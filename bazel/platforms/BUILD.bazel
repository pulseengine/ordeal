"""
Platform definitions for Ordeal build targets.

Ordeal has two targets:
  * the host (native) platform — our own pure-Rust CDCL core plus the optional
    CaDiCaL accelerator and the Z3 differential-oracle harness;
  * wasm32-wasip2 — the WebAssembly Component Model target loom embeds when it
    self-optimizes as a component (loom #246). Our own pure-Rust core is the
    engine here too; the optional native CaDiCaL accelerator is cfg-gated out.
"""

package(default_visibility = ["//visibility:public"])

# WebAssembly System Interface, preview 2 (wasm32-wasip2)
# The Component Model target. Selected via `--config=wasm`.
platform(
    name = "wasm32_wasip2",
    constraint_values = [
        "@platforms//os:wasi",
        "@platforms//cpu:wasm32",
    ],
)
