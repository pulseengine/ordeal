/- The query re-check (issue #192, phase 4): `kernel::check_query` is sound.

   This file is HAND-WRITTEN (Kernel.lean is generated by regen.sh and must
   not be edited). Phase 3's capstone `dag_refuted` (BlasterCapstone.lean)
   assumed its preconditions — the DAG is `DagWF`, every width fits, the
   gate budget / the `i32` variable numbers / the clause count fit — as
   hypotheses. `check_query` CHECKS them (`dag_wf`, `roots_wf`, `max_width`,
   `encode_fits`, `tseitin_fits` and two inline tests) before lowering the
   DAG through the proven pipeline and running the checker. This file proves
   each check establishes exactly the hypothesis it is there for, and
   composes them into `check_query_sound`: an accepted query is unsatisfiable,
   with NO hypothesis beyond the acceptance itself. -/
import BlasterCapstone

open Aeneas Aeneas.Std Result
open kernel.blast_kernel.spec

set_option maxHeartbeats 1000000

namespace kernel.spec

/- ══════════════════ WIDTH LISTS: `Vec<usize>` ↔ `List Nat` ══════════════════ -/

/-- The width list the Rust check carries is the `usize` projection of the
    Lean one. -/
theorem getD_map_val (ws : List Std.Usize) (j : Nat) (hj : j < ws.length) :
    (ws.map UScalar.val).getD j 0 = (ws[j]).val := by
  rw [List.getD_eq_getElem?_getD, List.getElem?_map, List.getElem?_eq_getElem hj]
  rfl

/-- Every entry of a `usize` width list fits `usize` (and so does the default). -/
theorem getD_map_val_le (ws : List Std.Usize) (j : Nat) :
    (ws.map UScalar.val).getD j 0 ≤ Usize.max := by
  rw [List.getD_eq_getElem?_getD]
  cases h : (ws.map UScalar.val)[j]? with
  | none => simp
  | some w =>
    simp only [Option.getD_some]
    obtain ⟨u, _, rfl⟩ := List.mem_map.mp (List.mem_of_getElem? h)
    scalar_tac

theorem and_fits_iff {P Q : Prop} {x : Nat} (hx : x ≤ Usize.max) (h : P ↔ Q) :
    P ↔ Q ∧ x ≤ Usize.max := by
  rw [h]
  exact ⟨fun hq => ⟨hq, hx⟩, fun hq => hq.1⟩

/- ══════════════════ THE PER-NODE CHECK ══════════════════ -/

theorem bin_wf_spec (ws : Slice Std.Usize) (a b : Std.Usize) :
    kernel.bin_wf ws a b ⦃ r => r = true ↔
      (a.val < ws.val.length ∧ b.val < ws.val.length ∧
        0 < (ws.val.map UScalar.val).getD a.val 0 ∧
        (ws.val.map UScalar.val).getD a.val 0 =
          (ws.val.map UScalar.val).getD b.val 0) ⦄ := by
  unfold kernel.bin_wf
  dsimp only
  split
  · rename_i ha
    have ha' : a.val < ws.val.length := by scalar_tac
    split
    · rename_i hb
      have hb' : b.val < ws.val.length := by scalar_tac
      step as ⟨i, hi⟩
      split
      · rename_i hpos
        step as ⟨i1, hi1⟩
        simp only [decide_eq_true_eq, getD_map_val _ _ ha', getD_map_val _ _ hb',
          ← hi, ← hi1]
        constructor
        · intro h
          exact ⟨ha', hb', by scalar_tac, by rw [h]⟩
        · rintro ⟨_, _, _, h⟩
          exact UScalar.val_eq_imp _ _ h
      · rename_i hpos
        simp only [WP.spec_ok, Bool.false_eq_true, false_iff, getD_map_val _ _ ha', ← hi]
        rintro ⟨_, _, h, _⟩
        exact hpos (by scalar_tac)
    · rename_i hb
      simp only [WP.spec_ok, Bool.false_eq_true, false_iff]
      rintro ⟨_, h, _, _⟩
      exact hb (by scalar_tac)
  · rename_i ha
    simp only [WP.spec_ok, Bool.false_eq_true, false_iff]
    rintro ⟨h, _, _, _⟩
    exact ha (by scalar_tac)

theorem bool_bin_wf_spec (ws : Slice Std.Usize) (a b : Std.Usize) :
    kernel.bool_bin_wf ws a b ⦃ r => r = true ↔
