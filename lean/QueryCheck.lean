        (ws.val.map UScalar.val).getD a.val 0 = 1 ∧
        (ws.val.map UScalar.val).getD b.val 0 = 1) ⦄ := by
  unfold kernel.bool_bin_wf
  dsimp only
  split
  · rename_i ha
    have ha' : a.val < ws.val.length := by scalar_tac
    split
    · rename_i hb
      have hb' : b.val < ws.val.length := by scalar_tac
      step as ⟨i, hi⟩
      split
      · rename_i hone
        step as ⟨i1, hi1⟩
        simp only [decide_eq_true_eq, getD_map_val _ _ ha', getD_map_val _ _ hb',
          ← hi, ← hi1]
        constructor
        · intro h
          exact ⟨ha', hb', by scalar_tac, by scalar_tac⟩
        · rintro ⟨_, _, _, h⟩
          scalar_tac
      · rename_i hone
        simp only [WP.spec_ok, Bool.false_eq_true, false_iff, getD_map_val _ _ ha', ← hi]
        rintro ⟨_, _, h, _⟩
        exact hone (by scalar_tac)
    · rename_i hb
      simp only [WP.spec_ok, Bool.false_eq_true, false_iff]
      rintro ⟨_, h, _, _⟩
      exact hb (by scalar_tac)
  · rename_i ha
    simp only [WP.spec_ok, Bool.false_eq_true, false_iff]
    rintro ⟨h, _, _, _⟩
    exact ha (by scalar_tac)

theorem ext_wf_spec (ws : Slice Std.Usize) (a by1 : Std.Usize) :
    kernel.ext_wf ws a by1 ⦃ r => r = true ↔
