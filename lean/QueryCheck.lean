/-- `node_wf` accepts node `nd` against the widths `ws` of the nodes before
    it iff the node is `DagNodeWF` at index `ws.len()` and its own width
    fits `usize`. -/
theorem node_wf_spec (ws : Slice Std.Usize) (nbits : Std.Usize)
    (nd : kernel.blast_kernel.DagNode) :
    kernel.node_wf ws nbits nd ⦃ b => b = true ↔
      (DagNodeWF (ws.val.map UScalar.val) nbits.val ws.val.length nd ∧
        dagNodeWidth (ws.val.map UScalar.val) nd ≤ Usize.max) ⦄ := by
  have h1max : 1 ≤ Usize.max := by scalar_tac
  -- `cases nd` cannot generalize `nd` under the `⦃ ⦄` notation; `induction` can.
  -- The 22 binary-word / predicate arms and the two extensions are the
  -- helper specs; the six remaining arms follow.
  induction nd <;> simp only [kernel.node_wf, DagNodeWF, dagNodeWidth] <;> first
    | exact WP.spec_mono (bin_wf_spec ws _ _)
        (fun _ hr => and_fits_iff (getD_map_val_le _ _) hr)
    | exact WP.spec_mono (bin_wf_spec ws _ _) (fun _ hr => and_fits_iff h1max hr)
    | exact WP.spec_mono (bool_bin_wf_spec ws _ _) (fun _ hr => and_fits_iff h1max hr)
    | exact ext_wf_spec ws _ _
    | skip
  · -- Var
    simp only [WP.spec_ok, decide_eq_true_eq]
    constructor
    · intro h
      scalar_tac
    · intro h
      scalar_tac
  · -- Const
    split
    · rename_i hw
      split
      · rename_i hs
        step as ⟨i, hi⟩
        simp only [decide_eq_true_eq]
        constructor
        · intro h
          scalar_tac
        · intro h
          scalar_tac
      · rename_i hs
        simp only [WP.spec_ok, Bool.false_eq_true, false_iff]
        rintro ⟨⟨_, h⟩, _⟩
        exact hs (by scalar_tac)
    · rename_i hw
      simp only [WP.spec_ok, Bool.false_eq_true, false_iff]
      rintro ⟨⟨h, _⟩, _⟩
      exact hw (by scalar_tac)
  · -- Extract
    rename_i hi lo a
    split
    · rename_i ha
      have ha' : a.val < ws.val.length := by scalar_tac
      split
      · rename_i hlo
        step as ⟨i, hi'⟩
        simp only [decide_eq_true_eq, getD_map_val _ _ ha', ← hi']
        constructor
        · intro h
          scalar_tac
        · intro h
          scalar_tac
      · rename_i hlo
        simp only [WP.spec_ok, Bool.false_eq_true, false_iff]
        rintro ⟨⟨_, h, _⟩, _⟩
        exact hlo (by scalar_tac)
    · rename_i ha
      simp only [WP.spec_ok, Bool.false_eq_true, false_iff]
      rintro ⟨⟨h, _, _⟩, _⟩
      exact ha (by scalar_tac)
  · -- Concat
    rename_i a b
    split
    · rename_i ha
      have ha' : a.val < ws.val.length := by scalar_tac
      split
      · rename_i hb
        have hb' : b.val < ws.val.length := by scalar_tac
        step as ⟨i, hi⟩
        split
        · rename_i hpos
          step as ⟨i1, hi1⟩
          split
          · rename_i hpos1
            step as ⟨i2, hi2⟩
            simp only [decide_eq_true_eq, getD_map_val _ _ ha', getD_map_val _ _ hb', ← hi, ← hi1]
            constructor
            · intro h
              scalar_tac
            · intro h
              scalar_tac
          · rename_i hpos1
            simp only [WP.spec_ok, Bool.false_eq_true, false_iff, getD_map_val _ _ hb', ← hi1]
            intro h
            exact hpos1 (by scalar_tac)
        · rename_i hpos
          simp only [WP.spec_ok, Bool.false_eq_true, false_iff, getD_map_val _ _ ha', ← hi]
          intro h
          exact hpos (by scalar_tac)
      · rename_i hb
        simp only [WP.spec_ok, Bool.false_eq_true, false_iff]
        rintro ⟨⟨_, h, _, _⟩, _⟩
        exact hb (by scalar_tac)
    · rename_i ha
      simp only [WP.spec_ok, Bool.false_eq_true, false_iff]
      rintro ⟨⟨h, _, _, _⟩, _⟩
      exact ha (by scalar_tac)
  · -- Ite
    rename_i c t e
    split
    · rename_i hc
      have hc' : c.val < ws.val.length := by scalar_tac
      split
      · rename_i ht
        have ht' : t.val < ws.val.length := by scalar_tac
        split
        · rename_i he
          have he' : e.val < ws.val.length := by scalar_tac
          step as ⟨i, hi⟩
          split
          · rename_i hone
            step as ⟨i1, hi1⟩
            split
            · rename_i hpos
              step as ⟨i2, hi2⟩
              simp only [decide_eq_true_eq, getD_map_val _ _ hc', getD_map_val _ _ ht',
                getD_map_val _ _ he', ← hi, ← hi1, ← hi2]
              constructor
              · intro h
                scalar_tac
              · intro h
                scalar_tac
            · rename_i hpos
              simp only [WP.spec_ok, Bool.false_eq_true, false_iff, getD_map_val _ _ ht', ← hi1]
