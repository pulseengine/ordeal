      step as ⟨i, hi⟩
      simp only [decide_eq_true_eq, getD_map_val _ _ ha', ← hi]
      constructor
      · intro h
        scalar_tac
      · intro h
        scalar_tac
    · rename_i ha
      simp only [WP.spec_ok, Bool.false_eq_true, false_iff]
      rintro ⟨⟨h, _⟩, _⟩
      exact ha (by scalar_tac)

/-- After `node_wf` accepted, `node_width` computes the node's syntactic
    width (`dagNodeWidth`) — every index is in range, no sum overflows. -/
theorem node_width_spec (ws : Slice Std.Usize) (nbits : Std.Usize)
    (nd : kernel.blast_kernel.DagNode)
    (hwf : DagNodeWF (ws.val.map UScalar.val) nbits.val ws.val.length nd)
    (hfit : dagNodeWidth (ws.val.map UScalar.val) nd ≤ Usize.max) :
    kernel.node_width ws nd ⦃ w => w.val = dagNodeWidth (ws.val.map UScalar.val) nd ⦄ := by
  induction nd <;> simp only [DagNodeWF] at hwf <;>
    simp only [kernel.node_width, dagNodeWidth] at hfit ⊢ <;> first
    | (simp; done)
    | (obtain ⟨ha, _⟩ := hwf
       step as ⟨i, hi⟩
       rw [hi, getD_map_val _ _ ha]
       done)
    | skip
  · -- Extract
    rename_i hi lo a
    obtain ⟨_, hlo, _⟩ := hwf
    step as ⟨i, hi'⟩
    step as ⟨w, hw⟩
    scalar_tac
  · -- Concat
    rename_i a b
    obtain ⟨ha, hb, _, _⟩ := hwf
    rw [getD_map_val _ _ ha, getD_map_val _ _ hb] at hfit ⊢
    step as ⟨i, hi⟩
    step as ⟨i1, hi1⟩
    rw [hi, hi1]
    step as ⟨w, hw⟩
    exact hw
  · -- ZeroExt
    rename_i a by1
    obtain ⟨ha, _⟩ := hwf
    rw [getD_map_val _ _ ha] at hfit ⊢
    step as ⟨i, hi⟩
    rw [hi]
    step as ⟨w, hw⟩
    exact hw
  · -- SignExt
    rename_i a by1
    obtain ⟨ha, _⟩ := hwf
    rw [getD_map_val _ _ ha] at hfit ⊢
    step as ⟨i, hi⟩
    rw [hi]
    step as ⟨w, hw⟩
    exact hw
  · -- Ite
    rename_i c t e
    obtain ⟨_, ht, _⟩ := hwf
    exact WP.spec_mono (Slice.index_usize_spec ws t ht)
      (fun _ hw => by rw [hw, getD_map_val _ _ ht])

/- ══════════════════ THE DAG CHECK ══════════════════ -/

/-- The loop invariant of `dag_wf_loop` after `i` nodes: the width vector
    is the widths of the first `i` nodes, and each of them is well-formed. -/
def DagWFInv (ns : List kernel.blast_kernel.DagNode) (nbits : Nat)
    (s : alloc.vec.Vec Std.Usize × Std.Usize) : Prop :=
  s.2.val ≤ ns.length ∧
  s.1.val.map UScalar.val = dagWidths (ns.take s.2.val) ∧
  ∀ (j : Nat) (hj : j < s.2.val) (hj' : j < ns.length), DagNodeWF (dagWidths ns) nbits j ns[j]

/-- What `dag_wf` establishes: `Ok ws` iff the DAG is `DagWF` and every
    width fits `usize` — and then `ws` IS the width list. -/
def DagWFPost (ns : List kernel.blast_kernel.DagNode) (nbits : Nat) :
    core.result.Result (alloc.vec.Vec Std.Usize) kernel.QueryError → Prop
  | .Ok ws => ws.val.map UScalar.val = dagWidths ns ∧ DagWF ns nbits
  | .Err _ => ¬ (DagWF ns nbits ∧ ∀ w ∈ dagWidths ns, w ≤ Usize.max)

theorem dag_wf_loop_spec (ns : Slice kernel.blast_kernel.DagNode) (nbits : Std.Usize)
    (ws : alloc.vec.Vec Std.Usize) (n i : Std.Usize)
    (hn : n.val = ns.val.length) (hinv : DagWFInv ns.val nbits.val (ws, i)) :
    kernel.dag_wf_loop ns nbits ws n i ⦃ r => DagWFPost ns.val nbits.val r ⦄ := by
  unfold kernel.dag_wf_loop
  apply loop.spec_decr_nat
    (measure := fun (s : alloc.vec.Vec Std.Usize × Std.Usize) => ns.val.length - s.2.val)
    (inv := DagWFInv ns.val nbits.val)
  · rintro ⟨ws1, i1⟩ ⟨hile, hws, hwf⟩
    dsimp only at hile hws hwf
    unfold kernel.dag_wf_loop.body
    dsimp only
    split
    · rename_i hlt
      have hilt : i1.val < ns.val.length := by scalar_tac
      have hlen : ws1.val.length = i1.val := by
        have := congrArg List.length hws
        simp only [List.length_map, dagWidths_length, List.length_take] at this
        omega
      have hderef : (alloc.vec.Vec.deref ws1).val = ws1.val := rfl
      have htake : ns.val.take (i1.val + 1) = ns.val.take i1.val ++ [ns.val[i1.val]] := by
        rw [List.take_add_one, List.getElem?_eq_getElem hilt]
        simp
      step as ⟨node, hnode⟩
      step with (node_wf_spec (alloc.vec.Vec.deref ws1) nbits node) as ⟨b, hb⟩
      rw [hderef, hlen, hws] at hb
      split
      · rename_i hbt
        obtain ⟨hnwf, hfit⟩ := hb.mp hbt
        step with (node_width_spec (alloc.vec.Vec.deref ws1) nbits node
          (by rw [hderef, hlen, hws]; exact hnwf) (by rw [hderef, hws]; exact hfit)) as ⟨w, hw⟩
        rw [hderef, hws] at hw
        have hcap : ws1.val.length < Usize.max := by
          have := ns.length_ineq
          omega
        step as ⟨ws2, hws2⟩
        step as ⟨i2, hi2⟩
        refine ⟨?_, by scalar_tac⟩
        unfold DagWFInv
        dsimp only
        refine ⟨by scalar_tac, ?_, ?_⟩
        · rw [hws2, hi2, List.map_append, hws, htake, dagWidths_snoc]
          simp [hw, hnode]
        · intro j hj hj'
          rw [hi2] at hj
          rcases Nat.lt_or_ge j i1.val with hjl | hjl
          · exact hwf j hjl hj'
          · have hjeq : j = i1.val := by omega
            subst hjeq
            rw [← hnode]
            exact DagNodeWF_congr (fun k hk => dagWidths_take_getD ns.val i1.val k hk) hnwf
      · rename_i hbf
        simp only [WP.spec_ok, DagWFPost]
        rintro ⟨hdag, hfits⟩
        apply hbf
        rw [hb, hnode]
        refine ⟨?_, ?_⟩
        · exact DagNodeWF_congr (fun k hk => (dagWidths_take_getD ns.val i1.val k hk).symm)
            (hdag i1.val hilt)
        · rw [← dagWidths_getD_eq ns.val i1.val hilt]
          exact getD_le_of_forall hfits _
    · rename_i hge
      have hieq : i1.val = ns.val.length := by scalar_tac
      simp only [WP.spec_ok, DagWFPost]
      rw [hieq, List.take_length] at hws
      refine ⟨hws, ?_⟩
      intro j hj
      exact hwf j (by omega) hj
  · exact hinv

/-- **`dag_wf` is exactly `DagWF` + "every width fits `usize`"**: `Ok ws`
    returns the width list of a well-formed DAG; `Err` means the DAG is
    not well-formed or a `Concat` / extension width would overflow. -/
theorem dag_wf_spec (ns : Slice kernel.blast_kernel.DagNode) (nbits : Std.Usize) :
    kernel.dag_wf ns nbits ⦃ r => match r with
      | core.result.Result.Ok ws =>
        ws.val.map UScalar.val = dagWidths ns.val ∧ DagWF ns.val nbits.val
      | core.result.Result.Err _ =>
        ¬ (DagWF ns.val nbits.val ∧ ∀ w ∈ dagWidths ns.val, w ≤ Usize.max) ⦄ := by
  unfold kernel.dag_wf
  dsimp only
  apply WP.spec_mono (dag_wf_loop_spec ns nbits _ _ _ (by simp) ?_)
  · intro r hr
    cases r with
    | Ok ws => exact hr
    | Err e => exact hr
  · unfold DagWFInv
    dsimp only
    refine ⟨by simp, ?_, ?_⟩
    · simp [dagWidths, dagWidthsAux]
    · intro j hj _
      simp at hj

/-- Soundness half of `dag_wf_spec` as a plain implication. -/
theorem dag_wf_sound (ns : Slice kernel.blast_kernel.DagNode) (nbits : Std.Usize)
    (ws : alloc.vec.Vec Std.Usize)
    (h : kernel.dag_wf ns nbits = ok (core.result.Result.Ok ws)) :
    ws.val.map UScalar.val = dagWidths ns.val ∧ DagWF ns.val nbits.val := by
  have := dag_wf_spec ns nbits
  rw [h, WP.spec_ok] at this
  exact this

/-- Completeness half of `dag_wf_spec`: a well-formed DAG whose widths fit
    is accepted (with its width list). -/
theorem dag_wf_complete (ns : Slice kernel.blast_kernel.DagNode) (nbits : Std.Usize)
    (hdag : DagWF ns.val nbits.val) (hfit : ∀ w ∈ dagWidths ns.val, w ≤ Usize.max) :
    ∃ ws : alloc.vec.Vec Std.Usize, kernel.dag_wf ns nbits = ok (core.result.Result.Ok ws) ∧
      ws.val.map UScalar.val = dagWidths ns.val := by
  obtain ⟨r, hr, hP⟩ := WP.spec_imp_exists (dag_wf_spec ns nbits)
  cases r with
  | Ok ws => exact ⟨ws, hr, hP.1⟩
  | Err e => exact absurd ⟨hdag, hfit⟩ hP

/- ══════════════════ THE ROOT CHECK ══════════════════ -/

/-- The loop invariant of `roots_wf_loop`: the first `r` roots are boolean
    nodes. (A `def`, so `step`'s simplifier leaves its shape alone.) -/
def RootsInv (ws roots : List Std.Usize) (r : Nat) : Prop :=
  r ≤ roots.length ∧
  ∀ (k : Nat) (hk : k < r) (hk' : k < roots.length),
    (roots[k]).val < ws.length ∧ (ws.map UScalar.val).getD (roots[k]).val 0 = 1

theorem roots_wf_loop_spec (ws roots : Slice Std.Usize) (n m r : Std.Usize)
    (hn : n.val = ws.val.length) (hm : m.val = roots.val.length)
    (hinv : RootsInv ws.val roots.val r.val) :
    kernel.roots_wf_loop ws roots n m r ⦃ res => match res with
      | core.result.Result.Ok _ =>
        ∀ rt ∈ roots.val, rt.val < ws.val.length ∧ (ws.val.map UScalar.val).getD rt.val 0 = 1
      | core.result.Result.Err _ => True ⦄ := by
  unfold kernel.roots_wf_loop
  apply loop.spec_decr_nat
    (measure := fun (r : Std.Usize) => roots.val.length - r.val)
    (inv := fun (r : Std.Usize) => RootsInv ws.val roots.val r.val)
  · rintro r1 ⟨hle, hk⟩
    unfold kernel.roots_wf_loop.body
    split
    · rename_i hlt
      have hrlt : r1.val < roots.val.length := by scalar_tac
      step as ⟨root, hroot⟩
      split
      · rename_i hge
        simp only [WP.spec_ok]
      · rename_i hlt2
        have hrootlt : root.val < ws.val.length := by scalar_tac
        step as ⟨i, hi⟩
        split
        · rename_i hne
          simp only [WP.spec_ok]
        · rename_i hne
          step as ⟨r2, hr2⟩
          refine ⟨?_, by scalar_tac⟩
          unfold RootsInv
          refine ⟨by scalar_tac, ?_⟩
          intro k hk' hk''
          rw [hr2] at hk'
          rcases Nat.lt_or_ge k r1.val with h | h
          · exact hk k h hk''
          · have hkeq : k = r1.val := by omega
            subst hkeq
            rw [← hroot]
            refine ⟨hrootlt, ?_⟩
            rw [getD_map_val _ _ hrootlt, ← hi]
            simp only [bne_iff_ne, ne_eq, not_not] at hne
            rw [hne]
            simp
    · rename_i hge
      simp only [WP.spec_ok]
      intro rt hrt
      obtain ⟨k, hk', rfl⟩ := List.getElem_of_mem hrt
      exact hk k (by scalar_tac) hk'
  · exact hinv

/-- `roots_wf` accepts only roots naming boolean (width-1) nodes — the
    encoder's `hroots` precondition — and never fails. -/
theorem roots_wf_spec (ws roots : Slice Std.Usize) :
    kernel.roots_wf ws roots ⦃ res => match res with
      | core.result.Result.Ok _ =>
        ∀ rt ∈ roots.val, rt.val < ws.val.length ∧ (ws.val.map UScalar.val).getD rt.val 0 = 1
      | core.result.Result.Err _ => True ⦄ := by
  unfold kernel.roots_wf
  dsimp only
  apply roots_wf_loop_spec ws roots _ _ _ (by simp) (by simp)
  unfold RootsInv
  refine ⟨by simp, ?_⟩
  intro k hk _
  simp at hk

/- ══════════════════ THE WIDTH BOUND ══════════════════ -/

/-- The loop invariant of `max_width_loop`: `m` bounds the first `i` widths. -/
def MaxInv (ws : List Std.Usize) (s : Std.Usize × Std.Usize) : Prop :=
  s.2.val ≤ ws.length ∧
  ∀ (k : Nat) (hk : k < s.2.val) (hk' : k < ws.length), (ws[k]).val ≤ s.1.val

theorem max_width_loop_spec (ws : Slice Std.Usize) (m n i : Std.Usize)
    (hn : n.val = ws.val.length) (hinv : MaxInv ws.val (m, i)) :
    kernel.max_width_loop ws m n i ⦃ r => ∀ w ∈ ws.val, w.val ≤ r.val ⦄ := by
  unfold kernel.max_width_loop
  apply loop.spec_decr_nat
    (measure := fun (s : Std.Usize × Std.Usize) => ws.val.length - s.2.val)
    (inv := MaxInv ws.val)
  · rintro ⟨m1, i1⟩ ⟨hle, hk⟩
    dsimp only at hle hk
    unfold kernel.max_width_loop.body
    dsimp only
    split
    · rename_i hlt
      have hilt : i1.val < ws.val.length := by scalar_tac
      step as ⟨x, hx⟩
      split
      · rename_i hgt
        simp only [bind_tc_ok]
        step as ⟨i2, hi2⟩
        refine ⟨?_, by scalar_tac⟩
        unfold MaxInv
        dsimp only
        refine ⟨by scalar_tac, ?_⟩
        intro k hk' hk''
        rw [hi2] at hk'
        rcases Nat.lt_or_ge k i1.val with h | h
        · exact Nat.le_trans (hk k h hk'') (by scalar_tac)
        · have hkeq : k = i1.val := by omega
          subst hkeq
          rw [← hx]
      · rename_i hgt
        simp only [bind_tc_ok]
        step as ⟨i2, hi2⟩
        refine ⟨?_, by scalar_tac⟩
        unfold MaxInv
        dsimp only
        refine ⟨by scalar_tac, ?_⟩
        intro k hk' hk''
        rw [hi2] at hk'
        rcases Nat.lt_or_ge k i1.val with h | h
        · exact hk k h hk''
        · have hkeq : k = i1.val := by omega
          subst hkeq
          rw [← hx]
          scalar_tac
    · rename_i hge
      simp only [WP.spec_ok]
      intro w hw
      obtain ⟨k, hk', rfl⟩ := List.getElem_of_mem hw
      exact hk k (by scalar_tac) hk'
  · exact hinv

/-- `max_width` bounds every width — the `W` of `encode_sound`. -/
theorem max_width_spec (ws : Slice Std.Usize) :
    kernel.max_width ws ⦃ m => ∀ w ∈ ws.val, w.val ≤ m.val ⦄ := by
  unfold kernel.max_width
  dsimp only
  apply max_width_loop_spec ws _ _ _ (by simp)
  unfold MaxInv
  dsimp only
  refine ⟨by simp, ?_⟩
  intro k hk _
  simp at hk

theorem encode_fits_tail (w n w25 : Std.Usize)
    (hw25 : w25.val = 25 * w.val) (hsq : 25 * w.val * w.val ≤ Usize.max)
    (h25 : 25 * w.val ≤ Usize.max) :
    ((do
      let sq ← w25 * w
      let lin ← 20#usize * w
      let i2 ← core.num.Usize.MAX - lin
      if sq > i2
      then ok false
      else
        let s ← sq + lin
        let i3 ← core.num.Usize.MAX - 1#usize
        if s > i3
        then ok false
        else
          let gb ← s + 1#usize
          if n > 0#usize
          then
            let i4 ← core.num.Usize.MAX / n
            if gb > i4
            then ok false
            else let total ← n * gb
                 ok (total < core.num.Usize.MAX)
          else let total ← n * gb
               ok (total < core.num.Usize.MAX)) : Result Bool) ⦃ b =>
      b = true → 1 + n.val * gateBound w.val ≤ Usize.max ⦄ := by
  have hMAX : core.num.Usize.MAX.val = Usize.max := by simp
  have h1max : 1 ≤ Usize.max := by scalar_tac
  have hsq' : w25.val * w.val ≤ Usize.max := by rw [hw25]; exact hsq
  step as ⟨sq, hsqv⟩
  have hlin' : 20 * w.val ≤ Usize.max := by omega
  step as ⟨lin, hlinv⟩
  step as ⟨i2, hi2⟩
  split
  · simp
  · rename_i hle
    have hs' : sq.val + lin.val ≤ Usize.max := by scalar_tac
    step as ⟨s, hs⟩
    step as ⟨i3, hi3⟩
    split
    · simp
    · rename_i hle3
      have hgb' : s.val + 1 ≤ Usize.max := by scalar_tac
      step as ⟨gb, hgb⟩
      have hgbv : gb.val = 25 * w.val * w.val + 20 * w.val + 1 := by
        rw [hgb, hs, hsqv, hlinv, hw25]
      split
      · rename_i hnpos
        step as ⟨i4, hi4⟩
        split
        · simp
        · rename_i hle4
          have hmul : gb.val * n.val ≤ Usize.max := by
            have : gb.val ≤ Usize.max / n.val := by scalar_tac
            exact (Nat.le_div_iff_mul_le (by scalar_tac)).mp this
          have hmul' : n.val * gb.val ≤ Usize.max := by rw [Nat.mul_comm]; exact hmul
          step as ⟨total, htotal⟩
          simp only [decide_eq_true_eq]
          intro hlt
          unfold gateBound
          rw [← hgbv]
          scalar_tac
      · rename_i hnz
        have hn0 : n.val = 0 := by scalar_tac
        have hmul' : n.val * gb.val ≤ Usize.max := by rw [hn0]; simp
        step as ⟨total, htotal⟩
        simp only [decide_eq_true_eq]
        intro _
        rw [hn0]
        simp
        exact h1max

/-- `encode_fits w n = true` means the arena capacity hypothesis of
    `encode_sound` holds for `n` nodes of width at most `w`; it never
    fails (every product is guarded by the preceding division). -/
theorem encode_fits_spec (w n : Std.Usize) :
    kernel.encode_fits w n ⦃ b => b = true → 1 + n.val * gateBound w.val ≤ Usize.max ⦄ := by
  unfold kernel.encode_fits
  have hMAX : core.num.Usize.MAX.val = Usize.max := by simp
  step as ⟨i, hi⟩
  split
  · simp
  · rename_i hle
    have h25 : 25 * w.val ≤ Usize.max := by
      have : w.val ≤ Usize.max / 25 := by scalar_tac
      have := (Nat.le_div_iff_mul_le (by omega)).mp this
      omega
    have h25' : (25#usize).val * w.val ≤ Usize.max := by simpa using h25
    step as ⟨w25, hw25⟩
    split
    · rename_i hwpos
      step as ⟨i1, hi1⟩
      split
      · simp
      · rename_i hle2
        have hsq : 25 * w.val * w.val ≤ Usize.max := by
          have : w25.val ≤ Usize.max / w.val := by scalar_tac
          have := (Nat.le_div_iff_mul_le (by scalar_tac)).mp this
          rw [hw25] at this
          simpa using this
        exact encode_fits_tail w n w25 (by simpa using hw25) hsq h25
    · rename_i hwz
      have hw0 : w.val = 0 := by scalar_tac
      exact encode_fits_tail w n w25 (by simpa using hw25) (by rw [hw0]; simp) h25

/-- `tseitin_fits nodes outs = true` means the clause-count capacity
    hypothesis of `tseitin_sat_preserving` holds; it never fails. -/
theorem tseitin_fits_spec (nodes outs : Std.Usize) :
    kernel.tseitin_fits nodes outs ⦃ b =>
      b = true → 1 + 3 * nodes.val + outs.val < Usize.max ⦄ := by
  unfold kernel.tseitin_fits
  have hMAX : core.num.Usize.MAX.val = Usize.max := by simp
  have h2max : 2 ≤ Usize.max := by scalar_tac
  step as ⟨i, hi⟩
  split
  · simp
  · rename_i hle
    have h3 : 3 * nodes.val ≤ Usize.max := by
      have : nodes.val ≤ Usize.max / 3 := by scalar_tac
      have := (Nat.le_div_iff_mul_le (by omega)).mp this
      omega
    have h3' : (3#usize).val * nodes.val ≤ Usize.max := by simpa using h3
    step as ⟨three, hthree⟩
    step as ⟨i1, hi1⟩
    split
    · simp
    · rename_i hle2
      step as ⟨i2, hi2⟩
      simp only [decide_eq_true_eq]
      intro h
      scalar_tac

/- ══════════════════ THE CAPSTONE ══════════════════ -/

/-- Inverting one monadic bind of an accepted run: the first action
    succeeded with some value, and the continuation accepted from it. -/
theorem bind_ok_inv {α β : Type} {m : Result α} {k : α → Result β} {y : β}
    (h : (do let x ← m; k x) = ok y) : ∃ x, m = ok x ∧ k x = ok y := by
  cases m with
  | ok x => exact ⟨x, rfl, by simpa using h⟩
  | fail e => simp at h
  | div => simp at h

/-- Everything an accepted `check_query` run establishes: the checker
    accepted `steps` against the returned CNF (which fits), and no
    primary-input assignment makes every root true. -/
theorem check_query_accepted (ns : Slice kernel.blast_kernel.DagNode) (bits : Slice Bool)
    (roots : Slice Std.Usize) (hints : Slice Std.Usize) (steps : Slice kernel.Step)
    (cnf : alloc.vec.Vec (alloc.vec.Vec Std.I32))
    (h : kernel.check_query ns bits roots hints steps = ok (core.result.Result.Ok cnf)) :
    (cnf.val.length + steps.val.length ≤ Std.Usize.max ∧
      kernel.check_steps ⟨cnf.val, cnf.property⟩ steps = ok (core.result.Result.Ok ())) ∧
    ∀ inp : List Bool, ¬ (∀ (k : Nat) (hk : k < roots.val.length),
      dagBool inp bits.val ns.val (roots.val[k]).val = true) := by
  unfold kernel.check_query at h
  dsimp only at h
  -- dag_wf
  obtain ⟨r, hr, h⟩ := bind_ok_inv h
  have hP := dag_wf_spec ns (Slice.len bits)
  rw [hr, WP.spec_ok] at hP
  cases r with
  | Err e =>
    simp [core.result.Result.Insts.CoreOpsTry.branch,
      core.result.Result.Insts.CoreOpsTryTraitFromResidualResultInfallible.from_residual] at h
  | Ok ws =>
  obtain ⟨hws, hdag⟩ := hP
  have hdag' : DagWF ns.val bits.val.length := by simpa using hdag
  have hlen : ws.val.length = ns.val.length := by
    have := congrArg List.length hws
    simpa using this
  simp only [core.result.Result.Insts.CoreOpsTry.branch, bind_tc_ok] at h
  -- roots_wf
  obtain ⟨r1, hr1, h⟩ := bind_ok_inv h
  have hP1 := roots_wf_spec (alloc.vec.Vec.deref ws) roots
  rw [hr1, WP.spec_ok] at hP1
  cases r1 with
  | Err e =>
    simp [core.result.Result.Insts.CoreOpsTryTraitFromResidualResultInfallible.from_residual] at h
  | Ok u =>
  have hroots : ∀ r ∈ roots.val, r.val < ns.val.length ∧ (dagWidths ns.val).getD r.val 0 = 1 := by
    intro r hr
    obtain ⟨h1, h2⟩ := hP1 r hr
    exact ⟨by rw [← hlen]; exact h1, by rw [← hws]; exact h2⟩
  simp only [bind_tc_ok] at h
  -- max_width
  obtain ⟨wmax, hwmax, h⟩ := bind_ok_inv h
  have hPw := max_width_spec (alloc.vec.Vec.deref ws)
  rw [hwmax, WP.spec_ok] at hPw
  have hW : ∀ w ∈ dagWidths ns.val, w ≤ wmax.val := by
    intro w hw
    rw [← hws, List.mem_map] at hw
    obtain ⟨u, hu, rfl⟩ := hw
    exact hPw u hu
  -- encode_fits
  obtain ⟨b, hb, h⟩ := bind_ok_inv h
  have hPb := encode_fits_spec wmax (Slice.len ns)
  rw [hb, WP.spec_ok] at hPb
  split at h
  · rename_i hbt
    have hcap : 1 + ns.val.length * gateBound wmax.val ≤ Usize.max := by
      simpa using hPb hbt
    -- aig_new, encode, compact, map_word
    obtain ⟨aig0, hnew, h⟩ := bind_ok_inv h
    obtain ⟨p, henc, h⟩ := bind_ok_inv h
    obtain ⟨⟨words, outs⟩, aig1⟩ := p
    obtain ⟨q, hcomp, h⟩ := bind_ok_inv h
    obtain ⟨aig2, map⟩ := q
    obtain ⟨outs2, hmap, h⟩ := bind_ok_inv h
    split at h
    · simp at h
    · rename_i hle
      have hi32 : (aig2.nodes.val.length : Int) ≤ I32.max := by
        have : aig2.nodes.val.length ≤ 2147483647 := by scalar_tac
        rw [I32.max_eq]
        omega
      -- tseitin_fits
      obtain ⟨b1, hb1, h⟩ := bind_ok_inv h
      have hPt := tseitin_fits_spec (alloc.vec.Vec.len aig2.nodes) (alloc.vec.Vec.len outs2)
      rw [hb1, WP.spec_ok] at hPt
      split at h
      · rename_i hb1t
        have hcapT : 1 + 3 * aig2.nodes.val.length + outs2.val.length < Usize.max := by
          simpa using hPt hb1t
        -- tseitin
        obtain ⟨cnf', htse, h⟩ := bind_ok_inv h
        obtain ⟨i7, hi7, h⟩ := bind_ok_inv h
        have hsub := Usize.sub_spec (x := core.num.Usize.MAX) (y := alloc.vec.Vec.len cnf')
          (by have := cnf'.len_ineq; scalar_tac)
        rw [hi7, WP.spec_ok] at hsub
        split at h
        · simp at h
        · rename_i hle2
          have hfit : cnf'.val.length + steps.val.length ≤ Std.Usize.max := by
            have := steps.length_ineq
            scalar_tac
          -- check_steps
          obtain ⟨r2, hchk, h⟩ := bind_ok_inv h
          cases r2 with
          | Err e => simp at h
          | Ok u =>
          cases u
          simp only [Result.ok.injEq, core.result.Result.Ok.injEq] at h
          subst h
          refine ⟨⟨hfit, hchk⟩, ?_⟩
          exact dag_refuted ns bits roots wmax.val hdag' hW hcap hroots aig0 hnew words outs aig1
            henc hints aig2 map hcomp outs2 hmap hi32 hcapT cnf' htse steps hfit hchk
      · simp at h
  · simp at h

/-- **The query re-check is sound** (issue #192 phase 4): if `check_query`
    accepts, no assignment to the DAG's variables makes every asserted
    root true. No hypothesis beyond the acceptance itself — the checks
    inside `check_query` discharge every precondition of `dag_refuted`. -/
theorem check_query_sound (ns : Slice kernel.blast_kernel.DagNode) (bits : Slice Bool)
    (roots : Slice Std.Usize) (hints : Slice Std.Usize) (steps : Slice kernel.Step)
    (cnf : alloc.vec.Vec (alloc.vec.Vec Std.I32))
    (h : kernel.check_query ns bits roots hints steps = ok (core.result.Result.Ok cnf)) :
    ∀ inp : List Bool, ¬ (∀ (k : Nat) (hk : k < roots.val.length),
      dagBool inp bits.val ns.val (roots.val[k]).val = true) :=
  (check_query_accepted ns bits roots hints steps cnf h).2

/-- The CNF `check_query` returns is the one the checker refuted: it is
    unsatisfiable in the kernel's own semantics (`lrat_check_sound`). -/
theorem check_query_refutes_cnf (ns : Slice kernel.blast_kernel.DagNode) (bits : Slice Bool)
    (roots : Slice Std.Usize) (hints : Slice Std.Usize) (steps : Slice kernel.Step)
    (cnf : alloc.vec.Vec (alloc.vec.Vec Std.I32))
    (h : kernel.check_query ns bits roots hints steps = ok (core.result.Result.Ok cnf)) :
    kernel.spec.unsat (cnf.val.map (fun c => c.val)) :=
  let hf := (check_query_accepted ns bits roots hints steps cnf h).1
  lrat_check_sound ⟨cnf.val, cnf.property⟩ steps hf.1 hf.2

end kernel.spec
