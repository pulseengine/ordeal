/- Correctness of the shift-add multiplier (issue #68, v0.15.0 capstone):
   `full_adder` and `blast_mul`.

   This file is HAND-WRITTEN (BlastKernel.lean is generated by
   regen-blaster.sh and must not be edited). It builds on the pure-model
   infrastructure of BlasterProof.lean (`pSim` / `pEvalLit`,
   append-monotonicity, `AigWF`, the gadget-spec idiom, `simulate_spec`,
   `Denotes`), BlasterArith.lean (`dLit`, `lit_false_spec`,
   `pEvalLit_node_zero`, `Bool.atLeastTwo` algebra) and BlasterShift.lean
   (`node0_of_prefix`).

   What `blast_mul` computes (ground truth from the Rust):

     acc = [FALSE; w]
     for i in 0..w:                 -- rows
         carry = FALSE
         for j in i..w:             -- columns
             pp = and(a[j-i], b[i])                       -- 1 gate
             (sum, cout) = full_adder(acc[j], pp, carry)  -- 9 gates
             acc[j] = sum; carry = cout
     return acc     -- low w bits; the carry out of bit w-1 is dropped

   Gate counts (exact, from the generated code): `full_adder` = 9 gates
   (two XOR gadgets à 3, two AND, one OR), one inner-loop column = 10 gates
   (1 partial-product AND + 9), row `i` = `10 * (w - i)` gates, and the whole
   multiplier = `mulGates w w = 10·w + 10·(w-1) + … = 5·w·(w+1)` gates.

   Proof architecture (two halves, glued by `blast_mul_correct`):

   * REFINEMENT (Boolean pure model). `wordVals vals word` reads a whole word
     of literals into a `List Bool`. Row `i`'s inner chain is modelled purely:
     `pPP pa pb i j` is the partial-product bit of column `j`,
     `pRowCarry pa pb acc i j` the ripple carry INTO column `j` (false at and
     below `i`), and `pRowBit pa pb acc i j` the accumulator bit after the
     row (bits below `i` untouched). `pRow` packages a whole row,
     `pMulAcc pa pb w i` iterates it: the accumulator after `i` rows.
     `MulRowInv` (inner loop, gates: 10 per column) and `MulInv` (outer loop,
     gates: `mulGates`) are the two-level invariant; `blast_mul_row_spec` and
     `blast_mul_loop1_spec` are the loop specs; `blast_mul_correct` composes
     them with `simulate_spec` exactly like `blast_add_correct`.

   * NUMERIC BRIDGE (core `BitVec.carry`). On denoting words
     (`DenotesBits`), row `i` adds `rowX A B i = if B.getLsbD i then A <<< i
     else 0`: the row carry chain IS core's numerically-defined
     `BitVec.carry` (`pRowCarry_eq_carry`, via `BitVec.carry_succ`; carries
     at and below column `i` vanish because `rowX` has no low bits —
     `carry_rowX_of_le`), so the row is one truncated `BitVec` addition
     (`pRow_denotesBits`, via `BitVec.getLsbD_add`). Folding the rows gives
     `pAccBV A B i` with `toNat = A.toNat * (B.toNat % 2^i) % 2^w`
     (`pAccBV_toNat`, plain `Nat` induction), hence `pAccBV A B w = A * B`
     (`pAccBV_last`).

   * The headline `blast_mul_bitvec`: if the input words denote `A B :
     BitVec w` under the post-blast simulation, the output word denotes
     `A * B` — for EVERY width `w`.
-/
import BlasterShift

open Aeneas Aeneas.Std Result

set_option maxHeartbeats 1000000

namespace blast_kernel.spec

/- ══════════════════ WORDS OF LITERALS AS BOOLEAN WORDS ══════════════════ -/

/-- The Boolean values of a whole word of literals under a value list. -/
def wordVals (vals : List Bool) (word : List Lit) : List Bool :=
  word.map (pEvalLit vals)

@[simp]
theorem wordVals_length (vals : List Bool) (word : List Lit) :
    (wordVals vals word).length = word.length := by
  simp [wordVals]

theorem wordVals_getD (vals : List Bool) (word : List Lit) {t : Nat}
    (ht : t < word.length) :
    (wordVals vals word).getD t false = pEvalLit vals (word[t]'ht) := by
  rw [getD_eq_getElem_of_lt (by simpa using ht) false]
  simp [wordVals]

/-- Append-monotonicity for whole words: appending nodes to the AIG does not
    change the value of any word whose literals refer to existing nodes. -/
theorem wordVals_stable {ns ns' : List Node} (hpre : ns <+: ns')
    {word : List Lit} (hw : ∀ l ∈ word, l.node.val < ns.length)
    (inp : List Bool) :
    wordVals (pSim inp ns') word = wordVals (pSim inp ns) word := by
  unfold wordVals
  apply List.map_congr_left
  intro l hl
  exact pEvalLit_stable hpre l (hw l hl) inp

/-- Two Boolean lists with equal lengths and equal `getD` reads are equal. -/
theorem eq_of_getD_eq {l1 l2 : List Bool} (hlen : l1.length = l2.length)
    (h : ∀ t, t < l1.length → l1.getD t false = l2.getD t false) :
    l1 = l2 := by
  apply List.ext_getElem hlen
  intro t h1 h2
  rw [← getD_eq_getElem_of_lt h1 false, ← getD_eq_getElem_of_lt h2 false]
  exact h t h1

/- ══════════════════ THE PURE ROW MODEL ══════════════════ -/

/-- Partial-product bit of row `i` at column `j` (only read for `j ≥ i`):
    `a[j-i] ∧ b[i]`. -/
def pPP (pa pb : List Bool) (i j : Nat) : Bool :=
  pa.getD (j - i) false && pb.getD i false

/-- Ripple carry INTO column `j` of the row-`i` inner chain over base
    accumulator bits `acc`: false at and below column `i`, then the majority
    recurrence of the full adder. -/
def pRowCarry (pa pb acc : List Bool) (i : Nat) : Nat → Bool
  | 0 => false
  | j + 1 =>
    if j < i then false
    else
      Bool.atLeastTwo (acc.getD j false) (pPP pa pb i j)
        (pRowCarry pa pb acc i j)

theorem pRowCarry_of_le (pa pb acc : List Bool) (i : Nat) {j : Nat}
    (hj : j ≤ i) : pRowCarry pa pb acc i j = false := by
  cases j with
  | zero => rfl
  | succ j =>
    simp only [pRowCarry]
    rw [if_pos (by omega)]

theorem pRowCarry_succ_of_ge (pa pb acc : List Bool) {i j : Nat} (h : i ≤ j) :
    pRowCarry pa pb acc i (j + 1)
      = Bool.atLeastTwo (acc.getD j false) (pPP pa pb i j)
          (pRowCarry pa pb acc i j) := by
  simp only [pRowCarry]
  rw [if_neg (by omega)]

/-- Accumulator bit `j` after row `i`: untouched below `i`, full-adder sum
    at and above. -/
def pRowBit (pa pb acc : List Bool) (i j : Nat) : Bool :=
  if j < i then acc.getD j false
  else acc.getD j false ^^ (pPP pa pb i j ^^ pRowCarry pa pb acc i j)

theorem pRowBit_of_lt {pa pb acc : List Bool} {i j : Nat} (h : j < i) :
    pRowBit pa pb acc i j = acc.getD j false := by
  unfold pRowBit
  rw [if_pos h]

theorem pRowBit_of_ge {pa pb acc : List Bool} {i j : Nat} (h : i ≤ j) :
    pRowBit pa pb acc i j
      = (acc.getD j false
         ^^ (pPP pa pb i j ^^ pRowCarry pa pb acc i j)) := by
  unfold pRowBit
  rw [if_neg (by omega)]

/-- The whole accumulator after row `i` (same length as `acc`). -/
def pRow (pa pb acc : List Bool) (i : Nat) : List Bool :=
  (List.range acc.length).map (pRowBit pa pb acc i)

@[simp]
theorem pRow_length (pa pb acc : List Bool) (i : Nat) :
    (pRow pa pb acc i).length = acc.length := by
  simp [pRow]

theorem pRow_getD (pa pb acc : List Bool) (i : Nat) {t : Nat}
    (ht : t < acc.length) :
    (pRow pa pb acc i).getD t false = pRowBit pa pb acc i t := by
  have h1 : t < (pRow pa pb acc i).length := by simp [ht]
  rw [getD_eq_getElem_of_lt h1 false]
  simp [pRow]

/-- The accumulator after `i` rows of the shift-add multiplier. -/
def pMulAcc (pa pb : List Bool) (w : Nat) : Nat → List Bool
  | 0 => List.replicate w false
  | i + 1 => pRow pa pb (pMulAcc pa pb w i) i

@[simp]
theorem pMulAcc_length (pa pb : List Bool) (w i : Nat) :
    (pMulAcc pa pb w i).length = w := by
  induction i with
  | zero => simp [pMulAcc]
  | succ i ih => simp [pMulAcc, ih]

/- ══════════════════ GATE COUNTING ══════════════════ -/

/-- Exact gate count of the first `i` rows: row `r` costs `10 · (w - r)`
    gates (one AND + one 9-gate full adder per column `r..w-1`). -/
def mulGates (w : Nat) : Nat → Nat
  | 0 => 0
  | i + 1 => mulGates w i + 10 * (w - i)

theorem mulGates_le (w : Nat) : ∀ i, mulGates w i ≤ 10 * w * i := by
  intro i
  induction i with
  | zero => simp [mulGates]
  | succ i ih =>
    have h1 : 10 * w * (i + 1) = 10 * w * i + 10 * w := Nat.mul_succ _ _
    have h2 : 10 * (w - i) ≤ 10 * w := by omega
    simp only [mulGates]
    omega

/- ══════════════════ THE FULL-ADDER GADGET ══════════════════ -/

/-- **Gadget spec for the standalone `full_adder`**: appends exactly 9 gates
    (two XOR gadgets à three, two AND, one OR), preserves well-formedness —
    and, by append-monotonicity, the value of every pre-existing literal —
    and returns a sum literal valued `x ⊕ (y ⊕ c)` and a carry literal
    valued `atLeastTwo x y c` (majority), all w.r.t. the PRE-state aig.
    Same 5-gate-gadget algebra as `ripple_body_gadget` in BlasterArith. -/
theorem full_adder_gadget (aig : Aig) (x y c : Lit)
    (hcap : aig.nodes.val.length + 9 ≤ Usize.max)
    (hx : x.node.val < aig.nodes.val.length)
    (hy : y.node.val < aig.nodes.val.length)
    (hc : c.node.val < aig.nodes.val.length) :
    full_adder aig x y c ⦃ p =>
      p.2.nodes.val.length = aig.nodes.val.length + 9 ∧
      aig.nodes.val <+: p.2.nodes.val ∧
      (∀ L, AigWF aig.nodes.val L → AigWF p.2.nodes.val L) ∧
      p.1.1.node.val < p.2.nodes.val.length ∧
      p.1.2.node.val < p.2.nodes.val.length ∧
      ∀ inp : List Bool,
        pEvalLit (pSim inp p.2.nodes.val) p.1.1
          = (pEvalLit (pSim inp aig.nodes.val) x
             ^^ (pEvalLit (pSim inp aig.nodes.val) y
                 ^^ pEvalLit (pSim inp aig.nodes.val) c)) ∧
        pEvalLit (pSim inp p.2.nodes.val) p.1.2
          = Bool.atLeastTwo (pEvalLit (pSim inp aig.nodes.val) x)
              (pEvalLit (pSim inp aig.nodes.val) y)
              (pEvalLit (pSim inp aig.nodes.val) c) ⦄ := by
  unfold full_adder
  step with (push_xor_gadget aig x y (by omega) hx hy) as
    ⟨p, aigA, hp1, hp2, hp3, hp4, hp5⟩
  have hcA : c.node.val < aigA.nodes.val.length := by omega
  step with (push_xor_gadget aigA p c (by omega) hp3 hcA) as
    ⟨s, aigB, hs1, hs2, hs3, hs4, hs5⟩
  have hxB : x.node.val < aigB.nodes.val.length := by omega
  have hyB : y.node.val < aigB.nodes.val.length := by omega
  step with (push_and_gadget aigB x y (by omega) hxB hyB) as
    ⟨g, aigC, hg1, hg2, hg3, hg4, hg5⟩
  have hpC : p.node.val < aigC.nodes.val.length := by omega
  have hcC : c.node.val < aigC.nodes.val.length := by omega
  step with (push_and_gadget aigC p c (by omega) hpC hcC) as
    ⟨t, aigD, ht1, ht2, ht3, ht4, ht5⟩
  have hgD : g.node.val < aigD.nodes.val.length := by omega
  step with (push_or_gadget aigD g t (by omega) hgD ht3) as
    ⟨c2, aigE, hE1, hE2, hE3, hE4, hE5⟩
  refine ⟨by omega, hp2.trans (hs2.trans (hg2.trans (ht2.trans hE2))),
    fun L hL => hE4 L (ht4 L (hg4 L (hs4 L (hp4 L hL)))), by omega, hE3, ?_⟩
  intro inp
  constructor
  · -- sum bit: s = x ⊕ (y ⊕ c)
    rw [pEvalLit_stable (hg2.trans (ht2.trans hE2)) s hs3 inp, hs5 inp,
      hp5 inp, pEvalLit_stable hp2 c hc inp]
    exact Bool.xor_assoc _ _ _
  · -- carry out: c2 = atLeastTwo x y c
    rw [hE5 inp, pEvalLit_stable ht2 g hg3 inp, hg5 inp, ht5 inp,
      pEvalLit_stable (hs2.trans hg2) p hp3 inp, hp5 inp,
      pEvalLit_stable (hp2.trans hs2) x hx inp,
      pEvalLit_stable (hp2.trans hs2) y hy inp,
      pEvalLit_stable (hp2.trans (hs2.trans hg2)) c hc inp]
    exact or_and_xor_eq_atLeastTwo _ _ _

/- ══════════════════ THE ACCUMULATOR-INIT LOOP ══════════════════ -/

/-- First `blast_mul` loop: seeds the accumulator with `w` copies of
    `lit_false` (no gates). -/
theorem blast_mul_loop0_spec (w : Std.Usize) :
    blast_mul_loop0 w (alloc.vec.Vec.new Lit) 0#usize ⦃ r =>
      r.val = List.replicate w.val dLit ⦄ := by
  unfold blast_mul_loop0
  apply loop.spec_decr_nat
    (measure := fun (s : alloc.vec.Vec Lit × Std.Usize) => w.val - s.2.val)
    (inv := fun (s : alloc.vec.Vec Lit × Std.Usize) =>
      s.2.val ≤ w.val ∧ s.1.val = List.replicate s.2.val dLit)
  · rintro ⟨acc1, k⟩ ⟨hle, hval⟩
    dsimp only at hle hval
    unfold blast_mul_loop0.body
    dsimp only
    split
    · rename_i hlt
      step with lit_false_spec as ⟨l, hl⟩
      have hcap : acc1.val.length < Usize.max := by
        rw [hval]
        simp only [List.length_replicate]
        scalar_tac
      step as ⟨acc2, hacc2⟩
      step as ⟨k1, hk1⟩
      refine ⟨by scalar_tac, ?_, by scalar_tac⟩
      rw [hk1, hacc2, hval, hl, List.replicate_succ']
      rfl
    · rename_i hge
      have hkeq : k.val = w.val := by scalar_tac
      have hfin : acc1.val = List.replicate w.val dLit := by
        rw [hval, hkeq]
      exact hfin
  · exact ⟨by scalar_tac, by simp⟩

/- ══════════════════ THE INNER (COLUMN) LOOP ══════════════════ -/

/-- Inner-loop invariant of row `i`, at column `j` (relative to the
    row-start aig `aigR` and row-start accumulator `acc`): 10 gates per
    processed column were appended, nothing existing was touched, columns
    outside `[i, j)` still hold their ORIGINAL literals, the carry literal
    evaluates — under the CURRENT aig — to the pure row carry
    `pRowCarry … j`, and every processed column `t ∈ [i, j)` evaluates to
    the pure row bit `pRowBit … t` (operand and accumulator values all read
    under the row-start aig `aigR`). -/
def MulRowInv (aigR : Aig) (a b : Slice Lit) (acc : alloc.vec.Vec Lit)
    (i : Nat) (aig1 : Aig) (acc1 : alloc.vec.Vec Lit) (carry1 : Lit)
    (j : Nat) : Prop :=
  i ≤ j ∧ j ≤ a.val.length ∧
  aig1.nodes.val.length = aigR.nodes.val.length + 10 * (j - i) ∧
  aigR.nodes.val <+: aig1.nodes.val ∧
  (∀ L, AigWF aigR.nodes.val L → AigWF aig1.nodes.val L) ∧
  acc1.val.length = acc.val.length ∧
  (∀ l ∈ acc1.val, l.node.val < aig1.nodes.val.length) ∧
  carry1.node.val < aig1.nodes.val.length ∧
  (∀ t : Nat, t < i ∨ j ≤ t → acc1.val.getD t dLit = acc.val.getD t dLit) ∧
  (∀ inp : List Bool,
    pEvalLit (pSim inp aig1.nodes.val) carry1
      = pRowCarry (wordVals (pSim inp aigR.nodes.val) a.val)
          (wordVals (pSim inp aigR.nodes.val) b.val)
          (wordVals (pSim inp aigR.nodes.val) acc.val) i j) ∧
  (∀ (inp : List Bool) (t : Nat), i ≤ t → t < j →
    pEvalLit (pSim inp aig1.nodes.val) (acc1.val.getD t dLit)
      = pRowBit (wordVals (pSim inp aigR.nodes.val) a.val)
          (wordVals (pSim inp aigR.nodes.val) b.val)
          (wordVals (pSim inp aigR.nodes.val) acc.val) i t)

/-- **Row spec** (one full outer iteration `i`, i.e. the inner column loop
    started at `j = i` with a false carry): appends exactly `10 · (w - i)`
    gates and rewrites the accumulator so that EVERY bit `t < w` evaluates
    to `pRowBit … t` — bits below `i` keep their old values (`pRowBit`'s
    first branch), bits at and above `i` become the full-adder sums. -/
theorem blast_mul_row_spec (aigR : Aig) (a b : Slice Lit) (w : Std.Usize)
    (acc : alloc.vec.Vec Lit) (i : Std.Usize) (carry : Lit)
    (hw : w.val = a.val.length)
    (hacc : acc.val.length = a.val.length)
    (hi : i.val < a.val.length)
    (hib : i.val < b.val.length)
    (hcap : aigR.nodes.val.length + 10 * (a.val.length - i.val) ≤ Usize.max)
    (ha : ∀ l ∈ a.val, l.node.val < aigR.nodes.val.length)
    (hb : ∀ l ∈ b.val, l.node.val < aigR.nodes.val.length)
    (haccr : ∀ l ∈ acc.val, l.node.val < aigR.nodes.val.length)
    (hcr : carry.node.val < aigR.nodes.val.length)
    (hcv : ∀ inp : List Bool,
      pEvalLit (pSim inp aigR.nodes.val) carry = false) :
    blast_mul_loop1_loop0 aigR a b w acc i carry i ⦃ q =>
      q.1.nodes.val.length
        = aigR.nodes.val.length + 10 * (a.val.length - i.val) ∧
      aigR.nodes.val <+: q.1.nodes.val ∧
      (∀ L, AigWF aigR.nodes.val L → AigWF q.1.nodes.val L) ∧
      q.2.val.length = a.val.length ∧
      (∀ l ∈ q.2.val, l.node.val < q.1.nodes.val.length) ∧
      ∀ (inp : List Bool) (t : Nat), t < a.val.length →
        pEvalLit (pSim inp q.1.nodes.val) (q.2.val.getD t dLit)
          = pRowBit (wordVals (pSim inp aigR.nodes.val) a.val)
              (wordVals (pSim inp aigR.nodes.val) b.val)
              (wordVals (pSim inp aigR.nodes.val) acc.val) i.val t ⦄ := by
  unfold blast_mul_loop1_loop0
  apply loop.spec_decr_nat
    (measure := fun (s : Aig × alloc.vec.Vec Lit × Lit × Std.Usize) =>
      a.val.length - s.2.2.2.val)
    (inv := fun (s : Aig × alloc.vec.Vec Lit × Lit × Std.Usize) =>
      MulRowInv aigR a b acc i.val s.1 s.2.1 s.2.2.1 s.2.2.2.val)
  · rintro ⟨aig1, acc1, carry1, j⟩ hinv
    obtain ⟨hij, hjw, hlen1, hpre1, hwf1, halen, harng, hcrng, hunt, hcsem,
      hssem⟩ := hinv
    dsimp only at hij hjw hlen1 hpre1 hwf1 halen harng hcrng hunt hcsem hssem
    unfold blast_mul_loop1_loop0.body
    dsimp only
    split
    · rename_i hlt
      have hjlt : j.val < a.val.length := by scalar_tac
      step as ⟨i1, hi1⟩
      have hi1v : i1.val = j.val - i.val := by scalar_tac
      have hi1lt : i1.val < a.val.length := by omega
      step as ⟨la, hla⟩
      simp only [hi1v] at hla
      step as ⟨lb, hlb⟩
      have hla1 : la.node.val < aig1.nodes.val.length := by
        have h1 := ha la (by rw [hla]; exact List.getElem_mem _)
        have h2 := hpre1.length_le
        omega
      have hlb1 : lb.node.val < aig1.nodes.val.length := by
        have h1 := hb lb (by rw [hlb]; exact List.getElem_mem _)
        have h2 := hpre1.length_le
        omega
      have hcap1 : aig1.nodes.val.length + 1 ≤ Usize.max := by omega
      step with (push_and_gadget aig1 la lb hcap1 hla1 hlb1) as
        ⟨pp, aigP, hP1, hP2, hP3, hP4, hP5⟩
      have hjacc : j.val < acc1.val.length := by omega
      step as ⟨l2, hl2⟩
      have hl2r : l2.node.val < aigP.nodes.val.length := by
        have h1 := harng l2 (by rw [hl2]; exact List.getElem_mem _)
        omega
      have hcapP : aigP.nodes.val.length + 9 ≤ Usize.max := by omega
      have hcP : carry1.node.val < aigP.nodes.val.length := by omega
      step with (full_adder_gadget aigP l2 pp carry1 hcapP hl2r hP3 hcP) as
        ⟨sum, cout, aigF, hF1, hF2, hF3, hF4, hF5, hF6⟩
      step as ⟨old, back, hold, hback⟩
      step as ⟨j1, hj1⟩
      -- the three full-adder operand values, under the push_and post-state,
      -- expressed against the row-start aig
      have hVl2 : ∀ inp : List Bool,
          pEvalLit (pSim inp aigP.nodes.val) l2
            = (wordVals (pSim inp aigR.nodes.val) acc.val).getD j.val
                false := by
        intro inp
        have hj2 : j.val < acc.val.length := by omega
        have hlit : acc1.val[j.val]'hjacc = acc.val[j.val]'hj2 := by
          have h9 := hunt j.val (Or.inr (Nat.le_refl _))
          rwa [getD_eq_getElem_of_lt hjacc dLit,
            getD_eq_getElem_of_lt hj2 dLit] at h9
        rw [hl2, pEvalLit_stable hP2 _ (harng _ (List.getElem_mem _)) inp,
          hlit, pEvalLit_stable hpre1 _ (haccr _ (List.getElem_mem _)) inp,
          wordVals_getD _ _ hj2]
      have hVpp : ∀ inp : List Bool,
          pEvalLit (pSim inp aigP.nodes.val) pp
            = pPP (wordVals (pSim inp aigR.nodes.val) a.val)
                (wordVals (pSim inp aigR.nodes.val) b.val) i.val j.val := by
        intro inp
        rw [hP5 inp, hla, hlb,
          pEvalLit_stable hpre1 _ (ha _ (List.getElem_mem _)) inp,
          pEvalLit_stable hpre1 _ (hb _ (List.getElem_mem _)) inp]
        unfold pPP
        rw [wordVals_getD _ _ (show j.val - i.val < a.val.length by omega),
          wordVals_getD _ _ hib]
      have hVc : ∀ inp : List Bool,
          pEvalLit (pSim inp aigP.nodes.val) carry1
            = pRowCarry (wordVals (pSim inp aigR.nodes.val) a.val)
                (wordVals (pSim inp aigR.nodes.val) b.val)
                (wordVals (pSim inp aigR.nodes.val) acc.val) i.val
                j.val := by
        intro inp
        rw [pEvalLit_stable hP2 carry1 hcrng inp]
        exact hcsem inp
      refine ⟨?_, by scalar_tac⟩
      rw [hj1, hback]
      have hpreF : aig1.nodes.val <+: aigF.nodes.val := hP2.trans hF2
      refine ⟨by omega, by omega, by omega, hpre1.trans hpreF,
        fun L hL => hF3 L (hP4 L (hwf1 L hL)), ?_, ?_, hF5, ?_, ?_, ?_⟩
      · -- length preserved by the in-place update
        simp only [alloc.vec.Vec.set_val_eq, List.length_set]
        exact halen
      · -- all accumulator literals in range
        intro l hl
        simp only [alloc.vec.Vec.set_val_eq] at hl
        rcases List.mem_or_eq_of_mem_set hl with h' | h'
        · have h1 := harng l h'
          have h2 := hpreF.length_le
          omega
        · subst h'
          exact hF4
      · -- columns outside [i, j+1) untouched
        intro t htc
        simp only [alloc.vec.Vec.set_val_eq]
        rw [List.getD_eq_getElem?_getD,
          List.getElem?_set_ne (show j.val ≠ t by omega),
          ← List.getD_eq_getElem?_getD]
        exact hunt t (by omega)
      · -- carry chain advances by one majority stage
        intro inp
        rw [(hF6 inp).2, hVl2 inp, hVpp inp, hVc inp,
          pRowCarry_succ_of_ge _ _ _ hij]
      · -- processed columns: old ones stable, the fresh one is the sum
        intro inp t hit htj
        simp only [alloc.vec.Vec.set_val_eq]
        by_cases hteq : t = j.val
        · subst hteq
          rw [List.getD_eq_getElem?_getD,
            List.getElem?_set_self (by omega), Option.getD_some,
            (hF6 inp).1, hVl2 inp, hVpp inp, hVc inp, pRowBit_of_ge hit]
        · have htlt : t < j.val := by omega
          rw [List.getD_eq_getElem?_getD,
            List.getElem?_set_ne (show j.val ≠ t by omega),
            ← List.getD_eq_getElem?_getD]
          have htacc : t < acc1.val.length := by omega
          rw [getD_eq_getElem_of_lt htacc dLit,
            pEvalLit_stable hpreF _ (harng _ (List.getElem_mem _)) inp,
            ← getD_eq_getElem_of_lt htacc dLit]
          exact hssem inp t hit htlt
    · rename_i hge
      have hjeq : j.val = a.val.length := by scalar_tac
      refine ⟨by dsimp only; omega, hpre1, hwf1, by dsimp only; omega,
        harng, ?_⟩
      dsimp only
      intro inp t ht
      by_cases hti : i.val ≤ t
      · exact hssem inp t hti (by omega)
      · -- t < i: untouched, and pRowBit's first branch is the old value
        rw [hunt t (Or.inl (by omega))]
        have htacc : t < acc.val.length := by omega
        rw [getD_eq_getElem_of_lt htacc dLit,
          pEvalLit_stable hpre1 _ (haccr _ (List.getElem_mem _)) inp,
          pRowBit_of_lt (by omega), wordVals_getD _ _ htacc]
  · dsimp only
    refine ⟨Nat.le_refl _, by omega, by omega, List.prefix_refl _,
      fun _ h => h, rfl, haccr, hcr, fun t _ => rfl, ?_, ?_⟩
    · intro inp
      rw [hcv inp, pRowCarry_of_le _ _ _ _ (Nat.le_refl i.val)]
    · intro inp t h1 h2
      omega

/- ══════════════════ THE OUTER (ROW) LOOP ══════════════════ -/

/-- Outer-loop invariant after `i` processed rows: `mulGates w i` gates were
    appended, nothing existing was touched, and — under the CURRENT aig —
    accumulator bit `t` evaluates to bit `t` of the pure accumulator
    `pMulAcc … i` (operand values read under the ORIGINAL aig). -/
def MulInv (aig : Aig) (a b : Slice Lit) (aig1 : Aig)
    (acc1 : alloc.vec.Vec Lit) (i : Nat) : Prop :=
  i ≤ a.val.length ∧
  aig1.nodes.val.length = aig.nodes.val.length + mulGates a.val.length i ∧
  aig.nodes.val <+: aig1.nodes.val ∧
  (∀ L, AigWF aig.nodes.val L → AigWF aig1.nodes.val L) ∧
  acc1.val.length = a.val.length ∧
  (∀ l ∈ acc1.val, l.node.val < aig1.nodes.val.length) ∧
  ∀ (inp : List Bool) (t : Nat), t < a.val.length →
    pEvalLit (pSim inp aig1.nodes.val) (acc1.val.getD t dLit)
      = (pMulAcc (wordVals (pSim inp aig.nodes.val) a.val)
          (wordVals (pSim inp aig.nodes.val) b.val)
          a.val.length i).getD t false

/-- **Outer loop spec**: after all `w` rows the accumulator denotes
    `pMulAcc … w`. -/
theorem blast_mul_loop1_spec (aig : Aig) (a b : Slice Lit) (w : Std.Usize)
    (acc : alloc.vec.Vec Lit)
    (hw : w.val = a.val.length)
    (hab : a.val.length ≤ b.val.length)
    (hcap : aig.nodes.val.length + 10 * a.val.length * a.val.length
      ≤ Usize.max)
    (ha : ∀ l ∈ a.val, l.node.val < aig.nodes.val.length)
    (hb : ∀ l ∈ b.val, l.node.val < aig.nodes.val.length)
    (hne : 0 < aig.nodes.val.length)
    (h0 : aig.nodes.val[0]'hne = Node.False)
    (hacc : acc.val = List.replicate a.val.length dLit) :
    blast_mul_loop1 aig a b w acc 0#usize ⦃ q =>
      MulInv aig a b q.2 q.1 a.val.length ⦄ := by
  unfold blast_mul_loop1
  apply loop.spec_decr_nat
    (measure := fun (s : Aig × alloc.vec.Vec Lit × Std.Usize) =>
      a.val.length - s.2.2.val)
    (inv := fun (s : Aig × alloc.vec.Vec Lit × Std.Usize) =>
      MulInv aig a b s.1 s.2.1 s.2.2.val)
  · rintro ⟨aig1, acc1, i⟩ hinv
    obtain ⟨hile, hlen1, hpre1, hwf1, halen, harng, hsem⟩ := hinv
    dsimp only at hile hlen1 hpre1 hwf1 halen harng hsem
    unfold blast_mul_loop1.body
    dsimp only
    split
    · rename_i hlt
      have hilt : i.val < a.val.length := by scalar_tac
      have hib : i.val < b.val.length := by omega
      step with lit_false_spec as ⟨carryl, hcarryl⟩
      have hne1 : 0 < aig1.nodes.val.length := by
        have := hpre1.length_le
        omega
      have h01 : aig1.nodes.val[0]'hne1 = Node.False :=
        node0_of_prefix hpre1 hne h0 hne1
      have ha1 : ∀ l ∈ a.val, l.node.val < aig1.nodes.val.length := by
        intro l hl
        have h1 := ha l hl
        have h2 := hpre1.length_le
        omega
      have hb1 : ∀ l ∈ b.val, l.node.val < aig1.nodes.val.length := by
        intro l hl
        have h1 := hb l hl
        have h2 := hpre1.length_le
        omega
      have hcapR : aig1.nodes.val.length + 10 * (a.val.length - i.val)
          ≤ Usize.max := by
        have h1 : mulGates a.val.length (i.val + 1)
            = mulGates a.val.length i.val
              + 10 * (a.val.length - i.val) := rfl
        have h2 := mulGates_le a.val.length (i.val + 1)
        have h3 : 10 * a.val.length * (i.val + 1)
            ≤ 10 * a.val.length * a.val.length :=
          Nat.mul_le_mul_left _ (by omega)
        omega
      have hcrng : carryl.node.val < aig1.nodes.val.length := by
        rw [hcarryl]
        scalar_tac
      have hcvr : ∀ inp : List Bool,
          pEvalLit (pSim inp aig1.nodes.val) carryl = false := by
        intro inp
        rw [hcarryl]
        exact pEvalLit_node_zero hne1 h01 inp false
      step with (blast_mul_row_spec aig1 a b w acc1 i carryl hw
        (by omega) hilt hib hcapR ha1 hb1 harng hcrng hcvr) as
        ⟨aig2, acc2, hr1, hr2, hr3, hr4, hr5, hr6⟩
      step as ⟨i1, hi1⟩
      refine ⟨?_, by scalar_tac⟩
      rw [hi1]
      refine ⟨by omega, ?_, hpre1.trans hr2,
        fun L hL => hr3 L (hwf1 L hL), hr4, hr5, ?_⟩
      · have h1 : mulGates a.val.length (i.val + 1)
            = mulGates a.val.length i.val
              + 10 * (a.val.length - i.val) := rfl
        omega
      · intro inp t ht
        rw [hr6 inp t ht, wordVals_stable hpre1 ha inp,
          wordVals_stable hpre1 hb inp]
        have haccV : wordVals (pSim inp aig1.nodes.val) acc1.val
            = pMulAcc (wordVals (pSim inp aig.nodes.val) a.val)
                (wordVals (pSim inp aig.nodes.val) b.val)
                a.val.length i.val := by
          apply eq_of_getD_eq (by simp [halen])
          intro u hu
          simp only [wordVals_length] at hu
          have hu' : u < a.val.length := by omega
          have huacc : u < acc1.val.length := by omega
          rw [wordVals_getD _ _ huacc, ← getD_eq_getElem_of_lt huacc dLit,
            hsem inp u hu']
        rw [haccV]
        simp only [pMulAcc]
        rw [pRow_getD _ _ _ _ (by rw [pMulAcc_length]; exact ht)]
    · rename_i hge
      have hieq : i.val = a.val.length := by scalar_tac
      rw [← hieq]
      exact ⟨hile, hlen1, hpre1, hwf1, halen, harng, hsem⟩
  · dsimp only
    refine ⟨Nat.zero_le _, by simp [mulGates], List.prefix_refl _,
      fun _ h => h, by rw [hacc]; simp, ?_, ?_⟩
    · intro l hl
      rw [hacc] at hl
      have hld : l = dLit := List.eq_of_mem_replicate hl
      rw [hld]
      simp only [dLit]
      scalar_tac
    · intro inp t ht
      simp only [hacc, dLit, List.getD_eq_getElem?_getD,
        List.getElem?_replicate, if_pos ht, Option.getD_some]
      rw [pEvalLit_node_zero hne h0 inp false]
      simp [pMulAcc, ht]

/- ══════════════ END-TO-END: BLAST THEN SIMULATE ══════════════ -/

/-- **Correctness of `blast_mul` against the simulator** (issue #68), the
    per-bit monadic headline mirroring `blast_add_correct`: after blasting,
    simulating the extended aig on ANY well-formed input assignment gives,
    for each output bit `t`, exactly bit `t` of the pure shift-add
    accumulator `pMulAcc … w` — with the operand words read under the SAME
    simulation. Requires node 0 to be the constant-FALSE node (the
    accumulator is seeded with `lit_false`, and each row's carry starts
    there). Unbounded: `a`/`b` have arbitrary length. -/
theorem blast_mul_correct (aig : Aig) (a b : Slice Lit)
    (hab : a.val.length ≤ b.val.length)
    (hcap : aig.nodes.val.length + 10 * a.val.length * a.val.length
      ≤ Usize.max)
    (ha : ∀ l ∈ a.val, l.node.val < aig.nodes.val.length)
    (hb : ∀ l ∈ b.val, l.node.val < aig.nodes.val.length)
    (hne : 0 < aig.nodes.val.length)
    (h0 : aig.nodes.val[0]'hne = Node.False) :
    blast_mul aig a b ⦃ p =>
      p.1.val.length = a.val.length ∧
      ∀ (inputs : Slice Bool), AigWF aig.nodes.val inputs.val.length →
        simulate p.2 inputs ⦃ vals =>
          ∀ (t : Nat), t < a.val.length →
            pEvalLit vals.val (p.1.val.getD t dLit)
              = (pMulAcc (wordVals vals.val a.val) (wordVals vals.val b.val)
                  a.val.length a.val.length).getD t false ⦄ ⦄ := by
  unfold blast_mul
  have hlen : (Slice.len a).val = a.val.length := by scalar_tac
  step with (blast_mul_loop0_spec (Slice.len a)) as ⟨acc0, hacc0⟩
  rw [hlen] at hacc0
  apply WP.spec_mono (blast_mul_loop1_spec aig a b (Slice.len a) acc0 hlen
    hab hcap ha hb hne h0 hacc0)
  rintro ⟨out, aigF⟩ hinv
  obtain ⟨_, _, hpre, hwf, holen, horng, hsem⟩ := hinv
  refine ⟨holen, fun inputs hwfI => ?_⟩
  apply WP.spec_mono (simulate_spec aigF inputs (hwf _ hwfI))
  intro vals hv t ht
  rw [hv, hsem inputs.val t ht, ← wordVals_stable hpre ha inputs.val,
    ← wordVals_stable hpre hb inputs.val]

/- ══════════════ THE NUMERIC BRIDGE (core `BitVec.carry`) ══════════════ -/

/-- A Boolean word reads as a `BitVec w`: right length, and every `getD`
    read (in OR out of range — both are `false` past the width) is the
    corresponding bit. -/
def DenotesBits (l : List Bool) {w : Nat} (A : BitVec w) : Prop :=
  l.length = w ∧ ∀ j : Nat, l.getD j false = A.getLsbD j

theorem denotesBits_of_denotes {vals : List Bool} {word : List Lit}
    {w : Nat} {A : BitVec w} (h : Denotes vals word w A) :
    DenotesBits (wordVals vals word) A := by
  obtain ⟨hlen, hbit⟩ := h
  refine ⟨by simp [hlen], fun j => ?_⟩
  by_cases hj : j < word.length
  · rw [wordVals_getD vals word hj, hbit j hj]
  · rw [List.getD_eq_default _ _ (by simp; omega),
      BitVec.getLsbD_of_ge _ _ (by omega)]

/-- The bitvector row `i` adds into the accumulator: the multiplicand
    shifted by `i`, masked by multiplier bit `i`. -/
def rowX {w : Nat} (A B : BitVec w) (i : Nat) : BitVec w :=
  if B.getLsbD i then A <<< i else 0#w

theorem rowX_getLsbD_low {w : Nat} (A B : BitVec w) {i t : Nat} (ht : t < i) :
    (rowX A B i).getLsbD t = false := by
  unfold rowX
  split
  · rw [BitVec.getLsbD_shiftLeft]
    simp [ht]
  · simp

/-- `rowX` has no bits below `i`, so its value vanishes mod `2^j` for
    `j ≤ i`. -/
theorem rowX_toNat_mod {w : Nat} (A B : BitVec w) {i j : Nat} (hj : j ≤ i) :
    (rowX A B i).toNat % 2 ^ j = 0 := by
  have hset : BitVec.setWidth j (rowX A B i) = 0#j := by
    apply BitVec.eq_of_getLsbD_eq
    intro t htj
    rw [BitVec.getLsbD_setWidth, rowX_getLsbD_low A B (by omega)]
    simp
  have h := congrArg BitVec.toNat hset
  rw [BitVec.toNat_setWidth] at h
  simpa using h

/-- Carries at and below column `i` vanish: `rowX` contributes nothing
    there, and the accumulator alone cannot reach `2^j`. -/
theorem carry_rowX_of_le {w : Nat} (ACC A B : BitVec w) {i j : Nat}
    (hj : j ≤ i) : BitVec.carry j ACC (rowX A B i) false = false := by
  have h0 : (rowX A B i).toNat % 2 ^ j = 0 := rowX_toNat_mod A B hj
  have hlt : ACC.toNat % 2 ^ j < 2 ^ j :=
    Nat.mod_lt _ (Nat.two_pow_pos j)
  simp only [BitVec.carry, h0, Bool.toNat_false, Nat.add_zero, ge_iff_le,
    decide_eq_false_iff_not, not_le]
  omega

/-- On denoting words the partial-product bit IS bit `j` of `rowX`
    (for `i ≤ j < w`). -/
theorem pPP_eq_rowX {pa pb : List Bool} {w : Nat} {A B : BitVec w}
    (hpa : DenotesBits pa A) (hpb : DenotesBits pb B) {i j : Nat}
    (hij : i ≤ j) (hjw : j < w) :
    pPP pa pb i j = (rowX A B i).getLsbD j := by
  unfold pPP rowX
  rw [hpa.2, hpb.2]
  cases hbi : B.getLsbD i
  · simp
  · simp [hjw, show ¬j < i by omega,
      BitVec.getLsbD_eq_getElem (show j - i < w by omega)]

/-- **The carry bridge**: the pure row carry chain coincides with core
    Lean's numerically-defined `BitVec.carry` of the truncated addition
    `ACC + rowX A B i`, for every column `j ≤ w`. -/
theorem pRowCarry_eq_carry {pa pb acc : List Bool} {w : Nat}
    {A B ACC : BitVec w} (hpa : DenotesBits pa A) (hpb : DenotesBits pb B)
    (hacc : DenotesBits acc ACC) (i : Nat) :
    ∀ j, j ≤ w →
      pRowCarry pa pb acc i j = BitVec.carry j ACC (rowX A B i) false := by
  intro j
  induction j with
  | zero =>
    intro _
    rw [carry_rowX_of_le ACC A B (Nat.zero_le i)]
    rfl
  | succ j ih =>
    intro hj
    by_cases hji : j < i
    · rw [pRowCarry_of_le _ _ _ _ (by omega : j + 1 ≤ i),
        carry_rowX_of_le ACC A B (by omega)]
    · rw [BitVec.carry_succ, pRowCarry_succ_of_ge _ _ _ (by omega),
        hacc.2 j, pPP_eq_rowX hpa hpb (by omega) (by omega), ih (by omega)]

/-- **The row bridge**: one inner-loop row over denoting words is one
    truncated `BitVec` addition — bits below `i` untouched, bits at and
    above `i` full-adder sums, carry out of bit `w-1` dropped. -/
theorem pRow_denotesBits {pa pb acc : List Bool} {w : Nat}
    {A B ACC : BitVec w} (hpa : DenotesBits pa A) (hpb : DenotesBits pb B)
    (hacc : DenotesBits acc ACC) (i : Nat) :
    DenotesBits (pRow pa pb acc i) (ACC + rowX A B i) := by
  refine ⟨by simp [hacc.1], fun j => ?_⟩
  by_cases hj : j < w
  · have hjacc : j < acc.length := by rw [hacc.1]; exact hj
    rw [pRow_getD pa pb acc i hjacc, BitVec.getLsbD_add hj]
    by_cases hji : j < i
    · rw [pRowBit_of_lt hji, hacc.2 j, rowX_getLsbD_low A B hji,
        carry_rowX_of_le ACC A B (by omega)]
      simp
    · rw [pRowBit_of_ge (by omega), hacc.2 j,
        pPP_eq_rowX hpa hpb (by omega) hj,
        pRowCarry_eq_carry hpa hpb hacc i j (by omega)]
  · rw [List.getD_eq_default _ _ (by rw [pRow_length, hacc.1]; omega),
      BitVec.getLsbD_of_ge _ _ (by omega)]

/-- The bitvector accumulator after `i` rows:
    `Σ_{r < i} (b_r ? A <<< r : 0)`, truncated to `w` bits. -/
def pAccBV {w : Nat} (A B : BitVec w) : Nat → BitVec w
  | 0 => 0#w
  | i + 1 => pAccBV A B i + rowX A B i

/-- **The accumulator bridge**: the pure Boolean accumulator denotes
    `pAccBV` after every number of rows. -/
theorem pMulAcc_denotesBits {pa pb : List Bool} {w : Nat} {A B : BitVec w}
    (hpa : DenotesBits pa A) (hpb : DenotesBits pb B) :
    ∀ i, DenotesBits (pMulAcc pa pb w i) (pAccBV A B i) := by
  intro i
  induction i with
  | zero =>
    refine ⟨by simp [pMulAcc], fun j => ?_⟩
    show (List.replicate w false).getD j false = (0#w).getLsbD j
    rw [List.getD_eq_getElem?_getD, List.getElem?_replicate]
    split <;> simp
  | succ i ih => exact pRow_denotesBits hpa hpb ih i

/-- **The numeric heart**: after `i` rows the accumulated value is
    `A · (B mod 2^i) mod 2^w` — row `i` adds `A · b_i · 2^i mod 2^w`. -/
theorem pAccBV_toNat {w : Nat} (A B : BitVec w) :
    ∀ i, (pAccBV A B i).toNat = A.toNat * (B.toNat % 2 ^ i) % 2 ^ w := by
  intro i
  induction i with
  | zero => simp [pAccBV, Nat.mod_one]
  | succ i ih =>
    have hdecomp : B.toNat % 2 ^ (i + 1)
        = B.toNat % 2 ^ i + 2 ^ i * (B.toNat / 2 ^ i % 2) := by
      rw [Nat.pow_succ]
      exact Nat.mod_mul
    have htb : B.getLsbD i = decide (B.toNat / 2 ^ i % 2 = 1) := by
      rw [show B.getLsbD i = B.toNat.testBit i from rfl,
        Nat.testBit_eq_decide_div_mod_eq]
    simp only [pAccBV, BitVec.toNat_add, ih]
    rcases Nat.mod_two_eq_zero_or_one (B.toNat / 2 ^ i) with hm | hm
    · -- multiplier bit clear: the row adds nothing
      have hbi : B.getLsbD i = false := by rw [htb, hm]; simp
      rw [hdecomp, hm]
      simp only [rowX, hbi, Bool.false_eq_true, if_false, Nat.mul_zero,
        Nat.add_zero]
      simp only [BitVec.toNat_ofNat, Nat.zero_mod, Nat.add_zero]
      exact Nat.mod_mod_of_dvd _ (dvd_refl _)
    · -- multiplier bit set: the row adds `A · 2^i mod 2^w`
      have hbi : B.getLsbD i = true := by rw [htb, hm]; simp
      rw [hdecomp, hm]
      simp only [rowX, hbi, if_true, Nat.mul_one]
      rw [BitVec.toNat_shiftLeft, Nat.shiftLeft_eq, Nat.mul_add]
      conv_rhs => rw [Nat.add_mod]

/-- After all `w` rows: `A · (B mod 2^w) mod 2^w = A · B` in `BitVec w`. -/
theorem pAccBV_last {w : Nat} (A B : BitVec w) : pAccBV A B w = A * B := by
  apply BitVec.eq_of_toNat_eq
  rw [pAccBV_toNat A B w, Nat.mod_eq_of_lt B.isLt, BitVec.toNat_mul]

/- ══════════════ THE HEADLINE: `blast_mul` IS `BitVec` MULTIPLICATION ══════════════ -/

/-- **`blast_mul` implements `BitVec` multiplication, for every width `w`**
    (issue #68, the v0.15.0 capstone): if the input words denote `A` and `B`
    under the post-blast simulation, the output word denotes `A * B` —
    truncated shift-add partial-product sum, `5·w·(w+1)` gates. -/
theorem blast_mul_bitvec (aig : Aig) (a b : Slice Lit)
    (hab : a.val.length ≤ b.val.length)
    (hcap : aig.nodes.val.length + 10 * a.val.length * a.val.length
      ≤ Usize.max)
    (ha : ∀ l ∈ a.val, l.node.val < aig.nodes.val.length)
    (hb : ∀ l ∈ b.val, l.node.val < aig.nodes.val.length)
    (hne : 0 < aig.nodes.val.length)
    (h0 : aig.nodes.val[0]'hne = Node.False)
    {w : Nat} (A B : BitVec w) :
    blast_mul aig a b ⦃ p =>
      ∀ (inputs : Slice Bool), AigWF aig.nodes.val inputs.val.length →
        simulate p.2 inputs ⦃ vals =>
          Denotes vals.val a.val w A → Denotes vals.val b.val w B →
          Denotes vals.val p.1.val w (A * B) ⦄ ⦄ := by
  apply WP.spec_mono (blast_mul_correct aig a b hab hcap ha hb hne h0)
  rintro ⟨out, aig'⟩ ⟨hlen, hsim⟩
  intro inputs hwf
  apply WP.spec_mono (hsim inputs hwf)
  intro vals hbit hA hB
  have hpa := denotesBits_of_denotes hA
  have hpb := denotesBits_of_denotes hB
  obtain ⟨hal, _⟩ := hA
  refine ⟨by omega, fun j hj => ?_⟩
  have hja : j < a.val.length := by omega
  rw [← getD_eq_getElem_of_lt hj dLit, hbit j hja, hal,
    (pMulAcc_denotesBits hpa hpb w).2 j, pAccBV_last]

end blast_kernel.spec
