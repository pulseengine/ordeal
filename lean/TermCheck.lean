/- The term-to-DAG correspondence check (issue #192, phase 7):
   `kernel::check_term_dag` is sound.

   This file is HAND-WRITTEN (Kernel.lean is generated by regen.sh and must
   not be edited). Phases 4–6 proved that `check_query` refutes, and
   `check_query_model` satisfies, the DAG a certificate carries, in the
   `dagSim` semantics of BlasterDag.lean. That DAG is the solver's: the
   caller's assertions after canonicalization (commutative operands
   reordered, comparisons mirrored, constant-valued subterms folded) and
   hash-consing. `check_term_dag` takes the TERM too — the assertions
   flattened as they were asked, variables shared by name and nothing else
   — and an untrusted index map, and checks node by node that the DAG is a
   semantics-preserving rewrite of the term along the map.

   Proof architecture:
   * The total helpers (`node_tag`, `node_f1..3`, `node_eq`, `map_at`,
     `map_node`, `swap_comm`, `mirror`, `const_at`, `cond_value`,
     `node_const`) are mirrored by pure functions and `_eq` equations, so
     the monadic model disappears early.
   * `pMapNode_val`, `pSwap_val`, `pMirror_val` are the per-rewrite
     semantic facts: an operator over corresponding operand values computes
     corresponding values; a commutative swap (`BitVec.add_comm` …) and a
     comparison mirror do not change a value.
   * `dagConst` mirrors the constant-valuedness table and `const_indep`
     says a constant-valued node's value does not depend on the inputs —
     what lets a fold be checked by the proven encoder and simulator at
     the all-false assignment. The table admits the three short-circuits
     of the evaluator behind canonicalization (an `ite` with a constant
     condition, an `and` / `or` with a deciding constant operand), whose
     condition values the Rust reads off that same simulation.
   * The main loop establishes a SYNTACTIC correspondence (`NodeCorr`) and
     the injectivity of the map on variables; `corr_values` is the pure
     induction turning it into value equality under `VarsAgree` (the two
     input assignments agree on the variables through the map).
   * `pullback` / `pushforward` transport an assignment across the map in
     each direction, so the capstones compose with `check_query_sound`
     (`check_term_unsat_sound`) and `check_query_model_sound`
     (`check_term_model_sound`); `term_verdicts_exclusive` is their
     contradiction. -/
import QueryCheck
import SatWitness

open Aeneas Aeneas.Std Result
open kernel.blast_kernel.spec

set_option maxHeartbeats 4000000

namespace kernel.spec

/- ══════════════════ THE MAP ══════════════════ -/

/-- `usize::MAX`: the map entry of a term node that has no image. -/
abbrev NONE : Std.Usize := core.num.Usize.MAX

/-- The image of term node `i` under the map (`NONE` past the end). -/
def img (map : List Std.Usize) (i : Nat) : Std.Usize := map.getD i NONE

theorem img_lt {map : List Std.Usize} {i : Nat} (hi : i < map.length) :
    img map i = map[i] := by
  simp [img, List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hi]

theorem img_ge {map : List Std.Usize} {i : Nat} (hi : map.length ≤ i) :
    img map i = NONE := by
  simp [img, List.getD_eq_getElem?_getD, List.getElem?_eq_none hi]

/-- A node index of a DAG is never `NONE` (`usize::MAX` is past any slice). -/
theorem ne_NONE_of_lt {x : Std.Usize} {n : Nat} (hn : n ≤ Usize.max) (hx : x.val < n) :
    x ≠ NONE := by
  intro h
  subst h
  simp only [NONE, core.num.Usize.MAX] at hx
  scalar_tac

theorem map_at_eq (map : Slice Std.Usize) (a : Std.Usize) :
    kernel.map_at map a = ok (img map.val a.val) := by
  unfold kernel.map_at
  try dsimp only
  split
  · rename_i hlt
    have hlt' : a.val < map.val.length := by scalar_tac
    obtain ⟨x, hx, hP⟩ := WP.spec_imp_exists (Slice.index_usize_spec map a hlt')
    rw [hx, hP, img_lt hlt']
  · rename_i hge
    have hge' : map.val.length ≤ a.val := by scalar_tac
    rw [img_ge hge']

/- ══════════════════ TAGS AND FIELDS ══════════════════ -/

/-- The pure `node_tag`. -/
def pTag : blast_kernel.DagNode → Std.Usize
  | .Var _ => 0#usize
  | .Const _ _ => 1#usize
  | .Add _ _ => 2#usize
  | .Sub _ _ => 3#usize
  | .Mul _ _ => 4#usize
  | .Udiv _ _ => 5#usize
  | .Urem _ _ => 6#usize
  | .And _ _ => 7#usize
  | .Or _ _ => 8#usize
  | .Xor _ _ => 9#usize
  | .Shl _ _ => 10#usize
  | .Lshr _ _ => 11#usize
  | .Ashr _ _ => 12#usize
  | .Rotr _ _ => 13#usize
  | .Extract _ _ _ => 14#usize
  | .Concat _ _ => 15#usize
  | .ZeroExt _ _ => 16#usize
  | .SignExt _ _ => 17#usize
  | .Ite _ _ _ => 18#usize
  | .Eq _ _ => 19#usize
  | .Ne _ _ => 20#usize
  | .Ult _ _ => 21#usize
  | .Ule _ _ => 22#usize
  | .Ugt _ _ => 23#usize
  | .Uge _ _ => 24#usize
  | .Slt _ _ => 25#usize
  | .Sle _ _ => 26#usize
  | .Sgt _ _ => 27#usize
  | .Sge _ _ => 28#usize
  | .Not _ => 29#usize
  | .BoolAnd _ _ => 30#usize
  | .BoolOr _ _ => 31#usize
  | .BvNot _ => 32#usize
  | .Neg _ => 33#usize
  | .Rotl _ _ => 34#usize
  | .Sdiv _ _ => 35#usize
  | .Srem _ _ => 36#usize

/-- The pure `node_f1`. -/
def pF1 : blast_kernel.DagNode → Std.Usize
  | .Var w => w
  | .Const s _ => s
  | .Add a _ | .Sub a _ | .Mul a _ | .Udiv a _ | .Urem a _
  | .And a _ | .Or a _ | .Xor a _
  | .Shl a _ | .Lshr a _ | .Ashr a _ | .Rotr a _ => a
  | .Extract hi _ _ => hi
  | .Concat a _ => a
  | .ZeroExt a _ | .SignExt a _ => a
  | .Ite c _ _ => c
  | .Eq a _ | .Ne a _ | .Ult a _ | .Ule a _ | .Ugt a _ | .Uge a _
  | .Slt a _ | .Sle a _ | .Sgt a _ | .Sge a _ => a
  | .Not a => a
  | .BoolAnd a _ | .BoolOr a _ => a
  | .BvNot a | .Neg a => a
  | .Rotl a _ | .Sdiv a _ | .Srem a _ => a

/-- The pure `node_f2`. -/
def pF2 : blast_kernel.DagNode → Std.Usize
  | .Var _ => 0#usize
  | .Const _ w => w
  | .Add _ b | .Sub _ b | .Mul _ b | .Udiv _ b | .Urem _ b
  | .And _ b | .Or _ b | .Xor _ b
  | .Shl _ b | .Lshr _ b | .Ashr _ b | .Rotr _ b => b
  | .Extract _ lo _ => lo
  | .Concat _ b => b
  | .ZeroExt _ by1 | .SignExt _ by1 => by1
  | .Ite _ t _ => t
  | .Eq _ b | .Ne _ b | .Ult _ b | .Ule _ b | .Ugt _ b | .Uge _ b
  | .Slt _ b | .Sle _ b | .Sgt _ b | .Sge _ b => b
  | .Not _ => 0#usize
  | .BoolAnd _ b | .BoolOr _ b => b
  | .BvNot _ | .Neg _ => 0#usize
  | .Rotl _ b | .Sdiv _ b | .Srem _ b => b

/-- The pure `node_f3`. -/
def pF3 : blast_kernel.DagNode → Std.Usize
  | .Extract _ _ a => a
  | .Ite _ _ e => e
  | _ => 0#usize

theorem node_tag_eq (n : blast_kernel.DagNode) : kernel.node_tag n = ok (pTag n) := by
  cases n <;> rfl

theorem node_f1_eq (n : blast_kernel.DagNode) : kernel.node_f1 n = ok (pF1 n) := by
  cases n <;> rfl

theorem node_f2_eq (n : blast_kernel.DagNode) : kernel.node_f2 n = ok (pF2 n) := by
  cases n <;> rfl

theorem node_f3_eq (n : blast_kernel.DagNode) : kernel.node_f3 n = ok (pF3 n) := by
  cases n <;> rfl

/-- Is a node an operator (neither a variable nor a constant)? -/
def IsOp (n : blast_kernel.DagNode) : Prop := (∀ w, n ≠ .Var w) ∧ (∀ s w, n ≠ .Const s w)

theorem pTag_eq_zero (n : blast_kernel.DagNode) : pTag n = 0#usize ↔ ∃ w, n = .Var w := by
  cases n <;> simp [pTag]

theorem pTag_eq_one (n : blast_kernel.DagNode) : pTag n = 1#usize ↔ ∃ s w, n = .Const s w := by
  cases n <;> simp [pTag]

theorem isOp_of_tag (n : blast_kernel.DagNode) (h0 : pTag n ≠ 0#usize) (h1 : pTag n ≠ 1#usize) :
    IsOp n := by
  refine ⟨fun w hw => h0 ?_, fun s w hw => h1 ?_⟩
  · subst hw; rfl
  · subst hw; rfl

/-- Peeling one `if` off an accepted boolean check. -/
theorem ite_ok_true {c : Prop} [Decidable c] {x : Result Bool}
    (h : (if c then x else ok false) = ok true) : c ∧ x = ok true := by
  by_cases hc : c
  · exact ⟨hc, by simpa [hc] using h⟩
  · simp [hc] at h

/-- **Structural equality is what `node_eq` decides**: an accepted
    comparison means the two nodes are the same (the 37 × 37 case split
    over the constructor tags and the three fields). -/
theorem node_eq_sound (a b : blast_kernel.DagNode) (h : kernel.node_eq a b = ok true) :
    a = b := by
  unfold kernel.node_eq at h
  simp only [node_tag_eq, node_f1_eq, node_f2_eq, node_f3_eq, bind_tc_ok] at h
  obtain ⟨htag, h⟩ := ite_ok_true h
  obtain ⟨h1, h⟩ := ite_ok_true h
  obtain ⟨h2, h⟩ := ite_ok_true h
  have h3 : pF3 a = pF3 b := by simpa using h
  cases a <;> cases b <;> simp [pTag] at htag <;> simp_all [pF1, pF2, pF3]

/- ══════════════════ THE PURE REWRITES ══════════════════ -/

/-- The operands of a node: the earlier nodes whose values it reads. -/
def operands : blast_kernel.DagNode → List Std.Usize
  | .Var _ => []
  | .Const _ _ => []
  | .Add a b | .Sub a b | .Mul a b | .Udiv a b | .Urem a b
  | .And a b | .Or a b | .Xor a b
  | .Shl a b | .Lshr a b | .Ashr a b | .Rotr a b => [a, b]
  | .Extract _ _ a => [a]
  | .Concat a b => [a, b]
  | .ZeroExt a _ | .SignExt a _ => [a]
  | .Ite c t e => [c, t, e]
  | .Eq a b | .Ne a b | .Ult a b | .Ule a b | .Ugt a b | .Uge a b
  | .Slt a b | .Sle a b | .Sgt a b | .Sge a b => [a, b]
  | .Not a => [a]
  | .BoolAnd a b | .BoolOr a b => [a, b]
  | .BvNot a | .Neg a => [a]
  | .Rotl a b | .Sdiv a b | .Srem a b => [a, b]

/-- The pure `map_node`: every operand replaced by its image. -/
def pMapNode (map : List Std.Usize) : blast_kernel.DagNode → blast_kernel.DagNode
  | .Var w => .Var w
  | .Const s w => .Const s w
  | .Add a b => .Add (img map a.val) (img map b.val)
  | .Sub a b => .Sub (img map a.val) (img map b.val)
  | .Mul a b => .Mul (img map a.val) (img map b.val)
  | .Udiv a b => .Udiv (img map a.val) (img map b.val)
  | .Urem a b => .Urem (img map a.val) (img map b.val)
  | .And a b => .And (img map a.val) (img map b.val)
  | .Or a b => .Or (img map a.val) (img map b.val)
  | .Xor a b => .Xor (img map a.val) (img map b.val)
  | .Shl a b => .Shl (img map a.val) (img map b.val)
  | .Lshr a b => .Lshr (img map a.val) (img map b.val)
  | .Ashr a b => .Ashr (img map a.val) (img map b.val)
  | .Rotr a b => .Rotr (img map a.val) (img map b.val)
  | .Extract hi lo a => .Extract hi lo (img map a.val)
  | .Concat a b => .Concat (img map a.val) (img map b.val)
  | .ZeroExt a by1 => .ZeroExt (img map a.val) by1
  | .SignExt a by1 => .SignExt (img map a.val) by1
  | .Ite c t e => .Ite (img map c.val) (img map t.val) (img map e.val)
  | .Eq a b => .Eq (img map a.val) (img map b.val)
  | .Ne a b => .Ne (img map a.val) (img map b.val)
  | .Ult a b => .Ult (img map a.val) (img map b.val)
  | .Ule a b => .Ule (img map a.val) (img map b.val)
  | .Ugt a b => .Ugt (img map a.val) (img map b.val)
  | .Uge a b => .Uge (img map a.val) (img map b.val)
  | .Slt a b => .Slt (img map a.val) (img map b.val)
  | .Sle a b => .Sle (img map a.val) (img map b.val)
  | .Sgt a b => .Sgt (img map a.val) (img map b.val)
  | .Sge a b => .Sge (img map a.val) (img map b.val)
  | .Not a => .Not (img map a.val)
  | .BoolAnd a b => .BoolAnd (img map a.val) (img map b.val)
  | .BoolOr a b => .BoolOr (img map a.val) (img map b.val)
  | .BvNot a => .BvNot (img map a.val)
  | .Neg a => .Neg (img map a.val)
  | .Rotl a b => .Rotl (img map a.val) (img map b.val)
  | .Sdiv a b => .Sdiv (img map a.val) (img map b.val)
  | .Srem a b => .Srem (img map a.val) (img map b.val)

theorem map_node_eq (map : Slice Std.Usize) (n : blast_kernel.DagNode) :
    kernel.map_node map n = ok (pMapNode map.val n) := by
  cases n <;> simp [kernel.map_node, map_at_eq, pMapNode]

/-- The pure `swap_comm`. -/
def pSwap : blast_kernel.DagNode → blast_kernel.DagNode
  | .Add a b => .Add b a
  | .Mul a b => .Mul b a
  | .And a b => .And b a
  | .Or a b => .Or b a
  | .Xor a b => .Xor b a
  | .Eq a b => .Eq b a
  | .Ne a b => .Ne b a
  | .BoolAnd a b => .BoolAnd b a
  | .BoolOr a b => .BoolOr b a
  | n => n

theorem swap_comm_eq (n : blast_kernel.DagNode) : kernel.swap_comm n = ok (pSwap n) := by
  cases n <;> rfl

/-- The pure `mirror`. -/
def pMirror : blast_kernel.DagNode → blast_kernel.DagNode
  | .Ult a b => .Ugt b a
  | .Ule a b => .Uge b a
  | .Ugt a b => .Ult b a
  | .Uge a b => .Ule b a
  | .Slt a b => .Sgt b a
  | .Sle a b => .Sge b a
  | .Sgt a b => .Slt b a
  | .Sge a b => .Sle b a
  | n => n

theorem mirror_eq (n : blast_kernel.DagNode) : kernel.mirror n = ok (pMirror n) := by
  cases n <;> rfl

/-- What an accepted `node_corr` means: the mapped term node IS the DAG
    node, or its commutative swap, or its mirror. -/
theorem node_corr_sound (map : Slice Std.Usize) (tn d : blast_kernel.DagNode)
    (h : kernel.node_corr map tn d = ok true) :
    pMapNode map.val tn = d ∨ pMapNode map.val tn = pSwap d ∨
      pMapNode map.val tn = pMirror d := by
  unfold kernel.node_corr at h
  simp only [map_node_eq, swap_comm_eq, mirror_eq, bind_tc_ok] at h
  obtain ⟨b, hb, h⟩ := bind_ok_inv h
  cases b with
  | true => exact Or.inl (node_eq_sound _ _ hb)
  | false =>
    simp only [Bool.false_eq_true, ↓reduceIte] at h
    obtain ⟨b1, hb1, h⟩ := bind_ok_inv h
    cases b1 with
    | true => exact Or.inr (Or.inl (node_eq_sound _ _ hb1))
    | false =>
      simp only [Bool.false_eq_true, ↓reduceIte] at h
      exact Or.inr (Or.inr (node_eq_sound _ _ h))

/-- The operands of the mapped node are the images of the operands. -/
theorem operands_pMapNode (map : List Std.Usize) (n : blast_kernel.DagNode) :
    operands (pMapNode map n) = (operands n).map (fun a => img map a.val) := by
  cases n <;> simp [operands, pMapNode]

theorem mem_operands_pSwap (d : blast_kernel.DagNode) (x : Std.Usize) :
    x ∈ operands (pSwap d) ↔ x ∈ operands d := by
  cases d <;> simp [operands, pSwap] <;> tauto

theorem mem_operands_pMirror (d : blast_kernel.DagNode) (x : Std.Usize) :
    x ∈ operands (pMirror d) ↔ x ∈ operands d := by
  cases d <;> simp [operands, pMirror] <;> tauto

/-- A well-formed node's operands are earlier nodes. -/
theorem operands_lt_of_wf {ws : List Nat} {nbits i : Nat} {d : blast_kernel.DagNode}
    (h : DagNodeWF ws nbits i d) : ∀ x ∈ operands d, x.val < i := by
  intro x hx
  cases d <;> simp [operands] at hx <;> simp [DagNodeWF] at h <;>
    rcases hx with rfl | rfl | rfl <;> omega

/-- A commutative binary node over `a`, `b` (the ones canonicalization may
    swap). -/
def CommShape (d : blast_kernel.DagNode) (a b : Std.Usize) : Prop :=
  d = .Add a b ∨ d = .Mul a b ∨ d = .And a b ∨ d = .Or a b ∨ d = .Xor a b ∨
  d = .Eq a b ∨ d = .Ne a b ∨ d = .BoolAnd a b ∨ d = .BoolOr a b

/-- A comparison over `a`, `b` (the ones canonicalization may mirror). -/
def CmpShape (d : blast_kernel.DagNode) (a b : Std.Usize) : Prop :=
  d = .Ult a b ∨ d = .Ule a b ∨ d = .Ugt a b ∨ d = .Uge a b ∨
  d = .Slt a b ∨ d = .Sle a b ∨ d = .Sgt a b ∨ d = .Sge a b

/-- A well-formed binary node's operands have one width (the swap and the
    mirror need it: `toW` is then the identity on both sides). -/
theorem operands_width_of_wf {ws : List Nat} {nbits i : Nat} {d : blast_kernel.DagNode}
    (h : DagNodeWF ws nbits i d) (a b : Std.Usize) (hd : CommShape d a b ∨ CmpShape d a b) :
    ws.getD a.val 0 = ws.getD b.val 0 := by
  rcases hd with (rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl) |
      (rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl) <;>
    simp [DagNodeWF, List.getD_eq_getElem?_getD] at h ⊢ <;> omega

theorem mem_operands_of_shape {d : blast_kernel.DagNode} {a b : Std.Usize}
    (hd : CommShape d a b ∨ CmpShape d a b) : a ∈ operands d ∧ b ∈ operands d := by
  rcases hd with (rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl) |
      (rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl) <;>
    simp [operands]

/- ══════════════════ VALUES UNDER THE REWRITES ══════════════════ -/

/-- `dagNodeVal` reads only the operands' values (and, for a variable, the
    inputs): for a non-variable node, any two value lists agreeing on the
    operands — and any inputs — give the same value. -/
theorem dagNodeVal_congr_op (nd : blast_kernel.DagNode) (hnv : ∀ w, nd ≠ .Var w)
    (inp inp' bits : List Bool) (V V' : List DVal) (nin nin' : Nat)
    (hop : ∀ a ∈ operands nd, V.getD a.val dDflt = V'.getD a.val dDflt) :
    dagNodeVal inp bits V nin nd = dagNodeVal inp' bits V' nin' nd := by
  cases nd <;> first
    | exact absurd rfl (hnv _)
    | (try simp only [operands, List.mem_cons, List.not_mem_nil, or_false,
         forall_eq_or_imp, forall_eq] at hop
       simp only [dagNodeVal]
       -- `rw`, not `simp`: the value sits in a `Sigma` whose first
       -- component indexes the second, so only a simultaneous rewrite of
       -- every occurrence is type-correct.
       try first
         | rw [hop.1, hop.2.1, hop.2.2]
         | rw [hop.1, hop.2]
         | rw [hop])

/-- An operator over corresponding operand values computes the same value
    as its mapped image over the images' values. -/
theorem pMapNode_val (map : List Std.Usize) (tn : blast_kernel.DagNode) (hop_ : IsOp tn)
    (inp0 inp1 tbits bits : List Bool) (V0 V1 : List DVal) (nin0 nin1 : Nat)
    (hop : ∀ a ∈ operands tn, V0.getD a.val dDflt = V1.getD (img map a.val).val dDflt) :
    dagNodeVal inp0 tbits V0 nin0 tn = dagNodeVal inp1 bits V1 nin1 (pMapNode map tn) := by
  obtain ⟨hnv, hnc⟩ := hop_
  cases tn <;> first
    | exact absurd rfl (hnv _)
    | exact absurd rfl (hnc _ _)
    | (simp only [operands, List.mem_cons, List.not_mem_nil, or_false,
         forall_eq_or_imp, forall_eq] at hop
       simp only [dagNodeVal, pMapNode]
       first
         | rw [hop.1, hop.2.1, hop.2.2]
         | rw [hop.1, hop.2]
         | rw [hop])

/-- `toW` is the identity on a value of the right width. -/
theorem toW_self (v : DVal) : toW v.1 v = v.2 := by
  simp [toW]

/-- A commutative swap does not change a node's value (given its operands
    have one width, as `DagWF` guarantees). -/
theorem pSwap_val (d : blast_kernel.DagNode) (inp bits : List Bool) (V : List DVal) (nin : Nat)
    (hw : ∀ a b, CommShape d a b → (V.getD a.val dDflt).1 = (V.getD b.val dDflt).1) :
    dagNodeVal inp bits V nin (pSwap d) = dagNodeVal inp bits V nin d := by
  cases d <;> simp only [pSwap] <;> try rfl
  all_goals rename_i a b
  all_goals
    have h := hw a b (by simp [CommShape])
    simp only [dagNodeVal]
    generalize V.getD a.val dDflt = VA at h ⊢
    generalize V.getD b.val dDflt = VB at h ⊢
    obtain ⟨wa, A⟩ := VA
    obtain ⟨wb, B⟩ := VB
    simp only at h
    subst h
    simp [toW, BitVec.add_comm, BitVec.mul_comm, BitVec.and_comm, BitVec.or_comm,
      BitVec.xor_comm, eq_comm, Bool.and_comm, Bool.or_comm]

/-- A comparison mirror does not change a node's value (same width
    hypothesis). -/
theorem pMirror_val (d : blast_kernel.DagNode) (inp bits : List Bool) (V : List DVal) (nin : Nat)
    (hw : ∀ a b, CmpShape d a b → (V.getD a.val dDflt).1 = (V.getD b.val dDflt).1) :
    dagNodeVal inp bits V nin (pMirror d) = dagNodeVal inp bits V nin d := by
  cases d <;> simp only [pMirror] <;> try rfl
  all_goals rename_i a b
  all_goals
    have h := hw a b (by simp [CmpShape])
    simp only [dagNodeVal]
    generalize V.getD a.val dDflt = VA at h ⊢
    generalize V.getD b.val dDflt = VB at h ⊢
    obtain ⟨wa, A⟩ := VA
    obtain ⟨wb, B⟩ := VB
    simp only at h
    subst h
    simp [toW]

/- ══════════════════ INDEXING THE SEMANTICS ══════════════════ -/

/-- The value of node `i` is its `dagNodeVal` over the earlier nodes'
    values (the value twin of `dagWidths_getD_eq`). -/
theorem dagSim_getD_eq (inp bits : List Bool) (ns : List blast_kernel.DagNode) (i : Nat)
    (hi : i < ns.length) :
    (dagSim inp bits ns).getD i dDflt
      = dagNodeVal inp bits (dagSim inp bits (ns.take i)) (dagNin (ns.take i)) ns[i] := by
  have htake : ns.take (i + 1) = ns.take i ++ [ns[i]] := by
    rw [List.take_add_one, List.getElem?_eq_getElem hi]
    simp
  have hpre := dagSim_prefix_of_prefix inp bits (List.take_prefix (i + 1) ns)
  have hlen : i < (dagSim inp bits (ns.take (i + 1))).length := by
    rw [dagSim_length, List.length_take]
    omega
  rw [getD_of_prefix hpre hlen, htake, dagSim_snoc]
  have hl : (dagSim inp bits (ns.take i)).length = i := by
    rw [dagSim_length, List.length_take]
    omega
  have := getD_snoc_length (dagSim inp bits (ns.take i))
    (dagNodeVal inp bits (dagSim inp bits (ns.take i)) (dagNin (ns.take i)) ns[i]) dDflt
  rw [hl] at this
  exact this

theorem dagSim_take_getD (inp bits : List Bool) (ns : List blast_kernel.DagNode) (i j : Nat)
    (hj : j < i) :
    (dagSim inp bits (ns.take i)).getD j dDflt = (dagSim inp bits ns).getD j dDflt := by
  by_cases hi : i ≤ ns.length
  · have hpre := dagSim_prefix_of_prefix inp bits (List.take_prefix i ns)
    rw [getD_of_prefix hpre]
    rw [dagSim_length, List.length_take]
    omega
  · rw [List.take_of_length_le (by omega)]

/- ══════════════════ CONSTANT-VALUED NODES ══════════════════ -/

/-- The pure `cond_value`: the boolean value of node `c` read off the
    simulation, `none` when out of range (the rules then do not fire). -/
def pCond (vals : List Bool) (words : List (alloc.vec.Vec blast_kernel.Lit)) (c : Nat) :
    Option Bool :=
  match words[c]? with
  | none => none
  | some v =>
    match v.val[0]? with
    | none => none
    | some l => if l.node.val < vals.length then some (pEvalLit vals l) else none

/-- The pure `node_const`, with `cv` the condition values: a constant is
    constant-valued, a variable is not, an operator is iff its operands
    are — except an `ite` with a known constant condition (through the
    branch it selects) and an `and` / `or` with a known constant operand
    that decides it. -/
def pNodeConst (cl : List Bool) (cv : Nat → Option Bool) (nd : blast_kernel.DagNode) : Bool :=
  match nd with
  | .Var _ => false
  | .Const _ _ => true
  | .Ite c t e =>
    cl.getD c.val false &&
      match cv c.val with
      | some b => if b then cl.getD t.val false else cl.getD e.val false
      | none => false
  | .BoolAnd a b =>
    decide ((cl.getD a.val false = true ∧ cv a.val = some false) ∨
      (cl.getD b.val false = true ∧ cv b.val = some false) ∨
      (cl.getD a.val false = true ∧ cl.getD b.val false = true))
  | .BoolOr a b =>
    decide ((cl.getD a.val false = true ∧ cv a.val = some true) ∨
      (cl.getD b.val false = true ∧ cv b.val = some true) ∨
      (cl.getD a.val false = true ∧ cl.getD b.val false = true))
  | _ => (operands nd).all (fun a => cl.getD a.val false)

/-- A node without a short-circuit rule. -/
def IsGeneric (nd : blast_kernel.DagNode) : Prop :=
  (∀ c t e, nd ≠ .Ite c t e) ∧ (∀ a b, nd ≠ .BoolAnd a b) ∧ (∀ a b, nd ≠ .BoolOr a b)

theorem node_kind (n : blast_kernel.DagNode) :
    (∃ c t e, n = .Ite c t e) ∨ (∃ a b, n = .BoolAnd a b) ∨ (∃ a b, n = .BoolOr a b) ∨
      IsGeneric n := by
  cases n <;> simp [IsGeneric]

theorem pNodeConst_operand {cl : List Bool} {cv : Nat → Option Bool} {nd : blast_kernel.DagNode}
    (hgen : IsGeneric nd) (h : pNodeConst cl cv nd = true) :
    ∀ a ∈ operands nd, cl.getD a.val false = true := by
  obtain ⟨h1, h2, h3⟩ := hgen
  cases nd <;> first
    | exact absurd rfl (h1 _ _ _)
    | exact absurd rfl (h2 _ _)
    | exact absurd rfl (h3 _ _)
    | (simp only [pNodeConst, operands, List.all_eq_true] at h ⊢
       first | exact h | simp at h | simp)

theorem pNodeConst_not_var {cl : List Bool} {cv : Nat → Option Bool} {nd : blast_kernel.DagNode}
    (h : pNodeConst cl cv nd = true) : ∀ w, nd ≠ .Var w := by
  intro w hw
  subst hw
  simp [pNodeConst] at h

/-- The constant-valuedness table, generalized over the accumulator. -/
def dagConstAux (cv : Nat → Option Bool) : List Bool → List blast_kernel.DagNode → List Bool
  | cl, [] => cl
  | cl, nd :: ns => dagConstAux cv (cl ++ [pNodeConst cl cv nd]) ns

/-- Which nodes are constant-valued (the pure `dag_const`). -/
def dagConst (cv : Nat → Option Bool) (ns : List blast_kernel.DagNode) : List Bool :=
  dagConstAux cv [] ns

theorem dagConstAux_append (cv : Nat → Option Bool) (cl : List Bool)
    (ns ms : List blast_kernel.DagNode) :
    dagConstAux cv cl (ns ++ ms) = dagConstAux cv (dagConstAux cv cl ns) ms := by
  induction ns generalizing cl with
  | nil => simp [dagConstAux]
  | cons nd ns ih => simp [dagConstAux, ih]

theorem dagConstAux_length (cv : Nat → Option Bool) (cl : List Bool)
    (ns : List blast_kernel.DagNode) :
    (dagConstAux cv cl ns).length = cl.length + ns.length := by
  induction ns generalizing cl with
  | nil => simp [dagConstAux]
  | cons nd ns ih =>
    simp only [dagConstAux, ih, List.length_append, List.length_cons, List.length_nil]
    omega

@[simp] theorem dagConst_length (cv : Nat → Option Bool) (ns : List blast_kernel.DagNode) :
    (dagConst cv ns).length = ns.length := by
  simp [dagConst, dagConstAux_length]

theorem dagConstAux_prefix (cv : Nat → Option Bool) (cl : List Bool)
    (ns : List blast_kernel.DagNode) : cl <+: dagConstAux cv cl ns := by
  induction ns generalizing cl with
  | nil => simp [dagConstAux]
  | cons nd ns ih => exact (List.prefix_append cl _).trans (ih _)

theorem dagConst_prefix_of_prefix (cv : Nat → Option Bool) {ns ns' : List blast_kernel.DagNode}
    (h : ns <+: ns') : dagConst cv ns <+: dagConst cv ns' := by
  obtain ⟨t, rfl⟩ := h
  unfold dagConst
  rw [dagConstAux_append]
  exact dagConstAux_prefix cv _ t

theorem dagConst_snoc (cv : Nat → Option Bool) (ns : List blast_kernel.DagNode)
    (nd : blast_kernel.DagNode) :
    dagConst cv (ns ++ [nd]) = dagConst cv ns ++ [pNodeConst (dagConst cv ns) cv nd] := by
  unfold dagConst
  rw [dagConstAux_append]
  rfl

theorem dagConst_take_getD (cv : Nat → Option Bool) (ns : List blast_kernel.DagNode) (i j : Nat)
    (hj : j < i) :
    (dagConst cv (ns.take i)).getD j false = (dagConst cv ns).getD j false := by
  by_cases hi : i ≤ ns.length
  · have hpre := dagConst_prefix_of_prefix cv (List.take_prefix i ns)
    rw [getD_of_prefix hpre]
    rw [dagConst_length, List.length_take]
    omega
  · rw [List.take_of_length_le (by omega)]

theorem dagConst_getD_eq (cv : Nat → Option Bool) (ns : List blast_kernel.DagNode) (i : Nat)
    (hi : i < ns.length) :
    (dagConst cv ns).getD i false = pNodeConst (dagConst cv (ns.take i)) cv ns[i] := by
  have htake : ns.take (i + 1) = ns.take i ++ [ns[i]] := by
    rw [List.take_add_one, List.getElem?_eq_getElem hi]
    simp
  have hpre := dagConst_prefix_of_prefix cv (List.take_prefix (i + 1) ns)
  have hlen : i < (dagConst cv (ns.take (i + 1))).length := by
    rw [dagConst_length, List.length_take]
    omega
  rw [getD_of_prefix hpre hlen, htake, dagConst_snoc]
  have hl : (dagConst cv (ns.take i)).length = i := by
    rw [dagConst_length, List.length_take]
    omega
  have := getD_snoc_length (dagConst cv (ns.take i))
    (pNodeConst (dagConst cv (ns.take i)) cv ns[i]) false
  rw [hl] at this
  exact this

/-- An `ite`'s value from its condition's and the selected branch's. -/
theorem dagNodeVal_ite (inp inp' bits : List Bool) (V V' : List DVal) (nin nin' : Nat)
    (c t e : Std.Usize)
    (hw : (V.getD t.val dDflt).1 = (V'.getD t.val dDflt).1)
    (hc : V.getD c.val dDflt = V'.getD c.val dDflt)
    (hb : bval (V.getD c.val dDflt) = true → V.getD t.val dDflt = V'.getD t.val dDflt)
    (hb' : bval (V.getD c.val dDflt) = false → V.getD e.val dDflt = V'.getD e.val dDflt) :
    dagNodeVal inp bits V nin (.Ite c t e) = dagNodeVal inp' bits V' nin' (.Ite c t e) := by
  simp only [dagNodeVal]
  rw [← hc]
  cases hbc : bval (V.getD c.val dDflt)
  · rw [hb' hbc]
    simp only [Bool.false_eq_true, ↓reduceIte]
    rw [hw]
  · rw [hb hbc]
    simp

/-- A boolean `and`'s value from a deciding operand or both. -/
theorem dagNodeVal_booland (inp inp' bits : List Bool) (V V' : List DVal) (nin nin' : Nat)
    (a b : Std.Usize)
    (h : (V.getD a.val dDflt = V'.getD a.val dDflt ∧ bval (V.getD a.val dDflt) = false) ∨
      (V.getD b.val dDflt = V'.getD b.val dDflt ∧ bval (V.getD b.val dDflt) = false) ∨
      (V.getD a.val dDflt = V'.getD a.val dDflt ∧ V.getD b.val dDflt = V'.getD b.val dDflt)) :
    dagNodeVal inp bits V nin (.BoolAnd a b) = dagNodeVal inp' bits V' nin' (.BoolAnd a b) := by
  simp only [dagNodeVal]
  rcases h with ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩
  · rw [← h1, h2]; simp
  · rw [← h1, h2]; simp
  · rw [h1, h2]

/-- A boolean `or`'s value from a deciding operand or both. -/
theorem dagNodeVal_boolor (inp inp' bits : List Bool) (V V' : List DVal) (nin nin' : Nat)
    (a b : Std.Usize)
    (h : (V.getD a.val dDflt = V'.getD a.val dDflt ∧ bval (V.getD a.val dDflt) = true) ∨
      (V.getD b.val dDflt = V'.getD b.val dDflt ∧ bval (V.getD b.val dDflt) = true) ∨
      (V.getD a.val dDflt = V'.getD a.val dDflt ∧ V.getD b.val dDflt = V'.getD b.val dDflt)) :
    dagNodeVal inp bits V nin (.BoolOr a b) = dagNodeVal inp' bits V' nin' (.BoolOr a b) := by
  simp only [dagNodeVal]
  rcases h with ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩
  · rw [← h1, h2]; simp
  · rw [← h1, h2]; simp
  · rw [h1, h2]

/-- **A constant-valued node's value does not depend on the inputs** —
    what lets a fold be checked at the all-false assignment. `cv` is right
    wherever it is `some` (as the Rust reads it off that simulation). -/
theorem const_indep (t : List blast_kernel.DagNode) (tbits : List Bool) (nbits : Nat)
    (hwf : DagWF t nbits) (cv : Nat → Option Bool)
    (hcv : ∀ c b, c < t.length → cv c = some b →
      b = bval ((dagSim (List.replicate (dagNin t) false) tbits t).getD c dDflt))
    (i : Nat) :
    ∀ (hi : i < t.length), (dagConst cv t).getD i false = true →
      ∀ inp inp' : List Bool,
        (dagSim inp tbits t).getD i dDflt = (dagSim inp' tbits t).getD i dDflt := by
  induction i using Nat.strong_induction_on with
  | _ i ih =>
  intro hi hc inp inp'
  rw [dagConst_getD_eq cv t i hi] at hc
  have hval : ∀ a : Std.Usize, a.val < i → (dagConst cv (t.take i)).getD a.val false = true →
      (dagSim inp tbits (t.take i)).getD a.val dDflt
        = (dagSim inp' tbits (t.take i)).getD a.val dDflt := by
    intro a ha hca
    rw [dagConst_take_getD cv t i a.val ha] at hca
    rw [dagSim_take_getD inp tbits t i a.val ha, dagSim_take_getD inp' tbits t i a.val ha]
    exact ih a.val ha (by omega) hca inp inp'
  have hcond : ∀ (a : Std.Usize) (b : Bool), a.val < i →
      (dagConst cv (t.take i)).getD a.val false = true → cv a.val = some b →
      bval ((dagSim inp tbits (t.take i)).getD a.val dDflt) = b := by
    intro a b ha hca hb
    rw [dagConst_take_getD cv t i a.val ha] at hca
    rw [dagSim_take_getD inp tbits t i a.val ha,
      ih a.val ha (by omega) hca inp (List.replicate (dagNin t) false)]
    exact (hcv a.val b (by omega) hb).symm
  have hwidth : ∀ a : Std.Usize,
      ((dagSim inp tbits (t.take i)).getD a.val dDflt).1
        = ((dagSim inp' tbits (t.take i)).getD a.val dDflt).1 := by
    intro a
    rw [dagSim_getD_fst, dagSim_getD_fst]
  have hlt := operands_lt_of_wf (hwf i hi)
  rw [dagSim_getD_eq inp tbits t i hi, dagSim_getD_eq inp' tbits t i hi]
  rcases node_kind t[i] with ⟨c, tt, e, hk⟩ | ⟨a, b, hk⟩ | ⟨a, b, hk⟩ | hgen
  · -- an `ite` with a known constant condition
    rw [hk] at hc hlt ⊢
    simp only [pNodeConst, Bool.and_eq_true] at hc
    obtain ⟨hcc, hsel⟩ := hc
    cases hcvc : cv c.val with
    | none => simp [hcvc] at hsel
    | some bc =>
      rw [hcvc] at hsel
      have hcl : c.val < i := hlt c (by simp [operands])
      have htl : tt.val < i := hlt tt (by simp [operands])
      have hel : e.val < i := hlt e (by simp [operands])
      have hbc := hcond c bc hcl hcc hcvc
      apply dagNodeVal_ite _ _ _ _ _ _ _ c tt e (hwidth tt) (hval c hcl hcc)
      · intro ht
        rw [hbc] at ht
        subst ht
        exact hval tt htl (by simpa using hsel)
      · intro hf
        rw [hbc] at hf
        subst hf
        exact hval e hel (by simpa using hsel)
  · -- a boolean `and` with a deciding constant operand, or two
    rw [hk] at hc hlt ⊢
    simp only [pNodeConst, decide_eq_true_eq] at hc
    have hal : a.val < i := hlt a (by simp [operands])
    have hbl : b.val < i := hlt b (by simp [operands])
    apply dagNodeVal_booland
    rcases hc with ⟨hca, hva⟩ | ⟨hcb, hvb⟩ | ⟨hca, hcb⟩
    · exact Or.inl ⟨hval a hal hca, hcond a false hal hca hva⟩
    · exact Or.inr (Or.inl ⟨hval b hbl hcb, hcond b false hbl hcb hvb⟩)
    · exact Or.inr (Or.inr ⟨hval a hal hca, hval b hbl hcb⟩)
  · -- a boolean `or`, symmetric
    rw [hk] at hc hlt ⊢
    simp only [pNodeConst, decide_eq_true_eq] at hc
    have hal : a.val < i := hlt a (by simp [operands])
    have hbl : b.val < i := hlt b (by simp [operands])
    apply dagNodeVal_boolor
    rcases hc with ⟨hca, hva⟩ | ⟨hcb, hvb⟩ | ⟨hca, hcb⟩
    · exact Or.inl ⟨hval a hal hca, hcond a true hal hca hva⟩
    · exact Or.inr (Or.inl ⟨hval b hbl hcb, hcond b true hbl hcb hvb⟩)
    · exact Or.inr (Or.inr ⟨hval a hal hca, hval b hbl hcb⟩)
  · -- every other operator: all its operands are constant-valued
    apply dagNodeVal_congr_op t[i] (pNodeConst_not_var hc)
    intro a ha
    exact hval a (hlt a ha) (pNodeConst_operand hgen hc a ha)

/- ══════════════════ THE SYNTACTIC CORRESPONDENCE ══════════════════ -/

/-- What the main loop establishes about a mapped term node `i` (node `tn`,
    image `d`): a variable to the same variable; a constant to the same
    constant; an operator either folded to a constant of its width —
    constant-valued, with the fold's value checked (`FoldOk`) — or to the
    same operator over the images of its operands up to a commutative swap
    or a comparison mirror. -/
def NodeCorr (tbits bits : List Bool) (map : List Std.Usize) (ws0 : List Nat) (cval : List Bool)
    (i : Nat) (tn d : blast_kernel.DagNode) : Prop :=
  match tn with
  | .Var w => d = .Var w
  | .Const s0 w => ∃ s1, d = .Const s1 w ∧
      ∀ j < w.val, tbits.getD (s0.val + j) false = bits.getD (s1.val + j) false
  | _ => (∃ s1 w1, d = .Const s1 w1 ∧ cval.getD i false = true ∧ ws0.getD i 0 = w1.val) ∨
      (pMapNode map tn = d ∨ pMapNode map tn = pSwap d ∨ pMapNode map tn = pMirror d)

theorem NodeCorr_var (tbits bits : List Bool) (map : List Std.Usize) (ws0 : List Nat)
    (cval : List Bool) (i : Nat) (w : Std.Usize) (d : blast_kernel.DagNode) :
    NodeCorr tbits bits map ws0 cval i (.Var w) d ↔ d = .Var w := Iff.rfl

theorem NodeCorr_const (tbits bits : List Bool) (map : List Std.Usize) (ws0 : List Nat)
    (cval : List Bool) (i : Nat) (s0 w : Std.Usize) (d : blast_kernel.DagNode) :
    NodeCorr tbits bits map ws0 cval i (.Const s0 w) d ↔ ∃ s1, d = .Const s1 w ∧
      ∀ j < w.val, tbits.getD (s0.val + j) false = bits.getD (s1.val + j) false := Iff.rfl

theorem NodeCorr_op (tbits bits : List Bool) (map : List Std.Usize) (ws0 : List Nat)
    (cval : List Bool) (i : Nat) (tn d : blast_kernel.DagNode) (hop : IsOp tn) :
    NodeCorr tbits bits map ws0 cval i tn d ↔
      (∃ s1 w1, d = .Const s1 w1 ∧ cval.getD i false = true ∧ ws0.getD i 0 = w1.val) ∨
      (pMapNode map tn = d ∨ pMapNode map tn = pSwap d ∨ pMapNode map tn = pMirror d) := by
  obtain ⟨hnv, hnc⟩ := hop
  cases tn <;> first
    | exact absurd rfl (hnv _)
    | exact absurd rfl (hnc _ _)
    | exact Iff.rfl

theorem node_shape (n : blast_kernel.DagNode) :
    (∃ w, n = .Var w) ∨ (∃ s w, n = .Const s w) ∨ IsOp n := by
  cases n <;> simp [IsOp]

/-- The value of a fold, as the check establishes it: at the all-false
    assignment, node `i`'s bits are the constant's. -/
def FoldOk (tbits bits : List Bool) (t : List blast_kernel.DagNode) (i : Nat)
    (s1 w1 : Std.Usize) : Prop :=
  ∀ j < w1.val,
    ((dagSim (List.replicate (dagNin t) false) tbits t).getD i dDflt).2.getLsbD j
      = bits.getD (s1.val + j) false

/-- The two input assignments agree on the variables, through the map: a
    mapped term variable reads the same bits as its image. (`dagNin` of a
    prefix is a node's input offset.) -/
def VarsAgree (t ns : List blast_kernel.DagNode) (map : List Std.Usize)
    (inp0 inp1 : List Bool) : Prop :=
  ∀ i (hi : i < t.length) (w : Std.Usize), t[i] = .Var w → img map i ≠ NONE →
    ∀ j < w.val, inp0.getD (dagNin (t.take i) + j) false
      = inp1.getD (dagNin (ns.take (img map i).val) + j) false

/-- Everything syntactic an accepted `check_term_dag` establishes, with
    `cv` the condition values the constant-valuedness table was built with
    (right wherever `some`). -/
structure TermCorr (t ns : List blast_kernel.DagNode) (tbits bits : List Bool)
    (map : List Std.Usize) (cv : Nat → Option Bool) : Prop where
  len : map.length = t.length
  cv_ok : ∀ c b, c < t.length → cv c = some b →
    b = bval ((dagSim (List.replicate (dagNin t) false) tbits t).getD c dDflt)
  corr : ∀ i (hi : i < t.length), img map i ≠ NONE → ∃ (hm : (img map i).val < ns.length),
    NodeCorr tbits bits map (dagWidths t) (dagConst cv t) i t[i] ns[(img map i).val]
  fold : ∀ i (hi : i < t.length), img map i ≠ NONE →
    ∀ (hm : (img map i).val < ns.length) (s1 w1 : Std.Usize),
      IsOp t[i] → ns[(img map i).val] = .Const s1 w1 → FoldOk tbits bits t i s1 w1
  inj : ∀ i i' (hi : i < t.length) (hi' : i' < t.length) (w w' : Std.Usize),
    t[i] = .Var w → t[i'] = .Var w' → img map i ≠ NONE → img map i' ≠ NONE →
    img map i = img map i' → i = i'

theorem dval_mk_congr {w : Nat} {A B : BitVec w} (h : A = B) : (⟨w, A⟩ : DVal) = ⟨w, B⟩ := by
  rw [h]

theorem bvOfFn_congr (f g : Nat → Bool) (w : Nat) (h : ∀ j < w, f j = g j) :
    bvOfFn f w = bvOfFn g w := by
  induction w with
  | zero => rfl
  | succ w ih =>
    simp only [bvOfFn]
    rw [h w (by omega), ih (fun j hj => h j (by omega))]

theorem dval_ext (v : DVal) (w : Nat) (f : Nat → Bool) (h1 : v.1 = w)
    (h2 : ∀ j < w, v.2.getLsbD j = f j) : v = ⟨w, bvOfFn f w⟩ := by
  obtain ⟨w', A⟩ := v
  simp only at h1 h2
  subst h1
  apply dval_mk_congr
  apply BitVec.eq_of_getLsbD_eq
  intro j hj
  rw [getLsbD_bvOfFn, h2 j hj]
  simp [hj]

/-- Two operands of a well-formed commutative or comparison node have one
    width, in the values of the prefix the node is computed over. -/
theorem width_agree_of_wf {ns : List blast_kernel.DagNode} {nbits m : Nat} (hm : m < ns.length)
    (hwf : DagNodeWF (dagWidths ns) nbits m ns[m]) (inp bits : List Bool) (a b : Std.Usize)
    (hd : CommShape ns[m] a b ∨ CmpShape ns[m] a b) :
    ((dagSim inp bits (ns.take m)).getD a.val dDflt).1
      = ((dagSim inp bits (ns.take m)).getD b.val dDflt).1 := by
  obtain ⟨ha, hb⟩ := mem_operands_of_shape hd
  rw [dagSim_getD_fst, dagSim_getD_fst,
    dagWidths_take_getD ns m a.val (operands_lt_of_wf hwf a ha),
    dagWidths_take_getD ns m b.val (operands_lt_of_wf hwf b hb)]
  exact operands_width_of_wf hwf a b hd

/-- **The syntactic correspondence is a semantic one**: under two input
    assignments that agree on the variables, every mapped term node has
    the value of its image. The induction over the term's nodes. -/
theorem corr_values (t ns : List blast_kernel.DagNode) (tbits bits : List Bool)
    (map : List Std.Usize) (cv : Nat → Option Bool)
    (hwf0 : DagWF t tbits.length) (hwf1 : DagWF ns bits.length)
    (hns : ns.length ≤ Usize.max) (hc : TermCorr t ns tbits bits map cv)
    (inp0 inp1 : List Bool) (hv : VarsAgree t ns map inp0 inp1) (i : Nat) :
    ∀ (hi : i < t.length), img map i ≠ NONE →
      (dagSim inp0 tbits t).getD i dDflt = (dagSim inp1 bits ns).getD (img map i).val dDflt := by
  induction i using Nat.strong_induction_on with
  | _ i ih =>
  intro hi hm
  obtain ⟨hlt, hcorr⟩ := hc.corr i hi hm
  rcases node_shape t[i] with ⟨w, hw⟩ | ⟨s0, w, hw⟩ | hop
  · -- a variable: the same variable, and the inputs agree on it
    rw [hw, NodeCorr_var] at hcorr
    rw [dagSim_getD_eq inp0 tbits t i hi, dagSim_getD_eq inp1 bits ns _ hlt, hw, hcorr]
    simp only [dagNodeVal]
    apply dval_mk_congr
    apply bvOfFn_congr
    intro j hj
    exact hv i hi w hw hm j hj
  · -- a constant: the same bits
    rw [hw, NodeCorr_const] at hcorr
    obtain ⟨s1, hd, hbits⟩ := hcorr
    rw [dagSim_getD_eq inp0 tbits t i hi, dagSim_getD_eq inp1 bits ns _ hlt, hw, hd]
    simp only [dagNodeVal]
    apply dval_mk_congr
    apply bvOfFn_congr
    intro j hj
    exact hbits j hj
  · rw [NodeCorr_op _ _ _ _ _ _ _ _ hop] at hcorr
    rcases hcorr with ⟨s1, w1, hd, hcl, hw1⟩ | hc3
    · -- folded to a constant: constant-valued, so the all-false value is THE value
      rw [const_indep t tbits tbits.length hwf0 cv hc.cv_ok i hi hcl inp0
        (List.replicate (dagNin t) false)]
      rw [dagSim_getD_eq inp1 bits ns _ hlt, hd]
      simp only [dagNodeVal]
      apply dval_ext
      · rw [dagSim_getD_fst]
        exact hw1
      · intro j hj
        exact hc.fold i hi hm hlt s1 w1 hop hd j hj
    · -- the same operator up to a swap or a mirror, over corresponding operands
      have hwfd := hwf1 _ hlt
      have hopv : ∀ a ∈ operands t[i],
          (dagSim inp0 tbits (t.take i)).getD a.val dDflt
            = (dagSim inp1 bits (ns.take (img map i).val)).getD (img map a.val).val dDflt := by
        intro a ha
        have halt : a.val < i := operands_lt_of_wf (hwf0 i hi) a ha
        have hmem : img map a.val ∈ operands ns[(img map i).val] := by
          have hin : img map a.val ∈ operands (pMapNode map t[i]) := by
            rw [operands_pMapNode]
            exact List.mem_map.mpr ⟨a, ha, rfl⟩
          rcases hc3 with h | h | h
          · rwa [h] at hin
          · rwa [h, mem_operands_pSwap] at hin
          · rwa [h, mem_operands_pMirror] at hin
        have hmlt : (img map a.val).val < (img map i).val := operands_lt_of_wf hwfd _ hmem
        have hne : img map a.val ≠ NONE := ne_NONE_of_lt hns (by omega)
        rw [dagSim_take_getD inp0 tbits t i a.val halt,
          dagSim_take_getD inp1 bits ns (img map i).val _ hmlt]
        exact ih a.val halt (by omega) hne
      rw [dagSim_getD_eq inp0 tbits t i hi, dagSim_getD_eq inp1 bits ns _ hlt]
      rw [pMapNode_val map t[i] hop inp0 inp1 tbits bits _ _ (dagNin (t.take i))
        (dagNin (ns.take (img map i).val)) hopv]
      rcases hc3 with h | h | h
      · rw [h]
      · rw [h]
        apply pSwap_val
        intro a b hab
        exact width_agree_of_wf hlt hwfd inp1 bits a b (Or.inl hab)
      · rw [h]
        apply pMirror_val
        intro a b hab
        exact width_agree_of_wf hlt hwfd inp1 bits a b (Or.inr hab)

/-- The roots agree: every term root has the value of its DAG root. -/
theorem corr_roots (t ns : List blast_kernel.DagNode) (tbits bits : List Bool)
    (map troots roots : List Std.Usize) (cv : Nat → Option Bool)
    (hwf0 : DagWF t tbits.length) (hwf1 : DagWF ns bits.length)
    (hns : ns.length ≤ Usize.max) (hc : TermCorr t ns tbits bits map cv)
    (hroots : ∀ k (hk : k < troots.length),
      (troots[k]).val < t.length ∧ img map (troots[k]).val ≠ NONE ∧
      img map (troots[k]).val = roots.getD k 0#usize)
    (inp0 inp1 : List Bool) (hv : VarsAgree t ns map inp0 inp1) :
    ∀ k (hk : k < troots.length),
      dagBool inp0 tbits t (troots[k]).val = dagBool inp1 bits ns (roots.getD k 0#usize).val := by
  intro k hk
  obtain ⟨hlt, hne, heq⟩ := hroots k hk
  unfold dagBool
  rw [corr_values t ns tbits bits map cv hwf0 hwf1 hns hc inp0 inp1 hv _ hlt hne, heq]

/- ══════════════════ TRANSPORT ══════════════════ -/

/-- The width a node contributes to the input count. -/
def varWidth : blast_kernel.DagNode → Nat
  | .Var w => w.val
  | _ => 0

theorem dagNodeNin_eq (nin : Nat) (nd : blast_kernel.DagNode) :
    dagNodeNin nin nd = nin + varWidth nd := by
  cases nd <;> simp [dagNodeNin, varWidth]

theorem dagNin_take_succ (ns : List blast_kernel.DagNode) (k : Nat) (hk : k < ns.length) :
    dagNin (ns.take (k + 1)) = dagNin (ns.take k) + varWidth ns[k] := by
  have htake : ns.take (k + 1) = ns.take k ++ [ns[k]] := by
    rw [List.take_add_one, List.getElem?_eq_getElem hk]
    simp
  rw [htake, dagNin_snoc, dagNodeNin_eq]

theorem foldl_dagNodeNin_ge (m : List blast_kernel.DagNode) (nin : Nat) :
    nin ≤ m.foldl dagNodeNin nin := by
  induction m generalizing nin with
  | nil => simp
  | cons nd m ih =>
    simp only [List.foldl_cons]
    exact le_trans (by rw [dagNodeNin_eq]; omega) (ih _)

theorem dagNin_take_mono (ns : List blast_kernel.DagNode) (i n : Nat) (h : i ≤ n) :
    dagNin (ns.take i) ≤ dagNin (ns.take n) := by
  have hsplit := List.take_append_drop i (ns.take n)
  rw [List.take_take, Nat.min_eq_left h] at hsplit
  rw [← hsplit]
  unfold dagNin
  rw [List.foldl_append]
  exact foldl_dagNodeNin_ge _ _

/-- `w` bits read by `f`. -/
def block (w : Nat) (f : Nat → Bool) : List Bool := (List.range w).map f

@[simp] theorem block_length (w : Nat) (f : Nat → Bool) : (block w f).length = w := by
  simp [block]

theorem block_getD (w : Nat) (f : Nat → Bool) (j : Nat) (hj : j < w) :
    (block w f).getD j false = f j := by
  simp [block, List.getD_eq_getElem?_getD, hj]

/-- `blk k` for every node `k < n`, concatenated in order. -/
def layoutAux (blk : Nat → List Bool) : Nat → List Bool
  | 0 => []
  | k + 1 => layoutAux blk k ++ blk k

theorem layoutAux_length (ns : List blast_kernel.DagNode) (blk : Nat → List Bool)
    (hlen : ∀ k (hk : k < ns.length), (blk k).length = varWidth ns[k]) (n : Nat)
    (hn : n ≤ ns.length) : (layoutAux blk n).length = dagNin (ns.take n) := by
  induction n with
  | zero => simp [layoutAux, dagNin]
  | succ n ih =>
    simp only [layoutAux, List.length_append]
    rw [ih (by omega), hlen n (by omega), dagNin_take_succ ns n (by omega)]

theorem layoutAux_getD (ns : List blast_kernel.DagNode) (blk : Nat → List Bool)
    (hlen : ∀ k (hk : k < ns.length), (blk k).length = varWidth ns[k]) (n : Nat)
    (hn : n ≤ ns.length) (i : Nat) (hi : i < n) (j : Nat) (hj : j < varWidth ns[i]) :
    (layoutAux blk n).getD (dagNin (ns.take i) + j) false = (blk i).getD j false := by
  induction n with
  | zero => omega
  | succ n ih =>
    simp only [layoutAux]
    rcases Nat.lt_or_ge i n with h | h
    · have hl : dagNin (ns.take i) + j < (layoutAux blk n).length := by
        rw [layoutAux_length ns blk hlen n (by omega)]
        have hmono := dagNin_take_mono ns (i + 1) n (by omega)
        rw [dagNin_take_succ ns i (by omega)] at hmono
        omega
      rw [List.getD_eq_getElem?_getD, List.getElem?_append_left hl, ← List.getD_eq_getElem?_getD]
      exact ih (by omega) h hj
    · have hin : i = n := by omega
      subst hin
      have hl : (layoutAux blk i).length = dagNin (ns.take i) :=
        layoutAux_length ns blk hlen i (by omega)
      rw [List.getD_eq_getElem?_getD, List.getElem?_append_right (by omega), hl,
        Nat.add_sub_cancel_left, ← List.getD_eq_getElem?_getD]

/-- A placeholder node for out-of-range reads (never a variable). -/
def dfltNode : blast_kernel.DagNode := .Const 0#usize 0#usize

/-- The block of term node `i`, read back from the DAG inputs through the
    map: its image's bits for a mapped variable, zeros for an unmapped one,
    nothing for a non-variable. -/
def pullBlockNode (ns : List blast_kernel.DagNode) (map : List Std.Usize) (inp1 : List Bool)
    (i : Nat) : blast_kernel.DagNode → List Bool
  | .Var w =>
    if img map i ≠ NONE then
      block w.val (fun j => inp1.getD (dagNin (ns.take (img map i).val) + j) false)
    else List.replicate w.val false
  | _ => []

def pullBlock (t ns : List blast_kernel.DagNode) (map : List Std.Usize) (inp1 : List Bool)
    (i : Nat) : List Bool :=
  pullBlockNode ns map inp1 i (t.getD i dfltNode)

/-- The term's input assignment read back from a DAG assignment. -/
def pullback (t ns : List blast_kernel.DagNode) (map : List Std.Usize) (inp1 : List Bool) :
    List Bool :=
  layoutAux (pullBlock t ns map inp1) t.length

theorem varsAgree_pullback (t ns : List blast_kernel.DagNode) (map : List Std.Usize)
    (inp1 : List Bool) : VarsAgree t ns map (pullback t ns map inp1) inp1 := by
  intro i hi w hw hm j hj
  unfold pullback
  have hlen : ∀ k (hk : k < t.length), (pullBlock t ns map inp1 k).length = varWidth t[k] := by
    intro k hk
    unfold pullBlock
    rw [getD_eq_getElem_of_lt hk]
    generalize t[k] = nd
    cases nd <;> simp [pullBlockNode, varWidth]
    split <;> simp
  have hjw : j < varWidth t[i] := by
    rw [hw]
    simpa [varWidth] using hj
  rw [layoutAux_getD t _ hlen t.length le_rfl i hi j hjw]
  unfold pullBlock
  rw [getD_eq_getElem_of_lt hi, hw]
  simp only [pullBlockNode, hm, ne_eq, not_false_eq_true, ↓reduceIte]
  exact block_getD _ _ j hj

/-- Is a node a variable? -/
def isVar : blast_kernel.DagNode → Bool
  | .Var _ => true
  | _ => false

theorem isVar_iff (n : blast_kernel.DagNode) : isVar n = true ↔ ∃ w, n = .Var w := by
  cases n <;> simp [isVar]

/-- Term node `i` is a variable mapped to DAG node `m`. -/
def Pred (t : List blast_kernel.DagNode) (map : List Std.Usize) (m i : Nat) : Prop :=
  isVar (t.getD i dfltNode) = true ∧ img map i ≠ NONE ∧ (img map i).val = m

instance (t : List blast_kernel.DagNode) (map : List Std.Usize) (m i : Nat) :
    Decidable (Pred t map m i) := by
  unfold Pred
  infer_instance

/-- The first term variable mapped to DAG node `m`, among the first `n`
    term nodes. -/
def preimageAux (t : List blast_kernel.DagNode) (map : List Std.Usize) (m : Nat) :
    Nat → Option Nat
  | 0 => none
  | i + 1 =>
    match preimageAux t map m i with
    | some r => some r
    | none => if Pred t map m i then some i else none

def preimage (t : List blast_kernel.DagNode) (map : List Std.Usize) (m : Nat) : Option Nat :=
  preimageAux t map m t.length

theorem preimageAux_some {t : List blast_kernel.DagNode} {map : List Std.Usize} {m : Nat}
    (n r : Nat) (h : preimageAux t map m n = some r) : r < n ∧ Pred t map m r := by
  induction n with
  | zero => simp [preimageAux] at h
  | succ n ih =>
    simp only [preimageAux] at h
    cases hprev : preimageAux t map m n with
    | some r' =>
      rw [hprev] at h
      simp only [Option.some.injEq] at h
      subst h
      obtain ⟨h1, h2⟩ := ih hprev
      exact ⟨by omega, h2⟩
    | none =>
      rw [hprev] at h
      by_cases hp : Pred t map m n
      · simp [hp] at h
        subst h
        exact ⟨by omega, hp⟩
      · simp [hp] at h

theorem preimageAux_none {t : List blast_kernel.DagNode} {map : List Std.Usize} {m : Nat}
    (n : Nat) (h : preimageAux t map m n = none) : ∀ i < n, ¬ Pred t map m i := by
  induction n with
  | zero => intro i hi; omega
  | succ n ih =>
    intro i hi
    simp only [preimageAux] at h
    cases hprev : preimageAux t map m n with
    | some r' => rw [hprev] at h; simp at h
    | none =>
      rw [hprev] at h
      rcases Nat.lt_or_ge i n with hlt | hge
      · exact ih hprev i hlt
      · have : i = n := by omega
        subst this
        intro hp
        simp [hp] at h

theorem preimage_eq (t : List blast_kernel.DagNode) (map : List Std.Usize)
    (hinj : ∀ i i' (hi : i < t.length) (hi' : i' < t.length) (w w' : Std.Usize),
      t[i] = .Var w → t[i'] = .Var w' → img map i ≠ NONE → img map i' ≠ NONE →
      img map i = img map i' → i = i')
    (i : Nat) (hi : i < t.length) (w : Std.Usize) (hw : t[i] = .Var w) (hm : img map i ≠ NONE) :
    preimage t map (img map i).val = some i := by
  have hp : Pred t map (img map i).val i := by
    refine ⟨?_, hm, rfl⟩
    rw [getD_eq_getElem_of_lt hi, hw]
    rfl
  unfold preimage
  cases h : preimageAux t map (img map i).val t.length with
  | none => exact absurd hp (preimageAux_none _ h i hi)
  | some r =>
    obtain ⟨hr, hv, hm', heq⟩ := preimageAux_some _ _ h
    rw [getD_eq_getElem_of_lt hr, isVar_iff] at hv
    obtain ⟨w', hw'⟩ := hv
    have : r = i := hinj r i hr hi w' w hw' hw hm' hm (UScalar.eq_of_val_eq heq)
    rw [this]

/-- The block of DAG node `m`: the bits of the term variable mapped to it,
    zeros when none is. -/
def pushBlockNode (t : List blast_kernel.DagNode) (map : List Std.Usize) (inp0 : List Bool)
    (m : Nat) : blast_kernel.DagNode → List Bool
  | .Var w =>
    match preimage t map m with
    | some i => block w.val (fun j => inp0.getD (dagNin (t.take i) + j) false)
    | none => List.replicate w.val false
  | _ => []

def pushBlock (t ns : List blast_kernel.DagNode) (map : List Std.Usize) (inp0 : List Bool)
    (m : Nat) : List Bool :=
  pushBlockNode t map inp0 m (ns.getD m dfltNode)

/-- The DAG's input assignment laid out from a term assignment. -/
def pushforward (t ns : List blast_kernel.DagNode) (map : List Std.Usize) (inp0 : List Bool) :
    List Bool :=
  layoutAux (pushBlock t ns map inp0) ns.length

theorem varsAgree_pushforward (t ns : List blast_kernel.DagNode) (tbits bits : List Bool)
    (map : List Std.Usize) (cv : Nat → Option Bool) (hc : TermCorr t ns tbits bits map cv)
    (inp0 : List Bool) : VarsAgree t ns map inp0 (pushforward t ns map inp0) := by
  intro i hi w hw hm j hj
  obtain ⟨hlt, hcorr⟩ := hc.corr i hi hm
  rw [hw, NodeCorr_var] at hcorr
  unfold pushforward
  have hlen : ∀ k (hk : k < ns.length), (pushBlock t ns map inp0 k).length = varWidth ns[k] := by
    intro k hk
    unfold pushBlock
    rw [getD_eq_getElem_of_lt hk]
    generalize ns[k] = nd
    cases nd <;> simp [pushBlockNode, varWidth]
    split <;> simp
  have hjw : j < varWidth ns[(img map i).val] := by
    rw [hcorr]
    simpa [varWidth] using hj
  rw [layoutAux_getD ns _ hlen ns.length le_rfl _ hlt j hjw]
  unfold pushBlock
  rw [getD_eq_getElem_of_lt hlt, hcorr]
  simp only [pushBlockNode]
  rw [preimage_eq t map hc.inj i hi w hw hm]
  try dsimp only
  exact (block_getD w.val (fun j => inp0.getD (dagNin (t.take i) + j) false) j hj).symm

/- ══════════════════ THE KERNEL FUNCTIONS: THE TOTAL HELPERS ══════════════════ -/

theorem const_at_eq (cval : Slice Bool) (a : Std.Usize) :
    kernel.const_at cval a = ok (cval.val.getD a.val false) := by
  unfold kernel.const_at
  try dsimp only
  split
  · rename_i hlt
    have hlt' : a.val < cval.val.length := by scalar_tac
    obtain ⟨x, hx, hP⟩ := WP.spec_imp_exists (Slice.index_usize_spec cval a hlt')
    rw [hx, hP, getD_eq_getElem_of_lt hlt']
  · rename_i hge
    have hge' : cval.val.length ≤ a.val := by scalar_tac
    simp [List.getD_eq_getElem?_getD, List.getElem?_eq_none hge']

theorem cond_value_spec (vals : Slice Bool) (words : Slice (alloc.vec.Vec blast_kernel.Lit))
    (c : Std.Usize) :
    kernel.cond_value vals words c ⦃ r =>
      r = ((pCond vals.val words.val c.val).isSome, (pCond vals.val words.val c.val).getD false) ⦄ := by
  unfold kernel.cond_value
  try dsimp only
  split
  · rename_i hlt
    have hlt' : c.val < words.val.length := by scalar_tac
    step as ⟨v, hv⟩
    have hv' : words.val[c.val] = v := hv.symm
    split
    · rename_i hpos
      have hpos' : 0 < v.val.length := by scalar_tac
      try rw [alloc.vec.Vec.index_slice_index]
      step as ⟨l, hl⟩
      have hl' : v.val[0] = l := by rw [hl]
      split
      · rename_i hn
        have hn' : l.node.val < vals.val.length := by scalar_tac
        step with (eval_lit_spec vals l hn') as ⟨b, hb⟩
        try simp only [WP.spec_ok]
        simp [pCond, List.getElem?_eq_getElem hlt', hv', List.getElem?_eq_getElem hpos', hl',
          hn', hb]
      · rename_i hn
        have hn' : ¬ l.node.val < vals.val.length := by scalar_tac
        try simp only [WP.spec_ok]
        simp [pCond, List.getElem?_eq_getElem hlt', hv', List.getElem?_eq_getElem hpos', hl',
          hn']
        try omega
    · rename_i hz
      have hz' : v.val.length ≤ 0 := by scalar_tac
      try simp only [WP.spec_ok]
      simp [pCond, List.getElem?_eq_getElem hlt', hv', List.getElem?_eq_none hz']
  · rename_i hge
    have hge' : words.val.length ≤ c.val := by scalar_tac
    try simp only [WP.spec_ok]
    simp [pCond, List.getElem?_eq_none hge']

theorem cond_value_eq (vals : Slice Bool) (words : Slice (alloc.vec.Vec blast_kernel.Lit))
    (c : Std.Usize) :
    kernel.cond_value vals words c
      = ok ((pCond vals.val words.val c.val).isSome, (pCond vals.val words.val c.val).getD false) := by
  obtain ⟨r, hr, hP⟩ := WP.spec_imp_exists (cond_value_spec vals words c)
  rw [hr, hP]

theorem ite_ok_and (x y : Bool) :
    (if x = true then ok y else ok false : Result Bool) = ok (x && y) := by
  cases x <;> simp

theorem ite_ok (b : Bool) (x y : Bool) :
    (if b = true then ok x else ok y : Result Bool) = ok (if b then x else y) := by
  cases b <;> simp

theorem ite_ok_not (y : Bool) :
    (if y = true then ok false else ok true : Result Bool) = ok (!y) := by
  cases y <;> simp

theorem ite_ok_self (y : Bool) :
    (if y = true then ok true else ok false : Result Bool) = ok y := by
  cases y <;> simp

theorem node_const_eq (cval vals : Slice Bool) (words : Slice (alloc.vec.Vec blast_kernel.Lit))
    (nd : blast_kernel.DagNode) :
    kernel.node_const cval vals words nd
      = ok (pNodeConst cval.val (pCond vals.val words.val) nd) := by
  rcases node_kind nd with ⟨c, t, e, rfl⟩ | ⟨a, b, rfl⟩ | ⟨a, b, rfl⟩ | hgen
  · simp only [kernel.node_const, cond_value_eq, const_at_eq, bind_tc_ok, pNodeConst]
    cases pCond vals.val words.val c.val with
    | none => simp
    | some bc => cases bc <;> cases cval.val.getD c.val false <;> simp
  · simp only [kernel.node_const, cond_value_eq, const_at_eq, bind_tc_ok, pNodeConst]
    cases pCond vals.val words.val a.val <;> cases pCond vals.val words.val b.val <;>
      cases cval.val.getD a.val false <;> cases cval.val.getD b.val false <;>
      simp [ite_ok_not, ite_ok_self]
    all_goals try (rename_i x y; cases x <;> cases y <;> simp [ite_ok_not, ite_ok_self])
    all_goals try (rename_i x; cases x <;> simp [ite_ok_not, ite_ok_self])
  · simp only [kernel.node_const, cond_value_eq, const_at_eq, bind_tc_ok, pNodeConst]
    cases pCond vals.val words.val a.val <;> cases pCond vals.val words.val b.val <;>
      cases cval.val.getD a.val false <;> cases cval.val.getD b.val false <;>
      simp [ite_ok_not, ite_ok_self]
    all_goals try (rename_i x y; cases x <;> cases y <;> simp [ite_ok_not, ite_ok_self])
    all_goals try (rename_i x; cases x <;> simp [ite_ok_not, ite_ok_self])
  · obtain ⟨h1, h2, h3⟩ := hgen
    cases nd <;> first
      | exact absurd rfl (h1 _ _ _)
      | exact absurd rfl (h2 _ _)
      | exact absurd rfl (h3 _ _)
      | simp [kernel.node_const, const_at_eq, ite_ok_and, pNodeConst, operands]

/-- The constant-valuedness table the kernel builds is `dagConst`. -/
theorem dag_const_loop_spec (ns : Slice blast_kernel.DagNode) (vals : Slice Bool)
    (words : Slice (alloc.vec.Vec blast_kernel.Lit)) (cval : alloc.vec.Vec Bool) (n i : Std.Usize)
    (hn : n.val = ns.val.length)
    (hinv : i.val ≤ ns.val.length ∧
      cval.val = dagConst (pCond vals.val words.val) (ns.val.take i.val)) :
    kernel.dag_const_loop ns vals words cval n i ⦃ r =>
      r.val = dagConst (pCond vals.val words.val) ns.val ⦄ := by
  unfold kernel.dag_const_loop
  apply loop.spec_decr_nat
    (measure := fun (s : alloc.vec.Vec Bool × Std.Usize) => ns.val.length - s.2.val)
    (inv := fun (s : alloc.vec.Vec Bool × Std.Usize) => s.2.val ≤ ns.val.length ∧
      s.1.val = dagConst (pCond vals.val words.val) (ns.val.take s.2.val))
  · rintro ⟨cval1, i1⟩ ⟨hle, hcv⟩
    dsimp only at hle hcv
    unfold kernel.dag_const_loop.body
    try dsimp only
    split
    · rename_i hlt
      have hilt : i1.val < ns.val.length := by scalar_tac
      have htake : ns.val.take (i1.val + 1) = ns.val.take i1.val ++ [ns.val[i1.val]] := by
        rw [List.take_add_one, List.getElem?_eq_getElem hilt]
        simp
      step as ⟨node, hnode⟩
      rw [node_const_eq]
      simp only [bind_tc_ok]
      have hcap : cval1.val.length < Usize.max := by
        have := ns.length_ineq
        rw [hcv, dagConst_length, List.length_take]
        omega
      step as ⟨cval2, hcval2⟩
      step as ⟨i2, hi2⟩
      and_intros
      · scalar_tac
      · rw [hcval2, hi2, htake, dagConst_snoc, hnode]
        have hderef : (alloc.vec.Vec.deref cval1).val = cval1.val := rfl
        rw [hderef, hcv]
      · scalar_tac
    · rename_i hge
      have hieq : i1.val = ns.val.length := by scalar_tac
      try simp only [WP.spec_ok]
      rw [hcv, hieq, List.take_length]
  · exact hinv

theorem dag_const_spec (ns : Slice blast_kernel.DagNode) (vals : Slice Bool)
    (words : Slice (alloc.vec.Vec blast_kernel.Lit)) :
    kernel.dag_const ns vals words ⦃ r => r.val = dagConst (pCond vals.val words.val) ns.val ⦄ := by
  unfold kernel.dag_const
  try dsimp only
  apply dag_const_loop_spec ns vals words _ _ _ (by simp)
  exact ⟨by simp, by simp [dagConst, dagConstAux]⟩

/- ══════════════════ THE KERNEL FUNCTIONS: THE BIT LOOPS ══════════════════ -/

theorem bits_eq_loop_spec (tbits : Slice Bool) (s0 : Std.Usize) (bits : Slice Bool)
    (s1 w j : Std.Usize)
    (h0 : s0.val + w.val ≤ tbits.val.length) (h1 : s1.val + w.val ≤ bits.val.length)
    (hinv : j.val ≤ w.val ∧ ∀ k < j.val,
      tbits.val.getD (s0.val + k) false = bits.val.getD (s1.val + k) false) :
    kernel.bits_eq_loop tbits s0 bits s1 w j ⦃ r => r = true →
      ∀ k < w.val, tbits.val.getD (s0.val + k) false = bits.val.getD (s1.val + k) false ⦄ := by
  unfold kernel.bits_eq_loop
  apply loop.spec_decr_nat
    (measure := fun (j : Std.Usize) => w.val - j.val)
    (inv := fun (j : Std.Usize) => j.val ≤ w.val ∧ ∀ k < j.val,
      tbits.val.getD (s0.val + k) false = bits.val.getD (s1.val + k) false)
  · rintro j1 ⟨hle, hk⟩
    unfold kernel.bits_eq_loop.body
    try dsimp only
    split
    · rename_i hlt
      have hjl : j1.val < w.val := by scalar_tac
      step as ⟨i, hi⟩
      have hi' : i.val < tbits.val.length := by scalar_tac
      step as ⟨b, hb⟩
      step as ⟨i1, hi1⟩
      have hi1' : i1.val < bits.val.length := by scalar_tac
      step as ⟨b1, hb1⟩
      split
      · simp
      · rename_i hne
        have hne' : b = b1 := by simpa using hne
        step as ⟨j2, hj2⟩
        and_intros
        · scalar_tac
        · intro k hk'
          rw [hj2] at hk'
          rcases Nat.lt_or_ge k j1.val with h | h
          · exact hk k h
          · have : k = j1.val := by omega
            subst this
            rw [← hi, ← hi1, getD_eq_getElem_of_lt hi', getD_eq_getElem_of_lt hi1', ← hb, ← hb1]
            exact hne'
        · scalar_tac
    · rename_i hge
      try simp only [WP.spec_ok]
      intro _ k hk'
      exact hk k (by scalar_tac)
  · exact hinv

theorem bits_eq_spec (tbits : Slice Bool) (s0 : Std.Usize) (bits : Slice Bool) (s1 w : Std.Usize) :
    kernel.bits_eq tbits s0 bits s1 w ⦃ r => r = true →
      ∀ k < w.val, tbits.val.getD (s0.val + k) false = bits.val.getD (s1.val + k) false ⦄ := by
  unfold kernel.bits_eq
  try dsimp only
  split
  · simp
  · rename_i hs0
    step as ⟨i2, hi2⟩
    split
    · simp
    · rename_i hw0
      split
      · simp
      · rename_i hs1
        step as ⟨i5, hi5⟩
        split
        · simp
        · rename_i hw1
          apply bits_eq_loop_spec tbits s0 bits s1 w 0#usize (by scalar_tac) (by scalar_tac)
          exact ⟨by simp, fun k hk => by simp at hk⟩

theorem fold_bits_ok_loop_spec (vals : Slice Bool) (word : Slice blast_kernel.Lit)
    (bits : Slice Bool) (s1 w j : Std.Usize)
    (hw : word.val.length = w.val) (h1 : s1.val + w.val ≤ bits.val.length)
    (hinv : j.val ≤ w.val ∧ ∀ k (hk : k < j.val) (hk' : k < word.val.length),
      pEvalLit vals.val word.val[k] = bits.val.getD (s1.val + k) false) :
    kernel.fold_bits_ok_loop vals word bits s1 w j ⦃ r => r = true →
      ∀ k (hk : k < word.val.length),
        pEvalLit vals.val word.val[k] = bits.val.getD (s1.val + k) false ⦄ := by
  unfold kernel.fold_bits_ok_loop
  apply loop.spec_decr_nat
    (measure := fun (j : Std.Usize) => w.val - j.val)
    (inv := fun (j : Std.Usize) => j.val ≤ w.val ∧ ∀ k (hk : k < j.val) (hk' : k < word.val.length),
      pEvalLit vals.val word.val[k] = bits.val.getD (s1.val + k) false)
  · rintro j1 ⟨hle, hk⟩
    unfold kernel.fold_bits_ok_loop.body
    try dsimp only
    split
    · rename_i hlt
      have hjl : j1.val < word.val.length := by scalar_tac
      step as ⟨l, hl⟩
      split
      · simp
      · rename_i hrng
        have hrng' : l.node.val < vals.val.length := by scalar_tac
        step with (eval_lit_spec vals l hrng') as ⟨b, hb⟩
        step as ⟨i1, hi1⟩
        have hi1' : i1.val < bits.val.length := by scalar_tac
        step as ⟨b1, hb1⟩
        split
        · simp
        · rename_i hne
          have hne' : b = b1 := by simpa using hne
          step as ⟨j2, hj2⟩
          and_intros
          · scalar_tac
          · intro k hk' hk''
            rw [hj2] at hk'
            rcases Nat.lt_or_ge k j1.val with h | h
            · exact hk k h hk''
            · have : k = j1.val := by omega
              subst this
              rw [← hl, ← hb, ← hi1, getD_eq_getElem_of_lt hi1', ← hb1]
              exact hne'
          · scalar_tac
    · rename_i hge
      try simp only [WP.spec_ok]
      intro _ k hk'
      exact hk k (by scalar_tac) hk'
  · exact hinv

theorem fold_bits_ok_spec (vals : Slice Bool) (word : Slice blast_kernel.Lit) (bits : Slice Bool)
    (s1 w : Std.Usize) :
    kernel.fold_bits_ok vals word bits s1 w ⦃ r => r = true →
      word.val.length = w.val ∧ ∀ k (hk : k < word.val.length),
        pEvalLit vals.val word.val[k] = bits.val.getD (s1.val + k) false ⦄ := by
  unfold kernel.fold_bits_ok
  try dsimp only
  split
  · simp
  · rename_i hlen
    have hlen' : word.val.length = w.val := by scalar_tac
    split
    · simp
    · rename_i hs1
      step as ⟨i3, hi3⟩
      split
      · simp
      · rename_i hw1
        apply WP.spec_mono (fold_bits_ok_loop_spec vals word bits s1 w 0#usize hlen'
          (by scalar_tac) ⟨by simp, fun k hk _ => by simp at hk⟩)
        intro r hr ht
        exact ⟨hlen', hr ht⟩

/- ══════════════════ THE KERNEL FUNCTIONS: THE ROOTS ══════════════════ -/

/-- The first `k` roots correspond. -/
def RootsCorr (troots map roots : List Std.Usize) (k : Nat) : Prop :=
  ∀ k' (hk : k' < troots.length), k' < k →
    (troots[k']).val < map.length ∧ img map (troots[k']).val ≠ NONE ∧
    img map (troots[k']).val = roots.getD k' 0#usize

theorem roots_corr_loop_spec (troots map roots : Slice Std.Usize) (m : Std.Usize) (ok1 : Bool)
    (k : Std.Usize) (hm : m.val = troots.val.length) (hlen : troots.val.length = roots.val.length)
    (hinv : k.val ≤ m.val ∧ (ok1 = true → RootsCorr troots.val map.val roots.val k.val)) :
    kernel.roots_corr_loop troots map roots m ok1 k ⦃ r => r = true →
      RootsCorr troots.val map.val roots.val troots.val.length ⦄ := by
  unfold kernel.roots_corr_loop
  apply loop.spec_decr_nat
    (measure := fun (s : Bool × Std.Usize) => m.val - s.2.val)
    (inv := fun (s : Bool × Std.Usize) => s.2.val ≤ m.val ∧
      (s.1 = true → RootsCorr troots.val map.val roots.val s.2.val))
  · rintro ⟨ok2, k1⟩ ⟨hle, hrc⟩
    dsimp only at hle hrc
    unfold kernel.roots_corr_loop.body
    try dsimp only
    split
    · rename_i hok
      split
      · rename_i hlt
        have hkl : k1.val < troots.val.length := by scalar_tac
        step as ⟨r, hr⟩
        split
        · rename_i hri
          have hri' : r.val < map.val.length := by scalar_tac
          step as ⟨image, himage⟩
          have hkr : k1.val < roots.val.length := by omega
          step as ⟨rk, hrk⟩
          split
          · rename_i hmax
            step as ⟨k2, hk2⟩
            and_intros
            · scalar_tac
            · intro h; simp at h
            · scalar_tac
          · rename_i hmax
            split
            · rename_i hne
              step as ⟨k2, hk2⟩
              and_intros
              · scalar_tac
              · intro h; simp at h
              · scalar_tac
            · rename_i heq
              have heq' : image = rk := UScalar.eq_of_val_eq (by simpa using heq)
              step as ⟨k2, hk2⟩
              and_intros
              · scalar_tac
              · intro _ k' hk' hk'lt
                rw [hk2] at hk'lt
                rcases Nat.lt_or_ge k' k1.val with h | h
                · exact hrc hok k' hk' h
                · have : k' = k1.val := by omega
                  subst this
                  rw [← hr]
                  refine ⟨hri', ?_, ?_⟩
                  · rw [img_lt hri', ← himage]
                    exact hmax
                  · rw [img_lt hri', ← himage, heq', hrk, getD_eq_getElem_of_lt hkr]
              · scalar_tac
        · rename_i hri
          step as ⟨k2, hk2⟩
          and_intros
          · scalar_tac
          · intro h; simp at h
          · scalar_tac
      · rename_i hge
        have hkeq : k1.val = troots.val.length := by scalar_tac
        try simp only [WP.spec_ok]
        intro _
        rw [← hkeq]
        exact hrc hok
    · simp
  · exact hinv

theorem roots_corr_spec (troots map roots : Slice Std.Usize) :
    kernel.roots_corr troots map roots ⦃ r => r = true →
      troots.val.length = roots.val.length ∧
      RootsCorr troots.val map.val roots.val troots.val.length ⦄ := by
  unfold kernel.roots_corr
  try dsimp only
  split
  · simp
  · rename_i hlen
    have hlen' : troots.val.length = roots.val.length := by scalar_tac
    apply WP.spec_mono (roots_corr_loop_spec troots map roots _ true 0#usize (by simp) hlen'
      ⟨by simp, fun _ k' _ hk' => by simp at hk'⟩)
    intro r hr ht
    exact ⟨hlen', hr ht⟩

/- ══════════════════ THE KERNEL FUNCTIONS: ONE TERM NODE ══════════════════ -/

/-- The fold facts for term node `i`, in terms of the simulation. -/
def FoldPost (t ns : List blast_kernel.DagNode) (bits vals : List Bool)
    (words : List (alloc.vec.Vec blast_kernel.Lit)) (i mi : Nat) (hi : i < t.length)
    (hmi : mi < ns.length) : Prop :=
  ∀ s1 w1 : Std.Usize, IsOp t[i] → ns[mi] = .Const s1 w1 →
    ∃ (hiw : i < words.length), (words[i]'hiw).val.length = w1.val ∧
      ∀ k (hk : k < (words[i]'hiw).val.length),
        pEvalLit vals (words[i]'hiw).val[k] = bits.getD (s1.val + k) false

/-- What `term_node_corr` establishes on `Ok`: the syntactic correspondence,
    the fold facts, and the bookkeeping of `seen`. -/
def NodePost (t ns : List blast_kernel.DagNode) (tbits bits : List Bool) (ws0 : List Nat)
    (cval : List Bool) (map : List Std.Usize) (vals : List Bool)
    (words : List (alloc.vec.Vec blast_kernel.Lit)) (seen : List Bool) (i mi : Nat)
    (hi : i < t.length) (hmi : mi < ns.length) (seen' : List Bool) : Prop :=
  NodeCorr tbits bits map ws0 cval i t[i] ns[mi] ∧
  FoldPost t ns bits vals words i mi hi hmi ∧
  (∀ w, t[i] = .Var w →
    ∃ (hs : mi < seen.length), seen[mi]'hs = false ∧ seen' = seen.set mi true) ∧
  ((∀ w, t[i] ≠ .Var w) → seen' = seen)

theorem node_eq_ok (a b : blast_kernel.DagNode) : ∃ r, kernel.node_eq a b = ok r := by
  unfold kernel.node_eq
  simp only [node_tag_eq, node_f1_eq, node_f2_eq, node_f3_eq, bind_tc_ok]
  split
  · split
    · split
      · exact ⟨_, rfl⟩
      · exact ⟨_, rfl⟩
    · exact ⟨_, rfl⟩
  · exact ⟨_, rfl⟩

theorem node_corr_ok (map : Slice Std.Usize) (tn d : blast_kernel.DagNode) :
    ∃ r, kernel.node_corr map tn d = ok r := by
  unfold kernel.node_corr
  simp only [map_node_eq, swap_comm_eq, mirror_eq, bind_tc_ok]
  obtain ⟨r1, h1⟩ := node_eq_ok (pMapNode map.val tn) d
  rw [h1]
  simp only [bind_tc_ok]
  split
  · exact ⟨_, rfl⟩
  · obtain ⟨r2, h2⟩ := node_eq_ok (pMapNode map.val tn) (pSwap d)
    rw [h2]
    simp only [bind_tc_ok]
    split
    · exact ⟨_, rfl⟩
    · exact node_eq_ok _ _

theorem term_node_corr_spec (t : Slice blast_kernel.DagNode) (tbits : Slice Bool)
    (ws0 : Slice Std.Usize) (cval : Slice Bool) (map : Slice Std.Usize)
    (ns : Slice blast_kernel.DagNode) (bits : Slice Bool) (vals : Slice Bool)
    (words : Slice (alloc.vec.Vec blast_kernel.Lit)) (seen : Slice Bool) (i mi : Std.Usize)
    (hi : i.val < t.val.length) (hmi : mi.val < ns.val.length)
    (hws : ws0.val.map UScalar.val = dagWidths t.val) (hseen : seen.val.length = ns.val.length)
    (hcv : cval.val.length = t.val.length) (hiw : i.val < words.val.length) :
    kernel.term_node_corr t tbits ws0 cval map ns bits vals words seen i mi ⦃ r =>
      match r with
      | (core.result.Result.Ok _, seen') =>
        NodePost t.val ns.val tbits.val bits.val (ws0.val.map UScalar.val) cval.val map.val
          vals.val words.val seen.val i.val mi.val hi hmi seen'.val
      | (core.result.Result.Err _, seen') => seen' = seen ⦄ := by
  unfold kernel.term_node_corr
  try dsimp only
  step as ⟨tn, htn⟩
  step as ⟨d, hd⟩
  simp only [node_tag_eq, node_f1_eq, node_f2_eq, bind_tc_ok]
  split
  · -- a variable
    rename_i h0
    obtain ⟨w, hw⟩ := (pTag_eq_zero tn).mp h0
    split
    · simp
    · rename_i hd0
      have hd0' : pTag d = 0#usize := UScalar.eq_of_val_eq (by simpa using hd0)
      obtain ⟨w', hw'⟩ := (pTag_eq_zero d).mp hd0'
      split
      · simp
      · rename_i hf1
        have hf1' : pF1 tn = pF1 d := UScalar.eq_of_val_eq (by simpa using hf1)
        rw [hw, hw'] at hf1'
        have hww : w = w' := by simpa [pF1] using hf1'
        have hmi' : mi.val < seen.val.length := by rw [hseen]; exact hmi
        step as ⟨b, hb⟩
        split
        · simp
        · rename_i hbf
          have hbf' : b = false := by simpa using hbf
          step as ⟨seen1, hseen1⟩
          try simp only [WP.spec_ok]
          refine ⟨?_, ?_, ?_, ?_⟩
          · rw [← htn, ← hd, hw, hw', NodeCorr_var, hww]
          · intro s1 w1 hop hc
            rw [← htn, hw] at hop
            exact absurd rfl (hop.1 w)
          · intro _ _
            refine ⟨hmi', by rw [← hb]; exact hbf', ?_⟩
            rw [hseen1]
            simp
          · intro hnv
            rw [← htn] at hnv
            exact absurd hw (hnv w)
  · rename_i h0
    split
    · -- a constant
      rename_i h1
      obtain ⟨s0, w, hw⟩ := (pTag_eq_one tn).mp h1
      split
      · simp
      · rename_i hd1
        have hd1' : pTag d = 1#usize := UScalar.eq_of_val_eq (by simpa using hd1)
        obtain ⟨s1, w', hw'⟩ := (pTag_eq_one d).mp hd1'
        split
        · simp
        · rename_i hf2
          have hf2' : pF2 tn = pF2 d := UScalar.eq_of_val_eq (by simpa using hf2)
          rw [hw, hw'] at hf2'
          have hww : w = w' := by simpa [pF2] using hf2'
          step with (bits_eq_spec tbits (pF1 tn) bits (pF1 d) (pF2 tn)) as ⟨b, hb⟩
          split
          · rename_i hbt
            try simp only [WP.spec_ok]
            refine ⟨?_, ?_, ?_, ?_⟩
            · rw [← htn, ← hd, hw, hw', NodeCorr_const]
              refine ⟨s1, by rw [hww], ?_⟩
              have := hb hbt
              rw [hw, hw'] at this
              simpa [pF1, pF2] using this
            · intro s1' w1 hop hc
              rw [← htn, hw] at hop
              exact absurd rfl (hop.2 s0 w)
            · intro w0 hw0
              rw [← htn, hw] at hw0
              cases hw0
            · intro _
              rfl
          · simp
    · rename_i h1
      have hop : IsOp tn := isOp_of_tag tn h0 h1
      split
      · -- an operator folded to a constant
        rename_i hd1
        obtain ⟨s1, w1, hw'⟩ := (pTag_eq_one d).mp hd1
        have hi' : i.val < cval.val.length := by rw [hcv]; exact hi
        step as ⟨b, hb⟩
        split
        · rename_i hbt
          have hiws : i.val < ws0.val.length := by
            have := congrArg List.length hws
            simp only [List.length_map, dagWidths_length] at this
            omega
          step as ⟨i1, hi1⟩
          split
          · simp
          · rename_i hweq
            have hweq' : i1 = pF2 d := UScalar.eq_of_val_eq (by simpa using hweq)
            step as ⟨v, hv⟩
            step with (fold_bits_ok_spec vals (alloc.vec.Vec.deref v) bits (pF1 d) (pF2 d))
              as ⟨b1, hb1⟩
            split
            · rename_i hb1t
              obtain ⟨hvlen, hvbits⟩ := hb1 hb1t
              have hvv : (alloc.vec.Vec.deref v).val = (words.val[i.val]).val := by
                rw [hv]
                rfl
              rw [hvv] at hvlen hvbits
              try simp only [WP.spec_ok]
              refine ⟨?_, ?_, ?_, ?_⟩
              · rw [← htn, ← hd, NodeCorr_op _ _ _ _ _ _ _ _ hop, hw']
                left
                refine ⟨s1, w1, rfl, ?_, ?_⟩
                · rw [getD_eq_getElem_of_lt hi', ← hb]
                  exact hbt
                · rw [getD_map_val ws0.val i.val hiws, ← hi1, hweq', hw']
                  rfl
              · intro s1' w1' _ hc
                rw [← hd, hw'] at hc
                cases hc
                refine ⟨hiw, ?_, ?_⟩
                · rw [hw'] at hvlen
                  simpa [pF2] using hvlen
                · intro k hk
                  have := hvbits k hk
                  rw [hw'] at this
                  simpa [pF1] using this
              · intro w0 hw0
                rw [← htn] at hw0
                exact absurd hw0 (hop.1 w0)
              · intro _
                rfl
            · simp
        · simp
      · -- the same operator up to a swap or a mirror
        rename_i hd1
        obtain ⟨b, hb⟩ := node_corr_ok map tn d
        rw [hb]
        simp only [bind_tc_ok]
        split
        · rename_i hbt
          subst hbt
          try simp only [WP.spec_ok]
          refine ⟨?_, ?_, ?_, ?_⟩
          · rw [← htn, ← hd, NodeCorr_op _ _ _ _ _ _ _ _ hop]
            exact Or.inr (node_corr_sound map tn d hb)
          · intro s1 w1 _ hc
            rw [← hd] at hc
            rw [hc] at hd1
            simp [pTag] at hd1
          · intro w0 hw0
            rw [← htn] at hw0
            exact absurd hw0 (hop.1 w0)
          · intro _
            rfl
        · simp

theorem term_step_spec (t : Slice blast_kernel.DagNode) (tbits : Slice Bool)
    (ws0 : Slice Std.Usize) (cval : Slice Bool) (map : Slice Std.Usize)
    (ns : Slice blast_kernel.DagNode) (bits : Slice Bool) (vals : Slice Bool)
    (words : Slice (alloc.vec.Vec blast_kernel.Lit)) (seen : Slice Bool) (i n1 : Std.Usize)
    (hi : i.val < t.val.length) (hn1 : n1.val = ns.val.length) (hmap : map.val.length = t.val.length)
    (hws : ws0.val.map UScalar.val = dagWidths t.val) (hseen : seen.val.length = ns.val.length)
    (hcv : cval.val.length = t.val.length) (hiw : i.val < words.val.length) :
    kernel.term_step t tbits ws0 cval map ns bits vals words seen i n1 ⦃ r =>
      match r with
      | (core.result.Result.Ok _, seen') =>
        (img map.val i.val = NONE ∧ seen' = seen) ∨
        (img map.val i.val ≠ NONE ∧ ∃ (hmi : (img map.val i.val).val < ns.val.length),
          NodePost t.val ns.val tbits.val bits.val (ws0.val.map UScalar.val) cval.val map.val
            vals.val words.val seen.val i.val (img map.val i.val).val hi hmi seen'.val)
      | (core.result.Result.Err _, seen') => seen' = seen ⦄ := by
  unfold kernel.term_step
  try dsimp only
  have him : i.val < map.val.length := by rw [hmap]; exact hi
  step as ⟨mi, hmi⟩
  have himg : img map.val i.val = mi := by rw [img_lt him, hmi]
  split
  · rename_i hnone
    try simp only [WP.spec_ok]
    exact Or.inl ⟨by rw [himg, hnone], by simp⟩
  · rename_i hsome
    split
    · simp
    · rename_i hlt
      have hmi' : mi.val < ns.val.length := by scalar_tac
      apply WP.spec_mono (term_node_corr_spec t tbits ws0 cval map ns bits vals words seen i mi
        hi hmi' hws hseen hcv hiw)
      intro r hr
      obtain ⟨res, seen'⟩ := r
      cases res with
      | Ok u =>
        right
        refine ⟨by rw [himg]; exact hsome, ?_⟩
        rw [himg]
        exact ⟨hmi', hr⟩
      | Err e => exact hr

/- ══════════════════ THE MAIN LOOP ══════════════════ -/

/-- The injectivity of the map on the first `n` term variables. -/
def VarInj (t : List blast_kernel.DagNode) (map : List Std.Usize) (n : Nat) : Prop :=
  ∀ i i' (hi : i < t.length) (hi' : i' < t.length), i < n → i' < n →
    ∀ (w w' : Std.Usize), t[i] = .Var w → t[i'] = .Var w' →
      img map i ≠ NONE → img map i' ≠ NONE → img map i = img map i' → i = i'

/-- What the first `n` term nodes establish. -/
def LoopFacts (t ns : List blast_kernel.DagNode) (tbits bits : List Bool) (ws0 : List Nat)
    (cval : List Bool) (map : List Std.Usize) (vals : List Bool)
    (words : List (alloc.vec.Vec blast_kernel.Lit)) (seen : List Bool) (n : Nat) : Prop :=
  (∀ j (hj : j < t.length), j < n → img map j ≠ NONE →
    ∃ (hm : (img map j).val < ns.length),
      NodeCorr tbits bits map ws0 cval j t[j] ns[(img map j).val] ∧
      FoldPost t ns bits vals words j (img map j).val hj hm) ∧
  (∀ (m : Nat) (hm : m < seen.length), seen[m] = true ↔
    ∃ (j : Nat) (hj : j < t.length) (w : Std.Usize), j < n ∧ t[j] = .Var w ∧ img map j ≠ NONE ∧
      (img map j).val = m) ∧
  VarInj t map n

def MainInv (t ns : List blast_kernel.DagNode) (tbits bits : List Bool) (ws0 : List Nat)
    (cval : List Bool) (map : List Std.Usize) (vals : List Bool)
    (words : List (alloc.vec.Vec blast_kernel.Lit))
    (s : alloc.vec.Vec Bool × Option kernel.TermError × Std.Usize) : Prop :=
  s.2.2.val ≤ t.length ∧ s.1.val.length = ns.length ∧
  (s.2.1 = none → LoopFacts t ns tbits bits ws0 cval map vals words s.1.val s.2.2.val)

theorem check_term_dag_loop2_spec (t : Slice blast_kernel.DagNode) (tbits : Slice Bool)
    (map : Slice Std.Usize) (ns : Slice blast_kernel.DagNode) (bits : Slice Bool)
    (ws0 : alloc.vec.Vec Std.Usize) (n0 n1 : Std.Usize)
    (words : alloc.vec.Vec (alloc.vec.Vec blast_kernel.Lit)) (vals cval seen : alloc.vec.Vec Bool)
    (failure : Option kernel.TermError) (i : Std.Usize)
    (hn0 : n0.val = t.val.length) (hn1 : n1.val = ns.val.length)
    (hmap : map.val.length = t.val.length) (hws : ws0.val.map UScalar.val = dagWidths t.val)
    (hcv : cval.val.length = t.val.length) (hwl : words.val.length = t.val.length)
    (hinv : MainInv t.val ns.val tbits.val bits.val (ws0.val.map UScalar.val) cval.val map.val
      vals.val words.val (seen, failure, i)) :
    kernel.check_term_dag_loop2 t tbits map ns bits ws0 n0 n1 words vals cval seen failure i ⦃ r =>
      r = none → ∃ seen' : List Bool, seen'.length = ns.val.length ∧
        LoopFacts t.val ns.val tbits.val bits.val (ws0.val.map UScalar.val) cval.val map.val
          vals.val words.val seen' t.val.length ⦄ := by
  unfold kernel.check_term_dag_loop2
  apply loop.spec_decr_nat
    (measure := fun (s : alloc.vec.Vec Bool × Option kernel.TermError × Std.Usize) =>
      t.val.length - s.2.2.val)
    (inv := MainInv t.val ns.val tbits.val bits.val (ws0.val.map UScalar.val) cval.val map.val
      vals.val words.val)
  · rintro ⟨seen1, failure1, i1⟩ ⟨hle, hslen, hfacts⟩
    dsimp only at hle hslen hfacts
    unfold kernel.check_term_dag_loop2.body
    try dsimp only
    cases failure1 with
    | some e =>
      simp only [core.option.Option.is_none, Option.isNone_some, Bool.false_eq_true, ↓reduceIte,
        WP.spec_ok]
      intro h
      cases h
    | none =>
      simp only [core.option.Option.is_none, Option.isNone_none, if_true]
      have hfacts' := hfacts rfl
      split
      · rename_i hlt
        have hilt : i1.val < t.val.length := by scalar_tac
        simp only [alloc.vec.Vec.deref_mut, lift]
        have hderef : ∀ v : alloc.vec.Vec Bool, (alloc.vec.Vec.deref v).val = v.val := fun _ => rfl
        have hderefw : (alloc.vec.Vec.deref words).val = words.val := rfl
        have hderefs : (alloc.vec.Vec.deref ws0).val = ws0.val := rfl
        step with (term_step_spec t tbits (alloc.vec.Vec.deref ws0) (alloc.vec.Vec.deref cval) map
          ns bits (alloc.vec.Vec.deref vals) (alloc.vec.Vec.deref words) ⟨seen1.val, seen1.property⟩
          i1 n1 hilt hn1 hmap (by rw [hderefs]; exact hws) (by exact hslen) (by rw [hderef]; exact hcv)
          (by rw [hderefw, hwl]; exact hilt)) as ⟨r, s5, hr⟩
        cases r with
        | Err e =>
          simp only at hr
          simp only [bind_tc_ok]
          step as ⟨i2, hi2⟩
          refine ⟨?_, by scalar_tac⟩
          refine ⟨by scalar_tac, ?_, fun h => by cases h⟩
          simp only [hr]
          exact hslen
        | Ok u =>
          simp only at hr
          simp only [bind_tc_ok]
          step as ⟨i2, hi2⟩
          refine ⟨?_, by scalar_tac⟩
          obtain ⟨hA, hB, hC⟩ := hfacts'
          rcases hr with ⟨hnone, hs⟩ | ⟨hsome, hmi, hcorr, hfold, hvar, hnvar⟩
          · -- no image: nothing changes
            refine ⟨by scalar_tac, by simp only [hs]; exact hslen, fun _ => ?_⟩
            simp only [hs]
            refine ⟨?_, ?_, ?_⟩
            · intro j hj hjn hne
              rw [hi2] at hjn
              rcases Nat.lt_or_ge j i1.val with h | h
              · exact hA j hj h hne
              · have : j = i1.val := by omega
                subst this
                exact absurd hnone hne
            · intro m hm
              rw [hB m hm]
              constructor
              · rintro ⟨j, hj, w', hjn, hw', hne, hjm⟩
                exact ⟨j, hj, w', by rw [hi2]; omega, hw', hne, hjm⟩
              · rintro ⟨j, hj, w', hjn, hw', hne, hjm⟩
                rw [hi2] at hjn
                rcases Nat.lt_or_ge j i1.val with h | h
                · exact ⟨j, hj, w', h, hw', hne, hjm⟩
                · have : j = i1.val := by omega
                  subst this
                  exact absurd hnone hne
            · intro j j' hj hj' hjn hjn' w w' hw hw' hne hne' heq
              rw [hi2] at hjn hjn'
              rcases Nat.lt_or_ge j i1.val with h | h
              · rcases Nat.lt_or_ge j' i1.val with h' | h'
                · exact hC j j' hj hj' h h' w w' hw hw' hne hne' heq
                · have : j' = i1.val := by omega
                  subst this
                  exact absurd hnone hne'
              · have : j = i1.val := by omega
                subst this
                exact absurd hnone hne
          · -- an image: one more node corresponds
            rcases node_shape t.val[i1.val] with ⟨w, hw⟩ | ⟨s0, w, hw⟩ | hop
            · -- a variable: `seen` gains its image
              obtain ⟨hmilt, hfalse, hset⟩ := hvar w hw
              refine ⟨by scalar_tac, ?_, fun _ => ?_⟩
              · simp only [hset, List.length_set]
                exact hslen
              simp only [hset]
              refine ⟨?_, ?_, ?_⟩
              · intro j hj hjn hne
                rw [hi2] at hjn
                rcases Nat.lt_or_ge j i1.val with h | h
                · exact hA j hj h hne
                · have : j = i1.val := by omega
                  subst this
                  exact ⟨hmi, hcorr, hfold⟩
              · intro m hm
                rw [List.length_set] at hm
                rw [List.getElem_set]
                constructor
                · intro h
                  split at h
                  · rename_i hmm
                    exact ⟨i1.val, hilt, w, by rw [hi2]; omega, hw, hsome, by omega⟩
                  · obtain ⟨j, hj, w', hjn, hw', hne, hjm⟩ := (hB m hm).mp h
                    exact ⟨j, hj, w', by rw [hi2]; omega, hw', hne, hjm⟩
                · rintro ⟨j, hj, w', hjn, hw', hne, hjm⟩
                  rw [hi2] at hjn
                  split
                  · rfl
                  · rename_i hmm
                    rcases Nat.lt_or_ge j i1.val with h | h
                    · exact (hB m hm).mpr ⟨j, hj, w', h, hw', hne, hjm⟩
                    · have : j = i1.val := by omega
                      subst this
                      exact absurd (by omega) hmm
              · intro j j' hj hj' hjn hjn' w0 w0' hw0 hw0' hne hne' heq
                rw [hi2] at hjn hjn'
                -- an earlier variable with the same image would have marked `seen`
                have hmark : ∀ j0 (hj0 : j0 < t.val.length), j0 < i1.val → ∀ w0, t.val[j0] = .Var w0 →
                    img map.val j0 ≠ NONE → img map.val j0 = img map.val i1.val → False := by
                  intro j0 hj0 hj0n w1 hw1 hne1 heq1
                  have : seen1.val[(img map.val i1.val).val] = true :=
                    (hB _ hmilt).mpr ⟨j0, hj0, w1, hj0n, hw1, hne1, by rw [heq1]⟩
                  rw [hfalse] at this
                  cases this
                rcases Nat.lt_or_ge j i1.val with h | h
                · rcases Nat.lt_or_ge j' i1.val with h' | h'
                  · exact hC j j' hj hj' h h' w0 w0' hw0 hw0' hne hne' heq
                  · have : j' = i1.val := by omega
                    subst this
                    exact absurd heq (fun heq => hmark j hj h w0 hw0 hne heq)
                · have : j = i1.val := by omega
                  subst this
                  rcases Nat.lt_or_ge j' i1.val with h' | h'
                  · exact absurd heq.symm (fun heq => hmark j' hj' h' w0' hw0' hne' heq)
                  · omega
            · -- a constant: `seen` unchanged
              have hs := hnvar (fun w0 hw0 => by rw [hw] at hw0; cases hw0)
              refine ⟨by scalar_tac, by simp only [hs]; exact hslen, fun _ => ?_⟩
              simp only [hs]
              refine ⟨?_, ?_, ?_⟩
              · intro j hj hjn hne
                rw [hi2] at hjn
                rcases Nat.lt_or_ge j i1.val with h | h
                · exact hA j hj h hne
                · have : j = i1.val := by omega
                  subst this
                  exact ⟨hmi, hcorr, hfold⟩
              · intro m hm
                rw [hB m hm]
                constructor
                · rintro ⟨j, hj, w', hjn, hw', hne, hjm⟩
                  exact ⟨j, hj, w', by rw [hi2]; omega, hw', hne, hjm⟩
                · rintro ⟨j, hj, w', hjn, hw', hne, hjm⟩
                  rw [hi2] at hjn
                  rcases Nat.lt_or_ge j i1.val with h | h
                  · exact ⟨j, hj, w', h, hw', hne, hjm⟩
                  · have : j = i1.val := by omega
                    subst this
                    rw [hw] at hw'
                    cases hw'
              · intro j j' hj hj' hjn hjn' w0 w0' hw0 hw0' hne hne' heq
                rw [hi2] at hjn hjn'
                rcases Nat.lt_or_ge j i1.val with h | h
                · rcases Nat.lt_or_ge j' i1.val with h' | h'
                  · exact hC j j' hj hj' h h' w0 w0' hw0 hw0' hne hne' heq
                  · have : j' = i1.val := by omega
                    subst this
                    rw [hw] at hw0'
                    cases hw0'
                · have : j = i1.val := by omega
                  subst this
                  rw [hw] at hw0
                  cases hw0
            · -- an operator: `seen` unchanged
              have hs := hnvar hop.1
              refine ⟨by scalar_tac, by simp only [hs]; exact hslen, fun _ => ?_⟩
              simp only [hs]
              refine ⟨?_, ?_, ?_⟩
              · intro j hj hjn hne
                rw [hi2] at hjn
                rcases Nat.lt_or_ge j i1.val with h | h
                · exact hA j hj h hne
                · have : j = i1.val := by omega
                  subst this
                  exact ⟨hmi, hcorr, hfold⟩
              · intro m hm
                rw [hB m hm]
                constructor
                · rintro ⟨j, hj, w', hjn, hw', hne, hjm⟩
                  exact ⟨j, hj, w', by rw [hi2]; omega, hw', hne, hjm⟩
                · rintro ⟨j, hj, w', hjn, hw', hne, hjm⟩
                  rw [hi2] at hjn
                  rcases Nat.lt_or_ge j i1.val with h | h
                  · exact ⟨j, hj, w', h, hw', hne, hjm⟩
                  · have : j = i1.val := by omega
                    subst this
                    exact absurd hw' (hop.1 w')
              · intro j j' hj hj' hjn hjn' w0 w0' hw0 hw0' hne hne' heq
                rw [hi2] at hjn hjn'
                rcases Nat.lt_or_ge j i1.val with h | h
                · rcases Nat.lt_or_ge j' i1.val with h' | h'
                  · exact hC j j' hj hj' h h' w0 w0' hw0 hw0' hne hne' heq
                  · have : j' = i1.val := by omega
                    subst this
                    exact absurd hw0' (hop.1 w0')
                · have : j = i1.val := by omega
                  subst this
                  exact absurd hw0 (hop.1 w0)
      · rename_i hge
        have hieq : i1.val = t.val.length := by scalar_tac
        try simp only [WP.spec_ok]
        intro _
        refine ⟨seen1.val, hslen, ?_⟩
        rw [← hieq]
        exact hfacts rfl
  · exact hinv

/- ══════════════════ THE REPLICATE LOOPS ══════════════════ -/

theorem check_term_dag_loop0_spec (nin : Std.Usize) (inp : alloc.vec.Vec Bool) (k : Std.Usize)
    (hinv : k.val ≤ nin.val ∧ inp.val = List.replicate k.val false) :
    kernel.check_term_dag_loop0 nin inp k ⦃ r => r.val = List.replicate nin.val false ⦄ := by
  unfold kernel.check_term_dag_loop0
  apply loop.spec_decr_nat
    (measure := fun (s : alloc.vec.Vec Bool × Std.Usize) => nin.val - s.2.val)
    (inv := fun (s : alloc.vec.Vec Bool × Std.Usize) => s.2.val ≤ nin.val ∧
      s.1.val = List.replicate s.2.val false)
  · rintro ⟨inp1, k1⟩ ⟨hle, hv⟩
    dsimp only at hle hv
    unfold kernel.check_term_dag_loop0.body
    try dsimp only
    split
    · rename_i hlt
      have hcap : inp1.val.length < Usize.max := by
        rw [hv, List.length_replicate]
        scalar_tac
      step as ⟨inp2, hinp2⟩
      step as ⟨k2, hk2⟩
      and_intros
      · scalar_tac
      · rw [hinp2, hk2, hv, List.replicate_succ']
      · scalar_tac
    · rename_i hge
      have : k1.val = nin.val := by scalar_tac
      try simp only [WP.spec_ok]
      rw [hv, this]
  · exact hinv

theorem check_term_dag_loop1_spec (n1 : Std.Usize) (seen : alloc.vec.Vec Bool) (k : Std.Usize)
    (hinv : k.val ≤ n1.val ∧ seen.val = List.replicate k.val false) :
    kernel.check_term_dag_loop1 n1 seen k ⦃ r => r.val = List.replicate n1.val false ⦄ := by
  unfold kernel.check_term_dag_loop1
  apply loop.spec_decr_nat
    (measure := fun (s : alloc.vec.Vec Bool × Std.Usize) => n1.val - s.2.val)
    (inv := fun (s : alloc.vec.Vec Bool × Std.Usize) => s.2.val ≤ n1.val ∧
      s.1.val = List.replicate s.2.val false)
  · rintro ⟨seen1, k1⟩ ⟨hle, hv⟩
    dsimp only at hle hv
    unfold kernel.check_term_dag_loop1.body
    try dsimp only
    split
    · rename_i hlt
      have hcap : seen1.val.length < Usize.max := by
        rw [hv, List.length_replicate]
        scalar_tac
      step as ⟨seen2, hseen2⟩
      step as ⟨k2, hk2⟩
      and_intros
      · scalar_tac
      · rw [hseen2, hk2, hv, List.replicate_succ']
      · scalar_tac
    · rename_i hge
      have : k1.val = n1.val := by scalar_tac
      try simp only [WP.spec_ok]
      rw [hv, this]
  · exact hinv

/- ══════════════════ THE ENTRY POINT ══════════════════ -/

/-- Everything an accepted `check_term_dag` establishes: the syntactic
    correspondence (with the condition values the table was built from),
    the DAG's well-formedness, and the root correspondence. -/
theorem check_term_dag_accepted (t : Slice blast_kernel.DagNode) (tbits : Slice Bool)
    (troots map : Slice Std.Usize) (ns : Slice blast_kernel.DagNode) (bits : Slice Bool)
    (roots : Slice Std.Usize)
    (h : kernel.check_term_dag t tbits troots map ns bits roots = ok (core.result.Result.Ok ())) :
    DagWF t.val tbits.val.length ∧ DagWF ns.val bits.val.length ∧
    (∃ cv, TermCorr t.val ns.val tbits.val bits.val map.val cv) ∧
    troots.val.length = roots.val.length ∧
    RootsCorr troots.val map.val roots.val troots.val.length := by
  unfold kernel.check_term_dag at h
  dsimp only at h
  -- dag_wf on the term
  obtain ⟨r, hr, h⟩ := bind_ok_inv h
  have hP := dag_wf_spec t (Slice.len tbits)
  rw [hr, WP.spec_ok] at hP
  cases r with
  | Err e => try dsimp only at h; simp at h
  | Ok ws0 =>
  try dsimp only at h
  obtain ⟨hws, hdag0⟩ := hP
  have hdag0' : DagWF t.val tbits.val.length := by simpa using hdag0
  have hlen0 : ws0.val.length = t.val.length := by
    have := congrArg List.length hws
    simpa using this
  -- dag_wf on the DAG
  obtain ⟨r1, hr1, h⟩ := bind_ok_inv h
  have hP1 := dag_wf_spec ns (Slice.len bits)
  rw [hr1, WP.spec_ok] at hP1
  cases r1 with
  | Err e => try dsimp only at h; simp at h
  | Ok ws1 =>
  try dsimp only at h
  obtain ⟨hws1, hdag1⟩ := hP1
  have hdag1' : DagWF ns.val bits.val.length := by simpa using hdag1
  -- the map's length
  split at h
  · simp at h
  · rename_i hmaplen
    have hmap : map.val.length = t.val.length := by scalar_tac
    -- max_width, encode_fits
    obtain ⟨wmax, hwmax, h⟩ := bind_ok_inv h
    have hPw := max_width_spec (alloc.vec.Vec.deref ws0)
    rw [hwmax, WP.spec_ok] at hPw
    have hW : ∀ w ∈ dagWidths t.val, w ≤ wmax.val := by
      intro w hw
      rw [← hws, List.mem_map] at hw
      obtain ⟨u, hu, rfl⟩ := hw
      exact hPw u hu
    obtain ⟨b, hb, h⟩ := bind_ok_inv h
    have hPb := encode_fits_spec wmax (Slice.len t)
    rw [hb, WP.spec_ok] at hPb
    split at h
    · rename_i hbt
      have hcap : 1 + t.val.length * gateBound wmax.val ≤ Usize.max := by
        simpa using hPb hbt
      -- dag_nin
      obtain ⟨r2, hr2, h⟩ := bind_ok_inv h
      have hPn := dag_nin_spec t
      rw [hr2, WP.spec_ok] at hPn
      cases r2 with
      | Err e => try dsimp only at h; simp at h
      | Ok nin =>
      try dsimp only at h
      have hnin : nin.val = dagNin t.val := hPn
      -- the all-false assignment
      obtain ⟨inp, hinp, h⟩ := bind_ok_inv h
      have hPi := check_term_dag_loop0_spec nin (alloc.vec.Vec.new Bool) 0#usize ⟨by simp, by simp⟩
      rw [hinp, WP.spec_ok] at hPi
      -- aig_new, encode, simulate
      obtain ⟨aig0, hnew, h⟩ := bind_ok_inv h
      obtain ⟨p, henc, h⟩ := bind_ok_inv h
      obtain ⟨⟨words, outs⟩, aig1⟩ := p
      obtain ⟨vals, hsim, h⟩ := bind_ok_inv h
      have h0list := aig_new_fresh aig0 hnew
      have hne0 : 0 < aig0.nodes.val.length := by rw [h0list]; simp
      have h00 : aig0.nodes.val[0]'hne0 = kernel.blast_kernel.Node.False := by simp [h0list]
      have hwf0 : AigWF aig0.nodes.val 0 := by
        intro i hi
        have hi0 : i = 0 := by
          rw [h0list] at hi
          simp only [List.length_singleton] at hi
          omega
        subst hi0
        rw [h00]
        trivial
      have hcap0 : aig0.nodes.val.length + t.val.length * gateBound wmax.val ≤ Usize.max := by
        rw [h0list]
        simpa using hcap
      have hroots0 : ∀ r ∈ (alloc.vec.Vec.deref (alloc.vec.Vec.new Std.Usize)).val,
          r.val < t.val.length ∧ (dagWidths t.val).getD r.val 0 = 1 := by
        intro r hr
        simp [alloc.vec.Vec.deref, alloc.vec.Vec.new] at hr
      obtain ⟨y, hy, hPenc⟩ := WP.spec_imp_exists
        (encode_sound aig0 t tbits (alloc.vec.Vec.deref (alloc.vec.Vec.new Std.Usize)) wmax.val
          hne0 h00 hwf0 hdag0' hW hcap0 hroots0)
      rw [henc] at hy
      have hy' := Result.ok.inj hy
      subst hy'
      obtain ⟨_, hwf1, hwlen, hden, _, _, _⟩ := hPenc
      dsimp only at hwf1 hwlen hden
      have hinplen : (alloc.vec.Vec.deref inp).val.length = dagNin t.val := by
        show inp.val.length = dagNin t.val
        rw [hPi, List.length_replicate, hnin]
      have hwf1' : AigWF aig1.nodes.val (alloc.vec.Vec.deref inp).val.length := by
        rw [hinplen]; exact hwf1
      have hS := simulate_spec aig1 (alloc.vec.Vec.deref inp) hwf1'
      rw [hsim, WP.spec_ok] at hS
      have hvals : vals.val = pSim (List.replicate (dagNin t.val) false) aig1.nodes.val := by
        rw [hS]
        show pSim inp.val aig1.nodes.val = _
        rw [hPi, hnin]
      -- dag_const
      obtain ⟨cval, hcval, h⟩ := bind_ok_inv h
      have hPc := dag_const_spec t (alloc.vec.Vec.deref vals) (alloc.vec.Vec.deref words)
      rw [hcval, WP.spec_ok] at hPc
      have hcvalv : cval.val = dagConst (pCond vals.val words.val) t.val := hPc
      have hcvlen : cval.val.length = t.val.length := by rw [hcvalv, dagConst_length]
      -- seen
      obtain ⟨seen, hseen, h⟩ := bind_ok_inv h
      have hPs := check_term_dag_loop1_spec (Slice.len ns) (alloc.vec.Vec.new Bool) 0#usize
        ⟨by simp, by simp⟩
      rw [hseen, WP.spec_ok] at hPs
      have hseenv : seen.val = List.replicate ns.val.length false := by
        rw [hPs]; simp
      -- the main loop
      obtain ⟨failure, hfail, h⟩ := bind_ok_inv h
      have hwl : words.val.length = t.val.length := hwlen
      have hinv0 : MainInv t.val ns.val tbits.val bits.val (ws0.val.map UScalar.val) cval.val
          map.val vals.val words.val (seen, none, 0#usize) := by
        refine ⟨by simp, by rw [hseenv, List.length_replicate], fun _ => ⟨?_, ?_, ?_⟩⟩
        · intro j hj hjn
          simp at hjn
        · intro m hm
          have hf : seen.val[m] = false := by
            rw [List.getElem_of_eq hseenv]
            exact List.getElem_replicate ..
          rw [hf]
          simp only [Bool.false_eq_true, false_iff, not_exists, not_and]
          intro j hj w hjn
          simp at hjn
        · intro j j' hj hj' hjn
          simp at hjn
      have hPl := check_term_dag_loop2_spec t tbits map ns bits ws0 (Slice.len t) (Slice.len ns)
        words vals cval seen none 0#usize (by simp) (by simp) hmap hws hcvlen hwl hinv0
      rw [hfail, WP.spec_ok] at hPl
      cases failure with
      | some e => try dsimp only at h; simp at h
      | none =>
      try dsimp only at h
      obtain ⟨seen', _, hA, hB, hC⟩ := hPl rfl
      -- the roots
      obtain ⟨b1, hb1, h⟩ := bind_ok_inv h
      have hPr := roots_corr_spec troots map roots
      rw [hb1, WP.spec_ok] at hPr
      split at h
      · rename_i hb1t
        obtain ⟨hrlen, hrc⟩ := hPr hb1t
        refine ⟨hdag0', hdag1', ⟨pCond vals.val words.val, ?_⟩, hrlen, hrc⟩
        -- the correspondence, assembled
        refine ⟨hmap, ?_, ?_, ?_, ?_⟩
        · -- the condition values are right wherever `some`
          intro c b hc hcb
          unfold pCond at hcb
          cases hwc : words.val[c]? with
          | none => rw [hwc] at hcb; simp at hcb
          | some v =>
            rw [hwc] at hcb
            try dsimp only at hcb
            cases hv0 : v.val[0]? with
            | none => rw [hv0] at hcb; simp at hcb
            | some l =>
              rw [hv0] at hcb
              try dsimp only at hcb
              split at hcb
              · rename_i hrng
                simp only [Option.some.injEq] at hcb
                subst hcb
                have hcw : c < words.val.length := by rw [hwl]; exact hc
                have hveq : v = words.val[c] := by
                  rw [List.getElem?_eq_getElem hcw] at hwc
                  exact (Option.some.inj hwc).symm
                have hvl : 0 < v.val.length := List.getElem?_eq_some_iff.mp hv0 |>.1
                have hleq : l = v.val[0] := by
                  rw [List.getElem?_eq_getElem hvl] at hv0
                  exact (Option.some.inj hv0).symm
                have hvv : (words.val[c]).val = v.val := by rw [hveq]
                have hvl' : 0 < (words.val[c]).val.length := by rw [hvv]; exact hvl
                have h0 : (words.val[c]).val[0] = l := by
                  rw [List.getElem_of_eq hvv]
                  exact hleq.symm
                obtain ⟨_, hdj⟩ := hden (List.replicate (dagNin t.val) false) c hcw
                have hbit := hdj 0 hvl'
                rw [h0, ← hvals] at hbit
                unfold bval
                exact hbit
              · simp at hcb
        · -- the per-node correspondence
          intro i hi hne
          obtain ⟨hm, hcorr, _⟩ := hA i hi hi hne
          refine ⟨hm, ?_⟩
          rw [← hws, ← hcvalv]
          exact hcorr
        · -- the folds
          intro i hi hne hm s1 w1 hop hconst
          obtain ⟨hm', _, hfold⟩ := hA i hi hi hne
          obtain ⟨hiw, hvlen, hvbits⟩ := hfold s1 w1 hop hconst
          intro k hk
          have hd := hden (List.replicate (dagNin t.val) false) i hiw
          obtain ⟨hdl, hdj⟩ := hd
          have hk' : k < (words.val[i]).val.length := by rw [hvlen]; exact hk
          rw [← hdj k hk', ← hvals]
          exact hvbits k hk'
        · -- injectivity
          intro i i' hi hi' w w' hw hw' hne hne' heq
          exact hC i i' hi hi' hi hi' w w' hw hw' hne hne' heq
      · simp at h
    · simp at h

/-- **The term-to-DAG correspondence check is sound**: under any two input
    assignments that agree on the variables through the map, every term
    root has the value of its DAG root. -/
theorem check_term_dag_sound (t : Slice blast_kernel.DagNode) (tbits : Slice Bool)
    (troots map : Slice Std.Usize) (ns : Slice blast_kernel.DagNode) (bits : Slice Bool)
    (roots : Slice Std.Usize)
    (h : kernel.check_term_dag t tbits troots map ns bits roots = ok (core.result.Result.Ok ())) :
    ∀ inp0 inp1 : List Bool, VarsAgree t.val ns.val map.val inp0 inp1 →
      ∀ k (hk : k < troots.val.length),
        dagBool inp0 tbits.val t.val (troots.val[k]).val
          = dagBool inp1 bits.val ns.val (roots.val.getD k 0#usize).val := by
  intro inp0 inp1 hv k hk
  obtain ⟨hdag0, hdag1, ⟨cv, hc⟩, hrlen, hrc⟩ := check_term_dag_accepted t tbits troots map ns bits roots h
  have hns : ns.val.length ≤ Usize.max := by have := ns.length_ineq; omega
  apply corr_roots t.val ns.val tbits.val bits.val map.val troots.val roots.val cv hdag0 hdag1 hns hc
    ?_ inp0 inp1 hv k hk
  intro k' hk'
  obtain ⟨h1, h2, h3⟩ := hrc k' hk' hk'
  exact ⟨by rw [← hc.len]; exact h1, h2, h3⟩

/-- **THE UNSAT CAPSTONE**: an accepted term check and an accepted query
    re-check refute the TERM — no assignment to the term's variables makes
    every asserted root true. The map is untrusted; the proof composes
    `check_query_sound` with the pushforward of a term assignment. -/
theorem check_term_unsat_sound (t : Slice blast_kernel.DagNode) (tbits : Slice Bool)
    (troots map : Slice Std.Usize) (ns : Slice blast_kernel.DagNode) (bits : Slice Bool)
    (roots hints : Slice Std.Usize) (steps : Slice kernel.Step)
    (cnf : alloc.vec.Vec (alloc.vec.Vec Std.I32))
    (ht : kernel.check_term_dag t tbits troots map ns bits roots = ok (core.result.Result.Ok ()))
    (hq : kernel.check_query ns bits roots hints steps = ok (core.result.Result.Ok cnf)) :
    ∀ inp0 : List Bool, ¬ (∀ k (hk : k < troots.val.length),
      dagBool inp0 tbits.val t.val (troots.val[k]).val = true) := by
  intro inp0 hall
  obtain ⟨_, _, ⟨cv, hc⟩, hrlen, _⟩ := check_term_dag_accepted t tbits troots map ns bits roots ht
  have hv := varsAgree_pushforward t.val ns.val tbits.val bits.val map.val cv hc inp0
  apply check_query_sound ns bits roots hints steps cnf hq (pushforward t.val ns.val map.val inp0)
  intro k hk
  have hk' : k < troots.val.length := by rw [hrlen]; exact hk
  rw [← getD_eq_getElem_of_lt hk 0#usize,
    ← check_term_dag_sound t tbits troots map ns bits roots ht inp0 _ hv k hk']
  exact hall k hk'

/-- **THE SAT CAPSTONE**: an accepted term check and an accepted model
    re-check give a model of the TERM — an assignment to the term's
    variables, agreeing with the DAG's through the map, under which every
    asserted root is true. -/
theorem check_term_model_sound (t : Slice blast_kernel.DagNode) (tbits : Slice Bool)
    (troots map : Slice Std.Usize) (ns : Slice blast_kernel.DagNode) (bits : Slice Bool)
    (roots : Slice Std.Usize) (inp1 : Slice Bool)
    (ht : kernel.check_term_dag t tbits troots map ns bits roots = ok (core.result.Result.Ok ()))
    (hm : kernel.check_query_model ns bits roots inp1 = ok (core.result.Result.Ok ())) :
    ∃ inp0 : List Bool, VarsAgree t.val ns.val map.val inp0 inp1.val ∧
      ∀ k (hk : k < troots.val.length),
        dagBool inp0 tbits.val t.val (troots.val[k]).val = true := by
  obtain ⟨_, _, _, hrlen, _⟩ := check_term_dag_accepted t tbits troots map ns bits roots ht
  have hv := varsAgree_pullback t.val ns.val map.val inp1.val
  refine ⟨pullback t.val ns.val map.val inp1.val, hv, ?_⟩
  intro k hk
  rw [check_term_dag_sound t tbits troots map ns bits roots ht _ inp1.val hv k hk]
  have hk' : k < roots.val.length := by rw [← hrlen]; exact hk
  rw [getD_eq_getElem_of_lt hk' 0#usize]
  exact check_query_model_sound ns bits roots inp1 hm k hk'

/-- **No term has both an accepted refutation and an accepted model.** -/
theorem term_verdicts_exclusive (t : Slice blast_kernel.DagNode) (tbits : Slice Bool)
    (troots map : Slice Std.Usize) (ns : Slice blast_kernel.DagNode) (bits : Slice Bool)
    (roots hints : Slice Std.Usize) (steps : Slice kernel.Step)
    (cnf : alloc.vec.Vec (alloc.vec.Vec Std.I32)) (inp1 : Slice Bool)
    (ht : kernel.check_term_dag t tbits troots map ns bits roots = ok (core.result.Result.Ok ()))
    (hq : kernel.check_query ns bits roots hints steps = ok (core.result.Result.Ok cnf))
    (hm : kernel.check_query_model ns bits roots inp1 = ok (core.result.Result.Ok ())) : False := by
  obtain ⟨inp0, _, hall⟩ := check_term_model_sound t tbits troots map ns bits roots inp1 ht hm
  exact check_term_unsat_sound t tbits troots map ns bits roots hints steps cnf ht hq inp0 hall

/- ══════════════════ THE MODEL BINDING AT THE DAG LEVEL (7d) ══════════════════ -/

theorem var_offset_loop_spec (ns : Slice blast_kernel.DagNode) (node nin i : Std.Usize)
    (hnode : node.val ≤ ns.val.length)
    (hinv : i.val ≤ node.val ∧ nin.val = dagNin (ns.val.take i.val)) :
    kernel.var_offset_loop ns node nin i ⦃ r => match r with
      | core.result.Result.Ok m => m.val = dagNin (ns.val.take node.val)
      | core.result.Result.Err _ => True ⦄ := by
  unfold kernel.var_offset_loop
  apply loop.spec_decr_nat
    (measure := fun (s : Std.Usize × Std.Usize) => node.val - s.2.val)
    (inv := fun (s : Std.Usize × Std.Usize) => s.2.val ≤ node.val ∧
      s.1.val = dagNin (ns.val.take s.2.val))
  · rintro ⟨nin1, i1⟩ ⟨hle, hnin⟩
    dsimp only at hle hnin
    unfold kernel.var_offset_loop.body
    try dsimp only
    split
    · rename_i hlt
      have hilt : i1.val < ns.val.length := by scalar_tac
      have hcap : i1.val < Usize.max := by
        have := ns.length_ineq
        omega
      have htake : ns.val.take (i1.val + 1) = ns.val.take i1.val ++ [ns.val[i1.val]] := by
        rw [List.take_add_one, List.getElem?_eq_getElem hilt]
        simp
      step as ⟨nd, hnd⟩
      cases nd <;> dsimp only
      · rename_i w
        step as ⟨i2, hi2⟩
        split
        · simp only [WP.spec_ok]
        · rename_i hwle
          have hadd : nin1.val + w.val ≤ Usize.max := by scalar_tac
          step as ⟨nin2, hnin2⟩
          step as ⟨i3, hi3⟩
          and_intros
          · scalar_tac
          · rw [hi3, htake, dagNin_snoc, ← hnd, hnin2, hnin]
            rfl
          · scalar_tac
      all_goals
        step as ⟨i3, hi3⟩
        and_intros
        · scalar_tac
        · rw [hi3, htake, dagNin_snoc, ← hnd, hnin]
          rfl
        · scalar_tac
    · rename_i hge
      have hieq : i1.val = node.val := by scalar_tac
      try simp only [WP.spec_ok]
      rw [hnin, hieq]
  · exact hinv

/-- `var_offset` computes a node's input offset: `dagNin` of the prefix
    before it. -/
theorem var_offset_spec (ns : Slice blast_kernel.DagNode) (node : Std.Usize) :
    kernel.var_offset ns node ⦃ r => match r with
      | core.result.Result.Ok m => m.val = dagNin (ns.val.take node.val)
      | core.result.Result.Err _ => True ⦄ := by
  unfold kernel.var_offset
  try dsimp only
  split
  · simp only [WP.spec_ok]
  · rename_i hle
    apply var_offset_loop_spec ns node 0#usize 0#usize (by scalar_tac)
    exact ⟨by simp, by simp [dagNin]⟩

theorem check_input_value_loop_spec (inp : Slice Bool) (offset w : Std.Usize) (value : Std.U128)
    (j : Std.Usize) (hw : w.val ≤ 128) (hr : offset.val + w.val ≤ inp.val.length)
    (hinv : j.val ≤ w.val ∧ ∀ k < j.val, inp.val.getD (offset.val + k) false = value.val.testBit k) :
    kernel.check_input_value_loop inp offset w value j ⦃ r => r = true →
      ∀ k < w.val, inp.val.getD (offset.val + k) false = value.val.testBit k ⦄ := by
  unfold kernel.check_input_value_loop
  apply loop.spec_decr_nat
    (measure := fun (j : Std.Usize) => w.val - j.val)
    (inv := fun (j : Std.Usize) => j.val ≤ w.val ∧
      ∀ k < j.val, inp.val.getD (offset.val + k) false = value.val.testBit k)
  · rintro j1 ⟨hle, hk⟩
    unfold kernel.check_input_value_loop.body
    try dsimp only
    split
    · rename_i hlt
      have hjl : j1.val < w.val := by scalar_tac
      have hj128 : j1.val < 128 := by omega
      step as ⟨i, hi, _⟩
      step as ⟨bit, hbit, _⟩
      have hbitv : bit.val = (value.val >>> j1.val) % 2 := by
        rw [hbit, UScalar.val_and, hi, ← Nat.and_one_is_mod]
        simp
      have htb : value.val.testBit j1.val = decide (bit.val = 1) := by
        rw [testBit_eq_shift_mod, hbitv]
      step as ⟨i1, hi1⟩
      have hi1' : i1.val < inp.val.length := by scalar_tac
      step as ⟨b, hb⟩
      have hext : inp.val.getD (offset.val + j1.val) false = value.val.testBit j1.val →
          ∀ k < j1.val + 1, inp.val.getD (offset.val + k) false = value.val.testBit k := by
        intro hm k hk'
        rcases Nat.lt_or_ge k j1.val with h | h
        · exact hk k h
        · have : k = j1.val := by omega
          subst this
          exact hm
      have hbv : inp.val.getD (offset.val + j1.val) false = b := by
        rw [← hi1, getD_eq_getElem_of_lt hi1', hb]
      split
      · rename_i hbt
        split
        · simp
        · rename_i hb1
          have hb1' : bit.val = 1 := by simpa using hb1
          step as ⟨j2, hj2⟩
          and_intros
          · clear hbv hb; scalar_tac
          · rw [hj2]
            apply hext
            rw [hbv, htb, hb1', hbt]
            decide
          · clear hbv hb; scalar_tac
      · rename_i hbf
        have hbf' : b = false := by simpa using hbf
        split
        · simp
        · rename_i hb0
          have hb0' : bit.val = 0 := by simpa using hb0
          step as ⟨j2, hj2⟩
          and_intros
          · clear hbv hb hbf'; scalar_tac
          · rw [hj2]
            apply hext
            rw [hbv, htb, hb0', hbf']
            decide
          · clear hbv hb hbf'; scalar_tac
    · rename_i hge
      try simp only [WP.spec_ok]
      intro _ k hk'
      exact hk k (by scalar_tac)
  · exact hinv

/-- **The model binding is sound** (7d): an accepted `check_input_value`
    means bit `k` of `value` (LSB first) IS input `offset + k` — the named
    model value a `v3` bundle advertises is the term variable's bits. -/
theorem check_input_value_sound (inp : Slice Bool) (offset w : Std.Usize) (value : Std.U128)
    (h : kernel.check_input_value inp offset w value = ok true) :
    ∀ k < w.val, inp.val.getD (offset.val + k) false = value.val.testBit k := by
  unfold kernel.check_input_value at h
  dsimp only at h
  split at h
  · cases h
  · rename_i hw
    split at h
    · cases h
    · rename_i hoff
      obtain ⟨i2, hi2, h⟩ := bind_ok_inv h
      have hsub := Usize.sub_spec (x := Slice.len inp) (y := offset) (by scalar_tac)
      rw [hi2, WP.spec_ok] at hsub
      split at h
      · cases h
      · rename_i hwle
        have hspec := check_input_value_loop_spec inp offset w value 0#usize (by scalar_tac)
          (by scalar_tac) ⟨by simp, fun k hk => by simp at hk⟩
        rw [h] at hspec
        simpa using hspec

end kernel.spec
