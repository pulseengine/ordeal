      p.1.node.val < p.2.nodes.val.length ⦄ := by
  unfold blast_sgt
  apply WP.spec_mono (blast_slt_frame aig b a (by omega) (by omega) hb ha hne h0)
  rintro ⟨lt, aig1⟩ ⟨h1, h2, h3, h4⟩
  exact ⟨h1, by omega, h3, h4⟩

/-- Structural frame of `blast_sge` (`¬(a <ₛ b)`). -/
theorem blast_sge_frame (aig : Aig) (a b : Slice Lit)
    (hab : a.val.length = b.val.length)
    (hcap : aig.nodes.val.length + 9 * a.val.length ≤ Usize.max)
    (ha : ∀ l ∈ a.val, l.node.val < aig.nodes.val.length)
