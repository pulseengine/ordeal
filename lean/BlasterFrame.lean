/- ══════════════════ FRAMES: EQUALITY ══════════════════ -/

/-- Structural frame of `blast_eq`: `4·w` gates, prefix, WF, output
    literal in range (harvested from `EqInv`). -/
theorem blast_eq_frame (aig : Aig) (a b : Slice Lit)
    (hab : a.val.length ≤ b.val.length)
    (hcap : aig.nodes.val.length + 4 * a.val.length ≤ Usize.max)
    (ha : ∀ l ∈ a.val, l.node.val < aig.nodes.val.length)
    (hb : ∀ l ∈ b.val, l.node.val < aig.nodes.val.length)
    (hne : 0 < aig.nodes.val.length)
    (h0 : aig.nodes.val[0]'hne = Node.False) :
    blast_eq aig a b ⦃ p =>
      aig.nodes.val <+: p.2.nodes.val ∧
      p.2.nodes.val.length ≤ aig.nodes.val.length + 4 * a.val.length ∧
      (∀ L, AigWF aig.nodes.val L → AigWF p.2.nodes.val L) ∧
      p.1.node.val < p.2.nodes.val.length ⦄ := by
  unfold blast_eq
  step with lit_true_spec as ⟨acc, hacc⟩
  simp only [hacc]
  have hcin : ({ node := 0#usize, neg := true } : Lit).node.val
      < aig.nodes.val.length := by scalar_tac
  apply WP.spec_mono (blast_eq_loop_spec aig a b _ (Slice.len a)
    (by scalar_tac) hab hcap ha hb hcin)
  rintro ⟨lres, aig1⟩ hinv
  obtain ⟨_, hlen, hpre, hwf, haccr, _⟩ := hinv
  exact ⟨hpre, Nat.le_of_eq hlen, hwf, haccr⟩

/-- Structural frame of `blast_ne` (`¬(a = b)`). -/
theorem blast_ne_frame (aig : Aig) (a b : Slice Lit)
    (hab : a.val.length ≤ b.val.length)
    (hcap : aig.nodes.val.length + 4 * a.val.length ≤ Usize.max)
    (ha : ∀ l ∈ a.val, l.node.val < aig.nodes.val.length)
    (hb : ∀ l ∈ b.val, l.node.val < aig.nodes.val.length)
    (hne : 0 < aig.nodes.val.length)
    (h0 : aig.nodes.val[0]'hne = Node.False) :
    blast_ne aig a b ⦃ p =>
      aig.nodes.val <+: p.2.nodes.val ∧
      p.2.nodes.val.length ≤ aig.nodes.val.length + 4 * a.val.length ∧
      (∀ L, AigWF aig.nodes.val L → AigWF p.2.nodes.val L) ∧
      p.1.node.val < p.2.nodes.val.length ⦄ := by
  unfold blast_ne
  step with (blast_eq_frame aig a b hab hcap ha hb hne h0) as
    ⟨eq, aig1, h1, h2, h3, h4⟩
  step with (lit_not_spec eq) as ⟨l, hl⟩
  refine ⟨h1, h2, h3, ?_⟩
  rw [hl]
  exact h4

/- ══════════════════ FRAMES: THE BARREL SHIFTERS ══════════════════ -/

/-- Structural frame of `blast_shl`: `3·w·stages + (|b| - stages) + 3·w`
    gates, prefix, WF, output width `w` with every literal in range. -/
theorem blast_shl_frame (aig : Aig) (a b : Slice Lit)
    (hw : 0 < a.val.length)
    (hab : a.val.length ≤ b.val.length)
    (hcap : aig.nodes.val.length
      + (3 * a.val.length * pStages a.val.length
        + (b.val.length - pStages a.val.length) + 3 * a.val.length)
      ≤ Usize.max)
    (ha : ∀ l ∈ a.val, l.node.val < aig.nodes.val.length)
    (hb : ∀ l ∈ b.val, l.node.val < aig.nodes.val.length)
    (hne : 0 < aig.nodes.val.length)
    (h0 : aig.nodes.val[0]'hne = Node.False) :
    blast_shl aig a b ⦃ p =>
      p.1.val.length = a.val.length ∧
      aig.nodes.val <+: p.2.nodes.val ∧
      p.2.nodes.val.length ≤ aig.nodes.val.length
        + (3 * a.val.length * pStages a.val.length
          + (b.val.length - pStages a.val.length) + 3 * a.val.length) ∧
      (∀ L, AigWF aig.nodes.val L → AigWF p.2.nodes.val L) ∧
      (∀ l ∈ p.1.val, l.node.val < p.2.nodes.val.length) ⦄ := by
  unfold blast_shl
  have hlen : (Slice.len a).val = a.val.length := by scalar_tac
  step with (stage_count_spec (Slice.len a) (by scalar_tac)) as
    ⟨stages, pow2, hst1, hst2, hst3, hst4⟩
  rw [hlen] at hst1 hst2 hst3
  rw [← hst1] at hcap ⊢
  have hsle : stages.val ≤ a.val.length := stages_le hst3
  have hstages : stages.val ≤ b.val.length := by omega
  step with (blast_shl_loop0_spec a (alloc.vec.Vec.new Lit)
    (Slice.len a) (by scalar_tac) (by simp; scalar_tac)) as ⟨cur, hcurv⟩
  have hcur : cur.val = a.val := by
    rw [hcurv]
    simp
  step with (blast_shl_loop1_spec aig a b stages cur hcur hstages
    hst3 (by omega) ha hb hne h0) as
    ⟨aig1, cur1, h11, h12, h13, h14, h15, _⟩
  have hb1 : ∀ l ∈ b.val, l.node.val < aig1.nodes.val.length := by
    intro l hl
    have := hb l hl
    have := h12.length_le
    omega
  have hne1 : 0 < aig1.nodes.val.length := by
    have := h12.length_le
    omega
  have h01 : aig1.nodes.val[0]'hne1 = Node.False :=
    node0_of_prefix h12 hne h0 hne1
  step with (out_of_range_spec aig1 b stages hstages (by omega) hb1
    hne1 h01) as ⟨oor, aig2, ho1, ho2, ho3, ho4, _⟩
  step with lit_false_spec as ⟨f, hf⟩
  have hne2 : 0 < aig2.nodes.val.length := by
    have := ho2.length_le
    omega
  have hfnode : f.node.val < aig2.nodes.val.length := by
    rw [hf]
    scalar_tac
  have hcur2 : ∀ l ∈ cur1.val, l.node.val < aig2.nodes.val.length := by
    intro l hl
    have := h15 l hl
    have := ho2.length_le
    omega
  apply WP.spec_mono (blast_shl_loop2_spec aig2 cur1 (Slice.len a) oor f
    (by rw [h14]; scalar_tac) (by omega) hcur2 ho4 hfnode)
  rintro ⟨out, aig3⟩ ⟨hf1, hf2, hf3, hf4, hf5, _⟩
  rw [h14] at hf1 hf3
  exact ⟨hf1, h12.trans (ho2.trans hf2), by omega,
    fun L hL => hf4 L (ho3 L (h13 L hL)), hf5⟩

/-- Structural frame of `blast_lshr` (`barrel_right` with the FALSE fill). -/
theorem blast_lshr_frame (aig : Aig) (a b : Slice Lit)
    (hw : 0 < a.val.length)
    (hab : a.val.length ≤ b.val.length)
    (hcap : aig.nodes.val.length
      + (3 * a.val.length * pStages a.val.length
        + (b.val.length - pStages a.val.length) + 3 * a.val.length)
      ≤ Usize.max)
    (ha : ∀ l ∈ a.val, l.node.val < aig.nodes.val.length)
    (hb : ∀ l ∈ b.val, l.node.val < aig.nodes.val.length)
    (hne : 0 < aig.nodes.val.length)
    (h0 : aig.nodes.val[0]'hne = Node.False) :
    blast_lshr aig a b ⦃ p =>
      p.1.val.length = a.val.length ∧
      aig.nodes.val <+: p.2.nodes.val ∧
      p.2.nodes.val.length ≤ aig.nodes.val.length
        + (3 * a.val.length * pStages a.val.length
          + (b.val.length - pStages a.val.length) + 3 * a.val.length) ∧
      (∀ L, AigWF aig.nodes.val L → AigWF p.2.nodes.val L) ∧
      (∀ l ∈ p.1.val, l.node.val < p.2.nodes.val.length) ⦄ := by
  unfold blast_lshr
  step with lit_false_spec as ⟨f, hf⟩
  have hfnode : f.node.val < aig.nodes.val.length := by
    rw [hf]
    scalar_tac
  apply WP.spec_mono (barrel_right_spec aig a b f hw hab hcap
    ha hb hfnode hne h0)
  rintro ⟨out, aig1⟩ ⟨hL1, hL2, hL3, hL4, hL5, _⟩
  exact ⟨hL1, hL2, Nat.le_of_eq hL3, hL4, hL5⟩

/-- Structural frame of `blast_ashr` (`barrel_right` with the sign-bit
    fill `a[w-1]`, which needs `w ≥ 1`). -/
theorem blast_ashr_frame (aig : Aig) (a b : Slice Lit)
    (hw : 0 < a.val.length)
    (hab : a.val.length ≤ b.val.length)
    (hcap : aig.nodes.val.length
      + (3 * a.val.length * pStages a.val.length
        + (b.val.length - pStages a.val.length) + 3 * a.val.length)
      ≤ Usize.max)
    (ha : ∀ l ∈ a.val, l.node.val < aig.nodes.val.length)
    (hb : ∀ l ∈ b.val, l.node.val < aig.nodes.val.length)
    (hne : 0 < aig.nodes.val.length)
    (h0 : aig.nodes.val[0]'hne = Node.False) :
    blast_ashr aig a b ⦃ p =>
      p.1.val.length = a.val.length ∧
      aig.nodes.val <+: p.2.nodes.val ∧
      p.2.nodes.val.length ≤ aig.nodes.val.length
        + (3 * a.val.length * pStages a.val.length
          + (b.val.length - pStages a.val.length) + 3 * a.val.length) ∧
      (∀ L, AigWF aig.nodes.val L → AigWF p.2.nodes.val L) ∧
      (∀ l ∈ p.1.val, l.node.val < p.2.nodes.val.length) ⦄ := by
  unfold blast_ashr
  have hw0 : 0 < a.val.length := hw
  step as ⟨i1, hi1⟩
  have hi1v : i1.val = a.val.length - 1 := by scalar_tac
  have hi1lt : i1.val < a.val.length := by omega
  step as ⟨sign, hsign⟩
  have hsnode : sign.node.val < aig.nodes.val.length := by
    have := ha sign (by rw [hsign]; exact List.getElem_mem _)
    omega
  apply WP.spec_mono (barrel_right_spec aig a b sign hw hab
    hcap ha hb hsnode hne h0)
  rintro ⟨out, aig1⟩ ⟨hL1, hL2, hL3, hL4, hL5, _⟩
  exact ⟨hL1, hL2, Nat.le_of_eq hL3, hL4, hL5⟩

/- ══════════════════ FRAME: `blast_rotr` ══════════════════ -/

/-- Structural frame of `blast_rotr`: at most the remainder's
    `22·w² + 17·w` gates plus the barrel's `3·w·stages`, prefix, WF, output
    width `w` with every literal in range. At a power-of-two width only the
    barrel runs; otherwise `blast_urem` reduces the amount first. -/
theorem blast_rotr_frame (aig : Aig) (a b : Slice Lit)
    (hw : 0 < a.val.length)
    (hab : b.val.length = a.val.length)
    (hcap : aig.nodes.val.length
      + (12 * a.val.length * a.val.length + 8 * a.val.length)
      + 10 * a.val.length * a.val.length
      + 9 * a.val.length
      + 3 * a.val.length * pStages a.val.length
      ≤ Usize.max)
    (ha : ∀ l ∈ a.val, l.node.val < aig.nodes.val.length)
    (hb : ∀ l ∈ b.val, l.node.val < aig.nodes.val.length)
    (hne : 0 < aig.nodes.val.length)
    (h0 : aig.nodes.val[0]'hne = Node.False) :
    blast_rotr aig a b ⦃ p =>
      p.1.val.length = a.val.length ∧
      aig.nodes.val <+: p.2.nodes.val ∧
      p.2.nodes.val.length ≤ aig.nodes.val.length
        + (12 * a.val.length * a.val.length + 8 * a.val.length)
        + 10 * a.val.length * a.val.length
        + 9 * a.val.length
        + 3 * a.val.length * pStages a.val.length ∧
      (∀ L, AigWF aig.nodes.val L → AigWF p.2.nodes.val L) ∧
      (∀ l ∈ p.1.val, l.node.val < p.2.nodes.val.length) ⦄ := by
  unfold blast_rotr
  have hlen : (Slice.len a).val = a.val.length := by scalar_tac
  step with (stage_count_spec (Slice.len a) (by scalar_tac)) as
    ⟨stages, pow2, hst1, hst2, hst3, hst4⟩
  rw [hlen] at hst1 hst2 hst3 hst4
  rw [← hst1] at hcap ⊢
  have hsle : stages.val ≤ a.val.length := stages_le hst3
  split
  · -- power-of-two width: the barrel reads `b` directly
    apply WP.spec_mono (rotr_stages_spec aig a b stages (by omega) hst3
      (by omega) ha hb)
    rintro ⟨out, aig2⟩ ⟨h11, h12, h13, h14, h15, _⟩
    exact ⟨h11, h12, by omega, h14, h15⟩
  · -- any other width: reduce the amount mod `w` first
    step with (word_const_spec (Slice.len a) (Slice.len a)) as
      ⟨modulus, hml, hmbits⟩
    rw [hlen] at hml hmbits
    have hderefm : (alloc.vec.Vec.deref modulus).val = modulus.val := rfl
    have hmrng : ∀ l ∈ (alloc.vec.Vec.deref modulus).val,
        l.node.val < aig.nodes.val.length := by
      rw [hderefm]
      intro l hl
      obtain ⟨j, hj, rfl⟩ := List.mem_iff_getElem.mp hl
      rw [hmbits j hj]
      scalar_tac
    have hmlen' : (alloc.vec.Vec.deref modulus).val.length = a.val.length := by
      rw [hderefm, hml]
    step with (blast_urem_frame aig b (alloc.vec.Vec.deref modulus)
      (by omega) (by rw [hab]; omega) hb hmrng hne h0) as
      ⟨reduced, aig1, hrl, hpre1, hlen1, hwf1, hrrng⟩
    have hderefr : (alloc.vec.Vec.deref reduced).val = reduced.val := rfl
    have hrlen' : (alloc.vec.Vec.deref reduced).val.length = a.val.length := by
      rw [hderefr, hrl, hab]
    have hrrng' : ∀ l ∈ (alloc.vec.Vec.deref reduced).val,
        l.node.val < aig1.nodes.val.length := by
      rw [hderefr]
      exact hrrng
    have ha1 : ∀ l ∈ a.val, l.node.val < aig1.nodes.val.length := by
      intro l hl
      have := ha l hl
      have := hpre1.length_le
      omega
    rw [hab] at hlen1
    apply WP.spec_mono (rotr_stages_spec aig1 a (alloc.vec.Vec.deref reduced)
      stages (by omega) hst3 (by omega) ha1 hrrng')
    rintro ⟨out, aig2⟩ ⟨h11, h12, h13, h14, h15, _⟩
    exact ⟨h11, hpre1.trans h12, by omega,
      fun L hL => h14 L (hwf1 L hL), h15⟩

end kernel.blast_kernel.spec
