/- Structural FRAME lemmas for every bit-blasting rule, plus leaf specs for
   the DAG-encoder's word constructors (`word_inputs`, `word_bits`,
   `lit_word`).

   This file is HAND-WRITTEN (BlastKernel.lean is generated by regen.sh and
   must not be edited). It proves NO new semantics: each `blast_X_frame`
   records only the plumbing facts of rule `X` — the output has width `w`
   (or is a single literal), the original AIG is a prefix of the result,
   a gate-count bound, `AigWF` preservation, and every output literal in
   range — under EXACTLY the hypotheses of the matching `blast_X_bitvec`
   theorem, so that a later file can glue frame and semantics with
   `spec_and` (the idiom of `blast_udiv_full` / `blast_urem_full`).

   Rules that already carry a frame or a full structural spec are NOT
   redone here: and/or/xor (`blast_*_spec`, BlasterProof.lean), sub / mul /
   udiv / udivrem (`blast_*_frame`, BlasterDiv.lean), urem
   (`blast_urem_frame`, BlasterRotr.lean), ite (`blast_ite_spec`) and the
   gate-free extract / concat / zero_ext / sign_ext (`*_spec`,
   BlasterCmp.lean).

   * `word_inputs_spec`: appends `w` fresh `Input` nodes `first ..
     first + w`, nothing existing is touched, `AigWF` is preserved for any
     input vector covering those indices, and literal `j` reads input
     `first + j` (`pNodeVal` of an `Input` node is the input bit).
   * `word_bits_spec` / `lit_word_spec`: gate-free, pure list facts.
   * The frames are harvested from the existing loop / gadget specs by the
     "frame idiom": unfold, `step with` through the sub-calls, keep the
     structural conjuncts, finish with `WP.spec_mono`.
-/
import BlasterRotr

open Aeneas Aeneas.Std Result

set_option maxHeartbeats 1000000

namespace kernel.blast_kernel.spec

/- ══════════════════ LEAF SPECS: INPUT NODES ══════════════════ -/

/-- Appending an `Input k` node with `k < L` preserves well-formedness
    (mirror of `AigWF_append_and`). -/
theorem AigWF_append_input {ns : List Node} {L : Nat} (h : AigWF ns L)
    {k : Std.Usize} (hk : k.val < L) :
    AigWF (ns ++ [Node.Input k]) L := by
  intro i hi
  simp only [List.length_append, List.length_cons, List.length_nil] at hi
  by_cases hlt : i < ns.length
  · rw [List.getElem_append_left hlt]
    exact h i hlt
  · have hieq : i = ns.length := by omega
    have : (ns ++ [Node.Input k])[i] = Node.Input k :=
      List.getElem_concat_length hieq _
    rw [this]
    simp only [NodeWF]
    exact hk

/-- Structural spec of `push_input`: appends exactly one `Input` node and
    returns a positive literal pointing at it. -/
theorem push_input_spec (aig : Aig) (k : Std.Usize)
    (hcap : aig.nodes.val.length < Usize.max) :
    push_input aig k ⦃ p =>
      p.2.nodes.val = aig.nodes.val ++ [Node.Input k] ∧
      p.1.node.val = aig.nodes.val.length ∧ p.1.neg = false ⦄ := by
  unfold push_input
  step as ⟨v, hv⟩
  simp [hv]

/-- Gadget spec of `push_input`: one node, prefix, in-range output literal,
    `AigWF` preserved for any input vector covering `k`, and the fresh
    literal reads input bit `k`. -/
theorem push_input_gadget (aig : Aig) (k : Std.Usize)
    (hcap : aig.nodes.val.length + 1 ≤ Usize.max) :
    push_input aig k ⦃ p =>
      p.2.nodes.val.length = aig.nodes.val.length + 1 ∧
      aig.nodes.val <+: p.2.nodes.val ∧
      p.1.node.val < p.2.nodes.val.length ∧
      (∀ L, k.val < L → AigWF aig.nodes.val L → AigWF p.2.nodes.val L) ∧
      (∀ inp : List Bool,
        pEvalLit (pSim inp p.2.nodes.val) p.1 = inp.getD k.val false) ⦄ := by
  apply WP.spec_mono (push_input_spec aig k (by omega))
  rintro ⟨g, aig'⟩ ⟨h1, h2, h3⟩
  dsimp only at h1 h2 h3 ⊢
  refine ⟨by simp [h1], ?_, ?_, ?_, ?_⟩
  · rw [h1]; exact List.prefix_append _ _
  · simp [h1, h2]
  · intro L hk hL
    rw [h1]
    exact AigWF_append_input hL hk
  · intro inp
    rw [h1, pEvalLit_fresh inp _ _ g h2, h3]
    simp [pNodeVal]

/-- **Spec of `word_inputs`**: appends `w` fresh input nodes reading inputs
    `first .. first + w - 1`; nothing existing is touched; well-formedness
    is preserved for any input vector of length `≥ first + w`; output
    literal `j` evaluates to input bit `first + j`. -/
theorem word_inputs_spec (aig : Aig) (first w : Std.Usize)
    (hcap : aig.nodes.val.length + w.val ≤ Usize.max)
    (hfw : first.val + w.val ≤ Usize.max) :
    word_inputs aig first w ⦃ p =>
      p.1.val.length = w.val ∧
      aig.nodes.val <+: p.2.nodes.val ∧
      p.2.nodes.val.length = aig.nodes.val.length + w.val ∧
      (∀ L, first.val + w.val ≤ L → AigWF aig.nodes.val L → AigWF p.2.nodes.val L) ∧
      (∀ l ∈ p.1.val, l.node.val < p.2.nodes.val.length) ∧
      ∀ (inp : List Bool) (j : Nat) (hj : j < p.1.val.length),
        pEvalLit (pSim inp p.2.nodes.val) p.1.val[j] = inp.getD (first.val + j) false ⦄ := by
  unfold word_inputs word_inputs_loop
  apply loop.spec_decr_nat
    (measure := fun (s : Aig × alloc.vec.Vec Lit × Std.Usize) =>
      w.val - s.2.2.val)
    (inv := fun (s : Aig × alloc.vec.Vec Lit × Std.Usize) =>
      s.2.2.val ≤ w.val ∧
      s.1.nodes.val.length = aig.nodes.val.length + s.2.2.val ∧
      aig.nodes.val <+: s.1.nodes.val ∧
      (∀ L, first.val + w.val ≤ L → AigWF aig.nodes.val L →
        AigWF s.1.nodes.val L) ∧
      s.2.1.val.length = s.2.2.val ∧
      (∀ l ∈ s.2.1.val, l.node.val < s.1.nodes.val.length) ∧
      ∀ (inp : List Bool) (i : Nat) (hi : i < s.2.1.val.length),
        pEvalLit (pSim inp s.1.nodes.val) s.2.1.val[i]
          = inp.getD (first.val + i) false)
  · rintro ⟨aig1, out1, j⟩ hinv
    obtain ⟨hjle, hlen1, hpre1, hwf1, holen, horng, hsem⟩ := hinv
    dsimp only at hjle hlen1 hpre1 hwf1 holen horng hsem
    unfold word_inputs_loop.body
    dsimp only
    split
    · rename_i hlt
      have hjlt : j.val < w.val := by scalar_tac
      step as ⟨i, hi⟩
      have hiv : i.val = first.val + j.val := by scalar_tac
      step with (push_input_gadget aig1 i (by omega)) as
        ⟨g, aig2, hg1, hg2, hg3, hg4, hg5⟩
      have hocap : out1.val.length < Usize.max := by omega
      step as ⟨out2, hout2⟩
      step as ⟨j1, hj1⟩
      refine ⟨by omega, by omega, hpre1.trans hg2, ?_, ?_, ?_, ?_, by scalar_tac⟩
      · intro L hL hwf
        exact hg4 L (by omega) (hwf1 L hL hwf)
      · rw [hout2, hj1]
        simp [holen]
      · intro l hl
        rw [hout2] at hl
        rcases List.mem_append.mp hl with h' | h'
        · exact Nat.lt_of_lt_of_le (horng l h') hg2.length_le
        · simp only [List.mem_singleton] at h'
          subst h'
          exact hg3
      · intro inp i' hi'
        have hi'' : i' < out1.val.length + 1 := by
          rw [hout2] at hi'
          simpa using hi'
        rcases Nat.lt_or_ge i' out1.val.length with hji | hji
        · have hget : out2.val[i']'hi' = out1.val[i']'hji := by
            simp only [hout2]
            exact List.getElem_append_left hji
          rw [hget, pEvalLit_stable hg2 _ (horng _ (List.getElem_mem _)) inp]
          exact hsem inp i' hji
        · have hieq : i' = j.val := by omega
          have hget : out2.val[i']'hi' = g := by
            simp only [hout2]
            exact List.getElem_concat_length (by omega) _
          rw [hget, hg5 inp, hieq, hiv]
    · rename_i hge
      have hjeq : j.val = w.val := by scalar_tac
      refine ⟨by dsimp only; omega, hpre1, by dsimp only; omega, hwf1, horng, ?_⟩
      intro inp i hi
      exact hsem inp i hi
  · dsimp only
    refine ⟨by scalar_tac, by simp, List.prefix_refl _, fun _ _ h => h, by simp,
      by simp, ?_⟩
    intro _ i hi
    simp at hi

/- ══════════════════ LEAF SPECS: CONSTANT WORDS ══════════════════ -/

/-- **Spec of `word_bits`**: a `w`-literal word, every literal on node 0
    with `neg` = the corresponding bit of `bits[s..s+w]`. No gates. -/
theorem word_bits_spec (bits : Slice Bool) (s w : Std.Usize)
    (hsw : s.val + w.val ≤ bits.val.length) :
    word_bits bits s w ⦃ out =>
      out.val.length = w.val ∧
      ∀ (j : Nat) (hj : j < out.val.length),
        out.val[j] = { node := 0#usize, neg := bits.val.getD (s.val + j) false } ⦄ := by
  unfold word_bits word_bits_loop
  apply loop.spec_decr_nat
    (measure := fun (st : alloc.vec.Vec Lit × Std.Usize) => w.val - st.2.val)
    (inv := fun (st : alloc.vec.Vec Lit × Std.Usize) =>
      st.2.val ≤ w.val ∧ st.1.val.length = st.2.val ∧
      ∀ (j : Nat) (hj : j < st.1.val.length),
        st.1.val[j] = { node := 0#usize, neg := bits.val.getD (s.val + j) false })
  · rintro ⟨out, j⟩ ⟨hjle, hlen, hbits⟩
    dsimp only at hjle hlen hbits
    unfold word_bits_loop.body
    dsimp only
    split
    · rename_i hlt
      have hjlt : j.val < w.val := by scalar_tac
      step as ⟨i, hi⟩
      have hiv : i.val = s.val + j.val := by scalar_tac
      have hilt : i.val < bits.val.length := by omega
      step as ⟨b, hb⟩
      have hbv : b = bits.val.getD (s.val + j.val) false := by
        rw [hb, ← hiv, getD_eq_getElem_of_lt hilt]
      have hocap : out.val.length < Usize.max := by
        have := bits.length_ineq
        omega
      -- the pushed literal, in either branch
      have hpush : ∀ (l : Lit) (out1 : alloc.vec.Vec Lit),
          l = { node := 0#usize, neg := bits.val.getD (s.val + j.val) false } →
          out1.val = out.val ++ [l] →
          ∀ (j' : Nat) (hj' : j' < out1.val.length),
            out1.val[j'] = { node := 0#usize,
                             neg := bits.val.getD (s.val + j') false } := by
        intro l out1 hl hout1 j' hj'
        have hj'' : j' < out.val.length + 1 := by
          rw [hout1] at hj'
          simpa using hj'
        rcases Nat.lt_or_ge j' out.val.length with hji | hji
        · have : out1.val[j']'hj' = out.val[j']'hji := by
            simp only [hout1]
            exact List.getElem_append_left hji
          rw [this]
          exact hbits j' hji
        · have hjeq : j' = j.val := by omega
          have : out1.val[j']'hj' = l := by
            simp only [hout1]
            exact List.getElem_concat_length (by omega) _
          rw [this, hl, hjeq]
      split
      · rename_i hbt
        step with lit_true_spec as ⟨l, hl⟩
        step as ⟨out1, hout1⟩
        step as ⟨j1, hj1⟩
        refine ⟨by scalar_tac, ?_, ?_, by scalar_tac⟩
        · rw [hout1, hj1]
          simp [hlen]
        · exact hpush l out1 (by rw [hl, ← hbv, hbt]) hout1
      · rename_i hbf
        simp only [Bool.not_eq_true] at hbf
        step with lit_false_spec as ⟨l, hl⟩
        step as ⟨out1, hout1⟩
        step as ⟨j1, hj1⟩
        refine ⟨by scalar_tac, ?_, ?_, by scalar_tac⟩
        · rw [hout1, hj1]
          simp [hlen]
        · exact hpush l out1 (by rw [hl, ← hbv, hbf]) hout1
    · rename_i hge
      have hjeq : j.val = w.val := by scalar_tac
      exact ⟨by omega, hbits⟩
  · dsimp only
    refine ⟨by scalar_tac, by simp, ?_⟩
    intro j hj
    simp at hj

/-- **Spec of `lit_word`**: the one-literal word `[l]`. -/
theorem lit_word_spec (l : Lit) :
    lit_word l ⦃ out => out.val = [l] ⦄ := by
  unfold lit_word
  have hcap : (alloc.vec.Vec.new Lit).val.length < Usize.max := by
    simp
    scalar_tac
  step as ⟨out, hout⟩
  simp [hout]

/- ══════════════════ FRAME: `blast_add` ══════════════════ -/

/-- Structural frame of `blast_add`: exactly `9·w` gates (bounded by `≤`),
    prefix, WF-preservation, output ranges. -/
theorem blast_add_frame (aig : Aig) (a b : Slice Lit)
    (hab : a.val.length ≤ b.val.length)
    (hcap : aig.nodes.val.length + 9 * a.val.length ≤ Usize.max)
    (ha : ∀ l ∈ a.val, l.node.val < aig.nodes.val.length)
    (hb : ∀ l ∈ b.val, l.node.val < aig.nodes.val.length)
    (hne : 0 < aig.nodes.val.length)
    (h0 : aig.nodes.val[0]'hne = Node.False) :
    blast_add aig a b ⦃ p =>
      p.1.val.length = a.val.length ∧
      aig.nodes.val <+: p.2.nodes.val ∧
      p.2.nodes.val.length ≤ aig.nodes.val.length + 9 * a.val.length ∧
      (∀ L, AigWF aig.nodes.val L → AigWF p.2.nodes.val L) ∧
      (∀ l ∈ p.1.val, l.node.val < p.2.nodes.val.length) ⦄ := by
  unfold blast_add
  step with lit_false_spec as ⟨l, hl⟩
  simp only [hl]
  have hcin : ({ node := 0#usize, neg := false } : Lit).node.val
      < aig.nodes.val.length := by
    scalar_tac
  step with (ripple_carry_spec aig a b _ hab hcap ha hb hcin) as
    ⟨sum, carry, aig1, h1, h2, h3, h4, h5, _, _, _⟩
  exact ⟨h1, h2, Nat.le_of_eq h3, h4, h5⟩

/- ══════════════════ FRAMES: UNSIGNED COMPARISONS ══════════════════ -/

/-- Structural frame of `blast_ult`: `9·w` gates, prefix, WF, output
    literal in range. -/
theorem blast_ult_frame (aig : Aig) (a b : Slice Lit)
    (hab : a.val.length ≤ b.val.length)
    (hcap : aig.nodes.val.length + 9 * a.val.length ≤ Usize.max)
    (ha : ∀ l ∈ a.val, l.node.val < aig.nodes.val.length)
    (hb : ∀ l ∈ b.val, l.node.val < aig.nodes.val.length)
    (hne : 0 < aig.nodes.val.length)
    (h0 : aig.nodes.val[0]'hne = Node.False) :
    blast_ult aig a b ⦃ p =>
      aig.nodes.val <+: p.2.nodes.val ∧
      p.2.nodes.val.length ≤ aig.nodes.val.length + 9 * a.val.length ∧
      (∀ L, AigWF aig.nodes.val L → AigWF p.2.nodes.val L) ∧
      p.1.node.val < p.2.nodes.val.length ⦄ := by
  unfold blast_ult
  step with (word_not_spec b) as ⟨nb, hnb⟩
  have hderef : (alloc.vec.Vec.deref nb).val = nb.val := rfl
  step with lit_true_spec as ⟨l, hl⟩
  simp only [hl]
  have hnblen : (alloc.vec.Vec.deref nb).val.length = b.val.length := by
    rw [hderef, hnb]
    simp
  have hnbrng : ∀ l ∈ (alloc.vec.Vec.deref nb).val,
      l.node.val < aig.nodes.val.length := by
    rw [hderef, hnb]
    intro l' hl'
    rw [List.mem_map] at hl'
    obtain ⟨l'', hl'', rfl⟩ := hl'
    exact hb l'' hl''
  have hcin : ({ node := 0#usize, neg := true } : Lit).node.val
      < aig.nodes.val.length := by scalar_tac
  step with (ripple_carry_spec aig a (alloc.vec.Vec.deref nb) _
    (by omega) hcap ha hnbrng hcin) as
    ⟨sum, carry, aig1, _, h2, h3, h4, _, h6, _, _⟩
  step with (lit_not_spec carry) as ⟨lres, hlres⟩
  refine ⟨h2, Nat.le_of_eq h3, h4, ?_⟩
  rw [hlres]
  exact h6

/-- Structural frame of `blast_ule` (`¬(b <ᵤ a)`). -/
theorem blast_ule_frame (aig : Aig) (a b : Slice Lit)
    (hab : a.val.length = b.val.length)
    (hcap : aig.nodes.val.length + 9 * a.val.length ≤ Usize.max)
    (ha : ∀ l ∈ a.val, l.node.val < aig.nodes.val.length)
    (hb : ∀ l ∈ b.val, l.node.val < aig.nodes.val.length)
    (hne : 0 < aig.nodes.val.length)
    (h0 : aig.nodes.val[0]'hne = Node.False) :
    blast_ule aig a b ⦃ p =>
      aig.nodes.val <+: p.2.nodes.val ∧
      p.2.nodes.val.length ≤ aig.nodes.val.length + 9 * a.val.length ∧
      (∀ L, AigWF aig.nodes.val L → AigWF p.2.nodes.val L) ∧
      p.1.node.val < p.2.nodes.val.length ⦄ := by
  unfold blast_ule
  step with (blast_ult_frame aig b a (by omega) (by omega) hb ha hne h0) as
    ⟨lt, aig1, h1, h2, h3, h4⟩
  step with (lit_not_spec lt) as ⟨l, hl⟩
  refine ⟨h1, by omega, h3, ?_⟩
  rw [hl]
  exact h4

/-- Structural frame of `blast_ugt` (`b <ᵤ a`). -/
theorem blast_ugt_frame (aig : Aig) (a b : Slice Lit)
    (hab : a.val.length = b.val.length)
    (hcap : aig.nodes.val.length + 9 * a.val.length ≤ Usize.max)
    (ha : ∀ l ∈ a.val, l.node.val < aig.nodes.val.length)
    (hb : ∀ l ∈ b.val, l.node.val < aig.nodes.val.length)
    (hne : 0 < aig.nodes.val.length)
    (h0 : aig.nodes.val[0]'hne = Node.False) :
    blast_ugt aig a b ⦃ p =>
      aig.nodes.val <+: p.2.nodes.val ∧
      p.2.nodes.val.length ≤ aig.nodes.val.length + 9 * a.val.length ∧
      (∀ L, AigWF aig.nodes.val L → AigWF p.2.nodes.val L) ∧
      p.1.node.val < p.2.nodes.val.length ⦄ := by
  unfold blast_ugt
  apply WP.spec_mono (blast_ult_frame aig b a (by omega) (by omega) hb ha hne h0)
  rintro ⟨lt, aig1⟩ ⟨h1, h2, h3, h4⟩
  exact ⟨h1, by omega, h3, h4⟩

/-- Structural frame of `blast_uge` (`¬(a <ᵤ b)`). -/
theorem blast_uge_frame (aig : Aig) (a b : Slice Lit)
    (hab : a.val.length = b.val.length)
    (hcap : aig.nodes.val.length + 9 * a.val.length ≤ Usize.max)
    (ha : ∀ l ∈ a.val, l.node.val < aig.nodes.val.length)
    (hb : ∀ l ∈ b.val, l.node.val < aig.nodes.val.length)
    (hne : 0 < aig.nodes.val.length)
    (h0 : aig.nodes.val[0]'hne = Node.False) :
    blast_uge aig a b ⦃ p =>
      aig.nodes.val <+: p.2.nodes.val ∧
      p.2.nodes.val.length ≤ aig.nodes.val.length + 9 * a.val.length ∧
      (∀ L, AigWF aig.nodes.val L → AigWF p.2.nodes.val L) ∧
      p.1.node.val < p.2.nodes.val.length ⦄ := by
  unfold blast_uge
  step with (blast_ult_frame aig a b (by omega) hcap ha hb hne h0) as
    ⟨lt, aig1, h1, h2, h3, h4⟩
  step with (lit_not_spec lt) as ⟨l, hl⟩
  refine ⟨h1, h2, h3, ?_⟩
  rw [hl]
  exact h4

/- ══════════════════ FRAMES: SIGNED COMPARISONS ══════════════════ -/

/-- Structural frame of `blast_slt` (`flip_sign` is gate-free, then
    `blast_ult`). -/
theorem blast_slt_frame (aig : Aig) (a b : Slice Lit)
    (hab : a.val.length = b.val.length)
    (hcap : aig.nodes.val.length + 9 * a.val.length ≤ Usize.max)
    (ha : ∀ l ∈ a.val, l.node.val < aig.nodes.val.length)
    (hb : ∀ l ∈ b.val, l.node.val < aig.nodes.val.length)
    (hne : 0 < aig.nodes.val.length)
    (h0 : aig.nodes.val[0]'hne = Node.False) :
    blast_slt aig a b ⦃ p =>
      aig.nodes.val <+: p.2.nodes.val ∧
      p.2.nodes.val.length ≤ aig.nodes.val.length + 9 * a.val.length ∧
      (∀ L, AigWF aig.nodes.val L → AigWF p.2.nodes.val L) ∧
      p.1.node.val < p.2.nodes.val.length ⦄ := by
  unfold blast_slt
  step with (flip_sign_spec a) as ⟨fa, hfa1, hfa2⟩
  step with (flip_sign_spec b) as ⟨fb, hfb1, hfb2⟩
  have hda : (alloc.vec.Vec.deref fa).val = fa.val := rfl
  have hdb : (alloc.vec.Vec.deref fb).val = fb.val := rfl
  have hfarng : ∀ l ∈ (alloc.vec.Vec.deref fa).val,
      l.node.val < aig.nodes.val.length := by
    rw [hda]
    intro l hl
    obtain ⟨j, hj, rfl⟩ := List.getElem_of_mem hl
    have hnode : (fa.val[j]'hj).node = (a.val[j]'(by omega)).node := by
      rw [hfa2 j hj (by omega)]
      split <;> rfl
    rw [hnode]
    exact ha _ (List.getElem_mem _)
  have hfbrng : ∀ l ∈ (alloc.vec.Vec.deref fb).val,
      l.node.val < aig.nodes.val.length := by
    rw [hdb]
    intro l hl
    obtain ⟨j, hj, rfl⟩ := List.getElem_of_mem hl
    have hnode : (fb.val[j]'hj).node = (b.val[j]'(by omega)).node := by
      rw [hfb2 j hj (by omega)]
      split <;> rfl
    rw [hnode]
    exact hb _ (List.getElem_mem _)
  apply WP.spec_mono (blast_ult_frame aig (alloc.vec.Vec.deref fa)
    (alloc.vec.Vec.deref fb) (by rw [hda, hdb]; omega)
    (by rw [hda]; omega) hfarng hfbrng hne h0)
  rintro ⟨lt, aig1⟩ ⟨h1, h2, h3, h4⟩
  rw [hda, hfa1] at h2
  exact ⟨h1, h2, h3, h4⟩

/-- Structural frame of `blast_sle` (`¬(b <ₛ a)`). -/
theorem blast_sle_frame (aig : Aig) (a b : Slice Lit)
    (hab : a.val.length = b.val.length)
    (hcap : aig.nodes.val.length + 9 * a.val.length ≤ Usize.max)
    (ha : ∀ l ∈ a.val, l.node.val < aig.nodes.val.length)
    (hb : ∀ l ∈ b.val, l.node.val < aig.nodes.val.length)
    (hne : 0 < aig.nodes.val.length)
    (h0 : aig.nodes.val[0]'hne = Node.False) :
    blast_sle aig a b ⦃ p =>
      aig.nodes.val <+: p.2.nodes.val ∧
      p.2.nodes.val.length ≤ aig.nodes.val.length + 9 * a.val.length ∧
      (∀ L, AigWF aig.nodes.val L → AigWF p.2.nodes.val L) ∧
      p.1.node.val < p.2.nodes.val.length ⦄ := by
  unfold blast_sle
  step with (blast_slt_frame aig b a (by omega) (by omega) hb ha hne h0) as
    ⟨lt, aig1, h1, h2, h3, h4⟩
  step with (lit_not_spec lt) as ⟨l, hl⟩
  refine ⟨h1, by omega, h3, ?_⟩
  rw [hl]
  exact h4

/-- Structural frame of `blast_sgt` (`b <ₛ a`). -/
theorem blast_sgt_frame (aig : Aig) (a b : Slice Lit)
    (hab : a.val.length = b.val.length)
    (hcap : aig.nodes.val.length + 9 * a.val.length ≤ Usize.max)
