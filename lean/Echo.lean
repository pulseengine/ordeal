/-- `decl_func` declares function `g` at the signature of its first call. -/
theorem decl_func_ok (c : EchoIn) (H : Good c) (g : Std.Usize) (hg : g.val < c.nf)
    {st ln w : Std.Usize} (hst : st = c.fname_start.val.getD g.val 0#usize)
    (hln : ln = c.fname_len.val.getD g.val 0#usize)
    (hw : w = c.func_width.val.getD g.val 0#usize)
    {out out' : alloc.vec.Vec Std.U8}
    (h : kernel.echo_kernel.decl_func out c.nodes c.side c.ws c.fnames st ln w g = ok (true, out')) :
    DeclWF (.fn (c.fargs g.val) (c.fwidth g.val)) ∧
      out'.val = out.val
        ++ (render (declE (c.fname g.val, .fn (c.fargs g.val) (c.fwidth g.val))) ++ [cNl]) := by
  unfold kernel.echo_kernel.decl_func at h
  split at h
  · cases h
  rename_i hw0
  obtain ⟨cc, hcc, h⟩ := bind_ok_inv h
  (try dsimp only at h)
  split at h
  · cases h
  rename_i hccl
  obtain ⟨first, hfirst, h⟩ := bind_ok_inv h
  obtain ⟨r, hr, h⟩ := bind_ok_inv h
  cases r with
  | Err e => cases h
  | Ok p =>
    obtain ⟨s0, n0⟩ := p
    (try dsimp only at h)
    obtain ⟨s, hs, h⟩ := bind_ok_inv h
    have hs' := lift_ok hs
    subst hs'
    obtain ⟨o1, ho1, h⟩ := bind_ok_inv h
    obtain ⟨o2, ho2, h⟩ := bind_ok_inv h
    obtain ⟨s1, hs1, h⟩ := bind_ok_inv h
    have hs1' := lift_ok hs1
    subst hs1'
    obtain ⟨o3, ho3, h⟩ := bind_ok_inv h
    obtain ⟨⟨b, o4⟩, hsorts, h⟩ := bind_ok_inv h
    (try dsimp only at h)
    change (if b = true then _ else _) = _ at h
    split at h
    rotate_left
    · cases h
    rename_i hbt
    subst hbt
    obtain ⟨s2, hs2, h⟩ := bind_ok_inv h
    have hs2' := lift_ok hs2
    subst hs2'
    obtain ⟨o5, ho5, h⟩ := bind_ok_inv h
    obtain ⟨o6, ho6, h⟩ := bind_ok_inv h
    obtain ⟨s3, hs3, h⟩ := bind_ok_inv h
    have hs3' := lift_ok hs3
    subst hs3'
    obtain ⟨o7, ho7, h⟩ := bind_ok_inv h
    cases h
    have hccl' : cc.val < c.nodes.val.length := by scalar_tac
    have hfc := find_call_ok hcc hccl'
    obtain ⟨_, hfirstv⟩ := slice_index_ok hfirst
    obtain ⟨f', w', hfirstE⟩ := call_args_ok hr
    have hfargs : c.fargs g.val = argWidths c s0.val n0.val := by
      unfold EchoIn.fargs argWidths
      rw [hfc, ← hfirstv dfltExt, hfirstE]
      rfl
    have hgood := H.fgood g.val hg
    have hin : st.val + ln.val ≤ c.fnames.val.length := by
      have := hgood.1
      unfold EntryIn at this
      rw [← hst, ← hln] at this
      exact this
    have hname : nameAt c.fnames.val st.val ln.val = c.fname g.val := by
      unfold EchoIn.fname entryName
      rw [← hst, ← hln]
    have hfw : c.fwidth g.val = w.val := by
      unfold EchoIn.fwidth
      rw [← hw]
    have hwp : 0 < w.val := by
      rcases Nat.eq_zero_or_pos w.val with h0 | hp
      · exact absurd (UScalar.eq_of_val_eq (by simpa using h0)) hw0
      · exact hp
    obtain ⟨hapos, hsortsE⟩ := push_arg_sorts_ok c H hsorts
    refine ⟨⟨by rw [hfargs]; exact hapos, by rw [hfw]; exact hwp⟩, ?_⟩
    rw [push_word_ok ho7, push_sort_ok ho6, push_word_ok ho5, hsortsE, push_word_ok ho3,
      push_name_ok ho2 hin, push_word_ok ho1, hname, render_declE_fn, hfargs, hfw]
    simp only [List.append_assoc]
    rfl

