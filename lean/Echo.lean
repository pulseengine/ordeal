/- The certified query echo (issue #281, phase E1): the printer
   `kernel::echo_kernel` (crates/ordeal-lrat/src/echo_kernel.rs) is proven
   against the explicit SMT-LIB model of EchoSpec.lean.

   This file is HAND-WRITTEN (Kernel.lean is generated by regen.sh and must
   not be edited). The printer turns the node lists a certificate is about —
   an `ordeal-term/v1` term or an `ordeal-ext/v1` extended query, with their
   name tables — into the bytes of an SMT-LIB script. The theorems say what
   those bytes MEAN under the model:

   * `lex_render`: the reader (`lex`) reads a printed script back, so on
     the printer's image the text determines the script.
   * `echo_ext_sound` / `echo_term_sound`: an accepted echo is the text of
     such a script, and under EVERY interpretation of its declared symbols
     the script is satisfied exactly when every root of the node list is
     true under the assignment (`layoutOf`), the array interpretation
     (`arrsOf`) and the function interpretation (`ufsOf`) read off that
     interpretation through the tables. `echo_ext_text_sound` /
     `echo_term_text_sound` are the same over the bytes (`TextSat`).
   * `echo_ext_unsat_sound` / `echo_unsat_sound` (and `echo_ext_text_unsat`
     / `echo_text_unsat`): composed with the UNCHANGED sliver and term
     capstones, an accepted `unsat` certificate makes the echoed script
     unsatisfiable.

   Proof architecture. The printer is a recursion over node indices
   (Aeneas `partial_fixpoint` definitions); every statement is partial
   correctness (`= ok … → …`), as in TreeFlatten.lean, whose `loop_ok` and
   primitive `_ok` lemmas are reused.
   * Bytes: `push_range`, `range_eq`, `bytes_ok`, `push_dec` (the one
     digits loop), `push_bits` (`#b`, MSB first), `push_name`, `push_sort`,
     `push_sym` (one symbol per `DagNode` arm), `rot_amount`.
   * The reader: `lex_sexp` / `parse_sexp` by structural recursion over
     the S-expression, then `lex_render`.
   * Names: `is_reserved` is the model's `reservedWords` (the kernel's
     four tables are that list, by `rfl`); `table_ok` gives `EntryGood` —
     every name in range, quotable, not reserved, distinct from every
     earlier name of its table and of the tables before it — hence
     `Good.names_distinct`: SMT-LIB's one namespace.
   * The walk: `echo_node_step` is one case per arm — the printed
     S-expression `e` of node `i` at the sort asked for satisfies
     `NodeDen`: it reads back, and `den I sg e` is the node's value under
     every interpretation. `echo_node_ok` is the strong induction on the
     index (operands are earlier nodes, by `ext_wf`).
   * The script: the three declaration loops, the assertion loop,
     `scriptSat_iff` (a printed script is satisfied exactly when its
     assertions are true under its signature), and the capstones. -/
import TreeFlatten
import EchoSpec

open Aeneas Aeneas.Std Result
open kernel.blast_kernel.spec

set_option maxHeartbeats 8000000

namespace kernel.spec

open kernel.spec.smt

/- ══════════════════ PRIMITIVES (partial correctness) ══════════════════ -/

theorem uadd_ok {ty : UScalarTy} {x y z : UScalar ty} (h : x + y = ok z) : z.val = x.val + y.val := by
  have := UScalar.add_equiv x y
  rw [h] at this
  exact this.2.1

theorem usub_ok {ty : UScalarTy} {x y z : UScalar ty} (h : x - y = ok z) : x.val = z.val + y.val := by
  have := UScalar.sub_equiv x y
  rw [h] at this
  exact this.2.1

theorem umul_ok {ty : UScalarTy} {x y z : UScalar ty} (h : x * y = ok z) : z.val = x.val * y.val := by
  have := UScalar.mul_equiv x y
  have h' : x.mul y = ok z := h
  rw [h'] at this
  exact this.2.1

theorem udiv_ok {ty : UScalarTy} {x y z : UScalar ty} (h : x / y = ok z) (hy : y.val ≠ 0) :
    z.val = x.val / y.val := by
  obtain ⟨z', hz, hzv⟩ := UScalar.div_spec x (y := y) hy
  rw [h] at hz
  cases hz
  exact hzv

theorem urem_ok {ty : UScalarTy} {x y z : UScalar ty} (h : x % y = ok z) (hy : y.val ≠ 0) :
    z.val = x.val % y.val := by
  have := UScalar.rem_spec x (y := y) hy
  rw [h] at this
  simpa [WP.spec_ok] using this

/-- A literal byte array as a slice is its bytes. -/
theorem lit_val (n : Std.Usize) (l : List Std.U8) (h : l.length = n.val) :
    (Array.to_slice (Array.make n l h)).val = l := rfl

/-- `l[s .. s + n]` reads `l` at `s + j`. -/
theorem seg_getD {α : Type} (l : List α) (s n j : Nat) (d : α) (hj : j < n) :
    ((l.drop s).take n).getD j d = l.getD (s + j) d := by
  rw [List.getD_eq_getElem?_getD, List.getElem?_take_of_lt hj, List.getElem?_drop,
    ← List.getD_eq_getElem?_getD]

theorem seg_length {α : Type} (l : List α) (s n : Nat) (hr : s + n ≤ l.length) :
    ((l.drop s).take n).length = n := by
  simp only [List.length_take, List.length_drop]
  omega

theorem take_succ_getD {α : Type} (l : List α) (j : Nat) (d : α) (hj : j < l.length) :
    l.take (j + 1) = l.take j ++ [l.getD j d] := by
  rw [List.take_add_one, List.getElem?_eq_getElem hj, getD_eq_getElem_of_lt hj]
  simp

/- ── push_range / push_word ── -/

theorem push_range_loop_ok (src : Slice Std.U8) (start len : Std.Usize)
    (hr : start.val + len.val ≤ src.val.length) (out0 out : alloc.vec.Vec Std.U8) (j : Std.Usize)
    (hinv : out.val = out0.val ++ (nameAt src.val start.val len.val).take j.val ∧ j.val ≤ len.val)
    (v : alloc.vec.Vec Std.U8) (h : kernel.echo_kernel.push_range_loop out src start len j = ok v) :
    v.val = out0.val ++ nameAt src.val start.val len.val := by
  unfold kernel.echo_kernel.push_range_loop at h
  have hlen : (nameAt src.val start.val len.val).length = len.val := seg_length _ _ _ hr
  refine loop_ok (fun (st : alloc.vec.Vec Std.U8 × Std.Usize) => len.val - st.2.val)
    (fun st => st.1.val = out0.val ++ (nameAt src.val start.val len.val).take st.2.val ∧
      st.2.val ≤ len.val)
    (fun v => v.val = out0.val ++ nameAt src.val start.val len.val) _ ?_ (out, j) hinv v h
  intro st hst r hr'
  obtain ⟨out1, j1⟩ := st
  obtain ⟨ha, hj⟩ := hst
  (try dsimp only at ha hj)
  unfold kernel.echo_kernel.push_range_loop.body at hr'
  (try dsimp only at hr')
  split at hr'
  · rename_i hlt
    have hjl : j1.val < len.val := by simpa using hlt
    obtain ⟨i, hi, hr'⟩ := bind_ok_inv hr'
    obtain ⟨b, hb, hr'⟩ := bind_ok_inv hr'
    obtain ⟨out2, ho2, hr'⟩ := bind_ok_inv hr'
    obtain ⟨j2, hj2, hr'⟩ := bind_ok_inv hr'
    cases hr'
    refine ⟨fun y hy => (nomatch hy), fun x' hx => ?_⟩
    cases hx
    obtain ⟨_, hbv⟩ := slice_index_ok hb
    have hj2' : j2.val = j1.val + 1 := by have := uadd_ok hj2; simpa using this
    refine ⟨⟨?_, by simp [hj2']; omega⟩, by simp [hj2']; omega⟩
    rw [push_ok ho2, ha, hbv 0#u8, hj2', take_succ_getD _ _ 0#u8 (by omega), uadd_ok hi]
    unfold nameAt
    rw [seg_getD _ _ _ _ _ hjl]
    simp
  · rename_i hge
    cases hr'
    refine ⟨fun y hy => ?_, fun x' hx => (nomatch hx)⟩
    cases hy
    rw [ha, List.take_of_length_le (by scalar_tac)]

theorem push_range_ok {out : alloc.vec.Vec Std.U8} {src : Slice Std.U8} {start len : Std.Usize}
    {v : alloc.vec.Vec Std.U8} (h : kernel.echo_kernel.push_range out src start len = ok v)
    (hr : start.val + len.val ≤ src.val.length) :
    v.val = out.val ++ nameAt src.val start.val len.val := by
  unfold kernel.echo_kernel.push_range at h
  (try dsimp only at h)
  split at h
  · rename_i hgt
    exfalso
    scalar_tac
  · obtain ⟨i2, hi2, h⟩ := bind_ok_inv h
    have hs := usub_ok hi2
    simp only [Slice.len_val] at hs
    split at h
    · rename_i hgt
      exfalso
      scalar_tac
    · exact push_range_loop_ok src start len hr out out 0#usize ⟨by simp, by simp⟩ v h

theorem push_word_ok {out : alloc.vec.Vec Std.U8} {w : Slice Std.U8} {v : alloc.vec.Vec Std.U8}
    (h : kernel.echo_kernel.push_word out w = ok v) : v.val = out.val ++ w.val := by
  unfold kernel.echo_kernel.push_word at h
  (try dsimp only at h)
  have := push_range_ok h (by simp)
  rw [this]
  simp [nameAt]

/- ── range_eq / word_is ── -/

theorem range_eq_loop_ok (a : Slice Std.U8) (sa la : Std.Usize) (b : Slice Std.U8) (sb : Std.Usize)
    (j : Std.Usize)
    (hinv : j.val ≤ la.val ∧
      ∀ k < j.val, a.val.getD (sa.val + k) 0#u8 = b.val.getD (sb.val + k) 0#u8)
    (r : Bool) (h : kernel.echo_kernel.range_eq_loop a sa la b sb j = ok r) :
    r = true ↔ ∀ k < la.val, a.val.getD (sa.val + k) 0#u8 = b.val.getD (sb.val + k) 0#u8 := by
  unfold kernel.echo_kernel.range_eq_loop at h
  refine loop_ok (fun (j : Std.Usize) => la.val - j.val)
    (fun j => j.val ≤ la.val ∧
      ∀ k < j.val, a.val.getD (sa.val + k) 0#u8 = b.val.getD (sb.val + k) 0#u8)
    (fun r => r = true ↔ ∀ k < la.val, a.val.getD (sa.val + k) 0#u8 = b.val.getD (sb.val + k) 0#u8)
    _ ?_ j hinv r h
  intro j1 hst r1 hr
  obtain ⟨hj, hk⟩ := hst
  unfold kernel.echo_kernel.range_eq_loop.body at hr
  (try dsimp only at hr)
  split at hr
  · rename_i hlt
    have hjl : j1.val < la.val := by simpa using hlt
    obtain ⟨i, hi, hr⟩ := bind_ok_inv hr
    obtain ⟨b1, hb1, hr⟩ := bind_ok_inv hr
    obtain ⟨i2, hi2, hr⟩ := bind_ok_inv hr
    obtain ⟨b2, hb2, hr⟩ := bind_ok_inv hr
    have hiv := uadd_ok hi
    have hi2v := uadd_ok hi2
    obtain ⟨_, hb1v⟩ := slice_index_ok hb1
    obtain ⟨_, hb2v⟩ := slice_index_ok hb2
    split at hr
    · rename_i hne
      cases hr
      refine ⟨fun y hy => ?_, fun x' hx => (nomatch hx)⟩
      cases hy
      simp only [Bool.false_eq_true, false_iff, not_forall]
      refine ⟨j1.val, hjl, ?_⟩
      rw [← hiv, ← hi2v, ← hb1v 0#u8, ← hb2v 0#u8]
      simpa using hne
    · rename_i heq
      obtain ⟨j2, hj2, hr⟩ := bind_ok_inv hr
      cases hr
      refine ⟨fun y hy => (nomatch hy), fun x' hx => ?_⟩
      cases hx
      have hj2' : j2.val = j1.val + 1 := by have := uadd_ok hj2; simpa using this
      refine ⟨⟨by omega, fun k hk' => ?_⟩, by (try dsimp only); omega⟩
      rw [hj2'] at hk'
      rcases Nat.lt_or_ge k j1.val with hlt' | hge'
      · exact hk k hlt'
      · have : k = j1.val := by omega
        subst this
        rw [← hiv, ← hi2v, ← hb1v 0#u8, ← hb2v 0#u8]
        exact UScalar.eq_of_val_eq (by simpa using heq)
  · rename_i hge
    cases hr
    refine ⟨fun y hy => ?_, fun x' hx => (nomatch hx)⟩
    cases hy
    have : j1.val = la.val := by scalar_tac
    simp only [true_iff]
    intro k hk'
    exact hk k (by omega)

/-- `range_eq` decides equality of two in-range byte ranges. -/
theorem range_eq_ok {a : Slice Std.U8} {sa la : Std.Usize} {b : Slice Std.U8} {sb lb : Std.Usize}
    {r : Bool} (h : kernel.echo_kernel.range_eq a sa la b sb lb = ok r) :
    r = true ↔ (la.val = lb.val ∧ sa.val + la.val ≤ a.val.length ∧
      sb.val + lb.val ≤ b.val.length ∧
      nameAt a.val sa.val la.val = nameAt b.val sb.val lb.val) := by
  unfold kernel.echo_kernel.range_eq at h
  (try dsimp only at h)
  split at h
  · rename_i hne
    cases h
    have : la.val ≠ lb.val := by
      intro hc
      simp only [bne_iff_ne, ne_eq] at hne
      exact hne (UScalar.eq_of_val_eq hc)
    simp [this]
  · rename_i heq
    have hlen : la.val = lb.val := by
      simp only [bne_iff_ne, ne_eq, Decidable.not_not] at heq
      rw [heq]
    split at h
    · rename_i hgt
      cases h
      have : ¬ (sa.val + la.val ≤ a.val.length) := by scalar_tac
      simp [this]
    · rename_i hle
      obtain ⟨i2, hi2, h⟩ := bind_ok_inv h
      have hs := usub_ok hi2
      simp only [Slice.len_val] at hs
      split at h
      · rename_i hgt
        cases h
        have : ¬ (sa.val + la.val ≤ a.val.length) := by scalar_tac
        simp [this]
      · rename_i hle2
        split at h
        · rename_i hgt
          cases h
          have : ¬ (sb.val + lb.val ≤ b.val.length) := by scalar_tac
          simp [this]
        · rename_i hle3
          obtain ⟨i5, hi5, h⟩ := bind_ok_inv h
          have hs5 := usub_ok hi5
          simp only [Slice.len_val] at hs5
          split at h
          · rename_i hgt
            cases h
            have : ¬ (sb.val + lb.val ≤ b.val.length) := by scalar_tac
            simp [this]
          · rename_i hle4
            have hra : sa.val + la.val ≤ a.val.length := by scalar_tac
            have hrb : sb.val + lb.val ≤ b.val.length := by scalar_tac
            have hl := range_eq_loop_ok a sa la b sb 0#usize
              ⟨by simp, fun k hk => by simp at hk⟩ r h
            have hnl := nameAt_length b.val sb.val lb.val hrb
            rw [hl, nameAt_eq_iff a.val sa.val la.val _ hra (by rw [hnl]; exact hlen)]
            constructor
            · intro hall
              refine ⟨hlen, hra, hrb, fun k hk => ?_⟩
              rw [hall k hk]
              unfold nameAt
              rw [seg_getD _ _ _ _ _ (by omega)]
            · intro hall k hk
              rw [hall.2.2.2 k hk]
              unfold nameAt
              rw [seg_getD _ _ _ _ _ (by omega)]

/-- `word_is` decides whether an in-range name is a word. -/
theorem word_is_ok {arena : Slice Std.U8} {s l : Std.Usize} {w : Slice Std.U8} {r : Bool}
    (h : kernel.echo_kernel.word_is arena s l w = ok r)
    (hr : s.val + l.val ≤ arena.val.length) :
    r = true ↔ nameAt arena.val s.val l.val = w.val := by
  unfold kernel.echo_kernel.word_is at h
  (try dsimp only at h)
  rw [range_eq_ok h]
  have hw : nameAt w.val (0#usize).val (Slice.len w).val = w.val := by simp [nameAt]
  rw [hw]
  constructor
  · intro hall
    exact hall.2.2.2
  · intro heq
    refine ⟨?_, hr, by simp, heq⟩
    have := nameAt_length arena.val s.val l.val hr
    rw [heq] at this
    simp [this]

/- ── bytes_ok ── -/

theorem byte_ok_ok {c : Std.U8} {r : Bool} (h : kernel.echo_kernel.byte_ok c = ok r) :
    r = true → quotable c := by
  unfold kernel.echo_kernel.byte_ok at h
  intro hr
  subst hr
  split at h
  · rename_i h1
    split at h
    · rename_i h2
      split at h
      · rename_i h3
        have h4 : (c != 92#u8) = true := by simpa using h
        refine ⟨by scalar_tac, by scalar_tac, ?_, ?_⟩
        · simpa [cBar] using h3
        · simpa [cBsl] using h4
      · cases h
    · cases h
  · cases h

theorem bytes_ok_loop_ok (arena : Slice Std.U8) (start len : Std.Usize) (j : Std.Usize)
    (hinv : j.val ≤ len.val ∧ ∀ k < j.val, quotable (arena.val.getD (start.val + k) 0#u8))
    (r : Bool) (h : kernel.echo_kernel.bytes_ok_loop arena start len j = ok r) :
    r = true → ∀ k < len.val, quotable (arena.val.getD (start.val + k) 0#u8) := by
  unfold kernel.echo_kernel.bytes_ok_loop at h
  refine loop_ok (fun (j : Std.Usize) => len.val - j.val)
    (fun j => j.val ≤ len.val ∧ ∀ k < j.val, quotable (arena.val.getD (start.val + k) 0#u8))
    (fun r => r = true → ∀ k < len.val, quotable (arena.val.getD (start.val + k) 0#u8))
    _ ?_ j hinv r h
  intro j1 hst r1 hr
  obtain ⟨hj, hk⟩ := hst
  unfold kernel.echo_kernel.bytes_ok_loop.body at hr
  (try dsimp only at hr)
  split at hr
  · rename_i hlt
    have hjl : j1.val < len.val := by simpa using hlt
    obtain ⟨i, hi, hr⟩ := bind_ok_inv hr
    obtain ⟨c, hc, hr⟩ := bind_ok_inv hr
    obtain ⟨b, hb, hr⟩ := bind_ok_inv hr
    have hiv := uadd_ok hi
    obtain ⟨_, hcv⟩ := slice_index_ok hc
    split at hr
    · rename_i hbt
      obtain ⟨j2, hj2, hr⟩ := bind_ok_inv hr
      cases hr
      refine ⟨fun y hy => (nomatch hy), fun x' hx => ?_⟩
      cases hx
      have hj2' : j2.val = j1.val + 1 := by have := uadd_ok hj2; simpa using this
      refine ⟨⟨by omega, fun k hk' => ?_⟩, by (try dsimp only); omega⟩
      rw [hj2'] at hk'
      rcases Nat.lt_or_ge k j1.val with hlt' | hge'
      · exact hk k hlt'
      · have : k = j1.val := by omega
        subst this
        rw [← hiv, ← hcv 0#u8]
        exact byte_ok_ok hb hbt
    · cases hr
      refine ⟨fun y hy => ?_, fun x' hx => (nomatch hx)⟩
      cases hy
      intro hc'
      cases hc'
  · rename_i hge
    cases hr
    refine ⟨fun y hy => ?_, fun x' hx => (nomatch hx)⟩
    cases hy
    have : j1.val = len.val := by scalar_tac
    intro _ k hk'
    exact hk k (by omega)

/-- `bytes_ok` accepts only in-range names of quotable bytes. -/
theorem bytes_ok_ok {arena : Slice Std.U8} {start len : Std.Usize} {r : Bool}
    (h : kernel.echo_kernel.bytes_ok arena start len = ok r) (hr : r = true) :
    start.val + len.val ≤ arena.val.length ∧
      ∀ c ∈ nameAt arena.val start.val len.val, quotable c := by
  unfold kernel.echo_kernel.bytes_ok at h
  (try dsimp only at h)
  subst hr
  split at h
  · cases h
  · rename_i hle
    obtain ⟨i2, hi2, h⟩ := bind_ok_inv h
    have hs := usub_ok hi2
    simp only [Slice.len_val] at hs
    split at h
    · cases h
    · rename_i hle2
      have hra : start.val + len.val ≤ arena.val.length := by scalar_tac
      have hl := bytes_ok_loop_ok arena start len 0#usize ⟨by simp, fun k hk => by simp at hk⟩
        true h rfl
      refine ⟨hra, fun c hc => ?_⟩
      obtain ⟨k, hk, rfl⟩ := List.mem_iff_getElem.mp hc
      have hkl : k < len.val := by rw [nameAt_length _ _ _ hra] at hk; exact hk
      have := hl k hkl
      rw [← getD_eq_getElem_of_lt hk 0#u8]
      unfold nameAt
      rw [seg_getD _ _ _ _ _ hkl]
      exact this

/- ── push_rev / push_dec ── -/

theorem lift_ok {α : Type} {x y : α} (h : lift x = ok y) : y = x := by
  simp only [lift, ok.injEq] at h
  exact h.symm

theorem push_rev_loop_ok (tmp : Slice Std.U8) (out0 out : alloc.vec.Vec Std.U8) (j : Std.Usize)
    (hinv : out.val = out0.val ++ (tmp.val.drop j.val).reverse ∧ j.val ≤ tmp.val.length)
    (v : alloc.vec.Vec Std.U8) (h : kernel.echo_kernel.push_rev_loop out tmp j = ok v) :
    v.val = out0.val ++ tmp.val.reverse := by
  unfold kernel.echo_kernel.push_rev_loop at h
  refine loop_ok (fun (st : alloc.vec.Vec Std.U8 × Std.Usize) => st.2.val)
    (fun st => st.1.val = out0.val ++ (tmp.val.drop st.2.val).reverse ∧ st.2.val ≤ tmp.val.length)
    (fun v => v.val = out0.val ++ tmp.val.reverse) _ ?_ (out, j) hinv v h
  intro st hst r hr
  obtain ⟨out1, j1⟩ := st
  obtain ⟨ha, hj⟩ := hst
  (try dsimp only at ha hj)
  unfold kernel.echo_kernel.push_rev_loop.body at hr
  (try dsimp only at hr)
  split at hr
  · rename_i hgt
    have hpos : 0 < j1.val := by simpa using hgt
    obtain ⟨j2, hj2, hr⟩ := bind_ok_inv hr
    obtain ⟨b, hb, hr⟩ := bind_ok_inv hr
    obtain ⟨out2, ho2, hr⟩ := bind_ok_inv hr
    cases hr
    refine ⟨fun y hy => (nomatch hy), fun x' hx => ?_⟩
    cases hx
    have hj2' : j1.val = j2.val + 1 := by have := usub_ok hj2; simpa using this
    obtain ⟨hlt, hbv⟩ := slice_index_ok hb
    refine ⟨⟨?_, by (try dsimp only); omega⟩, by (try dsimp only); omega⟩
    (try dsimp only)
    rw [push_ok ho2, ha, List.drop_eq_getElem_cons hlt, hj2', hbv 0#u8,
      getD_eq_getElem_of_lt hlt, List.reverse_cons, List.append_assoc]
  · rename_i hle
    cases hr
    refine ⟨fun y hy => ?_, fun x' hx => (nomatch hx)⟩
    cases hy
    have : j1.val = 0 := by scalar_tac
    rw [ha, this]
    simp

theorem push_rev_ok {out : alloc.vec.Vec Std.U8} {tmp : Slice Std.U8} {v : alloc.vec.Vec Std.U8}
    (h : kernel.echo_kernel.push_rev out tmp = ok v) : v.val = out.val ++ tmp.val.reverse := by
  unfold kernel.echo_kernel.push_rev at h
  (try dsimp only at h)
  exact push_rev_loop_ok tmp out out (Slice.len tmp) ⟨by simp, by simp⟩ v h

theorem digit_val (d : Nat) (h : d < 10) : (digit d).val = 48 + d := by
  change (BitVec.ofNat 8 (48 + d)).toNat = 48 + d
  rw [BitVec.toNat_ofNat]
  omega

theorem decDigits_lt {n : Nat} (h : n < 10) : decDigits n = [digit n] := by
  rw [decDigits]
  simp [h]

theorem decDigits_ge {n : Nat} (h : 10 ≤ n) :
    decDigits n = decDigits (n / 10) ++ [digit (n % 10)] := by
  rw [decDigits]
  simp [show ¬ n < 10 by omega]

/-- The byte `'0' + (d as u8)` is the digit `d`. -/
theorem digit_of_cast {d : Std.Usize} {c x : Std.U8} (hd : d.val < 10)
    (hc : lift (UScalar.cast .U8 d) = ok c) (hx : 48#u8 + c = ok x) : x = digit d.val := by
  have hc' := lift_ok hc
  subst hc'
  apply UScalar.eq_of_val_eq
  have hv := uadd_ok hx
  rw [UScalar.cast_val_eq] at hv
  have h8 : UScalarTy.U8.numBits = 8 := rfl
  rw [h8] at hv
  rw [digit_val _ hd, hv]
  have : d.val % 2 ^ 8 = d.val := Nat.mod_eq_of_lt (by omega)
  rw [this]
  rfl

theorem push_dec_loop_ok (n : Nat) (tmp : alloc.vec.Vec Std.U8) (m : Std.Usize)
    (hinv : decDigits n = decDigits m.val ++ tmp.val.reverse)
    (r : alloc.vec.Vec Std.U8 × Std.Usize) (h : kernel.echo_kernel.push_dec_loop tmp m = ok r) :
    r.2.val < 10 ∧ decDigits n = decDigits r.2.val ++ r.1.val.reverse := by
  unfold kernel.echo_kernel.push_dec_loop at h
  refine loop_ok (fun (st : alloc.vec.Vec Std.U8 × Std.Usize) => st.2.val)
    (fun st => decDigits n = decDigits st.2.val ++ st.1.val.reverse)
    (fun (r : alloc.vec.Vec Std.U8 × Std.Usize) =>
      r.2.val < 10 ∧ decDigits n = decDigits r.2.val ++ r.1.val.reverse) _ ?_ (tmp, m) hinv r h
  intro st hst r1 hr
  obtain ⟨tmp1, m1⟩ := st
  (try dsimp only at hst)
  unfold kernel.echo_kernel.push_dec_loop.body at hr
  (try dsimp only at hr)
  split at hr
  · rename_i hge
    have hge' : 10 ≤ m1.val := by simpa using hge
    obtain ⟨i, hi, hr⟩ := bind_ok_inv hr
    obtain ⟨c, hc, hr⟩ := bind_ok_inv hr
    obtain ⟨x, hx, hr⟩ := bind_ok_inv hr
    obtain ⟨tmp2, ht2, hr⟩ := bind_ok_inv hr
    obtain ⟨m2, hm2, hr⟩ := bind_ok_inv hr
    cases hr
    refine ⟨fun y hy => (nomatch hy), fun x' hx' => ?_⟩
    cases hx'
    have hiv : i.val = m1.val % 10 := by have := urem_ok hi (by simp); simpa using this
    have hm2v : m2.val = m1.val / 10 := by have := udiv_ok hm2 (by simp); simpa using this
    have hxd : x = digit i.val := digit_of_cast (by omega) hc hx
    refine ⟨?_, by (try dsimp only); omega⟩
    (try dsimp only)
    rw [hst, decDigits_ge hge', push_ok ht2, hm2v, hxd, hiv]
    simp
  · rename_i hlt
    cases hr
    refine ⟨fun y hy => ?_, fun x' hx => (nomatch hx)⟩
    cases hy
    exact ⟨by scalar_tac, hst⟩

/-- `push_dec` appends the decimal numeral. -/
theorem push_dec_ok {out : alloc.vec.Vec Std.U8} {n : Std.Usize} {v : alloc.vec.Vec Std.U8}
    (h : kernel.echo_kernel.push_dec out n = ok v) : v.val = out.val ++ decDigits n.val := by
  unfold kernel.echo_kernel.push_dec at h
  obtain ⟨⟨tmp, m⟩, hl, h⟩ := bind_ok_inv h
  (try dsimp only at h)
  obtain ⟨c, hc, h⟩ := bind_ok_inv h
  obtain ⟨x, hx, h⟩ := bind_ok_inv h
  obtain ⟨tmp1, ht1, h⟩ := bind_ok_inv h
  obtain ⟨hm, hd⟩ := push_dec_loop_ok n.val (alloc.vec.Vec.new Std.U8) n (by simp) (tmp, m) hl
  (try dsimp only at hm hd)
  have hxd : x = digit m.val := digit_of_cast hm hc hx
  have := push_rev_ok h
  rw [this, hd, decDigits_lt hm]
  simp only [alloc.vec.Vec.deref]
  rw [push_ok ht1, hxd]
  simp

/- ── push_bits ── -/

/-- `l[s .. s + n]`. -/
def segOf {α : Type} (l : List α) (s n : Nat) : List α := (l.drop s).take n

/-- The character of a binary digit. -/
def bitc (b : Bool) : Std.U8 := if b then c1 else c0

theorem push_bits_loop_ok (bits : Slice Bool) (s w : Std.Usize)
    (out0 out : alloc.vec.Vec Std.U8) (j : Std.Usize)
    (hinv : out.val = out0.val ++ (((segOf bits.val s.val w.val).drop j.val).reverse.map bitc) ∧
      j.val ≤ w.val)
    (hr : s.val + w.val ≤ bits.val.length)
    (v : alloc.vec.Vec Std.U8) (h : kernel.echo_kernel.push_bits_loop out bits s j = ok v) :
    v.val = out0.val ++ (segOf bits.val s.val w.val).reverse.map bitc := by
  unfold kernel.echo_kernel.push_bits_loop at h
  have hlen : (segOf bits.val s.val w.val).length = w.val := seg_length _ _ _ hr
  refine loop_ok (fun (st : alloc.vec.Vec Std.U8 × Std.Usize) => st.2.val)
    (fun st => st.1.val = out0.val ++ (((segOf bits.val s.val w.val).drop st.2.val).reverse.map bitc) ∧
      st.2.val ≤ w.val)
    (fun v => v.val = out0.val ++ (segOf bits.val s.val w.val).reverse.map bitc) _ ?_ (out, j) hinv v h
  intro st hst r hr'
  obtain ⟨out1, j1⟩ := st
  obtain ⟨ha, hj⟩ := hst
  (try dsimp only at ha hj)
  unfold kernel.echo_kernel.push_bits_loop.body at hr'
  (try dsimp only at hr')
  split at hr'
  · rename_i hgt
    have hpos : 0 < j1.val := by simpa using hgt
    obtain ⟨j2, hj2, hr'⟩ := bind_ok_inv hr'
    obtain ⟨i, hi, hr'⟩ := bind_ok_inv hr'
    obtain ⟨b, hb, hr'⟩ := bind_ok_inv hr'
    have hj2' : j1.val = j2.val + 1 := by have := usub_ok hj2; simpa using this
    have hiv := uadd_ok hi
    obtain ⟨_, hbv⟩ := slice_index_ok hb
    have hlt : j2.val < (segOf bits.val s.val w.val).length := by omega
    have hseg : (segOf bits.val s.val w.val)[j2.val] = b := by
      rw [← getD_eq_getElem_of_lt hlt (d := false)]
      unfold segOf
      rw [seg_getD _ _ _ _ _ (by omega), hbv false, hiv]
    have hstep : ((segOf bits.val s.val w.val).drop j2.val).reverse.map bitc
        = ((segOf bits.val s.val w.val).drop j1.val).reverse.map bitc ++ [bitc b] := by
      rw [List.drop_eq_getElem_cons hlt, hseg, hj2']
      simp
    split at hr'
    · rename_i hbt
      obtain ⟨out2, ho2, hr'⟩ := bind_ok_inv hr'
      cases hr'
      refine ⟨fun y hy => (nomatch hy), fun x' hx => ?_⟩
      cases hx
      refine ⟨⟨?_, by (try dsimp only); omega⟩, by (try dsimp only); omega⟩
      (try dsimp only)
      rw [push_ok ho2, ha, hstep, hbt]
      simp [bitc, c1]
    · rename_i hbf
      obtain ⟨out2, ho2, hr'⟩ := bind_ok_inv hr'
      cases hr'
      refine ⟨fun y hy => (nomatch hy), fun x' hx => ?_⟩
      cases hx
      refine ⟨⟨?_, by (try dsimp only); omega⟩, by (try dsimp only); omega⟩
      (try dsimp only)
      have hbf' : b = false := by simpa using hbf
      rw [push_ok ho2, ha, hstep, hbf']
      simp [bitc, c0]
  · rename_i hle
    cases hr'
    refine ⟨fun y hy => ?_, fun x' hx => (nomatch hx)⟩
    cases hy
    have : j1.val = 0 := by scalar_tac
    rw [ha, this]
    simp

/-- The constant `bits[s .. s + w]` as an S-expression: most significant
    digit first. -/
def binE (bits : List Bool) (s w : Nat) : SExp := .bin (segOf bits s w).reverse

/-- `push_bits` appends the constant, `#b` and `w` digits MSB first. -/
theorem push_bits_ok {out : alloc.vec.Vec Std.U8} {bits : Slice Bool} {s w : Std.Usize}
    {v : alloc.vec.Vec Std.U8} (h : kernel.echo_kernel.push_bits out bits s w = ok v)
    (hr : s.val + w.val ≤ bits.val.length) :
    v.val = out.val ++ render (binE bits.val s.val w.val) := by
  unfold kernel.echo_kernel.push_bits at h
  obtain ⟨out1, ho1, h⟩ := bind_ok_inv h
  obtain ⟨out2, ho2, h⟩ := bind_ok_inv h
  (try dsimp only at h)
  split at h
  · exfalso
    scalar_tac
  · obtain ⟨i2, hi2, h⟩ := bind_ok_inv h
    have hs := usub_ok hi2
    simp only [Slice.len_val] at hs
    split at h
    · exfalso
      scalar_tac
    · have := push_bits_loop_ok bits s w out2 out2 w ⟨by
        rw [List.drop_of_length_le (by unfold segOf; rw [seg_length _ _ _ hr])]
        simp, le_refl _⟩ hr v h
      rw [this, push_ok ho2, push_ok ho1]
      simp only [binE, render, List.append_assoc, List.cons_append, List.nil_append]
      rfl

/- ── push_name / push_sort / push_stores ── -/

/-- `push_name` appends the quoted name. -/
theorem push_name_ok {out : alloc.vec.Vec Std.U8} {arena : Slice Std.U8} {start len : Std.Usize}
    {v : alloc.vec.Vec Std.U8} (h : kernel.echo_kernel.push_name out arena start len = ok v)
    (hr : start.val + len.val ≤ arena.val.length) :
    v.val = out.val ++ render (.qsym (nameAt arena.val start.val len.val)) := by
  unfold kernel.echo_kernel.push_name at h
  obtain ⟨out1, ho1, h⟩ := bind_ok_inv h
  obtain ⟨out2, ho2, h⟩ := bind_ok_inv h
  rw [push_ok h, push_range_ok ho2 hr, push_ok ho1]
  simp only [render, List.append_assoc, List.cons_append, List.nil_append]
  rfl

/-- The sort `(_ BitVec w)`. -/
def sortE (w : Nat) : SExp := .list [.sym (bytes "_"), .sym (bytes "BitVec"), .num w]

theorem render_sortE (w : Nat) : render (sortE w) = bytes "(_ BitVec " ++ (decDigits w ++ [cRp]) := by
  simp only [sortE, render, renderSp, List.drop_succ_cons, List.drop_zero, List.append_assoc,
    List.cons_append, List.append_nil]
  rfl

/-- `push_sort` appends the sort. -/
theorem push_sort_ok {out : alloc.vec.Vec Std.U8} {w : Std.Usize} {v : alloc.vec.Vec Std.U8}
    (h : kernel.echo_kernel.push_sort out w = ok v) : v.val = out.val ++ render (sortE w.val) := by
  unfold kernel.echo_kernel.push_sort at h
  obtain ⟨s, hs, h⟩ := bind_ok_inv h
  have hs' := lift_ok hs
  subst hs'
  obtain ⟨out1, ho1, h⟩ := bind_ok_inv h
  obtain ⟨out2, ho2, h⟩ := bind_ok_inv h
  rw [push_ok h, push_dec_ok ho2, push_word_ok ho1, render_sortE]
  simp only [List.append_assoc]
  rfl

theorem push_stores_loop_ok (n : Std.Usize) (out0 out : alloc.vec.Vec Std.U8) (j : Std.Usize)
    (hinv : out.val = out0.val ++ (List.replicate j.val (bytes "(store ")).flatten ∧ j.val ≤ n.val)
    (v : alloc.vec.Vec Std.U8) (h : kernel.echo_kernel.push_stores_loop out n j = ok v) :
    v.val = out0.val ++ (List.replicate n.val (bytes "(store ")).flatten := by
  unfold kernel.echo_kernel.push_stores_loop at h
  refine loop_ok (fun (st : alloc.vec.Vec Std.U8 × Std.Usize) => n.val - st.2.val)
    (fun st => st.1.val = out0.val ++ (List.replicate st.2.val (bytes "(store ")).flatten ∧
      st.2.val ≤ n.val)
    (fun v => v.val = out0.val ++ (List.replicate n.val (bytes "(store ")).flatten) _ ?_ (out, j)
    hinv v h
  intro st hst r hr
  obtain ⟨out1, j1⟩ := st
  obtain ⟨ha, hj⟩ := hst
  (try dsimp only at ha hj)
  unfold kernel.echo_kernel.push_stores_loop.body at hr
  (try dsimp only at hr)
  split at hr
  · rename_i hlt
    have hjl : j1.val < n.val := by simpa using hlt
    obtain ⟨s, hs, hr⟩ := bind_ok_inv hr
    have hs' := lift_ok hs
    subst hs'
    obtain ⟨out2, ho2, hr⟩ := bind_ok_inv hr
    obtain ⟨j2, hj2, hr⟩ := bind_ok_inv hr
    cases hr
    refine ⟨fun y hy => (nomatch hy), fun x' hx => ?_⟩
    cases hx
    have hj2' : j2.val = j1.val + 1 := by have := uadd_ok hj2; simpa using this
    refine ⟨⟨?_, by (try dsimp only); omega⟩, by (try dsimp only); omega⟩
    (try dsimp only)
    rw [push_word_ok ho2, ha, hj2', List.replicate_succ', List.flatten_append]
    simp only [List.append_assoc, List.flatten_cons, List.flatten_nil, List.append_nil]
    rfl
  · rename_i hge
    cases hr
    refine ⟨fun y hy => ?_, fun x' hx => (nomatch hx)⟩
    cases hy
    have : j1.val = n.val := by scalar_tac
    rw [ha, this]

theorem push_stores_ok {out : alloc.vec.Vec Std.U8} {n : Std.Usize} {v : alloc.vec.Vec Std.U8}
    (h : kernel.echo_kernel.push_stores out n = ok v) :
    v.val = out.val ++ (List.replicate n.val (bytes "(store ")).flatten :=
  push_stores_loop_ok n out out 0#usize ⟨by simp, by simp⟩ v h

/- ══════════════════ THE READER READS THE PRINTER BACK ══════════════════ -/

mutual
/-- The tokens of an S-expression. -/
def toks : SExp → List Tok
  | .sym b => [Tok.atom (.sym b)]
  | .qsym b => [Tok.atom (.qsym b)]
  | .num n => [Tok.atom (.num n)]
  | .bin bs => [Tok.atom (.bin bs)]
  | .list xs => Tok.lp :: (toksL xs ++ [Tok.rp])
def toksL : List SExp → List Tok
  | [] => []
  | x :: xs => toks x ++ toksL xs
end

/-- What may follow a word: the end, whitespace or a parenthesis. -/
def Stop (rest : List Std.U8) : Prop :=
  rest = [] ∨ ∃ d r, rest = d :: r ∧ (d = cSp ∨ d = cNl ∨ d = cLp ∨ d = cRp)

theorem wordCh_iff (c : Std.U8) :
    wordCh c = true ↔ (c ≠ cSp ∧ c ≠ cNl ∧ c ≠ cLp ∧ c ≠ cRp ∧ c ≠ cBar) := by
  simp [wordCh, and_assoc]

theorem lexAux_idle_sp (cs : List Std.U8) : lexAux .idle (cSp :: cs) = lexAux .idle cs := by
  simp [lexAux]

theorem lexAux_idle_nl (cs : List Std.U8) : lexAux .idle (cNl :: cs) = lexAux .idle cs := by
  simp [lexAux]

theorem lexAux_idle_lp (cs : List Std.U8) :
    lexAux .idle (cLp :: cs) = (lexAux .idle cs).map (Tok.lp :: ·) := by
  have h1 : cLp ≠ cSp := by decide
  have h2 : cLp ≠ cNl := by decide
  simp [lexAux, h1, h2]

theorem lexAux_idle_rp (cs : List Std.U8) :
    lexAux .idle (cRp :: cs) = (lexAux .idle cs).map (Tok.rp :: ·) := by
  have h1 : cRp ≠ cSp := by decide
  have h2 : cRp ≠ cNl := by decide
  have h3 : cRp ≠ cLp := by decide
  simp [lexAux, h1, h2, h3]

theorem lexAux_idle_bar (cs : List Std.U8) :
    lexAux .idle (cBar :: cs) = lexAux (.quoted []) cs := by
  have h1 : cBar ≠ cSp := by decide
  have h2 : cBar ≠ cNl := by decide
  have h3 : cBar ≠ cLp := by decide
  have h4 : cBar ≠ cRp := by decide
  simp [lexAux, h1, h2, h3, h4]

theorem lexAux_idle_word (c : Std.U8) (cs : List Std.U8) (hc : wordCh c = true) :
    lexAux .idle (c :: cs) = lexAux (.word [c]) cs := by
  obtain ⟨h1, h2, h3, h4, h5⟩ := (wordCh_iff c).mp hc
  simp [lexAux, h1, h2, h3, h4, h5]

theorem lexAux_word_step (acc : List Std.U8) (c : Std.U8) (cs : List Std.U8)
    (hc : wordCh c = true) : lexAux (.word acc) (c :: cs) = lexAux (.word (acc ++ [c])) cs := by
  obtain ⟨h1, h2, h3, h4, h5⟩ := (wordCh_iff c).mp hc
  simp [lexAux, h1, h2, h3, h4, h5]

/-- A run of word characters is accumulated. -/
theorem lexAux_word (w : List Std.U8) : ∀ (acc rest : List Std.U8), w.all wordCh = true →
    lexAux (.word acc) (w ++ rest) = lexAux (.word (acc ++ w)) rest := by
  induction w with
  | nil => intro acc rest _; simp
  | cons c w ih =>
    intro acc rest hw
    simp only [List.all_cons, Bool.and_eq_true] at hw
    rw [List.cons_append, lexAux_word_step acc c _ hw.1, ih (acc ++ [c]) rest hw.2]
    simp

/-- A word ends at the end of the text, at whitespace or at a parenthesis. -/
theorem lexAux_word_end (acc : List Std.U8) (e : SExp) (rest : List Std.U8)
    (hc : classify acc = some e) (hs : Stop rest) :
    lexAux (.word acc) rest = (lexAux .idle rest).map (Tok.atom e :: ·) := by
  rcases hs with rfl | ⟨d, r, rfl, hd⟩
  · simp [lexAux, hc]
  · rcases hd with rfl | rfl | rfl | rfl
    · rw [lexAux_idle_sp]
      simp [lexAux, hc]
    · rw [lexAux_idle_nl]
      simp [lexAux, hc]
    · rw [lexAux_idle_lp]
      have h1 : cLp ≠ cSp := by decide
      have h2 : cLp ≠ cNl := by decide
      simp [lexAux, hc, h1, h2, Option.map_map, Function.comp_def]
    · rw [lexAux_idle_rp]
      have h1 : cRp ≠ cSp := by decide
      have h2 : cRp ≠ cNl := by decide
      have h3 : cRp ≠ cLp := by decide
      simp [lexAux, hc, h1, h2, h3, Option.map_map, Function.comp_def]

/-- An atom whose text is a classified word of word characters is one
    token. -/
theorem lexAux_atom (e : SExp) (w rest : List Std.U8) (hne : w ≠ [])
    (hw : w.all wordCh = true) (hc : classify w = some e) (hs : Stop rest) :
    lexAux .idle (w ++ rest) = (lexAux .idle rest).map (Tok.atom e :: ·) := by
  cases w with
  | nil => exact absurd rfl hne
  | cons c w =>
    simp only [List.all_cons, Bool.and_eq_true] at hw
    rw [List.cons_append, lexAux_idle_word c _ hw.1, lexAux_word w [c] rest hw.2]
    exact lexAux_word_end _ e rest hc hs

/-- A quoted symbol runs to the closing bar. -/
theorem lexAux_quoted (b : List Std.U8) : ∀ (acc rest : List Std.U8), qOk b = true →
    lexAux (.quoted acc) (b ++ cBar :: rest)
      = (lexAux .idle rest).map (Tok.atom (.qsym (acc ++ b)) :: ·) := by
  induction b with
  | nil => intro acc rest _; simp [lexAux]
  | cons c b ih =>
    intro acc rest hq
    simp only [qOk, List.all_cons, Bool.and_eq_true, bne_iff_ne, ne_eq] at hq
    have hq' : qOk b = true := by
      simp only [qOk, List.all_eq_true, Bool.and_eq_true, bne_iff_ne, ne_eq]
      intro d hd
      have := List.all_eq_true.mp hq.2 d hd
      simpa using this
    rw [List.cons_append]
    simp only [lexAux, hq.1.1, hq.1.2, if_false]
    rw [ih (acc ++ [c]) rest hq']
    simp

/- ── the atoms ── -/

theorem isDigit_wordCh (c : Std.U8) (h : isDigit c = true) : wordCh c = true := by
  simp only [isDigit, Bool.and_eq_true, decide_eq_true_eq] at h
  rw [wordCh_iff]
  refine ⟨?_, ?_, ?_, ?_, ?_⟩ <;>
    (intro hc
     rw [hc] at h
     revert h
     decide)

theorem isDigit_digit (d : Nat) (hd : d < 10) : isDigit (digit d) = true := by
  simp only [isDigit, Bool.and_eq_true, decide_eq_true_eq, digit_val d hd]
  omega

theorem decDigits_all (n : Nat) : (decDigits n).all isDigit = true := by
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    rcases Nat.lt_or_ge n 10 with h | h
    · rw [decDigits_lt h]
      simp [isDigit_digit n h]
    · rw [decDigits_ge h, List.all_append, ih (n / 10) (by omega)]
      simp [isDigit_digit (n % 10) (by omega)]

theorem decDigits_ne (n : Nat) : decDigits n ≠ [] := by
  rcases Nat.lt_or_ge n 10 with h | h
  · rw [decDigits_lt h]
    simp
  · rw [decDigits_ge h]
    simp

theorem readDec_snoc (a : List Std.U8) (d : Std.U8) :
    readDec (a ++ [d]) = 10 * readDec a + (d.val - 48) := by
  simp [readDec, List.foldl_append]

theorem readDec_decDigits (n : Nat) : readDec (decDigits n) = n := by
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    rcases Nat.lt_or_ge n 10 with h | h
    · rw [decDigits_lt h]
      simp [readDec, digit_val n h]
    · rw [decDigits_ge h, readDec_snoc, ih (n / 10) (by omega), digit_val _ (by omega)]
      omega

theorem classify_num (n : Nat) : classify (decDigits n) = some (.num n) := by
  have hall := decDigits_all n
  have hrd := readDec_decDigits n
  cases hd : decDigits n with
  | nil => exact absurd hd (decDigits_ne n)
  | cons c r =>
    rw [hd] at hall hrd
    simp only [List.all_cons, Bool.and_eq_true] at hall
    have hch : c ≠ cHash := by
      intro hc
      have h1 := hall.1
      rw [hc] at h1
      revert h1
      decide
    simp only [classify, hch, if_false, hall.1, hall.2, if_true, hrd]

theorem classify_sym (b : List Std.U8) (h : symOk b = true) :
    b ≠ [] ∧ b.all wordCh = true ∧ classify b = some (.sym b) := by
  cases b with
  | nil => simp [symOk] at h
  | cons c r =>
    simp only [symOk, Bool.and_eq_true, Bool.not_eq_true', bne_iff_ne, ne_eq] at h
    obtain ⟨⟨hd, hh⟩, hall⟩ := h
    refine ⟨by simp, hall, ?_⟩
    simp only [classify, hh, if_false, hd]
    simp

theorem classify_bin (bs : List Bool) (h : bs ≠ []) :
    classify (cHash :: cB :: bs.map fun b => if b then c1 else c0) = some (.bin bs) := by
  have hne : (bs.map fun b => if b then c1 else c0) ≠ [] := by
    intro hc
    exact h (List.map_eq_nil_iff.mp hc)
  have hall : (bs.map fun b => if b then c1 else c0).all (fun d => d = c0 || d = c1) = true := by
    rw [List.all_eq_true]
    intro d hd
    obtain ⟨b, _, rfl⟩ := List.mem_map.mp hd
    cases b <;> simp
  have hback : ((bs.map fun b => if b then c1 else c0).map fun d => decide (d = c1)) = bs := by
    rw [List.map_map]
    have h01 : c0 ≠ c1 := by decide
    have : ((fun d => decide (d = c1)) ∘ fun b => if b then c1 else c0) = id := by
      funext b
      cases b <;> simp [h01]
    rw [this, List.map_id]
  simp only [classify, if_true, hne, hall, ne_eq, not_false_eq_true, and_self, hback]

theorem bin_wordCh (bs : List Bool) :
    (cHash :: cB :: bs.map fun b => if b then c1 else c0).all wordCh = true := by
  have hh : wordCh cHash = true := by decide
  have hb : wordCh cB = true := by decide
  have h0 : wordCh c0 = true := by decide
  have h1 : wordCh c1 = true := by decide
  simp only [List.all_cons, hh, hb, Bool.true_and, List.all_eq_true]
  intro d hd
  obtain ⟨b, _, rfl⟩ := List.mem_map.mp hd
  cases b <;> simp [h0, h1]

theorem stop_cons_sp (r : List Std.U8) : Stop (cSp :: r) := Or.inr ⟨cSp, r, rfl, Or.inl rfl⟩
theorem stop_cons_nl (r : List Std.U8) : Stop (cNl :: r) :=
  Or.inr ⟨cNl, r, rfl, Or.inr (Or.inl rfl)⟩
theorem stop_cons_rp (r : List Std.U8) : Stop (cRp :: r) :=
  Or.inr ⟨cRp, r, rfl, Or.inr (Or.inr (Or.inr rfl))⟩

theorem stop_renderSp (xs : List SExp) (rest : List Std.U8) (hs : Stop rest) :
    Stop (renderSp xs ++ rest) := by
  cases xs with
  | nil => simpa [renderSp] using hs
  | cons x xs =>
    simp only [renderSp, List.cons_append]
    exact stop_cons_sp _

/-- The leading space `render` drops is one the tokenizer skips. -/
theorem lexAux_drop_sp (xs : List SExp) (rest : List Std.U8) :
    lexAux .idle ((renderSp xs).drop 1 ++ rest) = lexAux .idle (renderSp xs ++ rest) := by
  cases xs with
  | nil => simp [renderSp]
  | cons x xs =>
    simp only [renderSp, List.drop_succ_cons, List.drop_zero, List.cons_append]
    rw [lexAux_idle_sp]

mutual
/-- The tokenizer on a printed S-expression. -/
theorem lex_sexp : ∀ (e : SExp), Printable e → ∀ (rest : List Std.U8), Stop rest →
    lexAux .idle (render e ++ rest) = (lexAux .idle rest).map (toks e ++ ·)
  | .sym b, hp, rest, hs => by
    simp only [Printable] at hp
    obtain ⟨hne, hall, hc⟩ := classify_sym b hp
    simp only [render, toks]
    rw [lexAux_atom _ b rest hne hall hc hs]
    rfl
  | .qsym b, hp, rest, _ => by
    simp only [Printable] at hp
    simp only [render, toks, List.cons_append, List.append_assoc, List.nil_append]
    rw [lexAux_idle_bar, lexAux_quoted b [] rest hp]
    rfl
  | .num n, _, rest, hs => by
    simp only [render, toks]
    rw [lexAux_atom _ (decDigits n) rest (decDigits_ne n)
      (List.all_eq_true.mpr fun c hc =>
        isDigit_wordCh c (List.all_eq_true.mp (decDigits_all n) c hc)) (classify_num n) hs]
    rfl
  | .bin bs, hp, rest, hs => by
    simp only [Printable] at hp
    simp only [render, toks]
    rw [lexAux_atom _ _ rest (by simp) (bin_wordCh bs) (classify_bin bs hp) hs]
    rfl
  | .list xs, hp, rest, hs => by
    simp only [Printable] at hp
    simp only [render, toks, List.cons_append, List.append_assoc, List.nil_append]
    rw [lexAux_idle_lp, lexAux_drop_sp, lex_sexps xs hp (cRp :: rest) (stop_cons_rp rest),
      lexAux_idle_rp]
    simp [Option.map_map, Function.comp_def]
/-- The tokenizer on the items of a printed list. -/
theorem lex_sexps : ∀ (xs : List SExp), PrintableL xs → ∀ (rest : List Std.U8), Stop rest →
    lexAux .idle (renderSp xs ++ rest) = (lexAux .idle rest).map (toksL xs ++ ·)
  | [], _, rest, _ => by simp [renderSp, toksL]
  | x :: xs, hp, rest, hs => by
    simp only [PrintableL] at hp
    simp only [renderSp, toksL, List.cons_append, List.append_assoc]
    rw [lexAux_idle_sp, lex_sexp x hp.1 (renderSp xs ++ rest) (stop_renderSp xs rest hs),
      lex_sexps xs hp.2 rest hs]
    simp [Option.map_map, Function.comp_def]
end

theorem parseGo_atom (st : List (List SExp)) (cur : List SExp) (e : SExp) (ts : List Tok) :
    parseGo st cur (Tok.atom e :: ts) = parseGo st (e :: cur) ts := by
  cases st <;> simp [parseGo]

theorem parseGo_lp (st : List (List SExp)) (cur : List SExp) (ts : List Tok) :
    parseGo st cur (Tok.lp :: ts) = parseGo (cur :: st) [] ts := by
  cases st <;> simp [parseGo]

theorem parseGo_rp (top : List SExp) (st : List (List SExp)) (cur : List SExp) (ts : List Tok) :
    parseGo (top :: st) cur (Tok.rp :: ts) = parseGo st (.list cur.reverse :: top) ts := by
  simp [parseGo]

mutual
/-- The parser on the tokens of an S-expression. -/
theorem parse_sexp : ∀ (e : SExp) (st : List (List SExp)) (cur : List SExp) (ts : List Tok),
    parseGo st cur (toks e ++ ts) = parseGo st (e :: cur) ts
  | .sym b, st, cur, ts => by simp only [toks, List.cons_append, List.nil_append, parseGo_atom]
  | .qsym b, st, cur, ts => by simp only [toks, List.cons_append, List.nil_append, parseGo_atom]
  | .num n, st, cur, ts => by simp only [toks, List.cons_append, List.nil_append, parseGo_atom]
  | .bin bs, st, cur, ts => by simp only [toks, List.cons_append, List.nil_append, parseGo_atom]
  | .list xs, st, cur, ts => by
    simp only [toks, List.cons_append, List.append_assoc, List.nil_append]
    rw [parseGo_lp, parse_sexps xs (cur :: st) [] (Tok.rp :: ts), parseGo_rp]
    simp
/-- The parser on the tokens of a list's items. -/
theorem parse_sexps : ∀ (xs : List SExp) (st : List (List SExp)) (cur : List SExp)
    (ts : List Tok), parseGo st cur (toksL xs ++ ts) = parseGo st (xs.reverse ++ cur) ts
  | [], st, cur, ts => by simp [toksL]
  | x :: xs, st, cur, ts => by
    simp only [toksL, List.append_assoc]
    rw [parse_sexp x st cur (toksL xs ++ ts), parse_sexps xs st (x :: cur) ts]
    simp
end

theorem lexAux_script : ∀ (cs : List SExp), PrintableL cs →
    lexAux .idle (renderScript cs) = some (toksL cs)
  | [], _ => by simp [renderScript, lexAux, toksL]
  | c :: cs, hp => by
    simp only [PrintableL] at hp
    simp only [renderScript, toksL]
    rw [lex_sexp c hp.1 (cNl :: renderScript cs) (stop_cons_nl _), lexAux_idle_nl,
      lexAux_script cs hp.2]
    rfl

/-- **The round trip**: the reader reads a printed script back. On the
    printer's image the text determines the script, so "the text is
    satisfied" (`TextSat`) is "the script is satisfied". -/
theorem lex_render (cs : List SExp) (h : PrintableL cs) : lex (renderScript cs) = some cs := by
  unfold lex
  rw [lexAux_script cs h]
  have := parse_sexps cs [] [] []
  simp only [List.append_nil] at this
  simp only [Option.bind_some, this]
  simp [parseGo]

theorem textSat_render (I : Interp) (cs : List SExp) (h : PrintableL cs) :
    TextSat I (renderScript cs) ↔ ScriptSat I cs := by
  unfold TextSat
  rw [lex_render cs h]
  constructor
  · rintro ⟨cs', hcs, hs⟩
    cases hcs
    exact hs
  · intro hs
    exact ⟨cs, rfl, hs⟩

/- ══════════════════ RESERVED WORDS ══════════════════ -/

/-- A short byte string as a slice. -/
def lw (l : List Std.U8) (h : l.length ≤ 64 := by decide) : Slice Std.U8 :=
  ⟨l, by scalar_tac⟩

/-- The reserved-word check as a recursion over the word list: what each
    `reserved_k` of the kernel is, by unfolding. -/
def anyWord (a : Slice Std.U8) (s l : Std.Usize) : List (Slice Std.U8) → Result Bool
  | [] => ok false
  | [w] => kernel.echo_kernel.word_is a s l w
  | w :: w' :: ws => do
    let b ← kernel.echo_kernel.word_is a s l w
    if b then ok true else anyWord a s l (w' :: ws)

theorem anyWord_ok (a : Slice Std.U8) (s l : Std.Usize) (hr : s.val + l.val ≤ a.val.length) :
    ∀ (ws : List (Slice Std.U8)) (r : Bool), anyWord a s l ws = ok r → r = false →
      ∀ w ∈ ws, nameAt a.val s.val l.val ≠ w.val := by
  intro ws
  induction ws with
  | nil => intro r _ _ w hw; cases hw
  | cons w ws ih =>
    intro r h hr' w0 hw0
    cases ws with
    | nil =>
      simp only [anyWord] at h
      have hw := word_is_ok h hr
      simp only [List.mem_singleton] at hw0
      subst hw0
      intro hc
      rw [← hw] at hc
      rw [hc] at hr'
      cases hr'
    | cons w' ws =>
      simp only [anyWord] at h
      obtain ⟨b, hb, h⟩ := bind_ok_inv h
      have hw := word_is_ok hb hr
      split at h
      · cases h
        cases hr'
      · rename_i hbf
        rcases List.mem_cons.mp hw0 with rfl | hmem
        · intro hc
          exact hbf (hw.mpr hc)
        · exact ih r h hr' w0 hmem

def resWords0 : List (Slice Std.U8) := [
  lw (bytes "!"), lw (bytes "_"), lw (bytes "as"), lw (bytes "BINARY"), lw (bytes "DECIMAL"),
  lw (bytes "exists"), lw (bytes "HEXADECIMAL"), lw (bytes "forall"), lw (bytes "let"),
  lw (bytes "match"), lw (bytes "NUMERAL"), lw (bytes "par"), lw (bytes "STRING"),
  lw (bytes "assert"), lw (bytes "check-sat"), lw (bytes "check-sat-assuming"),
  lw (bytes "declare-const"), lw (bytes "declare-datatype"), lw (bytes "declare-datatypes"),
  lw (bytes "declare-fun"), lw (bytes "declare-sort"), lw (bytes "define-fun"),
  lw (bytes "define-fun-rec"), lw (bytes "define-funs-rec")]

