  · split at h
    · cases h
    · exact decl_funcs_loop_ok c H (Slice.len c.fname_start) (by simp [EchoIn.nf]) out out 0#usize
        ⟨by simp, fun j hj => by simp at hj, by simp [renderScript]⟩ (true, out') h rfl

/- ── the assertions ── -/

theorem echo_roots_loop_ok (c : EchoIn) (H : Good c) (roots : Slice Std.Usize) (n : Std.Usize)
    (hn : n.val = roots.val.length) (out0 out : alloc.vec.Vec Std.U8) (k : Std.Usize)
    (hinv : k.val ≤ roots.val.length ∧ ∃ ts : List SExp, ts.length = k.val ∧
      out.val = out0.val ++ renderScript (ts.map assertE) ∧
      ∀ j (hj : j < ts.length), NodeDen c (roots.val.getD j 0#usize).val true ts[j])
    (r : core.result.Result Unit kernel.echo_kernel.EchoError × alloc.vec.Vec Std.U8)
    (h : kernel.echo_kernel.echo_roots_loop c.nodes c.bits c.side c.ws c.names c.name_start
      c.name_len c.var_node c.var_width c.anames c.aname_start c.aname_len c.fnames c.fname_start
      c.fname_len c.func_width roots out n k = ok r) :
    r.1 = core.result.Result.Ok () → ∃ ts : List SExp, ts.length = roots.val.length ∧
      r.2.val = out0.val ++ renderScript (ts.map assertE) ∧
      ∀ j (hj : j < ts.length), NodeDen c (roots.val.getD j 0#usize).val true ts[j] := by
  unfold kernel.echo_kernel.echo_roots_loop at h
  refine loop_ok (fun (st : alloc.vec.Vec Std.U8 × Std.Usize) => roots.val.length - st.2.val)
    (fun st => st.2.val ≤ roots.val.length ∧ ∃ ts : List SExp, ts.length = st.2.val ∧
      st.1.val = out0.val ++ renderScript (ts.map assertE) ∧
      ∀ j (hj : j < ts.length), NodeDen c (roots.val.getD j 0#usize).val true ts[j])
    (fun (r : core.result.Result Unit kernel.echo_kernel.EchoError × alloc.vec.Vec Std.U8) =>
      r.1 = core.result.Result.Ok () → ∃ ts : List SExp, ts.length = roots.val.length ∧
      r.2.val = out0.val ++ renderScript (ts.map assertE) ∧
      ∀ j (hj : j < ts.length), NodeDen c (roots.val.getD j 0#usize).val true ts[j])
    _ ?_ (out, k) hinv r h
  intro st hst r1 hr
  obtain ⟨out1, k1⟩ := st
  obtain ⟨hk, ts, hlen, ho, hden⟩ := hst
  (try dsimp only at hk hlen ho)
  unfold kernel.echo_kernel.echo_roots_loop.body at hr
  (try dsimp only at hr)
  split at hr
  · rename_i hlt
    have hkl : k1.val < roots.val.length := by
      have : k1.val < n.val := by simpa using hlt
      omega
    obtain ⟨s, hs, hr⟩ := bind_ok_inv hr
    have hs' := lift_ok hs
    subst hs'
    obtain ⟨o1, ho1, hr⟩ := bind_ok_inv hr
    obtain ⟨x, hx, hr⟩ := bind_ok_inv hr
    obtain ⟨⟨rr, o2⟩, hnode, hr⟩ := bind_ok_inv hr
    (try dsimp only at hr)
    obtain ⟨_, hxv⟩ := slice_index_ok hx
    cases rr with
    | Err e =>
      cases hr
      refine ⟨fun y hy => ?_, fun x' hx' => (nomatch hx')⟩
      cases hy
      intro hc
      cases hc
    | Ok u =>
      cases u
      (try dsimp only at hr)
      obtain ⟨s1, hs1, hr⟩ := bind_ok_inv hr
      have hs1' := lift_ok hs1
      subst hs1'
      obtain ⟨o3, ho3, hr⟩ := bind_ok_inv hr
      obtain ⟨k2, hk2, hr⟩ := bind_ok_inv hr
      cases hr
      refine ⟨fun y hy => (nomatch hy), fun x' hx' => ?_⟩
      cases hx'
      have hk2' : k2.val = k1.val + 1 := by have := uadd_ok hk2; simpa using this
      obtain ⟨e, he, hde⟩ := echo_node_ok c H (x.val + 1) x (by omega) true o1 o2 hnode
      refine ⟨⟨by (try dsimp only); omega, ts ++ [e], by simp [hlen, hk2'], ?_, ?_⟩,
        by (try dsimp only); omega⟩
      · (try dsimp only)
        rw [push_word_ok ho3, he, push_word_ok ho1, ho, List.map_append, renderScript_append]
        simp only [List.map_cons, List.map_nil, renderScript, assertE, render, renderSp,
          List.drop_succ_cons, List.drop_zero, List.append_assoc, List.cons_append,
          List.nil_append, List.append_nil]
        rfl
      · intro j hj
        rcases Nat.lt_or_ge j ts.length with hlt' | hge'
        · rw [List.getElem_append_left hlt']
          exact hden j hlt'
        · have hje : j = ts.length := by
            simp only [List.length_append, List.length_cons, List.length_nil] at hj
            omega
          subst hje
          rw [List.getElem_append_right (le_refl _)]
          simp only [Nat.sub_self, List.getElem_cons_zero]
          rw [hlen, ← hxv 0#usize]
          exact hde
  · rename_i hge
    cases hr
    refine ⟨fun y hy => ?_, fun x' hx => (nomatch hx)⟩
    cases hy
    intro _
    have hke : k1.val = roots.val.length := by
      have : ¬ k1.val < n.val := by simpa using hge
      omega
    exact ⟨ts, by rw [hlen, hke], ho, hden⟩

theorem echo_roots_ok (c : EchoIn) (H : Good c) (roots : Slice Std.Usize)
    {out out' : alloc.vec.Vec Std.U8}
    (h : kernel.echo_kernel.echo_roots c.nodes c.bits c.side c.ws c.names c.name_start c.name_len
      c.var_node c.var_width c.anames c.aname_start c.aname_len c.fnames c.fname_start c.fname_len
      c.func_width roots out = ok (core.result.Result.Ok (), out')) :
    ∃ ts : List SExp, ts.length = roots.val.length ∧
      out'.val = out.val ++ renderScript (ts.map assertE) ∧
      ∀ j (hj : j < ts.length), NodeDen c (roots.val.getD j 0#usize).val true ts[j] := by
  unfold kernel.echo_kernel.echo_roots at h
  (try dsimp only at h)
  exact echo_roots_loop_ok c H roots (Slice.len roots) (by simp) out out 0#usize
    ⟨by simp, [], rfl, by simp [renderScript], fun j hj => by simp at hj⟩ _ h rfl

/- ── the logic ── -/

/-- The logic the printer names. -/
def logicOf (c : EchoIn) : List Std.U8 :=
  if 0 < c.nf then bytes "QF_AUFBV" else if 0 < c.na then bytes "QF_ABV" else bytes "QF_BV"

theorem push_logic_ok (c : EchoIn) {na nf : Std.Usize} (hna : na.val = c.na) (hnf : nf.val = c.nf)
    {out out' : alloc.vec.Vec Std.U8}
    (h : kernel.echo_kernel.push_logic out na nf = ok out') :
    out'.val = out.val ++ (render (setLogicE (logicOf c)) ++ [cNl]) := by
  unfold kernel.echo_kernel.push_logic at h
  obtain ⟨s, hs, h⟩ := bind_ok_inv h
  have hs' := lift_ok hs
  subst hs'
  obtain ⟨o1, ho1, h⟩ := bind_ok_inv h
  obtain ⟨o2, ho2, h⟩ := bind_ok_inv h
  obtain ⟨s1, hs1, h⟩ := bind_ok_inv h
  have hs1' := lift_ok hs1
  subst hs1'
  rw [push_word_ok h]
  split at ho2
  · rename_i hf
    have hfp : 0 < c.nf := by rw [← hnf]; simpa using hf
    obtain ⟨s2, hs2, ho2⟩ := bind_ok_inv ho2
    have hs2' := lift_ok hs2
    subst hs2'
    rw [push_word_ok ho2, push_word_ok ho1]
    simp only [logicOf, hfp, if_true, setLogicE, render, renderSp, List.drop_succ_cons,
      List.drop_zero, List.append_assoc, List.cons_append, List.nil_append, List.append_nil]
    rfl
  · rename_i hf
    have hf0 : ¬ 0 < c.nf := by rw [← hnf]; simpa using hf
    split at ho2
    · rename_i ha
      have hap : 0 < c.na := by rw [← hna]; simpa using ha
      obtain ⟨s2, hs2, ho2⟩ := bind_ok_inv ho2
      have hs2' := lift_ok hs2
      subst hs2'
      rw [push_word_ok ho2, push_word_ok ho1]
      simp only [logicOf, hf0, hap, if_true, if_false, setLogicE, render, renderSp,
        List.drop_succ_cons, List.drop_zero, List.append_assoc, List.cons_append, List.nil_append,
        List.append_nil]
      rfl
    · rename_i ha
      have ha0 : ¬ 0 < c.na := by rw [← hna]; simpa using ha
      obtain ⟨s2, hs2, ho2⟩ := bind_ok_inv ho2
      have hs2' := lift_ok hs2
      subst hs2'
      rw [push_word_ok ho2, push_word_ok ho1]
      simp only [logicOf, hf0, ha0, if_false, setLogicE, render, renderSp, List.drop_succ_cons,
        List.drop_zero, List.append_assoc, List.cons_append, List.nil_append, List.append_nil]
      rfl

/- ══════════════════ THE ECHO OF AN EXTENDED QUERY ══════════════════ -/

/-- **The assignment an SMT-LIB interpretation induces** on the node
    list's primary inputs, through the variable table: the block of a
    `Var` node is the bits of the constant its first table entry names. -/
def layoutOf (I : Interp) (nodes : List ExtNode) (names : List Std.U8)
    (name_start name_len var_node : List Std.Usize) : List Bool :=
  layoutAux (fun i =>
    match nodes.getD i dfltExt with
    | .Core (.Var w) =>
      (List.range w.val).map fun j =>
        (I.cst (entryName names name_start name_len (nodeVar var_node i)) w.val).getLsbD j
    | _ => []) nodes.length

/-- The array interpretation by id, through the array table. -/
def arrsOf (I : Interp) (anames : List Std.U8) (aname_start aname_len : List Std.Usize) : Arrs :=
  fun aid => I.arr (entryName anames aname_start aname_len aid)

/-- The function interpretation by id, through the function table. -/
def ufsOf (I : Interp) (fnames : List Std.U8) (fname_start fname_len : List Std.Usize) : Ufs :=
  fun fid => I.fn (entryName fnames fname_start fname_len fid)

theorem slice_len_eq {α β : Type} {a : Slice α} {b : Slice β}
    (h : ¬ ((Slice.len a != Slice.len b) = true)) : a.val.length = b.val.length := by
  simp only [bne_iff_ne, ne_eq, Decidable.not_not] at h
  have := congrArg UScalar.val h
  simpa using this

theorem printable_sortE (w : Nat) : Printable (sortE w) := by
  simp only [sortE, Printable, PrintableL]
  exact ⟨by rfl, by rfl, trivial, trivial⟩

theorem printableL_sorts : ∀ (args : List Nat), PrintableL (args.map sortE)
  | [] => by simp only [List.map_nil, PrintableL]
  | a :: rest => by
    simp only [List.map_cons, PrintableL]
    exact ⟨printable_sortE a, printableL_sorts rest⟩

theorem printable_declE (n : List Std.U8) (d : Decl) (hn : qOk n = true) :
    Printable (declE (n, d)) := by
  cases d with
  | bv w =>
    simp only [declE, Printable, PrintableL]
    exact ⟨by rfl, hn, printable_sortE w, trivial⟩
  | arr =>
    simp only [declE, arrSortE, Printable, PrintableL]
    exact ⟨by rfl, hn, ⟨by rfl, printable_sortE 32, printable_sortE 8, trivial⟩, trivial⟩
  | fn args w =>
    simp only [declE, Printable, PrintableL]
    exact ⟨by rfl, hn, printableL_sorts args, printable_sortE w, trivial⟩

theorem printableL_append : ∀ (a b : List SExp), PrintableL a → PrintableL b →
    PrintableL (a ++ b)
  | [], b, _, hb => hb
  | x :: a, b, ha, hb => by
    simp only [List.cons_append, PrintableL] at ha ⊢
    exact ⟨ha.1, printableL_append a b ha.2 hb⟩

theorem printableL_map {α : Type} (f : α → SExp) : ∀ (l : List α), (∀ x ∈ l, Printable (f x)) →
    PrintableL (l.map f)
  | [], _ => by simp only [List.map_nil, PrintableL]
  | x :: l, h => by
    simp only [List.map_cons, PrintableL]
    exact ⟨h x (by simp), printableL_map f l (fun y hy => h y (by simp [hy]))⟩

/-- Everything an accepted `echo_ext` established, over its `EchoIn`. -/
theorem echo_ext_ok (e : Slice ExtNode) (ebits : Slice Bool) (eside eroots : Slice Std.Usize)
    (names : Slice Std.U8) (name_start name_len var_node var_width : Slice Std.Usize)
    (anames : Slice Std.U8) (aname_start aname_len : Slice Std.Usize)
    (fnames : Slice Std.U8) (fname_start fname_len func_width : Slice Std.Usize)
    (out : alloc.vec.Vec Std.U8)
    (h : kernel.echo_kernel.echo_ext e ebits eside eroots names name_start name_len var_node
      var_width anames aname_start aname_len fnames fname_start fname_len func_width
        = ok (core.result.Result.Ok out)) :
    ∃ (ws : Slice Std.Usize) (ts : List SExp),
      let c : EchoIn := ⟨e, ebits, eside, ws, names, name_start, name_len, var_node, var_width,
        anames, aname_start, aname_len, fnames, fname_start, fname_len, func_width⟩
      Good c ∧ ts.length = eroots.val.length ∧
      out.val = renderScript (scriptOf (logicOf c) c.sg ts) ∧
      (∀ j (hj : j < ts.length), NodeDen c (eroots.val.getD j 0#usize).val true ts[j]) ∧
      (∀ p ∈ c.sg, DeclWF p.2) := by
  unfold kernel.echo_kernel.echo_ext at h
  (try dsimp only at h)
  obtain ⟨r, hwf, h⟩ := bind_ok_inv h
  cases r with
  | Err e' => cases h
  | Ok ws =>
    (try dsimp only at h)
    change (if (Slice.len name_len != Slice.len name_start) = true then _ else _) = _ at h
    by_cases h1 : (Slice.len name_len != Slice.len name_start) = true
    · rw [if_pos h1] at h
      cases h
    rw [if_neg h1] at h
    by_cases h2 : (Slice.len var_node != Slice.len name_start) = true
    · rw [if_pos h2] at h
      cases h
    rw [if_neg h2] at h
    by_cases h3 : (Slice.len var_width != Slice.len name_start) = true
    · rw [if_pos h3] at h
      cases h
    rw [if_neg h3] at h
    by_cases h4 : (Slice.len aname_len != Slice.len aname_start) = true
    · rw [if_pos h4] at h
      cases h
    rw [if_neg h4] at h
    by_cases h5 : (Slice.len fname_len != Slice.len fname_start) = true
    · rw [if_pos h5] at h
      cases h
    rw [if_neg h5] at h
    by_cases h6 : (Slice.len func_width != Slice.len fname_start) = true
    · rw [if_pos h6] at h
      cases h
    rw [if_neg h6] at h
    obtain ⟨b, hb, h⟩ := bind_ok_inv h
    by_cases hbt : b = true
    rotate_left
    · rw [if_neg hbt] at h
      cases h
    rw [if_pos hbt] at h
    obtain ⟨b1, hb1, h⟩ := bind_ok_inv h
    by_cases hb1t : b1 = true
    rotate_left
    · rw [if_neg hb1t] at h
      cases h
    rw [if_pos hb1t] at h
    obtain ⟨b2, hb2, h⟩ := bind_ok_inv h
    by_cases hb2t : b2 = true
    rotate_left
    · rw [if_neg hb2t] at h
      cases h
    rw [if_pos hb2t] at h
    obtain ⟨b3, hb3, h⟩ := bind_ok_inv h
    by_cases hb3t : b3 = true
    rotate_left
    · rw [if_neg hb3t] at h
      cases h
    rw [if_pos hb3t] at h
    obtain ⟨o0, ho0, h⟩ := bind_ok_inv h
    obtain ⟨⟨b4, o1⟩, hdv, h⟩ := bind_ok_inv h
    (try dsimp only at h)
    change (if b4 = true then _ else _) = _ at h
    by_cases hb4t : b4 = true
    rotate_left
    · rw [if_neg hb4t] at h
      cases h
    rw [if_pos hb4t] at h
    subst hb4t
    obtain ⟨⟨b5, o2⟩, hda, h⟩ := bind_ok_inv h
    (try dsimp only at h)
    change (if b5 = true then _ else _) = _ at h
    by_cases hb5t : b5 = true
    rotate_left
    · rw [if_neg hb5t] at h
      cases h
    rw [if_pos hb5t] at h
    subst hb5t
    obtain ⟨⟨b6, o3⟩, hdf, h⟩ := bind_ok_inv h
    (try dsimp only at h)
    change (if b6 = true then _ else _) = _ at h
    by_cases hb6t : b6 = true
    rotate_left
    · rw [if_neg hb6t] at h
      cases h
    rw [if_pos hb6t] at h
    subst hb6t
    obtain ⟨⟨r1, o4⟩, hroots, h⟩ := bind_ok_inv h
    (try dsimp only at h)
    cases r1 with
    | Err e' => cases h
    | Ok u =>
      cases u
      (try dsimp only at h)
      obtain ⟨s11, hs11, h⟩ := bind_ok_inv h
      have hs11' := lift_ok hs11
      subst hs11'
      obtain ⟨o5, ho5, h⟩ := bind_ok_inv h
      cases h
      have hspec := sliver_ext_wf_spec e (Slice.len ebits) eside
      rw [hwf] at hspec
      simp only [WP.spec_ok] at hspec
      obtain ⟨hws, hwfE⟩ := hspec
      have he8 : (alloc.vec.Vec.deref (alloc.vec.Vec.new Std.U8)).val = [] := rfl
      have heu : (alloc.vec.Vec.deref (alloc.vec.Vec.new Std.Usize)).val = [] := rfl
      obtain ⟨hvl, hvg⟩ := table_ok_ok hb hbt
      obtain ⟨hal, hag⟩ := table_ok_ok hb1 hb1t
      obtain ⟨hfl, hfg⟩ := table_ok_ok hb2 hb2t
      rw [he8, heu] at hvg hag
      refine ⟨alloc.vec.Vec.deref ws, ?_⟩
      have H : Good ⟨e, ebits, eside, alloc.vec.Vec.deref ws, names, name_start, name_len,
          var_node, var_width, anames, aname_start, aname_len, fnames, fname_start, fname_len,
          func_width⟩ :=
        { ws := hws
          wf := by simpa using hwfE
          vlen := slice_len_eq h1
          vnlen := slice_len_eq h2
          vwlen := slice_len_eq h3
          alen := slice_len_eq h4
          flen := slice_len_eq h5
          fwlen := slice_len_eq h6
          vgood := hvg
          agood := hag
          fgood := hfg }
      obtain ⟨hvpos, ho1E⟩ := decl_vars_ok _ H hdv
      have ho2E := decl_arrays_ok _ H hda
      obtain ⟨hfwf, ho3E⟩ := decl_funcs_ok _ H hdf
      obtain ⟨ts, hlen, ho4E, hden⟩ := echo_roots_ok _ H eroots hroots
      have ho0E := push_logic_ok (⟨e, ebits, eside, alloc.vec.Vec.deref ws, names, name_start,
          name_len, var_node, var_width, anames, aname_start, aname_len, fnames, fname_start,
          fname_len, func_width⟩ : EchoIn) (na := Slice.len aname_start)
        (nf := Slice.len fname_start) (by simp [EchoIn.na]) (by simp [EchoIn.nf]) ho0
      refine ⟨ts, H, hlen, ?_, hden, ?_⟩
      · rw [push_word_ok ho5, ho4E, ho3E, ho2E, ho1E, ho0E]
        simp only [scriptOf, EchoIn.sg, renderScript, List.map_append, renderScript_append,
          List.append_assoc, List.cons_append, List.nil_append, alloc.vec.Vec.new,
          checkSatE, render, renderSp, List.drop_succ_cons, List.drop_zero, List.append_nil]
        rfl
      · intro p hp
        simp only [EchoIn.sg, List.mem_append] at hp
        rcases hp with hp | hp | hp
        · simp only [EchoIn.varSig, List.mem_map, List.mem_range] at hp
          obtain ⟨k, hk, rfl⟩ := hp
          exact hvpos k hk
        · simp only [EchoIn.arrSig, List.mem_map, List.mem_range] at hp
          obtain ⟨a, ha, rfl⟩ := hp
          trivial
        · simp only [EchoIn.funSig, List.mem_map, List.mem_range] at hp
          obtain ⟨g, hg, rfl⟩ := hp
          exact hfwf g hg

/-- The logic the printer names allows every declaration it makes. -/
theorem logic_allows (c : EchoIn) (H : Good c) :
    (logicOf c = bytes "QF_BV" ∨ logicOf c = bytes "QF_ABV" ∨ logicOf c = bytes "QF_AUFBV") ∧
    ∀ p ∈ c.sg, nameOk p.1 ∧ logicAllows (logicOf c) p.2 := by
  constructor
  · unfold logicOf
    split
    · exact Or.inr (Or.inr rfl)
    · split
      · exact Or.inr (Or.inl rfl)
      · exact Or.inl rfl
  · intro p hp
    simp only [EchoIn.sg, List.mem_append] at hp
    rcases hp with hp | hp | hp
    · simp only [EchoIn.varSig, List.mem_map, List.mem_range] at hp
      obtain ⟨k, hk, rfl⟩ := hp
      exact ⟨(H.vgood k hk).2.1, trivial⟩
    · simp only [EchoIn.arrSig, List.mem_map, List.mem_range] at hp
      obtain ⟨a, ha, rfl⟩ := hp
      refine ⟨(H.agood a ha).2.1, ?_⟩
      have hpos : 0 < c.na := by omega
      have hl : logicOf c = bytes "QF_ABV" ∨ logicOf c = bytes "QF_AUFBV" := by
        unfold logicOf
        by_cases hf : 0 < c.nf
        · rw [if_pos hf]
          exact Or.inr rfl
        · rw [if_neg hf, if_pos hpos]
          exact Or.inl rfl
      exact hl
    · simp only [EchoIn.funSig, List.mem_map, List.mem_range] at hp
      obtain ⟨g, hg, rfl⟩ := hp
      refine ⟨(H.fgood g hg).2.1, ?_⟩
      have hpos : 0 < c.nf := by omega
      refine Or.inr ?_
      unfold logicOf
      rw [if_pos hpos]

theorem printable_script (c : EchoIn) (H : Good c) (ts : List SExp)
    (hts : ∀ j (hj : j < ts.length), Printable ts[j]) :
    PrintableL (scriptOf (logicOf c) c.sg ts) := by
  have hlog : symOk (logicOf c) = true := by
    unfold logicOf
    split
    · rfl
    · split <;> rfl
  simp only [scriptOf, PrintableL]
  refine ⟨?_, printableL_append _ _ ?_ (printableL_append _ _ ?_ ?_)⟩
  · simp only [setLogicE, Printable, PrintableL]
    exact ⟨by rfl, hlog, trivial⟩
  · apply printableL_map
    intro p hp
    obtain ⟨n, d⟩ := p
    exact printable_declE n d (qOk_of_nameOk ((logic_allows c H).2 (n, d) hp).1)
  · apply printableL_map
    intro t ht
    obtain ⟨j, hj, rfl⟩ := List.mem_iff_getElem.mp ht
    simp only [assertE, Printable, PrintableL]
    exact ⟨by rfl, hts j hj, trivial⟩
  · simp only [checkSatE, PrintableL, Printable]
    exact ⟨⟨by rfl, trivial⟩, trivial⟩

/-- **THE ECHO THEOREM (extended queries)**: an accepted `echo_ext`
    returned the text of a script the reader reads back, and under EVERY
    SMT-LIB interpretation of its declared symbols the script is
    satisfied exactly when every root of the node list is true under the
    assignment, the array interpretation and the function interpretation
    read off that interpretation through the tables. -/
theorem echo_ext_sound (e : Slice ExtNode) (ebits : Slice Bool) (eside eroots : Slice Std.Usize)
    (names : Slice Std.U8) (name_start name_len var_node var_width : Slice Std.Usize)
    (anames : Slice Std.U8) (aname_start aname_len : Slice Std.Usize)
    (fnames : Slice Std.U8) (fname_start fname_len func_width : Slice Std.Usize)
    (out : alloc.vec.Vec Std.U8)
    (h : kernel.echo_kernel.echo_ext e ebits eside eroots names name_start name_len var_node
      var_width anames aname_start aname_len fnames fname_start fname_len func_width
        = ok (core.result.Result.Ok out)) :
    ∃ cs, out.val = renderScript cs ∧ PrintableL cs ∧
      ∀ I : Interp, ScriptSat I cs ↔
        ExtSat (layoutOf I e.val names.val name_start.val name_len.val var_node.val) ebits.val
          (arrsOf I anames.val aname_start.val aname_len.val)
          (ufsOf I fnames.val fname_start.val fname_len.val) eside.val e.val eroots.val := by
  obtain ⟨ws, ts, H, hlen, hout, hden, hdwf⟩ := echo_ext_ok e ebits eside eroots names name_start
    name_len var_node var_width anames aname_start aname_len fnames fname_start fname_len
    func_width out h
  (try dsimp only at H hout hden hdwf)
  generalize hc : (⟨e, ebits, eside, ws, names, name_start, name_len, var_node, var_width,
    anames, aname_start, aname_len, fnames, fname_start, fname_len, func_width⟩ : EchoIn) = c
    at H hout hden hdwf
  have hla := logic_allows c H
  refine ⟨scriptOf (logicOf c) c.sg ts, hout,
    printable_script c H ts (fun j hj => (hden j hj).1), fun I => ?_⟩
  rw [scriptSat_iff I (logicOf c) c.sg ts hla.1
    (fun p hp => ⟨hdwf p hp, (hla.2 p hp).1, (hla.2 p hp).2⟩) H.names_distinct]
  have hsim : extSim (layoutOf I e.val names.val name_start.val name_len.val var_node.val)
      ebits.val (arrsOf I anames.val aname_start.val aname_len.val)
      (ufsOf I fnames.val fname_start.val fname_len.val) eside.val e.val = c.sim I := by
    subst hc
    rfl
  unfold ExtSat extBool
  rw [hsim]
  constructor
  · intro hall k hk
    have hk' : k < ts.length := by rw [hlen]; exact hk
    have h1 := (hden k hk').2 I
    rw [hall ts[k] (List.getElem_mem hk')] at h1
    simp only [valK, Option.some.injEq, Val.bool.injEq] at h1
    rw [getD_eq_getElem_of_lt hk] at h1
    exact h1.symm
  · intro hall t ht
    obtain ⟨k, hk', rfl⟩ := List.mem_iff_getElem.mp ht
    have hk : k < eroots.val.length := by rw [← hlen]; exact hk'
    have h1 := (hden k hk').2 I
    simp only [valK] at h1
    rw [getD_eq_getElem_of_lt hk, hall k hk] at h1
    exact h1

/-- The same, for the text: it is satisfied by an interpretation exactly
    when the node list's roots are. -/
theorem echo_ext_text_sound (e : Slice ExtNode) (ebits : Slice Bool)
    (eside eroots : Slice Std.Usize)
    (names : Slice Std.U8) (name_start name_len var_node var_width : Slice Std.Usize)
    (anames : Slice Std.U8) (aname_start aname_len : Slice Std.Usize)
    (fnames : Slice Std.U8) (fname_start fname_len func_width : Slice Std.Usize)
    (out : alloc.vec.Vec Std.U8)
    (h : kernel.echo_kernel.echo_ext e ebits eside eroots names name_start name_len var_node
      var_width anames aname_start aname_len fnames fname_start fname_len func_width
        = ok (core.result.Result.Ok out)) :
    ∀ I : Interp, TextSat I out.val ↔
      ExtSat (layoutOf I e.val names.val name_start.val name_len.val var_node.val) ebits.val
        (arrsOf I anames.val aname_start.val aname_len.val)
        (ufsOf I fnames.val fname_start.val fname_len.val) eside.val e.val eroots.val := by
  obtain ⟨cs, hout, hp, hiff⟩ := echo_ext_sound e ebits eside eroots names name_start name_len
    var_node var_width anames aname_start aname_len fnames fname_start fname_len func_width out h
  intro I
  rw [hout, textSat_render I cs hp]
  exact hiff I

/-- **THE UNSAT CAPSTONE (extended queries)**: an accepted echo, an
    accepted sliver check, an accepted term check and an accepted query
    re-check make the echoed script unsatisfiable — NO SMT-LIB
    interpretation of its declared symbols satisfies it. -/
theorem echo_ext_unsat_sound (e : Slice ExtNode) (ebits : Slice Bool)
    (eside eroots : Slice Std.Usize)
    (names : Slice Std.U8) (name_start name_len var_node var_width : Slice Std.Usize)
    (anames : Slice Std.U8) (aname_start aname_len : Slice Std.Usize)
    (fnames : Slice Std.U8) (fname_start fname_len func_width : Slice Std.Usize)
    (out : alloc.vec.Vec Std.U8)
    (map reads calls cargs : Slice Std.Usize) (t : Slice blast_kernel.DagNode)
    (tbits : Slice Bool) (troots map1 : Slice Std.Usize) (ns : Slice blast_kernel.DagNode)
    (bits : Slice Bool) (roots hints : Slice Std.Usize) (steps : Slice kernel.Step)
    (cnf : alloc.vec.Vec (alloc.vec.Vec Std.I32))
    (he : kernel.echo_kernel.echo_ext e ebits eside eroots names name_start name_len var_node
      var_width anames aname_start aname_len fnames fname_start fname_len func_width
        = ok (core.result.Result.Ok out))
    (hs : kernel.sliver_kernel.check_sliver_lowering e ebits eside eroots map reads calls cargs t
      tbits troots = ok (core.result.Result.Ok ()))
    (ht : kernel.check_term_dag t tbits troots map1 ns bits roots = ok (core.result.Result.Ok ()))
    (hq : kernel.check_query ns bits roots hints steps = ok (core.result.Result.Ok cnf)) :
    ∃ cs, out.val = renderScript cs ∧ PrintableL cs ∧ ∀ I : Interp, ¬ ScriptSat I cs := by
  obtain ⟨cs, hout, hp, hiff⟩ := echo_ext_sound e ebits eside eroots names name_start name_len
    var_node var_width anames aname_start aname_len fnames fname_start fname_len func_width out he
  refine ⟨cs, hout, hp, fun I hsat => ?_⟩
  exact check_sliver_unsat_sound e ebits eside eroots map reads calls cargs t tbits troots map1 ns
    bits roots hints steps cnf hs ht hq _ _ _ ((hiff I).mp hsat)

/-- The same, for the text: no interpretation satisfies it. -/
theorem echo_ext_text_unsat (e : Slice ExtNode) (ebits : Slice Bool)
    (eside eroots : Slice Std.Usize)
    (names : Slice Std.U8) (name_start name_len var_node var_width : Slice Std.Usize)
    (anames : Slice Std.U8) (aname_start aname_len : Slice Std.Usize)
    (fnames : Slice Std.U8) (fname_start fname_len func_width : Slice Std.Usize)
    (out : alloc.vec.Vec Std.U8)
    (map reads calls cargs : Slice Std.Usize) (t : Slice blast_kernel.DagNode)
    (tbits : Slice Bool) (troots map1 : Slice Std.Usize) (ns : Slice blast_kernel.DagNode)
    (bits : Slice Bool) (roots hints : Slice Std.Usize) (steps : Slice kernel.Step)
    (cnf : alloc.vec.Vec (alloc.vec.Vec Std.I32))
    (he : kernel.echo_kernel.echo_ext e ebits eside eroots names name_start name_len var_node
      var_width anames aname_start aname_len fnames fname_start fname_len func_width
        = ok (core.result.Result.Ok out))
    (hs : kernel.sliver_kernel.check_sliver_lowering e ebits eside eroots map reads calls cargs t
      tbits troots = ok (core.result.Result.Ok ()))
    (ht : kernel.check_term_dag t tbits troots map1 ns bits roots = ok (core.result.Result.Ok ()))
    (hq : kernel.check_query ns bits roots hints steps = ok (core.result.Result.Ok cnf)) :
    ∀ I : Interp, ¬ TextSat I out.val := by
  obtain ⟨cs, hout, hp, hun⟩ := echo_ext_unsat_sound e ebits eside eroots names name_start name_len
    var_node var_width anames aname_start aname_len fnames fname_start fname_len func_width out
    map reads calls cargs t tbits troots map1 ns bits roots hints steps cnf he hs ht hq
  intro I
  rw [hout, textSat_render I cs hp]
  exact hun I

/- ══════════════════ THE ECHO OF A TERM ══════════════════ -/

theorem lift_core_loop_ok (t : Slice blast_kernel.DagNode) (n : Std.Usize)
    (hn : n.val = t.val.length) (out : alloc.vec.Vec ExtNode) (i : Std.Usize)
    (hinv : i.val ≤ t.val.length ∧ out.val = (t.val.take i.val).map kernel.sliver_kernel.ExtNode.Core)
    (v : alloc.vec.Vec ExtNode) (h : kernel.echo_kernel.lift_core_loop t out n i = ok v) :
    v.val = t.val.map kernel.sliver_kernel.ExtNode.Core := by
  unfold kernel.echo_kernel.lift_core_loop at h
  refine loop_ok (fun (st : alloc.vec.Vec ExtNode × Std.Usize) => t.val.length - st.2.val)
    (fun st => st.2.val ≤ t.val.length ∧ st.1.val = (t.val.take st.2.val).map kernel.sliver_kernel.ExtNode.Core)
    (fun v => v.val = t.val.map kernel.sliver_kernel.ExtNode.Core) _ ?_ (out, i) hinv v h
  intro st hst r hr
  obtain ⟨out1, i1⟩ := st
  obtain ⟨hi, ho⟩ := hst
  (try dsimp only at hi ho)
  unfold kernel.echo_kernel.lift_core_loop.body at hr
  (try dsimp only at hr)
  split at hr
  · rename_i hlt
    have hil : i1.val < t.val.length := by
      have : i1.val < n.val := by simpa using hlt
      omega
    obtain ⟨nd, hnd, hr⟩ := bind_ok_inv hr
    obtain ⟨out2, ho2, hr⟩ := bind_ok_inv hr
    obtain ⟨i2, hi2, hr⟩ := bind_ok_inv hr
    cases hr
    refine ⟨fun y hy => (nomatch hy), fun x' hx => ?_⟩
    cases hx
    have hi2' : i2.val = i1.val + 1 := by have := uadd_ok hi2; simpa using this
    obtain ⟨_, hndv⟩ := slice_index_ok hnd
    refine ⟨⟨by (try dsimp only); omega, ?_⟩, by (try dsimp only); omega⟩
    (try dsimp only)
    rw [push_ok ho2, ho, hi2', take_succ_getD _ _ dfltNode hil, List.map_append, hndv dfltNode]
    rfl
  · rename_i hge
    cases hr
    refine ⟨fun y hy => ?_, fun x' hx => (nomatch hx)⟩
    cases hy
    have : ¬ i1.val < n.val := by simpa using hge
    rw [ho, List.take_of_length_le (by omega)]

theorem lift_core_ok {t : Slice blast_kernel.DagNode} {v : alloc.vec.Vec ExtNode}
    (h : kernel.echo_kernel.lift_core t = ok v) : v.val = t.val.map kernel.sliver_kernel.ExtNode.Core := by
  unfold kernel.echo_kernel.lift_core at h
  (try dsimp only at h)
  exact lift_core_loop_ok t (Slice.len t) (by simp) _ 0#usize ⟨by simp, by simp⟩ v h

/-- **THE ECHO THEOREM (terms)**: an accepted `echo_term` returned the
    text of a script the reader reads back, and under EVERY SMT-LIB
    interpretation of its declared constants the script is satisfied
    exactly when every root of the term is true under the assignment read
    off that interpretation through the variable table. -/
theorem echo_term_sound (t : Slice blast_kernel.DagNode) (tbits : Slice Bool)
    (troots : Slice Std.Usize) (names : Slice Std.U8)
    (name_start name_len var_node var_width : Slice Std.Usize) (out : alloc.vec.Vec Std.U8)
    (h : kernel.echo_kernel.echo_term t tbits troots names name_start name_len var_node var_width
      = ok (core.result.Result.Ok out)) :
    ∃ cs, out.val = renderScript cs ∧ PrintableL cs ∧
      ∀ I : Interp, ScriptSat I cs ↔ ∀ k (hk : k < troots.val.length),
        dagBool (layoutOf I (t.val.map kernel.sliver_kernel.ExtNode.Core) names.val name_start.val name_len.val
          var_node.val) tbits.val t.val (troots.val[k]).val = true := by
  unfold kernel.echo_kernel.echo_term at h
  obtain ⟨nodes, hnodes, h⟩ := bind_ok_inv h
  (try dsimp only at h)
  have hnv := lift_core_ok hnodes
  obtain ⟨cs, hout, hp, hiff⟩ := echo_ext_sound _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ out h
  refine ⟨cs, hout, hp, fun I => ?_⟩
  rw [hiff I]
  have hd : (alloc.vec.Vec.deref nodes).val = t.val.map kernel.sliver_kernel.ExtNode.Core := hnv
  rw [hd]
  unfold ExtSat extBool dagBool
  rw [extSim_map_core]

/-- The same, for the text. -/
theorem echo_term_text_sound (t : Slice blast_kernel.DagNode) (tbits : Slice Bool)
    (troots : Slice Std.Usize) (names : Slice Std.U8)
    (name_start name_len var_node var_width : Slice Std.Usize) (out : alloc.vec.Vec Std.U8)
    (h : kernel.echo_kernel.echo_term t tbits troots names name_start name_len var_node var_width
      = ok (core.result.Result.Ok out)) :
    ∀ I : Interp, TextSat I out.val ↔ ∀ k (hk : k < troots.val.length),
      dagBool (layoutOf I (t.val.map kernel.sliver_kernel.ExtNode.Core) names.val name_start.val name_len.val
        var_node.val) tbits.val t.val (troots.val[k]).val = true := by
  obtain ⟨cs, hout, hp, hiff⟩ := echo_term_sound t tbits troots names name_start name_len var_node
    var_width out h
  intro I
  rw [hout, textSat_render I cs hp]
  exact hiff I

/-- **THE UNSAT CAPSTONE (terms)**: an accepted echo, an accepted term
    check and an accepted query re-check make the echoed script
    unsatisfiable — NO SMT-LIB interpretation of its declared constants
    satisfies it. -/
theorem echo_unsat_sound (t : Slice blast_kernel.DagNode) (tbits : Slice Bool)
    (troots : Slice Std.Usize) (names : Slice Std.U8)
    (name_start name_len var_node var_width : Slice Std.Usize) (out : alloc.vec.Vec Std.U8)
    (map : Slice Std.Usize) (ns : Slice blast_kernel.DagNode) (bits : Slice Bool)
    (roots hints : Slice Std.Usize) (steps : Slice kernel.Step)
    (cnf : alloc.vec.Vec (alloc.vec.Vec Std.I32))
    (he : kernel.echo_kernel.echo_term t tbits troots names name_start name_len var_node var_width
      = ok (core.result.Result.Ok out))
    (ht : kernel.check_term_dag t tbits troots map ns bits roots = ok (core.result.Result.Ok ()))
    (hq : kernel.check_query ns bits roots hints steps = ok (core.result.Result.Ok cnf)) :
    ∃ cs, out.val = renderScript cs ∧ PrintableL cs ∧ ∀ I : Interp, ¬ ScriptSat I cs := by
  obtain ⟨cs, hout, hp, hiff⟩ := echo_term_sound t tbits troots names name_start name_len var_node
    var_width out he
  refine ⟨cs, hout, hp, fun I hsat => ?_⟩
  exact check_term_unsat_sound t tbits troots map ns bits roots hints steps cnf ht hq _
    ((hiff I).mp hsat)

/-- The same, for the text: no interpretation satisfies it. -/
theorem echo_text_unsat (t : Slice blast_kernel.DagNode) (tbits : Slice Bool)
    (troots : Slice Std.Usize) (names : Slice Std.U8)
    (name_start name_len var_node var_width : Slice Std.Usize) (out : alloc.vec.Vec Std.U8)
    (map : Slice Std.Usize) (ns : Slice blast_kernel.DagNode) (bits : Slice Bool)
    (roots hints : Slice Std.Usize) (steps : Slice kernel.Step)
    (cnf : alloc.vec.Vec (alloc.vec.Vec Std.I32))
    (he : kernel.echo_kernel.echo_term t tbits troots names name_start name_len var_node var_width
      = ok (core.result.Result.Ok out))
    (ht : kernel.check_term_dag t tbits troots map ns bits roots = ok (core.result.Result.Ok ()))
    (hq : kernel.check_query ns bits roots hints steps = ok (core.result.Result.Ok cnf)) :
    ∀ I : Interp, ¬ TextSat I out.val := by
  obtain ⟨cs, hout, hp, hun⟩ := echo_unsat_sound t tbits troots names name_start name_len var_node
    var_width out map ns bits roots hints steps cnf he ht hq
  intro I
  rw [hout, textSat_render I cs hp]
  exact hun I

