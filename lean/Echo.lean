set_option maxRecDepth 100000 in
theorem reserved_0_eq (a : Slice Std.U8) (s l : Std.Usize) :
    kernel.echo_kernel.reserved_0 a s l = anyWord a s l resWords0 := rfl

set_option maxRecDepth 100000 in
theorem reserved_1_eq (a : Slice Std.U8) (s l : Std.Usize) :
    kernel.echo_kernel.reserved_1 a s l = anyWord a s l resWords1 := rfl

set_option maxRecDepth 100000 in
theorem reserved_2_eq (a : Slice Std.U8) (s l : Std.Usize) :
    kernel.echo_kernel.reserved_2 a s l = anyWord a s l resWords2 := rfl

set_option maxRecDepth 100000 in
theorem reserved_3_eq (a : Slice Std.U8) (s l : Std.Usize) :
    kernel.echo_kernel.reserved_3 a s l = anyWord a s l resWords3 := rfl

set_option maxRecDepth 100000 in
/-- The model's list is the kernel's four tables, in order. -/
theorem reservedWords_eq :
    reservedWords = (resWords0 ++ resWords1 ++ resWords2 ++ resWords3).map (·.val) := rfl

/-- **`is_reserved` is complete for the model's list**: a name it passes
    is not a reserved word or a theory symbol. -/
theorem is_reserved_ok {a : Slice Std.U8} {s l : Std.Usize} {r : Bool}
    (h : kernel.echo_kernel.is_reserved a s l = ok r) (hr : s.val + l.val ≤ a.val.length)
    (hf : r = false) : nameAt a.val s.val l.val ∉ reservedWords := by
  unfold kernel.echo_kernel.is_reserved at h
  subst hf
  obtain ⟨b0, h0, h⟩ := bind_ok_inv h
  split at h
  · cases h
  · rename_i hb0
    obtain ⟨b1, h1, h⟩ := bind_ok_inv h
    split at h
    · cases h
    · rename_i hb1
      obtain ⟨b2, h2, h⟩ := bind_ok_inv h
      split at h
      · cases h
      · rename_i hb2
        rw [reserved_0_eq] at h0
        rw [reserved_1_eq] at h1
        rw [reserved_2_eq] at h2
        rw [reserved_3_eq] at h
        have k0 := anyWord_ok a s l hr _ _ h0 (by simpa using hb0)
        have k1 := anyWord_ok a s l hr _ _ h1 (by simpa using hb1)
        have k2 := anyWord_ok a s l hr _ _ h2 (by simpa using hb2)
        have k3 := anyWord_ok a s l hr _ _ h rfl
        rw [reservedWords_eq]
        intro hmem
        obtain ⟨w, hw, hwv⟩ := List.mem_map.mp hmem
        simp only [List.mem_append] at hw
        rcases hw with ((hw | hw) | hw) | hw
        · exact k0 w hw hwv.symm
        · exact k1 w hw hwv.symm
        · exact k2 w hw hwv.symm
        · exact k3 w hw hwv.symm

/- ══════════════════ NAME TABLES ══════════════════ -/

/-- Entry `k` of a name table: its bytes. -/
def entryName (arena : List Std.U8) (starts lens : List Std.Usize) (k : Nat) : List Std.U8 :=
  nameAt arena (starts.getD k 0#usize).val (lens.getD k 0#usize).val

/-- Entry `k` lies inside the arena. -/
def EntryIn (arena : List Std.U8) (starts lens : List Std.Usize) (k : Nat) : Prop :=
  (starts.getD k 0#usize).val + (lens.getD k 0#usize).val ≤ arena.length

theorem table_has_loop_ok (arena : Slice Std.U8) (starts lens : Slice Std.Usize) (upto : Std.Usize)
    (b : Slice Std.U8) (sb lb : Std.Usize) (j : Std.Usize) (found : Bool)
    (hinv : found = false → ∀ j' < j.val, j' < starts.val.length → j' < lens.val.length →
      EntryIn arena.val starts.val lens.val j' → sb.val + lb.val ≤ b.val.length →
      entryName arena.val starts.val lens.val j' ≠ nameAt b.val sb.val lb.val)
    (r : Bool) (h : kernel.echo_kernel.table_has_loop arena starts lens upto b sb lb j found = ok r) :
    r = false → ∀ j' < upto.val, j' < starts.val.length → j' < lens.val.length →
      EntryIn arena.val starts.val lens.val j' → sb.val + lb.val ≤ b.val.length →
      entryName arena.val starts.val lens.val j' ≠ nameAt b.val sb.val lb.val := by
  unfold kernel.echo_kernel.table_has_loop at h
  refine loop_ok (fun (st : Std.Usize × Bool) => upto.val - st.1.val)
    (fun st => st.2 = false → ∀ j' < st.1.val, j' < starts.val.length → j' < lens.val.length →
      EntryIn arena.val starts.val lens.val j' → sb.val + lb.val ≤ b.val.length →
      entryName arena.val starts.val lens.val j' ≠ nameAt b.val sb.val lb.val)
    (fun r => r = false → ∀ j' < upto.val, j' < starts.val.length → j' < lens.val.length →
      EntryIn arena.val starts.val lens.val j' → sb.val + lb.val ≤ b.val.length →
      entryName arena.val starts.val lens.val j' ≠ nameAt b.val sb.val lb.val)
    _ ?_ (j, found) hinv r h
  intro st hst r1 hr
  obtain ⟨j1, found1⟩ := st
  (try dsimp only at hst)
  unfold kernel.echo_kernel.table_has_loop.body at hr
  (try dsimp only at hr)
  split at hr
  · rename_i hlt
    have hjl : j1.val < upto.val := by simpa using hlt
    obtain ⟨found2, hf2, hr⟩ := bind_ok_inv hr
    obtain ⟨j2, hj2, hr⟩ := bind_ok_inv hr
    cases hr
    refine ⟨fun y hy => (nomatch hy), fun x' hx => ?_⟩
    cases hx
    have hj2' : j2.val = j1.val + 1 := by have := uadd_ok hj2; simpa using this
    refine ⟨?_, by (try dsimp only); omega⟩
    (try dsimp only)
    intro hff j' hj' hs hl hin hb
    rw [hj2'] at hj'
    -- `found2 = false` forces `found1 = false` and no match at `j1`.
    have hkey : found1 = false ∧ (j1.val < starts.val.length → j1.val < lens.val.length →
        EntryIn arena.val starts.val lens.val j1.val → sb.val + lb.val ≤ b.val.length →
        entryName arena.val starts.val lens.val j1.val ≠ nameAt b.val sb.val lb.val) := by
      split at hf2
      · rename_i hjs
        split at hf2
        · rename_i hjl2
          obtain ⟨i2, hi2, hf2⟩ := bind_ok_inv hf2
          obtain ⟨i3, hi3, hf2⟩ := bind_ok_inv hf2
          obtain ⟨b1, hb1, hf2⟩ := bind_ok_inv hf2
          obtain ⟨_, hi2v⟩ := slice_index_ok hi2
          obtain ⟨_, hi3v⟩ := slice_index_ok hi3
          have hre := range_eq_ok hb1
          split at hf2
          · cases hf2
            cases hff
          · rename_i hb1f
            cases hf2
            refine ⟨hff, fun _ _ hin1 hb' hc => hb1f (hre.mpr ?_)⟩
            unfold EntryIn at hin1
            unfold entryName at hc
            rw [← hi2v 0#usize, ← hi3v 0#usize] at hin1 hc
            refine ⟨?_, hin1, hb', hc⟩
            have h1 := nameAt_length arena.val i2.val i3.val hin1
            have h2 := nameAt_length b.val sb.val lb.val hb'
            rw [hc, h2] at h1
            exact h1.symm
        · rename_i hjl2
          cases hf2
          exact ⟨hff, fun _ hl' => absurd (by simpa using hl') hjl2⟩
      · rename_i hjs
        cases hf2
        exact ⟨hff, fun hs' => absurd (by simpa using hs') hjs⟩
    rcases Nat.lt_or_ge j' j1.val with hlt' | hge'
    · exact hst hkey.1 j' hlt' hs hl hin hb
    · have : j' = j1.val := by omega
      subst this
      exact hkey.2 hs hl hin hb
  · rename_i hge
    cases hr
    refine ⟨fun y hy => ?_, fun x' hx => (nomatch hx)⟩
    cases hy
    intro hff j' hj'
    exact hst hff j' (by scalar_tac)

/-- `table_has` false: no in-range entry below `upto` carries the name. -/
theorem table_has_ok {arena : Slice Std.U8} {starts lens : Slice Std.Usize} {upto : Std.Usize}
    {b : Slice Std.U8} {sb lb : Std.Usize} {r : Bool}
    (h : kernel.echo_kernel.table_has arena starts lens upto b sb lb = ok r) (hf : r = false)
    (hb : sb.val + lb.val ≤ b.val.length) :
    ∀ j' < upto.val, j' < starts.val.length → j' < lens.val.length →
      EntryIn arena.val starts.val lens.val j' →
      entryName arena.val starts.val lens.val j' ≠ nameAt b.val sb.val lb.val := by
  intro j' hj' hs hl hin
  exact table_has_loop_ok arena starts lens upto b sb lb 0#usize false
    (fun _ j'' hj'' => by simp at hj'') r h hf j' hj' hs hl hin hb

/-- What `entry_ok` establishes about entry `k`. -/
def EntryGood (arena : List Std.U8) (starts lens : List Std.Usize)
    (a1 : List Std.U8) (s1 l1 : List Std.Usize) (a2 : List Std.U8) (s2 l2 : List Std.Usize)
    (k : Nat) : Prop :=
  EntryIn arena starts lens k ∧ nameOk (entryName arena starts lens k) ∧
  (∀ j < k, EntryIn arena starts lens j →
    entryName arena starts lens j ≠ entryName arena starts lens k) ∧
  (∀ j < s1.length, j < l1.length → EntryIn a1 s1 l1 j →
    entryName a1 s1 l1 j ≠ entryName arena starts lens k) ∧
  (∀ j < s2.length, j < l2.length → EntryIn a2 s2 l2 j →
    entryName a2 s2 l2 j ≠ entryName arena starts lens k)

theorem entry_ok_ok {arena : Slice Std.U8} {starts lens : Slice Std.Usize}
    {a1 : Slice Std.U8} {s1 l1 : Slice Std.Usize} {a2 : Slice Std.U8} {s2 l2 : Slice Std.Usize}
    {k : Std.Usize} {r : Bool}
    (h : kernel.echo_kernel.entry_ok arena starts lens a1 s1 l1 a2 s2 l2 k = ok r)
    (hr : r = true) (hlen : lens.val.length = starts.val.length) :
    k.val < starts.val.length ∧
    EntryGood arena.val starts.val lens.val a1.val s1.val l1.val a2.val s2.val l2.val k.val := by
  unfold kernel.echo_kernel.entry_ok at h
  (try dsimp only at h)
  subst hr
  split at h
  · cases h
  · rename_i hk1
    split at h
    · cases h
    · rename_i hk2
      have hks : k.val < starts.val.length := by scalar_tac
      have hkl : k.val < lens.val.length := by scalar_tac
      obtain ⟨s, hs, h⟩ := bind_ok_inv h
      obtain ⟨l, hl, h⟩ := bind_ok_inv h
      obtain ⟨_, hsv⟩ := slice_index_ok hs
      obtain ⟨_, hlv⟩ := slice_index_ok hl
      split at h
      · cases h
      · rename_i hl0
        obtain ⟨b, hb, h⟩ := bind_ok_inv h
        split at h
        · rename_i hbt
          obtain ⟨hin, hq⟩ := bytes_ok_ok hb hbt
          obtain ⟨b1, hb1, h⟩ := bind_ok_inv h
          split at h
          · cases h
          · rename_i hb1f
            have hres := is_reserved_ok hb1 hin (by simpa using hb1f)
            obtain ⟨b2, hb2, h⟩ := bind_ok_inv h
            split at h
            · cases h
            · rename_i hb2f
              have ht0 := table_has_ok hb2 (by simpa using hb2f) hin
              obtain ⟨b3, hb3, h⟩ := bind_ok_inv h
              split at h
              · cases h
              · rename_i hb3f
                have ht1 := table_has_ok hb3 (by simpa using hb3f) hin
                obtain ⟨b4, hb4, h⟩ := bind_ok_inv h
                split at h
                · cases h
                · rename_i hb4f
                  have ht2 := table_has_ok hb4 (by simpa using hb4f) hin
                  have hname : entryName arena.val starts.val lens.val k.val
                      = nameAt arena.val s.val l.val := by
                    unfold entryName
                    rw [← hsv 0#usize, ← hlv 0#usize]
                  have hein : EntryIn arena.val starts.val lens.val k.val := by
                    unfold EntryIn
                    rw [← hsv 0#usize, ← hlv 0#usize]
                    exact hin
                  refine ⟨hks, hein, ?_, ?_, ?_, ?_⟩
                  · rw [hname]
                    refine ⟨?_, hq, hres⟩
                    intro hc
                    have hlen' := nameAt_length arena.val s.val l.val hin
                    rw [hc] at hlen'
                    have : l.val ≠ 0 := by
                      intro h0
                      exact hl0 (UScalar.eq_of_val_eq (by simpa using h0))
                    simp at hlen'
                    omega
                  · intro j hj hjin
                    rw [hname]
                    exact ht0 j hj (by omega) (by omega) hjin
                  · intro j hj hjl hjin
                    rw [hname]
                    exact ht1 j (by simpa using hj) hj hjl hjin
                  · intro j hj hjl hjin
                    rw [hname]
                    exact ht2 j (by simpa using hj) hj hjl hjin
        · cases h

theorem table_ok_loop_ok (arena : Slice Std.U8) (starts lens : Slice Std.Usize)
    (a1 : Slice Std.U8) (s1 l1 : Slice Std.Usize) (a2 : Slice Std.U8) (s2 l2 : Slice Std.Usize)
    (n : Std.Usize) (hn : n.val = starts.val.length) (hlen : lens.val.length = starts.val.length)
    (k : Std.Usize)
    (hinv : ∀ k' < k.val,
      EntryGood arena.val starts.val lens.val a1.val s1.val l1.val a2.val s2.val l2.val k')
    (r : Bool)
    (h : kernel.echo_kernel.table_ok_loop arena starts lens a1 s1 l1 a2 s2 l2 n k = ok r) :
    r = true → ∀ k' < starts.val.length,
      EntryGood arena.val starts.val lens.val a1.val s1.val l1.val a2.val s2.val l2.val k' := by
  unfold kernel.echo_kernel.table_ok_loop at h
  refine loop_ok (fun (k : Std.Usize) => n.val - k.val)
    (fun k => ∀ k' < k.val,
      EntryGood arena.val starts.val lens.val a1.val s1.val l1.val a2.val s2.val l2.val k')
    (fun r => r = true → ∀ k' < starts.val.length,
      EntryGood arena.val starts.val lens.val a1.val s1.val l1.val a2.val s2.val l2.val k')
    _ ?_ k hinv r h
  intro k1 hst r1 hr
  unfold kernel.echo_kernel.table_ok_loop.body at hr
  (try dsimp only at hr)
  split at hr
  · rename_i hlt
    have hkl : k1.val < n.val := by simpa using hlt
    obtain ⟨b, hb, hr⟩ := bind_ok_inv hr
    split at hr
    · rename_i hbt
      obtain ⟨k2, hk2, hr⟩ := bind_ok_inv hr
      cases hr
      refine ⟨fun y hy => (nomatch hy), fun x' hx => ?_⟩
      cases hx
      have hk2' : k2.val = k1.val + 1 := by have := uadd_ok hk2; simpa using this
      refine ⟨fun k' hk' => ?_, by (try dsimp only); omega⟩
      rw [hk2'] at hk'
      rcases Nat.lt_or_ge k' k1.val with hlt' | hge'
      · exact hst k' hlt'
      · have : k' = k1.val := by omega
        subst this
        exact (entry_ok_ok hb hbt hlen).2
    · cases hr
      refine ⟨fun y hy => ?_, fun x' hx => (nomatch hx)⟩
      cases hy
      intro hc
      cases hc
  · rename_i hge
    cases hr
    refine ⟨fun y hy => ?_, fun x' hx => (nomatch hx)⟩
    cases hy
    intro _ k' hk'
    exact hst k' (by scalar_tac)

/-- **`table_ok`**: the columns have one length and every entry is good. -/
theorem table_ok_ok {arena : Slice Std.U8} {starts lens : Slice Std.Usize}
    {a1 : Slice Std.U8} {s1 l1 : Slice Std.Usize} {a2 : Slice Std.U8} {s2 l2 : Slice Std.Usize}
    {r : Bool} (h : kernel.echo_kernel.table_ok arena starts lens a1 s1 l1 a2 s2 l2 = ok r)
    (hr : r = true) :
    lens.val.length = starts.val.length ∧ ∀ k' < starts.val.length,
      EntryGood arena.val starts.val lens.val a1.val s1.val l1.val a2.val s2.val l2.val k' := by
  unfold kernel.echo_kernel.table_ok at h
  (try dsimp only at h)
  split at h
  · subst hr
    cases h
  · rename_i hne
    have hlen : lens.val.length = starts.val.length := by
      simp only [bne_iff_ne, ne_eq, Decidable.not_not] at hne
      have := congrArg UScalar.val hne
      simpa using this
    exact ⟨hlen, table_ok_loop_ok arena starts lens a1 s1 l1 a2 s2 l2 (Slice.len starts) (by simp)
      hlen 0#usize (fun k' hk' => by simp at hk') r h hr⟩

/- ══════════════════ LOOKUPS ══════════════════ -/

/-- The first position of `l` satisfying `p` (`l.length` when none). -/
def firstP {α : Type} (p : α → Prop) [DecidablePred p] : List α → Nat
  | [] => 0
  | x :: r => if p x then 0 else firstP p r + 1

theorem firstP_eq {α : Type} (p : α → Prop) [DecidablePred p] :
    ∀ (l : List α) (k : Nat) (hk : k < l.length), p l[k] → (∀ j (hj : j < k), ¬ p (l[j]'(by omega))) →
      firstP p l = k := by
  intro l
  induction l with
  | nil => intro k hk; simp at hk
  | cons x r ih =>
    intro k hk hp hfirst
    cases k with
    | zero =>
      simp only [List.getElem_cons_zero] at hp
      simp [firstP, hp]
    | succ k =>
      have h0 := hfirst 0 (by omega)
      simp only [List.getElem_cons_zero] at h0
      simp only [firstP, h0, if_false]
      congr 1
      refine ih k (by simpa using hk) (by simpa using hp) (fun j hj => ?_)
      have := hfirst (j + 1) (by omega)
      simpa using this

/-- The first table entry whose node is `i`. -/
def nodeVar (vn : List Std.Usize) (i : Nat) : Nat := firstP (fun x : Std.Usize => x.val = i) vn

theorem find_node_loop_ok (vn : Slice Std.Usize) (i n : Std.Usize) (hn : n.val = vn.val.length)
    (k : Std.Usize) (hinv : ∀ j (hj : j < k.val) (hjl : j < vn.val.length), (vn.val[j]).val ≠ i.val)
    (r : Std.Usize) (h : kernel.echo_kernel.find_node_loop vn i n k = ok r) :
    r.val < vn.val.length → nodeVar vn.val i.val = r.val := by
  unfold kernel.echo_kernel.find_node_loop at h
  refine loop_ok (fun (k : Std.Usize) => n.val - k.val)
    (fun k => ∀ j (hj : j < k.val) (hjl : j < vn.val.length), (vn.val[j]).val ≠ i.val)
    (fun r => r.val < vn.val.length → nodeVar vn.val i.val = r.val) _ ?_ k hinv r h
  intro k1 hst r1 hr
  unfold kernel.echo_kernel.find_node_loop.body at hr
  (try dsimp only at hr)
  split at hr
  · rename_i hlt
    have hkl : k1.val < n.val := by simpa using hlt
    obtain ⟨x, hx, hr⟩ := bind_ok_inv hr
    obtain ⟨hxl, hxv⟩ := slice_index_ok hx
    split at hr
    · rename_i heq
      cases hr
      refine ⟨fun y hy => ?_, fun x' hx' => (nomatch hx')⟩
      cases hy
      intro _
      unfold nodeVar
      refine firstP_eq _ vn.val k1.val hxl ?_ (fun j hj => hst j hj (by omega))
      rw [← getD_eq_getElem_of_lt hxl (d := 0#usize), ← hxv 0#usize, heq]
    · rename_i hne
      obtain ⟨k2, hk2, hr⟩ := bind_ok_inv hr
      cases hr
      refine ⟨fun y hy => (nomatch hy), fun x' hx' => ?_⟩
      cases hx'
      have hk2' : k2.val = k1.val + 1 := by have := uadd_ok hk2; simpa using this
      refine ⟨fun j hj hjl => ?_, by (try dsimp only); omega⟩
      rw [hk2'] at hj
      rcases Nat.lt_or_ge j k1.val with hlt' | hge'
      · exact hst j hlt' hjl
      · have : j = k1.val := by omega
        subst this
        rw [← getD_eq_getElem_of_lt hxl (d := 0#usize), ← hxv 0#usize]
        intro hc
        exact hne (UScalar.eq_of_val_eq hc)
  · rename_i hge
    cases hr
    refine ⟨fun y hy => ?_, fun x' hx' => (nomatch hx')⟩
    cases hy
    intro hc
    exfalso
    have : (core.num.Usize.MAX).val = Usize.max := by simp [core.num.Usize.MAX]
    scalar_tac

/-- `find_node` returns the first table entry naming node `i`, when it
    returns an entry at all. -/
theorem find_node_ok {vn : Slice Std.Usize} {i r : Std.Usize}
    (h : kernel.echo_kernel.find_node vn i = ok r) (hr : r.val < vn.val.length) :
    nodeVar vn.val i.val = r.val := by
  unfold kernel.echo_kernel.find_node at h
  (try dsimp only at h)
  exact find_node_loop_ok vn i (Slice.len vn) (by simp) 0#usize (fun j hj => by simp at hj) r h hr

/-- `node` is a call of function `g`. -/
def IsCallOf (g : Nat) : ExtNode → Prop
  | .Call f _ _ _ => f.val = g
  | _ => False

instance (g : Nat) : DecidablePred (IsCallOf g) := fun nd => by
  cases nd <;> simp only [IsCallOf] <;> infer_instance

/-- The first node that calls function `g`. -/
def firstCall (nodes : List ExtNode) (g : Nat) : Nat := firstP (IsCallOf g) nodes

theorem call_of_ok {node : ExtNode} {g : Std.Usize} {r : Bool}
    (h : kernel.echo_kernel.call_of node g = ok r) : r = true ↔ IsCallOf g.val node := by
  unfold kernel.echo_kernel.call_of at h
  cases node with
  | Core nd => cases h; simp [IsCallOf]
  | Select a j s n => cases h; simp [IsCallOf]
  | Call f w s n =>
    (try dsimp only at h)
    split at h
    · rename_i heq
      cases h
      simp [IsCallOf, heq]
    · rename_i hne
      cases h
      simp only [Bool.false_eq_true, IsCallOf, false_iff]
      intro hc
      exact hne (UScalar.eq_of_val_eq hc)

theorem find_call_loop_ok (nodes : Slice ExtNode) (g n : Std.Usize) (hn : n.val = nodes.val.length)
    (c : Std.Usize)
    (hinv : ∀ j (hj : j < c.val) (hjl : j < nodes.val.length), ¬ IsCallOf g.val nodes.val[j])
    (r : Std.Usize) (h : kernel.echo_kernel.find_call_loop nodes g n c = ok r) :
    r.val < nodes.val.length → firstCall nodes.val g.val = r.val := by
  unfold kernel.echo_kernel.find_call_loop at h
  refine loop_ok (fun (c : Std.Usize) => n.val - c.val)
    (fun c => ∀ j (hj : j < c.val) (hjl : j < nodes.val.length), ¬ IsCallOf g.val nodes.val[j])
    (fun r => r.val < nodes.val.length → firstCall nodes.val g.val = r.val) _ ?_ c hinv r h
  intro c1 hst r1 hr
  unfold kernel.echo_kernel.find_call_loop.body at hr
  (try dsimp only at hr)
  split at hr
  · rename_i hlt
    have hcl : c1.val < n.val := by simpa using hlt
    obtain ⟨x, hx, hr⟩ := bind_ok_inv hr
    obtain ⟨hxl, hxv⟩ := slice_index_ok hx
    obtain ⟨b, hb, hr⟩ := bind_ok_inv hr
    have hbv := call_of_ok hb
    have hxe : x = nodes.val[c1.val] := by
      rw [hxv dfltExt, getD_eq_getElem_of_lt hxl]
    split at hr
    · rename_i hbt
      cases hr
      refine ⟨fun y hy => ?_, fun x' hx' => (nomatch hx')⟩
      cases hy
      intro _
      unfold firstCall
      refine firstP_eq _ nodes.val c1.val hxl ?_ (fun j hj => hst j hj (by omega))
      rw [← hxe]
      exact hbv.mp hbt
    · rename_i hbf
      obtain ⟨c2, hc2, hr⟩ := bind_ok_inv hr
      cases hr
      refine ⟨fun y hy => (nomatch hy), fun x' hx' => ?_⟩
      cases hx'
      have hc2' : c2.val = c1.val + 1 := by have := uadd_ok hc2; simpa using this
      refine ⟨fun j hj hjl => ?_, by (try dsimp only); omega⟩
      rw [hc2'] at hj
      rcases Nat.lt_or_ge j c1.val with hlt' | hge'
      · exact hst j hlt' hjl
      · have : j = c1.val := by omega
        subst this
        rw [← hxe]
        intro hc
        exact hbf (hbv.mpr hc)
  · rename_i hge
    cases hr
    refine ⟨fun y hy => ?_, fun x' hx' => (nomatch hx')⟩
    cases hy
    intro hc
    exfalso
    have : (core.num.Usize.MAX).val = Usize.max := by simp [core.num.Usize.MAX]
    scalar_tac

/-- `find_call` returns the first node calling `g`, when it returns a node. -/
theorem find_call_ok {nodes : Slice ExtNode} {g r : Std.Usize}
    (h : kernel.echo_kernel.find_call nodes g = ok r) (hr : r.val < nodes.val.length) :
    firstCall nodes.val g.val = r.val := by
  unfold kernel.echo_kernel.find_call at h
  (try dsimp only at h)
  exact find_call_loop_ok nodes g (Slice.len nodes) (by simp) 0#usize (fun j hj => by simp at hj) r
    h hr

theorem call_args_ok {node : ExtNode} {s n : Std.Usize}
    (h : kernel.echo_kernel.call_args node = ok (core.result.Result.Ok (s, n))) :
    ∃ f w, node = .Call f w s n := by
  unfold kernel.echo_kernel.call_args at h
  cases node with
  | Core nd => cases h
  | Select a j s' n' => cases h
  | Call f w s' n' =>
    cases h
    exact ⟨f, w, rfl⟩

/-- The width of node `x` in a width list (0 past it). -/
theorem width_at_ok {ws : Slice Std.Usize} {x r : Std.Usize}
    (h : kernel.echo_kernel.width_at ws x = ok r) :
    r.val = (ws.val.map UScalar.val).getD x.val 0 := by
  unfold kernel.echo_kernel.width_at at h
  (try dsimp only at h)
  split at h
  · rename_i hlt
    obtain ⟨hxl, hxv⟩ := slice_index_ok h
    rw [hxv 0#usize, List.getD_eq_getElem?_getD, List.getD_eq_getElem?_getD, List.getElem?_map]
    cases ws.val[x.val]? <;> rfl
  · rename_i hge
    cases h
    rw [List.getD_eq_getElem?_getD, List.getElem?_eq_none (by simp; scalar_tac)]
    rfl

theorem args_match_loop_ok (ws side : Slice Std.Usize) (s s0 n : Std.Usize) (j : Std.Usize)
    (hinv : ∀ k < j.val, (ws.val.map UScalar.val).getD (side.val.getD (s.val + k) 0#usize).val 0
      = (ws.val.map UScalar.val).getD (side.val.getD (s0.val + k) 0#usize).val 0)
    (r : Bool) (h : kernel.echo_kernel.args_match_loop ws side s s0 n j = ok r) :
    r = true → ∀ k < n.val, (ws.val.map UScalar.val).getD (side.val.getD (s.val + k) 0#usize).val 0
      = (ws.val.map UScalar.val).getD (side.val.getD (s0.val + k) 0#usize).val 0 := by
  unfold kernel.echo_kernel.args_match_loop at h
  refine loop_ok (fun (j : Std.Usize) => n.val - j.val)
    (fun j => ∀ k < j.val, (ws.val.map UScalar.val).getD (side.val.getD (s.val + k) 0#usize).val 0
      = (ws.val.map UScalar.val).getD (side.val.getD (s0.val + k) 0#usize).val 0)
    (fun r => r = true → ∀ k < n.val,
      (ws.val.map UScalar.val).getD (side.val.getD (s.val + k) 0#usize).val 0
        = (ws.val.map UScalar.val).getD (side.val.getD (s0.val + k) 0#usize).val 0)
    _ ?_ j hinv r h
  intro j1 hst r1 hr
  unfold kernel.echo_kernel.args_match_loop.body at hr
  (try dsimp only at hr)
  split at hr
  · rename_i hlt
    have hjl : j1.val < n.val := by simpa using hlt
    obtain ⟨i, hi, hr⟩ := bind_ok_inv hr
    obtain ⟨x, hx, hr⟩ := bind_ok_inv hr
    obtain ⟨wx, hwx, hr⟩ := bind_ok_inv hr
    obtain ⟨i3, hi3, hr⟩ := bind_ok_inv hr
    obtain ⟨y, hy, hr⟩ := bind_ok_inv hr
    obtain ⟨wy, hwy, hr⟩ := bind_ok_inv hr
    obtain ⟨_, hxv⟩ := slice_index_ok hx
    obtain ⟨_, hyv⟩ := slice_index_ok hy
    have hiv := uadd_ok hi
    have hi3v := uadd_ok hi3
    split at hr
    · cases hr
      refine ⟨fun y' hy' => ?_, fun x' hx' => (nomatch hx')⟩
      cases hy'
      intro hc
      cases hc
    · rename_i heq
      obtain ⟨j2, hj2, hr⟩ := bind_ok_inv hr
      cases hr
      refine ⟨fun y' hy' => (nomatch hy'), fun x' hx' => ?_⟩
      cases hx'
      have hj2' : j2.val = j1.val + 1 := by have := uadd_ok hj2; simpa using this
      refine ⟨fun k hk => ?_, by (try dsimp only); omega⟩
      rw [hj2'] at hk
      rcases Nat.lt_or_ge k j1.val with hlt' | hge'
      · exact hst k hlt'
      · have : k = j1.val := by omega
        subst this
        rw [← hiv, ← hi3v, ← hxv 0#usize, ← hyv 0#usize, ← width_at_ok hwx, ← width_at_ok hwy]
        have : wx = wy := UScalar.eq_of_val_eq (by simpa using heq)
        rw [this]
  · rename_i hge
    cases hr
    refine ⟨fun y' hy' => ?_, fun x' hx' => (nomatch hx')⟩
    cases hy'
    intro _ k hk
    exact hst k (by scalar_tac)

/-- `args_match`: the two argument ranges are inside the side table and
    have the same widths, position by position. -/
theorem args_match_ok {ws side : Slice Std.Usize} {s s0 n : Std.Usize} {r : Bool}
    (h : kernel.echo_kernel.args_match ws side s s0 n = ok r) (hr : r = true) :
    ∀ k < n.val, (ws.val.map UScalar.val).getD (side.val.getD (s.val + k) 0#usize).val 0
      = (ws.val.map UScalar.val).getD (side.val.getD (s0.val + k) 0#usize).val 0 := by
  unfold kernel.echo_kernel.args_match at h
  (try dsimp only at h)
  subst hr
  split at h
  · cases h
  · obtain ⟨i, hi, h⟩ := bind_ok_inv h
    split at h
    · cases h
    · split at h
      · cases h
      · obtain ⟨i1, hi1, h⟩ := bind_ok_inv h
        split at h
        · cases h
        · exact args_match_loop_ok ws side s s0 n 0#usize (fun k hk => by simp at hk) true h rfl

/- ══════════════════ SYMBOLS ══════════════════ -/

/-- The SMT-LIB symbol of a closed operator node (`push_sym`). -/
def symOf : blast_kernel.DagNode → List Std.U8
  | .Var _ => []
  | .Const _ _ => []
  | .Add _ _ => bytes "bvadd"
  | .Sub _ _ => bytes "bvsub"
  | .Mul _ _ => bytes "bvmul"
  | .Udiv _ _ => bytes "bvudiv"
  | .Urem _ _ => bytes "bvurem"
  | .And _ _ => bytes "bvand"
  | .Or _ _ => bytes "bvor"
  | .Xor _ _ => bytes "bvxor"
  | .Shl _ _ => bytes "bvshl"
  | .Lshr _ _ => bytes "bvlshr"
  | .Ashr _ _ => bytes "bvashr"
  | .Rotr _ _ => bytes "rotate_right"
  | .Extract _ _ _ => bytes "extract"
  | .Concat _ _ => bytes "concat"
  | .ZeroExt _ _ => bytes "zero_extend"
  | .SignExt _ _ => bytes "sign_extend"
  | .Ite _ _ _ => bytes "ite"
  | .Eq _ _ => bytes "="
  | .Ne _ _ => bytes "distinct"
  | .Ult _ _ => bytes "bvult"
  | .Ule _ _ => bytes "bvule"
  | .Ugt _ _ => bytes "bvugt"
  | .Uge _ _ => bytes "bvuge"
  | .Slt _ _ => bytes "bvslt"
  | .Sle _ _ => bytes "bvsle"
  | .Sgt _ _ => bytes "bvsgt"
  | .Sge _ _ => bytes "bvsge"
  | .Not _ => bytes "not"
  | .BoolAnd _ _ => bytes "and"
  | .BoolOr _ _ => bytes "or"
  | .BvNot _ => bytes "bvnot"
  | .Neg _ => bytes "bvneg"
  | .Rotl _ _ => bytes "rotate_left"
  | .Sdiv _ _ => bytes "bvsdiv"
  | .Srem _ _ => bytes "bvsrem"

/-- **`push_sym` appends the node's symbol**: one symbol per arm. -/
theorem push_sym_ok {out : alloc.vec.Vec Std.U8} {nd : blast_kernel.DagNode}
    {v : alloc.vec.Vec Std.U8} (h : kernel.echo_kernel.push_sym out nd = ok v) :
    v.val = out.val ++ symOf nd := by
  unfold kernel.echo_kernel.push_sym at h
  cases nd <;> (try dsimp only at h) <;>
    first
    | (cases h
       simp [symOf])
    | (obtain ⟨s, hs, h⟩ := bind_ok_inv h
       have hs' := lift_ok hs
       subst hs'
       rw [push_word_ok h]
       rfl)

/- ══════════════════ ROTATE AMOUNTS ══════════════════ -/

theorem bvOfFn_succ_toNat (f : Nat → Bool) (j : Nat) :
    (bvOfFn f (j + 1)).toNat = (if f j then 2 ^ j else 0) + (bvOfFn f j).toNat := by
  simp only [bvOfFn, BitVec.toNat_cons']
  cases f j <;> simp [Nat.shiftLeft_eq]

theorem rot_amount_loop_ok (bits : Slice Bool) (s wb w : Std.Usize) (hw : w.val ≠ 0)
    (k p j : Std.Usize)
    (hinv : j.val ≤ wb.val ∧
      k.val = (bvOfFn (fun j => bits.val.getD (s.val + j) false) j.val).toNat % w.val ∧
      p.val = 2 ^ j.val % w.val)
    (r : Std.Usize) (h : kernel.echo_kernel.rot_amount_loop bits s wb w k p j = ok r) :
    r.val = (bvOfFn (fun j => bits.val.getD (s.val + j) false) wb.val).toNat % w.val := by
  unfold kernel.echo_kernel.rot_amount_loop at h
  refine loop_ok (fun (st : Std.Usize × Std.Usize × Std.Usize) => wb.val - st.2.2.val)
    (fun st => st.2.2.val ≤ wb.val ∧
      st.1.val = (bvOfFn (fun j => bits.val.getD (s.val + j) false) st.2.2.val).toNat % w.val ∧
      st.2.1.val = 2 ^ st.2.2.val % w.val)
    (fun r => r.val = (bvOfFn (fun j => bits.val.getD (s.val + j) false) wb.val).toNat % w.val)
    _ ?_ (k, p, j) hinv r h
  intro st hst r1 hr
  obtain ⟨k1, p1, j1⟩ := st
  obtain ⟨hj, hk, hp⟩ := hst
  (try dsimp only at hj hk hp)
  unfold kernel.echo_kernel.rot_amount_loop.body at hr
  (try dsimp only at hr)
  split at hr
  · rename_i hlt
    have hjl : j1.val < wb.val := by simpa using hlt
    obtain ⟨i, hi, hr⟩ := bind_ok_inv hr
    obtain ⟨b, hb, hr⟩ := bind_ok_inv hr
    obtain ⟨k2, hk2, hr⟩ := bind_ok_inv hr
    obtain ⟨i1, hi1, hr⟩ := bind_ok_inv hr
    obtain ⟨p2, hp2, hr⟩ := bind_ok_inv hr
    obtain ⟨j2, hj2, hr⟩ := bind_ok_inv hr
    cases hr
    refine ⟨fun y hy => (nomatch hy), fun x' hx => ?_⟩
    cases hx
    have hiv := uadd_ok hi
    obtain ⟨_, hbv⟩ := slice_index_ok hb
    have hj2' : j2.val = j1.val + 1 := by have := uadd_ok hj2; simpa using this
    have hp2v : p2.val = 2 ^ (j1.val + 1) % w.val := by
      have h2 : (2#usize : Std.Usize).val = 2 := rfl
      rw [urem_ok hp2 hw, umul_ok hi1, hp, h2, pow_succ, Nat.mod_mul_mod]
    have hk2v : k2.val =
        (bvOfFn (fun j => bits.val.getD (s.val + j) false) (j1.val + 1)).toNat % w.val := by
      rw [bvOfFn_succ_toNat]
      have hbe : bits.val.getD (s.val + j1.val) false = b := by rw [hbv false, hiv]
      rw [hbe]
      split at hk2
      · rename_i hbt
        obtain ⟨i2, hi2, hk2⟩ := bind_ok_inv hk2
        rw [urem_ok hk2 hw, uadd_ok hi2, hk, hp, hbt]
        simp only [↓reduceIte]
        rw [Nat.add_comm (2 ^ j1.val)]
        exact (Nat.add_mod _ _ _).symm
      · rename_i hbf
        cases hk2
        have : b = false := by simpa using hbf
        rw [this, hk]
        simp
    refine ⟨⟨by (try dsimp only); omega, ?_, ?_⟩, by (try dsimp only); omega⟩
    · (try dsimp only)
      rw [hj2']
      exact hk2v
    · (try dsimp only)
      rw [hj2']
      exact hp2v
  · rename_i hge
    cases hr
    refine ⟨fun y hy => ?_, fun x' hx => (nomatch hx)⟩
    cases hy
    have : j1.val = wb.val := by scalar_tac
    rw [hk, this]

theorem rot_amount_ok {bits : Slice Bool} {s wb w k : Std.Usize}
    (h : kernel.echo_kernel.rot_amount bits s wb w = ok k) (hw : w.val ≠ 0) :
    k.val = (bvOfFn (fun j => bits.val.getD (s.val + j) false) wb.val).toNat % w.val := by
  unfold kernel.echo_kernel.rot_amount at h
  obtain ⟨p, hp, h⟩ := bind_ok_inv h
  have hpv := urem_ok hp hw
  refine rot_amount_loop_ok bits s wb w hw 0#usize p 0#usize ⟨by simp, ?_, ?_⟩ k h
  · have h0 : (0#usize : Std.Usize).val = 0 := rfl
    rw [h0]
    simp [bvOfFn]
  · rw [hpv]
    simp

/-- `rot_of` accepts a `Const` amount only, and returns it modulo the width. -/
theorem rot_of_ok {bits : Slice Bool} {amt : ExtNode} {w k : Std.Usize}
    (h : kernel.echo_kernel.rot_of bits amt w = ok (core.result.Result.Ok k)) :
    ∃ s wb, amt = .Core (.Const s wb) ∧ w.val ≠ 0 ∧
      k.val = (bvOfFn (fun j => bits.val.getD (s.val + j) false) wb.val).toNat % w.val := by
  unfold kernel.echo_kernel.rot_of at h
  cases amt with
  | Select _ _ _ _ => cases h
  | Call _ _ _ _ => cases h
  | Core nd =>
    cases nd
    case Const s wb =>
      (try dsimp only at h)
      split at h
      · cases h
      · rename_i hw0
        split at h
        · cases h
        · split at h
          · cases h
          · obtain ⟨i2, hi2, h⟩ := bind_ok_inv h
            split at h
            · cases h
            · obtain ⟨k', hk', h⟩ := bind_ok_inv h
              cases h
              have hw : w.val ≠ 0 := by
                intro hc
                exact hw0 (UScalar.eq_of_val_eq (by simpa using hc))
              exact ⟨s, wb, rfl, hw, rot_amount_ok hk' hw⟩
    all_goals cases h

/- ══════════════════ THE MODEL: OPERATOR FACTS ══════════════════ -/

theorem bvBinOp_bvadd : bvBinOp (bytes "bvadd") = some fun _ x y => x + y := rfl
theorem bvBinOp_bvsub : bvBinOp (bytes "bvsub") = some fun _ x y => x - y := rfl
theorem bvBinOp_bvmul : bvBinOp (bytes "bvmul") = some fun _ x y => x * y := rfl
theorem bvBinOp_bvudiv : bvBinOp (bytes "bvudiv") = some fun _ x y => x.smtUDiv y := rfl
theorem bvBinOp_bvurem : bvBinOp (bytes "bvurem") = some fun _ x y => x % y := rfl
theorem bvBinOp_bvand : bvBinOp (bytes "bvand") = some fun _ x y => x &&& y := rfl
theorem bvBinOp_bvor : bvBinOp (bytes "bvor") = some fun _ x y => x ||| y := rfl
theorem bvBinOp_bvxor : bvBinOp (bytes "bvxor") = some fun _ x y => x ^^^ y := rfl
theorem bvBinOp_bvshl : bvBinOp (bytes "bvshl") = some fun _ x y => x <<< y.toNat := rfl
theorem bvBinOp_bvlshr : bvBinOp (bytes "bvlshr") = some fun _ x y => x >>> y.toNat := rfl
theorem bvBinOp_bvashr : bvBinOp (bytes "bvashr") = some fun _ x y => x.sshiftRight y.toNat := rfl
theorem bvBinOp_bvsdiv : bvBinOp (bytes "bvsdiv") = some fun _ x y => x.smtSDiv y := rfl
theorem bvBinOp_bvsrem : bvBinOp (bytes "bvsrem") = some fun _ x y => x.srem y := rfl

theorem bvCmpOp_eq : bvCmpOp (bytes "=") = some fun _ x y => decide (x = y) := rfl
theorem bvCmpOp_distinct : bvCmpOp (bytes "distinct") = some fun _ x y => decide (x ≠ y) := rfl
theorem bvCmpOp_bvult : bvCmpOp (bytes "bvult") = some fun _ x y => decide (x < y) := rfl
theorem bvCmpOp_bvule : bvCmpOp (bytes "bvule") = some fun _ x y => decide (x ≤ y) := rfl
theorem bvCmpOp_bvugt : bvCmpOp (bytes "bvugt") = some fun _ x y => decide (y < x) := rfl
theorem bvCmpOp_bvuge : bvCmpOp (bytes "bvuge") = some fun _ x y => decide (y ≤ x) := rfl
theorem bvCmpOp_bvslt : bvCmpOp (bytes "bvslt") = some fun _ x y => x.slt y := rfl
theorem bvCmpOp_bvsle : bvCmpOp (bytes "bvsle") = some fun _ x y => x.sle y := rfl
theorem bvCmpOp_bvsgt : bvCmpOp (bytes "bvsgt") = some fun _ x y => y.slt x := rfl
theorem bvCmpOp_bvsge : bvCmpOp (bytes "bvsge") = some fun _ x y => y.sle x := rfl

theorem bvUnOp_bvnot : bvUnOp (bytes "bvnot") = some fun _ x => ~~~x := rfl
theorem bvUnOp_bvneg : bvUnOp (bytes "bvneg") = some fun _ x => -x := rfl
theorem boolBinOp_and : boolBinOp (bytes "and") = some fun p q => p && q := rfl
theorem boolBinOp_or : boolBinOp (bytes "or") = some fun p q => p || q := rfl

theorem denSym_bin {op : List Std.U8} {f : (w : Nat) → BitVec w → BitVec w → BitVec w}
    (h : bvBinOp op = some f) (x y : DVal) (hw : x.1 = y.1) :
    denSym op [.bv x, .bv y] = some (.bv ⟨x.1, f x.1 x.2 (toW x.1 y)⟩) := by
  simp only [denSym, h, hw, if_true]

theorem denSym_cmp {op : List Std.U8} {p : (w : Nat) → BitVec w → BitVec w → Bool}
    (h0 : bvBinOp op = none) (h : bvCmpOp op = some p) (x y : DVal) (hw : x.1 = y.1) :
    denSym op [.bv x, .bv y] = some (.bool (p x.1 x.2 (toW x.1 y))) := by
  simp only [denSym, h0, h, hw, if_true]

theorem denSym_concat (x y : DVal) :
    denSym (bytes "concat") [.bv x, .bv y] = some (.bv ⟨x.1 + y.1, x.2 ++ y.2⟩) := by
  have h0 : bvBinOp (bytes "concat") = none := rfl
  have h1 : bvCmpOp (bytes "concat") = none := rfl
  simp only [denSym, h0, h1, if_true]

theorem denSym_un {op : List Std.U8} {f : (w : Nat) → BitVec w → BitVec w}
    (h : bvUnOp op = some f) (x : DVal) : denSym op [.bv x] = some (.bv ⟨x.1, f x.1 x.2⟩) := by
  simp only [denSym, h, Option.map_some]

theorem denSym_not (p : Bool) : denSym (bytes "not") [.bool p] = some (.bool !p) := by
  simp only [denSym, if_true]

theorem denSym_bool {op : List Std.U8} {f : Bool → Bool → Bool} (h : boolBinOp op = some f)
    (p q : Bool) : denSym op [.bool p, .bool q] = some (.bool (f p q)) := by
  simp only [denSym, h, Option.map_some]

theorem denSym_ite (c : Bool) (t e : DVal) (hw : t.1 = e.1) :
    denSym (bytes "ite") [.bool c, .bv t, .bv e]
      = some (.bv ⟨t.1, if c then t.2 else toW t.1 e⟩) := by
  simp only [denSym, hw, and_self, if_true]

theorem denSym_select (a : BitVec 32 → BitVec 8) (i : DVal) (hw : i.1 = 32) :
    denSym (bytes "select") [.arr a, .bv i] = some (.bv ⟨8, a (toW 32 i)⟩) := by
  simp only [denSym, hw, and_self, if_true]

theorem denSym_store (a : BitVec 32 → BitVec 8) (i v : DVal) (hi : i.1 = 32) (hv : v.1 = 8) :
    denSym (bytes "store") [.arr a, .bv i, .bv v]
      = some (.arr fun j => if toW 32 i = j then toW 8 v else a j) := by
  simp only [denSym, hi, hv, and_self, if_true]

/-- The value of an application: the head applied to the argument values. -/
theorem den_app (I : Interp) (sg : Sig) (h : SExp) (args : List SExp) (vs : List Val)
    (hargs : denArgs I sg args = some vs) :
    den I sg (.list (h :: args)) = denApp I sg h vs := by
  simp only [den, hargs, Option.bind_some]

theorem denArgs_nil (I : Interp) (sg : Sig) : denArgs I sg [] = some [] := by
  simp only [denArgs]

theorem denArgs_cons (I : Interp) (sg : Sig) (a : SExp) (rest : List SExp) (v : Val)
    (vs : List Val) (ha : den I sg a = some v) (hr : denArgs I sg rest = some vs) :
    denArgs I sg (a :: rest) = some (v :: vs) := by
  simp only [denArgs, ha, hr]

theorem denApp_sym (I : Interp) (sg : Sig) (op : List Std.U8) (vs : List Val) :
    denApp I sg (.sym op) vs = denSym op vs := by
  simp only [denApp]

/-- The value of a binary constant printed from `bits[s .. s + w]`. -/
theorem den_binE (I : Interp) (sg : Sig) (bits : List Bool) (s w : Nat) (hw : 0 < w)
    (hr : s + w ≤ bits.length) :
    den I sg (binE bits s w) = some (.bv ⟨w, bvOfFn (fun j => bits.getD (s + j) false) w⟩) := by
  have hlen : (segOf bits s w).reverse.length = w := by
    rw [List.length_reverse]
    exact seg_length _ _ _ hr
  have hne : (segOf bits s w).reverse ≠ [] := by
    intro hc
    rw [hc] at hlen
    simp at hlen
    omega
  have hfun : bvOfFn (fun j => (segOf bits s w).reverse.getD (w - 1 - j) false) w
      = bvOfFn (fun j => bits.getD (s + j) false) w := by
    apply bvOfFn_congr'
    intro j hj
    have hsl : (segOf bits s w).length = w := seg_length _ _ _ hr
    have hidx : w - 1 - (w - 1 - j) = j := by omega
    rw [List.getD_eq_getElem?_getD, List.getElem?_reverse (by rw [hsl]; omega), hsl, hidx,
      ← List.getD_eq_getElem?_getD]
    unfold segOf
    rw [seg_getD _ _ _ _ _ hj]
  simp only [binE, den, if_neg hne]
  rw [hlen, hfun]

/- ══════════════════ THE MODEL: SIGNATURES ══════════════════ -/

/-- A name the signature does not mention has no declaration. -/
theorem Sig.get_none (sg : Sig) (n : List Std.U8) (h : ∀ p ∈ sg, p.1 ≠ n) : Sig.get sg n = none := by
  induction sg with
  | nil => rfl
  | cons p sg ih =>
    obtain ⟨m, d⟩ := p
    have hm : m ≠ n := h (m, d) (by simp)
    simp only [Sig.get, hm, if_false]
    exact ih (fun p hp => h p (by simp [hp]))

/-- In a signature with pairwise distinct names, an entry is THE
    declaration of its name. -/
theorem Sig.get_of_mem (sg : Sig) (hd : (sg.map Prod.fst).Pairwise (· ≠ ·)) (n : List Std.U8)
    (d : Decl) (h : (n, d) ∈ sg) : Sig.get sg n = some d := by
  induction sg with
  | nil => cases h
  | cons p sg ih =>
    obtain ⟨m, d'⟩ := p
    simp only [List.map_cons, List.pairwise_cons] at hd
    rcases List.mem_cons.mp h with heq | hmem
    · cases heq
      simp [Sig.get]
    · have hm : m ≠ n := hd.1 n (List.mem_map.mpr ⟨(n, d), hmem, rfl⟩)
      simp only [Sig.get, hm, if_false]
      exact ih hd.2 hmem

theorem pairwise_range_map {α : Type} (f : Nat → α) (n : Nat)
    (h : ∀ i < n, ∀ j < i, f j ≠ f i) : ((List.range n).map f).Pairwise (· ≠ ·) := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [List.range_succ, List.map_append, List.pairwise_append]
    refine ⟨ih (fun i hi j hj => h i (by omega) j hj), by simp, ?_⟩
    intro a ha b hb
    simp only [List.map_cons, List.map_nil, List.mem_singleton] at hb
    obtain ⟨j, hj, rfl⟩ := List.mem_map.mp ha
    rw [hb]
    exact h n (by omega) j (by simpa using hj)

/- ══════════════════ THE ECHO'S INPUT ══════════════════ -/

/-- What the printer walks: the node list, its widths (`ext_wf`'s
    result) and the three name tables. -/
structure EchoIn where
  nodes : Slice ExtNode
  bits : Slice Bool
  side : Slice Std.Usize
  ws : Slice Std.Usize
  names : Slice Std.U8
  name_start : Slice Std.Usize
  name_len : Slice Std.Usize
  var_node : Slice Std.Usize
  var_width : Slice Std.Usize
  anames : Slice Std.U8
  aname_start : Slice Std.Usize
  aname_len : Slice Std.Usize
  fnames : Slice Std.U8
  fname_start : Slice Std.Usize
  fname_len : Slice Std.Usize
  func_width : Slice Std.Usize

namespace EchoIn

variable (c : EchoIn)

/-- The names of variable `k`, array `a`, function `g`. -/
def vname (k : Nat) : List Std.U8 := entryName c.names.val c.name_start.val c.name_len.val k
def aname (a : Nat) : List Std.U8 := entryName c.anames.val c.aname_start.val c.aname_len.val a
def fname (g : Nat) : List Std.U8 := entryName c.fnames.val c.fname_start.val c.fname_len.val g

def nv : Nat := c.name_start.val.length
def na : Nat := c.aname_start.val.length
def nf : Nat := c.fname_start.val.length

/-- The width of node `i`; of table variable `k`; the result width of
    function `g`; the node at side-table position `j`. -/
def W (i : Nat) : Nat := (extWidths c.nodes.val).getD i 0
def vwidth (k : Nat) : Nat := (c.var_width.val.getD k 0#usize).val
def fwidth (g : Nat) : Nat := (c.func_width.val.getD g 0#usize).val
def sideAt (j : Nat) : Nat := (c.side.val.getD j 0#usize).val

/-- The argument widths of function `g`: those of its first call. -/
def fargs (g : Nat) : List Nat :=
  match c.nodes.val.getD (firstCall c.nodes.val g) dfltExt with
  | .Call _ _ s n => (List.range n.val).map fun j => c.W (c.sideAt (s.val + j))
  | _ => []

/-- **The signature the script declares**: the variables, the arrays,
    the functions, in table order. -/
def varSig : Sig := (List.range c.nv).map fun k => (c.vname k, Decl.bv (c.vwidth k))
def arrSig : Sig := (List.range c.na).map fun a => (c.aname a, Decl.arr)
def funSig : Sig := (List.range c.nf).map fun g => (c.fname g, Decl.fn (c.fargs g) (c.fwidth g))
def sg : Sig := c.varSig ++ (c.arrSig ++ c.funSig)

/-- **The interpretations the node list is read under**, from an SMT-LIB
    interpretation through the tables: arrays and functions by id … -/
def arrsOf (I : Interp) : Arrs := fun aid => I.arr (c.aname aid)
def ufsOf (I : Interp) : Ufs := fun fid => I.fn (c.fname fid)

/-- … and the input block of node `i`: the bits of the constant its
    first table entry names. -/
def blk (I : Interp) (i : Nat) : List Bool :=
  match c.nodes.val.getD i dfltExt with
  | .Core (.Var w) =>
    (List.range w.val).map fun j => (I.cst (c.vname (nodeVar c.var_node.val i)) w.val).getLsbD j
  | _ => []

/-- The primary-input assignment: every node's block, in node order. -/
def layout (I : Interp) : List Bool := layoutAux (c.blk I) c.nodes.val.length

/-- The node values under an SMT-LIB interpretation. -/
def sim (I : Interp) : List DVal :=
  extSim (c.layout I) c.bits.val (c.arrsOf I) (c.ufsOf I) c.side.val c.nodes.val

/-- The kernel's walk over this input. -/
abbrev node (i : Std.Usize) (want : Bool) (out : alloc.vec.Vec Std.U8) :=
  kernel.echo_kernel.echo_node c.nodes c.bits c.side c.ws c.names c.name_start c.name_len
    c.var_node c.var_width c.anames c.aname_start c.aname_len c.fnames c.fname_start c.fname_len
    c.func_width i want out

abbrev one (a : Std.Usize) (ab : Bool) (out : alloc.vec.Vec Std.U8) :=
  kernel.echo_kernel.echo_one c.nodes c.bits c.side c.ws c.names c.name_start c.name_len
    c.var_node c.var_width c.anames c.aname_start c.aname_len c.fnames c.fname_start c.fname_len
    c.func_width a ab out

abbrev two (a b : Std.Usize) (ob : Bool) (out : alloc.vec.Vec Std.U8) :=
  kernel.echo_kernel.echo_two c.nodes c.bits c.side c.ws c.names c.name_start c.name_len
    c.var_node c.var_width c.anames c.aname_start c.aname_len c.fnames c.fname_start c.fname_len
    c.func_width a b ob out

abbrev levels (s l : Std.Usize) (out : alloc.vec.Vec Std.U8) :=
  kernel.echo_kernel.echo_levels c.nodes c.bits c.side c.ws c.names c.name_start c.name_len
    c.var_node c.var_width c.anames c.aname_start c.aname_len c.fnames c.fname_start c.fname_len
    c.func_width s l out

abbrev args (s n : Std.Usize) (out : alloc.vec.Vec Std.U8) :=
  kernel.echo_kernel.echo_args c.nodes c.bits c.side c.ws c.names c.name_start c.name_len
    c.var_node c.var_width c.anames c.aname_start c.aname_len c.fnames c.fname_start c.fname_len
    c.func_width s n out

end EchoIn

/-- What the printer has checked before it walks: the list is well
    formed with `ws` its widths, the tables' columns agree, and every name
    is good (`table_ok`, three times). -/
structure Good (c : EchoIn) : Prop where
  ws : c.ws.val.map UScalar.val = extWidths c.nodes.val
  wf : ExtWF c.nodes.val c.bits.val.length c.side.val
  vlen : c.name_len.val.length = c.nv
  vnlen : c.var_node.val.length = c.nv
  vwlen : c.var_width.val.length = c.nv
  alen : c.aname_len.val.length = c.na
  flen : c.fname_len.val.length = c.nf
  fwlen : c.func_width.val.length = c.nf
  vgood : ∀ k < c.nv, EntryGood c.names.val c.name_start.val c.name_len.val [] [] [] [] [] [] k
  agood : ∀ k < c.na, EntryGood c.anames.val c.aname_start.val c.aname_len.val
    c.names.val c.name_start.val c.name_len.val [] [] [] k
  fgood : ∀ k < c.nf, EntryGood c.fnames.val c.fname_start.val c.fname_len.val
    c.names.val c.name_start.val c.name_len.val c.anames.val c.aname_start.val c.aname_len.val k

/- ══════════════════ THE SIGNATURE ══════════════════ -/

/-- **One namespace**: the declared names are pairwise distinct — within
    each table and across the three. This is what the kernel's collision
    check establishes. -/
theorem Good.names_distinct {c : EchoIn} (H : Good c) :
    (c.sg.map Prod.fst).Pairwise (· ≠ ·) := by
  have hv : (c.varSig.map Prod.fst).Pairwise (· ≠ ·) := by
    unfold EchoIn.varSig
    rw [List.map_map]
    exact pairwise_range_map _ _ (fun i hi j hj =>
      (H.vgood i hi).2.2.1 j hj (H.vgood j (by omega)).1)
  have ha : (c.arrSig.map Prod.fst).Pairwise (· ≠ ·) := by
    unfold EchoIn.arrSig
    rw [List.map_map]
    exact pairwise_range_map _ _ (fun i hi j hj =>
      (H.agood i hi).2.2.1 j hj (H.agood j (by omega)).1)
  have hf : (c.funSig.map Prod.fst).Pairwise (· ≠ ·) := by
    unfold EchoIn.funSig
    rw [List.map_map]
    exact pairwise_range_map _ _ (fun i hi j hj =>
      (H.fgood i hi).2.2.1 j hj (H.fgood j (by omega)).1)
  unfold EchoIn.sg
  rw [List.map_append, List.map_append, List.pairwise_append, List.pairwise_append]
  refine ⟨hv, ⟨ha, hf, ?_⟩, ?_⟩
  · intro x hx y hy
    unfold EchoIn.arrSig at hx
    unfold EchoIn.funSig at hy
    simp only [List.map_map, List.mem_map, List.mem_range, Function.comp] at hx hy
    obtain ⟨a, ha', rfl⟩ := hx
    obtain ⟨g, hg', rfl⟩ := hy
    exact (H.fgood g hg').2.2.2.2 a ha' (by rw [H.alen]; exact ha') (H.agood a ha').1
  · intro x hx y hy
    unfold EchoIn.varSig at hx
    simp only [List.map_map, List.mem_map, List.mem_range, Function.comp] at hx
    obtain ⟨k, hk', rfl⟩ := hx
    rcases List.mem_append.mp hy with hy | hy
    · unfold EchoIn.arrSig at hy
      simp only [List.map_map, List.mem_map, List.mem_range, Function.comp] at hy
      obtain ⟨a, ha', rfl⟩ := hy
      exact (H.agood a ha').2.2.2.1 k hk' (by rw [H.vlen]; exact hk') (H.vgood k hk').1
    · unfold EchoIn.funSig at hy
      simp only [List.map_map, List.mem_map, List.mem_range, Function.comp] at hy
      obtain ⟨g, hg', rfl⟩ := hy
      exact (H.fgood g hg').2.2.2.1 k hk' (by rw [H.vlen]; exact hk') (H.vgood k hk').1

theorem Good.get_var {c : EchoIn} (H : Good c) (k : Nat) (hk : k < c.nv) :
    c.sg.get (c.vname k) = some (.bv (c.vwidth k)) := by
  apply Sig.get_of_mem _ H.names_distinct
  unfold EchoIn.sg EchoIn.varSig
  exact List.mem_append_left _ (List.mem_map.mpr ⟨k, List.mem_range.mpr hk, rfl⟩)

theorem Good.get_arr {c : EchoIn} (H : Good c) (a : Nat) (ha : a < c.na) :
    c.sg.get (c.aname a) = some .arr := by
  apply Sig.get_of_mem _ H.names_distinct
  unfold EchoIn.sg EchoIn.arrSig
  exact List.mem_append_right _ (List.mem_append_left _
    (List.mem_map.mpr ⟨a, List.mem_range.mpr ha, rfl⟩))

theorem Good.get_fun {c : EchoIn} (H : Good c) (g : Nat) (hg : g < c.nf) :
    c.sg.get (c.fname g) = some (.fn (c.fargs g) (c.fwidth g)) := by
  apply Sig.get_of_mem _ H.names_distinct
  unfold EchoIn.sg EchoIn.funSig
  exact List.mem_append_right _ (List.mem_append_right _
    (List.mem_map.mpr ⟨g, List.mem_range.mpr hg, rfl⟩))

/-- A good name's bytes are bytes the reader reads back inside `|…|`. -/
theorem qOk_of_nameOk {n : List Std.U8} (h : nameOk n) : qOk n = true := by
  unfold qOk
  rw [List.all_eq_true]
  intro d hd
  obtain ⟨_, _, h3, h4⟩ := h.2.1 d hd
  simp [h3, h4]

/- ══════════════════ NODE VALUES ══════════════════ -/

theorem EchoIn.sim_fst (c : EchoIn) (I : Interp) (j : Nat) :
    ((c.sim I).getD j dDflt).1 = (extWidths c.nodes.val).getD j 0 :=
  extSim_getD_fst _ _ _ _ _ _ j

theorem getD_map_val0 (l : List Std.Usize) (i : Nat) :
    (l.map UScalar.val).getD i 0 = (l.getD i 0#usize).val := by
  rw [List.getD_eq_getElem?_getD, List.getD_eq_getElem?_getD, List.getElem?_map]
  cases l[i]? <;> rfl

theorem EchoIn.sim_node (c : EchoIn) (I : Interp) {i : Nat} (hil : i < c.nodes.val.length) :
    (c.sim I).getD i dDflt = extNodeVal (c.layout I) c.bits.val (c.arrsOf I) (c.ufsOf I) c.side.val
      (extSim (c.layout I) c.bits.val (c.arrsOf I) (c.ufsOf I) c.side.val (c.nodes.val.take i))
      (extNin (c.nodes.val.take i)) c.nodes.val[i] :=
  extSim_node _ _ _ _ _ _ i hil

theorem EchoIn.sim_core (c : EchoIn) (I : Interp) {i : Nat} (hil : i < c.nodes.val.length)
    {nd : blast_kernel.DagNode} (hnd : c.nodes.val[i] = .Core nd) :
    (c.sim I).getD i dDflt = dagNodeVal (c.layout I) c.bits.val
      (extSim (c.layout I) c.bits.val (c.arrsOf I) (c.ufsOf I) c.side.val (c.nodes.val.take i))
      (extNin (c.nodes.val.take i)) nd := by
  rw [c.sim_node I hil, hnd]
  rfl

theorem EchoIn.sim_take (c : EchoIn) (I : Interp) {i j : Nat} (hj : j < i) :
    (extSim (c.layout I) c.bits.val (c.arrsOf I) (c.ufsOf I) c.side.val
      (c.nodes.val.take i)).getD j dDflt = (c.sim I).getD j dDflt :=
  extSim_take_getD _ _ _ _ _ _ i j hj

theorem EchoIn.sim_const (c : EchoIn) (I : Interp) {i : Nat} (hil : i < c.nodes.val.length)
    {s w : Std.Usize} (hnd : c.nodes.val[i] = .Core (.Const s w)) :
    (c.sim I).getD i dDflt = ⟨w.val, bvOfFn (fun j => c.bits.val.getD (s.val + j) false) w.val⟩ :=
  extSim_const _ _ _ _ _ _ i hil s w hnd

theorem EchoIn.blk_len (c : EchoIn) (I : Interp) :
    ∀ k (hk : k < c.nodes.val.length), (c.blk I k).length = extVarWidth c.nodes.val[k] := by
  intro k hk
  unfold EchoIn.blk
  rw [getD_eq_getElem_of_lt hk]
  cases c.nodes.val[k] with
  | Core nd => cases nd <;> simp [extVarWidth, varWidth]
  | Select _ _ _ _ => simp [extVarWidth]
  | Call _ _ _ _ => simp [extVarWidth]

/-- **A variable node reads the constant its table entry names.** -/
theorem EchoIn.sim_var (c : EchoIn) (I : Interp) {i : Nat} (hil : i < c.nodes.val.length)
    {w : Std.Usize} (hnd : c.nodes.val[i] = .Core (.Var w)) :
    (c.sim I).getD i dDflt = ⟨w.val, I.cst (c.vname (nodeVar c.var_node.val i)) w.val⟩ := by
  rw [c.sim_core I hil hnd]
  simp only [dagNodeVal]
  congr 1
  rw [← bvOfFn_getLsbD w.val (I.cst (c.vname (nodeVar c.var_node.val i)) w.val)]
  apply bvOfFn_congr'
  intro j hj
  have hvw : extVarWidth c.nodes.val[i] = w.val := by rw [hnd]; rfl
  unfold EchoIn.layout
  rw [layoutAuxE_getD c.nodes.val (c.blk I) (c.blk_len I) c.nodes.val.length (le_refl _) i hil j
    (by rw [hvw]; exact hj)]
  unfold EchoIn.blk
  rw [getD_eq_getElem_of_lt hil, hnd]
  simp only
  rw [List.getD_eq_getElem?_getD, List.getElem?_map, List.getElem?_range hj]
  rfl

/- ══════════════════ WHAT A PRINTED NODE DENOTES ══════════════════ -/

/-- A node's value as an SMT-LIB value of the sort it is printed at. -/
def valK : Bool → DVal → Val
  | true, v => .bool (bval v)
  | false, v => .bv v

/-- `e` is node `i` printed at sort `want`: it reads back, and under
    every interpretation it has the node's value. -/
def NodeDen (c : EchoIn) (i : Nat) (want : Bool) (e : SExp) : Prop :=
  Printable e ∧ ∀ I, den I c.sg e = some (valK want ((c.sim I).getD i dDflt))

/-- The walk is correct below `n` (the induction hypothesis). -/
def IHlt (c : EchoIn) (n : Nat) : Prop :=
  ∀ (i : Std.Usize), i.val < n → ∀ (want : Bool) (out out' : alloc.vec.Vec Std.U8),
    c.node i want out = ok (core.result.Result.Ok (), out') →
    ∃ e, out'.val = out.val ++ render e ∧ NodeDen c i.val want e

theorem echo_one_ok (c : EchoIn) (n : Nat) (ih : IHlt c n) (a : Std.Usize) (ha : a.val < n)
    (ab : Bool) (out out' : alloc.vec.Vec Std.U8)
    (h : c.one a ab out = ok (core.result.Result.Ok (), out')) :
    ∃ e, out'.val = out.val ++ (cSp :: (render e ++ [cRp])) ∧ NodeDen c a.val ab e := by
  unfold EchoIn.one kernel.echo_kernel.echo_one at h
  obtain ⟨out1, ho1, h⟩ := bind_ok_inv h
  obtain ⟨⟨r, out2⟩, hn, h⟩ := bind_ok_inv h
  (try dsimp only at h)
  cases r with
  | Err e => cases h
  | Ok u =>
    cases u
    (try dsimp only at h)
    obtain ⟨out3, ho3, h⟩ := bind_ok_inv h
    cases h
    obtain ⟨e, he, hd⟩ := ih a ha ab out1 out2 hn
    refine ⟨e, ?_, hd⟩
    rw [push_ok ho3, he, push_ok ho1]
    simp only [List.append_assoc, List.cons_append, List.nil_append]
    rfl

theorem echo_two_ok (c : EchoIn) (n : Nat) (ih : IHlt c n) (a b : Std.Usize) (ha : a.val < n)
    (hb : b.val < n) (ob : Bool) (out out' : alloc.vec.Vec Std.U8)
    (h : c.two a b ob out = ok (core.result.Result.Ok (), out')) :
    ∃ ea eb, out'.val = out.val ++ (cSp :: (render ea ++ (cSp :: (render eb ++ [cRp])))) ∧
      NodeDen c a.val ob ea ∧ NodeDen c b.val ob eb := by
  unfold EchoIn.two kernel.echo_kernel.echo_two at h
  obtain ⟨out1, ho1, h⟩ := bind_ok_inv h
  obtain ⟨⟨r, out2⟩, hn, h⟩ := bind_ok_inv h
  (try dsimp only at h)
  cases r with
  | Err e => cases h
  | Ok u =>
    cases u
    (try dsimp only at h)
    obtain ⟨ea, hea, hda⟩ := ih a ha ob out1 out2 hn
    obtain ⟨eb, heb, hdb⟩ := echo_one_ok c n ih b hb ob out2 out' h
    refine ⟨ea, eb, ?_, hda, hdb⟩
    rw [heb, hea, push_ok ho1]
    simp only [List.append_assoc, List.cons_append, List.nil_append]
    rfl

/-- **A two-operand application** `(sym A B)`: the 13 binary bitvector
    operators and `concat`, the 10 predicates, `and` / `or`. -/
theorem arm_two (c : EchoIn) (i : Std.Usize) (ih : IHlt c i.val) (nd : blast_kernel.DagNode)
    (a b : Std.Usize) (wantK opsK : Bool) (ha : a.val < i.val) (hb : b.val < i.val)
    (hsym : symOk (symOf nd) = true)
    (hsem : ∀ I, denSym (symOf nd)
      [valK opsK ((c.sim I).getD a.val dDflt), valK opsK ((c.sim I).getD b.val dDflt)]
        = some (valK wantK ((c.sim I).getD i.val dDflt)))
    (out out' : alloc.vec.Vec Std.U8)
    (h : (do
      let out1 ← alloc.vec.Vec.push out 40#u8
      let out2 ← kernel.echo_kernel.push_sym out1 nd
      c.two a b opsK out2) = ok (core.result.Result.Ok (), out')) :
    ∃ e, out'.val = out.val ++ render e ∧ NodeDen c i.val wantK e := by
  obtain ⟨out1, ho1, h⟩ := bind_ok_inv h
  obtain ⟨out2, ho2, h⟩ := bind_ok_inv h
  obtain ⟨ea, eb, he, ⟨hpa, hda⟩, ⟨hpb, hdb⟩⟩ := echo_two_ok c i.val ih a b ha hb opsK out2 out' h
  refine ⟨.list [.sym (symOf nd), ea, eb], ?_, ?_, fun I => ?_⟩
  · rw [he, push_sym_ok ho2, push_ok ho1]
    simp only [render, renderSp, List.drop_succ_cons, List.drop_zero, List.append_assoc,
      List.cons_append, List.nil_append, List.append_nil]
    rfl
  · simp only [Printable, PrintableL]
    exact ⟨hsym, hpa, hpb, trivial⟩
  · rw [den_app I c.sg _ _ _ (denArgs_cons I c.sg _ _ _ _ (hda I)
      (denArgs_cons I c.sg _ _ _ _ (hdb I) (denArgs_nil I c.sg))), denApp_sym]
    exact hsem I

/-- **A one-operand application** `(sym A)`: `bvnot`, `bvneg`, `not`. -/
theorem arm_one (c : EchoIn) (i : Std.Usize) (ih : IHlt c i.val) (nd : blast_kernel.DagNode)
    (a : Std.Usize) (wantK opK : Bool) (ha : a.val < i.val)
    (hsym : symOk (symOf nd) = true)
    (hsem : ∀ I, denSym (symOf nd) [valK opK ((c.sim I).getD a.val dDflt)]
        = some (valK wantK ((c.sim I).getD i.val dDflt)))
    (out out' : alloc.vec.Vec Std.U8)
    (h : (do
      let out1 ← alloc.vec.Vec.push out 40#u8
      let out2 ← kernel.echo_kernel.push_sym out1 nd
      c.one a opK out2) = ok (core.result.Result.Ok (), out')) :
    ∃ e, out'.val = out.val ++ render e ∧ NodeDen c i.val wantK e := by
  obtain ⟨out1, ho1, h⟩ := bind_ok_inv h
  obtain ⟨out2, ho2, h⟩ := bind_ok_inv h
  obtain ⟨ea, he, ⟨hpa, hda⟩⟩ := echo_one_ok c i.val ih a ha opK out2 out' h
  refine ⟨.list [.sym (symOf nd), ea], ?_, ?_, fun I => ?_⟩
  · rw [he, push_sym_ok ho2, push_ok ho1]
    simp only [render, renderSp, List.drop_succ_cons, List.drop_zero, List.append_assoc,
      List.cons_append, List.nil_append, List.append_nil]
    rfl
  · simp only [Printable, PrintableL]
    exact ⟨hsym, hpa, trivial⟩
  · rw [den_app I c.sg _ _ _ (denArgs_cons I c.sg _ _ _ _ (hda I) (denArgs_nil I c.sg)),
      denApp_sym]
    exact hsem I

/-- The indexed head `(_ ix k)`. -/
def idxE (ix : List Std.U8) (k : Nat) : SExp := .list [.sym (bytes "_"), .sym ix, .num k]

theorem denApp_idx1 (I : Interp) (sg : Sig) (ix : List Std.U8) (k : Nat) (x : DVal) :
    denApp I sg (idxE ix k) [.bv x] = denIdx1 ix k x := by
  simp [idxE, denApp]

theorem denApp_extract (I : Interp) (sg : Sig) (hi lo : Nat) (x : DVal) (h1 : lo ≤ hi)
    (h2 : hi < x.1) :
    denApp I sg (.list [.sym (bytes "_"), .sym (bytes "extract"), .num hi, .num lo]) [.bv x]
      = some (.bv ⟨hi - lo + 1, x.2.extractLsb hi lo⟩) := by
  simp [denApp, h1, h2]

/-- **An application of an indexed symbol** `((_ ix k) A)`: the two
    extensions and the two rotates. -/
theorem arm_idx1 (c : EchoIn) (i : Std.Usize) (ih : IHlt c i.val) (nd : blast_kernel.DagNode)
    (a k : Std.Usize) (ha : a.val < i.val) (hsym : symOk (symOf nd) = true)
    (hsem : ∀ I, denIdx1 (symOf nd) k.val ((c.sim I).getD a.val dDflt)
        = some (.bv ((c.sim I).getD i.val dDflt)))
    (out out' : alloc.vec.Vec Std.U8)
    (h : (do
      let s ← lift (Array.to_slice (Array.make 4#usize [ 40#u8, 40#u8, 95#u8, 32#u8 ]))
      let out1 ← kernel.echo_kernel.push_word out s
      let out2 ← kernel.echo_kernel.push_sym out1 nd
      let out3 ← alloc.vec.Vec.push out2 32#u8
      let out4 ← kernel.echo_kernel.push_dec out3 k
      let out5 ← alloc.vec.Vec.push out4 41#u8
      c.one a false out5) = ok (core.result.Result.Ok (), out')) :
    ∃ e, out'.val = out.val ++ render e ∧ NodeDen c i.val false e := by
  obtain ⟨s, hs, h⟩ := bind_ok_inv h
  have hs' := lift_ok hs
  subst hs'
  obtain ⟨out1, ho1, h⟩ := bind_ok_inv h
  obtain ⟨out2, ho2, h⟩ := bind_ok_inv h
  obtain ⟨out3, ho3, h⟩ := bind_ok_inv h
  obtain ⟨out4, ho4, h⟩ := bind_ok_inv h
  obtain ⟨out5, ho5, h⟩ := bind_ok_inv h
  obtain ⟨ea, he, ⟨hpa, hda⟩⟩ := echo_one_ok c i.val ih a ha false out5 out' h
  refine ⟨.list [idxE (symOf nd) k.val, ea], ?_, ?_, fun I => ?_⟩
  · rw [he, push_ok ho5, push_dec_ok ho4, push_ok ho3, push_sym_ok ho2, push_word_ok ho1]
    simp only [idxE, render, renderSp, List.drop_succ_cons, List.drop_zero, List.append_assoc,
      List.cons_append, List.nil_append, List.append_nil]
    rfl
  · simp only [idxE, Printable, PrintableL]
    exact ⟨⟨by rfl, hsym, trivial, trivial⟩, hpa, trivial⟩
  · rw [den_app I c.sg _ _ _ (denArgs_cons I c.sg _ _ _ _ (hda I) (denArgs_nil I c.sg))]
    simp only [valK]
    rw [denApp_idx1]
    exact hsem I

/- ══════════════════ PER-CLASS SEMANTICS ══════════════════ -/

/-- A binary bitvector operator node denotes what its symbol denotes. -/
theorem bvbin_sem (c : EchoIn) (I : Interp) {i : Nat} (hil : i < c.nodes.val.length)
    {nd : blast_kernel.DagNode} (hnd : c.nodes.val[i] = .Core nd) {a b : Std.Usize}
    (ha : a.val < i) (hb : b.val < i)
    (hweq : (extWidths c.nodes.val).getD a.val 0 = (extWidths c.nodes.val).getD b.val 0)
    {f : (w : Nat) → BitVec w → BitVec w → BitVec w} (hf : bvBinOp (symOf nd) = some f)
    (hval : ∀ (inp bits : List Bool) (vals : List DVal) (nin : Nat),
      dagNodeVal inp bits vals nin nd = ⟨(vals.getD a.val dDflt).1,
        f _ (vals.getD a.val dDflt).2 (toW _ (vals.getD b.val dDflt))⟩) :
    denSym (symOf nd)
      [valK false ((c.sim I).getD a.val dDflt), valK false ((c.sim I).getD b.val dDflt)]
        = some (valK false ((c.sim I).getD i dDflt)) := by
  rw [c.sim_core I hil hnd, hval, c.sim_take I ha, c.sim_take I hb]
  simp only [valK]
  exact denSym_bin hf ((c.sim I).getD a.val dDflt) ((c.sim I).getD b.val dDflt)
    (by rw [c.sim_fst, c.sim_fst]; exact hweq)

/-- A predicate node denotes what its symbol denotes. -/
theorem cmp_sem (c : EchoIn) (I : Interp) {i : Nat} (hil : i < c.nodes.val.length)
    {nd : blast_kernel.DagNode} (hnd : c.nodes.val[i] = .Core nd) {a b : Std.Usize}
    (ha : a.val < i) (hb : b.val < i)
    (hweq : (extWidths c.nodes.val).getD a.val 0 = (extWidths c.nodes.val).getD b.val 0)
    (h0 : bvBinOp (symOf nd) = none)
    {p : (w : Nat) → BitVec w → BitVec w → Bool} (hp : bvCmpOp (symOf nd) = some p)
    (hval : ∀ (inp bits : List Bool) (vals : List DVal) (nin : Nat),
      dagNodeVal inp bits vals nin nd
        = bvBool (p _ (vals.getD a.val dDflt).2 (toW _ (vals.getD b.val dDflt)))) :
    denSym (symOf nd)
      [valK false ((c.sim I).getD a.val dDflt), valK false ((c.sim I).getD b.val dDflt)]
        = some (valK true ((c.sim I).getD i dDflt)) := by
  rw [c.sim_core I hil hnd, hval, c.sim_take I ha, c.sim_take I hb]
  simp only [valK, bval_bvBool]
  exact denSym_cmp h0 hp ((c.sim I).getD a.val dDflt) ((c.sim I).getD b.val dDflt)
    (by rw [c.sim_fst, c.sim_fst]; exact hweq)

/-- A connective node denotes what its symbol denotes. -/
theorem boolbin_sem (c : EchoIn) (I : Interp) {i : Nat} (hil : i < c.nodes.val.length)
    {nd : blast_kernel.DagNode} (hnd : c.nodes.val[i] = .Core nd) {a b : Std.Usize}
    (ha : a.val < i) (hb : b.val < i)
    {f : Bool → Bool → Bool} (hf : boolBinOp (symOf nd) = some f)
    (hval : ∀ (inp bits : List Bool) (vals : List DVal) (nin : Nat),
      dagNodeVal inp bits vals nin nd
        = bvBool (f (bval (vals.getD a.val dDflt)) (bval (vals.getD b.val dDflt)))) :
    denSym (symOf nd)
      [valK true ((c.sim I).getD a.val dDflt), valK true ((c.sim I).getD b.val dDflt)]
        = some (valK true ((c.sim I).getD i dDflt)) := by
  rw [c.sim_core I hil hnd, hval, c.sim_take I ha, c.sim_take I hb]
  simp only [valK, bval_bvBool]
  exact denSym_bool hf _ _

/-- A unary bitvector operator node denotes what its symbol denotes. -/
theorem un_sem (c : EchoIn) (I : Interp) {i : Nat} (hil : i < c.nodes.val.length)
    {nd : blast_kernel.DagNode} (hnd : c.nodes.val[i] = .Core nd) {a : Std.Usize}
    (ha : a.val < i)
    {f : (w : Nat) → BitVec w → BitVec w} (hf : bvUnOp (symOf nd) = some f)
    (hval : ∀ (inp bits : List Bool) (vals : List DVal) (nin : Nat),
      dagNodeVal inp bits vals nin nd
        = ⟨(vals.getD a.val dDflt).1, f _ (vals.getD a.val dDflt).2⟩) :
    denSym (symOf nd) [valK false ((c.sim I).getD a.val dDflt)]
        = some (valK false ((c.sim I).getD i dDflt)) := by
  rw [c.sim_core I hil hnd, hval, c.sim_take I ha]
  simp only [valK]
  exact denSym_un hf _

theorem denIdx1_zext (k : Nat) (x : DVal) :
    denIdx1 (bytes "zero_extend") k x = some (.bv ⟨x.1 + k, x.2.setWidth (x.1 + k)⟩) := rfl
theorem denIdx1_sext (k : Nat) (x : DVal) :
    denIdx1 (bytes "sign_extend") k x = some (.bv ⟨x.1 + k, x.2.signExtend (x.1 + k)⟩) := rfl
theorem denIdx1_rotl (k : Nat) (x : DVal) :
    denIdx1 (bytes "rotate_left") k x = some (.bv ⟨x.1, x.2.rotateLeft (k % x.1)⟩) := rfl
theorem denIdx1_rotr (k : Nat) (x : DVal) :
    denIdx1 (bytes "rotate_right") k x = some (.bv ⟨x.1, x.2.rotateRight (k % x.1)⟩) := rfl

/- ══════════════════ STORE CHAINS ══════════════════ -/

/-- A chain of stores over `base`: level 0 outermost. -/
def chainE (base : SExp) : List (SExp × SExp) → SExp
  | [] => base
  | p :: rest => .list [.sym (bytes "store"), chainE base rest, p.1, p.2]

/-- The closings of a chain's levels, innermost first. -/
def levelsText : List (SExp × SExp) → List Std.U8
  | [] => []
  | p :: rest => levelsText rest ++ (cSp :: (render p.1 ++ (cSp :: (render p.2 ++ [cRp]))))

theorem levelsText_snoc (es : List (SExp × SExp)) (p : SExp × SExp) :
    levelsText (es ++ [p])
      = (cSp :: (render p.1 ++ (cSp :: (render p.2 ++ [cRp])))) ++ levelsText es := by
  induction es with
  | nil => simp [levelsText]
  | cons q es ih =>
    simp only [List.cons_append, levelsText, ih, List.append_assoc]

theorem render_chainE (base : SExp) : ∀ (es : List (SExp × SExp)),
    render (chainE base es)
      = (List.replicate es.length (bytes "(store ")).flatten ++ (render base ++ levelsText es)
  | [] => by simp [chainE, levelsText]
  | p :: rest => by
    simp only [chainE, levelsText, render, renderSp, List.drop_succ_cons, List.drop_zero,
      List.length_cons, List.replicate_succ, List.flatten_cons, List.append_assoc,
      List.cons_append, List.nil_append, List.append_nil]
    rw [render_chainE base rest]
    simp only [List.append_assoc]
    rfl

theorem printable_chainE (base : SExp) (hb : Printable base) : ∀ (es : List (SExp × SExp)),
    (∀ l (hl : l < es.length), Printable es[l].1 ∧ Printable es[l].2) →
    Printable (chainE base es)
  | [], _ => hb
  | p :: rest, h => by
    have h0 := h 0 (by simp)
    simp only [List.getElem_cons_zero] at h0
    have hr := printable_chainE base hb rest (fun l hl => by
      have := h (l + 1) (by simpa using hl)
      simpa using this)
    simp only [chainE, Printable, PrintableL]
    exact ⟨by rfl, hr, h0.1, h0.2, trivial⟩

/-- A printed chain denotes the read-over-write of its levels. -/
theorem den_chainE (I : Interp) (sg : Sig) (arrs : Arrs) (vals : List DVal)
    (side : List Std.Usize) (aid : Nat) (base : SExp)
    (hbase : den I sg base = some (.arr (arrs aid))) :
    ∀ (es : List (SExp × SExp)) (s : Nat),
      (∀ l (hl : l < es.length),
        den I sg es[l].1 = some (.bv (vals.getD (side.getD (s + 2 * l) 0#usize).val dDflt)) ∧
        (vals.getD (side.getD (s + 2 * l) 0#usize).val dDflt).1 = 32 ∧
        den I sg es[l].2
          = some (.bv (vals.getD (side.getD (s + 2 * l + 1) 0#usize).val dDflt)) ∧
        (vals.getD (side.getD (s + 2 * l + 1) 0#usize).val dDflt).1 = 8) →
      den I sg (chainE base es)
        = some (.arr (fun j => chainRead arrs vals side aid j s es.length))
  | [], s, _ => by
    simp only [chainE, List.length_nil, chainRead]
    exact hbase
  | p :: rest, s, h => by
    have h0 := h 0 (by simp)
    simp only [List.getElem_cons_zero, Nat.mul_zero, Nat.add_zero] at h0
    obtain ⟨hi, hiw, hv, hvw⟩ := h0
    have hrest := den_chainE I sg arrs vals side aid base hbase rest (s + 2) (fun l hl => by
      have := h (l + 1) (by simpa using hl)
      simp only [List.getElem_cons_succ] at this
      have e1 : s + 2 * (l + 1) = s + 2 + 2 * l := by omega
      rw [e1] at this
      exact this)
    simp only [chainE]
    rw [den_app I sg _ _ _ (denArgs_cons I sg _ _ _ _ hrest (denArgs_cons I sg _ _ _ _ hi
      (denArgs_cons I sg _ _ _ _ hv (denArgs_nil I sg)))), denApp_sym,
      denSym_store _ _ _ hiw hvw]
    simp only [List.length_cons, chainRead]

theorem echo_levels_ok (c : EchoIn) (n : Nat) (ih : IHlt c n) (s : Std.Usize) :
    ∀ (l : Nat) (lu : Std.Usize), lu.val = l →
      (∀ l' < l, c.sideAt (s.val + 2 * l') < n ∧ c.sideAt (s.val + 2 * l' + 1) < n) →
      ∀ (out out' : alloc.vec.Vec Std.U8),
        c.levels s lu out = ok (core.result.Result.Ok (), out') →
        ∃ es : List (SExp × SExp), es.length = l ∧ out'.val = out.val ++ levelsText es ∧
          ∀ l' (hl : l' < es.length),
            NodeDen c (c.sideAt (s.val + 2 * l')) false es[l'].1 ∧
            NodeDen c (c.sideAt (s.val + 2 * l' + 1)) false es[l'].2 := by
  intro l
  induction l with
  | zero =>
    intro lu hlu _ out out' h
    unfold EchoIn.levels kernel.echo_kernel.echo_levels at h
    have h0 : lu = 0#usize := UScalar.eq_of_val_eq (by simpa using hlu)
    subst h0
    simp only [if_true] at h
    cases h
    exact ⟨[], rfl, by simp [levelsText], fun l' hl => by simp at hl⟩
  | succ l ihl =>
    intro lu hlu hside out out' h
    unfold EchoIn.levels kernel.echo_kernel.echo_levels at h
    split at h
    · rename_i h0
      exfalso
      rw [h0] at hlu
      simp at hlu
    · obtain ⟨l1, hl1, h⟩ := bind_ok_inv h
      have hl1v : l1.val = l := by
        have := usub_ok hl1
        simp at this
        omega
      (try dsimp only at h)
      split at h
      · cases h
      · obtain ⟨i, hi, h⟩ := bind_ok_inv h
        obtain ⟨i1, hi1, h⟩ := bind_ok_inv h
        split at h
        · cases h
        · obtain ⟨i2, hi2, h⟩ := bind_ok_inv h
          obtain ⟨off, hoff, h⟩ := bind_ok_inv h
          obtain ⟨x, hx, h⟩ := bind_ok_inv h
          obtain ⟨i3, hi3, h⟩ := bind_ok_inv h
          obtain ⟨y, hy, h⟩ := bind_ok_inv h
          obtain ⟨⟨r, out1⟩, htwo, h⟩ := bind_ok_inv h
          (try dsimp only at h)
          cases r with
          | Err e => cases h
          | Ok u =>
            cases u
            (try dsimp only at h)
            have hoffv : off.val = s.val + 2 * l := by
              have h1 := uadd_ok hoff
              have h2 := umul_ok hi2
              simp at h2
              omega
            have hi3v : i3.val = s.val + 2 * l + 1 := by
              have h1 := uadd_ok hi3
              simp at h1
              omega
            obtain ⟨_, hxv⟩ := slice_index_ok hx
            obtain ⟨_, hyv⟩ := slice_index_ok hy
            have hxs : x.val = c.sideAt (s.val + 2 * l) := by
              unfold EchoIn.sideAt
              rw [hxv 0#usize, hoffv]
            have hys : y.val = c.sideAt (s.val + 2 * l + 1) := by
              unfold EchoIn.sideAt
              rw [hyv 0#usize, hi3v]
            obtain ⟨hsx, hsy⟩ := hside l (by omega)
            obtain ⟨ex, ey, hexy, hdx, hdy⟩ := echo_two_ok c n ih x y (by rw [hxs]; exact hsx)
              (by rw [hys]; exact hsy) false out out1 htwo
            obtain ⟨es, hlen, hes, hden⟩ := ihl l1 hl1v (fun l' hl' => hside l' (by omega))
              out1 out' h
            refine ⟨es ++ [(ex, ey)], by simp [hlen], ?_, ?_⟩
            · rw [hes, hexy, levelsText_snoc]
              simp only [List.append_assoc]
            · intro l' hl'
              rcases Nat.lt_or_ge l' es.length with hlt | hge
              · rw [List.getElem_append_left hlt]
                exact hden l' hlt
              · have hl'e : l' = es.length := by
                  simp only [List.length_append, List.length_cons, List.length_nil] at hl'
                  omega
                subst hl'e
                rw [List.getElem_append_right (le_refl _)]
                simp only [Nat.sub_self, List.getElem_cons_zero]
                rw [hlen, ← hxs, ← hys]
                exact ⟨hdx, hdy⟩

/- ══════════════════ CALL ARGUMENTS ══════════════════ -/

theorem renderSp_append (a b : List SExp) : renderSp (a ++ b) = renderSp a ++ renderSp b := by
  induction a with
  | nil => simp [renderSp]
  | cons x a ih => simp only [List.cons_append, renderSp, ih, List.append_assoc]

theorem printableL_of : ∀ (es : List SExp), (∀ j (hj : j < es.length), Printable es[j]) →
    PrintableL es
  | [], _ => by simp only [PrintableL]
  | e :: rest, h => by
    simp only [PrintableL]
    refine ⟨by simpa using h 0 (by simp), printableL_of rest (fun j hj => ?_)⟩
    have := h (j + 1) (by simpa using hj)
    simpa using this

theorem echo_args_ok (c : EchoIn) (n : Nat) (ih : IHlt c n) (s : Std.Usize) :
    ∀ (m : Nat) (mu : Std.Usize), mu.val = m → (∀ j < m, c.sideAt (s.val + j) < n) →
      ∀ (out out' : alloc.vec.Vec Std.U8),
        c.args s mu out = ok (core.result.Result.Ok (), out') →
        ∃ es : List SExp, es.length = m ∧ out'.val = out.val ++ renderSp es ∧
          ∀ j (hj : j < es.length), NodeDen c (c.sideAt (s.val + j)) false es[j] := by
  intro m
  induction m with
  | zero =>
    intro mu hmu _ out out' h
    unfold EchoIn.args kernel.echo_kernel.echo_args at h
    have h0 : mu = 0#usize := UScalar.eq_of_val_eq (by simpa using hmu)
    subst h0
    simp only [if_true] at h
    cases h
    exact ⟨[], rfl, by simp [renderSp], fun j hj => by simp at hj⟩
  | succ m ihm =>
    intro mu hmu hside out out' h
    unfold EchoIn.args kernel.echo_kernel.echo_args at h
    split at h
    · rename_i h0
      exfalso
      rw [h0] at hmu
      simp at hmu
    · obtain ⟨n1, hn1, h⟩ := bind_ok_inv h
      have hn1v : n1.val = m := by
        have := usub_ok hn1
        simp at this
        omega
      obtain ⟨⟨r, out1⟩, hrec, h⟩ := bind_ok_inv h
      (try dsimp only at h)
      cases r with
      | Err e => cases h
      | Ok u =>
        cases u
        (try dsimp only at h)
        split at h
        · cases h
        · obtain ⟨i, hi, h⟩ := bind_ok_inv h
          split at h
          · cases h
          · obtain ⟨i1, hi1, h⟩ := bind_ok_inv h
            obtain ⟨x, hx, h⟩ := bind_ok_inv h
            obtain ⟨out2, ho2, h⟩ := bind_ok_inv h
            obtain ⟨_, hxv⟩ := slice_index_ok hx
            have hxs : x.val = c.sideAt (s.val + m) := by
              unfold EchoIn.sideAt
              rw [hxv 0#usize, uadd_ok hi1, hn1v]
            obtain ⟨es, hlen, hes, hden⟩ := ihm n1 hn1v (fun j hj => hside j (by omega)) out out1
              hrec
            obtain ⟨ex, hex, hdx⟩ := ih x (by rw [hxs]; exact hside m (by omega)) false out2 out' h
            refine ⟨es ++ [ex], by simp [hlen], ?_, ?_⟩
            · rw [hex, push_ok ho2, hes, renderSp_append]
              simp only [renderSp, List.append_assoc, List.cons_append, List.nil_append,
                List.append_nil]
              rfl
            · intro j hj
              rcases Nat.lt_or_ge j es.length with hlt | hge
              · rw [List.getElem_append_left hlt]
                exact hden j hlt
              · have hje : j = es.length := by
                  simp only [List.length_append, List.length_cons, List.length_nil] at hj
                  omega
                subst hje
                rw [List.getElem_append_right (le_refl _)]
                simp only [Nat.sub_self, List.getElem_cons_zero]
                rw [hlen, ← hxs]
                exact hdx

theorem denArgs_bv (I : Interp) (sg : Sig) : ∀ (es : List SExp) (f : Nat → DVal),
    (∀ j (hj : j < es.length), den I sg es[j] = some (valK false (f j))) →
    denArgs I sg es = some ((List.range es.length).map fun j => Val.bv (f j))
  | [], f, _ => by simp [denArgs]
  | e :: rest, f, h => by
    have h0 := h 0 (by simp)
    simp only [List.getElem_cons_zero] at h0
    have hr := denArgs_bv I sg rest (fun j => f (j + 1)) (fun j hj => by
      have := h (j + 1) (by simpa using hj)
      simpa using this)
    rw [denArgs_cons I sg _ _ _ _ h0 hr, List.length_cons, List.range_succ_eq_map, List.map_cons,
      List.map_map]
    rfl

theorem bvArgs_map {α : Type} (l : List α) (g : α → DVal) :
    bvArgs (l.map fun x => Val.bv (g x)) = some (l.map g) := by
  induction l with
  | nil => rfl
  | cons x l ih => simp only [List.map_cons, bvArgs, ih, Option.map_some]

theorem denApp_call (I : Interp) (sg : Sig) (f : List Std.U8) (vs : List Val) (hne : vs ≠ [])
    (ws : List Nat) (w : Nat) (hsg : sg.get f = some (.fn ws w)) (dvs : List DVal)
    (hb : bvArgs vs = some dvs) (hw : dvs.map Sigma.fst = ws) :
    denApp I sg (.qsym f) vs = some (.bv ⟨w, toW w (I.fn f dvs)⟩) := by
  cases vs with
  | nil => exact absurd rfl hne
  | cons a rest => simp only [denApp, hsg, hb, hw, if_true]

/- ══════════════════ THE WALK ══════════════════ -/

theorem binE_printable (bits : List Bool) (s w : Nat) (hw : 0 < w) (hr : s + w ≤ bits.length) :
    Printable (binE bits s w) := by
  simp only [binE, Printable]
  intro hc
  have hlen : (segOf bits s w).reverse.length = w := by
    rw [List.length_reverse]
    exact seg_length _ _ _ hr
  rw [hc] at hlen
  simp at hlen
  omega

/-- **One step of the walk**: node `i`, given the walk is correct below
    it. One case per `DagNode` arm, then `select` and call. -/
theorem echo_node_step (c : EchoIn) (H : Good c) (i : Std.Usize) (ih : IHlt c i.val)
    (want : Bool) (out out' : alloc.vec.Vec Std.U8)
    (h : c.node i want out = ok (core.result.Result.Ok (), out')) :
    ∃ e, out'.val = out.val ++ render e ∧ NodeDen c i.val want e := by
  unfold EchoIn.node kernel.echo_kernel.echo_node at h
  (try dsimp only at h)
  -- `by_cases` + `rw`, not `split`: the term is the whole 37-arm walk.
  by_cases h1 : i ≥ Slice.len c.nodes
  · rw [if_pos h1] at h
    cases h
  rw [if_neg h1] at h
  by_cases h2 : i ≥ Slice.len c.ws
  · rw [if_pos h2] at h
    cases h
  rw [if_neg h2] at h
  -- The whole body is cleared once it is inverted: a later `subst` of
  -- `want` would re-introduce it AFTER the arm's own `h` and shadow it.
  obtain ⟨node, hnode, hbody⟩ := bind_ok_inv h
  clear h
  have h := hbody
  clear hbody
  obtain ⟨hil, hnv⟩ := slice_index_ok hnode
  have hnd0 : c.nodes.val[i.val] = node := by
    rw [hnv dfltExt, getD_eq_getElem_of_lt hil]
  have hwf0 := H.wf i.val hil
  rw [hnd0] at hwf0
  cases node with
  | Core nd =>
    have hwfc : DagNodeWF (extWidths c.nodes.val) c.bits.val.length i.val nd := hwf0
    cases nd with
    | Var w =>
      (try dsimp only at h)
      split at h
      · cases h
      rename_i hw
      have hwant : want = false := by simpa using hw
      subst hwant
      obtain ⟨k, hk, h⟩ := bind_ok_inv h
      split at h
      · cases h
      rename_i hk1
      split at h
      · cases h
      rename_i hk2
      split at h
      · cases h
      rename_i hk3
      obtain ⟨wk, hwk, h⟩ := bind_ok_inv h
      split at h
      · cases h
      rename_i hweq
      obtain ⟨st, hst, h⟩ := bind_ok_inv h
      obtain ⟨ln, hln, h⟩ := bind_ok_inv h
      obtain ⟨out1, ho1, h⟩ := bind_ok_inv h
      cases h
      have hkn : k.val < c.nv := by
        unfold EchoIn.nv
        scalar_tac
      have hkv : nodeVar c.var_node.val i.val = k.val :=
        find_node_ok hk (by rw [H.vnlen]; exact hkn)
      obtain ⟨_, hstv⟩ := slice_index_ok hst
      obtain ⟨_, hlnv⟩ := slice_index_ok hln
      obtain ⟨_, hwkv⟩ := slice_index_ok hwk
      have hg := H.vgood k.val hkn
      have hin : st.val + ln.val ≤ c.names.val.length := by
        have := hg.1
        unfold EntryIn at this
        rw [← hstv 0#usize, ← hlnv 0#usize] at this
        exact this
      have hname : nameAt c.names.val st.val ln.val = c.vname k.val := by
        unfold EchoIn.vname entryName
        rw [← hstv 0#usize, ← hlnv 0#usize]
      have hww : c.vwidth k.val = w.val := by
        unfold EchoIn.vwidth
        rw [← hwkv 0#usize]
        simp only [bne_iff_ne, ne_eq, Decidable.not_not] at hweq
        rw [hweq]
      refine ⟨.qsym (c.vname k.val), ?_, ?_, fun I => ?_⟩
      · rw [push_name_ok ho1 hin, hname]
      · simp only [Printable]
        exact qOk_of_nameOk hg.2.1
      · simp only [den, denName, H.get_var k.val hkn, valK]
        rw [c.sim_var I hil hnd0, hkv, hww]
    | Const s w =>
      (try dsimp only at h)
      split at h
      · cases h
      rename_i hw
      have hwant : want = false := by simpa using hw
      subst hwant
      obtain ⟨out1, ho1, h⟩ := bind_ok_inv h
      cases h
      obtain ⟨hpos, hrng⟩ := hwfc
      refine ⟨binE c.bits.val s.val w.val, push_bits_ok ho1 hrng,
        binE_printable _ _ _ hpos hrng, fun I => ?_⟩
      rw [den_binE I c.sg _ _ _ hpos hrng, c.sim_const I hil hnd0]
      rfl
    | Add a b =>
      (try dsimp only at h)
      split at h
      · cases h
      rename_i hw
      have hwant : want = false := by simpa using hw
      subst hwant
      obtain ⟨ha, hb, hpos, hweq⟩ := hwfc
      exact arm_two c i ih _ a b false false ha hb rfl
        (fun I => bvbin_sem c I hil hnd0 ha hb hweq bvBinOp_bvadd (fun _ _ _ _ => rfl)) out out' h
    | Sub a b =>
      (try dsimp only at h)
      split at h
      · cases h
      rename_i hw
      have hwant : want = false := by simpa using hw
      subst hwant
      obtain ⟨ha, hb, hpos, hweq⟩ := hwfc
      exact arm_two c i ih _ a b false false ha hb rfl
