        rw [← hstv 0#usize, ← hlnv 0#usize] at this
        exact this
      have hname : nameAt c.anames.val st.val ln.val = c.aname aid.val := by
        unfold EchoIn.aname entryName
        rw [← hstv 0#usize, ← hlnv 0#usize]
      obtain ⟨es, hlen, hes, hden⟩ := echo_levels_ok c i.val ih s n.val n rfl
        (fun l' hl' => ⟨(hch l' hl').2.1, (hch l' hl').2.2.2.1⟩) out3 out4 hlev
      obtain ⟨ej, hej, ⟨hpj, hdj⟩⟩ := echo_one_ok c i.val ih j hj false out4 out' h
      have hpq : Printable (.qsym (c.aname aid.val)) := by
        simp only [Printable]
        exact qOk_of_nameOk hg.2.1
      refine ⟨.list [.sym (bytes "select"), chainE (.qsym (c.aname aid.val)) es, ej],
        ?_, ?_, fun I => ?_⟩
      · rw [hej, hes, push_name_ok ho3 hin, hname, push_stores_ok ho2, push_word_ok ho1]
        simp only [render, renderSp, List.drop_succ_cons, List.drop_zero, List.append_assoc,
          List.cons_append, List.nil_append, List.append_nil]
        rw [render_chainE, hlen]
        simp only [render, List.append_assoc, List.cons_append, List.nil_append]
        rfl
      · simp only [Printable, PrintableL]
        exact ⟨by rfl, printable_chainE _ hpq es (fun l hl => ⟨(hden l hl).1.1, (hden l hl).2.1⟩),
          hpj, trivial⟩
      · have hbase : den I c.sg (.qsym (c.aname aid.val)) = some (.arr (c.arrsOf I aid.val)) := by
          simp only [den, denName, H.get_arr aid.val haid]
          rfl
        have hchain := den_chainE I c.sg (c.arrsOf I) (c.sim I) c.side.val aid.val _ hbase es
          s.val (fun l hl => by
            have hl' : l < n.val := by rw [← hlen]; exact hl
            refine ⟨(hden l hl).1.2 I, ?_, (hden l hl).2.2 I, ?_⟩
            · rw [c.sim_fst]
              exact (hch l hl').2.2.1
            · rw [c.sim_fst]
              exact (hch l hl').2.2.2.2)
        rw [den_app I c.sg _ _ _ (denArgs_cons I c.sg _ _ _ _ hchain
          (denArgs_cons I c.sg _ _ _ _ (hdj I) (denArgs_nil I c.sg))), denApp_sym]
        simp only [valK]
        rw [denSym_select _ _ (by rw [c.sim_fst]; exact hjw), c.sim_node I hil, hnd0]
        simp only [extNodeVal, hlen]
        rw [c.sim_take I hj, chainRead_congr (c.arrsOf I) _ (c.sim I) c.side.val aid.val _ n.val
          s.val (fun l hl => ⟨c.sim_take I (hch l hl).2.1, c.sim_take I (hch l hl).2.2.2.1⟩)]
  | Call fid w s n =>
    obtain ⟨hwpos, hargs⟩ := hwf0
    (try dsimp only at h)
    split at h
    · cases h
    rename_i hw
    have hwant : want = false := by simpa using hw
    subst hwant
    split at h
    · cases h
    rename_i hf1
    split at h
    · cases h
    rename_i hf2
    split at h
    · cases h
    rename_i hf3
    obtain ⟨fw, hfw, h⟩ := bind_ok_inv h
    split at h
    · cases h
    rename_i hfweq
    obtain ⟨cc, hcc, h⟩ := bind_ok_inv h
    split at h
    · cases h
    rename_i hccl
    obtain ⟨first, hfirst, h⟩ := bind_ok_inv h
    obtain ⟨r, hr, h⟩ := bind_ok_inv h
    cases r with
    | Err e => cases h
    | Ok p =>
      obtain ⟨s0, n0⟩ := p
      (try dsimp only at h)
      -- The pair `let` is a match `dsimp` leaves; `change` reduces it.
      change (if (n0 != n) = true then _ else _) = _ at h
      by_cases hn0 : (n0 != n) = true
      · rw [if_pos hn0] at h
        cases h
      rw [if_neg hn0] at h
      obtain ⟨bm, hbm, h⟩ := bind_ok_inv h
      by_cases hbmt : bm = true
      rotate_left
      · rw [if_neg hbmt] at h
        cases h
      rw [if_pos hbmt] at h
      have hfid : fid.val < c.nf := by
        unfold EchoIn.nf
        scalar_tac
      have hg := H.fgood fid.val hfid
      have hccl' : cc.val < c.nodes.val.length := by scalar_tac
      have hfc := find_call_ok hcc hccl'
      obtain ⟨_, hfirstv⟩ := slice_index_ok hfirst
      obtain ⟨f', w', hfirstE⟩ := call_args_ok hr
      have hn0' : n0 = n := by
        simp only [bne_iff_ne, ne_eq, Decidable.not_not] at hn0
        exact hn0
      subst n0
      have hm := args_match_ok hbm hbmt
      rw [H.ws] at hm
      obtain ⟨_, hfwv⟩ := slice_index_ok hfw
      have hfwW : c.fwidth fid.val = w.val := by
        unfold EchoIn.fwidth
        rw [← hfwv 0#usize]
        simp only [bne_iff_ne, ne_eq, Decidable.not_not] at hfweq
        rw [hfweq]
      have hfargs : c.fargs fid.val = (List.range n.val).map fun j =>
          (extWidths c.nodes.val).getD (c.sideAt (s.val + j)) 0 := by
        unfold EchoIn.fargs
        rw [hfc, ← hfirstv dfltExt, hfirstE]
        simp only
        apply List.map_congr_left
        intro j hj
        exact (hm j (List.mem_range.mp hj)).symm
      have hsg := H.get_fun fid.val hfid
      rw [hfargs, hfwW] at hsg
      split at h
      · rename_i hnz
        obtain ⟨st, hst, h⟩ := bind_ok_inv h
        obtain ⟨ln, hln, h⟩ := bind_ok_inv h
        obtain ⟨out1, ho1, h⟩ := bind_ok_inv h
        cases h
        obtain ⟨_, hstv⟩ := slice_index_ok hst
        obtain ⟨_, hlnv⟩ := slice_index_ok hln
        have hin : st.val + ln.val ≤ c.fnames.val.length := by
          have := hg.1
          unfold EntryIn at this
          rw [← hstv 0#usize, ← hlnv 0#usize] at this
          exact this
        have hname : nameAt c.fnames.val st.val ln.val = c.fname fid.val := by
          unfold EchoIn.fname entryName
          rw [← hstv 0#usize, ← hlnv 0#usize]
        have hnv0 : n.val = 0 := by rw [hnz]; rfl
        rw [hnv0] at hsg
        refine ⟨.qsym (c.fname fid.val), ?_, ?_, fun I => ?_⟩
        · rw [push_name_ok ho1 hin, hname]
        · simp only [Printable]
          exact qOk_of_nameOk hg.2.1
        · simp only [den, denName, hsg, List.range_zero, List.map_nil, valK]
          rw [c.sim_node I hil, hnd0]
          simp only [extNodeVal, argVals, hnv0, List.range_zero, List.map_nil]
          rfl
      · rename_i hnz
        obtain ⟨out1, ho1, h⟩ := bind_ok_inv h
        obtain ⟨st, hst, h⟩ := bind_ok_inv h
        obtain ⟨ln, hln, h⟩ := bind_ok_inv h
        obtain ⟨out2, ho2, h⟩ := bind_ok_inv h
        obtain ⟨⟨r1, out3⟩, hargsE, h⟩ := bind_ok_inv h
        (try dsimp only at h)
        cases r1 with
        | Err e => cases h
        | Ok u =>
          cases u
          (try dsimp only at h)
          obtain ⟨out4, ho4, h⟩ := bind_ok_inv h
          cases h
          obtain ⟨_, hstv⟩ := slice_index_ok hst
          obtain ⟨_, hlnv⟩ := slice_index_ok hln
          have hin : st.val + ln.val ≤ c.fnames.val.length := by
            have := hg.1
            unfold EntryIn at this
            rw [← hstv 0#usize, ← hlnv 0#usize] at this
            exact this
          have hname : nameAt c.fnames.val st.val ln.val = c.fname fid.val := by
            unfold EchoIn.fname entryName
            rw [← hstv 0#usize, ← hlnv 0#usize]
          have hnp0 : 0 < n.val := by
            rcases Nat.eq_zero_or_pos n.val with h0 | hp
            · exact absurd (UScalar.eq_of_val_eq (by simpa using h0)) hnz
            · exact hp
          obtain ⟨es, hlen, hes, hden⟩ := echo_args_ok c i.val ih s n.val n rfl
            (fun j hj => (hargs j hj).2) out2 out3 hargsE
          refine ⟨.list (.qsym (c.fname fid.val) :: es), ?_, ?_, fun I => ?_⟩
          · rw [push_ok ho4, hes, push_name_ok ho2 hin, hname, push_ok ho1]
            simp only [render, renderSp, List.drop_succ_cons, List.drop_zero, List.append_assoc,
              List.cons_append, List.nil_append]
            rfl
          · simp only [Printable, PrintableL]
            exact ⟨qOk_of_nameOk hg.2.1, printableL_of es (fun j hj => (hden j hj).1)⟩
          · have hargsden := denArgs_bv I c.sg es
              (fun j => (c.sim I).getD (c.sideAt (s.val + j)) dDflt) (fun j hj => (hden j hj).2 I)
            rw [hlen] at hargsden
            rw [den_app I c.sg _ _ _ hargsden]
            have hne : ((List.range n.val).map fun j =>
                Val.bv ((c.sim I).getD (c.sideAt (s.val + j)) dDflt)) ≠ [] := by
              intro hc
              have := congrArg List.length hc
              simp at this
              omega
            rw [denApp_call I c.sg _ _ hne _ _ hsg _ (bvArgs_map _ _) (by
              rw [List.map_map]
              apply List.map_congr_left
              intro j _
              exact c.sim_fst I _)]
            rw [c.sim_node I hil, hnd0]
            simp only [extNodeVal, valK]
            rw [argVals_congr _ (c.sim I) c.side.val s.val n.val
              (fun l hl => c.sim_take I (hargs l hl).2)]
            rfl

/-- **The walk is correct**: an accepted `echo_node` printed an
    S-expression that reads back and that denotes the node's value, at
    the sort it was asked for, under every interpretation. -/
theorem echo_node_ok (c : EchoIn) (H : Good c) : ∀ (n : Nat), IHlt c n := by
  intro n
  induction n with
  | zero =>
    intro i hi
    omega
  | succ n ih =>
    intro i hi want out out' h
    rcases Nat.lt_or_ge i.val n with hlt | hge
    · exact ih i hlt want out out' h
    · have hin : i.val = n := by omega
      subst hin
      exact echo_node_step c H i ih want out out' h

/- ══════════════════ THE SCRIPT (pure) ══════════════════ -/

/-- The commands the printer emits. -/
def setLogicE (l : List Std.U8) : SExp := .list [.sym (bytes "set-logic"), .sym l]
def checkSatE : SExp := .list [.sym (bytes "check-sat")]
def assertE (t : SExp) : SExp := .list [.sym (bytes "assert"), t]
def arrSortE : SExp := .list [.sym (bytes "Array"), sortE 32, sortE 8]

/-- The command that declares `n` at `d`. -/
def declE : List Std.U8 × Decl → SExp
  | (n, .bv w) => .list [.sym (bytes "declare-const"), .qsym n, sortE w]
  | (n, .arr) => .list [.sym (bytes "declare-const"), .qsym n, arrSortE]
  | (n, .fn args w) =>
    .list [.sym (bytes "declare-fun"), .qsym n, .list (args.map sortE), sortE w]

/-- **The script of a signature and its assertions.** -/
def scriptOf (logic : List Std.U8) (sg : Sig) (ts : List SExp) : List SExp :=
  setLogicE logic :: (sg.map declE ++ (ts.map assertE ++ [checkSatE]))

/-- A declaration SMT-LIB accepts: positive widths. -/
def DeclWF : Decl → Prop
  | .bv w => 0 < w
  | .arr => True
  | .fn args w => (∀ a ∈ args, 0 < a) ∧ 0 < w

theorem renderScript_append (a b : List SExp) :
    renderScript (a ++ b) = renderScript a ++ renderScript b := by
  induction a with
  | nil => simp [renderScript]
  | cons x a ih => simp only [List.cons_append, renderScript, ih, List.append_assoc]

theorem bvSort_sortE (w : Nat) (hw : 0 < w) : bvSort (sortE w) = some w := by
  simp only [sortE, bvSort, hw, and_self, if_true]

theorem bvSorts_sortE : ∀ (args : List Nat), (∀ a ∈ args, 0 < a) →
    bvSorts (args.map sortE) = some args
  | [], _ => rfl
  | a :: rest, h => by
    simp only [List.map_cons, bvSorts, bvSort_sortE a (h a (by simp)),
      bvSorts_sortE rest (fun x hx => h x (by simp [hx]))]

theorem constSort_arr : constSort arrSortE = some .arr := rfl

theorem declOf_declE (n : List Std.U8) (d : Decl) (hd : DeclWF d) :
    declOf (declE (n, d)) = some (n, d) := by
  cases d with
  | bv w =>
    simp only [declE, declOf, constSort, bvSort_sortE w hd, if_true, Option.map_some]
  | arr =>
    simp only [declE, declOf, constSort_arr, if_true, Option.map_some]
  | fn args w =>
    simp only [declE, declOf, bvSorts_sortE args hd.1, bvSort_sortE w hd.2, if_true]

theorem declOf_assert' (t : SExp) : declOf (.list [.sym (bytes "assert"), t]) = none := by
  cases t <;> rfl

theorem bodySat_decl_step (I : Interp) (logic : List Std.U8) (sg : Sig) (n : List Std.U8)
    (d : Decl) (rest : List SExp) (hrest : rest ≠ []) (hwf : DeclWF d) :
    BodySat I logic sg (declE (n, d) :: rest) ↔
      (nameOk n ∧ sg.get n = none ∧ logicAllows logic d ∧ BodySat I logic (sg ++ [(n, d)]) rest)
      := by
  rw [BodySat]
  · simp only [declOf_declE n d hwf, hrest, false_and, false_or, ne_eq, not_false_eq_true,
      true_and]
  · intro a t hc
    cases d <;> simp [declE] at hc

theorem bodySat_assert_step (I : Interp) (logic : List Std.U8) (sg : Sig) (t : SExp)
    (rest : List SExp) (hrest : rest ≠ []) :
    BodySat I logic sg (assertE t :: rest) ↔
      (den I sg t = some (.bool true) ∧ BodySat I logic sg rest) := by
  unfold assertE
  rw [BodySat]
  simp only [declOf_assert', hrest, false_and, false_or, ne_eq, not_false_eq_true, true_and]

theorem bodySat_end (I : Interp) (logic : List Std.U8) (sg : Sig) :
    BodySat I logic sg [checkSatE] := by
  rw [BodySat]
  · exact Or.inl ⟨rfl, rfl⟩
  · intro a t hc
    simp [checkSatE] at hc

/-- Declarations extend the signature. -/
theorem bodySat_decls (I : Interp) (logic : List Std.U8) : ∀ (ds sg0 : Sig) (rest : List SExp),
    rest ≠ [] →
    (∀ p ∈ ds, DeclWF p.2 ∧ nameOk p.1 ∧ logicAllows logic p.2) →
    ((sg0 ++ ds).map Prod.fst).Pairwise (· ≠ ·) →
    (BodySat I logic sg0 (ds.map declE ++ rest) ↔ BodySat I logic (sg0 ++ ds) rest)
  | [], sg0, rest, _, _, _ => by simp
  | (n, d) :: ds, sg0, rest, hrest, hd, hn => by
    have hp := hd (n, d) (by simp)
    have hne : ds.map declE ++ rest ≠ [] := by
      intro hc
      exact hrest (List.append_eq_nil_iff.mp hc).2
    have hget : sg0.get n = none := by
      apply Sig.get_none
      intro p hp' hc
      rw [List.map_append, List.pairwise_append] at hn
      exact hn.2.2 p.1 (List.mem_map.mpr ⟨p, hp', rfl⟩) n (by simp) hc
    have hn' : ((sg0 ++ [(n, d)] ++ ds).map Prod.fst).Pairwise (· ≠ ·) := by
      rw [List.append_assoc]
      exact hn
    have ih := bodySat_decls I logic ds (sg0 ++ [(n, d)]) rest hrest
      (fun p hp' => hd p (by simp [hp'])) hn'
    rw [List.append_assoc] at ih
    rw [List.map_cons, List.cons_append, bodySat_decl_step I logic sg0 n d _ hne hp.1, ih]
    constructor
    · intro h
      exact h.2.2.2
    · intro h
      exact ⟨hp.2.1, hget, hp.2.2, h⟩

/-- Assertions are checked under the signature. -/
theorem bodySat_asserts (I : Interp) (logic : List Std.U8) (sg : Sig) : ∀ (ts : List SExp),
    (BodySat I logic sg (ts.map assertE ++ [checkSatE]) ↔
      ∀ t ∈ ts, den I sg t = some (.bool true))
  | [] => by
    simp only [List.map_nil, List.nil_append, List.not_mem_nil, false_imp_iff, implies_true,
      iff_true]
    exact bodySat_end I logic sg
  | t :: ts => by
    have hne : ts.map assertE ++ [checkSatE] ≠ [] := by simp
    rw [List.map_cons, List.cons_append, bodySat_assert_step I logic sg t _ hne,
      bodySat_asserts I logic sg ts]
    simp

/-- **A printed script is satisfied exactly when its assertions are true
    under its signature** — given the declarations are ones SMT-LIB
    accepts: well sorted, allowed by the logic, good names, pairwise
    distinct. -/
theorem scriptSat_iff (I : Interp) (logic : List Std.U8) (sg : Sig) (ts : List SExp)
    (hl : logic = bytes "QF_BV" ∨ logic = bytes "QF_ABV" ∨ logic = bytes "QF_AUFBV")
    (hd : ∀ p ∈ sg, DeclWF p.2 ∧ nameOk p.1 ∧ logicAllows logic p.2)
    (hn : (sg.map Prod.fst).Pairwise (· ≠ ·)) :
    ScriptSat I (scriptOf logic sg ts) ↔ ∀ t ∈ ts, den I sg t = some (.bool true) := by
  have hdecl := bodySat_decls I logic sg [] (ts.map assertE ++ [checkSatE]) (by simp) hd hn
  have hass := bodySat_asserts I logic sg ts
  simp only [scriptOf, setLogicE, ScriptSat]
  constructor
  · rintro ⟨_, _, hb⟩
    exact hass.mp (hdecl.mp hb)
  · intro h
    exact ⟨by first | rfl | trivial, hl, hdecl.mpr (hass.mpr h)⟩

/- ══════════════════ THE SCRIPT (kernel) ══════════════════ -/

theorem render_declE_bv (n : List Std.U8) (w : Nat) :
    render (declE (n, .bv w)) ++ [cNl]
      = bytes "(declare-const " ++ (render (.qsym n) ++ (cSp :: (render (sortE w) ++ bytes ")\n"))) := by
  simp only [declE, render, renderSp, List.drop_succ_cons, List.drop_zero, List.append_assoc,
    List.cons_append, List.nil_append, List.append_nil]
  rfl

theorem decDigits_32 : decDigits 32 = bytes "32" := by
  rw [decDigits_ge (by omega), decDigits_lt (by omega)]
  rfl

theorem decDigits_8 : decDigits 8 = bytes "8" := by
  rw [decDigits_lt (by omega)]
  rfl

theorem render_declE_arr (n : List Std.U8) :
    render (declE (n, .arr)) ++ [cNl]
      = bytes "(declare-const " ++ (render (.qsym n)
          ++ bytes " (Array (_ BitVec 32) (_ BitVec 8)))\n") := by
  simp only [declE, arrSortE, sortE, render, renderSp, List.drop_succ_cons, List.drop_zero,
    List.append_assoc, List.cons_append, List.nil_append, List.append_nil, decDigits_32,
    decDigits_8]
  rfl

theorem render_declE_fn (n : List Std.U8) (args : List Nat) (w : Nat) :
    render (declE (n, .fn args w)) ++ [cNl]
      = bytes "(declare-fun " ++ (render (.qsym n) ++ (bytes " (" ++
          ((renderSp (args.map sortE)).drop 1 ++ (bytes ") " ++ (render (sortE w) ++ bytes ")\n")))))
      := by
  simp only [declE, render, renderSp, List.drop_succ_cons, List.drop_zero, List.append_assoc,
    List.cons_append, List.nil_append, List.append_nil]
  rfl

theorem decl_vars_loop_ok (c : EchoIn) (H : Good c) (n : Std.Usize) (hn : n.val = c.nv)
    (out0 out : alloc.vec.Vec Std.U8) (k : Std.Usize)
    (hinv : k.val ≤ c.nv ∧ (∀ j < k.val, 0 < c.vwidth j) ∧
      out.val = out0.val ++ renderScript
        (((List.range k.val).map fun j => (c.vname j, Decl.bv (c.vwidth j))).map declE))
    (r : Bool × alloc.vec.Vec Std.U8)
    (h : kernel.echo_kernel.decl_vars_loop out c.names c.name_start c.name_len c.var_width n k
      = ok r) :
    r.1 = true → (∀ j < c.nv, 0 < c.vwidth j) ∧
      r.2.val = out0.val ++ renderScript (c.varSig.map declE) := by
  unfold kernel.echo_kernel.decl_vars_loop at h
  refine loop_ok (fun (st : alloc.vec.Vec Std.U8 × Std.Usize) => c.nv - st.2.val)
    (fun st => st.2.val ≤ c.nv ∧ (∀ j < st.2.val, 0 < c.vwidth j) ∧
      st.1.val = out0.val ++ renderScript
        (((List.range st.2.val).map fun j => (c.vname j, Decl.bv (c.vwidth j))).map declE))
    (fun (r : Bool × alloc.vec.Vec Std.U8) => r.1 = true → (∀ j < c.nv, 0 < c.vwidth j) ∧
      r.2.val = out0.val ++ renderScript (c.varSig.map declE)) _ ?_ (out, k) hinv r h
  intro st hst r1 hr
  obtain ⟨out1, k1⟩ := st
  obtain ⟨hk, hpos, ho⟩ := hst
  (try dsimp only at hk hpos ho)
  unfold kernel.echo_kernel.decl_vars_loop.body at hr
  (try dsimp only at hr)
  split at hr
  · rename_i hlt
    have hkl : k1.val < c.nv := by
      have : k1.val < n.val := by simpa using hlt
      omega
    obtain ⟨w, hw, hr⟩ := bind_ok_inv hr
    obtain ⟨_, hwv⟩ := slice_index_ok hw
    split at hr
    · cases hr
      refine ⟨fun y hy => ?_, fun x' hx => (nomatch hx)⟩
      cases hy
      intro hc
      cases hc
    · rename_i hw0
      obtain ⟨s, hs, hr⟩ := bind_ok_inv hr
      have hs' := lift_ok hs
      subst hs'
      obtain ⟨o1, ho1, hr⟩ := bind_ok_inv hr
      obtain ⟨st, hst, hr⟩ := bind_ok_inv hr
      obtain ⟨ln, hln, hr⟩ := bind_ok_inv hr
      obtain ⟨o2, ho2, hr⟩ := bind_ok_inv hr
      obtain ⟨o3, ho3, hr⟩ := bind_ok_inv hr
      obtain ⟨o4, ho4, hr⟩ := bind_ok_inv hr
      obtain ⟨s1, hs1, hr⟩ := bind_ok_inv hr
      have hs1' := lift_ok hs1
      subst hs1'
      obtain ⟨o5, ho5, hr⟩ := bind_ok_inv hr
      obtain ⟨k2, hk2, hr⟩ := bind_ok_inv hr
      cases hr
      refine ⟨fun y hy => (nomatch hy), fun x' hx => ?_⟩
      cases hx
      have hk2' : k2.val = k1.val + 1 := by have := uadd_ok hk2; simpa using this
      obtain ⟨_, hstv⟩ := slice_index_ok hst
      obtain ⟨_, hlnv⟩ := slice_index_ok hln
      have hg := H.vgood k1.val hkl
      have hin : st.val + ln.val ≤ c.names.val.length := by
        have := hg.1
        unfold EntryIn at this
        rw [← hstv 0#usize, ← hlnv 0#usize] at this
        exact this
      have hname : nameAt c.names.val st.val ln.val = c.vname k1.val := by
        unfold EchoIn.vname entryName
        rw [← hstv 0#usize, ← hlnv 0#usize]
      have hww : c.vwidth k1.val = w.val := by
        unfold EchoIn.vwidth
        rw [← hwv 0#usize]
      have hwp : 0 < w.val := by
        rcases Nat.eq_zero_or_pos w.val with h0 | hp
        · exact absurd (UScalar.eq_of_val_eq (by simpa using h0)) hw0
        · exact hp
      refine ⟨⟨by (try dsimp only); omega, ?_, ?_⟩, by (try dsimp only); omega⟩
      · (try dsimp only)
        intro j hj
        rw [hk2'] at hj
        rcases Nat.lt_or_ge j k1.val with hlt' | hge'
        · exact hpos j hlt'
        · have : j = k1.val := by omega
          subst this
          rw [hww]
          exact hwp
      · (try dsimp only)
        rw [hk2', List.range_succ, List.map_append, List.map_append, renderScript_append,
          push_word_ok ho5, push_sort_ok ho4, push_ok ho3, push_name_ok ho2 hin, push_word_ok ho1,
          ho, hname]
        simp only [List.map_cons, List.map_nil, renderScript, List.append_nil, hww,
          render_declE_bv, List.append_assoc]
        rfl
  · rename_i hge
    cases hr
    refine ⟨fun y hy => ?_, fun x' hx => (nomatch hx)⟩
    cases hy
    intro _
    have hke : k1.val = c.nv := by
      have : ¬ k1.val < n.val := by simpa using hge
      omega
    refine ⟨fun j hj => hpos j (by omega), ?_⟩
    rw [ho, hke]
    rfl

