theorem renderSp_ne_nil (x : SExp) (xs : List SExp) : renderSp (x :: xs) ≠ [] := by
  simp [renderSp]

theorem drop_one_append {α : Type} (X Y : List α) (hX : X ≠ []) :
    (X ++ Y).drop 1 = X.drop 1 ++ Y := by
  cases X with
  | nil => exact absurd rfl hX
  | cons x X => simp

/-- The widths of the `n` argument nodes from `side[s]`. -/
def argWidths (c : EchoIn) (s n : Nat) : List Nat :=
  (List.range n).map fun j => (extWidths c.nodes.val).getD (c.sideAt (s + j)) 0

theorem push_arg_sorts_loop_ok (c : EchoIn) (H : Good c) (s n : Std.Usize)
    (out0 out : alloc.vec.Vec Std.U8) (j : Std.Usize)
    (hinv : j.val ≤ n.val ∧ (∀ a ∈ argWidths c s.val j.val, 0 < a) ∧
      out.val = out0.val ++ (renderSp ((argWidths c s.val j.val).map sortE)).drop 1)
    (r : Bool × alloc.vec.Vec Std.U8)
    (h : kernel.echo_kernel.push_arg_sorts_loop out c.ws c.side s n j = ok r) :
    r.1 = true → (∀ a ∈ argWidths c s.val n.val, 0 < a) ∧
      r.2.val = out0.val ++ (renderSp ((argWidths c s.val n.val).map sortE)).drop 1 := by
  unfold kernel.echo_kernel.push_arg_sorts_loop at h
  refine loop_ok (fun (st : alloc.vec.Vec Std.U8 × Std.Usize) => n.val - st.2.val)
    (fun st => st.2.val ≤ n.val ∧ (∀ a ∈ argWidths c s.val st.2.val, 0 < a) ∧
      st.1.val = out0.val ++ (renderSp ((argWidths c s.val st.2.val).map sortE)).drop 1)
    (fun (r : Bool × alloc.vec.Vec Std.U8) => r.1 = true →
      (∀ a ∈ argWidths c s.val n.val, 0 < a) ∧
      r.2.val = out0.val ++ (renderSp ((argWidths c s.val n.val).map sortE)).drop 1)
    _ ?_ (out, j) hinv r h
  intro st hst r1 hr
  obtain ⟨out1, j1⟩ := st
  obtain ⟨hj, hpos, ho⟩ := hst
  (try dsimp only at hj hpos ho)
  unfold kernel.echo_kernel.push_arg_sorts_loop.body at hr
  (try dsimp only at hr)
  split at hr
  · rename_i hlt
    have hjl : j1.val < n.val := by simpa using hlt
    obtain ⟨i, hi, hr⟩ := bind_ok_inv hr
    obtain ⟨x, hx, hr⟩ := bind_ok_inv hr
    obtain ⟨w, hw, hr⟩ := bind_ok_inv hr
    obtain ⟨_, hxv⟩ := slice_index_ok hx
    have hwv : w.val = (extWidths c.nodes.val).getD (c.sideAt (s.val + j1.val)) 0 := by
      rw [width_at_ok hw, H.ws]
      unfold EchoIn.sideAt
      rw [hxv 0#usize, uadd_ok hi]
    split at hr
    · cases hr
      refine ⟨fun y hy => ?_, fun x' hx' => (nomatch hx')⟩
      cases hy
      intro hc
      cases hc
    · rename_i hw0
      obtain ⟨o1, ho1, hr⟩ := bind_ok_inv hr
      obtain ⟨o2, ho2, hr⟩ := bind_ok_inv hr
      obtain ⟨j2, hj2, hr⟩ := bind_ok_inv hr
      cases hr
      refine ⟨fun y hy => (nomatch hy), fun x' hx' => ?_⟩
      cases hx'
      have hj2' : j2.val = j1.val + 1 := by have := uadd_ok hj2; simpa using this
      have hwp : 0 < w.val := by
        rcases Nat.eq_zero_or_pos w.val with h0 | hp
        · exact absurd (UScalar.eq_of_val_eq (by simpa using h0)) hw0
        · exact hp
      have hstep : argWidths c s.val (j1.val + 1) = argWidths c s.val j1.val ++ [w.val] := by
        unfold argWidths
        rw [List.range_succ, List.map_append, List.map_cons, List.map_nil, hwv]
      refine ⟨⟨by (try dsimp only); omega, ?_, ?_⟩, by (try dsimp only); omega⟩
      · (try dsimp only)
        rw [hj2', hstep]
        intro a ha
        rcases List.mem_append.mp ha with ha | ha
        · exact hpos a ha
        · simp only [List.mem_singleton] at ha
          rw [ha]
          exact hwp
      · (try dsimp only)
        rw [hj2', hstep, List.map_append, renderSp_append, push_sort_ok ho2]
        split at ho1
        · rename_i hj0
          have hjp : 0 < j1.val := by simpa using hj0
          have hne : renderSp ((argWidths c s.val j1.val).map sortE) ≠ [] := by
            unfold argWidths
            obtain ⟨m, hm⟩ : ∃ m, j1.val = m + 1 := ⟨j1.val - 1, by omega⟩
            rw [hm, List.range_succ_eq_map]
            simp [renderSp]
          rw [drop_one_append _ _ hne, push_ok ho1, ho]
          simp only [List.map_cons, List.map_nil, renderSp, List.append_assoc, List.cons_append,
            List.nil_append, List.append_nil]
          rfl
        · rename_i hj0
          have hj0' : j1.val = 0 := by
            have : ¬ 0 < j1.val := by simpa using hj0
            omega
          cases ho1
          rw [ho]
          simp [argWidths, hj0', renderSp]
  · rename_i hge
    cases hr
    refine ⟨fun y hy => ?_, fun x' hx => (nomatch hx)⟩
    cases hy
    intro _
    have hje : j1.val = n.val := by
      have : ¬ j1.val < n.val := by simpa using hge
      omega
    rw [← hje]
    exact ⟨hpos, ho⟩

theorem push_arg_sorts_ok (c : EchoIn) (H : Good c) {s n : Std.Usize}
    {out out' : alloc.vec.Vec Std.U8}
    (h : kernel.echo_kernel.push_arg_sorts out c.ws c.side s n = ok (true, out')) :
    (∀ a ∈ argWidths c s.val n.val, 0 < a) ∧
