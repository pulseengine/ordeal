      s.2.val ≤ a.val.length ∧
      s.1.val = out.val ++ a.val.take s.2.val)
  · rintro ⟨out1, i⟩ ⟨hle, hval⟩
    dsimp only at hle hval
    unfold blast_rotr_loop0.body
    dsimp only
    split
    · rename_i hlt
      have hilt : i.val < a.val.length := by scalar_tac
      step as ⟨l, hl⟩
      have hocap : out1.val.length < Usize.max := by
        rw [hval]
        simp only [List.length_append, List.length_take]
        omega
      step as ⟨out2, hout2⟩
      step as ⟨i1, hi1⟩
      refine ⟨by scalar_tac, ?_, by scalar_tac⟩
      rw [hi1, hout2, hval, hl, List.take_add_one,
        List.getElem?_eq_getElem hilt]
      simp
    · rename_i hge
      have hieq : i.val = a.val.length := by scalar_tac
      have hfin : out1.val = out.val ++ a.val := by
        rw [hval, hieq, List.take_of_length_le (by simp)]
      exact hfin
  · exact ⟨Nat.zero_le _, by simp⟩

/- ══════════════════ THE STAGE FOLDS (BARREL INVARIANT) ══════════════════ -/

/-- **The right-shift barrel invariant** (`barrel_right` stage fold): after
    all `stages` rounds, bit `j` of the current word equals bit
    `j + pAmt … stages` of the ORIGINAL word — the fill once past the
    end. Gate count: 3 gates per bit per round. -/
theorem barrel_right_loop1_spec (aig : Aig) (a b : Slice Lit)
    (stages : Std.Usize) (fill : Lit) (cur : alloc.vec.Vec Lit)
    (hcur : cur.val = a.val)
    (hstages : stages.val ≤ b.val.length)
    (hpow : 2 ^ stages.val = a.val.length)
    (hcap : aig.nodes.val.length + 3 * a.val.length * stages.val ≤ Usize.max)
    (ha : ∀ l ∈ a.val, l.node.val < aig.nodes.val.length)
    (hb : ∀ l ∈ b.val, l.node.val < aig.nodes.val.length)
    (hfill : fill.node.val < aig.nodes.val.length) :
    barrel_right_loop1 aig b stages fill cur 0#usize ⦃ q =>
      q.1.nodes.val.length
        = aig.nodes.val.length + 3 * a.val.length * stages.val ∧
      aig.nodes.val <+: q.1.nodes.val ∧
      (∀ L, AigWF aig.nodes.val L → AigWF q.1.nodes.val L) ∧
      q.2.val.length = a.val.length ∧
      (∀ l ∈ q.2.val, l.node.val < q.1.nodes.val.length) ∧
      ∀ (inp : List Bool) (j : Nat) (hj : j < q.2.val.length),
        pEvalLit (pSim inp q.1.nodes.val) q.2.val[j]
          = if j + pAmt (pSim inp aig.nodes.val) b.val stages.val
              < a.val.length
            then pEvalLit (pSim inp aig.nodes.val)
              (a.val.getD
                (j + pAmt (pSim inp aig.nodes.val) b.val stages.val) dLit)
            else pEvalLit (pSim inp aig.nodes.val) fill ⦄ := by
  unfold barrel_right_loop1
  apply loop.spec_decr_nat
    (measure := fun (st : Aig × alloc.vec.Vec Lit × Std.Usize) =>
      stages.val - st.2.2.val)
    (inv := fun (st : Aig × alloc.vec.Vec Lit × Std.Usize) =>
      st.2.2.val ≤ stages.val ∧
      st.1.nodes.val.length
        = aig.nodes.val.length + 3 * a.val.length * st.2.2.val ∧
      aig.nodes.val <+: st.1.nodes.val ∧
      (∀ L, AigWF aig.nodes.val L → AigWF st.1.nodes.val L) ∧
      st.2.1.val.length = a.val.length ∧
      (∀ l ∈ st.2.1.val, l.node.val < st.1.nodes.val.length) ∧
      ∀ (inp : List Bool) (j : Nat) (hj : j < st.2.1.val.length),
        pEvalLit (pSim inp st.1.nodes.val) st.2.1.val[j]
          = if j + pAmt (pSim inp aig.nodes.val) b.val st.2.2.val
              < a.val.length
            then pEvalLit (pSim inp aig.nodes.val)
              (a.val.getD
                (j + pAmt (pSim inp aig.nodes.val) b.val st.2.2.val) dLit)
            else pEvalLit (pSim inp aig.nodes.val) fill)
  · rintro ⟨aig1, cur1, k⟩ hinv
    obtain ⟨hkle, hlen1, hpre1, hwf1, hclen, hcrng, hsem⟩ := hinv
    dsimp only at hkle hlen1 hpre1 hwf1 hclen hcrng hsem
    unfold barrel_right_loop1.body
    dsimp only
    split
    · rename_i hklt
      have hks : k.val < stages.val := by scalar_tac
      have hwle : 2 ^ stages.val ≤ Usize.max := by
        have := a.length_ineq
        omega
      have hkb : k.val < System.Platform.numBits := by
        have := lt_numBits_of_pow_le hwle
        omega
      step with (Usize.ShiftLeft_spec 1#usize k hkb) as ⟨s, hs, _⟩
      have hsval : s.val = 2 ^ k.val := by
        rw [hs]
        exact shl_one_val hkb
      have hderef : (alloc.vec.Vec.deref cur1).val = cur1.val := rfl
      have hbk : k.val < b.val.length := by omega
      step as ⟨selk, hselk⟩
      -- capacity for one stage
      have hstepc : 3 * a.val.length * (k.val + 1)
          = 3 * a.val.length * k.val + 3 * a.val.length := Nat.mul_succ _ _
      have hmul1 : 3 * a.val.length * (k.val + 1)
          ≤ 3 * a.val.length * stages.val :=
        Nat.mul_le_mul_left _ (by omega)
      have hcap1 : aig1.nodes.val.length
          + 3 * (alloc.vec.Vec.deref cur1).val.length ≤ Usize.max := by
        rw [hderef, hclen]
        omega
      -- the shift distance fits: 2^(k+1) ≤ 2^stages = |a|
      have hpowk : 2 ^ (k.val + 1) ≤ 2 ^ stages.val :=
        Nat.pow_le_pow_right (by omega) (by omega)
      have h2s : 2 ^ (k.val + 1) = 2 ^ k.val + 2 ^ k.val := by
        rw [Nat.pow_succ]; omega
      have hmul2 : 3 * a.val.length * 1 ≤ 3 * a.val.length * stages.val :=
        Nat.mul_le_mul_left _ (by omega)
      have hadd1 : (alloc.vec.Vec.deref cur1).val.length + s.val
          ≤ Usize.max := by
        rw [hderef, hclen, hsval]
        omega
      have hcur1 : ∀ l ∈ (alloc.vec.Vec.deref cur1).val,
          l.node.val < aig1.nodes.val.length := by
        rw [hderef]
        exact hcrng
      have hsel1 : selk.node.val < aig1.nodes.val.length := by
        have h1 := hb selk (by rw [hselk]; exact List.getElem_mem _)
        have := hpre1.length_le
        omega
      have hfill1 : fill.node.val < aig1.nodes.val.length := by
        have := hpre1.length_le
        omega
      step with (barrel_right_stage_spec aig1 (alloc.vec.Vec.deref cur1)
        selk s fill hcap1 hadd1 hcur1 hsel1 hfill1) as
        ⟨cur2, aig2, hs1, hs2, hs3, hs4, hs5, hs6⟩
      step as ⟨k1, hk1⟩
      simp only [hderef] at hs1 hs3 hs6
      refine ⟨by scalar_tac, ?_, hpre1.trans hs2,
        fun L hL => hs4 L (hwf1 L hL), by omega, hs5, ?_, by scalar_tac⟩
      · rw [hk1, hstepc]
        omega
      · intro inp j hj
        have hja : j < a.val.length := by omega
        have hjc : j < cur1.val.length := by omega
        rw [hs6 inp j hj, hk1]
        have hselval : pEvalLit (pSim inp aig1.nodes.val) selk
            = pEvalLit (pSim inp aig.nodes.val) (b.val[k.val]'hbk) := by
          rw [hselk]
          exact pEvalLit_stable hpre1 _ (hb _ (List.getElem_mem hbk)) inp
        have hfillval : pEvalLit (pSim inp aig1.nodes.val) fill
            = pEvalLit (pSim inp aig.nodes.val) fill :=
          pEvalLit_stable hpre1 fill hfill inp
        simp only [pAmt, getD_eq_getElem_of_lt hbk, hselval, hfillval,
          hsval, hclen]
        cases hbit : pEvalLit (pSim inp aig.nodes.val) (b.val[k.val]'hbk)
        · simp only [Bool.false_eq_true, if_false, Nat.add_zero]
          rw [getD_eq_getElem_of_lt hjc, hsem inp j hjc]
        · simp only [if_true]
          by_cases hjs : j + 2 ^ k.val < a.val.length
          · rw [if_pos hjs, getD_eq_getElem_of_lt (by omega),
              hsem inp _ (by omega)]
            have hidx : j + 2 ^ k.val
                  + pAmt (pSim inp aig.nodes.val) b.val k.val
                = j + (pAmt (pSim inp aig.nodes.val) b.val k.val
                  + 2 ^ k.val) := by omega
            rw [hidx]
          · rw [if_neg hjs, if_neg (by omega)]
    · rename_i hge
      have hkeq : k.val = stages.val := by scalar_tac
      rw [hkeq] at hlen1 hsem
      exact ⟨hlen1, hpre1, hwf1, hclen, hcrng, hsem⟩
  · refine ⟨by scalar_tac, by simp, List.prefix_refl _, fun _ h => h,
      by rw [hcur], ?_, ?_⟩
    · rw [hcur]
      exact ha
    · intro inp j hj
      rw [hcur] at hj
      have h00 : (0#usize).val = 0 := by scalar_tac
      simp only [hcur, h00, pAmt, Nat.add_zero]
      rw [if_pos (by scalar_tac), getD_eq_getElem_of_lt (by scalar_tac)]

/-- **The left-shift barrel invariant** (`blast_shl` stage fold): after all
    `stages` rounds, bit `j` of the current word equals bit
    `j - pAmt … stages` of the ORIGINAL word — FALSE below the amount. -/
theorem blast_shl_loop1_spec (aig : Aig) (a b : Slice Lit)
    (stages : Std.Usize) (cur : alloc.vec.Vec Lit)
    (hcur : cur.val = a.val)
    (hstages : stages.val ≤ b.val.length)
    (hpow : 2 ^ stages.val = a.val.length)
    (hcap : aig.nodes.val.length + 3 * a.val.length * stages.val ≤ Usize.max)
    (ha : ∀ l ∈ a.val, l.node.val < aig.nodes.val.length)
    (hb : ∀ l ∈ b.val, l.node.val < aig.nodes.val.length)
    (hne : 0 < aig.nodes.val.length)
    (h0 : aig.nodes.val[0]'hne = Node.False) :
    blast_shl_loop1 aig b stages cur 0#usize ⦃ q =>
      q.1.nodes.val.length
        = aig.nodes.val.length + 3 * a.val.length * stages.val ∧
      aig.nodes.val <+: q.1.nodes.val ∧
      (∀ L, AigWF aig.nodes.val L → AigWF q.1.nodes.val L) ∧
      q.2.val.length = a.val.length ∧
      (∀ l ∈ q.2.val, l.node.val < q.1.nodes.val.length) ∧
      ∀ (inp : List Bool) (j : Nat) (hj : j < q.2.val.length),
        pEvalLit (pSim inp q.1.nodes.val) q.2.val[j]
          = if pAmt (pSim inp aig.nodes.val) b.val stages.val ≤ j
            then pEvalLit (pSim inp aig.nodes.val)
              (a.val.getD
                (j - pAmt (pSim inp aig.nodes.val) b.val stages.val) dLit)
            else false ⦄ := by
  unfold blast_shl_loop1
  apply loop.spec_decr_nat
    (measure := fun (st : Aig × alloc.vec.Vec Lit × Std.Usize) =>
      stages.val - st.2.2.val)
    (inv := fun (st : Aig × alloc.vec.Vec Lit × Std.Usize) =>
      st.2.2.val ≤ stages.val ∧
      st.1.nodes.val.length
        = aig.nodes.val.length + 3 * a.val.length * st.2.2.val ∧
      aig.nodes.val <+: st.1.nodes.val ∧
      (∀ L, AigWF aig.nodes.val L → AigWF st.1.nodes.val L) ∧
      st.2.1.val.length = a.val.length ∧
      (∀ l ∈ st.2.1.val, l.node.val < st.1.nodes.val.length) ∧
      ∀ (inp : List Bool) (j : Nat) (hj : j < st.2.1.val.length),
        pEvalLit (pSim inp st.1.nodes.val) st.2.1.val[j]
          = if pAmt (pSim inp aig.nodes.val) b.val st.2.2.val ≤ j
            then pEvalLit (pSim inp aig.nodes.val)
              (a.val.getD
                (j - pAmt (pSim inp aig.nodes.val) b.val st.2.2.val) dLit)
            else false)
  · rintro ⟨aig1, cur1, k⟩ hinv
    obtain ⟨hkle, hlen1, hpre1, hwf1, hclen, hcrng, hsem⟩ := hinv
    dsimp only at hkle hlen1 hpre1 hwf1 hclen hcrng hsem
    unfold blast_shl_loop1.body
    dsimp only
    split
    · rename_i hklt
      have hks : k.val < stages.val := by scalar_tac
      have hwle : 2 ^ stages.val ≤ Usize.max := by
        have := a.length_ineq
        omega
      have hkb : k.val < System.Platform.numBits := by
        have := lt_numBits_of_pow_le hwle
        omega
      step with (Usize.ShiftLeft_spec 1#usize k hkb) as ⟨s, hs, _⟩
      have hsval : s.val = 2 ^ k.val := by
        rw [hs]
        exact shl_one_val hkb
      have hderef : (alloc.vec.Vec.deref cur1).val = cur1.val := rfl
      have hbk : k.val < b.val.length := by omega
      step as ⟨selk, hselk⟩
      have hstepc : 3 * a.val.length * (k.val + 1)
          = 3 * a.val.length * k.val + 3 * a.val.length := Nat.mul_succ _ _
      have hmul1 : 3 * a.val.length * (k.val + 1)
          ≤ 3 * a.val.length * stages.val :=
        Nat.mul_le_mul_left _ (by omega)
      have hcap1 : aig1.nodes.val.length
          + 3 * (alloc.vec.Vec.deref cur1).val.length ≤ Usize.max := by
        rw [hderef, hclen]
        omega
      have hcur1 : ∀ l ∈ (alloc.vec.Vec.deref cur1).val,
          l.node.val < aig1.nodes.val.length := by
        rw [hderef]
        exact hcrng
      have hsel1 : selk.node.val < aig1.nodes.val.length := by
        have h1 := hb selk (by rw [hselk]; exact List.getElem_mem _)
        have := hpre1.length_le
        omega
      have hne1 : 0 < aig1.nodes.val.length := by
        have := hpre1.length_le
        omega
      have h01 : aig1.nodes.val[0]'hne1 = Node.False :=
        node0_of_prefix hpre1 hne h0 hne1
      step with (barrel_left_stage_spec aig1 (alloc.vec.Vec.deref cur1)
        selk s hcap1 hcur1 hsel1 hne1 h01) as
        ⟨cur2, aig2, hs1, hs2, hs3, hs4, hs5, hs6⟩
      step as ⟨k1, hk1⟩
      simp only [hderef] at hs1 hs3 hs6
      refine ⟨by scalar_tac, ?_, hpre1.trans hs2,
        fun L hL => hs4 L (hwf1 L hL), by omega, hs5, ?_, by scalar_tac⟩
      · rw [hk1, hstepc]
        omega
      · intro inp j hj
        have hja : j < a.val.length := by omega
        have hjc : j < cur1.val.length := by omega
        rw [hs6 inp j hj, hk1]
        have hselval : pEvalLit (pSim inp aig1.nodes.val) selk
            = pEvalLit (pSim inp aig.nodes.val) (b.val[k.val]'hbk) := by
          rw [hselk]
          exact pEvalLit_stable hpre1 _ (hb _ (List.getElem_mem hbk)) inp
        simp only [pAmt, getD_eq_getElem_of_lt hbk, hselval, hsval]
        cases hbit : pEvalLit (pSim inp aig.nodes.val) (b.val[k.val]'hbk)
        · simp only [Bool.false_eq_true, if_false, Nat.add_zero]
          rw [getD_eq_getElem_of_lt hjc, hsem inp j hjc]
        · simp only [if_true]
          by_cases hjs : 2 ^ k.val ≤ j
          · have hsub : j - 2 ^ k.val < cur1.val.length := by omega
            rw [if_pos hjs, getD_eq_getElem_of_lt hsub,
              hsem inp _ hsub]
            by_cases hn : pAmt (pSim inp aig.nodes.val) b.val k.val
                ≤ j - 2 ^ k.val
            · rw [if_pos hn, if_pos (by omega)]
              have hidx : j - 2 ^ k.val
                    - pAmt (pSim inp aig.nodes.val) b.val k.val
