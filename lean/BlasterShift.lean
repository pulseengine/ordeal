        rw [hderef]
        exact hcrng
      have hsel1 : selk.node.val < aig1.nodes.val.length := by
        have h1 := hb selk (by rw [hselk]; exact List.getElem_mem _)
        have := hpre1.length_le
        omega
      step with (rotr_stage_spec aig1 (alloc.vec.Vec.deref cur1)
        selk s hcap1 hadd1 hcur1 hsel1) as
        ⟨cur2, aig2, hs1, hs2, hs3, hs4, hs5, hs6⟩
      step as ⟨k1, hk1⟩
      simp only [hderef] at hs1 hs3 hs6
      refine ⟨by scalar_tac, ?_, hpre1.trans hs2,
        fun L hL => hs4 L (hwf1 L hL), by omega, hs5, ?_, by scalar_tac⟩
      · rw [hk1, hstepc]
        omega
      · intro inp j hj
        have hja : j < a.val.length := by omega
        have hjc : j < cur1.val.length := by omega
        rw [hs6 inp j hj, hk1]
        have hselval : pEvalLit (pSim inp aig1.nodes.val) selk
            = pEvalLit (pSim inp aig.nodes.val) (b.val[k.val]'hbk) := by
          rw [hselk]
          exact pEvalLit_stable hpre1 _ (hb _ (List.getElem_mem hbk)) inp
        simp only [pAmt, getD_eq_getElem_of_lt hbk, hselval, hsval, hclen]
        cases hbit : pEvalLit (pSim inp aig.nodes.val) (b.val[k.val]'hbk)
        · simp only [Bool.false_eq_true, if_false, Nat.add_zero]
          rw [getD_eq_getElem_of_lt hjc, hsem inp j hjc]
        · simp only [if_true]
          have hmlt : (j + 2 ^ k.val) % a.val.length < cur1.val.length := by
            have := Nat.mod_lt (j + 2 ^ k.val) haw
            omega
          rw [getD_eq_getElem_of_lt hmlt, hsem inp _ hmlt]
          have hmm : ((j + 2 ^ k.val) % a.val.length
                + pAmt (pSim inp aig.nodes.val) b.val k.val) % a.val.length
              = (j + (pAmt (pSim inp aig.nodes.val) b.val k.val
                + 2 ^ k.val)) % a.val.length := by
            rw [Nat.mod_add_mod]
            congr 1
            omega
          rw [hmm]
    · rename_i hge
      have hkeq : k.val = stages.val := by scalar_tac
      rw [hkeq] at hlen1 hsem
      exact ⟨hlen1, hpre1, hwf1, hclen, hcrng, hsem⟩
  · refine ⟨by scalar_tac, by simp, List.prefix_refl _, fun _ h => h,
      by rw [hcur], ?_, ?_⟩
    · rw [hcur]
      exact ha
    · intro inp j hj
      rw [hcur] at hj
      have h00 : (0#usize).val = 0 := by scalar_tac
      simp only [hcur, h00, pAmt, Nat.add_zero]
      rw [Nat.mod_eq_of_lt (by scalar_tac),
        getD_eq_getElem_of_lt (by scalar_tac)]

/- ══════════════════ THE FINAL FILL MUXES ══════════════════ -/

/-- Final `barrel_right` loop: muxes the fill over every bit, gated on the
    out-of-range literal (3 gates per bit). -/
theorem barrel_right_loop2_spec (aig : Aig) (fill : Lit)
    (cur : alloc.vec.Vec Lit) (w : Std.Usize) (oor : Lit)
    (hw : w.val = cur.val.length)
    (hcap : aig.nodes.val.length + 3 * cur.val.length ≤ Usize.max)
    (hcur : ∀ l ∈ cur.val, l.node.val < aig.nodes.val.length)
    (hoor : oor.node.val < aig.nodes.val.length)
    (hfill : fill.node.val < aig.nodes.val.length) :
    barrel_right_loop2 aig fill cur w oor (alloc.vec.Vec.new Lit) 0#usize ⦃ p =>
      p.1.val.length = cur.val.length ∧
      aig.nodes.val <+: p.2.nodes.val ∧
      p.2.nodes.val.length = aig.nodes.val.length + 3 * cur.val.length ∧
      (∀ L, AigWF aig.nodes.val L → AigWF p.2.nodes.val L) ∧
      (∀ l ∈ p.1.val, l.node.val < p.2.nodes.val.length) ∧
      ∀ (inp : List Bool) (j : Nat) (hj : j < p.1.val.length),
        pEvalLit (pSim inp p.2.nodes.val) p.1.val[j]
          = if pEvalLit (pSim inp aig.nodes.val) oor
            then pEvalLit (pSim inp aig.nodes.val) fill
            else pEvalLit (pSim inp aig.nodes.val)
              (cur.val.getD j dLit) ⦄ := by
  unfold barrel_right_loop2
  apply loop.spec_decr_nat
    (measure := fun (st : Aig × alloc.vec.Vec Lit × Std.Usize) =>
      cur.val.length - st.2.2.val)
    (inv := fun (st : Aig × alloc.vec.Vec Lit × Std.Usize) =>
      MuxMapInv aig cur.val.length
        (fun inp j =>
          if pEvalLit (pSim inp aig.nodes.val) oor
          then pEvalLit (pSim inp aig.nodes.val) fill
          else pEvalLit (pSim inp aig.nodes.val) (cur.val.getD j dLit))
        st.1 st.2.1 st.2.2.val)
  · rintro ⟨aig1, out1, j⟩ hinv
    obtain ⟨hile, hlen1, hpre1, hwf1, holen, horng, hsem⟩ := hinv
    dsimp only at hile hlen1 hpre1 hwf1 holen horng hsem
    unfold barrel_right_loop2.body
    dsimp only
    split
    · rename_i hlt
      have hjlt : j.val < cur.val.length := by scalar_tac
      step as ⟨l, hl⟩
      have hoor1 : oor.node.val < aig1.nodes.val.length := by
        have := hpre1.length_le
        omega
      have hfill1 : fill.node.val < aig1.nodes.val.length := by
        have := hpre1.length_le
        omega
      have hl1 : l.node.val < aig1.nodes.val.length := by
        have h1 := hcur l (by rw [hl]; exact List.getElem_mem _)
        have := hpre1.length_le
        omega
      have hcap1 : aig1.nodes.val.length + 3 ≤ Usize.max := by omega
      step with (push_mux_gadget aig1 oor fill l hcap1 hoor1 hfill1 hl1)
        as ⟨m, aig2, hm1, hm2, hm3, hm4, hm5⟩
      have hocap : out1.val.length < Usize.max := by
        have := cur.len_ineq
        omega
      step as ⟨out2, hout2⟩
      step as ⟨j1, hj1⟩
      refine ⟨?_, by scalar_tac⟩
      rw [hj1]
      apply MuxMapInv.step ⟨hile, hlen1, hpre1, hwf1, holen, horng, hsem⟩
        hjlt hm1 hm2 hm3 hm4 ?_ hout2
      intro inp
      rw [hm5 inp, pEvalLit_stable hpre1 oor hoor inp,
        pEvalLit_stable hpre1 fill hfill inp, hl,
        pEvalLit_stable hpre1 _ (hcur _ (List.getElem_mem hjlt)) inp,
        getD_eq_getElem_of_lt hjlt]
    · rename_i hge
      have hjeq : j.val = cur.val.length := by scalar_tac
      refine ⟨by dsimp only; omega, hpre1, by dsimp only; omega, hwf1,
        horng, ?_⟩
      intro inp j' hj'
      exact hsem inp j' hj'
  · exact MuxMapInv.init aig cur.val.length _

/-- Final `blast_shl` loop: muxes the FALSE fill over every bit, gated on
    the out-of-range literal (3 gates per bit). -/
theorem blast_shl_loop2_spec (aig : Aig) (cur : alloc.vec.Vec Lit)
    (w : Std.Usize) (oor : Lit) (f : Lit)
    (hw : w.val = cur.val.length)
    (hcap : aig.nodes.val.length + 3 * cur.val.length ≤ Usize.max)
    (hcur : ∀ l ∈ cur.val, l.node.val < aig.nodes.val.length)
    (hoor : oor.node.val < aig.nodes.val.length)
    (hf : f.node.val < aig.nodes.val.length) :
    blast_shl_loop2 aig cur w oor f (alloc.vec.Vec.new Lit) 0#usize ⦃ p =>
      p.1.val.length = cur.val.length ∧
      aig.nodes.val <+: p.2.nodes.val ∧
      p.2.nodes.val.length = aig.nodes.val.length + 3 * cur.val.length ∧
      (∀ L, AigWF aig.nodes.val L → AigWF p.2.nodes.val L) ∧
      (∀ l ∈ p.1.val, l.node.val < p.2.nodes.val.length) ∧
      ∀ (inp : List Bool) (j : Nat) (hj : j < p.1.val.length),
        pEvalLit (pSim inp p.2.nodes.val) p.1.val[j]
          = if pEvalLit (pSim inp aig.nodes.val) oor
            then pEvalLit (pSim inp aig.nodes.val) f
            else pEvalLit (pSim inp aig.nodes.val)
              (cur.val.getD j dLit) ⦄ := by
  unfold blast_shl_loop2
  apply loop.spec_decr_nat
    (measure := fun (st : Aig × alloc.vec.Vec Lit × Std.Usize) =>
      cur.val.length - st.2.2.val)
    (inv := fun (st : Aig × alloc.vec.Vec Lit × Std.Usize) =>
      MuxMapInv aig cur.val.length
        (fun inp j =>
          if pEvalLit (pSim inp aig.nodes.val) oor
          then pEvalLit (pSim inp aig.nodes.val) f
          else pEvalLit (pSim inp aig.nodes.val) (cur.val.getD j dLit))
        st.1 st.2.1 st.2.2.val)
  · rintro ⟨aig1, out1, j⟩ hinv
    obtain ⟨hile, hlen1, hpre1, hwf1, holen, horng, hsem⟩ := hinv
    dsimp only at hile hlen1 hpre1 hwf1 holen horng hsem
    unfold blast_shl_loop2.body
    dsimp only
    split
    · rename_i hlt
      have hjlt : j.val < cur.val.length := by scalar_tac
      step as ⟨l, hl⟩
      have hoor1 : oor.node.val < aig1.nodes.val.length := by
        have := hpre1.length_le
        omega
      have hf1 : f.node.val < aig1.nodes.val.length := by
        have := hpre1.length_le
        omega
      have hl1 : l.node.val < aig1.nodes.val.length := by
        have h1 := hcur l (by rw [hl]; exact List.getElem_mem _)
        have := hpre1.length_le
        omega
      have hcap1 : aig1.nodes.val.length + 3 ≤ Usize.max := by omega
      step with (push_mux_gadget aig1 oor f l hcap1 hoor1 hf1 hl1)
        as ⟨m, aig2, hm1, hm2, hm3, hm4, hm5⟩
      have hocap : out1.val.length < Usize.max := by
        have := cur.len_ineq
        omega
      step as ⟨out2, hout2⟩
      step as ⟨j1, hj1⟩
      refine ⟨?_, by scalar_tac⟩
      rw [hj1]
      apply MuxMapInv.step ⟨hile, hlen1, hpre1, hwf1, holen, horng, hsem⟩
        hjlt hm1 hm2 hm3 hm4 ?_ hout2
      intro inp
      rw [hm5 inp, pEvalLit_stable hpre1 oor hoor inp,
        pEvalLit_stable hpre1 f hf inp, hl,
        pEvalLit_stable hpre1 _ (hcur _ (List.getElem_mem hjlt)) inp,
        getD_eq_getElem_of_lt hjlt]
    · rename_i hge
      have hjeq : j.val = cur.val.length := by scalar_tac
      refine ⟨by dsimp only; omega, hpre1, by dsimp only; omega, hwf1,
        horng, ?_⟩
      intro inp j' hj'
      exact hsem inp j' hj'
  · exact MuxMapInv.init aig cur.val.length _

/- ══════════════════ COMPOSITION: `barrel_right` ══════════════════ -/

/-- Transporting `Denotes` back along append-monotonicity: a word denoting
    `V` under the EXTENDED aig's simulation also denotes `V` under the
    original aig's simulation (all its literals are pre-existing). -/
theorem Denotes.of_prefix {ns ns' : List Node} (hpre : ns <+: ns')
    {word : List Lit} {w : Nat} {V : BitVec w}
    (hrng : ∀ l ∈ word, l.node.val < ns.length) (inp : List Bool)
    (h : Denotes (pSim inp ns') word w V) :
    Denotes (pSim inp ns) word w V := by
  obtain ⟨hlen, hj⟩ := h
  refine ⟨hlen, fun j hjl => ?_⟩
  rw [← pEvalLit_stable hpre _ (hrng _ (List.getElem_mem _)) inp]
  exact hj j hjl

/-- **Spec of `barrel_right`** (the shared right-shift skeleton,
    parameterized by the fill literal): gate count
    `3·w·stages + (|b| - stages) + 3·w`; output bit `j` is the fill if the
    amount is out of range, else bit `j + pAmt … stages` of the input word
    (the fill past the end), everything under the ORIGINAL aig. -/
theorem barrel_right_spec (aig : Aig) (a b : Slice Lit) (stages : Std.Usize)
    (fill : Lit)
    (hstages : stages.val ≤ b.val.length)
    (hpow : 2 ^ stages.val = a.val.length)
    (hcap : aig.nodes.val.length + (3 * a.val.length * stages.val
      + (b.val.length - stages.val) + 3 * a.val.length) ≤ Usize.max)
    (ha : ∀ l ∈ a.val, l.node.val < aig.nodes.val.length)
    (hb : ∀ l ∈ b.val, l.node.val < aig.nodes.val.length)
    (hfill : fill.node.val < aig.nodes.val.length)
    (hne : 0 < aig.nodes.val.length)
    (h0 : aig.nodes.val[0]'hne = Node.False) :
    barrel_right aig a b stages fill ⦃ p =>
      p.1.val.length = a.val.length ∧
      aig.nodes.val <+: p.2.nodes.val ∧
      p.2.nodes.val.length = aig.nodes.val.length
        + (3 * a.val.length * stages.val + (b.val.length - stages.val)
          + 3 * a.val.length) ∧
      (∀ L, AigWF aig.nodes.val L → AigWF p.2.nodes.val L) ∧
      (∀ l ∈ p.1.val, l.node.val < p.2.nodes.val.length) ∧
      ∀ (inp : List Bool) (j : Nat) (hj : j < p.1.val.length),
        pEvalLit (pSim inp p.2.nodes.val) p.1.val[j]
          = if pHigh (pSim inp aig.nodes.val) b.val stages.val b.val.length
            then pEvalLit (pSim inp aig.nodes.val) fill
            else if j + pAmt (pSim inp aig.nodes.val) b.val stages.val
                < a.val.length
              then pEvalLit (pSim inp aig.nodes.val)
                (a.val.getD
                  (j + pAmt (pSim inp aig.nodes.val) b.val stages.val) dLit)
              else pEvalLit (pSim inp aig.nodes.val) fill ⦄ := by
  unfold barrel_right
  step with (barrel_right_loop0_spec a (alloc.vec.Vec.new Lit)
    (Slice.len a) (by scalar_tac) (by simp; scalar_tac)) as ⟨cur, hcurv⟩
  have hcur : cur.val = a.val := by
    rw [hcurv]
    simp
  step with (barrel_right_loop1_spec aig a b stages fill cur hcur hstages
    hpow (by omega) ha hb hfill) as
    ⟨aig1, cur1, h11, h12, h13, h14, h15, h16⟩
  have hb1 : ∀ l ∈ b.val, l.node.val < aig1.nodes.val.length := by
    intro l hl
    have := hb l hl
    have := h12.length_le
    omega
  have hne1 : 0 < aig1.nodes.val.length := by
    have := h12.length_le
    omega
  have h01 : aig1.nodes.val[0]'hne1 = Node.False :=
    node0_of_prefix h12 hne h0 hne1
  step with (out_of_range_spec aig1 b stages hstages (by omega) hb1
    hne1 h01) as ⟨oor, aig2, ho1, ho2, ho3, ho4, ho5⟩
  have hcur2 : ∀ l ∈ cur1.val, l.node.val < aig2.nodes.val.length := by
    intro l hl
    have := h15 l hl
    have := ho2.length_le
    omega
  have hfill2 : fill.node.val < aig2.nodes.val.length := by
    have := h12.length_le
    have := ho2.length_le
    omega
  apply WP.spec_mono (barrel_right_loop2_spec aig2 fill cur1
    (Slice.len a) oor (by rw [h14]; scalar_tac) (by omega) hcur2 ho4 hfill2)
  rintro ⟨out, aig3⟩ ⟨hf1, hf2, hf3, hf4, hf5, hf6⟩
  refine ⟨by omega, h12.trans (ho2.trans hf2), by omega,
    fun L hL => hf4 L (ho3 L (h13 L hL)), hf5, ?_⟩
  intro inp j hj
  have hjc : j < cur1.val.length := by omega
  rw [hf6 inp j hj, ho5 inp,
    pHigh_stable h12 hb inp stages.val b.val.length (Nat.le_refl _),
    pEvalLit_stable (h12.trans ho2) fill hfill inp,
    getD_eq_getElem_of_lt hjc,
    pEvalLit_stable ho2 _ (h15 _ (List.getElem_mem hjc)) inp,
    h16 inp j hjc]

/- ══════════════════ HEADLINE: `blast_lshr` ══════════════════ -/

/-- **`blast_lshr` implements SMT-LIB `bvlshr` (`BitVec` `>>>`), for every
    width `w = 2^stages`**: if the input words denote `A` and `B` under the
    post-blast simulation, the output word denotes `A >>> B.toNat`. Core's
    `>>>` on `Nat` amounts already yields `0` for amounts `≥ w`
    (`getLsbD_ushiftRight` reads past the width), matching SMT-LIB. -/
theorem blast_lshr_bitvec (aig : Aig) (a b : Slice Lit) (stages : Std.Usize)
    (hstages : stages.val ≤ b.val.length)
    (hpow : 2 ^ stages.val = a.val.length)
    (hcap : aig.nodes.val.length + (3 * a.val.length * stages.val
      + (b.val.length - stages.val) + 3 * a.val.length) ≤ Usize.max)
    (ha : ∀ l ∈ a.val, l.node.val < aig.nodes.val.length)
    (hb : ∀ l ∈ b.val, l.node.val < aig.nodes.val.length)
    (hne : 0 < aig.nodes.val.length)
    (h0 : aig.nodes.val[0]'hne = Node.False)
    {w : Nat} (A B : BitVec w) :
    blast_lshr aig a b stages ⦃ p =>
      ∀ (inputs : Slice Bool), AigWF aig.nodes.val inputs.val.length →
        simulate p.2 inputs ⦃ vals =>
          Denotes vals.val a.val w A → Denotes vals.val b.val w B →
          Denotes vals.val p.1.val w (A >>> B.toNat) ⦄ ⦄ := by
  unfold blast_lshr
  step with lit_false_spec as ⟨f, hf⟩
  have hfnode : f.node.val < aig.nodes.val.length := by
    rw [hf]
    scalar_tac
  apply WP.spec_mono (barrel_right_spec aig a b stages f hstages hpow hcap
    ha hb hfnode hne h0)
  rintro ⟨out, aig1⟩ ⟨hL1, hL2, hL3, hL4, hL5, hL6⟩
  intro inputs hwf
  apply WP.spec_mono (simulate_spec aig1 inputs (hL4 _ hwf))
  intro vals hv hA hB
  rw [hv] at hA hB ⊢
  have hA0 : Denotes (pSim inputs.val aig.nodes.val) a.val w A :=
    hA.of_prefix hL2 ha inputs.val
  have hB0 : Denotes (pSim inputs.val aig.nodes.val) b.val w B :=
    hB.of_prefix hL2 hb inputs.val
  have hal : a.val.length = w := hA0.1
  have hbl : b.val.length = w := hB0.1
  refine ⟨by omega, fun j hj => ?_⟩
  have hja : j < a.val.length := by omega
  have hfv : pEvalLit (pSim inputs.val aig.nodes.val) f = false := by
    rw [hf]
    exact pEvalLit_node_zero hne h0 inputs.val false
  rw [hL6 inputs.val j hj, hbl,
    pHigh_eq_decide hB0 (show stages.val ≤ w by omega),
    pAmt_eq_mod hB0 stages.val (by omega), hfv]
  by_cases hge : 2 ^ stages.val ≤ B.toNat
  · rw [if_pos (decide_eq_true hge), BitVec.getLsbD_ushiftRight,
      BitVec.getLsbD_of_ge A _ (by omega)]
  · rw [if_neg (by simp only [decide_eq_true_eq]; exact hge),
      Nat.mod_eq_of_lt (by omega), BitVec.getLsbD_ushiftRight]
    by_cases hjn : j + B.toNat < a.val.length
    · rw [if_pos hjn, getD_eq_getElem_of_lt hjn, hA0.2 _ hjn]
      congr 1
      omega
    · rw [if_neg hjn, BitVec.getLsbD_of_ge A _ (by omega)]

/- ══════════════════ HEADLINE: `blast_ashr` ══════════════════ -/

/-- **`blast_ashr` implements SMT-LIB `bvashr` (`BitVec.sshiftRight`), for
    every width `w = 2^stages`**: the output word denotes
    `A.sshiftRight B.toNat`. Core's `sshiftRight` saturates to the sign bit
    for amounts `≥ w` (`getLsbD_sshiftRight`), matching SMT-LIB. -/
theorem blast_ashr_bitvec (aig : Aig) (a b : Slice Lit) (stages : Std.Usize)
    (hstages : stages.val ≤ b.val.length)
    (hpow : 2 ^ stages.val = a.val.length)
    (hcap : aig.nodes.val.length + (3 * a.val.length * stages.val
      + (b.val.length - stages.val) + 3 * a.val.length) ≤ Usize.max)
    (ha : ∀ l ∈ a.val, l.node.val < aig.nodes.val.length)
    (hb : ∀ l ∈ b.val, l.node.val < aig.nodes.val.length)
    (hne : 0 < aig.nodes.val.length)
    (h0 : aig.nodes.val[0]'hne = Node.False)
    {w : Nat} (A B : BitVec w) :
    blast_ashr aig a b stages ⦃ p =>
      ∀ (inputs : Slice Bool), AigWF aig.nodes.val inputs.val.length →
        simulate p.2 inputs ⦃ vals =>
          Denotes vals.val a.val w A → Denotes vals.val b.val w B →
          Denotes vals.val p.1.val w (A.sshiftRight B.toNat) ⦄ ⦄ := by
  unfold blast_ashr
  have hw0 : 0 < a.val.length := by
    have := Nat.two_pow_pos stages.val
    omega
  step as ⟨i1, hi1⟩
  have hi1v : i1.val = a.val.length - 1 := by scalar_tac
  have hi1lt : i1.val < a.val.length := by omega
  step as ⟨sign, hsign⟩
  have hsnode : sign.node.val < aig.nodes.val.length := by
    have := ha sign (by rw [hsign]; exact List.getElem_mem _)
    omega
  apply WP.spec_mono (barrel_right_spec aig a b stages sign hstages hpow
    hcap ha hb hsnode hne h0)
  rintro ⟨out, aig1⟩ ⟨hL1, hL2, hL3, hL4, hL5, hL6⟩
  intro inputs hwf
  apply WP.spec_mono (simulate_spec aig1 inputs (hL4 _ hwf))
  intro vals hv hA hB
  rw [hv] at hA hB ⊢
  have hA0 : Denotes (pSim inputs.val aig.nodes.val) a.val w A :=
    hA.of_prefix hL2 ha inputs.val
  have hB0 : Denotes (pSim inputs.val aig.nodes.val) b.val w B :=
    hB.of_prefix hL2 hb inputs.val
  have hal : a.val.length = w := hA0.1
  have hbl : b.val.length = w := hB0.1
  have hwpos : 0 < w := by omega
  have hfv : pEvalLit (pSim inputs.val aig.nodes.val) sign = A.msb := by
    simp only [hi1v] at hsign
    rw [hsign, hA0.2 _ (by omega), BitVec.msb_eq_getLsbD_last, hal]
  refine ⟨by omega, fun j hj => ?_⟩
  have hja : j < a.val.length := by omega
  have hjw : j < w := by omega
  rw [hL6 inputs.val j hj, hbl,
    pHigh_eq_decide hB0 (show stages.val ≤ w by omega),
    pAmt_eq_mod hB0 stages.val (by omega), hfv,
    BitVec.getLsbD_sshiftRight, decide_eq_false (show ¬(w ≤ j) by omega),
    Bool.not_false, Bool.true_and]
  by_cases hge : 2 ^ stages.val ≤ B.toNat
  · rw [if_pos (decide_eq_true hge), if_neg (by omega)]
  · rw [if_neg (by simp only [decide_eq_true_eq]; exact hge),
      Nat.mod_eq_of_lt (by omega)]
    by_cases hjn : j + B.toNat < a.val.length
    · rw [if_pos hjn, if_pos (by omega), getD_eq_getElem_of_lt hjn,
        hA0.2 _ hjn]
      congr 1
      omega
    · rw [if_neg hjn, if_neg (by omega)]

/- ══════════════════ HEADLINE: `blast_shl` ══════════════════ -/

/-- **`blast_shl` implements SMT-LIB `bvshl` (`BitVec` `<<<`), for every
    width `w = 2^stages`**: the output word denotes `A <<< B.toNat`. Core's
    `<<<` on `Nat` amounts already yields `0` for amounts `≥ w` (the
    `decide (i < n)` guard in `getLsbD_shiftLeft`), matching SMT-LIB. -/
theorem blast_shl_bitvec (aig : Aig) (a b : Slice Lit) (stages : Std.Usize)
    (hstages : stages.val ≤ b.val.length)
    (hpow : 2 ^ stages.val = a.val.length)
    (hcap : aig.nodes.val.length + (3 * a.val.length * stages.val
      + (b.val.length - stages.val) + 3 * a.val.length) ≤ Usize.max)
    (ha : ∀ l ∈ a.val, l.node.val < aig.nodes.val.length)
    (hb : ∀ l ∈ b.val, l.node.val < aig.nodes.val.length)
    (hne : 0 < aig.nodes.val.length)
    (h0 : aig.nodes.val[0]'hne = Node.False)
    {w : Nat} (A B : BitVec w) :
    blast_shl aig a b stages ⦃ p =>
      ∀ (inputs : Slice Bool), AigWF aig.nodes.val inputs.val.length →
        simulate p.2 inputs ⦃ vals =>
          Denotes vals.val a.val w A → Denotes vals.val b.val w B →
          Denotes vals.val p.1.val w (A <<< B.toNat) ⦄ ⦄ := by
  unfold blast_shl
  step with (blast_shl_loop0_spec a (alloc.vec.Vec.new Lit)
    (Slice.len a) (by scalar_tac) (by simp; scalar_tac)) as ⟨cur, hcurv⟩
  have hcur : cur.val = a.val := by
    rw [hcurv]
    simp
  step with (blast_shl_loop1_spec aig a b stages cur hcur hstages
    hpow (by omega) ha hb hne h0) as
    ⟨aig1, cur1, h11, h12, h13, h14, h15, h16⟩
  have hb1 : ∀ l ∈ b.val, l.node.val < aig1.nodes.val.length := by
    intro l hl
    have := hb l hl
    have := h12.length_le
    omega
  have hne1 : 0 < aig1.nodes.val.length := by
    have := h12.length_le
    omega
  have h01 : aig1.nodes.val[0]'hne1 = Node.False :=
    node0_of_prefix h12 hne h0 hne1
  step with (out_of_range_spec aig1 b stages hstages (by omega) hb1
    hne1 h01) as ⟨oor, aig2, ho1, ho2, ho3, ho4, ho5⟩
  step with lit_false_spec as ⟨f, hf⟩
  have hne2 : 0 < aig2.nodes.val.length := by
    have := ho2.length_le
    omega
  have h02 : aig2.nodes.val[0]'hne2 = Node.False :=
    node0_of_prefix ho2 hne1 h01 hne2
  have hfnode : f.node.val < aig2.nodes.val.length := by
    rw [hf]
    scalar_tac
  have hcur2 : ∀ l ∈ cur1.val, l.node.val < aig2.nodes.val.length := by
    intro l hl
    have := h15 l hl
    have := ho2.length_le
    omega
  apply WP.spec_mono (blast_shl_loop2_spec aig2 cur1 (Slice.len a) oor f
    (by rw [h14]; scalar_tac) (by omega) hcur2 ho4 hfnode)
  rintro ⟨out, aig3⟩ ⟨hf1, hf2, hf3, hf4, hf5, hf6⟩
  intro inputs hwf
  apply WP.spec_mono (simulate_spec aig3 inputs
    (hf4 _ (ho3 _ (h13 _ hwf))))
  intro vals hv hA hB
  rw [hv] at hA hB ⊢
  have hpre02 : aig.nodes.val <+: aig2.nodes.val := h12.trans ho2
  have hA0 : Denotes (pSim inputs.val aig.nodes.val) a.val w A :=
    hA.of_prefix (hpre02.trans hf2) ha inputs.val
  have hB0 : Denotes (pSim inputs.val aig.nodes.val) b.val w B :=
    hB.of_prefix (hpre02.trans hf2) hb inputs.val
  have hal : a.val.length = w := hA0.1
  have hbl : b.val.length = w := hB0.1
  refine ⟨by omega, fun j hj => ?_⟩
  have hja : j < a.val.length := by omega
  have hjw : j < w := by omega
  have hjc : j < cur1.val.length := by omega
  have hfv : pEvalLit (pSim inputs.val aig2.nodes.val) f = false := by
    rw [hf]
    exact pEvalLit_node_zero hne2 h02 inputs.val false
  rw [hf6 inputs.val j hj, ho5 inputs.val,
    pHigh_stable h12 hb inputs.val stages.val b.val.length (Nat.le_refl _),
    hfv, getD_eq_getElem_of_lt hjc,
    pEvalLit_stable ho2 _ (h15 _ (List.getElem_mem hjc)) inputs.val,
    h16 inputs.val j hjc, hbl,
    pHigh_eq_decide hB0 (show stages.val ≤ w by omega),
    pAmt_eq_mod hB0 stages.val (by omega),
    BitVec.getLsbD_shiftLeft, decide_eq_true hjw, Bool.true_and]
  by_cases hge : 2 ^ stages.val ≤ B.toNat
  · rw [if_pos (decide_eq_true hge),
      decide_eq_true (show j < B.toNat by omega)]
    simp
  · rw [if_neg (by simp only [decide_eq_true_eq]; exact hge),
      Nat.mod_eq_of_lt (by omega)]
    by_cases hjn : B.toNat ≤ j
    · rw [if_pos hjn, decide_eq_false (show ¬(j < B.toNat) by omega),
        Bool.not_false, Bool.true_and,
        getD_eq_getElem_of_lt (show j - B.toNat < a.val.length by omega),
        hA0.2 _ (by omega)]
    · rw [if_neg hjn, decide_eq_true (show j < B.toNat by omega)]
      simp

/- ══════════════════ HEADLINE: `blast_rotr` ══════════════════ -/

/-- **`blast_rotr` implements SMT-LIB `rotate_right`
    (`BitVec.rotateRight`), for every width `w = 2^stages`**: the output
    word denotes `A.rotateRight (B.toNat % w)` — only the low `stages` bits
    of the amount matter, mod-width semantics, no out-of-range fill. -/
theorem blast_rotr_bitvec (aig : Aig) (a b : Slice Lit) (stages : Std.Usize)
    (hstages : stages.val ≤ b.val.length)
    (hpow : 2 ^ stages.val = a.val.length)
    (hcap : aig.nodes.val.length + 3 * a.val.length * stages.val
      ≤ Usize.max)
    (ha : ∀ l ∈ a.val, l.node.val < aig.nodes.val.length)
    (hb : ∀ l ∈ b.val, l.node.val < aig.nodes.val.length)
    {w : Nat} (A B : BitVec w) :
    blast_rotr aig a b stages ⦃ p =>
      ∀ (inputs : Slice Bool), AigWF aig.nodes.val inputs.val.length →
        simulate p.2 inputs ⦃ vals =>
          Denotes vals.val a.val w A → Denotes vals.val b.val w B →
          Denotes vals.val p.1.val w (A.rotateRight (B.toNat % w)) ⦄ ⦄ := by
  unfold blast_rotr
  step with (blast_rotr_loop0_spec a (alloc.vec.Vec.new Lit)
    (Slice.len a) (by scalar_tac) (by simp; scalar_tac)) as ⟨cur, hcurv⟩
  have hcur : cur.val = a.val := by
    rw [hcurv]
    simp
  apply WP.spec_mono (blast_rotr_loop1_spec aig a b stages cur hcur hstages
    hpow hcap ha hb)
  rintro ⟨out, aig1⟩ ⟨h11, h12, h13, h14, h15, h16⟩
  intro inputs hwf
  apply WP.spec_mono (simulate_spec aig1 inputs (h13 _ hwf))
  intro vals hv hA hB
  rw [hv] at hA hB ⊢
  have hA0 : Denotes (pSim inputs.val aig.nodes.val) a.val w A :=
    hA.of_prefix h12 ha inputs.val
  have hB0 : Denotes (pSim inputs.val aig.nodes.val) b.val w B :=
    hB.of_prefix h12 hb inputs.val
  have hal : a.val.length = w := hA0.1
  have hbl : b.val.length = w := hB0.1
  have hwpos : 0 < w := by
    have := Nat.two_pow_pos stages.val
    omega
  have hr : B.toNat % w < w := Nat.mod_lt _ hwpos
  have hrot : ∀ i : Nat, i < w →
      (A.rotateRight (B.toNat % w)).getLsbD i
        = A.getLsbD ((i + B.toNat % w) % w) := by
    intro i hi
    rw [BitVec.getLsbD_rotateRight, Nat.mod_eq_of_lt hr]
    by_cases hc : i < w - B.toNat % w
    · have hlt : i + B.toNat % w < w := by omega
      have hmod : (i + B.toNat % w) % w = i + B.toNat % w :=
        Nat.mod_eq_of_lt hlt
      rw [decide_eq_true hc, cond_true, hmod]
      congr 1
      omega
    · have hge : w ≤ i + B.toNat % w := by omega
      have hlt2 : i + B.toNat % w - w < w := by omega
      have hmod : (i + B.toNat % w) % w = i + B.toNat % w - w := by
        rw [Nat.mod_eq_sub_mod hge]
        exact Nat.mod_eq_of_lt hlt2
      rw [decide_eq_false hc, cond_false, decide_eq_true hi,
        Bool.true_and, hmod]
      congr 1
      omega
  refine ⟨by omega, fun j hj => ?_⟩
  have hja : j < a.val.length := by omega
  have hjw : j < w := by omega
  have hmlt : (j + pAmt (pSim inputs.val aig.nodes.val) b.val stages.val)
      % a.val.length < a.val.length := Nat.mod_lt _ (by omega)
  rw [h16 inputs.val j hj, getD_eq_getElem_of_lt hmlt, hA0.2 _ hmlt,
    hrot j hjw]
  congr 1
  rw [pAmt_eq_mod hB0 stages.val (by omega), hpow, hal]

end blast_kernel.spec
