          simp only [treeBv]
          -- the side-table levels in `f''`
          have hside : ∀ k < L.length, f''.side.val.getD ((alloc.vec.Vec.len f2.side).val + k) 0#usize
              = L.getD k 0#usize := by
            intro k hk
            have hlt : f2.side.val.length + k < v.val.length := by rw [hv']; simp; omega
            rw [hs, getD_of_prefix hL.side hlt, hv', getD_append_at _ _ _ _ hk]
          congr 1
          rw [chainRead_congr (arrsI f'' arrs) _ (simOf f'' env arrs ufs inp) f''.side.val aid.val _ n.val
            (alloc.vec.Vec.len f2.side).val (fun l hl => by
              have hl1 : 2 * l < L.length := by rw [hlen]; omega
              have hl2 : 2 * l + 1 < L.length := by rw [hlen]; omega
              have e : (alloc.vec.Vec.len f2.side).val + 2 * l + 1
                  = (alloc.vec.Vec.len f2.side).val + (2 * l + 1) := by omega
              rw [hside (2 * l) hl1, e, hside (2 * l + 1) hl2]
              exact ⟨take_val f'' env arrs ufs inp (by rw [hi]; exact hbound _ hl1),
                take_val f'' env arrs ufs inp (by rw [hi]; exact hbound _ hl2)⟩)]
          rw [take_val f'' env arrs ufs inp (by rw [hi]; exact hjl2),
            hjc f'' env arrs ufs inp (hL2.trans (hL3.trans hL)) hI'' hV, hn']
          exact hcorr f'' env arrs ufs inp (hL3.trans hL) hI'' hV _ _ hside
      · cases h
        exact ⟨hL1, hI1, fun i w hiw => nomatch hiw⟩
  | Call nm w args =>
    unfold kernel.term_kernel.flat_bv at h
    obtain ⟨⟨ra, f1, ids⟩, hra, h⟩ := bind_ok_inv h
    obtain ⟨hL1, hI1, hca⟩ := flat_args_ok args f (alloc.vec.Vec.new Std.Usize) hI ra f1 ids hra
    cases ra with
    | Err e =>
      cases h
      exact ⟨hL1, hI1, fun i w' hiw => nomatch hiw⟩
    | Ok u =>
      cases u
      obtain ⟨b, hb, h⟩ := bind_ok_inv h
      split at h
      · obtain ⟨⟨rg, f2⟩, hrg, h⟩ := bind_ok_inv h
        obtain ⟨hL2, hI2, hcg⟩ := flat_func_id_ok hI1 hrg
        cases rg with
        | Err e =>
          cases h
          exact ⟨hL1.trans hL2, hI2, fun i w' hiw => nomatch hiw⟩
        | Ok g =>
          obtain ⟨v, hv, h⟩ := bind_ok_inv h
          obtain ⟨v1, hv1, h⟩ := bind_ok_inv h
          cases h
          obtain ⟨I, hIv, hlen, hbound, hcorr⟩ := hca rfl
          obtain ⟨hg, hgname⟩ := hcg g rfl
          have hIv' : ids.val = I := by rw [hIv]; simp
          have hv' : v.val = f2.side.val ++ I := by
            rw [side_extend_ok hv]
            simp only [alloc.vec.Vec.deref]
            rw [hIv']
          have hv1' := push_ok hv1
          have hi : (alloc.vec.Vec.len f2.nodes).val = f2.nodes.val.length := by simp
          have hs : (alloc.vec.Vec.len f2.side).val = f2.side.val.length := by simp
          have hn : (alloc.vec.Vec.len ids).val = I.length := by simp [hIv']
          have hL3 := Later.push_node_side f2 v1 v _ I hv1' hv'
          refine ⟨(hL1.trans hL2).trans hL3,
            Inv.push_node_side hI2 v1 v _ I hv1' hv'
              ⟨fun _ _ _ _ heq => (nomatch heq), fun g' w' s' n' heq => (by cases heq; exact hg)⟩,
            fun i' w' hiw => ?_⟩
          cases hiw
          refine ⟨by show (alloc.vec.Vec.len f2.nodes).val < v1.val.length; rw [hv1', hi]; simp, ?_⟩
          intro f'' env arrs ufs inp hL hI'' hV
          rw [call_node_val f'' env arrs ufs inp
            (lt_of_lt_of_le (by rw [hi]; simp [hv1']) hL.nodes.length_le) (pushed_node_later2 hv1' hL hi)]
          simp only [treeBv]
          have hside : ∀ k < I.length, f''.side.val.getD ((alloc.vec.Vec.len f2.side).val + k) 0#usize
              = I.getD k 0#usize := by
            intro k hk
            have hlt : f2.side.val.length + k < v.val.length := by rw [hv']; simp; omega
            rw [hs, getD_of_prefix hL.side hlt, hv', getD_append_at _ _ _ _ hk]
          congr 1
          congr 1
          unfold ufsI
          rw [funName_later (hL3.trans hL) hI2 hg, hgname]
          congr 1
          rw [argVals_congr _ (simOf f'' env arrs ufs inp) f''.side.val _ _ (fun l hl => by
            rw [hn] at hl
            rw [hside l hl]
            exact take_val f'' env arrs ufs inp
              (by rw [hi]; exact lt_of_lt_of_le (hbound l hl) hL2.nodes.length_le))]
          apply List.ext_getElem
          · rw [argVals_length, hn, treeArgs_length, hlen]
          · intro l hl1 hl2
            have hlI : l < I.length := by rw [argVals_length, hn] at hl1; exact hl1
            rw [← getD_eq_getElem_of_lt hl1 dDflt, ← getD_eq_getElem_of_lt hl2 dDflt,
              argVals_getD _ _ _ _ _ (by rw [hn]; exact hlI), hside l hlI]
            exact hcorr f'' env arrs ufs inp (hL2.trans (hL3.trans hL)) hI'' hV l hlI
      · cases h
        exact ⟨hL1, hI1, fun i w' hiw => nomatch hiw⟩
termination_by structural t

theorem flat_array_ok (a : TArray) : ∀ (f : Flat) (levels : alloc.vec.Vec Std.Usize), Inv f →
    ∀ (r : core.result.Result Std.Usize FlatError) (f' : Flat) (levels' : alloc.vec.Vec Std.Usize),
      kernel.term_kernel.flat_array a f levels = ok (r, f', levels') → ArrPost a f levels r f' levels' := by
  intro f levels hI r f' levels' h
  cases a with
  | Var nm =>
    unfold kernel.term_kernel.flat_array at h
    obtain ⟨⟨aid, f1⟩, hid, h⟩ := bind_ok_inv h
    cases h
    obtain ⟨hL, hI1, hlt, hname⟩ := flat_array_id_ok hI hid
    refine ⟨hL, hI1, fun aid' ha => ?_⟩
    cases ha
    refine ⟨[], by simp, rfl, fun k hk => by simp at hk, hlt, hname, ?_⟩
    intro f'' env arrs ufs inp hL' hI'' hV s j hside
    simp only [chainLen, chainRead, arrsI, treeArr]
    rw [arrName_later hL' hI1 hlt, hname]
    rfl
  | Store arr index value =>
    unfold kernel.term_kernel.flat_array at h
    obtain ⟨⟨ri, f1⟩, hri, h⟩ := bind_ok_inv h
    obtain ⟨hL1, hI1, hc1⟩ := flat_bv_ok index f hI ri f1 hri
    cases ri with
    | Err e =>
      cases h
      exact ⟨hL1, hI1, fun aid ha => nomatch ha⟩
    | Ok p =>
      obtain ⟨ii, wi⟩ := p
      simp at h
      split at h
      · obtain ⟨⟨rv, f2⟩, hrv, h⟩ := bind_ok_inv h
        obtain ⟨hL2, hI2, hc2⟩ := flat_bv_ok value f1 hI1 rv f2 hrv
        cases rv with
        | Err e =>
          cases h
          exact ⟨hL1.trans hL2, hI2, fun aid ha => nomatch ha⟩
        | Ok p1 =>
          obtain ⟨iv, wv⟩ := p1
          simp at h
          split at h
          · obtain ⟨l1, hl1, h⟩ := bind_ok_inv h
            obtain ⟨l2, hl2, h⟩ := bind_ok_inv h
            obtain ⟨hL3, hI3, hc3⟩ := flat_array_ok arr f2 l2 hI2 r f' levels' h
            obtain ⟨hil, hic⟩ := hc1 ii wi rfl
            obtain ⟨hvl, hvc⟩ := hc2 iv wv rfl
            refine ⟨(hL1.trans hL2).trans hL3, hI3, fun aid ha => ?_⟩
            obtain ⟨L, hLv, hlen, hbound, haid, hname, hcorr⟩ := hc3 aid ha
            refine ⟨ii :: iv :: L, ?_, ?_, ?_, haid, hname, ?_⟩
            · rw [hLv, push_ok hl2, push_ok hl1]; simp
            · simp [chainLen, hlen]; omega
            · intro k hk
              match k with
              | 0 =>
                simp only [List.getD_cons_zero]
                exact lt_of_lt_of_le hil (hL2.trans hL3).nodes.length_le
              | 1 =>
                simp only [List.getD_cons_succ, List.getD_cons_zero]
                exact lt_of_lt_of_le hvl hL3.nodes.length_le
              | k + 2 =>
                simp only [List.getD_cons_succ]
                exact hbound k (by simp at hk; omega)
            · intro f'' env arrs ufs inp hL hI'' hV s j hside
              simp only [chainLen, chainRead, treeArr]
              have h0 := hside 0 (by simp)
              have h1 := hside 1 (by simp)
              simp only [Nat.add_zero, List.getD_cons_zero, List.getD_cons_succ] at h0 h1
              rw [h0, h1, hic f'' env arrs ufs inp ((hL2.trans hL3).trans hL) hI'' hV,
                hvc f'' env arrs ufs inp (hL3.trans hL) hI'' hV,
                hcorr f'' env arrs ufs inp hL hI'' hV (s + 2) j (fun k hk => by
                  have := hside (k + 2) (by simp; omega)
                  simp only [List.getD_cons_succ] at this
                  rw [← this]
                  congr 1
                  omega)]
          · cases h
            exact ⟨hL1.trans hL2, hI2, fun aid ha => nomatch ha⟩
      · cases h
        exact ⟨hL1, hI1, fun aid ha => nomatch ha⟩
termination_by structural a

theorem flat_args_ok (a : TArgs) : ∀ (f : Flat) (ids : alloc.vec.Vec Std.Usize), Inv f →
    ∀ (r : core.result.Result Unit FlatError) (f' : Flat) (ids' : alloc.vec.Vec Std.Usize),
      kernel.term_kernel.flat_args a f ids = ok (r, f', ids') → ArgsPost a f ids r f' ids' := by
  intro f ids hI r f' ids' h
  cases a with
  | Nil =>
    unfold kernel.term_kernel.flat_args at h
    cases h
    refine ⟨Later.rfl f, hI, fun _ => ⟨[], by simp, rfl, fun k hk => by simp at hk, ?_⟩⟩
    intro f'' env arrs ufs inp _ _ _ k hk
    simp at hk
  | Cons t rest =>
    unfold kernel.term_kernel.flat_args at h
    obtain ⟨⟨rt, f1⟩, hrt, h⟩ := bind_ok_inv h
    obtain ⟨hL1, hI1, hc1⟩ := flat_bv_ok t f hI rt f1 hrt
    cases rt with
    | Err e =>
      cases h
      exact ⟨hL1, hI1, fun hr => nomatch hr⟩
    | Ok p =>
      obtain ⟨x, wx⟩ := p
      obtain ⟨ids1, hids1, h⟩ := bind_ok_inv h
      obtain ⟨hL2, hI2, hc2⟩ := flat_args_ok rest f1 ids1 hI1 r f' ids' h
      obtain ⟨hxl, hxc⟩ := hc1 x wx rfl
      refine ⟨hL1.trans hL2, hI2, fun hr => ?_⟩
      obtain ⟨I, hI', hlen, hbound, hcorr⟩ := hc2 hr
      refine ⟨x :: I, ?_, ?_, ?_, ?_⟩
      · rw [hI', push_ok hids1]; simp
      · simp [argsLen, hlen]
      · intro k hk
        cases k with
        | zero =>
          simp only [List.getD_cons_zero]
          exact lt_of_lt_of_le hxl hL2.nodes.length_le
        | succ k =>
          simp only [List.getD_cons_succ]
          exact hbound k (by simp at hk; omega)
      · intro f'' env arrs ufs inp hL hI'' hV k hk
        cases k with
        | zero =>
          simp only [List.getD_cons_zero, treeArgs]
          exact hxc f'' env arrs ufs inp (hL2.trans hL) hI'' hV
        | succ k =>
          simp only [List.getD_cons_succ, treeArgs]
          exact hcorr f'' env arrs ufs inp hL hI'' hV k (by simp at hk; omega)
termination_by structural a

theorem flat_bool_ok (t : TBool) : ∀ (f : Flat), Inv f →
    ∀ (r : core.result.Result Std.Usize FlatError) (f' : Flat),
      kernel.term_kernel.flat_bool t f = ok (r, f') → BoolPost t f r f' := by
  intro f hI r f' h
  cases t with
  | Eq a b =>
    unfold kernel.term_kernel.flat_bool at h
    obtain ⟨hL, hI', hc⟩ := flat_cmp_ok a b f 0#usize hI (flat_bv_ok a) (flat_bv_ok b) r f' h
    exact ⟨hL, hI', fun i hi => ⟨(hc i hi).1, fun f'' env arrs ufs inp hL' hI'' hV => by
      rw [(hc i hi).2 f'' env arrs ufs inp hL' hI'' hV]; simp [treeBool, cmpVal]⟩⟩
  | Ne a b =>
    unfold kernel.term_kernel.flat_bool at h
    obtain ⟨hL, hI', hc⟩ := flat_cmp_ok a b f 1#usize hI (flat_bv_ok a) (flat_bv_ok b) r f' h
    exact ⟨hL, hI', fun i hi => ⟨(hc i hi).1, fun f'' env arrs ufs inp hL' hI'' hV => by
      rw [(hc i hi).2 f'' env arrs ufs inp hL' hI'' hV]; simp [treeBool, cmpVal]⟩⟩
  | Ult a b =>
    unfold kernel.term_kernel.flat_bool at h
    obtain ⟨hL, hI', hc⟩ := flat_cmp_ok a b f 2#usize hI (flat_bv_ok a) (flat_bv_ok b) r f' h
    exact ⟨hL, hI', fun i hi => ⟨(hc i hi).1, fun f'' env arrs ufs inp hL' hI'' hV => by
      rw [(hc i hi).2 f'' env arrs ufs inp hL' hI'' hV]; simp [treeBool, cmpVal]⟩⟩
  | Ule a b =>
    unfold kernel.term_kernel.flat_bool at h
    obtain ⟨hL, hI', hc⟩ := flat_cmp_ok a b f 3#usize hI (flat_bv_ok a) (flat_bv_ok b) r f' h
    exact ⟨hL, hI', fun i hi => ⟨(hc i hi).1, fun f'' env arrs ufs inp hL' hI'' hV => by
      rw [(hc i hi).2 f'' env arrs ufs inp hL' hI'' hV]; simp [treeBool, cmpVal]⟩⟩
  | Ugt a b =>
    unfold kernel.term_kernel.flat_bool at h
    obtain ⟨hL, hI', hc⟩ := flat_cmp_ok a b f 4#usize hI (flat_bv_ok a) (flat_bv_ok b) r f' h
    exact ⟨hL, hI', fun i hi => ⟨(hc i hi).1, fun f'' env arrs ufs inp hL' hI'' hV => by
      rw [(hc i hi).2 f'' env arrs ufs inp hL' hI'' hV]; simp [treeBool, cmpVal]⟩⟩
  | Uge a b =>
    unfold kernel.term_kernel.flat_bool at h
    obtain ⟨hL, hI', hc⟩ := flat_cmp_ok a b f 5#usize hI (flat_bv_ok a) (flat_bv_ok b) r f' h
    exact ⟨hL, hI', fun i hi => ⟨(hc i hi).1, fun f'' env arrs ufs inp hL' hI'' hV => by
      rw [(hc i hi).2 f'' env arrs ufs inp hL' hI'' hV]; simp [treeBool, cmpVal]⟩⟩
  | Slt a b =>
    unfold kernel.term_kernel.flat_bool at h
    obtain ⟨hL, hI', hc⟩ := flat_cmp_ok a b f 6#usize hI (flat_bv_ok a) (flat_bv_ok b) r f' h
    exact ⟨hL, hI', fun i hi => ⟨(hc i hi).1, fun f'' env arrs ufs inp hL' hI'' hV => by
      rw [(hc i hi).2 f'' env arrs ufs inp hL' hI'' hV]; simp [treeBool, cmpVal]⟩⟩
  | Sle a b =>
    unfold kernel.term_kernel.flat_bool at h
    obtain ⟨hL, hI', hc⟩ := flat_cmp_ok a b f 7#usize hI (flat_bv_ok a) (flat_bv_ok b) r f' h
    exact ⟨hL, hI', fun i hi => ⟨(hc i hi).1, fun f'' env arrs ufs inp hL' hI'' hV => by
      rw [(hc i hi).2 f'' env arrs ufs inp hL' hI'' hV]; simp [treeBool, cmpVal]⟩⟩
  | Sgt a b =>
    unfold kernel.term_kernel.flat_bool at h
    obtain ⟨hL, hI', hc⟩ := flat_cmp_ok a b f 8#usize hI (flat_bv_ok a) (flat_bv_ok b) r f' h
    exact ⟨hL, hI', fun i hi => ⟨(hc i hi).1, fun f'' env arrs ufs inp hL' hI'' hV => by
      rw [(hc i hi).2 f'' env arrs ufs inp hL' hI'' hV]; simp [treeBool, cmpVal]⟩⟩
  | Sge a b =>
    unfold kernel.term_kernel.flat_bool at h
    obtain ⟨hL, hI', hc⟩ := flat_cmp_ok a b f 9#usize hI (flat_bv_ok a) (flat_bv_ok b) r f' h
    exact ⟨hL, hI', fun i hi => ⟨(hc i hi).1, fun f'' env arrs ufs inp hL' hI'' hV => by
      rw [(hc i hi).2 f'' env arrs ufs inp hL' hI'' hV]; simp [treeBool, cmpVal]⟩⟩
  | Not a =>
    unfold kernel.term_kernel.flat_bool at h
    obtain ⟨⟨ra, f1⟩, hra, h⟩ := bind_ok_inv h
    obtain ⟨hL1, hI1, hc1⟩ := flat_bool_ok a f hI ra f1 hra
    cases ra with
    | Err e =>
      cases h
      exact ⟨hL1, hI1, fun i hi => nomatch hi⟩
    | Ok x =>
      obtain ⟨⟨i, f2⟩, hpc, h⟩ := bind_ok_inv h
      cases h
      obtain ⟨hi, v, hf2, hv⟩ := push_core_ok hpc
      subst hf2
      have hL2 := Later.push_core f1 v _ hv
      obtain ⟨hxl, hxc⟩ := hc1 x rfl
      refine ⟨hL1.trans hL2, Inv.push_core hI1 v _ hv, fun i' hi' => ?_⟩
      cases hi'
      refine ⟨by show i.val < v.val.length; rw [hv, hi]; simp, ?_⟩
      intro f'' env arrs ufs inp hL hI'' hV
      rw [core_node_val f'' env arrs ufs inp (lt_of_lt_of_le (by rw [hi]; simp [hv]) hL.nodes.length_le)
        (pushed_node_later hv hL hi)]
      simp only [dagNodeVal, treeBool]
      rw [take_val f'' env arrs ufs inp (by omega), hxc f'' env arrs ufs inp (hL2.trans hL) hI'' hV,
        bval_bvBool]
  | And a b =>
    unfold kernel.term_kernel.flat_bool at h
    obtain ⟨⟨ra, f1⟩, hra, h⟩ := bind_ok_inv h
    obtain ⟨hL1, hI1, hc1⟩ := flat_bool_ok a f hI ra f1 hra
    cases ra with
    | Err e =>
      cases h
      exact ⟨hL1, hI1, fun i hi => nomatch hi⟩
    | Ok x =>
      obtain ⟨⟨rb, f2⟩, hrb, h⟩ := bind_ok_inv h
      obtain ⟨hL2, hI2, hc2⟩ := flat_bool_ok b f1 hI1 rb f2 hrb
      cases rb with
      | Err e =>
        cases h
        exact ⟨hL1.trans hL2, hI2, fun i hi => nomatch hi⟩
      | Ok y =>
        obtain ⟨⟨i, f3⟩, hpc, h⟩ := bind_ok_inv h
        cases h
        obtain ⟨hi, v, hf3, hv⟩ := push_core_ok hpc
        subst hf3
        have hL3 := Later.push_core f2 v _ hv
        obtain ⟨hxl, hxc⟩ := hc1 x rfl
        obtain ⟨hyl, hyc⟩ := hc2 y rfl
        have hxl2 : x.val < f2.nodes.val.length := lt_of_lt_of_le hxl hL2.nodes.length_le
        refine ⟨(hL1.trans hL2).trans hL3, Inv.push_core hI2 v _ hv, fun i' hi' => ?_⟩
        cases hi'
        refine ⟨by show i.val < v.val.length; rw [hv, hi]; simp, ?_⟩
        intro f'' env arrs ufs inp hL hI'' hV
        rw [core_node_val f'' env arrs ufs inp (lt_of_lt_of_le (by rw [hi]; simp [hv]) hL.nodes.length_le)
          (pushed_node_later hv hL hi)]
        simp only [dagNodeVal, treeBool]
        rw [take_val f'' env arrs ufs inp (by omega), take_val f'' env arrs ufs inp (by omega),
          hxc f'' env arrs ufs inp (hL2.trans (hL3.trans hL)) hI'' hV,
          hyc f'' env arrs ufs inp (hL3.trans hL) hI'' hV, bval_bvBool, bval_bvBool]
  | Or a b =>
    unfold kernel.term_kernel.flat_bool at h
    obtain ⟨⟨ra, f1⟩, hra, h⟩ := bind_ok_inv h
    obtain ⟨hL1, hI1, hc1⟩ := flat_bool_ok a f hI ra f1 hra
    cases ra with
    | Err e =>
      cases h
      exact ⟨hL1, hI1, fun i hi => nomatch hi⟩
    | Ok x =>
      obtain ⟨⟨rb, f2⟩, hrb, h⟩ := bind_ok_inv h
      obtain ⟨hL2, hI2, hc2⟩ := flat_bool_ok b f1 hI1 rb f2 hrb
      cases rb with
      | Err e =>
        cases h
        exact ⟨hL1.trans hL2, hI2, fun i hi => nomatch hi⟩
      | Ok y =>
        obtain ⟨⟨i, f3⟩, hpc, h⟩ := bind_ok_inv h
        cases h
        obtain ⟨hi, v, hf3, hv⟩ := push_core_ok hpc
        subst hf3
        have hL3 := Later.push_core f2 v _ hv
        obtain ⟨hxl, hxc⟩ := hc1 x rfl
        obtain ⟨hyl, hyc⟩ := hc2 y rfl
        have hxl2 : x.val < f2.nodes.val.length := lt_of_lt_of_le hxl hL2.nodes.length_le
        refine ⟨(hL1.trans hL2).trans hL3, Inv.push_core hI2 v _ hv, fun i' hi' => ?_⟩
        cases hi'
        refine ⟨by show i.val < v.val.length; rw [hv, hi]; simp, ?_⟩
        intro f'' env arrs ufs inp hL hI'' hV
        rw [core_node_val f'' env arrs ufs inp (lt_of_lt_of_le (by rw [hi]; simp [hv]) hL.nodes.length_le)
          (pushed_node_later hv hL hi)]
        simp only [dagNodeVal, treeBool]
        rw [take_val f'' env arrs ufs inp (by omega), take_val f'' env arrs ufs inp (by omega),
          hxc f'' env arrs ufs inp (hL2.trans (hL3.trans hL)) hI'' hV,
          hyc f'' env arrs ufs inp (hL3.trans hL) hI'' hV, bval_bvBool, bval_bvBool]
termination_by structural t

end

/- ══════════════════ THE ROOTS ══════════════════ -/

/-- Replacing the roots keeps the invariant (it never reads them). -/
theorem Inv.set_roots {f : Flat} (hI : Inv f) (v : alloc.vec.Vec Std.Usize) :
    Inv { f with roots := v } :=
  ⟨hI.var_len1, hI.var_len2, hI.var_len3, hI.var_range, hI.var_node_lt, hI.var_is_var, hI.var_inj,
   hI.var_node_inj, hI.const_len1, hI.const_len2, hI.const_ok, hI.arr_len, hI.arr_range, hI.arr_inj,
   hI.fun_len1, hI.fun_len2, hI.fun_range, hI.fun_inj, hI.sel_range⟩

/-- Neither `simOf`, `Inv` nor `VarAgree` reads the roots, so a
    correspondence survives replacing them: a later state of the new
    state, with the old roots put back, is a later state of the old one. -/
theorem BoolCorr_set_roots {f : Flat} {i : Nat} {t : TBool} (v : alloc.vec.Vec Std.Usize)
    (h : BoolCorr f i t) : BoolCorr { f with roots := v } i t := by
  intro f' env arrs ufs inp hL hI hV
  have hL' : Later f { f' with roots := f.roots } :=
    ⟨hL.nodes, hL.bits, hL.side, rfl, hL.names, hL.name_start, hL.name_len, hL.var_node,
     hL.var_width, hL.const_value, hL.const_width, hL.const_node, hL.anames, hL.aname_start,
     hL.aname_len, hL.fnames, hL.fname_start, hL.fname_len, hL.func_width⟩
  exact h { f' with roots := f.roots } env arrs ufs inp hL' (hI.set_roots _) hV

/-- Root `i` of a state, as a `Nat`. -/
def rootOf (f : Flat) (i : Nat) : Nat := (f.roots.val.getD i 0#usize).val

/-- The first `k` roots denote the first `k` trees. -/
def TreeRoots (f : Flat) (ts : List TBool) (k : Nat) : Prop :=
  ∀ i (hi : i < ts.length), i < k → rootOf f i < f.nodes.val.length ∧ BoolCorr f (rootOf f i) ts[i]

theorem slice_len_val {α : Type} (s : Slice α) : (Slice.len s).val = s.val.length := by
  simp [Slice.len]

theorem flatten_roots_loop_ok (ts : Slice TBool) :
    ∀ (f : Flat) (k : Std.Usize), Inv f → k.val ≤ ts.val.length → f.roots.val.length = k.val →
      TreeRoots f ts.val k.val →
      ∀ r f', kernel.term_kernel.flatten_roots_loop ts f (Slice.len ts) k = ok (r, f') →
        Inv f' ∧ (r = .Ok () → f'.roots.val.length = ts.val.length ∧ TreeRoots f' ts.val ts.val.length) := by
  intro f k hI hk hlen hR r f' h
  unfold kernel.term_kernel.flatten_roots_loop at h
  refine loop_ok (α := Flat × Std.Usize) (β := (core.result.Result Unit FlatError) × Flat)
    (fun st => ts.val.length - st.2.val)
    (fun st => Inv st.1 ∧ st.2.val ≤ ts.val.length ∧ st.1.roots.val.length = st.2.val ∧
      TreeRoots st.1 ts.val st.2.val)
    (fun y => Inv y.2 ∧ (y.1 = .Ok () → y.2.roots.val.length = ts.val.length ∧
      TreeRoots y.2 ts.val ts.val.length))
    _ ?_ (f, k) ⟨hI, hk, hlen, hR⟩ (r, f') h
  rintro ⟨f1, k1⟩ ⟨hI1, hk1x, hlen1x, hR1x⟩ r1 hb0
  have hk1 : k1.val ≤ ts.val.length := hk1x
  have hlen1 : f1.roots.val.length = k1.val := hlen1x
  have hR1 : TreeRoots f1 ts.val k1.val := hR1x
  clear hk1x hlen1x hR1x
  have hb : kernel.term_kernel.flatten_roots_loop.body ts (Slice.len ts) f1 k1 = ok r1 := hb0
  unfold kernel.term_kernel.flatten_roots_loop.body at hb
  have hn : (Slice.len ts).val = ts.val.length := slice_len_val ts
  split at hb
  · rename_i hlt
    have hlt' : k1.val < ts.val.length := by rw [← hn]; exact hlt
    obtain ⟨t, ht, hb⟩ := bind_ok_inv hb
    obtain ⟨⟨rb, f2⟩, hrb, hb⟩ := bind_ok_inv hb
    obtain ⟨hL2, hI2, hc⟩ := flat_bool_ok t f1 hI1 rb f2 hrb
    obtain ⟨_, ht'⟩ := slice_index_ok ht
    cases rb with
    | Err e =>
      cases hb
      exact ⟨fun y hy => (by cases hy; exact ⟨hI2, fun hc => nomatch hc⟩), fun x' hx' => (nomatch hx')⟩
    | Ok i =>
      obtain ⟨v, hv, hb⟩ := bind_ok_inv hb
      obtain ⟨k2, hk2, hb⟩ := bind_ok_inv hb
      cases hb
      refine ⟨fun y hy => (nomatch hy), fun x' hx' => ?_⟩
      cases hx'
      have hv' := push_ok hv
      have hk2' : k2.val = k1.val + 1 := by simpa using add_ok hk2
      obtain ⟨hil, hic⟩ := hc i rfl
      have hr2 : f2.roots.val.length = k1.val := by rw [← hL2.roots]; exact hlen1
      refine ⟨⟨hI2.set_roots v, ?_, ?_, ?_⟩, ?_⟩
      · show k2.val ≤ ts.val.length
        omega
      · show v.val.length = k2.val
        rw [hv', hk2']; simp [hr2]
      · intro i' hi' hi'k
        show (v.val.getD i' 0#usize).val < f2.nodes.val.length ∧
          BoolCorr { f2 with roots := v } (v.val.getD i' 0#usize).val ts.val[i']
        rcases Nat.lt_or_ge i' k1.val with hlt2 | hge2
        · have hget : v.val.getD i' 0#usize = f1.roots.val.getD i' 0#usize := by
            rw [hv', getD_of_prefix (List.prefix_append _ _) (by omega), hL2.roots]
          rw [hget]
          obtain ⟨hl1, hc1⟩ := hR1 i' hi' hlt2
          exact ⟨lt_of_lt_of_le hl1 hL2.nodes.length_le,
            BoolCorr_set_roots v (BoolCorr_later hL2 hc1)⟩
        · have hik : i' = k1.val := by rw [hk2'] at hi'k; omega
          subst hik
          have hget : v.val.getD k1.val 0#usize = i := by
            rw [hv', ← hr2, getD_snoc_length]
          rw [hget]
          refine ⟨hil, BoolCorr_set_roots v ?_⟩
          have : ts.val[k1.val] = t := by rw [ht' ts.val[k1.val], getD_eq_getElem_of_lt hlt']
          rw [this]
          exact hic
      · show ts.val.length - k2.val < ts.val.length - k1.val
        omega
  · rename_i hge
    cases hb
    refine ⟨fun y hy => ?_, fun x' hx' => (nomatch hx')⟩
    cases hy
    have hge' : ts.val.length ≤ k1.val := by rw [← hn]; exact Nat.le_of_not_lt hge
    have hkn : k1.val = ts.val.length := by omega
    exact ⟨hI1, fun _ => ⟨by rw [hlen1, hkn], by rw [← hkn]; exact hR1⟩⟩

theorem Inv_flat_new (f : Flat) (h : kernel.term_kernel.flat_new = ok f) : Inv f ∧ f.roots.val = [] := by
  unfold kernel.term_kernel.flat_new at h
  cases h
  refine ⟨⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩, by simp⟩
  all_goals first
    | rfl
    | (intro k hk; simp [nvars, nconsts, narrs, nfuncs] at hk)

/-- **The flattener is sound**: an accepted `flatten_tree` has one root per
    tree, each denoting its tree under every assignment that agrees with
    the environment through the variable table. -/
theorem flatten_tree_sound (ts : Slice TBool) (f : Flat)
    (h : kernel.term_kernel.flatten_tree ts = ok (.Ok f)) :
    Inv f ∧ f.roots.val.length = ts.val.length ∧
    ∀ env arrs ufs inp, VarAgree f env inp → ∀ k (hk : k < ts.val.length),
      extBool inp f.bits.val (arrsI f arrs) (ufsI f ufs) f.side.val f.nodes.val (rootOf f k)
        = treeBool env arrs ufs ts.val[k] := by
  unfold kernel.term_kernel.flatten_tree at h
  obtain ⟨f0, hf0, h⟩ := bind_ok_inv h
  obtain ⟨⟨r, f1⟩, hr, h⟩ := bind_ok_inv h
  obtain ⟨hI0, hroots0⟩ := Inv_flat_new f0 hf0
  unfold kernel.term_kernel.flatten_roots at hr
  obtain ⟨hI1, hpost⟩ := flatten_roots_loop_ok ts f0 0#usize hI0 (by simp) (by simp [hroots0])
    (fun i _ hi => by simp at hi) r f1 hr
  cases r with
  | Err e => cases h
  | Ok u =>
    cases h
    obtain ⟨hlen, hR⟩ := hpost rfl
    refine ⟨hI1, hlen, fun env arrs ufs inp hV k hk => ?_⟩
    obtain ⟨_, hc⟩ := hR k hk (by omega)
    show bval ((simOf _ env arrs ufs inp).getD (rootOf _ k) dDflt) = _
    rw [hc _ env arrs ufs inp (Later.rfl _) hI1 hV, bval_bvBool]

/-- The flat query is satisfied exactly when the trees are, under agreeing
    assignments. -/
theorem flatten_tree_sat_iff (ts : Slice TBool) (f : Flat)
    (h : kernel.term_kernel.flatten_tree ts = ok (.Ok f)) (env : TEnv) (arrs : NArrs) (ufs : NUfs)
    (inp : List Bool) (hV : VarAgree f env inp) :
    ExtSat inp f.bits.val (arrsI f arrs) (ufsI f ufs) f.side.val f.nodes.val f.roots.val
      ↔ TreeSat env arrs ufs ts.val := by
  obtain ⟨_, hlen, hs⟩ := flatten_tree_sound ts f h
  constructor
  · intro hsat k hk
    have hk' : k < f.roots.val.length := by rw [hlen]; exact hk
    rw [← hs env arrs ufs inp hV k hk]
    have := hsat k hk'
    unfold rootOf
    rw [getD_eq_getElem_of_lt hk']
    exact this
  · intro hsat k hk
    have hk' : k < ts.val.length := by rw [← hlen]; exact hk
    have := hs env arrs ufs inp hV k hk'
    unfold rootOf at this
    rw [getD_eq_getElem_of_lt hk] at this
    rw [this]
    exact hsat k hk'

/- ══════════════════ THE CORE PROJECTION ══════════════════ -/

theorem project_core_loop_ok (nodes : Slice ExtNode) :
    ∀ (out : alloc.vec.Vec blast_kernel.DagNode) (i : Std.Usize), i.val ≤ nodes.val.length →
      nodes.val.take i.val = out.val.map .Core →
      ∀ r, kernel.term_kernel.project_core_loop nodes out (Slice.len nodes) i = ok r →
        ∀ t, r = .Ok t → nodes.val = t.val.map .Core := by
  intro out i hi hpre r h
  unfold kernel.term_kernel.project_core_loop at h
  refine loop_ok (α := (alloc.vec.Vec blast_kernel.DagNode) × Std.Usize)
    (β := core.result.Result (alloc.vec.Vec blast_kernel.DagNode) FlatError)
    (fun st => nodes.val.length - st.2.val)
    (fun st => st.2.val ≤ nodes.val.length ∧ nodes.val.take st.2.val = st.1.val.map .Core)
    (fun y => ∀ t, y = .Ok t → nodes.val = t.val.map .Core)
    _ ?_ (out, i) ⟨hi, hpre⟩ r h
  rintro ⟨out1, i1⟩ ⟨hi1x, hpre1x⟩ r1 hb0
  have hi1 : i1.val ≤ nodes.val.length := hi1x
  have hpre1 : nodes.val.take i1.val = out1.val.map .Core := hpre1x
  clear hi1x hpre1x
  have hb : kernel.term_kernel.project_core_loop.body nodes (Slice.len nodes) out1 i1 = ok r1 := hb0
  unfold kernel.term_kernel.project_core_loop.body at hb
  have hn : (Slice.len nodes).val = nodes.val.length := slice_len_val nodes
  split at hb
  · rename_i hlt
    have hlt' : i1.val < nodes.val.length := by rw [← hn]; exact hlt
    obtain ⟨node, hnode, hb⟩ := bind_ok_inv hb
    obtain ⟨_, hnode'⟩ := slice_index_ok hnode
    cases node with
    | Core nd =>
      obtain ⟨out2, hout2, hb⟩ := bind_ok_inv hb
      obtain ⟨i2, hi2, hb⟩ := bind_ok_inv hb
      cases hb
      refine ⟨fun y hy => (nomatch hy), fun x' hx' => ?_⟩
      cases hx'
      have hi2' : i2.val = i1.val + 1 := by simpa using add_ok hi2
      have hout2' := push_ok hout2
      refine ⟨⟨?_, ?_⟩, ?_⟩
      · show i2.val ≤ nodes.val.length
        omega
      rotate_left
      · show nodes.val.length - i2.val < nodes.val.length - i1.val
        omega
      show nodes.val.take i2.val = out2.val.map .Core
      rw [hi2', List.take_add_one, List.getElem?_eq_getElem hlt', hout2', List.map_append, ← hpre1]
      simp only [List.map_cons, List.map_nil, Option.toList]
      congr 2
      rw [← getD_eq_getElem_of_lt hlt' dfltExt, ← hnode' dfltExt]
    | Select _ _ _ _ =>
      cases hb
      exact ⟨fun y hy => (by cases hy; intro t ht; cases ht), fun x' hx' => (nomatch hx')⟩
    | Call _ _ _ _ =>
      cases hb
      exact ⟨fun y hy => (by cases hy; intro t ht; cases ht), fun x' hx' => (nomatch hx')⟩
  · rename_i hge
    cases hb
    refine ⟨fun y hy => ?_, fun x' hx' => (nomatch hx')⟩
    cases hy
    intro t ht
    cases ht
    have hge' : nodes.val.length ≤ i1.val := by rw [← hn]; exact Nat.le_of_not_lt hge
    have hin : i1.val = nodes.val.length := by omega
    rw [hin, List.take_length] at hpre1
    exact hpre1

/-- An accepted `project_core` is exactly the closed nodes, in order. -/
theorem project_core_ok (nodes : Slice ExtNode) (t : alloc.vec.Vec blast_kernel.DagNode)
    (h : kernel.term_kernel.project_core nodes = ok (.Ok t)) : nodes.val = t.val.map .Core := by
  unfold kernel.term_kernel.project_core at h
  exact project_core_loop_ok nodes _ 0#usize (by simp) (by simp) _ h t rfl

/-- Over closed nodes the extended semantics is the DAG semantics — no
    interpretation is consulted. -/
theorem extSimAux_map_core (inp bits : List Bool) (arrs : Arrs) (ufs : Ufs) (side : List Std.Usize) :
    ∀ (t : List blast_kernel.DagNode) (st : List DVal × Nat),
      extSimAux inp bits arrs ufs side st (t.map .Core) = dagSimAux inp bits st t := by
  intro t
  induction t with
  | nil => intro st; rfl
  | cons nd t ih =>
    rintro ⟨vals, nin⟩
    simp only [List.map_cons, extSimAux, dagSimAux, extNodeVal, extNodeNin]
    exact ih _

theorem extSim_map_core (inp bits : List Bool) (arrs : Arrs) (ufs : Ufs) (side : List Std.Usize)
    (t : List blast_kernel.DagNode) :
    extSim inp bits arrs ufs side (t.map .Core) = dagSim inp bits t := by
  unfold extSim dagSim
  rw [extSimAux_map_core]

theorem extNin_map_core (t : List blast_kernel.DagNode) : extNin (t.map .Core) = dagNin t := by
  unfold extNin dagNin
  rw [List.foldl_map]
  rfl

/- ══════════════════ TRANSPORT: ENVIRONMENT ⇄ LAYOUT ══════════════════ -/

open Classical in
/-- The input block of node `i`: the bits of the environment's value at
    the variable whose node it is; past the table, zeros of the node's own
    width. -/
noncomputable def blkOf (f : Flat) (env : TEnv) (i : Nat) : List Bool :=
  if h : ∃ k, k < nvars f ∧ varNodeOf f k = i then
    (List.range (varWidthOf f (Classical.choose h))).map
      (fun j => (env (varName f (Classical.choose h)) (varWidthOf f (Classical.choose h))).getLsbD j)
  else List.replicate (extVarWidth (f.nodes.val.getD i dfltExt)) false

theorem blkOf_length {f : Flat} (hI : Inv f) (env : TEnv) :
    ∀ i (hi : i < f.nodes.val.length), (blkOf f env i).length = extVarWidth f.nodes.val[i] := by
  intro i hi
  unfold blkOf
  split
  · rename_i hex
    obtain ⟨hk, hnode⟩ := Classical.choose_spec hex
    simp only [List.length_map, List.length_range]
    have hv := hI.var_is_var _ hk
    rw [hnode] at hv
    rw [← getD_eq_getElem_of_lt hi dfltExt, hv]
    rfl
  · simp only [List.length_replicate]
    rw [getD_eq_getElem_of_lt hi dfltExt]

/-- Every environment has a layout that agrees with it through the table. -/
theorem layout_exists {f : Flat} (hI : Inv f) (env : TEnv) : ∃ inp : List Bool, VarAgree f env inp := by
  refine ⟨layoutAux (blkOf f env) f.nodes.val.length, ?_⟩
  intro k hk j hj
  have hnode := hI.var_node_lt k hk
  have hw : extVarWidth f.nodes.val[varNodeOf f k] = varWidthOf f k := by
    rw [← getD_eq_getElem_of_lt hnode dfltExt, hI.var_is_var k hk]
    rfl
  rw [layoutAuxE_getD f.nodes.val (blkOf f env) (blkOf_length hI env) f.nodes.val.length le_rfl
    (varNodeOf f k) hnode j (by rw [hw]; exact hj)]
  unfold blkOf
  have hex : ∃ k', k' < nvars f ∧ varNodeOf f k' = varNodeOf f k := ⟨k, hk, rfl⟩
  rw [dif_pos hex]
  obtain ⟨hk1, hk2⟩ := Classical.choose_spec hex
  have hkk : Classical.choose hex = k := hI.var_node_inj _ hk1 k hk hk2
  rw [hkk]
  simp [List.getD_eq_getElem?_getD, hj]

open Classical in
/-- The environment a layout reads back through the table: the bits at
    the node of the (unique, by injectivity) variable with that name and
    width; zero past the table. -/
noncomputable def envOf (f : Flat) (inp : List Bool) : TEnv := fun nm w =>
  if h : ∃ k, k < nvars f ∧ varName f k = nm ∧ varWidthOf f k = w then
    bvOfFn (fun j => inp.getD (extNin (f.nodes.val.take (varNodeOf f (Classical.choose h))) + j) false) w
  else 0#w

theorem envOf_agree {f : Flat} (hI : Inv f) (inp : List Bool) : VarAgree f (envOf f inp) inp := by
  intro k hk j hj
  unfold envOf
  have hex : ∃ k', k' < nvars f ∧ varName f k' = varName f k ∧ varWidthOf f k' = varWidthOf f k :=
    ⟨k, hk, rfl, rfl⟩
  rw [dif_pos hex]
  obtain ⟨hk1, hk2, _⟩ := Classical.choose_spec hex
  have hkk : Classical.choose hex = k := hI.var_inj _ hk1 k hk hk2
  rw [hkk, getLsbD_bvOfFn]
  simp [hj]

open Classical in
/-- The by-name interpretations an id-keyed pair induces through the
    tables (injective, so well defined); defaults past them. -/
noncomputable def narrsOf (f : Flat) (arrs : Arrs) : NArrs := fun nm =>
  if h : ∃ a, a < narrs f ∧ arrName f a = nm then arrs (Classical.choose h) else fun _ => 0#8

open Classical in
noncomputable def nufsOf (f : Flat) (ufs : Ufs) : NUfs := fun nm =>
  if h : ∃ g, g < nfuncs f ∧ funName f g = nm then ufs (Classical.choose h) else fun _ => dDflt

theorem narrsOf_eq {f : Flat} (hI : Inv f) (arrs : Arrs) :
    ∀ a < narrs f, narrsOf f arrs (arrName f a) = arrs a := by
  intro a ha
  unfold narrsOf
  have hex : ∃ a', a' < narrs f ∧ arrName f a' = arrName f a := ⟨a, ha, rfl⟩
  rw [dif_pos hex]
  obtain ⟨h1, h2⟩ := Classical.choose_spec hex
  rw [hI.arr_inj _ h1 a ha h2]

theorem nufsOf_eq {f : Flat} (hI : Inv f) (ufs : Ufs) :
    ∀ g < nfuncs f, nufsOf f ufs (funName f g) = ufs g := by
  intro g hg
  unfold nufsOf
  have hex : ∃ g', g' < nfuncs f ∧ funName f g' = funName f g := ⟨g, hg, rfl⟩
  rw [dif_pos hex]
  obtain ⟨h1, h2⟩ := Classical.choose_spec hex
  rw [hI.fun_inj _ h1 g hg h2]

/- ══════════════════ THE SIMULATION ONLY READS NAMED IDS ══════════════════ -/

/-- Every select / call of the list names an array / function below the
    bounds. -/
def IdsBelow (e : List ExtNode) (A G : Nat) : Prop :=
  ∀ nd ∈ e, (∀ aid j s n, nd = .Select aid j s n → aid.val < A) ∧
    (∀ fid w s n, nd = .Call fid w s n → fid.val < G)

theorem chainRead_congr_arrs {arrs arrs' : Arrs} (vals : List DVal) (side : List Std.Usize) (aid : Nat)
    (j : BitVec 32) (h : arrs aid = arrs' aid) :
    ∀ n s, chainRead arrs vals side aid j s n = chainRead arrs' vals side aid j s n := by
  intro n
  induction n with
  | zero => intro s; simp [chainRead, h]
  | succ n ih => intro s; simp only [chainRead, ih]

theorem extNodeVal_congr {arrs arrs' : Arrs} {ufs ufs' : Ufs} {A G : Nat}
    (ha : ∀ a < A, arrs a = arrs' a) (hg : ∀ g < G, ufs g = ufs' g) (inp bits : List Bool)
    (side : List Std.Usize) (vals : List DVal) (nin : Nat) (nd : ExtNode)
    (hnd : (∀ aid j s n, nd = .Select aid j s n → aid.val < A) ∧
      (∀ fid w s n, nd = .Call fid w s n → fid.val < G)) :
    extNodeVal inp bits arrs ufs side vals nin nd = extNodeVal inp bits arrs' ufs' side vals nin nd := by
  cases nd with
  | Core nd => rfl
  | Select aid j s n =>
    simp only [extNodeVal]
    rw [chainRead_congr_arrs _ _ _ _ (ha _ (hnd.1 aid j s n rfl))]
  | Call fid w s n =>
    simp only [extNodeVal]
    rw [hg _ (hnd.2 fid w s n rfl)]

theorem extSimAux_congr {arrs arrs' : Arrs} {ufs ufs' : Ufs} {A G : Nat}
    (ha : ∀ a < A, arrs a = arrs' a) (hg : ∀ g < G, ufs g = ufs' g) (inp bits : List Bool)
    (side : List Std.Usize) :
    ∀ (e : List ExtNode), IdsBelow e A G → ∀ st,
      extSimAux inp bits arrs ufs side st e = extSimAux inp bits arrs' ufs' side st e := by
  intro e
  induction e with
  | nil => intro _ st; rfl
  | cons nd e ih =>
    rintro hb ⟨vals, nin⟩
    have hnd := hb nd (List.mem_cons_self ..)
    have hb' : IdsBelow e A G := fun x hx => hb x (List.mem_cons_of_mem _ hx)
    simp only [extSimAux]
    rw [extNodeVal_congr ha hg inp bits side vals nin nd hnd]
    exact ih hb' _

/-- A state's simulation under by-name interpretations is its simulation
    under any by-id pair they induce on the tables. -/
theorem simOf_congr {f : Flat} (hI : Inv f) (env : TEnv) (inp : List Bool) (arrs : Arrs) (ufs : Ufs)
    (narrs' : NArrs) (nufs' : NUfs) (ha : ∀ a < narrs f, arrsI f narrs' a = arrs a)
    (hg : ∀ g < nfuncs f, ufsI f nufs' g = ufs g) :
    simOf f env narrs' nufs' inp = extSim inp f.bits.val arrs ufs f.side.val f.nodes.val := by
  unfold simOf extSim
  have hbelow : IdsBelow f.nodes.val (narrs f) (nfuncs f) := by
    intro nd hnd
    obtain ⟨i, hi, rfl⟩ := List.mem_iff_getElem.mp hnd
    have := hI.sel_range i hi
    rw [getD_eq_getElem_of_lt hi] at this
    exact this
  rw [extSimAux_congr ha hg inp f.bits.val f.side.val f.nodes.val hbelow ([], 0)]

/- ══════════════════ THE MODEL BINDING BY NAME ══════════════════ -/

theorem var_of_width_ok {nd : blast_kernel.DagNode} {w : Std.Usize}
    (h : kernel.term_kernel.var_of_width nd w = ok true) : nd = .Var w := by
  unfold kernel.term_kernel.var_of_width at h
  split at h
  all_goals try cases h
  split at h
  · rename_i hv
    rw [hv]
  · cases h

/-- An accepted `bound_at`: bit `j` of the value IS input `offset + j` of
    the DAG variable at node `m`. -/
theorem bound_at_ok {ns : Slice blast_kernel.DagNode} {inp : Slice Bool} {m w : Std.Usize}
    {value : Std.U128} (h : kernel.term_kernel.bound_at ns inp m w value = ok true) :
    ∀ j < w.val, inp.val.getD (dagNin (ns.val.take m.val) + j) false = value.val.testBit j := by
  unfold kernel.term_kernel.bound_at at h
  obtain ⟨r, hr, h⟩ := bind_ok_inv h
  obtain ⟨r', hr', hP⟩ := WP.spec_imp_exists (var_offset_spec ns m)
  have hrr : r = r' := by rw [hr] at hr'; cases hr'; rfl
  subst hrr
  cases r with
  | Err e => cases h
  | Ok offset =>
    have hoff : offset.val = dagNin (ns.val.take m.val) := hP
    dsimp only at h
    split at h
    · cases h
    · obtain ⟨i2, hi2, h⟩ := bind_ok_inv h
      split at h
      · cases h
      · intro j hj
        rw [← hoff]
        exact check_input_value_sound inp offset w value h j hj

/-- Table entry `k` is bound: a mapped entry's image reads the advertised
    value. -/
def Bound (var_node var_width map : List Std.Usize) (ns : List blast_kernel.DagNode) (inp : List Bool)
    (values : List Std.U128) (k : Nat) : Prop :=
  img map (var_node.getD k 0#usize).val ≠ NONE →
    ∀ j < (var_width.getD k 0#usize).val,
      inp.getD (dagNin (ns.take (img map (var_node.getD k 0#usize).val).val) + j) false
        = (values.getD k 0#u128).val.testBit j

theorem check_tree_model_loop_ok (var_node var_width map : Slice Std.Usize)
    (ns : Slice blast_kernel.DagNode) (inp : Slice Bool) (values : Slice Std.U128) (n : Std.Usize) :
    ∀ (k : Std.Usize) (ok1 : Bool), k.val ≤ n.val →
      (ok1 = true → ∀ k' < k.val, Bound var_node.val var_width.val map.val ns.val inp.val values.val k') →
      ∀ r, kernel.term_kernel.check_tree_model_loop var_node var_width map ns inp values n k ok1 = ok r →
        r = true → ∀ k' < n.val, Bound var_node.val var_width.val map.val ns.val inp.val values.val k' := by
  intro k ok1 hk hinv r h
  unfold kernel.term_kernel.check_tree_model_loop at h
  refine loop_ok (α := Std.Usize × Bool) (β := Bool)
    (fun st => n.val - st.1.val)
    (fun st => st.1.val ≤ n.val ∧ (st.2 = true →
      ∀ k' < st.1.val, Bound var_node.val var_width.val map.val ns.val inp.val values.val k'))
    (fun y => y = true → ∀ k' < n.val, Bound var_node.val var_width.val map.val ns.val inp.val values.val k')
    _ ?_ (k, ok1) ⟨hk, hinv⟩ r h
  rintro ⟨k1, ok1⟩ ⟨hk1x, hinv1x⟩ r1 hb0
  have hk1 : k1.val ≤ n.val := hk1x
  have hinv1 : ok1 = true →
      ∀ k' < k1.val, Bound var_node.val var_width.val map.val ns.val inp.val values.val k' := hinv1x
  clear hk1x hinv1x
  have hb : kernel.term_kernel.check_tree_model_loop.body var_node var_width map ns inp values n k1 ok1
      = ok r1 := hb0
  unfold kernel.term_kernel.check_tree_model_loop.body at hb
  split at hb
  · rename_i hlt
    have hlt' : k1.val < n.val := hlt
    obtain ⟨i, hi, hb⟩ := bind_ok_inv hb
    obtain ⟨m, hm, hb⟩ := bind_ok_inv hb
    obtain ⟨ok2, hok2, hb⟩ := bind_ok_inv hb
    obtain ⟨k2, hk2, hb⟩ := bind_ok_inv hb
    cases hb
    refine ⟨fun y hy => (nomatch hy), fun x' hx' => ?_⟩
    cases hx'
    have hk2' : k2.val = k1.val + 1 := by simpa using add_ok hk2
    refine ⟨⟨?_, ?_⟩, ?_⟩
    · show k2.val ≤ n.val
      omega
    rotate_left
    · show n.val - k2.val < n.val - k1.val
      omega
    show ok2 = true → ∀ k' < k2.val, Bound var_node.val var_width.val map.val ns.val inp.val values.val k'
    intro hok k' hk'
    rw [map_at_eq] at hm
    cases hm
    obtain ⟨_, hi'⟩ := slice_index_ok hi
    rcases Nat.lt_or_ge k' k1.val with hlt2 | hge2
    · -- an earlier entry: `ok1` was true, since `ok2` only ever weakens
      refine hinv1 ?_ k' hlt2
      by_cases hmn : img map.val i.val = core.num.Usize.MAX
      · rw [hmn] at hok2
        simp at hok2
        rw [hok2]
        exact hok
      · have hne : (img map.val i.val != core.num.Usize.MAX) = true := by simpa using hmn
        rw [if_pos hne] at hok2
        obtain ⟨i1, _, hok2⟩ := bind_ok_inv hok2
        obtain ⟨i2, _, hok2⟩ := bind_ok_inv hok2
        obtain ⟨b, _, hok2⟩ := bind_ok_inv hok2
        split at hok2
        · cases hok2; exact hok
        · cases hok2; cases hok
    · have hkk : k' = k1.val := by omega
      subst hkk
      intro hne j hj
      rw [← hi' 0#usize] at hne ⊢
      have hne' : (img map.val i.val != core.num.Usize.MAX) = true := by simpa using hne
      rw [if_pos hne'] at hok2
      obtain ⟨i1, hi1, hok2⟩ := bind_ok_inv hok2
      obtain ⟨i2, hi2, hok2⟩ := bind_ok_inv hok2
      obtain ⟨b, hbnd, hok2⟩ := bind_ok_inv hok2
      obtain ⟨_, hi1'⟩ := slice_index_ok hi1
      obtain ⟨_, hi2'⟩ := slice_index_ok hi2
      split at hok2
      · rename_i hbt
        rw [hbt] at hbnd
        rw [← hi1' 0#usize] at hj
        rw [← hi2' 0#u128]
        exact bound_at_ok hbnd j hj
      · cases hok2; cases hok
  · rename_i hge
    cases hb
    refine ⟨fun y hy => ?_, fun x' hx' => (nomatch hx')⟩
    cases hy
    intro hok k' hk'
    have hge' : n.val ≤ k1.val := Nat.le_of_not_lt hge
    exact hinv1 hok k' (by omega)

/-- An accepted `check_tree_model` binds every table entry. -/
theorem check_tree_model_ok (var_node var_width map : Slice Std.Usize) (ns : Slice blast_kernel.DagNode)
    (inp : Slice Bool) (values : Slice Std.U128)
    (h : kernel.term_kernel.check_tree_model var_node var_width map ns inp values = ok true) :
    ∀ k < var_node.val.length, Bound var_node.val var_width.val map.val ns.val inp.val values.val k := by
  unfold kernel.term_kernel.check_tree_model at h
  dsimp only at h
  split at h
  · cases h
  · split at h
    · cases h
    · have := check_tree_model_loop_ok var_node var_width map ns inp values (Slice.len var_node) 0#usize true
        (by simp) (fun _ k' hk' => by simp at hk') true h rfl
      rw [slice_len_val] at this
      exact this

/-- Extended table entry `k` is bound: a mapped entry's image in the core
    is a variable of its width, and a mapped image reads the advertised
    value. -/
def BoundExt (var_node var_width emap : List Std.Usize) (t : List blast_kernel.DagNode)
    (map : List Std.Usize) (ns : List blast_kernel.DagNode) (inp : List Bool) (values : List Std.U128)
    (k : Nat) : Prop :=
  img emap (var_node.getD k 0#usize).val ≠ NONE →
    (img emap (var_node.getD k 0#usize).val).val < t.length ∧
    t.getD (img emap (var_node.getD k 0#usize).val).val dfltNode = .Var (var_width.getD k 0#usize) ∧
    (img map (img emap (var_node.getD k 0#usize).val).val ≠ NONE →
      ∀ j < (var_width.getD k 0#usize).val,
        inp.getD (dagNin (ns.take (img map (img emap (var_node.getD k 0#usize).val).val).val) + j) false
          = (values.getD k 0#u128).val.testBit j)

theorem check_tree_model_ext_loop_ok (var_node var_width emap : Slice Std.Usize)
    (t : Slice blast_kernel.DagNode) (map : Slice Std.Usize) (ns : Slice blast_kernel.DagNode)
    (inp : Slice Bool) (values : Slice Std.U128) (n : Std.Usize) :
    ∀ (k : Std.Usize) (ok1 : Bool), k.val ≤ n.val →
      (ok1 = true → ∀ k' < k.val,
        BoundExt var_node.val var_width.val emap.val t.val map.val ns.val inp.val values.val k') →
      ∀ r, kernel.term_kernel.check_tree_model_ext_loop var_node var_width emap t map ns inp values n k ok1
        = ok r →
        r = true → ∀ k' < n.val,
          BoundExt var_node.val var_width.val emap.val t.val map.val ns.val inp.val values.val k' := by
  intro k ok1 hk hinv r h
  unfold kernel.term_kernel.check_tree_model_ext_loop at h
  refine loop_ok (α := Std.Usize × Bool) (β := Bool)
    (fun st => n.val - st.1.val)
    (fun st => st.1.val ≤ n.val ∧ (st.2 = true → ∀ k' < st.1.val,
      BoundExt var_node.val var_width.val emap.val t.val map.val ns.val inp.val values.val k'))
    (fun y => y = true → ∀ k' < n.val,
      BoundExt var_node.val var_width.val emap.val t.val map.val ns.val inp.val values.val k')
    _ ?_ (k, ok1) ⟨hk, hinv⟩ r h
  rintro ⟨k1, ok1⟩ ⟨hk1x, hinv1x⟩ r1 hb0
  have hk1 : k1.val ≤ n.val := hk1x
  have hinv1 : ok1 = true → ∀ k' < k1.val,
      BoundExt var_node.val var_width.val emap.val t.val map.val ns.val inp.val values.val k' := hinv1x
  clear hk1x hinv1x
  have hb : kernel.term_kernel.check_tree_model_ext_loop.body var_node var_width emap t map ns inp values n
      k1 ok1 = ok r1 := hb0
  unfold kernel.term_kernel.check_tree_model_ext_loop.body at hb
  split at hb
  · rename_i hlt
    have hlt' : k1.val < n.val := hlt
    obtain ⟨i, hi, hb⟩ := bind_ok_inv hb
    obtain ⟨m1, hm1, hb⟩ := bind_ok_inv hb
    obtain ⟨ok2, hok2, hb⟩ := bind_ok_inv hb
    obtain ⟨k2, hk2, hb⟩ := bind_ok_inv hb
    cases hb
    refine ⟨fun y hy => (nomatch hy), fun x' hx' => ?_⟩
    cases hx'
    have hk2' : k2.val = k1.val + 1 := by simpa using add_ok hk2
    refine ⟨⟨?_, ?_⟩, ?_⟩
    · show k2.val ≤ n.val
      omega
    rotate_left
    · show n.val - k2.val < n.val - k1.val
      omega
    show ok2 = true → ∀ k' < k2.val,
      BoundExt var_node.val var_width.val emap.val t.val map.val ns.val inp.val values.val k'
    intro hok k' hk'
    rw [map_at_eq] at hm1
    cases hm1
    obtain ⟨_, hi'⟩ := slice_index_ok hi
    -- what the accepted step establishes about entry `k1` and `ok1`
    have hstep : ok1 = true ∧
        BoundExt var_node.val var_width.val emap.val t.val map.val ns.val inp.val values.val k1.val := by
      by_cases hmn : img emap.val i.val = core.num.Usize.MAX
      · rw [hmn] at hok2
        simp at hok2
        refine ⟨by rw [hok2]; exact hok, ?_⟩
        intro hne
        rw [← hi' 0#usize] at hne
        exact absurd hmn hne
      · have hne : (img emap.val i.val != core.num.Usize.MAX) = true := by simpa using hmn
        rw [if_pos hne] at hok2
        dsimp only at hok2
        split at hok2
        · cases hok2; cases hok
        · rename_i hlen
          obtain ⟨tn, htn, hok2⟩ := bind_ok_inv hok2
          obtain ⟨i2, hi2, hok2⟩ := bind_ok_inv hok2
          obtain ⟨b, hbv, hok2⟩ := bind_ok_inv hok2
          obtain ⟨ok3, hok3, hok2⟩ := bind_ok_inv hok2
          obtain ⟨m, hm, hok2⟩ := bind_ok_inv hok2
          rw [map_at_eq] at hm
          cases hm
          obtain ⟨htl, htn'⟩ := slice_index_ok htn
          obtain ⟨_, hi2'⟩ := slice_index_ok hi2
          -- `ok3 = true → b = true ∧ ok1 = true`
          have hok3' : ok3 = true → b = true ∧ ok1 = true := by
            intro h3
            split at hok3
            · rename_i hb; cases hok3; exact ⟨hb, h3⟩
            · cases hok3; cases h3
          by_cases hmn2 : img map.val (img emap.val i.val).val = core.num.Usize.MAX
          · rw [hmn2] at hok2
            simp at hok2
            obtain ⟨hbt, hok1⟩ := hok3' (by rw [hok2]; exact hok)
            rw [hbt] at hbv
            refine ⟨hok1, ?_⟩
            intro _
            rw [← hi' 0#usize]
            refine ⟨htl, ?_, fun hne2 => absurd hmn2 hne2⟩
            rw [← htn' dfltNode, var_of_width_ok hbv, hi2' 0#usize]
          · have hne2 : (img map.val (img emap.val i.val).val != core.num.Usize.MAX) = true := by
              simpa using hmn2
            rw [if_pos hne2] at hok2
            obtain ⟨i3, hi3, hok2⟩ := bind_ok_inv hok2
            obtain ⟨b1, hbnd, hok2⟩ := bind_ok_inv hok2
            obtain ⟨_, hi3'⟩ := slice_index_ok hi3
            split at hok2
            · rename_i hb1
              cases hok2
              obtain ⟨hbt, hok1⟩ := hok3' hok
              rw [hbt] at hbv
              rw [hb1] at hbnd
              refine ⟨hok1, ?_⟩
              intro _
              rw [← hi' 0#usize]
              refine ⟨htl, ?_, fun _ j hj => ?_⟩
              · rw [← htn' dfltNode, var_of_width_ok hbv, hi2' 0#usize]
              · rw [← hi2' 0#usize] at hj
                rw [← hi3' 0#u128]
                exact bound_at_ok hbnd j hj
            · cases hok2; cases hok
    rcases Nat.lt_or_ge k' k1.val with hlt2 | hge2
    · exact hinv1 hstep.1 k' hlt2
    · have hkk : k' = k1.val := by omega
      subst hkk
      exact hstep.2
  · rename_i hge
    cases hb
    refine ⟨fun y hy => ?_, fun x' hx' => (nomatch hx')⟩
    cases hy
    intro hok k' hk'
    have hge' : n.val ≤ k1.val := Nat.le_of_not_lt hge
    exact hinv1 hok k' (by omega)

/-- An accepted `check_tree_model_ext` binds every table entry. -/
theorem check_tree_model_ext_ok (var_node var_width emap : Slice Std.Usize)
    (t : Slice blast_kernel.DagNode) (map : Slice Std.Usize) (ns : Slice blast_kernel.DagNode)
    (inp : Slice Bool) (values : Slice Std.U128)
    (h : kernel.term_kernel.check_tree_model_ext var_node var_width emap t map ns inp values = ok true) :
    ∀ k < var_node.val.length,
      BoundExt var_node.val var_width.val emap.val t.val map.val ns.val inp.val values.val k := by
  unfold kernel.term_kernel.check_tree_model_ext at h
  dsimp only at h
  split at h
  · cases h
  · split at h
    · cases h
    · have := check_tree_model_ext_loop_ok var_node var_width emap t map ns inp values (Slice.len var_node)
        0#usize true (by simp) (fun _ k' hk' => by simp at hk') true h rfl
      rw [slice_len_val] at this
      exact this

/- ══════════════════ THE CAPSTONES: CLOSED TREES ══════════════════ -/

theorem getElem_of_getD {α : Type} {l : List α} {i : Nat} (hi : i < l.length) {d x : α}
    (h : l.getD i d = x) : l[i] = x := by
  rw [← getD_eq_getElem_of_lt hi d]
  exact h

/-- In a closed flattening, every table entry's node is a `Var` of its
    width in the projected term. -/
theorem core_var_of_table {f : Flat} (hI : Inv f) {t : List blast_kernel.DagNode}
    (hcore : f.nodes.val = t.map .Core) {k : Nat} (hk : k < nvars f) :
    varNodeOf f k < t.length ∧
      t.getD (varNodeOf f k) dfltNode = .Var (f.var_width.val.getD k 0#usize) := by
  have hlt := hI.var_node_lt k hk
  rw [hcore, List.length_map] at hlt
  refine ⟨hlt, ?_⟩
  have hv := hI.var_is_var k hk
  rw [hcore, getD_eq_getElem_of_lt (by rw [List.length_map]; exact hlt) dfltExt, List.getElem_map] at hv
  rw [getD_eq_getElem_of_lt hlt dfltNode]
  injection hv

/-- A model of the projected term, read back through the table, satisfies
    the trees — under EVERY interpretation, the trees being closed. -/
theorem tree_sat_of_model (ts : Slice TBool) (f : Flat) (e : Slice ExtNode)
    (t : alloc.vec.Vec blast_kernel.DagNode) (tS : Slice blast_kernel.DagNode) (tbits : Slice Bool)
    (troots : Slice Std.Usize) (inp0 : List Bool)
    (hf : kernel.term_kernel.flatten_tree ts = ok (.Ok f)) (he : e.val = f.nodes.val)
    (hp : kernel.term_kernel.project_core e = ok (.Ok t)) (htS : tS.val = t.val)
    (htb : tbits.val = f.bits.val) (htr : troots.val = f.roots.val)
    (hall : ∀ k (hk : k < troots.val.length), dagBool inp0 tbits.val tS.val (troots.val[k]).val = true) :
    ∀ (arrs : NArrs) (ufs : NUfs), TreeSat (envOf f inp0) arrs ufs ts.val := by
  obtain ⟨hI, hlen, hs⟩ := flatten_tree_sound ts f hf
  have hcore : f.nodes.val = t.val.map .Core := by rw [← he]; exact project_core_ok e t hp
  have hV := envOf_agree hI inp0
  intro arrs ufs k hk
  rw [← hs (envOf f inp0) arrs ufs inp0 hV k hk]
  have hk' : k < troots.val.length := by rw [htr, hlen]; exact hk
  have h1 := hall k hk'
  unfold dagBool at h1
  have hr : (troots.val[k]).val = rootOf f k := by
    unfold rootOf
    rw [← htr, getD_eq_getElem_of_lt hk']
  rw [hr, htb, htS] at h1
  unfold extBool
  rw [hcore, extSim_map_core]
  exact h1

/-- **THE UNSAT CAPSTONE FOR CLOSED TREES**: an accepted flattening, an
    accepted core projection, an accepted term check and an accepted
    query re-check refute the TREES AS THE CALLER BUILT THEM — no
    environment (a value per name and width), under any interpretation,
    makes every asserted tree true. -/
theorem tree_unsat_sound (ts : Slice TBool) (f : Flat) (e : Slice ExtNode)
    (t : alloc.vec.Vec blast_kernel.DagNode) (tS : Slice blast_kernel.DagNode) (tbits : Slice Bool)
    (troots map : Slice Std.Usize) (ns : Slice blast_kernel.DagNode) (bits : Slice Bool)
    (roots hints : Slice Std.Usize) (steps : Slice kernel.Step)
    (cnf : alloc.vec.Vec (alloc.vec.Vec Std.I32))
    (hf : kernel.term_kernel.flatten_tree ts = ok (.Ok f)) (he : e.val = f.nodes.val)
    (hp : kernel.term_kernel.project_core e = ok (.Ok t)) (htS : tS.val = t.val)
    (htb : tbits.val = f.bits.val) (htr : troots.val = f.roots.val)
    (ht : kernel.check_term_dag tS tbits troots map ns bits roots = ok (core.result.Result.Ok ()))
    (hq : kernel.check_query ns bits roots hints steps = ok (core.result.Result.Ok cnf)) :
    ∀ (env : TEnv) (arrs : NArrs) (ufs : NUfs), ¬ TreeSat env arrs ufs ts.val := by
  intro env arrs ufs hsat
  obtain ⟨hI, hlen, hs⟩ := flatten_tree_sound ts f hf
  obtain ⟨inp0, hV⟩ := layout_exists hI env
  have hcore : f.nodes.val = t.val.map .Core := by rw [← he]; exact project_core_ok e t hp
  apply check_term_unsat_sound tS tbits troots map ns bits roots hints steps cnf ht hq inp0
  intro k hk
  have hk' : k < ts.val.length := by rw [← hlen, ← htr]; exact hk
  have h1 := hsat k hk'
  rw [← hs env arrs ufs inp0 hV k hk'] at h1
  unfold extBool at h1
  rw [hcore, extSim_map_core] at h1
  have hr : (troots.val[k]).val = rootOf f k := by
    unfold rootOf
    rw [← htr, getD_eq_getElem_of_lt hk]
  unfold dagBool
  rw [hr, htb, htS]
  exact h1

/-- **THE SAT CAPSTONE FOR CLOSED TREES**: an accepted flattening, an
    accepted core projection, an accepted term check, an accepted model
    re-check and an accepted model binding give an environment under
    which every asserted tree is true (whatever the interpretations — the
    trees are closed), bound BY NAME: every table entry the DAG kept reads
    the value advertised under its name. -/
theorem tree_model_sound (ts : Slice TBool) (f : Flat) (e : Slice ExtNode)
    (t : alloc.vec.Vec blast_kernel.DagNode) (tS : Slice blast_kernel.DagNode) (tbits : Slice Bool)
    (troots map : Slice Std.Usize) (ns : Slice blast_kernel.DagNode) (bits : Slice Bool)
    (roots : Slice Std.Usize) (inp2 : Slice Bool) (vn vw : Slice Std.Usize) (values : Slice Std.U128)
    (hf : kernel.term_kernel.flatten_tree ts = ok (.Ok f)) (he : e.val = f.nodes.val)
    (hp : kernel.term_kernel.project_core e = ok (.Ok t)) (htS : tS.val = t.val)
    (htb : tbits.val = f.bits.val) (htr : troots.val = f.roots.val)
    (ht : kernel.check_term_dag tS tbits troots map ns bits roots = ok (core.result.Result.Ok ()))
    (hm : kernel.check_query_model ns bits roots inp2 = ok (core.result.Result.Ok ()))
    (hvn : vn.val = f.var_node.val) (hvw : vw.val = f.var_width.val)
    (hb : kernel.term_kernel.check_tree_model vn vw map ns inp2 values = ok true) :
    ∃ env : TEnv, (∀ (arrs : NArrs) (ufs : NUfs), TreeSat env arrs ufs ts.val) ∧
      ∀ k < nvars f, img map.val (varNodeOf f k) ≠ NONE →
        env (varName f k) (varWidthOf f k)
          = BitVec.ofNat (varWidthOf f k) (values.val.getD k 0#u128).val := by
  obtain ⟨inp0, hva, hall⟩ := check_term_model_sound tS tbits troots map ns bits roots inp2 ht hm
  obtain ⟨hI, _, _⟩ := flatten_tree_sound ts f hf
  have hcore : f.nodes.val = t.val.map .Core := by rw [← he]; exact project_core_ok e t hp
  have hV := envOf_agree hI inp0
  refine ⟨envOf f inp0, tree_sat_of_model ts f e t tS tbits troots inp0 hf he hp htS htb htr hall,
    fun k hk hne => ?_⟩
  have hbound := check_tree_model_ok vn vw map ns inp2 values hb k (by rw [hvn]; exact hk)
  unfold Bound at hbound
  rw [hvn, hvw] at hbound
  have hbound' : img map.val (varNodeOf f k) ≠ NONE → ∀ j < varWidthOf f k,
      inp2.val.getD (dagNin (ns.val.take (img map.val (varNodeOf f k)).val) + j) false
        = (values.val.getD k 0#u128).val.testBit j := hbound
  obtain ⟨hil, hvar⟩ := core_var_of_table hI hcore hk
  have hil' : varNodeOf f k < tS.val.length := by rw [htS]; exact hil
  have hvar' : tS.val.getD (varNodeOf f k) dfltNode = .Var (f.var_width.val.getD k 0#usize) := by
    rw [htS]; exact hvar
  have hva' := hva (varNodeOf f k) hil' _ (getElem_of_getD hil' hvar') hne
  apply BitVec.eq_of_getLsbD_eq
  intro j hj
  rw [← hV k hk j hj, BitVec.getLsbD_ofNat, decide_eq_true hj, Bool.true_and, ← hbound' hne j hj,
    ← hva' j hj, hcore, ← List.map_take, extNin_map_core, htS]

/-- **No closed tree set has both an accepted refutation and an accepted
    model** — at the tree level: the model's environment satisfies what
    the refutation refutes. -/
theorem tree_verdicts_exclusive (ts : Slice TBool) (f : Flat) (e : Slice ExtNode)
    (t : alloc.vec.Vec blast_kernel.DagNode) (tS : Slice blast_kernel.DagNode) (tbits : Slice Bool)
    (troots map : Slice Std.Usize) (ns : Slice blast_kernel.DagNode) (bits : Slice Bool)
    (roots hints : Slice Std.Usize) (steps : Slice kernel.Step)
    (cnf : alloc.vec.Vec (alloc.vec.Vec Std.I32)) (inp2 : Slice Bool)
    (hf : kernel.term_kernel.flatten_tree ts = ok (.Ok f)) (he : e.val = f.nodes.val)
    (hp : kernel.term_kernel.project_core e = ok (.Ok t)) (htS : tS.val = t.val)
    (htb : tbits.val = f.bits.val) (htr : troots.val = f.roots.val)
    (ht : kernel.check_term_dag tS tbits troots map ns bits roots = ok (core.result.Result.Ok ()))
    (hq : kernel.check_query ns bits roots hints steps = ok (core.result.Result.Ok cnf))
    (hm : kernel.check_query_model ns bits roots inp2 = ok (core.result.Result.Ok ())) : False := by
  obtain ⟨inp0, _, hall⟩ := check_term_model_sound tS tbits troots map ns bits roots inp2 ht hm
  exact tree_unsat_sound ts f e t tS tbits troots map ns bits roots hints steps cnf hf he hp htS htb htr
    ht hq (envOf f inp0) (fun _ _ => 0#8) (fun _ _ => dDflt)
    (tree_sat_of_model ts f e t tS tbits troots inp0 hf he hp htS htb htr hall _ _)

/- ══════════════════ THE CAPSTONES: EXTENDED TREES ══════════════════ -/

/-- A model of the flat extended query, read back through the tables,
    satisfies the trees. -/
theorem ext_tree_sat_of_model (ts : Slice TBool) (f : Flat) (e : Slice ExtNode) (ebits : Slice Bool)
    (eside eroots : Slice Std.Usize) (inp0 : List Bool) (arrs : Arrs) (ufs : Ufs)
    (hf : kernel.term_kernel.flatten_tree ts = ok (.Ok f)) (he : e.val = f.nodes.val)
    (heb : ebits.val = f.bits.val) (hes : eside.val = f.side.val) (her : eroots.val = f.roots.val)
    (hsat : ExtSat inp0 ebits.val arrs ufs eside.val e.val eroots.val) :
    TreeSat (envOf f inp0) (narrsOf f arrs) (nufsOf f ufs) ts.val := by
  obtain ⟨hI, _, _⟩ := flatten_tree_sound ts f hf
  have hV := envOf_agree hI inp0
  refine (flatten_tree_sat_iff ts f hf _ _ _ inp0 hV).1 ?_
  intro k hk
  have hk' : k < eroots.val.length := by rw [her]; exact hk
  have h1 := hsat k hk'
  rw [← getD_eq_getElem_of_lt hk' 0#usize, her, heb, hes, he] at h1
  rw [← getD_eq_getElem_of_lt hk 0#usize]
  unfold extBool at h1 ⊢
  show bval ((simOf f (envOf f inp0) (narrsOf f arrs) (nufsOf f ufs) inp0).getD _ dDflt) = true
  rw [simOf_congr hI (envOf f inp0) inp0 arrs ufs (narrsOf f arrs) (nufsOf f ufs) (narrsOf_eq hI arrs) (nufsOf_eq hI ufs)]
  exact h1

/-- **THE UNSAT CAPSTONE FOR EXTENDED TREES**: an accepted flattening, an
    accepted sliver check, an accepted term check and an accepted query
    re-check refute the EXTENDED TREES AS THE CALLER BUILT THEM — under
    every environment, every array interpretation and every UF
    interpretation, all BY NAME. -/
theorem ext_tree_unsat_sound (ts : Slice TBool) (f : Flat) (e : Slice ExtNode) (ebits : Slice Bool)
    (eside eroots map reads calls cargs : Slice Std.Usize) (t : Slice blast_kernel.DagNode)
    (tbits : Slice Bool) (troots map1 : Slice Std.Usize) (ns : Slice blast_kernel.DagNode)
    (bits : Slice Bool) (roots hints : Slice Std.Usize) (steps : Slice kernel.Step)
    (cnf : alloc.vec.Vec (alloc.vec.Vec Std.I32))
    (hf : kernel.term_kernel.flatten_tree ts = ok (.Ok f)) (he : e.val = f.nodes.val)
    (heb : ebits.val = f.bits.val) (hes : eside.val = f.side.val) (her : eroots.val = f.roots.val)
    (hs : kernel.sliver_kernel.check_sliver_lowering e ebits eside eroots map reads calls cargs t tbits
      troots = ok (core.result.Result.Ok ()))
    (ht : kernel.check_term_dag t tbits troots map1 ns bits roots = ok (core.result.Result.Ok ()))
    (hq : kernel.check_query ns bits roots hints steps = ok (core.result.Result.Ok cnf)) :
    ∀ (env : TEnv) (arrs : NArrs) (ufs : NUfs), ¬ TreeSat env arrs ufs ts.val := by
  intro env arrs ufs hsat
  obtain ⟨hI, _, _⟩ := flatten_tree_sound ts f hf
  obtain ⟨inp0, hV⟩ := layout_exists hI env
  have hext := (flatten_tree_sat_iff ts f hf env arrs ufs inp0 hV).2 hsat
  rw [← he, ← heb, ← hes, ← her] at hext
  exact check_sliver_unsat_sound e ebits eside eroots map reads calls cargs t tbits troots map1 ns bits
    roots hints steps cnf hs ht hq inp0 (arrsI f arrs) (ufsI f ufs) hext

/-- **THE SAT CAPSTONE FOR EXTENDED TREES**: an accepted flattening, an
    accepted sliver check, an accepted term check, an accepted model
    re-check and an accepted extended model binding give an environment,
    an array interpretation and a UF interpretation BY NAME under which
    every asserted extended tree is true — the interpretations being the
    id-keyed ones TR-072 binds to the model's reads and calls, read
    through the tables, and every variable the two maps kept bound to the
    value advertised under its name. -/
theorem ext_tree_model_sound (ts : Slice TBool) (f : Flat) (e : Slice ExtNode) (ebits : Slice Bool)
    (eside eroots map reads calls cargs : Slice Std.Usize) (t : Slice blast_kernel.DagNode)
    (tbits : Slice Bool) (troots map1 : Slice Std.Usize) (ns : Slice blast_kernel.DagNode)
    (bits : Slice Bool) (roots : Slice Std.Usize) (inp2 : Slice Bool) (vn vw : Slice Std.Usize)
    (values : Slice Std.U128)
    (hf : kernel.term_kernel.flatten_tree ts = ok (.Ok f)) (he : e.val = f.nodes.val)
    (heb : ebits.val = f.bits.val) (hes : eside.val = f.side.val) (her : eroots.val = f.roots.val)
    (hs : kernel.sliver_kernel.check_sliver_lowering e ebits eside eroots map reads calls cargs t tbits
      troots = ok (core.result.Result.Ok ()))
    (ht : kernel.check_term_dag t tbits troots map1 ns bits roots = ok (core.result.Result.Ok ()))
    (hm : kernel.check_query_model ns bits roots inp2 = ok (core.result.Result.Ok ()))
    (hvn : vn.val = f.var_node.val) (hvw : vw.val = f.var_width.val)
    (hb : kernel.term_kernel.check_tree_model_ext vn vw map t map1 ns inp2 values = ok true) :
    ∃ (env : TEnv) (narrs' : NArrs) (nufs' : NUfs) (arrs : Arrs) (ufs : Ufs) (inp1 : List Bool),
      TreeSat env narrs' nufs' ts.val ∧
      TablesAgree t.val tbits.val reads.val calls.val cargs.val arrs ufs inp1 ∧
      (∀ a < narrs f, narrs' (arrName f a) = arrs a) ∧
      (∀ g < nfuncs f, nufs' (funName f g) = ufs g) ∧
      ∀ k < nvars f, img map.val (varNodeOf f k) ≠ NONE →
        img map1.val (img map.val (varNodeOf f k)).val ≠ NONE →
          env (varName f k) (varWidthOf f k)
            = BitVec.ofNat (varWidthOf f k) (values.val.getD k 0#u128).val := by
  obtain ⟨inp0, inp1, arrs, ufs, hva, heva, hta, hsat⟩ := check_sliver_model_sound e ebits eside eroots
    map reads calls cargs t tbits troots map1 ns bits roots inp2 hs ht hm
  obtain ⟨hI, _, _⟩ := flatten_tree_sound ts f hf
  have hV := envOf_agree hI inp0
  refine ⟨envOf f inp0, narrsOf f arrs, nufsOf f ufs, arrs, ufs, inp1,
    ext_tree_sat_of_model ts f e ebits eside eroots inp0 arrs ufs hf he heb hes her hsat, hta,
    narrsOf_eq hI arrs, nufsOf_eq hI ufs, fun k hk hne1 hne2 => ?_⟩
  have hbound := check_tree_model_ext_ok vn vw map t map1 ns inp2 values hb k (by rw [hvn]; exact hk)
  unfold BoundExt at hbound
  rw [hvn, hvw] at hbound
  have hbound' : img map.val (varNodeOf f k) ≠ NONE →
      (img map.val (varNodeOf f k)).val < t.val.length ∧
      t.val.getD (img map.val (varNodeOf f k)).val dfltNode = .Var (f.var_width.val.getD k 0#usize) ∧
      (img map1.val (img map.val (varNodeOf f k)).val ≠ NONE → ∀ j < varWidthOf f k,
        inp2.val.getD (dagNin (ns.val.take (img map1.val (img map.val (varNodeOf f k)).val).val) + j) false
          = (values.val.getD k 0#u128).val.testBit j) := hbound
  obtain ⟨hm1l, hvar, hbind⟩ := hbound' hne1
  have hil : varNodeOf f k < e.val.length := by rw [he]; exact hI.var_node_lt k hk
  have hvar0 : e.val[varNodeOf f k] = .Core (.Var (f.var_width.val.getD k 0#usize)) := by
    rw [← getD_eq_getElem_of_lt hil dfltExt, he]
    exact hI.var_is_var k hk
  have heva' := heva (varNodeOf f k) hil _ hvar0 hne1
  have hva' := hva (img map.val (varNodeOf f k)).val hm1l _ (getElem_of_getD hm1l hvar) hne2
  apply BitVec.eq_of_getLsbD_eq
  intro j hj
  rw [← hV k hk j hj, BitVec.getLsbD_ofNat, decide_eq_true hj, Bool.true_and, ← hbind hne2 j hj,
    ← hva' j hj, ← heva' j hj, he]

/-- **No extended tree set has both an accepted refutation and an
    accepted model** — at the tree level. -/
theorem ext_tree_verdicts_exclusive (ts : Slice TBool) (f : Flat) (e : Slice ExtNode) (ebits : Slice Bool)
    (eside eroots map reads calls cargs : Slice Std.Usize) (t : Slice blast_kernel.DagNode)
    (tbits : Slice Bool) (troots map1 : Slice Std.Usize) (ns : Slice blast_kernel.DagNode)
    (bits : Slice Bool) (roots hints : Slice Std.Usize) (steps : Slice kernel.Step)
    (cnf : alloc.vec.Vec (alloc.vec.Vec Std.I32)) (inp2 : Slice Bool)
    (hf : kernel.term_kernel.flatten_tree ts = ok (.Ok f)) (he : e.val = f.nodes.val)
    (heb : ebits.val = f.bits.val) (hes : eside.val = f.side.val) (her : eroots.val = f.roots.val)
    (hs : kernel.sliver_kernel.check_sliver_lowering e ebits eside eroots map reads calls cargs t tbits
      troots = ok (core.result.Result.Ok ()))
    (ht : kernel.check_term_dag t tbits troots map1 ns bits roots = ok (core.result.Result.Ok ()))
    (hq : kernel.check_query ns bits roots hints steps = ok (core.result.Result.Ok cnf))
    (hm : kernel.check_query_model ns bits roots inp2 = ok (core.result.Result.Ok ())) : False := by
  obtain ⟨inp0, _, arrs, ufs, _, _, _, hsat⟩ := check_sliver_model_sound e ebits eside eroots map reads
    calls cargs t tbits troots map1 ns bits roots inp2 hs ht hm
  exact ext_tree_unsat_sound ts f e ebits eside eroots map reads calls cargs t tbits troots map1 ns bits
    roots hints steps cnf hf he heb hes her hs ht hq _ _ _
    (ext_tree_sat_of_model ts f e ebits eside eroots inp0 arrs ufs hf he heb hes her hsat)

end kernel.spec
