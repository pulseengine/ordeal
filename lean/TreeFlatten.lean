/- The proven flattener (TR-073): `kernel::term_kernel::flatten_tree` is
   sound — the answer rests on the query AS THE CALLER BUILT IT.

   This file is HAND-WRITTEN (Kernel.lean is generated by regen.sh and must
   not be edited). Phase 7 (TermCheck.lean) and TR-072 (SliverCheck.lean)
   prove the term and the extended query a certificate carries; both are
   NODE LISTS, and the step from the caller's TREE — `BoolTerm` /
   `ExtBoolTerm`, variables, arrays and functions by NAME — to those lists
   was untrusted Rust. `flatten_tree` is that step in the kernel, over the
   kernel's own tree type; this file gives the tree a semantics
   (`treeBv` / `treeBool`: `dagNodeVal`'s arms over the children's values,
   an environment keyed by name and width, array and function
   interpretations keyed by name) and proves:

   * `flatten_tree_sound`: every root of the flattening denotes the tree it
     came from, under assignments that agree through the variable table
     (`VarAgree`), and such assignments transport both ways (a layout from
     an environment; an environment read back from a layout, well defined
     because the table's names are injective — the kernel's lookup
     establishes it, so F2 of docs/design/flattener-proof.md cannot arise).
   * The capstones, composed with the unchanged phase-7 / TR-072 theorems:
     `tree_unsat_sound` / `tree_model_sound` (closed trees, through
     `project_core` and `check_term_dag`), `ext_tree_unsat_sound` /
     `ext_tree_model_sound` (extended trees, through `check_sliver_lowering`),
     with the model bound BY NAME through the kernel's own table
     (`check_tree_model`, `check_tree_model_ext`).

   Proof architecture: the flattener is recursive (Aeneas `partial_fixpoint`
   definitions, new to this project); every statement is partial
   correctness (`= ok … → …`), proved by structural induction on the tree
   with the definitions unfolded. The invariant of a flattening state
   (`Inv`) is structural; the semantic conclusion of flattening a subtree
   (`TreeCorr`) is stated for EVERY later state (`Later`: every table only
   grows), which is what lets a parent use its children's values in its
   own state without separate stability lemmas. -/
import SliverCheck

open Aeneas Aeneas.Std Result
open kernel.blast_kernel.spec

set_option maxHeartbeats 4000000

namespace kernel.spec

open kernel.term_kernel (TBv TArray TArgs TBool Flat FlatError)

/- ══════════════════ NAMES AND INTERPRETATIONS ══════════════════ -/

/-- A name: the bytes of the caller's `String`. -/
abbrev Name := List Std.U8

/-- A tree assignment: a value for every name at every width (a name is
    refused at two widths, so on an accepted tree this is a value per name). -/
abbrev TEnv := Name → (w : Nat) → BitVec w

/-- An array interpretation by name. -/
abbrev NArrs := Name → BitVec 32 → BitVec 8

/-- A UF interpretation by name (coerced to the call's width, as `Ufs`). -/
abbrev NUfs := Name → List DVal → DVal

/-- `arena[start .. start + len]`. -/
def nameAt (arena : List Std.U8) (start len : Nat) : Name := (arena.drop start).take len

/-- The `k`-th variable's name, width and node in a flattening. -/
def varName (f : Flat) (k : Nat) : Name :=
  nameAt f.names.val (f.name_start.val.getD k 0#usize).val (f.name_len.val.getD k 0#usize).val
def varWidthOf (f : Flat) (k : Nat) : Nat := (f.var_width.val.getD k 0#usize).val
def varNodeOf (f : Flat) (k : Nat) : Nat := (f.var_node.val.getD k 0#usize).val
def nvars (f : Flat) : Nat := f.var_node.val.length

/-- Array id `a`'s name; function id `g`'s name and result width. -/
def arrName (f : Flat) (a : Nat) : Name :=
  nameAt f.anames.val (f.aname_start.val.getD a 0#usize).val (f.aname_len.val.getD a 0#usize).val
def narrs (f : Flat) : Nat := f.aname_start.val.length
def funName (f : Flat) (g : Nat) : Name :=
  nameAt f.fnames.val (f.fname_start.val.getD g 0#usize).val (f.fname_len.val.getD g 0#usize).val
def nfuncs (f : Flat) : Nat := f.fname_start.val.length

/-- The by-id interpretations the extended semantics reads, from the
    by-name ones through the tables. -/
def arrsI (f : Flat) (arrs : NArrs) : Arrs := fun aid => arrs (arrName f aid)
def ufsI (f : Flat) (ufs : NUfs) : Ufs := fun fid => ufs (funName f fid)

/-- The `k`-th constant's value, width and node. -/
def constValOf (f : Flat) (k : Nat) : Nat := (f.const_value.val.getD k 0#u128).val
def constWidthOf (f : Flat) (k : Nat) : Nat := (f.const_width.val.getD k 0#usize).val
def constNodeOf (f : Flat) (k : Nat) : Nat := (f.const_node.val.getD k 0#usize).val
def nconsts (f : Flat) : Nat := f.const_node.val.length

/- ══════════════════ THE TREE SEMANTICS ══════════════════ -/

/-- `dagNodeVal`'s width-preserving binary arms, by the tag `bin_node` uses. -/
def binVal (op : Nat) (x y : DVal) : DVal :=
  match op with
  | 0 => ⟨x.1, x.2 + toW x.1 y⟩
  | 1 => ⟨x.1, x.2 - toW x.1 y⟩
  | 2 => ⟨x.1, x.2 * toW x.1 y⟩
  | 3 => ⟨x.1, x.2.smtUDiv (toW x.1 y)⟩
  | 4 => ⟨x.1, x.2 % toW x.1 y⟩
  | 5 => ⟨x.1, x.2 &&& toW x.1 y⟩
  | 6 => ⟨x.1, x.2 ||| toW x.1 y⟩
  | 7 => ⟨x.1, x.2 ^^^ toW x.1 y⟩
  | 8 => ⟨x.1, x.2 <<< (toW x.1 y).toNat⟩
  | 9 => ⟨x.1, x.2 >>> (toW x.1 y).toNat⟩
  | 10 => ⟨x.1, x.2.sshiftRight (toW x.1 y).toNat⟩
  | 11 => ⟨x.1, x.2.rotateRight ((toW x.1 y).toNat % x.1)⟩
  | 12 => ⟨x.1, x.2.rotateLeft ((toW x.1 y).toNat % x.1)⟩
  | 13 => ⟨x.1, x.2.smtSDiv (toW x.1 y)⟩
  | _ => ⟨x.1, x.2.srem (toW x.1 y)⟩

/-- `dagNodeVal`'s comparison arms, by the tag `cmp_node` uses. -/
def cmpVal (op : Nat) (x y : DVal) : DVal :=
  match op with
  | 0 => bvBool (decide (x.2 = toW x.1 y))
  | 1 => bvBool (decide (x.2 ≠ toW x.1 y))
  | 2 => bvBool (decide (x.2 < toW x.1 y))
  | 3 => bvBool (decide (x.2 ≤ toW x.1 y))
  | 4 => bvBool (decide (toW x.1 y < x.2))
  | 5 => bvBool (decide (toW x.1 y ≤ x.2))
  | 6 => bvBool (x.2.slt (toW x.1 y))
  | 7 => bvBool (x.2.sle (toW x.1 y))
  | 8 => bvBool ((toW x.1 y).slt x.2)
  | _ => bvBool ((toW x.1 y).sle x.2)

mutual
/-- The value of a bitvector tree: `dagNodeVal`'s arm over the children's
    values; a constant's low `w` bits; a variable from the environment by
    name and width; a `select` through the store chain by name; a call
    through the UF by name, coerced to the declared width. -/
def treeBv (env : TEnv) (arrs : NArrs) (ufs : NUfs) : TBv → DVal
  | .Const v w => ⟨w.val, bvOfFn (fun j => v.val.testBit j) w.val⟩
  | .Var n w => ⟨w.val, env n.val w.val⟩
  | .Add a b => binVal 0 (treeBv env arrs ufs a) (treeBv env arrs ufs b)
  | .Sub a b => binVal 1 (treeBv env arrs ufs a) (treeBv env arrs ufs b)
  | .Mul a b => binVal 2 (treeBv env arrs ufs a) (treeBv env arrs ufs b)
  | .Udiv a b => binVal 3 (treeBv env arrs ufs a) (treeBv env arrs ufs b)
  | .Urem a b => binVal 4 (treeBv env arrs ufs a) (treeBv env arrs ufs b)
  | .And a b => binVal 5 (treeBv env arrs ufs a) (treeBv env arrs ufs b)
  | .Or a b => binVal 6 (treeBv env arrs ufs a) (treeBv env arrs ufs b)
  | .Xor a b => binVal 7 (treeBv env arrs ufs a) (treeBv env arrs ufs b)
  | .Shl a b => binVal 8 (treeBv env arrs ufs a) (treeBv env arrs ufs b)
  | .Lshr a b => binVal 9 (treeBv env arrs ufs a) (treeBv env arrs ufs b)
  | .Ashr a b => binVal 10 (treeBv env arrs ufs a) (treeBv env arrs ufs b)
  | .Rotr a b => binVal 11 (treeBv env arrs ufs a) (treeBv env arrs ufs b)
  | .Extract hi lo a =>
    ⟨hi.val - lo.val + 1, (treeBv env arrs ufs a).2.extractLsb hi.val lo.val⟩
  | .Concat a b =>
    ⟨(treeBv env arrs ufs a).1 + (treeBv env arrs ufs b).1,
      (treeBv env arrs ufs a).2 ++ (treeBv env arrs ufs b).2⟩
  | .ZeroExt by1 a =>
    ⟨(treeBv env arrs ufs a).1 + by1.val,
      (treeBv env arrs ufs a).2.setWidth ((treeBv env arrs ufs a).1 + by1.val)⟩
  | .SignExt by1 a =>
    ⟨(treeBv env arrs ufs a).1 + by1.val,
      (treeBv env arrs ufs a).2.signExtend ((treeBv env arrs ufs a).1 + by1.val)⟩
  | .Ite c a b =>
    ⟨(treeBv env arrs ufs a).1,
      if treeBool env arrs ufs c then (treeBv env arrs ufs a).2
      else toW (treeBv env arrs ufs a).1 (treeBv env arrs ufs b)⟩
  | .BvNot a => ⟨(treeBv env arrs ufs a).1, ~~~(treeBv env arrs ufs a).2⟩
  | .Neg a => ⟨(treeBv env arrs ufs a).1, -(treeBv env arrs ufs a).2⟩
  | .Rotl a b => binVal 12 (treeBv env arrs ufs a) (treeBv env arrs ufs b)
  | .Sdiv a b => binVal 13 (treeBv env arrs ufs a) (treeBv env arrs ufs b)
  | .Srem a b => binVal 14 (treeBv env arrs ufs a) (treeBv env arrs ufs b)
  | .Select arr i => ⟨8, treeArr env arrs ufs arr (toW 32 (treeBv env arrs ufs i))⟩
  | .Call n w args => ⟨w.val, toW w.val (ufs n.val (treeArgs env arrs ufs args))⟩

/-- The contents of an array tree: read-over-write, most recent store
    first, the base array by name. -/
def treeArr (env : TEnv) (arrs : NArrs) (ufs : NUfs) : TArray → BitVec 32 → BitVec 8
  | .Var n => arrs n.val
  | .Store arr i v => fun j =>
    if toW 32 (treeBv env arrs ufs i) = j then toW 8 (treeBv env arrs ufs v)
    else treeArr env arrs ufs arr j

/-- The values of a call's arguments, in order. -/
def treeArgs (env : TEnv) (arrs : NArrs) (ufs : NUfs) : TArgs → List DVal
  | .Nil => []
  | .Cons t rest => treeBv env arrs ufs t :: treeArgs env arrs ufs rest

/-- The value of a boolean tree. -/
def treeBool (env : TEnv) (arrs : NArrs) (ufs : NUfs) : TBool → Bool
  | .Eq a b => bval (cmpVal 0 (treeBv env arrs ufs a) (treeBv env arrs ufs b))
  | .Ne a b => bval (cmpVal 1 (treeBv env arrs ufs a) (treeBv env arrs ufs b))
  | .Ult a b => bval (cmpVal 2 (treeBv env arrs ufs a) (treeBv env arrs ufs b))
  | .Ule a b => bval (cmpVal 3 (treeBv env arrs ufs a) (treeBv env arrs ufs b))
  | .Ugt a b => bval (cmpVal 4 (treeBv env arrs ufs a) (treeBv env arrs ufs b))
  | .Uge a b => bval (cmpVal 5 (treeBv env arrs ufs a) (treeBv env arrs ufs b))
  | .Slt a b => bval (cmpVal 6 (treeBv env arrs ufs a) (treeBv env arrs ufs b))
  | .Sle a b => bval (cmpVal 7 (treeBv env arrs ufs a) (treeBv env arrs ufs b))
  | .Sgt a b => bval (cmpVal 8 (treeBv env arrs ufs a) (treeBv env arrs ufs b))
  | .Sge a b => bval (cmpVal 9 (treeBv env arrs ufs a) (treeBv env arrs ufs b))
  | .Not a => !treeBool env arrs ufs a
  | .And a b => treeBool env arrs ufs a && treeBool env arrs ufs b
  | .Or a b => treeBool env arrs ufs a || treeBool env arrs ufs b
end

/-- The caller's question: every asserted tree is true. -/
def TreeSat (env : TEnv) (arrs : NArrs) (ufs : NUfs) (ts : List TBool) : Prop :=
  ∀ k (hk : k < ts.length), treeBool env arrs ufs ts[k] = true

/-- The number of store levels of an array tree, and of arguments. -/
def chainLen : TArray → Nat
  | .Var _ => 0
  | .Store arr _ _ => chainLen arr + 1

def baseName : TArray → Name
  | .Var n => n.val
  | .Store arr _ _ => baseName arr

def argsLen : TArgs → Nat
  | .Nil => 0
  | .Cons _ rest => argsLen rest + 1

/- ══════════════════ THE PURE NODE BUILDERS ══════════════════ -/

/-- `bin_node` / `cmp_node`, purely. -/
def pBinNode (op : Nat) (x y : Std.Usize) : blast_kernel.DagNode :=
  match op with
  | 0 => .Add x y
  | 1 => .Sub x y
  | 2 => .Mul x y
  | 3 => .Udiv x y
  | 4 => .Urem x y
  | 5 => .And x y
  | 6 => .Or x y
  | 7 => .Xor x y
  | 8 => .Shl x y
  | 9 => .Lshr x y
  | 10 => .Ashr x y
  | 11 => .Rotr x y
  | 12 => .Rotl x y
  | 13 => .Sdiv x y
  | _ => .Srem x y

def pCmpNode (op : Nat) (x y : Std.Usize) : blast_kernel.DagNode :=
  match op with
  | 0 => .Eq x y
  | 1 => .Ne x y
  | 2 => .Ult x y
  | 3 => .Ule x y
  | 4 => .Ugt x y
  | 5 => .Uge x y
  | 6 => .Slt x y
  | 7 => .Sle x y
  | 8 => .Sgt x y
  | _ => .Sge x y

theorem bin_node_eq (op x y : Std.Usize) :
    kernel.term_kernel.bin_node op x y = ok (pBinNode op.val x y) := by
  unfold kernel.term_kernel.bin_node
  by_cases h0 : op = 0#usize
  · rw [if_pos h0]; subst h0; rfl
  · rw [if_neg h0]
    by_cases h1 : op = 1#usize
    · rw [if_pos h1]; subst h1; rfl
    · rw [if_neg h1]
      by_cases h2 : op = 2#usize
      · rw [if_pos h2]; subst h2; rfl
      · rw [if_neg h2]
        by_cases h3 : op = 3#usize
        · rw [if_pos h3]; subst h3; rfl
        · rw [if_neg h3]
          by_cases h4 : op = 4#usize
          · rw [if_pos h4]; subst h4; rfl
          · rw [if_neg h4]
            by_cases h5 : op = 5#usize
            · rw [if_pos h5]; subst h5; rfl
            · rw [if_neg h5]
              by_cases h6 : op = 6#usize
              · rw [if_pos h6]; subst h6; rfl
              · rw [if_neg h6]
                by_cases h7 : op = 7#usize
                · rw [if_pos h7]; subst h7; rfl
                · rw [if_neg h7]
                  by_cases h8 : op = 8#usize
                  · rw [if_pos h8]; subst h8; rfl
                  · rw [if_neg h8]
                    by_cases h9 : op = 9#usize
                    · rw [if_pos h9]; subst h9; rfl
                    · rw [if_neg h9]
                      by_cases h10 : op = 10#usize
                      · rw [if_pos h10]; subst h10; rfl
                      · rw [if_neg h10]
                        by_cases h11 : op = 11#usize
                        · rw [if_pos h11]; subst h11; rfl
                        · rw [if_neg h11]
                          by_cases h12 : op = 12#usize
                          · rw [if_pos h12]; subst h12; rfl
                          · rw [if_neg h12]
                            by_cases h13 : op = 13#usize
                            · rw [if_pos h13]; subst h13; rfl
                            · rw [if_neg h13]
                              have hv0 : op.val ≠ 0 := by intro h'; apply h0; scalar_tac
                              have hv1 : op.val ≠ 1 := by intro h'; apply h1; scalar_tac
                              have hv2 : op.val ≠ 2 := by intro h'; apply h2; scalar_tac
                              have hv3 : op.val ≠ 3 := by intro h'; apply h3; scalar_tac
                              have hv4 : op.val ≠ 4 := by intro h'; apply h4; scalar_tac
                              have hv5 : op.val ≠ 5 := by intro h'; apply h5; scalar_tac
                              have hv6 : op.val ≠ 6 := by intro h'; apply h6; scalar_tac
                              have hv7 : op.val ≠ 7 := by intro h'; apply h7; scalar_tac
                              have hv8 : op.val ≠ 8 := by intro h'; apply h8; scalar_tac
                              have hv9 : op.val ≠ 9 := by intro h'; apply h9; scalar_tac
                              have hv10 : op.val ≠ 10 := by intro h'; apply h10; scalar_tac
                              have hv11 : op.val ≠ 11 := by intro h'; apply h11; scalar_tac
                              have hv12 : op.val ≠ 12 := by intro h'; apply h12; scalar_tac
                              have hv13 : op.val ≠ 13 := by intro h'; apply h13; scalar_tac
                              rcases hop : op.val with _|_|_|_|_|_|_|_|_|_|_|_|_|_|n <;> first | rfl | exact absurd hop ‹_›

theorem cmp_node_eq (op x y : Std.Usize) :
    kernel.term_kernel.cmp_node op x y = ok (pCmpNode op.val x y) := by
  unfold kernel.term_kernel.cmp_node
  by_cases h0 : op = 0#usize
  · rw [if_pos h0]; subst h0; rfl
  · rw [if_neg h0]
    by_cases h1 : op = 1#usize
    · rw [if_pos h1]; subst h1; rfl
    · rw [if_neg h1]
      by_cases h2 : op = 2#usize
      · rw [if_pos h2]; subst h2; rfl
      · rw [if_neg h2]
        by_cases h3 : op = 3#usize
        · rw [if_pos h3]; subst h3; rfl
        · rw [if_neg h3]
          by_cases h4 : op = 4#usize
          · rw [if_pos h4]; subst h4; rfl
          · rw [if_neg h4]
            by_cases h5 : op = 5#usize
            · rw [if_pos h5]; subst h5; rfl
            · rw [if_neg h5]
              by_cases h6 : op = 6#usize
              · rw [if_pos h6]; subst h6; rfl
              · rw [if_neg h6]
                by_cases h7 : op = 7#usize
                · rw [if_pos h7]; subst h7; rfl
                · rw [if_neg h7]
                  by_cases h8 : op = 8#usize
                  · rw [if_pos h8]; subst h8; rfl
                  · rw [if_neg h8]
                    have hv0 : op.val ≠ 0 := by intro h'; apply h0; scalar_tac
                    have hv1 : op.val ≠ 1 := by intro h'; apply h1; scalar_tac
                    have hv2 : op.val ≠ 2 := by intro h'; apply h2; scalar_tac
                    have hv3 : op.val ≠ 3 := by intro h'; apply h3; scalar_tac
                    have hv4 : op.val ≠ 4 := by intro h'; apply h4; scalar_tac
                    have hv5 : op.val ≠ 5 := by intro h'; apply h5; scalar_tac
                    have hv6 : op.val ≠ 6 := by intro h'; apply h6; scalar_tac
                    have hv7 : op.val ≠ 7 := by intro h'; apply h7; scalar_tac
                    have hv8 : op.val ≠ 8 := by intro h'; apply h8; scalar_tac
                    rcases hop : op.val with _|_|_|_|_|_|_|_|_|n <;> first | rfl | exact absurd hop ‹_›

theorem dagNodeVal_pBinNode (inp bits : List Bool) (vals : List DVal) (nin : Nat)
    (op : Nat) (x y : Std.Usize) :
    dagNodeVal inp bits vals nin (pBinNode op x y)
      = binVal op (vals.getD x.val dDflt) (vals.getD y.val dDflt) := by
  rcases op with _|_|_|_|_|_|_|_|_|_|_|_|_|_|_ <;> rfl

theorem dagNodeVal_pCmpNode (inp bits : List Bool) (vals : List DVal) (nin : Nat)
    (op : Nat) (x y : Std.Usize) :
    dagNodeVal inp bits vals nin (pCmpNode op x y)
      = cmpVal op (vals.getD x.val dDflt) (vals.getD y.val dDflt) := by
  rcases op with _|_|_|_|_|_|_|_|_|_ <;> rfl

/- ══════════════════ PARTIAL CORRECTNESS OF THE PRIMITIVES ══════════════════ -/

/- The flattener's output grows with the tree, so no capacity bound is
   available up front and every statement here is partial correctness
   (`= ok … → …`): what an ACCEPTED run established. The primitives'
   `_ok` lemmas and `loop_ok` are the partial twins of the Aeneas `step`
   specs. -/

theorem push_ok {α : Type} {v : alloc.vec.Vec α} {x : α} {v' : alloc.vec.Vec α}
    (h : alloc.vec.Vec.push v x = ok v') : v'.val = v.val ++ [x] := by
  unfold alloc.vec.Vec.push at h
  dsimp only at h
  split at h
  · cases h; simp
  · cases h

theorem add_ok {x y z : Std.Usize} (h : x + y = ok z) : z.val = x.val + y.val := by
  have := UScalar.add_equiv x y
  rw [h] at this
  exact this.2.1

theorem sub_ok {x y z : Std.Usize} (h : x - y = ok z) : x.val = z.val + y.val := by
  have := UScalar.sub_equiv x y
  rw [h] at this
  exact this.2.1

theorem slice_index_ok {α : Type} {v : Slice α} {i : Std.Usize} {x : α}
    (h : Slice.index_usize v i = ok x) : i.val < v.val.length ∧ ∀ d, x = v.val.getD i.val d := by
  unfold Slice.index_usize at h
  split at h
  · cases h
  · rename_i y hy
    cases h
    rw [Slice.getElem?_Usize_eq] at hy
    have hi : i.val < v.val.length := by
      by_contra hc
      rw [List.getElem?_eq_none (by omega)] at hy
      cases hy
    refine ⟨hi, fun d => ?_⟩
    rw [List.getD_eq_getElem?_getD, hy]
    rfl

theorem vec_index_ok {α : Type} {v : alloc.vec.Vec α} {i : Std.Usize} {x : α}
    (h : alloc.vec.Vec.index (core.slice.index.SliceIndexUsizeSlice α) v i = ok x) :
    i.val < v.val.length ∧ ∀ d, x = v.val.getD i.val d := by
  rw [alloc.vec.Vec.index_slice_index] at h
  have h' : Slice.index_usize ⟨v.val, v.property⟩ i = ok x := h
  exact slice_index_ok h'

theorem shr_ok {x : Std.U128} {s : Std.Usize} {z : Std.U128} (h : x >>> s = ok z) :
    z.val = x.val >>> s.val := by
  simp only [HShiftRight.hShiftRight, UScalar.shiftRight_UScalar, UScalar.shiftRight] at h
  split at h
  · cases h
    simp only [UScalar.val, BitVec.ushiftRight_eq, BitVec.toNat_ushiftRight]
  · cases h

/-- Partial correctness of a loop: an invariant the body preserves (with a
    decreasing measure) gives the post of an accepted run. -/
theorem loop_ok {α β : Type} (μ : α → Nat) (inv : α → Prop) (post : β → Prop)
    (body : α → Result (ControlFlow α β))
    (hBody : ∀ x, inv x → ∀ r, body x = ok r →
      (∀ y, r = .done y → post y) ∧ (∀ x', r = .cont x' → inv x' ∧ μ x' < μ x)) :
    ∀ x, inv x → ∀ y, loop body x = ok y → post y := by
  suffices hs : ∀ n x, μ x = n → inv x → ∀ y, loop body x = ok y → post y from
    fun x hinv y h => hs _ x rfl hinv y h
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    intro x hμ hinv y h
    unfold loop at h
    rcases hb : body x with r | e | _
    · rw [hb] at h
      obtain ⟨hdone, hcont⟩ := hBody x hinv r hb
      cases r with
      | cont x' =>
        obtain ⟨hinv', hlt⟩ := hcont x' rfl
        exact ih (μ x') (by omega) x' rfl hinv' y (by simpa using h)
      | done y' =>
        simp at h
        subst h
        exact hdone y' rfl
    · rw [hb] at h; cases h
    · rw [hb] at h; cases h

/- ══════════════════ FLATTENING STATES ══════════════════ -/

/-- `f'` is a later state of `f`: every table of the flattening only grows. -/
structure Later (f f' : Flat) : Prop where
  nodes : f.nodes.val <+: f'.nodes.val
  bits : f.bits.val <+: f'.bits.val
  side : f.side.val <+: f'.side.val
  roots : f.roots.val = f'.roots.val
  names : f.names.val <+: f'.names.val
  name_start : f.name_start.val <+: f'.name_start.val
  name_len : f.name_len.val <+: f'.name_len.val
  var_node : f.var_node.val <+: f'.var_node.val
  var_width : f.var_width.val <+: f'.var_width.val
  const_value : f.const_value.val <+: f'.const_value.val
  const_width : f.const_width.val <+: f'.const_width.val
  const_node : f.const_node.val <+: f'.const_node.val
  anames : f.anames.val <+: f'.anames.val
  aname_start : f.aname_start.val <+: f'.aname_start.val
  aname_len : f.aname_len.val <+: f'.aname_len.val
  fnames : f.fnames.val <+: f'.fnames.val
  fname_start : f.fname_start.val <+: f'.fname_start.val
  fname_len : f.fname_len.val <+: f'.fname_len.val
  func_width : f.func_width.val <+: f'.func_width.val

theorem Later.rfl (f : Flat) : Later f f :=
  ⟨List.prefix_rfl, List.prefix_rfl, List.prefix_rfl, Eq.refl _, List.prefix_rfl,
   List.prefix_rfl, List.prefix_rfl, List.prefix_rfl, List.prefix_rfl, List.prefix_rfl,
   List.prefix_rfl, List.prefix_rfl, List.prefix_rfl, List.prefix_rfl, List.prefix_rfl,
   List.prefix_rfl, List.prefix_rfl, List.prefix_rfl, List.prefix_rfl⟩

theorem Later.trans {f1 f2 f3 : Flat} (h : Later f1 f2) (h' : Later f2 f3) : Later f1 f3 :=
  ⟨h.nodes.trans h'.nodes, h.bits.trans h'.bits, h.side.trans h'.side, h.roots.trans h'.roots,
   h.names.trans h'.names, h.name_start.trans h'.name_start, h.name_len.trans h'.name_len,
   h.var_node.trans h'.var_node, h.var_width.trans h'.var_width,
   h.const_value.trans h'.const_value, h.const_width.trans h'.const_width,
   h.const_node.trans h'.const_node, h.anames.trans h'.anames,
   h.aname_start.trans h'.aname_start, h.aname_len.trans h'.aname_len,
   h.fnames.trans h'.fnames, h.fname_start.trans h'.fname_start, h.fname_len.trans h'.fname_len,
   h.func_width.trans h'.func_width⟩

/-- A name only depends on the arena up to its end. -/
theorem nameAt_of_prefix {arena arena' : List Std.U8} (h : arena <+: arena') (start len : Nat)
    (hr : start + len ≤ arena.length) : nameAt arena' start len = nameAt arena start len := by
  obtain ⟨t, rfl⟩ := h
  unfold nameAt
  rw [List.drop_append_of_le_length (by omega), List.take_append_of_le_length (by simp; omega)]

theorem nameAt_length (arena : List Std.U8) (start len : Nat) (hr : start + len ≤ arena.length) :
    (nameAt arena start len).length = len := by
  unfold nameAt
  simp
  omega

/-- The structural invariant of a flattening state: the tables are
    consistent, every variable node is a `Var` of its width, the names are
    injective (one node per name, one name per node), every constant memo
    entry is a `Const` node over its own bits, every select and call names
    an array / function of the tables. -/
structure Inv (f : Flat) : Prop where
  var_len1 : f.name_start.val.length = nvars f
  var_len2 : f.name_len.val.length = nvars f
  var_len3 : f.var_width.val.length = nvars f
  var_range : ∀ k < nvars f,
    (f.name_start.val.getD k 0#usize).val + (f.name_len.val.getD k 0#usize).val ≤ f.names.val.length
  var_node_lt : ∀ k < nvars f, varNodeOf f k < f.nodes.val.length
  var_is_var : ∀ k < nvars f,
    f.nodes.val.getD (varNodeOf f k) dfltExt = .Core (.Var (f.var_width.val.getD k 0#usize))
  var_inj : ∀ k1 < nvars f, ∀ k2 < nvars f, varName f k1 = varName f k2 → k1 = k2
  var_node_inj : ∀ k1 < nvars f, ∀ k2 < nvars f, varNodeOf f k1 = varNodeOf f k2 → k1 = k2
  const_len1 : f.const_value.val.length = nconsts f
  const_len2 : f.const_width.val.length = nconsts f
  const_ok : ∀ k < nconsts f, constNodeOf f k < f.nodes.val.length ∧ ∃ s : Std.Usize,
    f.nodes.val.getD (constNodeOf f k) dfltExt = .Core (.Const s (f.const_width.val.getD k 0#usize)) ∧
    s.val + constWidthOf f k ≤ f.bits.val.length ∧
    ∀ j < constWidthOf f k, f.bits.val.getD (s.val + j) false = (constValOf f k).testBit j
  arr_len : f.aname_len.val.length = narrs f
  arr_range : ∀ a < narrs f,
    (f.aname_start.val.getD a 0#usize).val + (f.aname_len.val.getD a 0#usize).val ≤ f.anames.val.length
  arr_inj : ∀ a1 < narrs f, ∀ a2 < narrs f, arrName f a1 = arrName f a2 → a1 = a2
  fun_len1 : f.fname_len.val.length = nfuncs f
  fun_len2 : f.func_width.val.length = nfuncs f
  fun_range : ∀ g < nfuncs f,
    (f.fname_start.val.getD g 0#usize).val + (f.fname_len.val.getD g 0#usize).val ≤ f.fnames.val.length
  fun_inj : ∀ g1 < nfuncs f, ∀ g2 < nfuncs f, funName f g1 = funName f g2 → g1 = g2
  sel_range : ∀ i < f.nodes.val.length,
    (∀ aid j s n, f.nodes.val.getD i dfltExt = .Select aid j s n → aid.val < narrs f) ∧
    (∀ fid w s n, f.nodes.val.getD i dfltExt = .Call fid w s n → fid.val < nfuncs f)

/- Stability of the tables under `Later`. -/

theorem varName_later {f f' : Flat} (hL : Later f f') (hI : Inv f) {k : Nat} (hk : k < nvars f) :
    varName f' k = varName f k := by
  unfold varName
  rw [getD_of_prefix hL.name_start (by rw [hI.var_len1]; exact hk),
    getD_of_prefix hL.name_len (by rw [hI.var_len2]; exact hk)]
  exact nameAt_of_prefix hL.names _ _ (hI.var_range k hk)

theorem varNodeOf_later {f f' : Flat} (hL : Later f f') {k : Nat} (hk : k < nvars f) :
    varNodeOf f' k = varNodeOf f k := by
  unfold varNodeOf
  rw [getD_of_prefix hL.var_node hk]

theorem varWidthOf_later {f f' : Flat} (hL : Later f f') (hI : Inv f) {k : Nat} (hk : k < nvars f) :
    varWidthOf f' k = varWidthOf f k := by
  unfold varWidthOf
  rw [getD_of_prefix hL.var_width (by rw [hI.var_len3]; exact hk)]

theorem nvars_later {f f' : Flat} (hL : Later f f') : nvars f ≤ nvars f' :=
  hL.var_node.length_le

theorem arrName_later {f f' : Flat} (hL : Later f f') (hI : Inv f) {a : Nat} (ha : a < narrs f) :
    arrName f' a = arrName f a := by
  unfold arrName
  rw [getD_of_prefix hL.aname_start ha, getD_of_prefix hL.aname_len (by rw [hI.arr_len]; exact ha)]
  exact nameAt_of_prefix hL.anames _ _ (hI.arr_range a ha)

theorem narrs_later {f f' : Flat} (hL : Later f f') : narrs f ≤ narrs f' :=
  hL.aname_start.length_le

theorem funName_later {f f' : Flat} (hL : Later f f') (hI : Inv f) {g : Nat} (hg : g < nfuncs f) :
    funName f' g = funName f g := by
  unfold funName
  rw [getD_of_prefix hL.fname_start hg, getD_of_prefix hL.fname_len (by rw [hI.fun_len1]; exact hg)]
  exact nameAt_of_prefix hL.fnames _ _ (hI.fun_range g hg)

theorem nfuncs_later {f f' : Flat} (hL : Later f f') : nfuncs f ≤ nfuncs f' :=
  hL.fname_start.length_le

theorem nodes_getD_later {f f' : Flat} (hL : Later f f') {i : Nat} (hi : i < f.nodes.val.length) :
    f'.nodes.val.getD i dfltExt = f.nodes.val.getD i dfltExt :=
  getD_of_prefix hL.nodes hi

/- ══════════════════ AGREEMENT AND CORRESPONDENCE ══════════════════ -/

/-- The flat query's variable `k` reads `env (name k) (width k)` at its
    node's input block. -/
def VarAgree (f : Flat) (env : TEnv) (inp : List Bool) : Prop :=
  ∀ k, k < nvars f → ∀ j < varWidthOf f k,
    inp.getD (extNin (f.nodes.val.take (varNodeOf f k)) + j) false
      = (env (varName f k) (varWidthOf f k)).getLsbD j

/-- The simulation of a state under the by-name interpretations. -/
def simOf (f : Flat) (env : TEnv) (arrs : NArrs) (ufs : NUfs) (inp : List Bool) : List DVal :=
  extSim inp f.bits.val (arrsI f arrs) (ufsI f ufs) f.side.val f.nodes.val

/-- Node `i` of state `f` denotes the tree `t` — in every later state. -/
def TreeCorr (f : Flat) (i : Nat) (t : TBv) : Prop :=
  ∀ f' env arrs ufs inp, Later f f' → Inv f' → VarAgree f' env inp →
    (simOf f' env arrs ufs inp).getD i dDflt = treeBv env arrs ufs t

def BoolCorr (f : Flat) (i : Nat) (t : TBool) : Prop :=
  ∀ f' env arrs ufs inp, Later f f' → Inv f' → VarAgree f' env inp →
    (simOf f' env arrs ufs inp).getD i dDflt = bvBool (treeBool env arrs ufs t)

/-- The side-table levels `L` (index, value, outermost first) with the base
    array id `aid` denote the array tree `a`: the chain read through them
    is the tree's read-over-write, in every later state and wherever in
    the side table they sit. -/
def ChainCorr (f : Flat) (L : List Std.Usize) (a : TArray) (aid : Nat) : Prop :=
  ∀ f' env arrs ufs inp, Later f f' → Inv f' → VarAgree f' env inp →
    ∀ (s : Nat) (j : BitVec 32), (∀ k < L.length, f'.side.val.getD (s + k) 0#usize = L.getD k 0#usize) →
      chainRead (arrsI f' arrs) (simOf f' env arrs ufs inp) f'.side.val aid j s (chainLen a)
        = treeArr env arrs ufs a j

/-- The argument nodes `I` denote the argument list `a`. -/
def ArgsCorr (f : Flat) (I : List Std.Usize) (a : TArgs) : Prop :=
  ∀ f' env arrs ufs inp, Later f f' → Inv f' → VarAgree f' env inp →
    ∀ k < I.length, (simOf f' env arrs ufs inp).getD (I.getD k 0#usize).val dDflt
      = (treeArgs env arrs ufs a).getD k dDflt

theorem TreeCorr_later {f f' : Flat} {i : Nat} {t : TBv} (hL : Later f f') (h : TreeCorr f i t) :
    TreeCorr f' i t :=
  fun f'' env arrs ufs inp hL' hI hV => h f'' env arrs ufs inp (hL.trans hL') hI hV

theorem BoolCorr_later {f f' : Flat} {i : Nat} {t : TBool} (hL : Later f f') (h : BoolCorr f i t) :
    BoolCorr f' i t :=
  fun f'' env arrs ufs inp hL' hI hV => h f'' env arrs ufs inp (hL.trans hL') hI hV

theorem ArgsCorr_later {f f' : Flat} {I : List Std.Usize} {a : TArgs} (hL : Later f f')
    (h : ArgsCorr f I a) : ArgsCorr f' I a :=
  fun f'' env arrs ufs inp hL' hI hV => h f'' env arrs ufs inp (hL.trans hL') hI hV

theorem ChainCorr_later {f f' : Flat} {L : List Std.Usize} {a : TArray} {aid : Nat}
    (hL : Later f f') (h : ChainCorr f L a aid) : ChainCorr f' L a aid :=
  fun f'' env arrs ufs inp hL' hI hV => h f'' env arrs ufs inp (hL.trans hL') hI hV

/- ══════════════════ THE TABLE PRIMITIVES ══════════════════ -/

theorem push_core_ok {f : Flat} {nd : blast_kernel.DagNode} {i : Std.Usize} {f' : Flat}
    (h : kernel.term_kernel.push_core f nd = ok (i, f')) :
    i.val = f.nodes.val.length ∧
      ∃ v, f' = { f with nodes := v } ∧ v.val = f.nodes.val ++ [.Core nd] := by
  unfold kernel.term_kernel.push_core at h
  dsimp only at h
  obtain ⟨v, hv, h⟩ := bind_ok_inv h
  cases h
  exact ⟨by simp, v, rfl, push_ok hv⟩

theorem arena_push_loop_ok (nm : Slice Std.U8) (arena0 : alloc.vec.Vec Std.U8)
    (arena : alloc.vec.Vec Std.U8) (j : Std.Usize)
    (hinv : arena.val = arena0.val ++ nm.val.take j.val ∧ j.val ≤ nm.val.length)
    (v : alloc.vec.Vec Std.U8) (h : kernel.term_kernel.arena_push_loop arena nm j = ok v) :
    v.val = arena0.val ++ nm.val := by
  unfold kernel.term_kernel.arena_push_loop at h
  refine loop_ok (fun (st : alloc.vec.Vec Std.U8 × Std.Usize) => nm.val.length - st.2.val)
    (fun st => st.1.val = arena0.val ++ nm.val.take st.2.val ∧ st.2.val ≤ nm.val.length)
    (fun v => v.val = arena0.val ++ nm.val) _ ?_ (arena, j) hinv v h
  intro st hst r hr
  obtain ⟨arena1, j1⟩ := st
  obtain ⟨ha, hj⟩ := hst
  dsimp only at ha hj
  unfold kernel.term_kernel.arena_push_loop.body at hr
  dsimp only at hr
  split at hr
  · rename_i hlt
    have hjl : j1.val < nm.val.length := by simpa using hlt
    obtain ⟨b, hb, hr⟩ := bind_ok_inv hr
    obtain ⟨arena2, ha2, hr⟩ := bind_ok_inv hr
    obtain ⟨j2, hj2, hr⟩ := bind_ok_inv hr
    cases hr
    refine ⟨fun y hy => (nomatch hy), fun x' hx => ?_⟩
    cases hx
    obtain ⟨_, hbv⟩ := slice_index_ok hb
    have hj2' : j2.val = j1.val + 1 := by have := add_ok hj2; simpa using this
    refine ⟨⟨?_, by simp [hj2']; omega⟩, by simp [hj2']; omega⟩
    rw [push_ok ha2, ha, hbv 0#u8, hj2', List.take_add_one, List.getElem?_eq_getElem hjl,
      getD_eq_getElem_of_lt hjl]
    simp
  · rename_i hge
    cases hr
    refine ⟨fun y hy => ?_, fun x' hx => (nomatch hx)⟩
    cases hy
    rw [ha, List.take_of_length_le (by scalar_tac)]

theorem arena_push_ok {arena : alloc.vec.Vec Std.U8} {nm : Slice Std.U8} {v : alloc.vec.Vec Std.U8}
    (h : kernel.term_kernel.arena_push arena nm = ok v) : v.val = arena.val ++ nm.val :=
  arena_push_loop_ok nm arena arena 0#usize ⟨by simp, by simp⟩ v h

theorem side_extend_loop_ok (ids : Slice Std.Usize) (side0 : alloc.vec.Vec Std.Usize)
    (side : alloc.vec.Vec Std.Usize) (j : Std.Usize)
    (hinv : side.val = side0.val ++ ids.val.take j.val ∧ j.val ≤ ids.val.length)
    (v : alloc.vec.Vec Std.Usize) (h : kernel.term_kernel.side_extend_loop side ids j = ok v) :
    v.val = side0.val ++ ids.val := by
  unfold kernel.term_kernel.side_extend_loop at h
  refine loop_ok (fun (st : alloc.vec.Vec Std.Usize × Std.Usize) => ids.val.length - st.2.val)
    (fun st => st.1.val = side0.val ++ ids.val.take st.2.val ∧ st.2.val ≤ ids.val.length)
    (fun v => v.val = side0.val ++ ids.val) _ ?_ (side, j) hinv v h
  intro st hst r hr
  obtain ⟨side1, j1⟩ := st
  obtain ⟨ha, hj⟩ := hst
  dsimp only at ha hj
  unfold kernel.term_kernel.side_extend_loop.body at hr
  dsimp only at hr
  split at hr
  · rename_i hlt
    have hjl : j1.val < ids.val.length := by simpa using hlt
    obtain ⟨b, hb, hr⟩ := bind_ok_inv hr
    obtain ⟨side2, ha2, hr⟩ := bind_ok_inv hr
    obtain ⟨j2, hj2, hr⟩ := bind_ok_inv hr
    cases hr
    refine ⟨fun y hy => (nomatch hy), fun x' hx => ?_⟩
    cases hx
    obtain ⟨_, hbv⟩ := slice_index_ok hb
    have hj2' : j2.val = j1.val + 1 := by have := add_ok hj2; simpa using this
    refine ⟨⟨?_, by simp [hj2']; omega⟩, by simp [hj2']; omega⟩
    rw [push_ok ha2, ha, hbv 0#usize, hj2', List.take_add_one, List.getElem?_eq_getElem hjl,
      getD_eq_getElem_of_lt hjl]
    simp
  · rename_i hge
    cases hr
    refine ⟨fun y hy => ?_, fun x' hx => (nomatch hx)⟩
    cases hy
    rw [ha, List.take_of_length_le (by scalar_tac)]

theorem side_extend_ok {side : alloc.vec.Vec Std.Usize} {ids : Slice Std.Usize}
    {v : alloc.vec.Vec Std.Usize} (h : kernel.term_kernel.side_extend side ids = ok v) :
    v.val = side.val ++ ids.val :=
  side_extend_loop_ok ids side side 0#usize ⟨by simp, by simp⟩ v h

/-- The bit pushed for position `j`: `(value >> j) & 1 == 1` is bit `j`. -/
theorem bits_push_loop_ok (value : Std.U128) (w : Std.Usize) (bits0 : alloc.vec.Vec Bool)
    (bits : alloc.vec.Vec Bool) (j : Std.Usize)
    (hinv : bits.val = bits0.val ++ block j.val (fun k => value.val.testBit k) ∧ j.val ≤ w.val)
    (v : alloc.vec.Vec Bool) (h : kernel.term_kernel.bits_push_loop bits value w j = ok v) :
    v.val = bits0.val ++ block w.val (fun k => value.val.testBit k) := by
  unfold kernel.term_kernel.bits_push_loop at h
  refine loop_ok (fun (st : alloc.vec.Vec Bool × Std.Usize) => w.val - st.2.val)
    (fun st => st.1.val = bits0.val ++ block st.2.val (fun k => value.val.testBit k) ∧ st.2.val ≤ w.val)
    (fun v => v.val = bits0.val ++ block w.val (fun k => value.val.testBit k)) _ ?_ (bits, j) hinv v h
  intro st hst r hr
  obtain ⟨bits1, j1⟩ := st
  obtain ⟨ha, hj⟩ := hst
  dsimp only at ha hj
  unfold kernel.term_kernel.bits_push_loop.body at hr
  dsimp only at hr
  split at hr
  · rename_i hlt
    have hjl : j1.val < w.val := by simpa using hlt
    obtain ⟨i, hi, hr⟩ := bind_ok_inv hr
    obtain ⟨bit, hbit, hr⟩ := bind_ok_inv hr
    obtain ⟨bits2, hb2, hr⟩ := bind_ok_inv hr
    obtain ⟨j2, hj2, hr⟩ := bind_ok_inv hr
    cases hr
    refine ⟨fun y hy => (nomatch hy), fun x' hx => ?_⟩
    cases hx
    have hiv := shr_ok hi
    have hbitv : bit.val = (value.val >>> j1.val) % 2 := by
      simp only [lift] at hbit
      cases hbit
      rw [UScalar.val_and, hiv, ← Nat.and_one_is_mod]
      simp
    have htb : value.val.testBit j1.val = decide (bit.val = 1) := by
      rw [testBit_eq_shift_mod, hbitv]
    have hj2' : j2.val = j1.val + 1 := by have := add_ok hj2; simpa using this
    refine ⟨⟨?_, by dsimp only; omega⟩, by dsimp only; omega⟩
    rw [push_ok hb2, ha, hj2', List.append_assoc]
    congr 1
    simp only [block, List.range_succ, List.map_append, List.map_cons, List.map_nil]
    congr 1
    simp only [List.cons.injEq, and_true]
    rw [htb]
    have h1 : (bit = 1#u128) ↔ (bit.val = 1) :=
      ⟨fun h => by subst h; rfl, fun h => UScalar.eq_of_val_eq (by simp [h])⟩
    simp [h1]
  · rename_i hge
    cases hr
    refine ⟨fun y hy => ?_, fun x' hx => (nomatch hx)⟩
    cases hy
    have : j1.val = w.val := by scalar_tac
    rw [ha, this]

theorem bits_push_ok {bits : alloc.vec.Vec Bool} {value : Std.U128} {w : Std.Usize}
    {v : alloc.vec.Vec Bool} (h : kernel.term_kernel.bits_push bits value w = ok v) :
    v.val = bits.val ++ block w.val (fun k => value.val.testBit k) :=
  bits_push_loop_ok value w bits bits 0#usize ⟨by simp [block], by simp⟩ v h

/- ══════════════════ THE LOOKUPS ══════════════════ -/

/-- A name slot equals a name iff they agree byte for byte. -/
theorem nameAt_eq_iff (arena : List Std.U8) (start len : Nat) (nm : List Std.U8)
    (hr : start + len ≤ arena.length) (hlen : len = nm.length) :
    nameAt arena start len = nm ↔ ∀ k < len, arena.getD (start + k) 0#u8 = nm.getD k 0#u8 := by
  have hl : (nameAt arena start len).length = len := nameAt_length arena start len hr
  constructor
  · intro h k hk
    have := congrArg (fun l => l.getD k 0#u8) h
    simp only at this
    rw [← this]
    unfold nameAt
    rw [List.getD_eq_getElem?_getD, List.getD_eq_getElem?_getD, List.getElem?_take_of_lt hk,
      List.getElem?_drop]
  · intro h
    apply List.ext_getElem (by omega)
    intro k hk1 hk2
    have hk : k < len := by omega
    have := h k hk
    rw [← getD_eq_getElem_of_lt hk1, ← getD_eq_getElem_of_lt hk2]
    unfold nameAt
    rw [List.getD_eq_getElem?_getD, List.getElem?_take_of_lt hk, List.getElem?_drop,
      ← List.getD_eq_getElem?_getD, this]

theorem name_is_loop_ok (arena : Slice Std.U8) (start len : Std.Usize) (nm : Slice Std.U8)
    (hlen : len.val = nm.val.length) (hr : start.val + len.val ≤ arena.val.length) (j : Std.Usize)
    (hinv : j.val ≤ len.val ∧ ∀ k < j.val, arena.val.getD (start.val + k) 0#u8 = nm.val.getD k 0#u8)
    (b : Bool) (h : kernel.term_kernel.name_is_loop arena start len nm j = ok b) :
    b = true ↔ ∀ k < len.val, arena.val.getD (start.val + k) 0#u8 = nm.val.getD k 0#u8 := by
  unfold kernel.term_kernel.name_is_loop at h
  refine loop_ok (fun (j : Std.Usize) => len.val - j.val)
    (fun j => j.val ≤ len.val ∧ ∀ k < j.val, arena.val.getD (start.val + k) 0#u8 = nm.val.getD k 0#u8)
    (fun b => b = true ↔ ∀ k < len.val, arena.val.getD (start.val + k) 0#u8 = nm.val.getD k 0#u8)
    _ ?_ j hinv b h
  intro j1 hst r hr
  obtain ⟨hj, hk⟩ := hst
  unfold kernel.term_kernel.name_is_loop.body at hr
  try dsimp only at hr
  split at hr
  · rename_i hlt
    have hjl : j1.val < len.val := by simpa using hlt
    obtain ⟨i, hi, hr⟩ := bind_ok_inv hr
    obtain ⟨b1, hb1, hr⟩ := bind_ok_inv hr
    obtain ⟨b2, hb2, hr⟩ := bind_ok_inv hr
    have hiv := add_ok hi
    obtain ⟨_, hb1v⟩ := slice_index_ok hb1
    obtain ⟨_, hb2v⟩ := slice_index_ok hb2
    split at hr
    · rename_i hne
      cases hr
      refine ⟨fun y hy => ?_, fun x' hx => (nomatch hx)⟩
      cases hy
      simp only [Bool.false_eq_true, false_iff, not_forall]
      refine ⟨j1.val, hjl, ?_⟩
      rw [← hiv, ← hb1v 0#u8, ← hb2v 0#u8]
      simpa using hne
    · rename_i heq
      obtain ⟨j2, hj2, hr⟩ := bind_ok_inv hr
      cases hr
      refine ⟨fun y hy => (nomatch hy), fun x' hx => ?_⟩
      cases hx
      have hj2' : j2.val = j1.val + 1 := by have := add_ok hj2; simpa using this
      refine ⟨⟨by omega, fun k hk' => ?_⟩, by dsimp only; omega⟩
      rw [hj2'] at hk'
      rcases Nat.lt_or_ge k j1.val with hlt' | hge'
      · exact hk k hlt'
      · have : k = j1.val := by omega
        subst this
        rw [← hiv, ← hb1v 0#u8, ← hb2v 0#u8]
        exact UScalar.eq_of_val_eq (by simpa using heq)
  · rename_i hge
    cases hr
    refine ⟨fun y hy => ?_, fun x' hx => (nomatch hx)⟩
    cases hy
    have : j1.val = len.val := by scalar_tac
    simp only [true_iff]
    intro k hk'
    exact hk k (by omega)

theorem name_is_ok {arena : Slice Std.U8} {start len : Std.Usize} {nm : Slice Std.U8} {b : Bool}
    (h : kernel.term_kernel.name_is arena start len nm = ok b) :
    b = true ↔ (len.val = nm.val.length ∧ start.val + len.val ≤ arena.val.length ∧
      nameAt arena.val start.val len.val = nm.val) := by
  unfold kernel.term_kernel.name_is at h
  try dsimp only at h
  split at h
  · rename_i hne
    cases h
    simp only [Bool.false_eq_true, false_iff, not_and]
    intro hl
    exfalso
    simp only [bne_iff_ne, ne_eq] at hne
    exact hne (UScalar.eq_of_val_eq (by simp [hl]))
  · rename_i heq
    have hlen : len.val = nm.val.length := by
      simp only [bne_iff_ne, ne_eq, Decidable.not_not] at heq
      subst heq
      simp
    split at h
    · rename_i hgt
      cases h
      simp only [Bool.false_eq_true, false_iff, not_and]
      intro _ hr
      exfalso
      scalar_tac
    · rename_i hle
      obtain ⟨i3, hi3, h⟩ := bind_ok_inv h
      have hsub := sub_ok hi3
      simp only [Slice.len_val] at hsub
      split at h
      · rename_i hgt
        cases h
        simp only [Bool.false_eq_true, false_iff, not_and]
        intro _ hr
        exfalso
        scalar_tac
      · rename_i hle2
        have hr : start.val + len.val ≤ arena.val.length := by scalar_tac
        have := name_is_loop_ok arena start len nm hlen hr 0#usize
          ⟨by simp, fun k hk => by simp at hk⟩ b h
        rw [this, nameAt_eq_iff arena.val start.val len.val nm.val hr hlen]
        constructor
        · intro hall
          exact ⟨hlen, hr, hall⟩
        · intro hall
          exact hall.2.2

/-- Table entry `j` carries the name `nm` (within the arena). -/
def Matches (arena : List Std.U8) (starts lens : List Std.Usize) (nm : List Std.U8) (j : Nat) : Prop :=
  j < starts.length ∧ j < lens.length ∧ (lens.getD j 0#usize).val = nm.length ∧
    (starts.getD j 0#usize).val + (lens.getD j 0#usize).val ≤ arena.length ∧
    nameAt arena (starts.getD j 0#usize).val (lens.getD j 0#usize).val = nm

theorem table_find_loop_ok (arena : Slice Std.U8) (starts lens : Slice Std.Usize) (nm : Slice Std.U8)
    (n : Std.Usize) (hn : n.val = starts.val.length) (k found : Std.Usize)
    (hinv : k.val ≤ n.val ∧
      (found = NONE → ∀ j < k.val, ¬ Matches arena.val starts.val lens.val nm.val j) ∧
      (found ≠ NONE → found.val < k.val ∧ Matches arena.val starts.val lens.val nm.val found.val))
    (r : Std.Usize) (h : kernel.term_kernel.table_find_loop arena starts lens nm n k found = ok r) :
    (r = NONE → ∀ j < n.val, ¬ Matches arena.val starts.val lens.val nm.val j) ∧
    (r ≠ NONE → r.val < n.val ∧ Matches arena.val starts.val lens.val nm.val r.val) := by
  unfold kernel.term_kernel.table_find_loop at h
  refine loop_ok (fun (st : Std.Usize × Std.Usize) => n.val - st.1.val)
    (fun st => st.1.val ≤ n.val ∧
      (st.2 = NONE → ∀ j < st.1.val, ¬ Matches arena.val starts.val lens.val nm.val j) ∧
      (st.2 ≠ NONE → st.2.val < st.1.val ∧ Matches arena.val starts.val lens.val nm.val st.2.val))
    (fun r => (r = NONE → ∀ j < n.val, ¬ Matches arena.val starts.val lens.val nm.val j) ∧
      (r ≠ NONE → r.val < n.val ∧ Matches arena.val starts.val lens.val nm.val r.val))
    _ ?_ (k, found) hinv r h
  intro st hst r hr
  obtain ⟨k1, found1⟩ := st
  obtain ⟨hk, hnone, hsome⟩ := hst
  dsimp only at hk hnone hsome
  unfold kernel.term_kernel.table_find_loop.body at hr
  dsimp only at hr
  split at hr
  · rename_i hlt
    have hkl : k1.val < n.val := by simpa using hlt
    obtain ⟨found2, hf2, hr⟩ := bind_ok_inv hr
    obtain ⟨k2, hk2, hr⟩ := bind_ok_inv hr
    cases hr
    refine ⟨fun y hy => (nomatch hy), fun x' hx => ?_⟩
    cases hx
    have hk2' : k2.val = k1.val + 1 := by have := add_ok hk2; simpa using this
    refine ⟨⟨by dsimp only; omega, ?_, ?_⟩, by dsimp only; omega⟩
    · -- found2 = NONE: nothing matched below k1, and k1 did not match either
      intro hf2n j hj
      dsimp only at hf2n hj
      rw [hk2'] at hj
      split at hf2
      · rename_i hfn
        split at hf2
        · rename_i hkl2
          obtain ⟨i1, hi1, hf2⟩ := bind_ok_inv hf2
          obtain ⟨i2, hi2, hf2⟩ := bind_ok_inv hf2
          obtain ⟨b, hb, hf2⟩ := bind_ok_inv hf2
          split at hf2
          · cases hf2
            rename_i hbt
            exfalso
            -- found2 = k1 = NONE is impossible: k1 < n ≤ starts.length ≤ usize max
            have : k1.val < Usize.max := by
              have := starts.length_ineq
              omega
            have hk1n : k1.val = NONE.val := by rw [hf2n]
            simp [NONE] at hk1n
            omega
          · cases hf2
            rcases Nat.lt_or_ge j k1.val with hlt' | hge'
            · exact hnone hfn j hlt'
            · have : j = k1.val := by omega
              subst this
              intro hm
              obtain ⟨_, _, hml, hmr, hme⟩ := hm
              obtain ⟨_, hi1v⟩ := slice_index_ok hi1
              obtain ⟨_, hi2v⟩ := slice_index_ok hi2
              have hb' := name_is_ok hb
              rw [hi1v 0#usize, hi2v 0#usize] at hb'
              have : b = true := hb'.mpr ⟨hml, hmr, hme⟩
              exact absurd this (by assumption)
        · cases hf2
          rcases Nat.lt_or_ge j k1.val with hlt' | hge'
          · exact hnone hfn j hlt'
          · have : j = k1.val := by omega
            subst this
            intro hm
            have : k1.val < lens.val.length := hm.2.1
            scalar_tac
      · cases hf2
        exact absurd hf2n (by assumption)
    · -- found2 ≠ NONE: either it was found before, or it is k1 and matches
      intro hf2s
      dsimp only at hf2s ⊢
      split at hf2
      · rename_i hfn
        split at hf2
        · rename_i hkl2
          obtain ⟨i1, hi1, hf2⟩ := bind_ok_inv hf2
          obtain ⟨i2, hi2, hf2⟩ := bind_ok_inv hf2
          obtain ⟨b, hb, hf2⟩ := bind_ok_inv hf2
          split at hf2
          · cases hf2
            have hbt : b = true := by assumption
            obtain ⟨_, hi1v⟩ := slice_index_ok hi1
            obtain ⟨hi2l, hi2v⟩ := slice_index_ok hi2
            have hb' := name_is_ok hb
            rw [hi1v 0#usize, hi2v 0#usize] at hb'
            obtain ⟨hml, hmr, hme⟩ := hb'.mp hbt
            refine ⟨by omega, by omega, hi2l, hml, hmr, hme⟩
          · cases hf2
            exact absurd hfn hf2s
        · cases hf2
          exact absurd hfn hf2s
      · cases hf2
        obtain ⟨hlt', hm⟩ := hsome hf2s
        exact ⟨by omega, hm⟩
  · rename_i hge
    cases hr
    refine ⟨fun y hy => ?_, fun x' hx => (nomatch hx)⟩
    cases hy
    have : k1.val = n.val := by scalar_tac
    refine ⟨fun hn' j hj => hnone hn' j (by omega), fun hs => ?_⟩
    obtain ⟨hlt', hm⟩ := hsome hs
    exact ⟨by omega, hm⟩

theorem table_find_ok {arena : Slice Std.U8} {starts lens : Slice Std.Usize} {nm : Slice Std.U8}
    {r : Std.Usize} (h : kernel.term_kernel.table_find arena starts lens nm = ok r) :
    (r = NONE → ∀ j < starts.val.length, ¬ Matches arena.val starts.val lens.val nm.val j) ∧
    (r ≠ NONE → r.val < starts.val.length ∧ Matches arena.val starts.val lens.val nm.val r.val) := by
  unfold kernel.term_kernel.table_find at h
  try dsimp only at h
  have := table_find_loop_ok arena starts lens nm (Slice.len starts) (by simp) 0#usize NONE
    ⟨by simp, fun _ j hj => by simp at hj, fun hne => absurd rfl hne⟩ r h
  simpa using this

/-- Constant memo entry `j` carries `(value, w)`. -/
def CMatches (values : List Std.U128) (widths : List Std.Usize) (value : Std.U128) (w : Std.Usize)
    (j : Nat) : Prop :=
  j < values.length ∧ j < widths.length ∧ values.getD j 0#u128 = value ∧ widths.getD j 0#usize = w

theorem const_find_loop_ok (values : Slice Std.U128) (widths : Slice Std.Usize) (value : Std.U128)
    (w : Std.Usize) (n : Std.Usize) (hn : n.val = values.val.length) (k found : Std.Usize)
    (hinv : k.val ≤ n.val ∧
      (found = NONE → ∀ j < k.val, ¬ CMatches values.val widths.val value w j) ∧
      (found ≠ NONE → found.val < k.val ∧ CMatches values.val widths.val value w found.val))
    (r : Std.Usize) (h : kernel.term_kernel.const_find_loop values widths value w n k found = ok r) :
    (r = NONE → ∀ j < n.val, ¬ CMatches values.val widths.val value w j) ∧
    (r ≠ NONE → r.val < n.val ∧ CMatches values.val widths.val value w r.val) := by
  unfold kernel.term_kernel.const_find_loop at h
  refine loop_ok (fun (st : Std.Usize × Std.Usize) => n.val - st.1.val)
    (fun st => st.1.val ≤ n.val ∧
      (st.2 = NONE → ∀ j < st.1.val, ¬ CMatches values.val widths.val value w j) ∧
      (st.2 ≠ NONE → st.2.val < st.1.val ∧ CMatches values.val widths.val value w st.2.val))
    (fun r => (r = NONE → ∀ j < n.val, ¬ CMatches values.val widths.val value w j) ∧
      (r ≠ NONE → r.val < n.val ∧ CMatches values.val widths.val value w r.val))
    _ ?_ (k, found) hinv r h
  intro st hst r hr
  obtain ⟨k1, found1⟩ := st
  obtain ⟨hk, hnone, hsome⟩ := hst
  dsimp only at hk hnone hsome
  unfold kernel.term_kernel.const_find_loop.body at hr
  dsimp only at hr
  split at hr
  · rename_i hlt
    have hkl : k1.val < n.val := by simpa using hlt
    obtain ⟨found2, hf2, hr⟩ := bind_ok_inv hr
    obtain ⟨k2, hk2, hr⟩ := bind_ok_inv hr
    cases hr
    refine ⟨fun y hy => (nomatch hy), fun x' hx => ?_⟩
    cases hx
    have hk2' : k2.val = k1.val + 1 := by have := add_ok hk2; simpa using this
    have hk1n : k1 ≠ NONE := by
      intro hc
      have := values.length_ineq
      have hk1v : k1.val = NONE.val := by rw [hc]
      simp [NONE] at hk1v
      omega
    refine ⟨⟨by dsimp only; omega, ?_, ?_⟩, by dsimp only; omega⟩
    · intro hf2n j hj
      dsimp only at hf2n hj
      rw [hk2'] at hj
      split at hf2
      · rename_i hfn
        split at hf2
        · rename_i hkl2
          obtain ⟨i1, hi1, hf2⟩ := bind_ok_inv hf2
          split at hf2
          · rename_i hv
            obtain ⟨i2, hi2, hf2⟩ := bind_ok_inv hf2
            split at hf2
            · cases hf2
              exact absurd hf2n hk1n
            · cases hf2
              rcases Nat.lt_or_ge j k1.val with hlt' | hge'
              · exact hnone hfn j hlt'
              · have : j = k1.val := by omega
                subst this
                intro hm
                obtain ⟨_, _, hmv, hmw⟩ := hm
                obtain ⟨_, hi2v⟩ := slice_index_ok hi2
                exact absurd (by rw [hi2v 0#usize, hmw]) ‹¬ i2 = w›
          · cases hf2
            rcases Nat.lt_or_ge j k1.val with hlt' | hge'
            · exact hnone hfn j hlt'
            · have : j = k1.val := by omega
              subst this
              intro hm
              obtain ⟨_, _, hmv, hmw⟩ := hm
              obtain ⟨_, hi1v⟩ := slice_index_ok hi1
              exact absurd (by rw [hi1v 0#u128, hmv]) ‹¬ i1 = value›
        · cases hf2
          rcases Nat.lt_or_ge j k1.val with hlt' | hge'
          · exact hnone hfn j hlt'
          · have : j = k1.val := by omega
            subst this
            intro hm
            have : k1.val < widths.val.length := hm.2.1
            scalar_tac
      · cases hf2
        exact absurd hf2n (by assumption)
    · intro hf2s
      dsimp only at hf2s ⊢
      split at hf2
      · rename_i hfn
        split at hf2
        · rename_i hkl2
          obtain ⟨i1, hi1, hf2⟩ := bind_ok_inv hf2
          split at hf2
          · rename_i hv
            obtain ⟨i2, hi2, hf2⟩ := bind_ok_inv hf2
            split at hf2
            · rename_i hw
              cases hf2
              obtain ⟨hi1l, hi1v⟩ := slice_index_ok hi1
              obtain ⟨hi2l, hi2v⟩ := slice_index_ok hi2
              refine ⟨by omega, hi1l, hi2l, ?_, ?_⟩
              · rw [← hi1v 0#u128]; exact hv
              · rw [← hi2v 0#usize]; exact hw
            · cases hf2
              exact absurd hfn hf2s
          · cases hf2
            exact absurd hfn hf2s
        · cases hf2
          exact absurd hfn hf2s
      · cases hf2
        obtain ⟨hlt', hm⟩ := hsome hf2s
        exact ⟨by omega, hm⟩
  · rename_i hge
    cases hr
    refine ⟨fun y hy => ?_, fun x' hx => (nomatch hx)⟩
    cases hy
    have : k1.val = n.val := by scalar_tac
    refine ⟨fun hn' j hj => hnone hn' j (by omega), fun hs => ?_⟩
    obtain ⟨hlt', hm⟩ := hsome hs
    exact ⟨by omega, hm⟩

theorem const_find_ok {values : Slice Std.U128} {widths : Slice Std.Usize} {value : Std.U128}
    {w : Std.Usize} {r : Std.Usize} (h : kernel.term_kernel.const_find values widths value w = ok r) :
    (r = NONE → ∀ j < values.val.length, ¬ CMatches values.val widths.val value w j) ∧
    (r ≠ NONE → r.val < values.val.length ∧ CMatches values.val widths.val value w r.val) := by
  unfold kernel.term_kernel.const_find at h
  try dsimp only at h
  have := const_find_loop_ok values widths value w (Slice.len values) (by simp) 0#usize NONE
    ⟨by simp, fun _ j hj => by simp at hj, fun hne => absurd rfl hne⟩ r h
  simpa using this

/- ══════════════════ STATE UPDATES PRESERVE THE INVARIANT ══════════════════ -/

theorem getD_append_at {α : Type} (l m : List α) (j : Nat) (d : α) (hj : j < m.length) :
    (l ++ m).getD (l.length + j) d = m.getD j d := by
  rw [List.getD_eq_getElem?_getD, List.getD_eq_getElem?_getD,
    List.getElem?_append_right (by omega), Nat.add_sub_cancel_left]

/-- Pushing a closed node. -/
theorem Later.push_core (f : Flat) (v : alloc.vec.Vec ExtNode) (nd : blast_kernel.DagNode)
    (hv : v.val = f.nodes.val ++ [.Core nd]) : Later f { f with nodes := v } := by
  refine ⟨?_, List.prefix_rfl, List.prefix_rfl, Eq.refl _, List.prefix_rfl,
   List.prefix_rfl, List.prefix_rfl, List.prefix_rfl, List.prefix_rfl, List.prefix_rfl,
   List.prefix_rfl, List.prefix_rfl, List.prefix_rfl, List.prefix_rfl, List.prefix_rfl,
   List.prefix_rfl, List.prefix_rfl, List.prefix_rfl, List.prefix_rfl⟩
  show f.nodes.val <+: v.val
  rw [hv]
  exact List.prefix_append _ _

theorem Inv.push_core {f : Flat} (hI : Inv f) (v : alloc.vec.Vec ExtNode) (nd : blast_kernel.DagNode)
    (hv : v.val = f.nodes.val ++ [.Core nd]) : Inv { f with nodes := v } := by
  have hpre : f.nodes.val <+: v.val := by rw [hv]; exact List.prefix_append _ _
  have hlen : v.val.length = f.nodes.val.length + 1 := by rw [hv]; simp
  refine ⟨hI.var_len1, hI.var_len2, hI.var_len3, hI.var_range, ?_, ?_, hI.var_inj, hI.var_node_inj,
    hI.const_len1, hI.const_len2, ?_, hI.arr_len, hI.arr_range, hI.arr_inj, hI.fun_len1, hI.fun_len2,
    hI.fun_range, hI.fun_inj, ?_⟩
  · intro k hk
    have := hI.var_node_lt k hk
    show varNodeOf f k < v.val.length
    omega
  · intro k hk
    have := hI.var_is_var k hk
    show v.val.getD (varNodeOf f k) dfltExt = _
    rw [getD_of_prefix hpre (hI.var_node_lt k hk)]
    exact this
  · intro k hk
    obtain ⟨hlt, s, hnode, hr, hb⟩ := hI.const_ok k hk
    show constNodeOf f k < v.val.length ∧ ∃ s : Std.Usize,
      v.val.getD (constNodeOf f k) dfltExt = .Core (.Const s (f.const_width.val.getD k 0#usize)) ∧
      s.val + constWidthOf f k ≤ f.bits.val.length ∧
      ∀ j < constWidthOf f k, f.bits.val.getD (s.val + j) false = (constValOf f k).testBit j
    refine ⟨by omega, s, ?_, hr, hb⟩
    rw [getD_of_prefix hpre hlt]
    exact hnode
  · intro i hi
    have hi' : i < v.val.length := hi
    show (∀ aid j s n, v.val.getD i dfltExt = .Select aid j s n → aid.val < narrs f) ∧
      (∀ fid w s n, v.val.getD i dfltExt = .Call fid w s n → fid.val < nfuncs f)
    rcases Nat.lt_or_ge i f.nodes.val.length with hlt | hge
    · have := hI.sel_range i hlt
      rw [getD_of_prefix hpre hlt]
      exact this
    · have : i = f.nodes.val.length := by omega
      subst this
      rw [hv, getD_snoc_length]
      exact ⟨fun _ _ _ _ h => (nomatch h), fun _ _ _ _ h => (nomatch h)⟩

/-- Pushing a new constant: the node, the bits and the three memo columns. -/
theorem Later.push_const (f : Flat) (v1 : alloc.vec.Vec ExtNode) (v : alloc.vec.Vec Bool)
    (v2 : alloc.vec.Vec Std.U128) (v3 v4 : alloc.vec.Vec Std.Usize) (s w : Std.Usize)
    (value : Std.U128) (i : Std.Usize)
    (hv1 : v1.val = f.nodes.val ++ [.Core (.Const s w)])
    (hv : v.val = f.bits.val ++ block w.val (fun k => value.val.testBit k))
    (hv2 : v2.val = f.const_value.val ++ [value]) (hv3 : v3.val = f.const_width.val ++ [w])
    (hv4 : v4.val = f.const_node.val ++ [i]) :
    Later f { f with nodes := v1, bits := v, const_value := v2, const_width := v3, const_node := v4 } := by
  refine ⟨?_, ?_, List.prefix_rfl, Eq.refl _, List.prefix_rfl,
   List.prefix_rfl, List.prefix_rfl, List.prefix_rfl, List.prefix_rfl, ?_,
   ?_, ?_, List.prefix_rfl, List.prefix_rfl, List.prefix_rfl,
   List.prefix_rfl, List.prefix_rfl, List.prefix_rfl, List.prefix_rfl⟩
  · show f.nodes.val <+: v1.val
    rw [hv1]; exact List.prefix_append _ _
  · show f.bits.val <+: v.val
    rw [hv]; exact List.prefix_append _ _
  · show f.const_value.val <+: v2.val
    rw [hv2]; exact List.prefix_append _ _
  · show f.const_width.val <+: v3.val
    rw [hv3]; exact List.prefix_append _ _
  · show f.const_node.val <+: v4.val
    rw [hv4]; exact List.prefix_append _ _

theorem Inv.push_const {f : Flat} (hI : Inv f) (v1 : alloc.vec.Vec ExtNode) (v : alloc.vec.Vec Bool)
    (v2 : alloc.vec.Vec Std.U128) (v3 v4 : alloc.vec.Vec Std.Usize) (s w : Std.Usize)
    (value : Std.U128) (i : Std.Usize)
    (hs : s.val = f.bits.val.length) (hi : i.val = f.nodes.val.length)
    (hv1 : v1.val = f.nodes.val ++ [.Core (.Const s w)])
    (hv : v.val = f.bits.val ++ block w.val (fun k => value.val.testBit k))
    (hv2 : v2.val = f.const_value.val ++ [value]) (hv3 : v3.val = f.const_width.val ++ [w])
    (hv4 : v4.val = f.const_node.val ++ [i]) :
    Inv { f with nodes := v1, bits := v, const_value := v2, const_width := v3, const_node := v4 } := by
  have hpre : f.nodes.val <+: v1.val := by rw [hv1]; exact List.prefix_append _ _
  have hbpre : f.bits.val <+: v.val := by rw [hv]; exact List.prefix_append _ _
  have hlen : v1.val.length = f.nodes.val.length + 1 := by rw [hv1]; simp
  have hblen : v.val.length = f.bits.val.length + w.val := by rw [hv]; simp
  refine ⟨hI.var_len1, hI.var_len2, hI.var_len3, hI.var_range, ?_, ?_, hI.var_inj, hI.var_node_inj,
    ?_, ?_, ?_, hI.arr_len, hI.arr_range, hI.arr_inj, hI.fun_len1, hI.fun_len2,
    hI.fun_range, hI.fun_inj, ?_⟩
  · intro k hk
    have := hI.var_node_lt k hk
    show varNodeOf f k < v1.val.length
    omega
  · intro k hk
    have := hI.var_is_var k hk
    show v1.val.getD (varNodeOf f k) dfltExt = _
    rw [getD_of_prefix hpre (hI.var_node_lt k hk)]
    exact this
  · show v2.val.length = v4.val.length
    rw [hv2, hv4, List.length_append, List.length_append, hI.const_len1]; rfl
  · show v3.val.length = v4.val.length
    rw [hv3, hv4, List.length_append, List.length_append, hI.const_len2]; rfl
  · intro k hk
    simp only [nconsts] at hk
    rw [hv4] at hk
    simp only [List.length_append, List.length_singleton] at hk
    simp only [constNodeOf, constWidthOf, constValOf]
    rcases Nat.lt_or_ge k f.const_node.val.length with hlt | hge
    · obtain ⟨hlt', s', hnode, hr, hb⟩ := hI.const_ok k hlt
      simp only [constNodeOf, constWidthOf, constValOf] at hlt' hnode hr hb
      rw [hv4, hv3, hv2, getD_of_prefix (List.prefix_append _ _) hlt,
        getD_of_prefix (List.prefix_append _ _) (by rw [hI.const_len2]; exact hlt),
        getD_of_prefix (List.prefix_append _ _) (by rw [hI.const_len1]; exact hlt)]
      refine ⟨by omega, s', ?_, by omega, ?_⟩
      · rw [getD_of_prefix hpre hlt']; exact hnode
      · intro j hj
        rw [getD_of_prefix hbpre (by omega)]
        exact hb j hj
    · have hk' : k = f.const_node.val.length := by omega
      subst hk'
      have h2 : f.const_node.val.length = f.const_width.val.length := hI.const_len2.symm
      have h1 : f.const_width.val.length = f.const_value.val.length :=
        hI.const_len2.trans hI.const_len1.symm
      rw [hv4, hv3, hv2, getD_snoc_length, h2, getD_snoc_length, h1, getD_snoc_length]
      refine ⟨by omega, s, ?_, by omega, ?_⟩
      · rw [hi, hv1, getD_snoc_length]
      · intro j hj
        rw [hv, hs, getD_append_at _ _ _ _ (by simp; exact hj), block_getD _ _ _ hj]
  · intro i' hi'
    have hi'' : i' < v1.val.length := hi'
    show (∀ aid j s n, v1.val.getD i' dfltExt = .Select aid j s n → aid.val < narrs f) ∧
      (∀ fid w s n, v1.val.getD i' dfltExt = .Call fid w s n → fid.val < nfuncs f)
    rcases Nat.lt_or_ge i' f.nodes.val.length with hlt | hge
    · have := hI.sel_range i' hlt
      rw [getD_of_prefix hpre hlt]
      exact this
    · have : i' = f.nodes.val.length := by omega
      subst this
      rw [hv1, getD_snoc_length]
      exact ⟨fun _ _ _ _ h => (nomatch h), fun _ _ _ _ h => (nomatch h)⟩

/-- Pushing a new variable: the node, the name and the four table columns. -/
theorem Later.push_var (f : Flat) (v1 : alloc.vec.Vec ExtNode) (v : alloc.vec.Vec Std.U8)
    (v2 v3 v4 v5 : alloc.vec.Vec Std.Usize) (nm : Slice Std.U8) (w start i len : Std.Usize)
    (hv1 : v1.val = f.nodes.val ++ [.Core (.Var w)]) (hv : v.val = f.names.val ++ nm.val)
    (hv2 : v2.val = f.name_start.val ++ [start]) (hv3 : v3.val = f.name_len.val ++ [len])
    (hv4 : v4.val = f.var_node.val ++ [i]) (hv5 : v5.val = f.var_width.val ++ [w]) :
    Later f { f with nodes := v1, names := v, name_start := v2, name_len := v3, var_node := v4, var_width := v5 } := by
  refine ⟨?_, List.prefix_rfl, List.prefix_rfl, Eq.refl _, ?_, ?_, ?_, ?_, ?_,
   List.prefix_rfl, List.prefix_rfl, List.prefix_rfl, List.prefix_rfl, List.prefix_rfl,
   List.prefix_rfl, List.prefix_rfl, List.prefix_rfl, List.prefix_rfl, List.prefix_rfl⟩
  · show f.nodes.val <+: v1.val
    rw [hv1]; exact List.prefix_append _ _
  · show f.names.val <+: v.val
    rw [hv]; exact List.prefix_append _ _
  · show f.name_start.val <+: v2.val
    rw [hv2]; exact List.prefix_append _ _
  · show f.name_len.val <+: v3.val
    rw [hv3]; exact List.prefix_append _ _
  · show f.var_node.val <+: v4.val
    rw [hv4]; exact List.prefix_append _ _
  · show f.var_width.val <+: v5.val
    rw [hv5]; exact List.prefix_append _ _

theorem nameAt_append_self (arena : List Std.U8) (nm : List Std.U8) :
    nameAt (arena ++ nm) arena.length nm.length = nm := by
  unfold nameAt
  rw [List.drop_append_of_le_length (le_refl _), List.drop_length, List.nil_append, List.take_length]

theorem Inv.push_var {f : Flat} (hI : Inv f) (v1 : alloc.vec.Vec ExtNode) (v : alloc.vec.Vec Std.U8)
    (v2 v3 v4 v5 : alloc.vec.Vec Std.Usize) (nm : Slice Std.U8) (w start i len : Std.Usize)
    (hstart : start.val = f.names.val.length) (hlen : len.val = nm.val.length)
    (hi : i.val = f.nodes.val.length)
    (hnew : ∀ k < nvars f, varName f k ≠ nm.val)
    (hv1 : v1.val = f.nodes.val ++ [.Core (.Var w)]) (hv : v.val = f.names.val ++ nm.val)
    (hv2 : v2.val = f.name_start.val ++ [start]) (hv3 : v3.val = f.name_len.val ++ [len])
    (hv4 : v4.val = f.var_node.val ++ [i]) (hv5 : v5.val = f.var_width.val ++ [w]) :
    Inv { f with nodes := v1, names := v, name_start := v2, name_len := v3, var_node := v4, var_width := v5 } := by
  have hpre : f.nodes.val <+: v1.val := by rw [hv1]; exact List.prefix_append _ _
  have hnpre : f.names.val <+: v.val := by rw [hv]; exact List.prefix_append _ _
  have hlen1 : v1.val.length = f.nodes.val.length + 1 := by rw [hv1]; simp
  have hnv : nvars { f with nodes := v1, names := v, name_start := v2, name_len := v3, var_node := v4, var_width := v5 } = nvars f + 1 := by
    simp only [nvars]; rw [hv4]; simp
  -- the name of entry `k` in the new state
  have hname : ∀ k < nvars f, varName { f with nodes := v1, names := v, name_start := v2, name_len := v3, var_node := v4, var_width := v5 } k = varName f k := by
    intro k hk
    simp only [varName]
    rw [hv2, hv3, getD_of_prefix (List.prefix_append _ _) (by rw [hI.var_len1]; exact hk),
      getD_of_prefix (List.prefix_append _ _) (by rw [hI.var_len2]; exact hk)]
    exact nameAt_of_prefix hnpre _ _ (hI.var_range k hk)
  have hname_new : varName { f with nodes := v1, names := v, name_start := v2, name_len := v3, var_node := v4, var_width := v5 } (nvars f) = nm.val := by
    simp only [varName]
    rw [hv2, hv3, ← hI.var_len1, getD_snoc_length, hI.var_len1, ← hI.var_len2, getD_snoc_length,
      hv, hstart, hlen]
    exact nameAt_append_self _ _
  have hnode : ∀ k < nvars f, varNodeOf { f with nodes := v1, names := v, name_start := v2, name_len := v3, var_node := v4, var_width := v5 } k = varNodeOf f k := by
    intro k hk
    simp only [varNodeOf]
    rw [hv4, getD_of_prefix (List.prefix_append _ _) hk]
  have hnode_new : varNodeOf { f with nodes := v1, names := v, name_start := v2, name_len := v3, var_node := v4, var_width := v5 } (nvars f) = i.val := by
    simp only [varNodeOf, nvars]
    rw [hv4, getD_snoc_length]
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, hI.const_len1, hI.const_len2, ?_, hI.arr_len, hI.arr_range,
    hI.arr_inj, hI.fun_len1, hI.fun_len2, hI.fun_range, hI.fun_inj, ?_⟩
  · show v2.val.length = v4.val.length
    rw [hv2, hv4, List.length_append, List.length_append, hI.var_len1]; rfl
  · show v3.val.length = v4.val.length
    rw [hv3, hv4, List.length_append, List.length_append, hI.var_len2]; rfl
  · show v5.val.length = v4.val.length
    rw [hv5, hv4, List.length_append, List.length_append, hI.var_len3]; rfl
  · intro k hk
    rw [hnv] at hk
    simp only []
    rcases Nat.lt_or_ge k (nvars f) with hlt | hge
    · have := hI.var_range k hlt
      rw [hv2, hv3, getD_of_prefix (List.prefix_append _ _) (by rw [hI.var_len1]; exact hlt),
        getD_of_prefix (List.prefix_append _ _) (by rw [hI.var_len2]; exact hlt), hv,
        List.length_append]
      omega
    · have hk' : k = nvars f := by omega
      subst hk'
      rw [hv2, hv3, ← hI.var_len1, getD_snoc_length, hI.var_len1, ← hI.var_len2, getD_snoc_length,
        hv, hstart, hlen]
      simp
  · intro k hk
    rw [hnv] at hk
    rcases Nat.lt_or_ge k (nvars f) with hlt | hge
    · rw [hnode k hlt]
      have := hI.var_node_lt k hlt
      simp only []
      omega
    · have hk' : k = nvars f := by omega
      subst hk'
      rw [hnode_new]
      simp only []
      omega
  · intro k hk
    rw [hnv] at hk
    rcases Nat.lt_or_ge k (nvars f) with hlt | hge
    · rw [hnode k hlt]
      have := hI.var_is_var k hlt
      simp only []
      rw [getD_of_prefix hpre (hI.var_node_lt k hlt), hv5,
        getD_of_prefix (List.prefix_append _ _) (by rw [hI.var_len3]; exact hlt)]
      exact this
    · have hk' : k = nvars f := by omega
      subst hk'
      rw [hnode_new]
      simp only []
      rw [hi, hv1, getD_snoc_length, hv5, ← hI.var_len3, getD_snoc_length]
  · intro k1 hk1 k2 hk2 heq
    rw [hnv] at hk1 hk2
    rcases Nat.lt_or_ge k1 (nvars f) with h1 | h1 <;> rcases Nat.lt_or_ge k2 (nvars f) with h2 | h2
    · rw [hname k1 h1, hname k2 h2] at heq
      exact hI.var_inj k1 h1 k2 h2 heq
    · have hk2' : k2 = nvars f := by omega
      subst hk2'
      rw [hname k1 h1, hname_new] at heq
      exact absurd heq (hnew k1 h1)
    · have hk1' : k1 = nvars f := by omega
      subst hk1'
      rw [hname_new, hname k2 h2] at heq
      exact absurd heq.symm (hnew k2 h2)
    · omega
  · intro k1 hk1 k2 hk2 heq
    rw [hnv] at hk1 hk2
    rcases Nat.lt_or_ge k1 (nvars f) with h1 | h1 <;> rcases Nat.lt_or_ge k2 (nvars f) with h2 | h2
    · rw [hnode k1 h1, hnode k2 h2] at heq
      exact hI.var_node_inj k1 h1 k2 h2 heq
    · have hk2' : k2 = nvars f := by omega
      subst hk2'
      rw [hnode k1 h1, hnode_new] at heq
      have := hI.var_node_lt k1 h1
      omega
    · have hk1' : k1 = nvars f := by omega
      subst hk1'
      rw [hnode_new, hnode k2 h2] at heq
      have := hI.var_node_lt k2 h2
      omega
    · omega
  · intro k hk
    obtain ⟨hlt, s, hnd, hr, hb⟩ := hI.const_ok k hk
    show constNodeOf f k < v1.val.length ∧ ∃ s : Std.Usize,
      v1.val.getD (constNodeOf f k) dfltExt = .Core (.Const s (f.const_width.val.getD k 0#usize)) ∧
      s.val + constWidthOf f k ≤ f.bits.val.length ∧
      ∀ j < constWidthOf f k, f.bits.val.getD (s.val + j) false = (constValOf f k).testBit j
    refine ⟨by omega, s, ?_, hr, hb⟩
    rw [getD_of_prefix hpre hlt]
    exact hnd
  · intro i' hi'
    have hi'' : i' < v1.val.length := hi'
    show (∀ aid j s n, v1.val.getD i' dfltExt = .Select aid j s n → aid.val < narrs f) ∧
      (∀ fid w s n, v1.val.getD i' dfltExt = .Call fid w s n → fid.val < nfuncs f)
    rcases Nat.lt_or_ge i' f.nodes.val.length with hlt | hge
    · have := hI.sel_range i' hlt
      rw [getD_of_prefix hpre hlt]
      exact this
    · have : i' = f.nodes.val.length := by omega
      subst this
      rw [hv1, getD_snoc_length]
      exact ⟨fun _ _ _ _ h => (nomatch h), fun _ _ _ _ h => (nomatch h)⟩

/-- Pushing a new array name. -/
theorem Later.push_arr (f : Flat) (v : alloc.vec.Vec Std.U8) (v1 v2 : alloc.vec.Vec Std.Usize)
    (nm : Slice Std.U8) (start len : Std.Usize)
    (hv : v.val = f.anames.val ++ nm.val) (hv1 : v1.val = f.aname_start.val ++ [start])
    (hv2 : v2.val = f.aname_len.val ++ [len]) :
    Later f { f with anames := v, aname_start := v1, aname_len := v2 } := by
  refine ⟨List.prefix_rfl, List.prefix_rfl, List.prefix_rfl, Eq.refl _, List.prefix_rfl,
   List.prefix_rfl, List.prefix_rfl, List.prefix_rfl, List.prefix_rfl, List.prefix_rfl,
   List.prefix_rfl, List.prefix_rfl, ?_, ?_, ?_,
   List.prefix_rfl, List.prefix_rfl, List.prefix_rfl, List.prefix_rfl⟩
  · show f.anames.val <+: v.val
    rw [hv]; exact List.prefix_append _ _
  · show f.aname_start.val <+: v1.val
    rw [hv1]; exact List.prefix_append _ _
  · show f.aname_len.val <+: v2.val
    rw [hv2]; exact List.prefix_append _ _

theorem Inv.push_arr {f : Flat} (hI : Inv f) (v : alloc.vec.Vec Std.U8) (v1 v2 : alloc.vec.Vec Std.Usize)
    (nm : Slice Std.U8) (start len : Std.Usize)
    (hstart : start.val = f.anames.val.length) (hlen : len.val = nm.val.length)
    (hnew : ∀ a < narrs f, arrName f a ≠ nm.val)
    (hv : v.val = f.anames.val ++ nm.val) (hv1 : v1.val = f.aname_start.val ++ [start])
    (hv2 : v2.val = f.aname_len.val ++ [len]) :
    Inv { f with anames := v, aname_start := v1, aname_len := v2 } := by
  have hnpre : f.anames.val <+: v.val := by rw [hv]; exact List.prefix_append _ _
  have h1 : narrs f = f.aname_start.val.length := rfl
  have h2 : narrs f = f.aname_len.val.length := hI.arr_len.symm
  have hna : narrs { f with anames := v, aname_start := v1, aname_len := v2 } = narrs f + 1 := by
    simp only [narrs]; rw [hv1]; simp
  have hname : ∀ a < narrs f, arrName { f with anames := v, aname_start := v1, aname_len := v2 } a
      = arrName f a := by
    intro a ha
    simp only [arrName]
    rw [hv1, hv2, getD_of_prefix (List.prefix_append _ _) ha,
      getD_of_prefix (List.prefix_append _ _) (by rw [hI.arr_len]; exact ha)]
    exact nameAt_of_prefix hnpre _ _ (hI.arr_range a ha)
  have hname_new : arrName { f with anames := v, aname_start := v1, aname_len := v2 } (narrs f)
      = nm.val := by
    simp only [arrName]
    rw [hv1, hv2, h1, getD_snoc_length, ← h1, h2, getD_snoc_length, hv, hstart, hlen]
    exact nameAt_append_self _ _
  refine ⟨hI.var_len1, hI.var_len2, hI.var_len3, hI.var_range, hI.var_node_lt, hI.var_is_var,
    hI.var_inj, hI.var_node_inj, hI.const_len1, hI.const_len2, hI.const_ok, ?_, ?_, ?_,
    hI.fun_len1, hI.fun_len2, hI.fun_range, hI.fun_inj, ?_⟩
  · show v2.val.length = v1.val.length
    rw [hv1, hv2, List.length_append, List.length_append, hI.arr_len]; rfl
  · intro a ha
    rw [hna] at ha
    simp only []
    rcases Nat.lt_or_ge a (narrs f) with hlt | hge
    · have := hI.arr_range a hlt
      rw [hv1, hv2, getD_of_prefix (List.prefix_append _ _) hlt,
        getD_of_prefix (List.prefix_append _ _) (by rw [hI.arr_len]; exact hlt), hv,
        List.length_append]
      omega
    · have ha' : a = narrs f := by omega
      subst ha'
      rw [hv1, hv2, h1, getD_snoc_length, ← h1, h2, getD_snoc_length, hv, hstart, hlen]
      simp
  · intro a1 ha1 a2 ha2 heq
    rw [hna] at ha1 ha2
    rcases Nat.lt_or_ge a1 (narrs f) with h1 | h1 <;> rcases Nat.lt_or_ge a2 (narrs f) with h2 | h2
    · rw [hname a1 h1, hname a2 h2] at heq
      exact hI.arr_inj a1 h1 a2 h2 heq
    · have ha2' : a2 = narrs f := by omega
      subst ha2'
      rw [hname a1 h1, hname_new] at heq
      exact absurd heq (hnew a1 h1)
    · have ha1' : a1 = narrs f := by omega
      subst ha1'
      rw [hname_new, hname a2 h2] at heq
      exact absurd heq.symm (hnew a2 h2)
    · omega
  · intro i hi
    have := hI.sel_range i hi
    rw [hna]
    simp only [nfuncs] at this ⊢
    exact ⟨fun aid j s n h => Nat.lt_succ_of_lt (this.1 aid j s n h), this.2⟩

/-- Pushing a new function name and width. -/
theorem Later.push_fun (f : Flat) (v : alloc.vec.Vec Std.U8) (v1 v2 v3 : alloc.vec.Vec Std.Usize)
    (nm : Slice Std.U8) (start len w : Std.Usize)
    (hv : v.val = f.fnames.val ++ nm.val) (hv1 : v1.val = f.fname_start.val ++ [start])
    (hv2 : v2.val = f.fname_len.val ++ [len]) (hv3 : v3.val = f.func_width.val ++ [w]) :
    Later f { f with fnames := v, fname_start := v1, fname_len := v2, func_width := v3 } := by
  refine ⟨List.prefix_rfl, List.prefix_rfl, List.prefix_rfl, Eq.refl _, List.prefix_rfl,
   List.prefix_rfl, List.prefix_rfl, List.prefix_rfl, List.prefix_rfl, List.prefix_rfl,
   List.prefix_rfl, List.prefix_rfl, List.prefix_rfl, List.prefix_rfl, List.prefix_rfl,
   ?_, ?_, ?_, ?_⟩
  · show f.fnames.val <+: v.val
    rw [hv]; exact List.prefix_append _ _
  · show f.fname_start.val <+: v1.val
    rw [hv1]; exact List.prefix_append _ _
  · show f.fname_len.val <+: v2.val
    rw [hv2]; exact List.prefix_append _ _
  · show f.func_width.val <+: v3.val
    rw [hv3]; exact List.prefix_append _ _

theorem Inv.push_fun {f : Flat} (hI : Inv f) (v : alloc.vec.Vec Std.U8) (v1 v2 v3 : alloc.vec.Vec Std.Usize)
    (nm : Slice Std.U8) (start len w : Std.Usize)
    (hstart : start.val = f.fnames.val.length) (hlen : len.val = nm.val.length)
    (hnew : ∀ g < nfuncs f, funName f g ≠ nm.val)
    (hv : v.val = f.fnames.val ++ nm.val) (hv1 : v1.val = f.fname_start.val ++ [start])
    (hv2 : v2.val = f.fname_len.val ++ [len]) (hv3 : v3.val = f.func_width.val ++ [w]) :
    Inv { f with fnames := v, fname_start := v1, fname_len := v2, func_width := v3 } := by
  have hnpre : f.fnames.val <+: v.val := by rw [hv]; exact List.prefix_append _ _
  have h1 : nfuncs f = f.fname_start.val.length := rfl
  have h2 : nfuncs f = f.fname_len.val.length := hI.fun_len1.symm
  have hnf : nfuncs { f with fnames := v, fname_start := v1, fname_len := v2, func_width := v3 }
      = nfuncs f + 1 := by
    simp only [nfuncs]; rw [hv1]; simp
  have hname : ∀ g < nfuncs f, funName { f with fnames := v, fname_start := v1, fname_len := v2, func_width := v3 } g = funName f g := by
    intro g hg
    simp only [funName]
    rw [hv1, hv2, getD_of_prefix (List.prefix_append _ _) hg,
      getD_of_prefix (List.prefix_append _ _) (by rw [hI.fun_len1]; exact hg)]
    exact nameAt_of_prefix hnpre _ _ (hI.fun_range g hg)
  have hname_new : funName { f with fnames := v, fname_start := v1, fname_len := v2, func_width := v3 } (nfuncs f) = nm.val := by
    simp only [funName]
    rw [hv1, hv2, h1, getD_snoc_length, ← h1, h2, getD_snoc_length, hv, hstart, hlen]
    exact nameAt_append_self _ _
  refine ⟨hI.var_len1, hI.var_len2, hI.var_len3, hI.var_range, hI.var_node_lt, hI.var_is_var,
    hI.var_inj, hI.var_node_inj, hI.const_len1, hI.const_len2, hI.const_ok, hI.arr_len,
    hI.arr_range, hI.arr_inj, ?_, ?_, ?_, ?_, ?_⟩
  · show v2.val.length = v1.val.length
    rw [hv1, hv2, List.length_append, List.length_append, hI.fun_len1]; rfl
  · show v3.val.length = v1.val.length
    rw [hv1, hv3, List.length_append, List.length_append, hI.fun_len2]; rfl
  · intro g hg
    rw [hnf] at hg
    simp only []
    rcases Nat.lt_or_ge g (nfuncs f) with hlt | hge
    · have := hI.fun_range g hlt
      rw [hv1, hv2, getD_of_prefix (List.prefix_append _ _) hlt,
        getD_of_prefix (List.prefix_append _ _) (by rw [hI.fun_len1]; exact hlt), hv,
        List.length_append]
      omega
    · have hg' : g = nfuncs f := by omega
      subst hg'
      rw [hv1, hv2, h1, getD_snoc_length, ← h1, h2, getD_snoc_length, hv, hstart, hlen]
      simp
  · intro g1 hg1 g2 hg2 heq
    rw [hnf] at hg1 hg2
    rcases Nat.lt_or_ge g1 (nfuncs f) with h1 | h1 <;> rcases Nat.lt_or_ge g2 (nfuncs f) with h2 | h2
    · rw [hname g1 h1, hname g2 h2] at heq
      exact hI.fun_inj g1 h1 g2 h2 heq
    · have hg2' : g2 = nfuncs f := by omega
      subst hg2'
      rw [hname g1 h1, hname_new] at heq
      exact absurd heq (hnew g1 h1)
    · have hg1' : g1 = nfuncs f := by omega
      subst hg1'
      rw [hname_new, hname g2 h2] at heq
      exact absurd heq.symm (hnew g2 h2)
    · omega
  · intro i hi
    have := hI.sel_range i hi
    rw [hnf]
    simp only [narrs] at this ⊢
    exact ⟨this.1, fun fid w' s n h => Nat.lt_succ_of_lt (this.2 fid w' s n h)⟩

/- ══════════════════ THE LEAVES ══════════════════ -/

/-- What flattening a constant establishes. -/
def ConstPost (f : Flat) (value : Std.U128) (w : Std.Usize) (i : Std.Usize) (f' : Flat) : Prop :=
  Later f f' ∧ Inv f' ∧ i.val < f'.nodes.val.length ∧ ∃ s : Std.Usize,
    f'.nodes.val.getD i.val dfltExt = .Core (.Const s w) ∧ s.val + w.val ≤ f'.bits.val.length ∧
    ∀ j < w.val, f'.bits.val.getD (s.val + j) false = value.val.testBit j

/-- The push branch of `flat_const` (Aeneas emits it twice). -/
theorem flat_const_push_ok {f : Flat} {value : Std.U128} {w : Std.Usize} {i : Std.Usize} {f' : Flat}
    (hI : Inv f)
    (h : (do
      let v ← kernel.term_kernel.bits_push f.bits value w
      let i1 := alloc.vec.Vec.len f.nodes
      let v1 ← alloc.vec.Vec.push f.nodes
        (kernel.sliver_kernel.ExtNode.Core (blast_kernel.DagNode.Const (alloc.vec.Vec.len f.bits) w))
      let v2 ← alloc.vec.Vec.push f.const_value value
      let v3 ← alloc.vec.Vec.push f.const_width w
      let v4 ← alloc.vec.Vec.push f.const_node i1
      ok (i1, { f with nodes := v1, bits := v, const_value := v2, const_width := v3, const_node := v4 }))
      = ok (i, f')) :
    ConstPost f value w i f' := by
  obtain ⟨v, hv, h⟩ := bind_ok_inv h
  obtain ⟨v1, hv1, h⟩ := bind_ok_inv h
  obtain ⟨v2, hv2, h⟩ := bind_ok_inv h
  obtain ⟨v3, hv3, h⟩ := bind_ok_inv h
  obtain ⟨v4, hv4, h⟩ := bind_ok_inv h
  cases h
  have hv' := bits_push_ok hv
  have hv1' := push_ok hv1
  have hv2' := push_ok hv2
  have hv3' := push_ok hv3
  have hv4' := push_ok hv4
  have hs : (alloc.vec.Vec.len f.bits).val = f.bits.val.length := by simp
  have hi : (alloc.vec.Vec.len f.nodes).val = f.nodes.val.length := by simp
  refine ⟨Later.push_const f v1 v v2 v3 v4 _ w value _ hv1' hv' hv2' hv3' hv4',
    Inv.push_const hI v1 v v2 v3 v4 _ w value _ hs hi hv1' hv' hv2' hv3' hv4', ?_, ?_⟩
  · show (alloc.vec.Vec.len f.nodes).val < v1.val.length
    rw [hv1', hi]; simp
  · refine ⟨alloc.vec.Vec.len f.bits, ?_, ?_, ?_⟩
    · show v1.val.getD (alloc.vec.Vec.len f.nodes).val dfltExt = _
      rw [hi, hv1', getD_snoc_length]
    · show (alloc.vec.Vec.len f.bits).val + w.val ≤ v.val.length
      rw [hs, hv']; simp
    · intro j hj
      show v.val.getD ((alloc.vec.Vec.len f.bits).val + j) false = value.val.testBit j
      rw [hs, hv', getD_append_at _ _ _ _ (by simp; exact hj), block_getD _ _ _ hj]

theorem flat_const_ok {f : Flat} {value : Std.U128} {w : Std.Usize} {i : Std.Usize} {f' : Flat}
    (hI : Inv f) (h : kernel.term_kernel.flat_const f value w = ok (i, f')) :
    ConstPost f value w i f' := by
  unfold kernel.term_kernel.flat_const at h
  dsimp only at h
  obtain ⟨k, hk, h⟩ := bind_ok_inv h
  have hfind := const_find_ok hk
  split at h
  · rename_i hne
    have hne' : k ≠ NONE := by simpa [NONE] using hne
    split at h
    · rename_i hlt
      obtain ⟨i1, hi1, h⟩ := bind_ok_inv h
      cases h
      obtain ⟨_, hi1v⟩ := vec_index_ok hi1
      obtain ⟨hkl, _, _, hval, hwid⟩ := hfind.2 hne'
      have hkn : k.val < nconsts f := by simpa using hlt
      obtain ⟨hlt', s, hnode, hr, hb⟩ := hI.const_ok k.val hkn
      refine ⟨Later.rfl f, hI, ?_, s, ?_, ?_, ?_⟩
      · rw [hi1v 0#usize]; exact hlt'
      · rw [hi1v 0#usize]
        simp only [constNodeOf] at hnode
        rw [hnode]
        simp only [alloc.vec.Vec.deref] at hwid
        rw [hwid]
      · simp only [constWidthOf, alloc.vec.Vec.deref] at hr hwid
        rw [hwid] at hr
        exact hr
      · intro j hj
        simp only [constWidthOf, constValOf, alloc.vec.Vec.deref] at hb hwid hval
        rw [hwid] at hb
        rw [hval] at hb
        exact hb j hj
    · exact flat_const_push_ok hI h
  · exact flat_const_push_ok hI h

/-- What flattening a variable establishes. -/
def VarPost (f : Flat) (nm : Slice Std.U8) (w : Std.Usize)
    (r : core.result.Result Std.Usize FlatError) (f' : Flat) : Prop :=
  Later f f' ∧ Inv f' ∧ ∀ i, r = .Ok i → i.val < f'.nodes.val.length ∧
    ∃ k < nvars f', varNodeOf f' k = i.val ∧ varName f' k = nm.val ∧ varWidthOf f' k = w.val

/-- A table miss means no entry carries the name. -/
theorem no_var_of_miss {f : Flat} (hI : Inv f) {nm : Slice Std.U8}
    (hmiss : ∀ j < f.name_start.val.length, ¬ Matches f.names.val f.name_start.val f.name_len.val nm.val j) :
    ∀ k < nvars f, varName f k ≠ nm.val := by
  intro k hk heq
  apply hmiss k (by rw [hI.var_len1]; exact hk)
  have hr := hI.var_range k hk
  refine ⟨by rw [hI.var_len1]; exact hk, by rw [hI.var_len2]; exact hk, ?_, hr, heq⟩
  have := nameAt_length f.names.val (f.name_start.val.getD k 0#usize).val
    (f.name_len.val.getD k 0#usize).val hr
  unfold varName at heq
  rw [heq] at this
  exact this.symm

theorem flat_var_ok {f : Flat} {nm : Slice Std.U8} {w : Std.Usize}
    {r : core.result.Result Std.Usize FlatError} {f' : Flat}
    (hI : Inv f) (h : kernel.term_kernel.flat_var f nm w = ok (r, f')) : VarPost f nm w r f' := by
  unfold kernel.term_kernel.flat_var at h
  dsimp only at h
  obtain ⟨k, hk, h⟩ := bind_ok_inv h
  have hfind := table_find_ok hk
  split at h
  · rename_i hne
    have hne' : k ≠ NONE := by simpa [NONE] using hne
    obtain ⟨hkl, hkl2, hkl3, hlen, hr, hname⟩ := hfind.2 hne'
    simp only [alloc.vec.Vec.deref] at hkl hkl2 hkl3 hlen hr hname
    split at h
    · cases h
      exact ⟨Later.rfl f, hI, fun i hi => nomatch hi⟩
    · rename_i hge
      split at h
      · cases h
        exact ⟨Later.rfl f, hI, fun i hi => nomatch hi⟩
      · rename_i hge2
        obtain ⟨i2, hi2, h⟩ := bind_ok_inv h
        split at h
        · cases h
          exact ⟨Later.rfl f, hI, fun i hi => nomatch hi⟩
        · rename_i hweq
          obtain ⟨i3, hi3, h⟩ := bind_ok_inv h
          cases h
          obtain ⟨_, hi2v⟩ := vec_index_ok hi2
          obtain ⟨hkn, hi3v⟩ := vec_index_ok hi3
          have hweq' : i2 = w := UScalar.eq_of_val_eq (by simpa using hweq)
          refine ⟨Later.rfl f, hI, fun i hi => ?_⟩
          cases hi
          refine ⟨?_, k.val, hkn, ?_, ?_, ?_⟩
          · rw [hi3v 0#usize]
            exact hI.var_node_lt k.val hkn
          · rw [hi3v 0#usize]; rfl
          · unfold varName; exact hname
          · unfold varWidthOf
            rw [← hi2v 0#usize, hweq']
  · rename_i hnn
    have hnn' : k = NONE := UScalar.eq_of_val_eq (by simpa [NONE] using hnn)
    have hmiss := hfind.1 hnn'
    simp only [alloc.vec.Vec.deref] at hmiss
    have hnew := no_var_of_miss hI hmiss
    obtain ⟨v, hv, h⟩ := bind_ok_inv h
    obtain ⟨v1, hv1, h⟩ := bind_ok_inv h
    obtain ⟨v2, hv2, h⟩ := bind_ok_inv h
    obtain ⟨v3, hv3, h⟩ := bind_ok_inv h
    obtain ⟨v4, hv4, h⟩ := bind_ok_inv h
    obtain ⟨v5, hv5, h⟩ := bind_ok_inv h
    cases h
    have hv' := arena_push_ok hv
    have hv1' := push_ok hv1
    have hv2' := push_ok hv2
    have hv3' := push_ok hv3
    have hv4' := push_ok hv4
    have hv5' := push_ok hv5
    have hstart : (alloc.vec.Vec.len f.names).val = f.names.val.length := by simp
    have hlen : (Slice.len nm).val = nm.val.length := by simp
    have hi : (alloc.vec.Vec.len f.nodes).val = f.nodes.val.length := by simp
    have hL := Later.push_var f v1 v v2 v3 v4 v5 nm w _ _ _ hv1' hv' hv2' hv3' hv4' hv5'
    have hI' := Inv.push_var hI v1 v v2 v3 v4 v5 nm w _ _ _ hstart hlen hi hnew hv1' hv' hv2' hv3'
      hv4' hv5'
    refine ⟨hL, hI', fun i hi' => ?_⟩
    cases hi'
    refine ⟨?_, nvars f, ?_, ?_, ?_, ?_⟩
    · show (alloc.vec.Vec.len f.nodes).val < v1.val.length
      rw [hi, hv1']; simp
    · show nvars f < v4.val.length
      rw [hv4']; simp [nvars]
    · show (v4.val.getD f.var_node.val.length 0#usize).val = (alloc.vec.Vec.len f.nodes).val
      rw [hv4', getD_snoc_length]
    · show nameAt v.val (v2.val.getD (nvars f) 0#usize).val (v3.val.getD (nvars f) 0#usize).val = nm.val
      have h1 : nvars f = f.name_start.val.length := hI.var_len1.symm
      have h2 : nvars f = f.name_len.val.length := hI.var_len2.symm
      rw [hv2', hv3', h1, getD_snoc_length, ← h1, h2, getD_snoc_length, hv', hstart, hlen]
      exact nameAt_append_self _ _
    · show (v5.val.getD (nvars f) 0#usize).val = w.val
      have h3 : nvars f = f.var_width.val.length := hI.var_len3.symm
      rw [hv5', h3, getD_snoc_length]

theorem no_arr_of_miss {f : Flat} (hI : Inv f) {nm : Slice Std.U8}
    (hmiss : ∀ j < f.aname_start.val.length, ¬ Matches f.anames.val f.aname_start.val f.aname_len.val nm.val j) :
    ∀ a < narrs f, arrName f a ≠ nm.val := by
  intro a ha heq
  apply hmiss a ha
  have hr := hI.arr_range a ha
  refine ⟨ha, by rw [hI.arr_len]; exact ha, ?_, hr, heq⟩
  have := nameAt_length f.anames.val (f.aname_start.val.getD a 0#usize).val
    (f.aname_len.val.getD a 0#usize).val hr
  unfold arrName at heq
  rw [heq] at this
  exact this.symm

theorem flat_array_id_ok {f : Flat} {nm : Slice Std.U8} {a : Std.Usize} {f' : Flat}
    (hI : Inv f) (h : kernel.term_kernel.flat_array_id f nm = ok (a, f')) :
    Later f f' ∧ Inv f' ∧ a.val < narrs f' ∧ arrName f' a.val = nm.val := by
  unfold kernel.term_kernel.flat_array_id at h
  dsimp only at h
  obtain ⟨k, hk, h⟩ := bind_ok_inv h
  have hfind := table_find_ok hk
  split at h
  · rename_i hne
    cases h
    have hne' : a ≠ NONE := by simpa [NONE] using hne
    obtain ⟨hkl, _, _, _, _, hname⟩ := hfind.2 hne'
    simp only [alloc.vec.Vec.deref] at hkl hname
    exact ⟨Later.rfl f, hI, hkl, hname⟩
  · rename_i hnn
    have hnn' : k = NONE := UScalar.eq_of_val_eq (by simpa [NONE] using hnn)
    have hmiss := hfind.1 hnn'
    simp only [alloc.vec.Vec.deref] at hmiss
    have hnew := no_arr_of_miss hI hmiss
    obtain ⟨v, hv, h⟩ := bind_ok_inv h
    obtain ⟨v1, hv1, h⟩ := bind_ok_inv h
    obtain ⟨v2, hv2, h⟩ := bind_ok_inv h
    cases h
    have hv' := arena_push_ok hv
    have hv1' := push_ok hv1
    have hv2' := push_ok hv2
    have hstart : (alloc.vec.Vec.len f.anames).val = f.anames.val.length := by simp
    have hlen : (Slice.len nm).val = nm.val.length := by simp
    refine ⟨Later.push_arr f v v1 v2 nm _ _ hv' hv1' hv2',
      Inv.push_arr hI v v1 v2 nm _ _ hstart hlen hnew hv' hv1' hv2', ?_, ?_⟩
    · show (alloc.vec.Vec.len f.aname_start).val < v1.val.length
      rw [hv1']; simp
    · show nameAt v.val (v1.val.getD (alloc.vec.Vec.len f.aname_start).val 0#usize).val
        (v2.val.getD (alloc.vec.Vec.len f.aname_start).val 0#usize).val = nm.val
      have h0 : (alloc.vec.Vec.len f.aname_start).val = f.aname_start.val.length := by simp
      have h2 : f.aname_start.val.length = f.aname_len.val.length := hI.arr_len.symm
      rw [h0, hv1', hv2', getD_snoc_length, h2, getD_snoc_length, hv', hstart, hlen]
      exact nameAt_append_self _ _

theorem no_fun_of_miss {f : Flat} (hI : Inv f) {nm : Slice Std.U8}
    (hmiss : ∀ j < f.fname_start.val.length, ¬ Matches f.fnames.val f.fname_start.val f.fname_len.val nm.val j) :
    ∀ g < nfuncs f, funName f g ≠ nm.val := by
  intro g hg heq
  apply hmiss g hg
  have hr := hI.fun_range g hg
  refine ⟨hg, by rw [hI.fun_len1]; exact hg, ?_, hr, heq⟩
  have := nameAt_length f.fnames.val (f.fname_start.val.getD g 0#usize).val
    (f.fname_len.val.getD g 0#usize).val hr
  unfold funName at heq
  rw [heq] at this
  exact this.symm

theorem flat_func_id_ok {f : Flat} {nm : Slice Std.U8} {w : Std.Usize}
    {r : core.result.Result Std.Usize FlatError} {f' : Flat}
    (hI : Inv f) (h : kernel.term_kernel.flat_func_id f nm w = ok (r, f')) :
    Later f f' ∧ Inv f' ∧ ∀ g, r = .Ok g → g.val < nfuncs f' ∧ funName f' g.val = nm.val := by
  unfold kernel.term_kernel.flat_func_id at h
  dsimp only at h
  obtain ⟨k, hk, h⟩ := bind_ok_inv h
  have hfind := table_find_ok hk
  split at h
  · rename_i hne
    have hne' : k ≠ NONE := by simpa [NONE] using hne
    obtain ⟨hkl, _, _, _, _, hname⟩ := hfind.2 hne'
    simp only [alloc.vec.Vec.deref] at hkl hname
    split at h
    · cases h
      exact ⟨Later.rfl f, hI, fun g hg => nomatch hg⟩
    · obtain ⟨i1, hi1, h⟩ := bind_ok_inv h
      split at h
      · cases h
        exact ⟨Later.rfl f, hI, fun g hg => nomatch hg⟩
      · cases h
        refine ⟨Later.rfl f, hI, fun g hg => ?_⟩
        cases hg
        exact ⟨hkl, hname⟩
  · rename_i hnn
    have hnn' : k = NONE := UScalar.eq_of_val_eq (by simpa [NONE] using hnn)
    have hmiss := hfind.1 hnn'
    simp only [alloc.vec.Vec.deref] at hmiss
    have hnew := no_fun_of_miss hI hmiss
    obtain ⟨v, hv, h⟩ := bind_ok_inv h
    obtain ⟨v1, hv1, h⟩ := bind_ok_inv h
    obtain ⟨v2, hv2, h⟩ := bind_ok_inv h
    obtain ⟨v3, hv3, h⟩ := bind_ok_inv h
    cases h
    have hv' := arena_push_ok hv
    have hv1' := push_ok hv1
    have hv2' := push_ok hv2
    have hv3' := push_ok hv3
    have hstart : (alloc.vec.Vec.len f.fnames).val = f.fnames.val.length := by simp
    have hlen : (Slice.len nm).val = nm.val.length := by simp
    refine ⟨Later.push_fun f v v1 v2 v3 nm _ _ w hv' hv1' hv2' hv3',
      Inv.push_fun hI v v1 v2 v3 nm _ _ w hstart hlen hnew hv' hv1' hv2' hv3', fun g hg => ?_⟩
    cases hg
    refine ⟨?_, ?_⟩
    · show (alloc.vec.Vec.len f.fname_start).val < v1.val.length
      rw [hv1']; simp
    · show nameAt v.val (v1.val.getD (alloc.vec.Vec.len f.fname_start).val 0#usize).val
        (v2.val.getD (alloc.vec.Vec.len f.fname_start).val 0#usize).val = nm.val
      have h0 : (alloc.vec.Vec.len f.fname_start).val = f.fname_start.val.length := by simp
      have h2 : f.fname_start.val.length = f.fname_len.val.length := hI.fun_len1.symm
      rw [h0, hv1', hv2', getD_snoc_length, h2, getD_snoc_length, hv', hstart, hlen]
      exact nameAt_append_self _ _

/- ══════════════════ NODE VALUES ══════════════════ -/

theorem div2_ok {i n : Std.Usize} (h : i / 2#usize = ok n) : n.val = i.val / 2 := by
  obtain ⟨z, hz, hzv⟩ := UScalar.div_spec i (y := 2#usize) (by simp)
  rw [h] at hz
  cases hz
  simpa using hzv

/-- The value of a closed node: `dagNodeVal` over the earlier nodes' values. -/
theorem core_node_val (f : Flat) (env : TEnv) (arrs : NArrs) (ufs : NUfs) (inp : List Bool)
    {i : Nat} {nd : blast_kernel.DagNode} (hi : i < f.nodes.val.length)
    (hnd : f.nodes.val.getD i dfltExt = .Core nd) :
    (simOf f env arrs ufs inp).getD i dDflt
      = dagNodeVal inp f.bits.val
          (extSim inp f.bits.val (arrsI f arrs) (ufsI f ufs) f.side.val (f.nodes.val.take i))
          (extNin (f.nodes.val.take i)) nd := by
  unfold simOf
  rw [extSim_getD_eq _ _ _ _ _ _ i hi, ← getD_eq_getElem_of_lt hi dfltExt, hnd]
  rfl

/-- The value of a select node. -/
theorem select_node_val (f : Flat) (env : TEnv) (arrs : NArrs) (ufs : NUfs) (inp : List Bool)
    {i : Nat} {aid j s n : Std.Usize} (hi : i < f.nodes.val.length)
    (hnd : f.nodes.val.getD i dfltExt = .Select aid j s n) :
    (simOf f env arrs ufs inp).getD i dDflt
      = ⟨8, chainRead (arrsI f arrs)
          (extSim inp f.bits.val (arrsI f arrs) (ufsI f ufs) f.side.val (f.nodes.val.take i))
          f.side.val aid.val
          (toW 32 ((extSim inp f.bits.val (arrsI f arrs) (ufsI f ufs) f.side.val (f.nodes.val.take i)).getD j.val dDflt))
          s.val n.val⟩ := by
  unfold simOf
  rw [extSim_getD_eq _ _ _ _ _ _ i hi, ← getD_eq_getElem_of_lt hi dfltExt, hnd]
  rfl

/-- The value of a call node. -/
theorem call_node_val (f : Flat) (env : TEnv) (arrs : NArrs) (ufs : NUfs) (inp : List Bool)
    {i : Nat} {fid w s n : Std.Usize} (hi : i < f.nodes.val.length)
    (hnd : f.nodes.val.getD i dfltExt = .Call fid w s n) :
    (simOf f env arrs ufs inp).getD i dDflt
      = ⟨w.val, toW w.val (ufsI f ufs fid.val (argVals
          (extSim inp f.bits.val (arrsI f arrs) (ufsI f ufs) f.side.val (f.nodes.val.take i))
          f.side.val s.val n.val))⟩ := by
  unfold simOf
  rw [extSim_getD_eq _ _ _ _ _ _ i hi, ← getD_eq_getElem_of_lt hi dfltExt, hnd]
  rfl

/-- An earlier node's value is the same in the prefix simulation. -/
theorem take_val (f : Flat) (env : TEnv) (arrs : NArrs) (ufs : NUfs) (inp : List Bool)
    {i x : Nat} (hx : x < i) :
    (extSim inp f.bits.val (arrsI f arrs) (ufsI f ufs) f.side.val (f.nodes.val.take i)).getD x dDflt
      = (simOf f env arrs ufs inp).getD x dDflt :=
  extSim_take_getD _ _ _ _ _ _ i x hx

/-- A node pushed at `i` is still that node in every later state. -/
theorem pushed_node_later {f1 : Flat} {v : alloc.vec.Vec ExtNode} {nd : ExtNode}
    (hv : v.val = f1.nodes.val ++ [nd]) {f'' : Flat} (hL : Later { f1 with nodes := v } f'')
    {i : Nat} (hi : i = f1.nodes.val.length) :
    f''.nodes.val.getD i dfltExt = nd := by
  have hlt : i < v.val.length := by rw [hv, hi]; simp
  rw [getD_of_prefix hL.nodes hlt, hv, hi, getD_snoc_length]

theorem pushed_node_later2 {f1 : Flat} {v : alloc.vec.Vec ExtNode} {sv : alloc.vec.Vec Std.Usize}
    {nd : ExtNode} (hv : v.val = f1.nodes.val ++ [nd]) {f'' : Flat}
    (hL : Later { f1 with nodes := v, side := sv } f'') {i : Nat} (hi : i = f1.nodes.val.length) :
    f''.nodes.val.getD i dfltExt = nd := by
  have hlt : i < v.val.length := by rw [hv, hi]; simp
  rw [getD_of_prefix hL.nodes hlt, hv, hi, getD_snoc_length]

theorem treeArgs_length (env : TEnv) (arrs : NArrs) (ufs : NUfs) (a : TArgs) :
    (treeArgs env arrs ufs a).length = argsLen a := by
  cases a with
  | Nil => rfl
  | Cons t rest => simp [treeArgs, argsLen, treeArgs_length env arrs ufs rest]
termination_by structural a

/- ══════════════════ THE POSTCONDITIONS ══════════════════ -/

def BvPost (t : TBv) (f : Flat) (r : core.result.Result (Std.Usize × Std.Usize) FlatError)
    (f' : Flat) : Prop :=
  Later f f' ∧ Inv f' ∧ ∀ i w, r = .Ok (i, w) → i.val < f'.nodes.val.length ∧ TreeCorr f' i.val t

def BoolPost (t : TBool) (f : Flat) (r : core.result.Result Std.Usize FlatError) (f' : Flat) : Prop :=
  Later f f' ∧ Inv f' ∧ ∀ i, r = .Ok i → i.val < f'.nodes.val.length ∧ BoolCorr f' i.val t

def ArrPost (a : TArray) (f : Flat) (levels : alloc.vec.Vec Std.Usize)
    (r : core.result.Result Std.Usize FlatError) (f' : Flat) (levels' : alloc.vec.Vec Std.Usize) : Prop :=
  Later f f' ∧ Inv f' ∧ ∀ aid, r = .Ok aid → ∃ L : List Std.Usize,
    levels'.val = levels.val ++ L ∧ L.length = 2 * chainLen a ∧
    (∀ k < L.length, (L.getD k 0#usize).val < f'.nodes.val.length) ∧
    aid.val < narrs f' ∧ arrName f' aid.val = baseName a ∧ ChainCorr f' L a aid.val

def ArgsPost (a : TArgs) (f : Flat) (ids : alloc.vec.Vec Std.Usize)
    (r : core.result.Result Unit FlatError) (f' : Flat) (ids' : alloc.vec.Vec Std.Usize) : Prop :=
  Later f f' ∧ Inv f' ∧ (r = .Ok () → ∃ I : List Std.Usize,
    ids'.val = ids.val ++ I ∧ I.length = argsLen a ∧
    (∀ k < I.length, (I.getD k 0#usize).val < f'.nodes.val.length) ∧ ArgsCorr f' I a)

/-- The semantic conclusion of a width-preserving binary operator node. -/
def BinCorr (f : Flat) (i : Nat) (op : Nat) (a b : TBv) : Prop :=
  ∀ f' env arrs ufs inp, Later f f' → Inv f' → VarAgree f' env inp →
    (simOf f' env arrs ufs inp).getD i dDflt
      = binVal op (treeBv env arrs ufs a) (treeBv env arrs ufs b)

def CmpCorr (f : Flat) (i : Nat) (op : Nat) (a b : TBv) : Prop :=
  ∀ f' env arrs ufs inp, Later f f' → Inv f' → VarAgree f' env inp →
    (simOf f' env arrs ufs inp).getD i dDflt
      = cmpVal op (treeBv env arrs ufs a) (treeBv env arrs ufs b)

/- ══════════════════ THE OPERATOR HELPERS ══════════════════ -/

/-- `flat_bin`, given the specs of its two operands. -/
theorem flat_bin_ok (a b : TBv) (f : Flat) (op : Std.Usize) (hI : Inv f)
    (ha : ∀ f, Inv f → ∀ r f', kernel.term_kernel.flat_bv a f = ok (r, f') → BvPost a f r f')
    (hb : ∀ f, Inv f → ∀ r f', kernel.term_kernel.flat_bv b f = ok (r, f') → BvPost b f r f')
    (r : core.result.Result (Std.Usize × Std.Usize) FlatError) (f' : Flat)
    (h : kernel.term_kernel.flat_bin a b f op = ok (r, f')) :
    Later f f' ∧ Inv f' ∧ ∀ i w, r = .Ok (i, w) → i.val < f'.nodes.val.length ∧
      BinCorr f' i.val op.val a b := by
  unfold kernel.term_kernel.flat_bin at h
  obtain ⟨⟨ra, f1⟩, hra, h⟩ := bind_ok_inv h
  obtain ⟨hL1, hI1, hc1⟩ := ha f hI ra f1 hra
  cases ra with
  | Err e =>
    cases h
    exact ⟨hL1, hI1, fun i w hiw => nomatch hiw⟩
  | Ok p =>
    obtain ⟨x, wa⟩ := p
    obtain ⟨⟨rb, f2⟩, hrb, h⟩ := bind_ok_inv h
    obtain ⟨hL2, hI2, hc2⟩ := hb f1 hI1 rb f2 hrb
    cases rb with
    | Err e =>
      cases h
      exact ⟨hL1.trans hL2, hI2, fun i w hiw => nomatch hiw⟩
    | Ok p1 =>
      obtain ⟨y, wb⟩ := p1
      simp at h
      split at h
      · obtain ⟨dn, hdn, h⟩ := bind_ok_inv h
        rw [bin_node_eq] at hdn
        cases hdn
        obtain ⟨⟨i, f3⟩, hpc, h⟩ := bind_ok_inv h
        cases h
        obtain ⟨hi, v, hf3, hv⟩ := push_core_ok hpc
        subst hf3
        have hL3 := Later.push_core f2 v _ hv
        obtain ⟨hxl, hxc⟩ := hc1 x wa rfl
        obtain ⟨hyl, hyc⟩ := hc2 y wb rfl
        have hxl2 : x.val < f2.nodes.val.length := lt_of_lt_of_le hxl hL2.nodes.length_le
        refine ⟨(hL1.trans hL2).trans hL3, Inv.push_core hI2 v _ hv, fun i' w hiw => ?_⟩
        cases hiw
        refine ⟨by show i.val < v.val.length; rw [hv, hi]; simp, ?_⟩
        intro f'' env arrs ufs inp hL hI'' hV
        rw [core_node_val f'' env arrs ufs inp (lt_of_lt_of_le (by rw [hi]; simp [hv]) hL.nodes.length_le)
          (pushed_node_later hv hL hi), dagNodeVal_pBinNode,
          take_val f'' env arrs ufs inp (by omega), take_val f'' env arrs ufs inp (by omega),
          hxc f'' env arrs ufs inp (hL2.trans (hL3.trans hL)) hI'' hV,
          hyc f'' env arrs ufs inp (hL3.trans hL) hI'' hV]
      · cases h
        exact ⟨hL1.trans hL2, hI2, fun i w hiw => nomatch hiw⟩

/-- `flat_cmp`, given the specs of its two operands. -/
theorem flat_cmp_ok (a b : TBv) (f : Flat) (op : Std.Usize) (hI : Inv f)
    (ha : ∀ f, Inv f → ∀ r f', kernel.term_kernel.flat_bv a f = ok (r, f') → BvPost a f r f')
    (hb : ∀ f, Inv f → ∀ r f', kernel.term_kernel.flat_bv b f = ok (r, f') → BvPost b f r f')
    (r : core.result.Result Std.Usize FlatError) (f' : Flat)
    (h : kernel.term_kernel.flat_cmp a b f op = ok (r, f')) :
    Later f f' ∧ Inv f' ∧ ∀ i, r = .Ok i → i.val < f'.nodes.val.length ∧
      CmpCorr f' i.val op.val a b := by
  unfold kernel.term_kernel.flat_cmp at h
  obtain ⟨⟨ra, f1⟩, hra, h⟩ := bind_ok_inv h
  obtain ⟨hL1, hI1, hc1⟩ := ha f hI ra f1 hra
  cases ra with
  | Err e =>
    cases h
    exact ⟨hL1, hI1, fun i hi => nomatch hi⟩
  | Ok p =>
    obtain ⟨x, wa⟩ := p
    obtain ⟨⟨rb, f2⟩, hrb, h⟩ := bind_ok_inv h
    obtain ⟨hL2, hI2, hc2⟩ := hb f1 hI1 rb f2 hrb
    cases rb with
    | Err e =>
      cases h
      exact ⟨hL1.trans hL2, hI2, fun i hi => nomatch hi⟩
    | Ok p1 =>
      obtain ⟨y, wb⟩ := p1
      simp at h
      split at h
      · obtain ⟨dn, hdn, h⟩ := bind_ok_inv h
        rw [cmp_node_eq] at hdn
        cases hdn
        obtain ⟨⟨i, f3⟩, hpc, h⟩ := bind_ok_inv h
        cases h
        obtain ⟨hi, v, hf3, hv⟩ := push_core_ok hpc
        subst hf3
        have hL3 := Later.push_core f2 v _ hv
        obtain ⟨hxl, hxc⟩ := hc1 x wa rfl
        obtain ⟨hyl, hyc⟩ := hc2 y wb rfl
        have hxl2 : x.val < f2.nodes.val.length := lt_of_lt_of_le hxl hL2.nodes.length_le
        refine ⟨(hL1.trans hL2).trans hL3, Inv.push_core hI2 v _ hv, fun i' hi' => ?_⟩
        cases hi'
        refine ⟨by show i.val < v.val.length; rw [hv, hi]; simp, ?_⟩
        intro f'' env arrs ufs inp hL hI'' hV
        rw [core_node_val f'' env arrs ufs inp (lt_of_lt_of_le (by rw [hi]; simp [hv]) hL.nodes.length_le)
          (pushed_node_later hv hL hi), dagNodeVal_pCmpNode,
          take_val f'' env arrs ufs inp (by omega), take_val f'' env arrs ufs inp (by omega),
          hxc f'' env arrs ufs inp (hL2.trans (hL3.trans hL)) hI'' hV,
          hyc f'' env arrs ufs inp (hL3.trans hL) hI'' hV]
      · cases h
        exact ⟨hL1.trans hL2, hI2, fun i hi => nomatch hi⟩

/- ══════════════════ A NODE WITH A SIDE-TABLE RANGE ══════════════════ -/

theorem bvOfFn_congr' {f g : Nat → Bool} {w : Nat} (h : ∀ j < w, f j = g j) :
    bvOfFn f w = bvOfFn g w := by
  apply BitVec.eq_of_getLsbD_eq
  intro j
  rw [getLsbD_bvOfFn, getLsbD_bvOfFn]
  by_cases hj : j < w
  · simp [hj, h j hj]
  · simp [hj]

theorem Later.push_node_side (f : Flat) (v1 : alloc.vec.Vec ExtNode) (sv : alloc.vec.Vec Std.Usize)
    (nd : ExtNode) (L : List Std.Usize) (hv1 : v1.val = f.nodes.val ++ [nd])
    (hsv : sv.val = f.side.val ++ L) : Later f { f with nodes := v1, side := sv } := by
  refine ⟨?_, List.prefix_rfl, ?_, Eq.refl _, List.prefix_rfl,
   List.prefix_rfl, List.prefix_rfl, List.prefix_rfl, List.prefix_rfl, List.prefix_rfl,
   List.prefix_rfl, List.prefix_rfl, List.prefix_rfl, List.prefix_rfl, List.prefix_rfl,
   List.prefix_rfl, List.prefix_rfl, List.prefix_rfl, List.prefix_rfl⟩
  · show f.nodes.val <+: v1.val
    rw [hv1]; exact List.prefix_append _ _
  · show f.side.val <+: sv.val
    rw [hsv]; exact List.prefix_append _ _

/-- Pushing a select or a call (with its side-table range): the invariant
    needs only that the array / function id is in the table. -/
theorem Inv.push_node_side {f : Flat} (hI : Inv f) (v1 : alloc.vec.Vec ExtNode)
    (sv : alloc.vec.Vec Std.Usize) (nd : ExtNode) (L : List Std.Usize)
    (hv1 : v1.val = f.nodes.val ++ [nd]) (hsv : sv.val = f.side.val ++ L)
    (hnd : (∀ aid j s n, nd = .Select aid j s n → aid.val < narrs f) ∧
      (∀ fid w s n, nd = .Call fid w s n → fid.val < nfuncs f)) :
    Inv { f with nodes := v1, side := sv } := by
  have hpre : f.nodes.val <+: v1.val := by rw [hv1]; exact List.prefix_append _ _
  have hlen : v1.val.length = f.nodes.val.length + 1 := by rw [hv1]; simp
  refine ⟨hI.var_len1, hI.var_len2, hI.var_len3, hI.var_range, ?_, ?_, hI.var_inj, hI.var_node_inj,
    hI.const_len1, hI.const_len2, ?_, hI.arr_len, hI.arr_range, hI.arr_inj, hI.fun_len1, hI.fun_len2,
    hI.fun_range, hI.fun_inj, ?_⟩
  · intro k hk
    have := hI.var_node_lt k hk
    show varNodeOf f k < v1.val.length
    omega
  · intro k hk
    have := hI.var_is_var k hk
    show v1.val.getD (varNodeOf f k) dfltExt = _
    rw [getD_of_prefix hpre (hI.var_node_lt k hk)]
    exact this
  · intro k hk
    obtain ⟨hlt, s, hnode, hr, hb⟩ := hI.const_ok k hk
    show constNodeOf f k < v1.val.length ∧ ∃ s : Std.Usize,
      v1.val.getD (constNodeOf f k) dfltExt = .Core (.Const s (f.const_width.val.getD k 0#usize)) ∧
      s.val + constWidthOf f k ≤ f.bits.val.length ∧
      ∀ j < constWidthOf f k, f.bits.val.getD (s.val + j) false = (constValOf f k).testBit j
    refine ⟨by omega, s, ?_, hr, hb⟩
    rw [getD_of_prefix hpre hlt]
    exact hnode
  · intro i hi
    have hi' : i < v1.val.length := hi
    show (∀ aid j s n, v1.val.getD i dfltExt = .Select aid j s n → aid.val < narrs f) ∧
      (∀ fid w s n, v1.val.getD i dfltExt = .Call fid w s n → fid.val < nfuncs f)
    rcases Nat.lt_or_ge i f.nodes.val.length with hlt | hge
    · have := hI.sel_range i hlt
      rw [getD_of_prefix hpre hlt]
      exact this
    · have : i = f.nodes.val.length := by omega
      subst this
      rw [hv1, getD_snoc_length]
      exact hnd

/- ══════════════════ THE MAIN INDUCTION ══════════════════ -/

/-- A `Var` node's value is the environment's value, under `VarAgree`. -/
theorem var_corr {f1 : Flat} {i : Nat} {k : Nat} {nm : Name} {w : Nat}
    (hI1 : Inv f1) (hk : k < nvars f1) (hnode : varNodeOf f1 k = i) (hname : varName f1 k = nm)
    (hwidth : varWidthOf f1 k = w) (f'' : Flat) (env : TEnv) (arrs : NArrs) (ufs : NUfs)
    (inp : List Bool) (hL : Later f1 f'') (hI'' : Inv f'') (hV : VarAgree f'' env inp) :
    (simOf f'' env arrs ufs inp).getD i dDflt = ⟨w, env nm w⟩ := by
  have hk'' : k < nvars f'' := lt_of_lt_of_le hk (nvars_later hL)
  have hnode'' : varNodeOf f'' k = i := by rw [varNodeOf_later hL hk]; exact hnode
  have hname'' : varName f'' k = nm := by rw [varName_later hL hI1 hk]; exact hname
  have hwidth'' : varWidthOf f'' k = w := by rw [varWidthOf_later hL hI1 hk]; exact hwidth
  have hv := hI''.var_is_var k hk''
  rw [hnode''] at hv
  have hil : i < f''.nodes.val.length := by
    have := hI''.var_node_lt k hk''
    rw [hnode''] at this
    exact this
  rw [core_node_val f'' env arrs ufs inp hil hv]
  simp only [dagNodeVal]
  have hw : (f''.var_width.val.getD k 0#usize).val = w := hwidth''
  have hV' := hV k hk''
  rw [hnode''] at hV'
  rw [hw]
  congr 1
  have hself : env nm w = bvOfFn (fun j => (env nm w).getLsbD j) w := by
    apply BitVec.eq_of_getLsbD_eq
    intro j
    rw [getLsbD_bvOfFn]
    by_cases hj : j < w
    · simp [hj]
    · have hge : w ≤ j := by omega
      simp [hj, BitVec.getLsbD_of_ge (env nm w) j hge]
  rw [hself]
  apply bvOfFn_congr'
  intro j hj
  rw [hV' j (by rw [hwidth'']; exact hj), hname'', hwidth'']

mutual

theorem flat_bv_ok (t : TBv) : ∀ (f : Flat), Inv f →
    ∀ (r : core.result.Result (Std.Usize × Std.Usize) FlatError) (f' : Flat),
      kernel.term_kernel.flat_bv t f = ok (r, f') → BvPost t f r f' := by
  intro f hI r f' h
  cases t with
  | Const value w =>
    unfold kernel.term_kernel.flat_bv at h
    obtain ⟨b, hb, h⟩ := bind_ok_inv h
    split at h
    · obtain ⟨⟨i, f1⟩, hc, h⟩ := bind_ok_inv h
      cases h
      obtain ⟨hL, hI1, hil, s, hnd, hr, hbits⟩ := flat_const_ok hI hc
      refine ⟨hL, hI1, fun i' w' hiw => ?_⟩
      cases hiw
      refine ⟨hil, ?_⟩
      intro f'' env arrs ufs inp hL' hI'' hV
      rw [core_node_val f'' env arrs ufs inp (lt_of_lt_of_le hil hL'.nodes.length_le)
        (by rw [nodes_getD_later hL' hil]; exact hnd)]
      simp only [dagNodeVal, treeBv]
      congr 1
      apply bvOfFn_congr'
      intro j hj
      rw [getD_of_prefix hL'.bits (by omega)]
      exact hbits j hj
    · cases h
      exact ⟨Later.rfl f, hI, fun i w hiw => nomatch hiw⟩
  | Var nm w =>
    unfold kernel.term_kernel.flat_bv at h
    obtain ⟨b, hb, h⟩ := bind_ok_inv h
    split at h
    · obtain ⟨⟨rv, f1⟩, hv, h⟩ := bind_ok_inv h
      obtain ⟨hL, hI1, hc⟩ := flat_var_ok hI hv
      cases rv with
      | Err e =>
        cases h
        exact ⟨hL, hI1, fun i w hiw => nomatch hiw⟩
      | Ok i =>
        cases h
        obtain ⟨hil, k, hk, hnode, hname, hwidth⟩ := hc i rfl
        refine ⟨hL, hI1, fun i' w' hiw => ?_⟩
        cases hiw
        refine ⟨hil, ?_⟩
        intro f'' env arrs ufs inp hL' hI'' hV
        rw [var_corr hI1 hk hnode hname hwidth f'' env arrs ufs inp hL' hI'' hV]
        rfl
    · cases h
      exact ⟨Later.rfl f, hI, fun i w hiw => nomatch hiw⟩
  | Add a b =>
    unfold kernel.term_kernel.flat_bv at h
    obtain ⟨hL, hI', hc⟩ := flat_bin_ok a b f 0#usize hI (flat_bv_ok a) (flat_bv_ok b) r f' h
    exact ⟨hL, hI', fun i w hiw => ⟨(hc i w hiw).1, fun f'' env arrs ufs inp hL' hI'' hV => by
      rw [(hc i w hiw).2 f'' env arrs ufs inp hL' hI'' hV]; rfl⟩⟩
  | Sub a b =>
    unfold kernel.term_kernel.flat_bv at h
    obtain ⟨hL, hI', hc⟩ := flat_bin_ok a b f 1#usize hI (flat_bv_ok a) (flat_bv_ok b) r f' h
    exact ⟨hL, hI', fun i w hiw => ⟨(hc i w hiw).1, fun f'' env arrs ufs inp hL' hI'' hV => by
      rw [(hc i w hiw).2 f'' env arrs ufs inp hL' hI'' hV]; rfl⟩⟩
  | Mul a b =>
    unfold kernel.term_kernel.flat_bv at h
    obtain ⟨hL, hI', hc⟩ := flat_bin_ok a b f 2#usize hI (flat_bv_ok a) (flat_bv_ok b) r f' h
