/- The derived operations as proven rules (issue #192, phase 5 / v0.28.0).

   This file is HAND-WRITTEN (Kernel.lean is generated by regen.sh and must
   not be edited). Until phase 5 the solver rewrote `bvnot`, `bvneg`,
   `bvrotl`, `bvsdiv` and `bvsrem` into the closed core before the term DAG
   was built (`lowering.rs`), so a certificate carried the rewrite and the
   rewrite itself was trusted. Each is now a `DagNode` whose rule in
   `blast_kernel.rs` is that rewrite spelled as a composition of the proven
   rules, and this file proves each composition against the Lean `BitVec`
   operation SMT-LIB names:

     blast_bvnot_bitvec   ~~~A                          (bvnot)
     blast_neg_bitvec     -A                            (bvneg)
     blast_rotl_bitvec    A.rotateLeft (B.toNat % w)    (bvrotl, every width)
     blast_sdiv_bitvec    A.smtSDiv B                   (bvsdiv: /0 and INT_MIN / -1 included)
     blast_srem_bitvec    A.srem B                      (bvsrem: sign of the dividend)

   plus a structural frame (`blast_X_frame`: width, prefix, gate bound,
   `AigWF` preservation, output range) for each, in exactly the shape
   BlasterDag.lean's `encode_node_spec` consumes.

   Proof architecture. A rule's standard capstone is "simulate-wrapped":
   `∀ inputs, AigWF … → simulate p.2 inputs ⦃ vals => Denotes … ⦄`. Composing
   several of those is tedious, so the compositions are proved in a PURE
   conditional form instead — `∀ inp, Denotes (pSim inp aig₀) a w A → … →
   Denotes (pSim inp aigₖ) out w C` — where each stage is one application of
   `bin_pure_of_sim` (harvest the stage's capstone at the pure level) and the
   operand facts are transported along the aig prefixes with `Denotes.up`.
   `sim_of_pure` turns the finished composition back into the standard
   simulate-wrapped statement. The harvesting infrastructure (`harvest`,
   `padTo`, `pSim_congr_inputs`, `spec_forall`) and the frame predicates
   (`WordFrame`, `PredFrame`) moved here from BlasterDag.lean, which now
   imports this file.

   The arithmetic facts are stated once, over `BitVec` alone:
   * `rotateRight_sub_eq_rotateLeft`: rotating right by `(w - r) % w` is
     rotating left by `r`; `rotateRight_neg_eq_rotateLeft`: at a
     power-of-two width `-B` is that amount (`2^w ≡ 0 (mod w)`), the identity
     that is FALSE at any other width (0.22.1), which is why the other branch
     reduces `b` mod `w` explicitly.
   * `sshiftRight_last`: `ashr(x, w - 1)` is the sign mask; `xor_sub_signMask`:
     `(s ^^^ x) - s` is `-x` under the all-ones mask and `x` under the zero
     mask; `sdiv_construction`: the whole sign-mask construction equals
     `smtSDiv` (four sign cases, `smtSDiv_eq`).
   * `srem_eq_sub_smtSDiv_mul`: `A.srem B = A - A.smtSDiv B * B` for all
     `B` including `0` (`umod_eq_sub_smtUDiv_mul`, BlasterDiv.lean, in each
     sign case).
   All `sorry`-free, axiom-clean (pinned in AxiomCheck.lean). -/
import BlasterFrame

open Aeneas Aeneas.Std Result

set_option maxHeartbeats 2000000

namespace kernel.blast_kernel.spec

/- ══════════════ HARVESTING SIMULATE-WRAPPED FACTS ══════════════ -/

/-- `pSim` only reads the inputs an `AigWF`-bounded aig names, so two
    input lists agreeing below `L` simulate identically. -/
theorem pSimAux_congr_inputs {inp inp' : List Bool} {L : Nat}
    (h : ∀ k, k < L → inp.getD k false = inp'.getD k false)
    (vals : List Bool) (ns : List Node)
    (hns : ∀ nd ∈ ns, ∀ k, nd = Node.Input k → k.val < L) :
    pSimAux inp vals ns = pSimAux inp' vals ns := by
  induction ns generalizing vals with
  | nil => rfl
  | cons nd ns ih =>
    simp only [pSimAux]
    have hnd : pNodeVal inp vals nd = pNodeVal inp' vals nd := by
      cases nd with
      | False => rfl
      | Input k =>
        simp only [pNodeVal]
        exact h k.val (hns _ (List.mem_cons_self) k rfl)
      | And x y => rfl
    rw [hnd]
    exact ih _ (fun nd' hnd' => hns nd' (List.mem_cons_of_mem _ hnd'))

theorem pSim_congr_inputs {inp inp' : List Bool} {L : Nat} {ns : List Node}
    (hwf : AigWF ns L)
    (h : ∀ k, k < L → inp.getD k false = inp'.getD k false) :
    pSim inp ns = pSim inp' ns := by
  unfold pSim
  apply pSimAux_congr_inputs h
  intro nd hnd k hk
  obtain ⟨i, hi, rfl⟩ := List.getElem_of_mem hnd
  have := hwf i hi
  rw [hk] at this
  exact this

/-- `inp` padded or truncated to exactly `L` entries, agreeing with `inp`
    on every index below `L`. -/
def padTo (inp : List Bool) (L : Nat) : List Bool :=
  (inp ++ List.replicate L false).take L

@[simp] theorem padTo_length (inp : List Bool) (L : Nat) : (padTo inp L).length = L := by
  simp only [padTo, List.length_take, List.length_append, List.length_replicate]
  omega

theorem padTo_getD (inp : List Bool) (L k : Nat) (hk : k < L) :
    (padTo inp L).getD k false = inp.getD k false := by
  unfold padTo
  rw [List.getD_eq_getElem?_getD, List.getElem?_take_of_lt hk, List.getD_eq_getElem?_getD]
  by_cases hin : k < inp.length
  · rw [List.getElem?_append_left hin]
  · rw [List.getElem?_append_right (by omega), List.getElem?_replicate]
    have hnone : inp[k]? = none := List.getElem?_eq_none (by omega)
    have hlt : k - inp.length < L := by omega
    rw [hnone]
    simp [hlt]

/-- Harvest a `simulate`-wrapped postcondition (the shape of every
    `blast_X_bitvec` capstone) at the pure level, for an ARBITRARY input
    list: the aig only names inputs below `L`, so `inp` padded to `L` is
    a valid `Slice` that simulates like `inp`. -/
theorem harvest {aig0 aig1 : Aig} {L : Nat}
    (hwf0 : AigWF aig0.nodes.val L) (hwf1 : AigWF aig1.nodes.val L)
    (hL : L ≤ Usize.max) {P : List Bool → Prop}
    (h : ∀ inputs : Slice Bool, AigWF aig0.nodes.val inputs.val.length →
      simulate aig1 inputs ⦃ vals => P vals.val ⦄)
    (inp : List Bool) : P (pSim inp aig1.nodes.val) := by
  let inputs : Slice Bool := ⟨padTo inp L, by simp [hL]⟩
  have hlen : inputs.val.length = L := by simp [inputs]
  obtain ⟨vals, hvals, hP⟩ := simulate_spec_pSim aig1 inputs (by rw [hlen]; exact hwf1)
    (h inputs (by rw [hlen]; exact hwf0))
  rw [hvals] at hP
  have hcongr : pSim inputs.val aig1.nodes.val = pSim inp aig1.nodes.val :=
    pSim_congr_inputs hwf1 (fun k hk => padTo_getD inp L k hk)
  rw [hcongr] at hP
  exact hP

/-- A universally quantified family of specs on one computation. -/
theorem spec_forall {α β : Type} [Nonempty β] {m : Result α} {P : β → α → Prop}
    (h : ∀ x, WP.spec m (P x)) : WP.spec m (fun r => ∀ x, P x r) := by
  cases m with
  | ok x =>
    simp only [WP.spec_ok] at h ⊢
    exact h
  | fail e => exact (WP.spec_fail _).mp (h (Classical.arbitrary β)) |>.elim
  | div => exact (WP.spec_div).mp (h (Classical.arbitrary β)) |>.elim

/- ══════════════ GLUING A RULE'S FRAME TO ITS SEMANTICS ══════════════ -/

/-- The structural post of a word rule: output width, prefix, gate budget,
    well-formedness preservation, output range. -/
def WordFrame (aig : Aig) (a : Slice Lit) (bound : Nat)
    (p : alloc.vec.Vec Lit × Aig) : Prop :=
  p.1.val.length = a.val.length ∧
  aig.nodes.val <+: p.2.nodes.val ∧
  p.2.nodes.val.length ≤ aig.nodes.val.length + bound ∧
  (∀ L, AigWF aig.nodes.val L → AigWF p.2.nodes.val L) ∧
  (∀ l ∈ p.1.val, l.node.val < p.2.nodes.val.length)

/-- The structural post of a predicate rule. -/
def PredFrame (aig : Aig) (bound : Nat) (p : Lit × Aig) : Prop :=
  aig.nodes.val <+: p.2.nodes.val ∧
  p.2.nodes.val.length ≤ aig.nodes.val.length + bound ∧
  (∀ L, AigWF aig.nodes.val L → AigWF p.2.nodes.val L) ∧
  p.1.node.val < p.2.nodes.val.length

/- ══════════════ PURE CONDITIONAL FORM OF A RULE ══════════════ -/

/-- A binary word rule, lifted from its simulate-wrapped capstone to the
    pure conditional form: for every input list, if the operands denote
    `A` and `B` under the aig BEFORE the rule, the output denotes `C` under
    the aig AFTER it. -/
theorem bin_pure_of_sim {aig : Aig} {a b : Slice Lit} {L bound : Nat}
    {rule : Result (alloc.vec.Vec Lit × Aig)} {w : Nat} {A B C : BitVec w}
    (hframe : rule ⦃ p => WordFrame aig a bound p ⦄)
    (hsem : rule ⦃ p => ∀ inputs : Slice Bool, AigWF aig.nodes.val inputs.val.length →
      simulate p.2 inputs ⦃ vals =>
        Denotes vals.val a.val w A → Denotes vals.val b.val w B →
        Denotes vals.val p.1.val w C ⦄ ⦄)
    (hwf : AigWF aig.nodes.val L) (hL : L ≤ Usize.max)
    (ha : ∀ l ∈ a.val, l.node.val < aig.nodes.val.length)
    (hb : ∀ l ∈ b.val, l.node.val < aig.nodes.val.length) :
    rule ⦃ p => WordFrame aig a bound p ∧
      ∀ inp, Denotes (pSim inp aig.nodes.val) a.val w A →
        Denotes (pSim inp aig.nodes.val) b.val w B →
        Denotes (pSim inp p.2.nodes.val) p.1.val w C ⦄ := by
  apply WP.spec_mono (spec_and hframe hsem)
  rintro ⟨out, aig1⟩ ⟨hfr, hs⟩
  refine ⟨hfr, fun inp hA hB => ?_⟩
  obtain ⟨_, hpre, _, hwfp, _⟩ := hfr
  have h := harvest (P := fun vals =>
      Denotes vals a.val w A → Denotes vals b.val w B → Denotes vals out.val w C)
    hwf (hwfp L hwf) hL hs inp
  exact h (Denotes.up hpre ha inp hA) (Denotes.up hpre hb inp hB)

/-- Back from the pure conditional form (established for every `L`) to the
    standard simulate-wrapped capstone shape. -/
theorem sim_of_pure {aig : Aig} {a b : Slice Lit} {bound : Nat}
    {rule : Result (alloc.vec.Vec Lit × Aig)} {w : Nat} {A B C : BitVec w}
    (hframe : rule ⦃ p => WordFrame aig a bound p ⦄)
    (hpure : ∀ L, AigWF aig.nodes.val L → L ≤ Usize.max →
      rule ⦃ p => ∀ inp, Denotes (pSim inp aig.nodes.val) a.val w A →
        Denotes (pSim inp aig.nodes.val) b.val w B →
        Denotes (pSim inp p.2.nodes.val) p.1.val w C ⦄)
    (ha : ∀ l ∈ a.val, l.node.val < aig.nodes.val.length)
    (hb : ∀ l ∈ b.val, l.node.val < aig.nodes.val.length) :
    rule ⦃ p => ∀ inputs : Slice Bool, AigWF aig.nodes.val inputs.val.length →
      simulate p.2 inputs ⦃ vals =>
        Denotes vals.val a.val w A → Denotes vals.val b.val w B →
        Denotes vals.val p.1.val w C ⦄ ⦄ := by
  have hall : rule ⦃ p => WordFrame aig a bound p ∧
      ∀ L, AigWF aig.nodes.val L → L ≤ Usize.max →
        ∀ inp, Denotes (pSim inp aig.nodes.val) a.val w A →
          Denotes (pSim inp aig.nodes.val) b.val w B →
          Denotes (pSim inp p.2.nodes.val) p.1.val w C ⦄ := by
    refine spec_and hframe (spec_forall (fun L => ?_))
    by_cases h : AigWF aig.nodes.val L ∧ L ≤ Usize.max
    · exact WP.spec_mono (hpure L h.1 h.2) (fun p hp _ _ => hp)
    · exact WP.spec_mono hframe (fun p _ hwf hL => absurd ⟨hwf, hL⟩ h)
  apply WP.spec_mono hall
  rintro ⟨out, aig1⟩ ⟨⟨_, hpre, _, hwfp, _⟩, hs⟩
  intro inputs hwf
  apply WP.spec_mono (simulate_spec aig1 inputs (hwfp _ hwf))
  intro vals hv hA hB
  rw [hv] at hA hB ⊢
  have hLmax : inputs.val.length ≤ Usize.max := by
    have := inputs.length_ineq
    omega
  exact hs inputs.val.length hwf hLmax inputs.val
    (hA.of_prefix hpre ha inputs.val) (hB.of_prefix hpre hb inputs.val)

/- ══════════════ CONSTANT WORDS ══════════════ -/

/-- A `word_const` word denotes `BitVec.ofNat w value` under any aig whose
    node 0 is FALSE (every literal is on node 0, its flag the bit). -/
theorem word_const_denotes {aig : Aig} (hne : 0 < aig.nodes.val.length)
    (h0 : aig.nodes.val[0]'hne = Node.False) {value : Nat} {out : List Lit} {w : Nat}
    (hl : out.length = w)
    (hbits : ∀ (j : Nat) (hj : j < out.length),
      out[j] = { node := 0#usize, neg := value.testBit j })
    (inp : List Bool) :
    Denotes (pSim inp aig.nodes.val) out w (BitVec.ofNat w value) := by
  refine ⟨hl, fun j hj => ?_⟩
  rw [hbits j hj, pEvalLit_node_zero hne h0, BitVec.getLsbD_ofNat,
    decide_eq_true (show j < w by omega), Bool.true_and]

/-- Every literal of a `word_const` word is in range of any non-empty aig. -/
theorem word_const_rng {aig : Aig} (hne : 0 < aig.nodes.val.length)
    {value : Nat} {out : List Lit}
    (hbits : ∀ (j : Nat) (hj : j < out.length),
      out[j] = { node := 0#usize, neg := value.testBit j }) :
    ∀ l ∈ out, l.node.val < aig.nodes.val.length := by
  intro l hl
  obtain ⟨j, hj, rfl⟩ := List.mem_iff_getElem.mp hl
  rw [hbits j hj]
  scalar_tac

/- ══════════════ THE COMPONENT FRAMES IN `WordFrame` SHAPE ══════════════ -/

theorem blast_sub_wframe (aig : Aig) (a b : Slice Lit)
    (hab : a.val.length ≤ b.val.length)
    (hcap : aig.nodes.val.length + 9 * a.val.length ≤ Usize.max)
    (ha : ∀ l ∈ a.val, l.node.val < aig.nodes.val.length)
    (hb : ∀ l ∈ b.val, l.node.val < aig.nodes.val.length)
    (hne : 0 < aig.nodes.val.length) :
    blast_sub aig a b ⦃ p => WordFrame aig a (9 * a.val.length) p ⦄ :=
  WP.spec_mono (blast_sub_frame aig a b hab hcap ha hb hne)
    (fun _ h => ⟨h.1, h.2.1, Nat.le_of_eq h.2.2.1, h.2.2.2.1, h.2.2.2.2⟩)

theorem blast_xor_wframe (aig : Aig) (a b : Slice Lit)
    (hab : a.val.length ≤ b.val.length)
    (hcap : aig.nodes.val.length + 3 * a.val.length ≤ Usize.max)
    (ha : ∀ l ∈ a.val, l.node.val < aig.nodes.val.length)
    (hb : ∀ l ∈ b.val, l.node.val < aig.nodes.val.length) :
    blast_xor aig a b ⦃ p => WordFrame aig a (3 * a.val.length) p ⦄ :=
  WP.spec_mono (blast_xor_spec aig a b hab hcap ha hb)
    (fun _ h => ⟨h.1, h.2.1, Nat.le_of_eq h.2.2.1, h.2.2.2.1, h.2.2.2.2.1⟩)

theorem blast_udiv_wframe (aig : Aig) (a b : Slice Lit)
    (hab : a.val.length ≤ b.val.length)
    (hcap : aig.nodes.val.length + (12 * a.val.length * a.val.length + 8 * a.val.length)
      ≤ Usize.max)
    (ha : ∀ l ∈ a.val, l.node.val < aig.nodes.val.length)
    (hb : ∀ l ∈ b.val, l.node.val < aig.nodes.val.length)
    (hne : 0 < aig.nodes.val.length)
    (h0 : aig.nodes.val[0]'hne = Node.False) :
    blast_udiv aig a b ⦃ p =>
      WordFrame aig a (12 * a.val.length * a.val.length + 8 * a.val.length) p ⦄ :=
  WP.spec_mono (blast_udiv_frame aig a b hab hcap ha hb hne h0)
    (fun _ h => ⟨h.1, h.2.1, Nat.le_of_eq h.2.2.1, h.2.2.2.1, h.2.2.2.2⟩)

theorem blast_mul_wframe (aig : Aig) (a b : Slice Lit)
    (hab : a.val.length ≤ b.val.length)
    (hcap : aig.nodes.val.length + 10 * a.val.length * a.val.length ≤ Usize.max)
    (ha : ∀ l ∈ a.val, l.node.val < aig.nodes.val.length)
    (hb : ∀ l ∈ b.val, l.node.val < aig.nodes.val.length)
    (hne : 0 < aig.nodes.val.length)
    (h0 : aig.nodes.val[0]'hne = Node.False) :
    blast_mul aig a b ⦃ p => WordFrame aig a (10 * a.val.length * a.val.length) p ⦄ :=
  WP.spec_mono (blast_mul_frame aig a b hab hcap ha hb hne h0)
    (fun _ h => ⟨h.1, h.2.1, h.2.2.1, h.2.2.2.1, h.2.2.2.2⟩)

theorem blast_urem_wframe (aig : Aig) (a b : Slice Lit)
    (hab : a.val.length ≤ b.val.length)
    (hcap : aig.nodes.val.length
      + (12 * a.val.length * a.val.length + 8 * a.val.length)
      + 10 * a.val.length * a.val.length
      + 9 * a.val.length
      ≤ Usize.max)
    (ha : ∀ l ∈ a.val, l.node.val < aig.nodes.val.length)
    (hb : ∀ l ∈ b.val, l.node.val < aig.nodes.val.length)
    (hne : 0 < aig.nodes.val.length)
    (h0 : aig.nodes.val[0]'hne = Node.False) :
    blast_urem aig a b ⦃ p =>
      WordFrame aig a ((12 * a.val.length * a.val.length + 8 * a.val.length)
        + 10 * a.val.length * a.val.length + 9 * a.val.length) p ⦄ :=
  WP.spec_mono (blast_urem_frame aig a b hab hcap ha hb hne h0)
    (fun _ h => ⟨h.1, h.2.1, by have := h.2.2.1; omega, h.2.2.2.1, h.2.2.2.2⟩)

theorem blast_rotr_wframe (aig : Aig) (a b : Slice Lit)
    (hw : 0 < a.val.length)
    (hab : b.val.length = a.val.length)
    (hcap : aig.nodes.val.length
      + (12 * a.val.length * a.val.length + 8 * a.val.length)
      + 10 * a.val.length * a.val.length
      + 9 * a.val.length
      + 3 * a.val.length * pStages a.val.length
      ≤ Usize.max)
    (ha : ∀ l ∈ a.val, l.node.val < aig.nodes.val.length)
    (hb : ∀ l ∈ b.val, l.node.val < aig.nodes.val.length)
    (hne : 0 < aig.nodes.val.length)
    (h0 : aig.nodes.val[0]'hne = Node.False) :
    blast_rotr aig a b ⦃ p =>
      WordFrame aig a ((12 * a.val.length * a.val.length + 8 * a.val.length)
        + 10 * a.val.length * a.val.length + 9 * a.val.length
        + 3 * a.val.length * pStages a.val.length) p ⦄ :=
  WP.spec_mono (blast_rotr_frame aig a b hw hab hcap ha hb hne h0)
    (fun _ h => ⟨h.1, h.2.1, by have := h.2.2.1; omega, h.2.2.2.1, h.2.2.2.2⟩)

theorem blast_ashr_wframe (aig : Aig) (a b : Slice Lit)
    (hw : 0 < a.val.length)
    (hab : a.val.length ≤ b.val.length)
    (hcap : aig.nodes.val.length
      + (3 * a.val.length * pStages a.val.length
        + (b.val.length - pStages a.val.length) + 3 * a.val.length)
      ≤ Usize.max)
    (ha : ∀ l ∈ a.val, l.node.val < aig.nodes.val.length)
    (hb : ∀ l ∈ b.val, l.node.val < aig.nodes.val.length)
    (hne : 0 < aig.nodes.val.length)
    (h0 : aig.nodes.val[0]'hne = Node.False) :
    blast_ashr aig a b ⦃ p =>
      WordFrame aig a (3 * a.val.length * pStages a.val.length
        + (b.val.length - pStages a.val.length) + 3 * a.val.length) p ⦄ :=
  WP.spec_mono (blast_ashr_frame aig a b hw hab hcap ha hb hne h0)
    (fun _ h => ⟨h.1, h.2.1, h.2.2.1, h.2.2.2.1, h.2.2.2.2⟩)

/- ══════════════ `bvnot` ══════════════ -/

/-- `blast_bvnot` is `word_not`: every literal complemented, no gates. -/
theorem blast_bvnot_spec (a : Slice Lit) :
    blast_bvnot a ⦃ out => out.val = a.val.map (fun l => { l with neg := !l.neg }) ⦄ := by
  unfold blast_bvnot
  exact word_not_spec a

/-- **`blast_bvnot` implements `bvnot` (`BitVec` `~~~`), for every width.**
    Gate-free, so the statement is about any value list at all. -/
theorem blast_bvnot_bitvec (a : Slice Lit) {w : Nat} (A : BitVec w) :
    blast_bvnot a ⦃ out =>
      ∀ vals : List Bool, Denotes vals a.val w A → Denotes vals out.val w (~~~A) ⦄ := by
  apply WP.spec_mono (blast_bvnot_spec a)
  intro out hout vals hA
  obtain ⟨hal, hAj⟩ := hA
  have hlen : out.val.length = w := by rw [hout, List.length_map, hal]
  refine ⟨hlen, fun j hj => ?_⟩
  have hja : j < a.val.length := by omega
  have hoj : out.val[j] = { node := (a.val[j]).node, neg := !(a.val[j]).neg } := by
    simp only [hout, List.getElem_map]
  rw [hoj, pEvalLit_not, hAj j hja, BitVec.getLsbD_not,
    decide_eq_true (show j < w by omega), Bool.true_and]

/-- The complemented word's literals live on the same nodes. -/
theorem blast_bvnot_rng (a : Slice Lit) {n : Nat}
    (ha : ∀ l ∈ a.val, l.node.val < n) :
    blast_bvnot a ⦃ out => ∀ l ∈ out.val, l.node.val < n ⦄ := by
  apply WP.spec_mono (blast_bvnot_spec a)
  intro out hout l hl
  rw [hout, List.mem_map] at hl
  obtain ⟨l', hl', rfl⟩ := hl
  exact ha l' hl'

/- ══════════════ `bvneg` ══════════════ -/

/-- Structural frame of `blast_neg`: `blast_sub`'s `9·w` gates. -/
theorem blast_neg_frame (aig : Aig) (a : Slice Lit)
    (hcap : aig.nodes.val.length + 9 * a.val.length ≤ Usize.max)
    (ha : ∀ l ∈ a.val, l.node.val < aig.nodes.val.length)
    (hne : 0 < aig.nodes.val.length) :
    blast_neg aig a ⦃ p => WordFrame aig a (9 * a.val.length) p ⦄ := by
  unfold blast_neg
  have hlen : (Slice.len a).val = a.val.length := by scalar_tac
  step with (word_const_spec 0#usize (Slice.len a)) as ⟨zero, hzl, hzbits⟩
  rw [hlen] at hzl
  have hderef : (alloc.vec.Vec.deref zero).val = zero.val := rfl
  have hzrng : ∀ l ∈ (alloc.vec.Vec.deref zero).val, l.node.val < aig.nodes.val.length := by
    rw [hderef]
    exact word_const_rng hne hzbits
  have hzlen : (alloc.vec.Vec.deref zero).val.length = a.val.length := by rw [hderef, hzl]
  apply WP.spec_mono (blast_sub_frame aig (alloc.vec.Vec.deref zero) a
    (by omega) (by omega) hzrng ha hne)
  rintro ⟨out, aig1⟩ ⟨h1, h2, h3, h4, h5⟩
  dsimp only at h1 h2 h3 h4 h5
  unfold WordFrame
  dsimp only
  exact ⟨by rw [h1, hzlen], h2, by omega, h4, h5⟩

/-- **`blast_neg` implements `bvneg` (`BitVec` negation), for every width**:
    `0 - A = -A` (`BitVec.zero_sub`). -/
theorem blast_neg_bitvec (aig : Aig) (a : Slice Lit)
    (hcap : aig.nodes.val.length + 9 * a.val.length ≤ Usize.max)
    (ha : ∀ l ∈ a.val, l.node.val < aig.nodes.val.length)
    (hne : 0 < aig.nodes.val.length)
    (h0 : aig.nodes.val[0]'hne = Node.False)
    {w : Nat} (A : BitVec w) :
    blast_neg aig a ⦃ p =>
      ∀ (inputs : Slice Bool), AigWF aig.nodes.val inputs.val.length →
        simulate p.2 inputs ⦃ vals =>
          Denotes vals.val a.val w A → Denotes vals.val p.1.val w (-A) ⦄ ⦄ := by
  unfold blast_neg
  have hlen : (Slice.len a).val = a.val.length := by scalar_tac
  step with (word_const_spec 0#usize (Slice.len a)) as ⟨zero, hzl, hzbits⟩
  rw [hlen] at hzl
  have hderef : (alloc.vec.Vec.deref zero).val = zero.val := rfl
  have hzrng : ∀ l ∈ (alloc.vec.Vec.deref zero).val, l.node.val < aig.nodes.val.length := by
    rw [hderef]
    exact word_const_rng hne hzbits
  have hzlen : (alloc.vec.Vec.deref zero).val.length = a.val.length := by rw [hderef, hzl]
  apply WP.spec_mono (spec_and
    (blast_sub_frame aig (alloc.vec.Vec.deref zero) a (by omega) (by omega) hzrng ha hne)
    (blast_sub_bitvec aig (alloc.vec.Vec.deref zero) a (by omega) (by omega) hzrng ha hne h0
      (0#w) A))
  rintro ⟨out, aig1⟩ ⟨⟨_, hpre, _, hwf1, _⟩, hsim⟩
  dsimp only at hpre hwf1 hsim
  intro inputs hwf
  apply WP.spec_mono (spec_and (simulate_spec aig1 inputs (hwf1 _ hwf)) (hsim inputs hwf))
  rintro vals ⟨hv, himp⟩ hA
  rw [hv] at himp hA ⊢
  have hne1 : 0 < aig1.nodes.val.length := by
    have := hpre.length_le
    omega
  have h01 : aig1.nodes.val[0]'hne1 = Node.False := node0_of_prefix hpre hne h0 hne1
  have hal : a.val.length = w := hA.1
  have hZ : Denotes (pSim inputs.val aig1.nodes.val) (alloc.vec.Vec.deref zero).val w
      (BitVec.ofNat w (0#usize).val) :=
    word_const_denotes hne1 h01 (by rw [hzlen, hal]) (by rw [hderef]; exact hzbits) inputs.val
  have hz0 : BitVec.ofNat w (0#usize).val = 0#w := rfl
  rw [hz0] at hZ
  have := himp hZ hA
  rwa [BitVec.zero_sub] at this

/- ══════════════ `bvrotl`: THE ROTATION ARITHMETIC ══════════════ -/

/-- Rotating right by `(w - r) % w` is rotating left by `r`, for `r < w`. -/
theorem rotateRight_sub_eq_rotateLeft {w : Nat} (A : BitVec w) {r : Nat} (hr : r < w) :
    A.rotateRight ((w - r) % w) = A.rotateLeft r := by
  apply BitVec.eq_of_getLsbD_eq_iff.mpr
  intro i hi
  rw [BitVec.getLsbD_rotateRight, BitVec.getLsbD_rotateLeft, Nat.mod_mod, Nat.mod_eq_of_lt hr]
  rcases Nat.eq_zero_or_pos r with hr0 | hrpos
  · subst hr0
    simp [Nat.mod_self, hi]
  · rw [Nat.mod_eq_of_lt (show w - r < w by omega)]
    have h1 : w - (w - r) = r := by omega
    rw [h1]

/-- `(m·w - t) % w = (w - t % w) % w` for `t ≤ m·w`: subtracting from a
    multiple of `w` negates the residue. -/
theorem sub_mod_mul {m w t : Nat} (hw : 0 < w) (ht : t ≤ m * w) :
    (m * w - t) % w = (w - t % w) % w := by
  have hx : (m * w - t) + t = m * w := Nat.sub_add_cancel ht
  have hmod : ((m * w - t) % w + t % w) % w = 0 := by
    rw [← Nat.add_mod, hx]
    simp
  have ha := Nat.mod_lt (m * w - t) hw
  have hb := Nat.mod_lt t hw
  generalize hxx : (m * w - t) % w = x at hmod ha ⊢
  generalize hyy : t % w = y at hmod hb ⊢
  rcases Nat.lt_or_ge (x + y) w with hlt | hge
  · rw [Nat.mod_eq_of_lt hlt] at hmod
    have hx0 : x = 0 := by omega
    have hy0 : y = 0 := by omega
    subst hx0 hy0
    simp [Nat.mod_self]
  · have hlt2 : x + y - w < w := by omega
    have hsum : (x + y) % w = x + y - w := by
      rw [Nat.mod_eq_sub_mod hge, Nat.mod_eq_of_lt hlt2]
    rw [hsum] at hmod
    have hxw : x = w - y := by omega
    rw [hxw, Nat.mod_eq_of_lt (by omega)]

/-- At a power-of-two width, rotating right by `-B` (mod `w`) is rotating
    left by `B` (mod `w`): `2^w` is a multiple of `w = 2^s`, so
    `(2^w - B) % w = (w - B % w) % w`. -/
theorem rotateRight_neg_eq_rotateLeft {w : Nat} (A B : BitVec w) {s : Nat} (hw : w = 2 ^ s) :
    A.rotateRight ((-B).toNat % w) = A.rotateLeft (B.toNat % w) := by
  have hwpos : 0 < w := by rw [hw]; exact Nat.two_pow_pos s
  have hsw : s ≤ w := by
    rw [hw]
    exact Nat.le_of_lt Nat.lt_two_pow_self
  have hm : 2 ^ (w - s) * w = 2 ^ w := by
    have h1 := Nat.pow_sub_mul_pow 2 hsw
    rw [← hw] at h1
    exact h1
  have hr : B.toNat % w < w := Nat.mod_lt _ hwpos
  rw [BitVec.toNat_neg]
  have hB := B.isLt
  rcases Nat.eq_zero_or_pos B.toNat with hz | hpos
  · simp only [hz, Nat.sub_zero, Nat.mod_self, Nat.zero_mod]
    have h := rotateRight_sub_eq_rotateLeft A (r := 0) hwpos
    rw [Nat.sub_zero, Nat.mod_self] at h
    exact h
  · rw [Nat.mod_eq_of_lt (show 2 ^ w - B.toNat < 2 ^ w by omega), ← hm,
      sub_mod_mul hwpos (by rw [hm]; exact Nat.le_of_lt hB)]
    exact rotateRight_sub_eq_rotateLeft A hr

/- ══════════════ `bvrotl`: FRAME ══════════════ -/

/-- `bvurem`'s gate bound (`blast_urem_frame`). -/
def uremBound (w : Nat) : Nat := (12 * w * w + 8 * w) + 10 * w * w + 9 * w

/-- `bvrotr`'s gate bound (`blast_rotr_frame`). -/
def rotrBound (w : Nat) : Nat := uremBound w + 3 * w * pStages w

/-- `bvrotl`'s gate bound: two remainders and a subtraction for the amount
    (the power-of-two branch only subtracts), then the rotate. -/
def rotlBound (w : Nat) : Nat := 2 * uremBound w + 9 * w + rotrBound w

theorem rotlBound_eq (w : Nat) :
    rotlBound w = 2 * ((12 * w * w + 8 * w) + 10 * w * w + 9 * w) + 9 * w
      + ((12 * w * w + 8 * w) + 10 * w * w + 9 * w + 3 * w * pStages w) := by
  simp only [rotlBound, rotrBound, uremBound]

/-- Structural frame of `blast_rotl`. -/
theorem blast_rotl_frame (aig : Aig) (a b : Slice Lit)
    (hw : 0 < a.val.length)
    (hab : b.val.length = a.val.length)
    (hcap : aig.nodes.val.length + rotlBound a.val.length ≤ Usize.max)
    (ha : ∀ l ∈ a.val, l.node.val < aig.nodes.val.length)
    (hb : ∀ l ∈ b.val, l.node.val < aig.nodes.val.length)
    (hne : 0 < aig.nodes.val.length)
    (h0 : aig.nodes.val[0]'hne = Node.False) :
    blast_rotl aig a b ⦃ p => WordFrame aig a (rotlBound a.val.length) p ⦄ := by
  rw [rotlBound_eq] at hcap ⊢
  unfold blast_rotl
  have hlen : (Slice.len a).val = a.val.length := by scalar_tac
  step with (stage_count_spec (Slice.len a) (by scalar_tac)) as
    ⟨stages, pow2, hst1, hst2, hst3, hst4⟩
  rw [hlen] at hst1 hst2 hst3 hst4
  split
  · -- power-of-two width: amount = 0 - b
    step with (word_const_spec 0#usize (Slice.len a)) as ⟨zero, hzl, hzbits⟩
    rw [hlen] at hzl
    have hderefz : (alloc.vec.Vec.deref zero).val = zero.val := rfl
    have hzrng : ∀ l ∈ (alloc.vec.Vec.deref zero).val, l.node.val < aig.nodes.val.length := by
      rw [hderefz]
      exact word_const_rng hne hzbits
    have hzlen : (alloc.vec.Vec.deref zero).val.length = a.val.length := by rw [hderefz, hzl]
    step with (blast_sub_frame aig (alloc.vec.Vec.deref zero) b (by omega) (by omega) hzrng hb hne)
      as ⟨p1, hal, hpre1, hlen1, hwf1, harng⟩
    obtain ⟨amount, aig1⟩ := p1
    dsimp only at hal hpre1 hlen1 hwf1 harng
    try simp only [bind_tc_ok]
    have hderefa : (alloc.vec.Vec.deref amount).val = amount.val := rfl
    have halen : (alloc.vec.Vec.deref amount).val.length = a.val.length := by
      rw [hderefa, hal, hzlen]
    have harng' : ∀ l ∈ (alloc.vec.Vec.deref amount).val, l.node.val < aig1.nodes.val.length := by
      rw [hderefa]
      exact harng
    have hne1 : 0 < aig1.nodes.val.length := by
      have := hpre1.length_le
      omega
    have h01 : aig1.nodes.val[0]'hne1 = Node.False := node0_of_prefix hpre1 hne h0 hne1
    have ha1 : ∀ l ∈ a.val, l.node.val < aig1.nodes.val.length := by
      intro l hl
      have := ha l hl
      have := hpre1.length_le
      omega
    rw [hzlen] at hlen1
    apply WP.spec_mono (blast_rotr_frame aig1 a (alloc.vec.Vec.deref amount) hw halen
      (by omega) ha1 harng' hne1 h01)
    rintro ⟨out, aig2⟩ ⟨h1, h2, h3, h4, h5⟩
    dsimp only at h1 h2 h3 h4 h5
    unfold WordFrame
    dsimp only
    exact ⟨h1, hpre1.trans h2, by omega, fun L hL => h4 L (hwf1 L hL), h5⟩
  · -- any other width: amount = (w - b urem w) urem w
    step with (word_const_spec (Slice.len a) (Slice.len a)) as ⟨modulus, hml, hmbits⟩
    rw [hlen] at hml
    have hderefm : (alloc.vec.Vec.deref modulus).val = modulus.val := rfl
    have hmrng : ∀ l ∈ (alloc.vec.Vec.deref modulus).val, l.node.val < aig.nodes.val.length := by
      rw [hderefm]
      exact word_const_rng hne hmbits
    have hmlen : (alloc.vec.Vec.deref modulus).val.length = a.val.length := by rw [hderefm, hml]
    step with (blast_urem_frame aig b (alloc.vec.Vec.deref modulus)
      (by omega) (by rw [hab]; omega) hb hmrng hne h0) as
      ⟨p1, hrl, hpre1, hlen1, hwf1, hrrng⟩
    obtain ⟨reduced, aig1⟩ := p1
    dsimp only at hrl hpre1 hlen1 hwf1 hrrng
    rw [hab] at hrl hlen1
    have hderefr : (alloc.vec.Vec.deref reduced).val = reduced.val := rfl
    have hrlen : (alloc.vec.Vec.deref reduced).val.length = a.val.length := by rw [hderefr, hrl]
    have hrrng' : ∀ l ∈ (alloc.vec.Vec.deref reduced).val, l.node.val < aig1.nodes.val.length := by
      rw [hderefr]
      exact hrrng
    have hne1 : 0 < aig1.nodes.val.length := by
      have := hpre1.length_le
      omega
    have h01 : aig1.nodes.val[0]'hne1 = Node.False := node0_of_prefix hpre1 hne h0 hne1
    have hmrng1 : ∀ l ∈ (alloc.vec.Vec.deref modulus).val, l.node.val < aig1.nodes.val.length := by
      intro l hl
      have := hmrng l hl
      have := hpre1.length_le
      omega
    step with (blast_sub_frame aig1 (alloc.vec.Vec.deref modulus) (alloc.vec.Vec.deref reduced)
      (by omega) (by omega) hmrng1 hrrng' hne1) as
      ⟨p2, hdl, hpre2, hlen2, hwf2, hdrng⟩
    obtain ⟨diff, aig2⟩ := p2
    dsimp only at hdl hpre2 hlen2 hwf2 hdrng
    rw [hmlen] at hdl hlen2
    have hderefd : (alloc.vec.Vec.deref diff).val = diff.val := rfl
    have hdlen : (alloc.vec.Vec.deref diff).val.length = a.val.length := by rw [hderefd, hdl]
    have hdrng' : ∀ l ∈ (alloc.vec.Vec.deref diff).val, l.node.val < aig2.nodes.val.length := by
      rw [hderefd]
      exact hdrng
    have hne2 : 0 < aig2.nodes.val.length := by
      have := hpre2.length_le
      omega
    have h02 : aig2.nodes.val[0]'hne2 = Node.False := node0_of_prefix hpre2 hne1 h01 hne2
    have hmrng2 : ∀ l ∈ (alloc.vec.Vec.deref modulus).val, l.node.val < aig2.nodes.val.length := by
      intro l hl
      have := hmrng1 l hl
      have := hpre2.length_le
      omega
    step with (blast_urem_frame aig2 (alloc.vec.Vec.deref diff) (alloc.vec.Vec.deref modulus)
      (by omega) (by rw [hdlen]; omega) hdrng' hmrng2 hne2 h02) as
      ⟨p3, hal, hpre3, hlen3, hwf3, harng⟩
    obtain ⟨amount, aig3⟩ := p3
    dsimp only at hal hpre3 hlen3 hwf3 harng
    try simp only [bind_tc_ok]
    rw [hdlen] at hal hlen3
    have hderefa : (alloc.vec.Vec.deref amount).val = amount.val := rfl
    have halen : (alloc.vec.Vec.deref amount).val.length = a.val.length := by rw [hderefa, hal]
    have harng' : ∀ l ∈ (alloc.vec.Vec.deref amount).val, l.node.val < aig3.nodes.val.length := by
      rw [hderefa]
      exact harng
    have hne3 : 0 < aig3.nodes.val.length := by
      have := hpre3.length_le
      omega
    have h03 : aig3.nodes.val[0]'hne3 = Node.False := node0_of_prefix hpre3 hne2 h02 hne3
    have ha3 : ∀ l ∈ a.val, l.node.val < aig3.nodes.val.length := by
      intro l hl
      have := ha l hl
      have := hpre1.length_le
      have := hpre2.length_le
      have := hpre3.length_le
      omega
    apply WP.spec_mono (blast_rotr_frame aig3 a (alloc.vec.Vec.deref amount) hw halen
      (by omega) ha3 harng' hne3 h03)
    rintro ⟨out, aig4⟩ ⟨h1, h2, h3, h4, h5⟩
    dsimp only at h1 h2 h3 h4 h5
    unfold WordFrame
    dsimp only
    exact ⟨h1, hpre1.trans (hpre2.trans (hpre3.trans h2)), by omega,
      fun L hL => h4 L (hwf3 L (hwf2 L (hwf1 L hL))), h5⟩

/- ══════════════ `bvrotl`: SEMANTICS ══════════════ -/

/-- The pure conditional form of `blast_rotl`. -/
theorem blast_rotl_pure (aig : Aig) (a b : Slice Lit) (L : Nat)
    (hw : 0 < a.val.length)
    (hab : b.val.length = a.val.length)
    (hcap : aig.nodes.val.length + rotlBound a.val.length ≤ Usize.max)
    (ha : ∀ l ∈ a.val, l.node.val < aig.nodes.val.length)
    (hb : ∀ l ∈ b.val, l.node.val < aig.nodes.val.length)
    (hne : 0 < aig.nodes.val.length)
    (h0 : aig.nodes.val[0]'hne = Node.False)
    (hwf : AigWF aig.nodes.val L) (hL : L ≤ Usize.max)
    {w : Nat} (A B : BitVec w) :
    blast_rotl aig a b ⦃ p =>
      ∀ inp, Denotes (pSim inp aig.nodes.val) a.val w A →
        Denotes (pSim inp aig.nodes.val) b.val w B →
        Denotes (pSim inp p.2.nodes.val) p.1.val w (A.rotateLeft (B.toNat % w)) ⦄ := by
  rw [rotlBound_eq] at hcap
  unfold blast_rotl
  have hlen : (Slice.len a).val = a.val.length := by scalar_tac
  step with (stage_count_spec (Slice.len a) (by scalar_tac)) as
    ⟨stages, pow2, hst1, hst2, hst3, hst4⟩
  rw [hlen] at hst1 hst2 hst3 hst4
  split
  · -- power-of-two width: amount = 0 - b denotes -B
    rename_i hp
    have hpow : a.val.length = 2 ^ stages.val := by
      rw [hp] at hst4
      exact of_decide_eq_true hst4.symm
    step with (word_const_spec 0#usize (Slice.len a)) as ⟨zero, hzl, hzbits⟩
    rw [hlen] at hzl
    have hderefz : (alloc.vec.Vec.deref zero).val = zero.val := rfl
    have hzrng : ∀ l ∈ (alloc.vec.Vec.deref zero).val, l.node.val < aig.nodes.val.length := by
      rw [hderefz]
      exact word_const_rng hne hzbits
    have hzlen : (alloc.vec.Vec.deref zero).val.length = a.val.length := by rw [hderefz, hzl]
    step with (bin_pure_of_sim
      (blast_sub_wframe aig (alloc.vec.Vec.deref zero) b (by omega) (by omega) hzrng hb hne)
      (blast_sub_bitvec aig (alloc.vec.Vec.deref zero) b (by omega) (by omega) hzrng hb hne h0
        (BitVec.ofNat w (0#usize).val) B) hwf hL hzrng hb) as ⟨p1, hfr1, hs1⟩
    obtain ⟨amount, aig1⟩ := p1
    obtain ⟨hal, hpre1, hlen1, hwf1, harng⟩ := hfr1
    dsimp only at hal hpre1 hlen1 hwf1 harng hs1
    try simp only [bind_tc_ok]
    have hderefa : (alloc.vec.Vec.deref amount).val = amount.val := rfl
    have halen : (alloc.vec.Vec.deref amount).val.length = a.val.length := by
      rw [hderefa, hal, hzlen]
    have harng' : ∀ l ∈ (alloc.vec.Vec.deref amount).val, l.node.val < aig1.nodes.val.length := by
      rw [hderefa]
      exact harng
    have hne1 : 0 < aig1.nodes.val.length := by
      have := hpre1.length_le
      omega
    have h01 : aig1.nodes.val[0]'hne1 = Node.False := node0_of_prefix hpre1 hne h0 hne1
    have ha1 : ∀ l ∈ a.val, l.node.val < aig1.nodes.val.length := by
      intro l hl
      have := ha l hl
      have := hpre1.length_le
      omega
    rw [hzlen] at hlen1
    apply WP.spec_mono (bin_pure_of_sim
      (blast_rotr_wframe aig1 a (alloc.vec.Vec.deref amount) hw halen (by omega) ha1 harng' hne1 h01)
      (blast_rotr_bitvec aig1 a (alloc.vec.Vec.deref amount) hw halen (by omega) ha1 harng' hne1 h01
        A (-B)) (hwf1 L hwf) hL ha1 harng')
    rintro ⟨out, aig2⟩ ⟨_, hs2⟩
    intro inp hA hB
    have hal' : a.val.length = w := hA.1
    have hZ : Denotes (pSim inp aig.nodes.val) (alloc.vec.Vec.deref zero).val w
        (BitVec.ofNat w (0#usize).val) :=
      word_const_denotes hne h0 (by rw [hzlen, hal']) (by rw [hderefz]; exact hzbits) inp
    have hAm := hs1 inp hZ hB
    rw [BitVec.zero_sub] at hAm
    have hres := hs2 inp (hA.up hpre1 ha inp) hAm
    rw [rotateRight_neg_eq_rotateLeft A B (s := stages.val) (by rw [← hal']; exact hpow)] at hres
    exact hres
  · -- any other width: amount = (w - b urem w) urem w denotes (w - B % w) % w
    rename_i hp
    step with (word_const_spec (Slice.len a) (Slice.len a)) as ⟨modulus, hml, hmbits⟩
    rw [hlen] at hml hmbits
    have hderefm : (alloc.vec.Vec.deref modulus).val = modulus.val := rfl
    have hmrng : ∀ l ∈ (alloc.vec.Vec.deref modulus).val, l.node.val < aig.nodes.val.length := by
      rw [hderefm]
      exact word_const_rng hne hmbits
    have hmlen : (alloc.vec.Vec.deref modulus).val.length = a.val.length := by rw [hderefm, hml]
    -- stage 1: reduced = b urem modulus
    step with (bin_pure_of_sim
      (blast_urem_wframe aig b (alloc.vec.Vec.deref modulus) (by omega) (by rw [hab]; omega)
        hb hmrng hne h0)
      (blast_urem_bitvec aig b (alloc.vec.Vec.deref modulus) (by omega) (by rw [hab]; omega)
        hb hmrng hne h0 B (BitVec.ofNat w a.val.length)) hwf hL hb hmrng) as
      ⟨p1, hfr1, hs1⟩
    obtain ⟨reduced, aig1⟩ := p1
    obtain ⟨hrl, hpre1, hlen1, hwf1, hrrng⟩ := hfr1
    dsimp only at hrl hpre1 hlen1 hwf1 hrrng hs1
    rw [hab] at hrl hlen1
    have hderefr : (alloc.vec.Vec.deref reduced).val = reduced.val := rfl
    have hrlen : (alloc.vec.Vec.deref reduced).val.length = a.val.length := by rw [hderefr, hrl]
    have hrrng' : ∀ l ∈ (alloc.vec.Vec.deref reduced).val, l.node.val < aig1.nodes.val.length := by
      rw [hderefr]
      exact hrrng
    have hne1 : 0 < aig1.nodes.val.length := by
      have := hpre1.length_le
      omega
    have h01 : aig1.nodes.val[0]'hne1 = Node.False := node0_of_prefix hpre1 hne h0 hne1
    have hmrng1 : ∀ l ∈ (alloc.vec.Vec.deref modulus).val, l.node.val < aig1.nodes.val.length := by
      intro l hl
      have := hmrng l hl
      have := hpre1.length_le
      omega
    -- stage 2: diff = modulus - reduced
    step with (bin_pure_of_sim
      (blast_sub_wframe aig1 (alloc.vec.Vec.deref modulus) (alloc.vec.Vec.deref reduced)
        (by omega) (by omega) hmrng1 hrrng' hne1)
      (blast_sub_bitvec aig1 (alloc.vec.Vec.deref modulus) (alloc.vec.Vec.deref reduced)
        (by omega) (by omega) hmrng1 hrrng' hne1 h01
        (BitVec.ofNat w a.val.length) (B % BitVec.ofNat w a.val.length))
      (hwf1 L hwf) hL hmrng1 hrrng') as ⟨p2, hfr2, hs2⟩
    obtain ⟨diff, aig2⟩ := p2
    obtain ⟨hdl, hpre2, hlen2, hwf2, hdrng⟩ := hfr2
    dsimp only at hdl hpre2 hlen2 hwf2 hdrng hs2
    rw [hmlen] at hdl hlen2
    have hderefd : (alloc.vec.Vec.deref diff).val = diff.val := rfl
    have hdlen : (alloc.vec.Vec.deref diff).val.length = a.val.length := by rw [hderefd, hdl]
    have hdrng' : ∀ l ∈ (alloc.vec.Vec.deref diff).val, l.node.val < aig2.nodes.val.length := by
      rw [hderefd]
      exact hdrng
    have hne2 : 0 < aig2.nodes.val.length := by
      have := hpre2.length_le
      omega
    have h02 : aig2.nodes.val[0]'hne2 = Node.False := node0_of_prefix hpre2 hne1 h01 hne2
    have hmrng2 : ∀ l ∈ (alloc.vec.Vec.deref modulus).val, l.node.val < aig2.nodes.val.length := by
      intro l hl
      have := hmrng1 l hl
      have := hpre2.length_le
      omega
    -- stage 3: amount = diff urem modulus
    step with (bin_pure_of_sim
      (blast_urem_wframe aig2 (alloc.vec.Vec.deref diff) (alloc.vec.Vec.deref modulus)
        (by omega) (by rw [hdlen]; omega) hdrng' hmrng2 hne2 h02)
      (blast_urem_bitvec aig2 (alloc.vec.Vec.deref diff) (alloc.vec.Vec.deref modulus)
        (by omega) (by rw [hdlen]; omega) hdrng' hmrng2 hne2 h02
        (BitVec.ofNat w a.val.length - B % BitVec.ofNat w a.val.length)
        (BitVec.ofNat w a.val.length))
      (hwf2 L (hwf1 L hwf)) hL hdrng' hmrng2) as ⟨p3, hfr3, hs3⟩
    obtain ⟨amount, aig3⟩ := p3
    obtain ⟨hal, hpre3, hlen3, hwf3, harng⟩ := hfr3
    dsimp only at hal hpre3 hlen3 hwf3 harng hs3
    try simp only [bind_tc_ok]
    rw [hdlen] at hal hlen3
    have hderefa : (alloc.vec.Vec.deref amount).val = amount.val := rfl
    have halen : (alloc.vec.Vec.deref amount).val.length = a.val.length := by rw [hderefa, hal]
    have harng' : ∀ l ∈ (alloc.vec.Vec.deref amount).val, l.node.val < aig3.nodes.val.length := by
      rw [hderefa]
      exact harng
    have hne3 : 0 < aig3.nodes.val.length := by
      have := hpre3.length_le
      omega
    have h03 : aig3.nodes.val[0]'hne3 = Node.False := node0_of_prefix hpre3 hne2 h02 hne3
    have ha3 : ∀ l ∈ a.val, l.node.val < aig3.nodes.val.length := by
      intro l hl
      have := ha l hl
      have := hpre1.length_le
      have := hpre2.length_le
      have := hpre3.length_le
      omega
    -- stage 4: the rotate
    apply WP.spec_mono (bin_pure_of_sim
      (blast_rotr_wframe aig3 a (alloc.vec.Vec.deref amount) hw halen (by omega) ha3 harng' hne3 h03)
      (blast_rotr_bitvec aig3 a (alloc.vec.Vec.deref amount) hw halen (by omega) ha3 harng' hne3 h03
        A ((BitVec.ofNat w a.val.length - B % BitVec.ofNat w a.val.length)
          % BitVec.ofNat w a.val.length))
      (hwf3 L (hwf2 L (hwf1 L hwf))) hL ha3 harng')
    rintro ⟨out, aig4⟩ ⟨_, hs4⟩
    intro inp hA hB
    have hal' : a.val.length = w := hA.1
    have hW : Denotes (pSim inp aig.nodes.val) (alloc.vec.Vec.deref modulus).val w
        (BitVec.ofNat w a.val.length) :=
      word_const_denotes hne h0 (by rw [hmlen, hal']) (by rw [hderefm]; exact hmbits) inp
    have hR := hs1 inp hB hW
    have hD := hs2 inp (hW.up hpre1 hmrng inp) hR
    have hAm := hs3 inp hD (hW.up (hpre1.trans hpre2) hmrng inp)
    have hres := hs4 inp (hA.up (hpre1.trans (hpre2.trans hpre3)) ha inp) hAm
    -- the amount's value is (w - B.toNat % w) % w
    have hwpos : 0 < w := by omega
    have hwlt : a.val.length < 2 ^ w := by rw [hal']; exact Nat.lt_two_pow_self
    have hWn : (BitVec.ofNat w a.val.length).toNat = w := by
      rw [BitVec.toNat_ofNat, Nat.mod_eq_of_lt hwlt, hal']
    have hRn : (B % BitVec.ofNat w a.val.length).toNat = B.toNat % w := by
      rw [BitVec.toNat_umod, hWn]
    have hRle : B % BitVec.ofNat w a.val.length ≤ BitVec.ofNat w a.val.length := by
      rw [BitVec.le_def, hRn, hWn]
      exact Nat.le_of_lt (Nat.mod_lt _ hwpos)
    have hDn : (BitVec.ofNat w a.val.length - B % BitVec.ofNat w a.val.length).toNat
        = w - B.toNat % w := by
      rw [BitVec.toNat_sub_of_le hRle, hWn, hRn]
    have hAmn : ((BitVec.ofNat w a.val.length - B % BitVec.ofNat w a.val.length)
        % BitVec.ofNat w a.val.length).toNat % w = (w - B.toNat % w) % w := by
      rw [BitVec.toNat_umod, hDn, hWn, Nat.mod_mod]
    rw [hAmn, rotateRight_sub_eq_rotateLeft A (Nat.mod_lt _ hwpos)] at hres
    exact hres

/-- **`blast_rotl` implements `bvrotl` (`BitVec.rotateLeft` by the amount
    mod the width), for EVERY width `w ≥ 1`.** -/
theorem blast_rotl_bitvec (aig : Aig) (a b : Slice Lit)
    (hw : 0 < a.val.length)
    (hab : b.val.length = a.val.length)
    (hcap : aig.nodes.val.length + rotlBound a.val.length ≤ Usize.max)
    (ha : ∀ l ∈ a.val, l.node.val < aig.nodes.val.length)
    (hb : ∀ l ∈ b.val, l.node.val < aig.nodes.val.length)
    (hne : 0 < aig.nodes.val.length)
    (h0 : aig.nodes.val[0]'hne = Node.False)
    {w : Nat} (A B : BitVec w) :
    blast_rotl aig a b ⦃ p =>
      ∀ (inputs : Slice Bool), AigWF aig.nodes.val inputs.val.length →
        simulate p.2 inputs ⦃ vals =>
          Denotes vals.val a.val w A → Denotes vals.val b.val w B →
          Denotes vals.val p.1.val w (A.rotateLeft (B.toNat % w)) ⦄ ⦄ :=
  sim_of_pure (blast_rotl_frame aig a b hw hab hcap ha hb hne h0)
    (fun L hwf hL => blast_rotl_pure aig a b L hw hab hcap ha hb hne h0 hwf hL A B) ha hb


/- ══════════════ `bvsdiv`: THE SIGN-MASK ARITHMETIC ══════════════ -/

/-- `ashr(x, w - 1)` is the sign mask: all-ones when the sign bit is set,
    zero otherwise. -/
theorem sshiftRight_last {w : Nat} (hw : 0 < w) (A : BitVec w) :
    A.sshiftRight (w - 1) = if A.msb then BitVec.allOnes w else 0#w := by
  apply BitVec.eq_of_getLsbD_eq_iff.mpr
  intro i hi
  rw [BitVec.getLsbD_sshiftRight, decide_eq_false (show ¬ (w ≤ i) by omega),
    Bool.not_false, Bool.true_and]
  by_cases h : w - 1 + i < w
  · have hi0 : i = 0 := by omega
    subst hi0
    rw [if_pos h, Nat.add_zero, ← BitVec.msb_eq_getLsbD_last]
    cases hm : A.msb <;> simp [hw]
  · rw [if_neg h]
    cases hm : A.msb <;> simp [hi]

/-- `(s ^^^ x) - s` is `-x` under the all-ones mask and `x` under the zero
    mask: the two's-complement magnitude construction. -/
theorem xor_sub_signMask {w : Nat} (b : Bool) (X : BitVec w) :
    ((if b then BitVec.allOnes w else 0#w) ^^^ X) - (if b then BitVec.allOnes w else 0#w)
      = if b then -X else X := by
  cases b
  · simp
  · simp only [↓reduceIte, BitVec.allOnes_xor]
    rw [← BitVec.neg_one_eq_allOnes, BitVec.sub_neg, ← BitVec.neg_eq_not_add]

/-- The same with the operands of the XOR swapped. -/
theorem xor_sub_signMask' {w : Nat} (b : Bool) (X : BitVec w) :
    (X ^^^ (if b then BitVec.allOnes w else 0#w)) - (if b then BitVec.allOnes w else 0#w)
      = if b then -X else X := by
  rw [BitVec.xor_comm]
  exact xor_sub_signMask b X

/-- The XOR of two sign masks is the mask of "the signs differ". -/
theorem xor_signMask {w : Nat} (p q : Bool) :
    (if p then BitVec.allOnes w else 0#w) ^^^ (if q then BitVec.allOnes w else 0#w)
      = if (p != q) then BitVec.allOnes w else 0#w := by
  cases p <;> cases q <;> simp

/-- **The sign-mask construction IS SMT-LIB signed division**: with
    `SA = ashr(A, w-1)`, `SB = ashr(B, w-1)`,
    `|X| = (SX ^^^ X) - SX` and `Q = |A| udiv |B|`,
    `(Q ^^^ (SA ^^^ SB)) - (SA ^^^ SB) = A smtSDiv B` — in all four sign
    cases, division by zero and `INT_MIN / -1` included (`smtSDiv_eq`). -/
theorem sdiv_construction {w : Nat} (hw : 0 < w) (A B : BitVec w) :
    ((((A.sshiftRight (w - 1) ^^^ A) - A.sshiftRight (w - 1)).smtUDiv
        ((B.sshiftRight (w - 1) ^^^ B) - B.sshiftRight (w - 1)))
      ^^^ (A.sshiftRight (w - 1) ^^^ B.sshiftRight (w - 1)))
      - (A.sshiftRight (w - 1) ^^^ B.sshiftRight (w - 1))
      = A.smtSDiv B := by
  simp only [sshiftRight_last hw, xor_sub_signMask, xor_signMask, xor_sub_signMask']
  rw [BitVec.smtSDiv_eq]
  cases hA : A.msb <;> cases hB : B.msb <;> simp

/-- **`bvsrem` is the multiplicative identity**: `A srem B = A - (A smtSDiv B) * B`
    for every `B`, `0` included (`umod_eq_sub_smtUDiv_mul` in each sign case,
    `srem_eq` / `smtSDiv_eq`). -/
theorem srem_eq_sub_smtSDiv_mul {w : Nat} (A B : BitVec w) :
    A.srem B = A - A.smtSDiv B * B := by
  rw [BitVec.srem_eq, BitVec.smtSDiv_eq]
  cases hA : A.msb <;> cases hB : B.msb <;> dsimp only
  · exact umod_eq_sub_smtUDiv_mul A B
  · rw [umod_eq_sub_smtUDiv_mul A (-B), BitVec.mul_neg, BitVec.neg_mul]
  · rw [umod_eq_sub_smtUDiv_mul (-A) B, BitVec.neg_sub, BitVec.neg_neg, BitVec.neg_mul,
      BitVec.sub_neg]
  · rw [umod_eq_sub_smtUDiv_mul (-A) (-B), BitVec.mul_neg, BitVec.sub_neg, BitVec.neg_add,
      BitVec.neg_neg]

/- ══════════════ GATE BOUNDS OF THE COMPONENTS, AS NAMES ══════════════ -/

/-- `blast_xor`: `3·w`. -/
def xorBound (w : Nat) : Nat := 3 * w
/-- `blast_sub`: `9·w`. -/
def subBound (w : Nat) : Nat := 9 * w
/-- `blast_udiv`: `12·w² + 8·w`. -/
def udivBound (w : Nat) : Nat := 12 * w * w + 8 * w
/-- `blast_mul`: `10·w²`. -/
def mulBound (w : Nat) : Nat := 10 * w * w
/-- `blast_ashr` at equal operand widths. -/
def ashrBound (w : Nat) : Nat := 3 * w * pStages w + (w - pStages w) + 3 * w
/-- `abs_word`: an XOR and a subtraction. -/
def absBound (w : Nat) : Nat := xorBound w + subBound w
/-- `blast_sdiv`: two sign masks, two magnitudes, the divider, the result
    sign and its application. -/
def sdivBound (w : Nat) : Nat :=
  ashrBound w + absBound w + ashrBound w + absBound w + udivBound w
    + xorBound w + xorBound w + subBound w
/-- `blast_srem`: the signed quotient, a multiplier and a subtraction. -/
def sremBound (w : Nat) : Nat := sdivBound w + mulBound w + subBound w

theorem blast_xor_dframe (aig : Aig) (a b : Slice Lit)
    (hab : a.val.length ≤ b.val.length)
    (hcap : aig.nodes.val.length + xorBound a.val.length ≤ Usize.max)
    (ha : ∀ l ∈ a.val, l.node.val < aig.nodes.val.length)
    (hb : ∀ l ∈ b.val, l.node.val < aig.nodes.val.length) :
    blast_xor aig a b ⦃ p => WordFrame aig a (xorBound a.val.length) p ⦄ :=
  blast_xor_wframe aig a b hab hcap ha hb

theorem blast_sub_dframe (aig : Aig) (a b : Slice Lit)
    (hab : a.val.length ≤ b.val.length)
    (hcap : aig.nodes.val.length + subBound a.val.length ≤ Usize.max)
    (ha : ∀ l ∈ a.val, l.node.val < aig.nodes.val.length)
    (hb : ∀ l ∈ b.val, l.node.val < aig.nodes.val.length)
    (hne : 0 < aig.nodes.val.length) :
    blast_sub aig a b ⦃ p => WordFrame aig a (subBound a.val.length) p ⦄ :=
  blast_sub_wframe aig a b hab hcap ha hb hne

theorem blast_udiv_dframe (aig : Aig) (a b : Slice Lit)
    (hab : a.val.length ≤ b.val.length)
    (hcap : aig.nodes.val.length + udivBound a.val.length ≤ Usize.max)
    (ha : ∀ l ∈ a.val, l.node.val < aig.nodes.val.length)
    (hb : ∀ l ∈ b.val, l.node.val < aig.nodes.val.length)
    (hne : 0 < aig.nodes.val.length)
    (h0 : aig.nodes.val[0]'hne = Node.False) :
    blast_udiv aig a b ⦃ p => WordFrame aig a (udivBound a.val.length) p ⦄ :=
  blast_udiv_wframe aig a b hab hcap ha hb hne h0

theorem blast_mul_dframe (aig : Aig) (a b : Slice Lit)
    (hab : a.val.length ≤ b.val.length)
    (hcap : aig.nodes.val.length + mulBound a.val.length ≤ Usize.max)
    (ha : ∀ l ∈ a.val, l.node.val < aig.nodes.val.length)
    (hb : ∀ l ∈ b.val, l.node.val < aig.nodes.val.length)
    (hne : 0 < aig.nodes.val.length)
    (h0 : aig.nodes.val[0]'hne = Node.False) :
    blast_mul aig a b ⦃ p => WordFrame aig a (mulBound a.val.length) p ⦄ :=
  blast_mul_wframe aig a b hab hcap ha hb hne h0

theorem blast_ashr_dframe (aig : Aig) (a b : Slice Lit)
    (hw : 0 < a.val.length)
    (hab : b.val.length = a.val.length)
    (hcap : aig.nodes.val.length + ashrBound a.val.length ≤ Usize.max)
    (ha : ∀ l ∈ a.val, l.node.val < aig.nodes.val.length)
    (hb : ∀ l ∈ b.val, l.node.val < aig.nodes.val.length)
    (hne : 0 < aig.nodes.val.length)
    (h0 : aig.nodes.val[0]'hne = Node.False) :
    blast_ashr aig a b ⦃ p => WordFrame aig a (ashrBound a.val.length) p ⦄ := by
  have hcap' : aig.nodes.val.length
      + (3 * a.val.length * pStages a.val.length
        + (b.val.length - pStages a.val.length) + 3 * a.val.length) ≤ Usize.max := by
    rw [hab]
    simpa only [ashrBound] using hcap
  apply WP.spec_mono (blast_ashr_wframe aig a b hw (by omega) hcap' ha hb hne h0)
  intro p h
  obtain ⟨h1, h2, h3, h4, h5⟩ := h
  refine ⟨h1, h2, ?_, h4, h5⟩
  rw [hab] at h3
  simpa only [ashrBound] using h3

/- ══════════════ `sign_mask` AND `abs_word` ══════════════ -/

/-- `sign_mask`: frame and pure semantics — the word denotes
    `A.sshiftRight (w - 1)`, i.e. the sign mask (`sshiftRight_last`). -/
theorem sign_mask_pure (aig : Aig) (a : Slice Lit) (L : Nat)
    (hw : 0 < a.val.length)
    (hcap : aig.nodes.val.length + ashrBound a.val.length ≤ Usize.max)
    (ha : ∀ l ∈ a.val, l.node.val < aig.nodes.val.length)
    (hne : 0 < aig.nodes.val.length)
    (h0 : aig.nodes.val[0]'hne = Node.False)
    (hwf : AigWF aig.nodes.val L) (hL : L ≤ Usize.max)
    {w : Nat} (A : BitVec w) :
    sign_mask aig a ⦃ p => WordFrame aig a (ashrBound a.val.length) p ∧
      ∀ inp, Denotes (pSim inp aig.nodes.val) a.val w A →
        Denotes (pSim inp p.2.nodes.val) p.1.val w (A.sshiftRight (w - 1)) ⦄ := by
  unfold sign_mask
  have hlen : (Slice.len a).val = a.val.length := by scalar_tac
  step as ⟨i1, hi1⟩
  have hi1v : i1.val = a.val.length - 1 := by scalar_tac
  step with (word_const_spec i1 (Slice.len a)) as ⟨shift, hsl, hsbits⟩
  rw [hlen] at hsl
  simp only [hi1v] at hsbits
  have hderef : (alloc.vec.Vec.deref shift).val = shift.val := rfl
  have hsrng : ∀ l ∈ (alloc.vec.Vec.deref shift).val, l.node.val < aig.nodes.val.length := by
    rw [hderef]
    exact word_const_rng hne hsbits
  have hslen : (alloc.vec.Vec.deref shift).val.length = a.val.length := by rw [hderef, hsl]
  apply WP.spec_mono (bin_pure_of_sim
    (blast_ashr_dframe aig a (alloc.vec.Vec.deref shift) hw hslen hcap ha hsrng hne h0)
    (blast_ashr_bitvec aig a (alloc.vec.Vec.deref shift) hw (by omega)
      (by rw [hslen]; simpa only [ashrBound] using hcap) ha hsrng hne h0
      A (BitVec.ofNat w (a.val.length - 1))) hwf hL ha hsrng)
  rintro ⟨out, aig1⟩ ⟨hfr, hs⟩
  refine ⟨hfr, fun inp hA => ?_⟩
  have hal : a.val.length = w := hA.1
  have hS : Denotes (pSim inp aig.nodes.val) (alloc.vec.Vec.deref shift).val w
      (BitVec.ofNat w (a.val.length - 1)) :=
    word_const_denotes hne h0 (by rw [hslen, hal]) (by rw [hderef]; exact hsbits) inp
  have hres := hs inp hA hS
  have hwlt : a.val.length - 1 < 2 ^ w := by
    have := Nat.lt_two_pow_self (n := w)
    omega
  rw [BitVec.toNat_ofNat, Nat.mod_eq_of_lt hwlt, hal] at hres
  exact hres

/-- `abs_word`: frame and pure semantics — given the sign mask `S` of `A`
    the word denotes `(S ^^^ A) - S`. -/
theorem abs_word_pure (aig : Aig) (a s : Slice Lit) (L : Nat)
    (hsa : s.val.length = a.val.length)
    (hcap : aig.nodes.val.length + absBound a.val.length ≤ Usize.max)
    (ha : ∀ l ∈ a.val, l.node.val < aig.nodes.val.length)
    (hs : ∀ l ∈ s.val, l.node.val < aig.nodes.val.length)
    (hne : 0 < aig.nodes.val.length)
    (h0 : aig.nodes.val[0]'hne = Node.False)
    (hwf : AigWF aig.nodes.val L) (hL : L ≤ Usize.max)
    {w : Nat} (A S : BitVec w) :
    abs_word aig a s ⦃ p => WordFrame aig a (absBound a.val.length) p ∧
      ∀ inp, Denotes (pSim inp aig.nodes.val) a.val w A →
        Denotes (pSim inp aig.nodes.val) s.val w S →
        Denotes (pSim inp p.2.nodes.val) p.1.val w ((S ^^^ A) - S) ⦄ := by
  unfold abs_word
  simp only [absBound] at hcap
  step with (bin_pure_of_sim
    (blast_xor_dframe aig s a (by omega) (by rw [hsa]; omega) hs ha)
    (blast_xor_bitvec aig s a (by omega) (by rw [hsa]; simp only [xorBound] at hcap; omega)
      hs ha S A) hwf hL hs ha) as ⟨x, aig1, hfr1, hs1⟩
  obtain ⟨hxl, hpre1, hlen1, hwf1, hxrng⟩ := hfr1
  dsimp only at hxl hpre1 hlen1 hwf1 hxrng hs1
  rw [hsa] at hxl hlen1
  have hderefx : (alloc.vec.Vec.deref x).val = x.val := rfl
  have hxlen : (alloc.vec.Vec.deref x).val.length = a.val.length := by rw [hderefx, hxl]
  have hxrng' : ∀ l ∈ (alloc.vec.Vec.deref x).val, l.node.val < aig1.nodes.val.length := by
    rw [hderefx]
    exact hxrng
  have hne1 : 0 < aig1.nodes.val.length := by
    have := hpre1.length_le
    omega
  have h01 : aig1.nodes.val[0]'hne1 = Node.False := node0_of_prefix hpre1 hne h0 hne1
  have hs1' : ∀ l ∈ s.val, l.node.val < aig1.nodes.val.length := by
    intro l hl
    have := hs l hl
    have := hpre1.length_le
    omega
  apply WP.spec_mono (bin_pure_of_sim
    (blast_sub_dframe aig1 (alloc.vec.Vec.deref x) s (by omega) (by rw [hxlen]; omega)
      hxrng' hs1' hne1)
    (blast_sub_bitvec aig1 (alloc.vec.Vec.deref x) s (by omega)
      (by rw [hxlen]; simp only [subBound] at hlen1 hcap; omega) hxrng' hs1' hne1 h01
      (S ^^^ A) S) (hwf1 L hwf) hL hxrng' hs1')
  rintro ⟨out, aig2⟩ ⟨hfr2, hs2⟩
  obtain ⟨hol, hpre2, hlen2, hwf2, horng⟩ := hfr2
  dsimp only at hol hpre2 hlen2 hwf2 horng hs2
  refine ⟨⟨by rw [hol, hxlen], hpre1.trans hpre2, ?_, fun L hL => hwf2 L (hwf1 L hL), horng⟩,
    fun inp hA hS => ?_⟩
  · rw [hxlen] at hlen2
    simp only [absBound]
    omega
  · have hX := hs1 inp hS hA
    exact hs2 inp (by rw [hderefx]; exact hX) (hS.up hpre1 hs inp)

/- ══════════════ `bvsdiv` ══════════════ -/

/-- The pure conditional form of `blast_sdiv`, frame included. -/
theorem blast_sdiv_pure (aig : Aig) (a b : Slice Lit) (L : Nat)
    (hw : 0 < a.val.length)
    (hab : b.val.length = a.val.length)
    (hcap : aig.nodes.val.length + sdivBound a.val.length ≤ Usize.max)
    (ha : ∀ l ∈ a.val, l.node.val < aig.nodes.val.length)
    (hb : ∀ l ∈ b.val, l.node.val < aig.nodes.val.length)
    (hne : 0 < aig.nodes.val.length)
    (h0 : aig.nodes.val[0]'hne = Node.False)
    (hwf : AigWF aig.nodes.val L) (hL : L ≤ Usize.max)
    {w : Nat} (A B : BitVec w) :
    blast_sdiv aig a b ⦃ p => WordFrame aig a (sdivBound a.val.length) p ∧
      ∀ inp, Denotes (pSim inp aig.nodes.val) a.val w A →
        Denotes (pSim inp aig.nodes.val) b.val w B →
        Denotes (pSim inp p.2.nodes.val) p.1.val w (A.smtSDiv B) ⦄ := by
  unfold blast_sdiv
  simp only [sdivBound] at hcap
  have hwb : 0 < b.val.length := by omega
  -- stage 1: sa = sign_mask a
  step with (sign_mask_pure aig a L hw (by omega) ha hne h0 hwf hL A) as ⟨sa, aig1, hfr1, hs1⟩
  obtain ⟨hsal, hpre1, hlen1, hwf1, hsarng⟩ := hfr1
  dsimp only at hsal hpre1 hlen1 hwf1 hsarng hs1
  have hderefsa : (alloc.vec.Vec.deref sa).val = sa.val := rfl
  have hsalen : (alloc.vec.Vec.deref sa).val.length = a.val.length := by rw [hderefsa, hsal]
  have hsarng1 : ∀ l ∈ (alloc.vec.Vec.deref sa).val, l.node.val < aig1.nodes.val.length := by
    rw [hderefsa]
    exact hsarng
  have hne1 : 0 < aig1.nodes.val.length := by
    have := hpre1.length_le
    omega
  have h01 : aig1.nodes.val[0]'hne1 = Node.False := node0_of_prefix hpre1 hne h0 hne1
  have ha1 : ∀ l ∈ a.val, l.node.val < aig1.nodes.val.length :=
    fun l hl => Nat.lt_of_lt_of_le (ha l hl) hpre1.length_le
  -- stage 2: abs_a = abs_word a sa
  step with (abs_word_pure aig1 a (alloc.vec.Vec.deref sa) L hsalen (by omega) ha1 hsarng1
    hne1 h01 (hwf1 L hwf) hL A (A.sshiftRight (w - 1))) as ⟨absa, aig2, hfr2, hs2⟩
  obtain ⟨habsal, hpre2, hlen2, hwf2, habsarng⟩ := hfr2
  dsimp only at habsal hpre2 hlen2 hwf2 habsarng hs2
  have hderefabsa : (alloc.vec.Vec.deref absa).val = absa.val := rfl
  have habsalen : (alloc.vec.Vec.deref absa).val.length = a.val.length := by
    rw [hderefabsa, habsal]
  have habsarng2 : ∀ l ∈ (alloc.vec.Vec.deref absa).val, l.node.val < aig2.nodes.val.length := by
    rw [hderefabsa]
    exact habsarng
  have hne2 : 0 < aig2.nodes.val.length := by
    have := hpre2.length_le
    omega
  have h02 : aig2.nodes.val[0]'hne2 = Node.False := node0_of_prefix hpre2 hne1 h01 hne2
  have hb2 : ∀ l ∈ b.val, l.node.val < aig2.nodes.val.length :=
    fun l hl => Nat.lt_of_lt_of_le (hb l hl) (hpre1.trans hpre2).length_le
  -- stage 3: sb = sign_mask b
  step with (sign_mask_pure aig2 b L hwb (by rw [hab]; omega) hb2 hne2 h02
    (hwf2 L (hwf1 L hwf)) hL B) as ⟨sb, aig3, hfr3, hs3⟩
  obtain ⟨hsbl, hpre3, hlen3, hwf3, hsbrng⟩ := hfr3
  dsimp only at hsbl hpre3 hlen3 hwf3 hsbrng hs3
  rw [hab] at hsbl hlen3
  have hderefsb : (alloc.vec.Vec.deref sb).val = sb.val := rfl
  have hsblen : (alloc.vec.Vec.deref sb).val.length = b.val.length := by
    rw [hderefsb, hsbl, hab]
  have hsbrng3 : ∀ l ∈ (alloc.vec.Vec.deref sb).val, l.node.val < aig3.nodes.val.length := by
    rw [hderefsb]
    exact hsbrng
  have hne3 : 0 < aig3.nodes.val.length := by
    have := hpre3.length_le
    omega
  have h03 : aig3.nodes.val[0]'hne3 = Node.False := node0_of_prefix hpre3 hne2 h02 hne3
  have hb3 : ∀ l ∈ b.val, l.node.val < aig3.nodes.val.length :=
    fun l hl => Nat.lt_of_lt_of_le (hb2 l hl) hpre3.length_le
  -- stage 4: abs_b = abs_word b sb
  step with (abs_word_pure aig3 b (alloc.vec.Vec.deref sb) L hsblen (by rw [hab]; omega) hb3
    hsbrng3 hne3 h03 (hwf3 L (hwf2 L (hwf1 L hwf))) hL B (B.sshiftRight (w - 1))) as
    ⟨absb, aig4, hfr4, hs4⟩
  obtain ⟨habsbl, hpre4, hlen4, hwf4, habsbrng⟩ := hfr4
  dsimp only at habsbl hpre4 hlen4 hwf4 habsbrng hs4
  rw [hab] at habsbl hlen4
  have hderefabsb : (alloc.vec.Vec.deref absb).val = absb.val := rfl
  have habsblen : (alloc.vec.Vec.deref absb).val.length = a.val.length := by
    rw [hderefabsb, habsbl]
  have habsbrng4 : ∀ l ∈ (alloc.vec.Vec.deref absb).val, l.node.val < aig4.nodes.val.length := by
    rw [hderefabsb]
    exact habsbrng
  have hne4 : 0 < aig4.nodes.val.length := by
    have := hpre4.length_le
    omega
  have h04 : aig4.nodes.val[0]'hne4 = Node.False := node0_of_prefix hpre4 hne3 h03 hne4
  have habsarng4 : ∀ l ∈ (alloc.vec.Vec.deref absa).val, l.node.val < aig4.nodes.val.length :=
    fun l hl => Nat.lt_of_lt_of_le (habsarng2 l hl) (hpre3.trans hpre4).length_le
  -- stage 5: q = abs_a udiv abs_b
  step with (bin_pure_of_sim
    (blast_udiv_dframe aig4 (alloc.vec.Vec.deref absa) (alloc.vec.Vec.deref absb)
      (by omega) (by rw [habsalen]; omega) habsarng4 habsbrng4 hne4 h04)
    (blast_udiv_bitvec aig4 (alloc.vec.Vec.deref absa) (alloc.vec.Vec.deref absb)
      (by omega) (by rw [habsalen]; simp only [udivBound] at hcap; omega) habsarng4 habsbrng4
      hne4 h04
      ((A.sshiftRight (w - 1) ^^^ A) - A.sshiftRight (w - 1))
      ((B.sshiftRight (w - 1) ^^^ B) - B.sshiftRight (w - 1)))
    (hwf4 L (hwf3 L (hwf2 L (hwf1 L hwf)))) hL habsarng4 habsbrng4) as ⟨q, aig5, hfr5, hs5⟩
  obtain ⟨hql, hpre5, hlen5, hwf5, hqrng⟩ := hfr5
  dsimp only at hql hpre5 hlen5 hwf5 hqrng hs5
  rw [habsalen] at hql hlen5
  have hderefq : (alloc.vec.Vec.deref q).val = q.val := rfl
  have hqlen : (alloc.vec.Vec.deref q).val.length = a.val.length := by rw [hderefq, hql]
  have hqrng5 : ∀ l ∈ (alloc.vec.Vec.deref q).val, l.node.val < aig5.nodes.val.length := by
    rw [hderefq]
    exact hqrng
  have hne5 : 0 < aig5.nodes.val.length := by
    have := hpre5.length_le
    omega
  have h05 : aig5.nodes.val[0]'hne5 = Node.False := node0_of_prefix hpre5 hne4 h04 hne5
  have hpre15 : aig1.nodes.val <+: aig5.nodes.val :=
    hpre2.trans (hpre3.trans (hpre4.trans hpre5))
  have hpre35 : aig3.nodes.val <+: aig5.nodes.val := hpre4.trans hpre5
  have hsarng5 : ∀ l ∈ (alloc.vec.Vec.deref sa).val, l.node.val < aig5.nodes.val.length :=
    fun l hl => Nat.lt_of_lt_of_le (hsarng1 l hl) hpre15.length_le
  have hsbrng5 : ∀ l ∈ (alloc.vec.Vec.deref sb).val, l.node.val < aig5.nodes.val.length :=
    fun l hl => Nat.lt_of_lt_of_le (hsbrng3 l hl) hpre35.length_le
  -- stage 6: rs = sa xor sb
  step with (bin_pure_of_sim
    (blast_xor_dframe aig5 (alloc.vec.Vec.deref sa) (alloc.vec.Vec.deref sb)
      (by rw [hsalen, hsblen, hab]) (by rw [hsalen]; omega) hsarng5 hsbrng5)
    (blast_xor_bitvec aig5 (alloc.vec.Vec.deref sa) (alloc.vec.Vec.deref sb)
      (by rw [hsalen, hsblen, hab]) (by rw [hsalen]; simp only [xorBound] at hcap; omega)
      hsarng5 hsbrng5 (A.sshiftRight (w - 1)) (B.sshiftRight (w - 1)))
    (hwf5 L (hwf4 L (hwf3 L (hwf2 L (hwf1 L hwf))))) hL hsarng5 hsbrng5) as ⟨rs, aig6, hfr6, hs6⟩
  obtain ⟨hrsl, hpre6, hlen6, hwf6, hrsrng⟩ := hfr6
  dsimp only at hrsl hpre6 hlen6 hwf6 hrsrng hs6
  rw [hsalen] at hrsl hlen6
  have hderefrs : (alloc.vec.Vec.deref rs).val = rs.val := rfl
  have hrslen : (alloc.vec.Vec.deref rs).val.length = a.val.length := by rw [hderefrs, hrsl]
  have hrsrng6 : ∀ l ∈ (alloc.vec.Vec.deref rs).val, l.node.val < aig6.nodes.val.length := by
    rw [hderefrs]
    exact hrsrng
  have hne6 : 0 < aig6.nodes.val.length := by
    have := hpre6.length_le
    omega
  have h06 : aig6.nodes.val[0]'hne6 = Node.False := node0_of_prefix hpre6 hne5 h05 hne6
  have hqrng6 : ∀ l ∈ (alloc.vec.Vec.deref q).val, l.node.val < aig6.nodes.val.length :=
    fun l hl => Nat.lt_of_lt_of_le (hqrng5 l hl) hpre6.length_le
  -- stage 7: xq = q xor rs
  step with (bin_pure_of_sim
    (blast_xor_dframe aig6 (alloc.vec.Vec.deref q) (alloc.vec.Vec.deref rs)
      (by rw [hqlen, hrslen]) (by rw [hqlen]; omega) hqrng6 hrsrng6)
    (blast_xor_bitvec aig6 (alloc.vec.Vec.deref q) (alloc.vec.Vec.deref rs)
      (by rw [hqlen, hrslen])
      (by rw [hqlen]; show aig6.nodes.val.length + xorBound a.val.length ≤ Usize.max; omega)
      hqrng6 hrsrng6
      (((A.sshiftRight (w - 1) ^^^ A) - A.sshiftRight (w - 1)).smtUDiv
        ((B.sshiftRight (w - 1) ^^^ B) - B.sshiftRight (w - 1)))
      (A.sshiftRight (w - 1) ^^^ B.sshiftRight (w - 1)))
    (hwf6 L (hwf5 L (hwf4 L (hwf3 L (hwf2 L (hwf1 L hwf)))))) hL hqrng6 hrsrng6) as
    ⟨xq, aig7, hfr7, hs7⟩
  obtain ⟨hxql, hpre7, hlen7, hwf7, hxqrng⟩ := hfr7
  dsimp only at hxql hpre7 hlen7 hwf7 hxqrng hs7
  rw [hqlen] at hxql hlen7
  have hderefxq : (alloc.vec.Vec.deref xq).val = xq.val := rfl
  have hxqlen : (alloc.vec.Vec.deref xq).val.length = a.val.length := by rw [hderefxq, hxql]
  have hxqrng7 : ∀ l ∈ (alloc.vec.Vec.deref xq).val, l.node.val < aig7.nodes.val.length := by
    rw [hderefxq]
    exact hxqrng
  have hne7 : 0 < aig7.nodes.val.length := by
    have := hpre7.length_le
    omega
  have h07 : aig7.nodes.val[0]'hne7 = Node.False := node0_of_prefix hpre7 hne6 h06 hne7
  have hrsrng7 : ∀ l ∈ (alloc.vec.Vec.deref rs).val, l.node.val < aig7.nodes.val.length :=
    fun l hl => Nat.lt_of_lt_of_le (hrsrng6 l hl) hpre7.length_le
  -- stage 8: out = xq - rs
  apply WP.spec_mono (bin_pure_of_sim
    (blast_sub_dframe aig7 (alloc.vec.Vec.deref xq) (alloc.vec.Vec.deref rs)
      (by rw [hxqlen, hrslen]) (by rw [hxqlen]; omega) hxqrng7 hrsrng7 hne7)
    (blast_sub_bitvec aig7 (alloc.vec.Vec.deref xq) (alloc.vec.Vec.deref rs)
      (by rw [hxqlen, hrslen]) (by rw [hxqlen]; simp only [subBound] at hcap; omega)
      hxqrng7 hrsrng7 hne7 h07
      ((((A.sshiftRight (w - 1) ^^^ A) - A.sshiftRight (w - 1)).smtUDiv
          ((B.sshiftRight (w - 1) ^^^ B) - B.sshiftRight (w - 1)))
        ^^^ (A.sshiftRight (w - 1) ^^^ B.sshiftRight (w - 1)))
      (A.sshiftRight (w - 1) ^^^ B.sshiftRight (w - 1)))
    (hwf7 L (hwf6 L (hwf5 L (hwf4 L (hwf3 L (hwf2 L (hwf1 L hwf))))))) hL hxqrng7 hrsrng7)
  rintro ⟨out, aig8⟩ ⟨hfr8, hs8⟩
  obtain ⟨hol, hpre8, hlen8, hwf8, horng⟩ := hfr8
  dsimp only at hol hpre8 hlen8 hwf8 horng hs8
  rw [hxqlen] at hol hlen8
  refine ⟨⟨hol, hpre1.trans (hpre2.trans (hpre3.trans (hpre4.trans (hpre5.trans
      (hpre6.trans (hpre7.trans hpre8)))))), by simp only [sdivBound]; omega,
    fun L hL => hwf8 L (hwf7 L (hwf6 L (hwf5 L (hwf4 L (hwf3 L (hwf2 L (hwf1 L hL))))))),
    horng⟩, fun inp hA hB => ?_⟩
  have hal : a.val.length = w := hA.1
  have hwpos : 0 < w := by omega
  -- the chain of denotations
  have hSA := hs1 inp hA
  have hABSA := hs2 inp (hA.up hpre1 ha inp) hSA
  have hSB := hs3 inp (hB.up (hpre1.trans hpre2) hb inp)
  have hABSB := hs4 inp (hB.up (hpre1.trans (hpre2.trans hpre3)) hb inp) hSB
  have hQ := hs5 inp (hABSA.up (hpre3.trans hpre4) habsarng2 inp) hABSB
  have hRS := hs6 inp (hSA.up hpre15 hsarng1 inp) (hSB.up hpre35 hsbrng3 inp)
  have hXQ := hs7 inp (hQ.up hpre6 hqrng5 inp) hRS
  have hOUT := hs8 inp hXQ (hRS.up hpre7 hrsrng6 inp)
  rw [sdiv_construction hwpos A B] at hOUT
  exact hOUT


/-- Structural frame of `blast_sdiv` (the composition's frame is read off
    the pure spec, which is why an `AigWF` witness is among the hypotheses;
    every caller — `encode_node_spec` — has one). -/
theorem blast_sdiv_frame (aig : Aig) (a b : Slice Lit) (L : Nat)
    (hw : 0 < a.val.length)
    (hab : b.val.length = a.val.length)
    (hcap : aig.nodes.val.length + sdivBound a.val.length ≤ Usize.max)
    (ha : ∀ l ∈ a.val, l.node.val < aig.nodes.val.length)
    (hb : ∀ l ∈ b.val, l.node.val < aig.nodes.val.length)
    (hne : 0 < aig.nodes.val.length)
    (h0 : aig.nodes.val[0]'hne = Node.False)
    (hwf : AigWF aig.nodes.val L) (hL : L ≤ Usize.max) :
    blast_sdiv aig a b ⦃ p => WordFrame aig a (sdivBound a.val.length) p ⦄ :=
  WP.spec_mono (blast_sdiv_pure aig a b L hw hab hcap ha hb hne h0 hwf hL (w := 0) 0#0 0#0)
    (fun _ h => h.1)

/-- Back from a pure conditional spec established at ONE `L` to the
    standard simulate-wrapped capstone shape (the semantics part of the
    pure spec is unconditional on `L`). -/
theorem sim_of_pure' {aig : Aig} {a b : Slice Lit} {bound : Nat}
    {rule : Result (alloc.vec.Vec Lit × Aig)} {w : Nat} {A B C : BitVec w}
    (hpure : rule ⦃ p => WordFrame aig a bound p ∧
      ∀ inp, Denotes (pSim inp aig.nodes.val) a.val w A →
        Denotes (pSim inp aig.nodes.val) b.val w B →
        Denotes (pSim inp p.2.nodes.val) p.1.val w C ⦄)
    (ha : ∀ l ∈ a.val, l.node.val < aig.nodes.val.length)
    (hb : ∀ l ∈ b.val, l.node.val < aig.nodes.val.length) :
    rule ⦃ p => ∀ inputs : Slice Bool, AigWF aig.nodes.val inputs.val.length →
      simulate p.2 inputs ⦃ vals =>
        Denotes vals.val a.val w A → Denotes vals.val b.val w B →
        Denotes vals.val p.1.val w C ⦄ ⦄ := by
  apply WP.spec_mono hpure
  rintro ⟨out, aig1⟩ ⟨⟨_, hpre, _, hwfp, _⟩, hs⟩
  dsimp only at hpre hwfp hs
  intro inputs hwf
  apply WP.spec_mono (simulate_spec aig1 inputs (hwfp _ hwf))
  intro vals hv hA hB
  rw [hv] at hA hB ⊢
  exact hs inputs.val (hA.of_prefix hpre ha inputs.val) (hB.of_prefix hpre hb inputs.val)

/-- **`blast_sdiv` implements SMT-LIB `bvsdiv` (`BitVec.smtSDiv`), for
    EVERY width `w ≥ 1`** — division by zero (`-1` for a non-negative
    dividend, `1` otherwise) and `INT_MIN / -1 = INT_MIN` included, since
    `smtSDiv` is defined by exactly the sign-case analysis the rule
    performs (`sdiv_construction`). -/
theorem blast_sdiv_bitvec (aig : Aig) (a b : Slice Lit) (L : Nat)
    (hw : 0 < a.val.length)
    (hab : b.val.length = a.val.length)
    (hcap : aig.nodes.val.length + sdivBound a.val.length ≤ Usize.max)
    (ha : ∀ l ∈ a.val, l.node.val < aig.nodes.val.length)
    (hb : ∀ l ∈ b.val, l.node.val < aig.nodes.val.length)
    (hne : 0 < aig.nodes.val.length)
    (h0 : aig.nodes.val[0]'hne = Node.False)
    (hwf : AigWF aig.nodes.val L) (hL : L ≤ Usize.max)
    {w : Nat} (A B : BitVec w) :
    blast_sdiv aig a b ⦃ p =>
      ∀ (inputs : Slice Bool), AigWF aig.nodes.val inputs.val.length →
        simulate p.2 inputs ⦃ vals =>
          Denotes vals.val a.val w A → Denotes vals.val b.val w B →
          Denotes vals.val p.1.val w (A.smtSDiv B) ⦄ ⦄ :=
  sim_of_pure' (blast_sdiv_pure aig a b L hw hab hcap ha hb hne h0 hwf hL A B) ha hb

/- ══════════════ `bvsrem` ══════════════ -/

/-- The pure conditional form of `blast_srem`, frame included: the
    multiplicative composition `a - (a sdiv b) * b` denotes `A.srem B`
    (`srem_eq_sub_smtSDiv_mul`). -/
theorem blast_srem_pure (aig : Aig) (a b : Slice Lit) (L : Nat)
    (hw : 0 < a.val.length)
    (hab : b.val.length = a.val.length)
    (hcap : aig.nodes.val.length + sremBound a.val.length ≤ Usize.max)
    (ha : ∀ l ∈ a.val, l.node.val < aig.nodes.val.length)
    (hb : ∀ l ∈ b.val, l.node.val < aig.nodes.val.length)
    (hne : 0 < aig.nodes.val.length)
    (h0 : aig.nodes.val[0]'hne = Node.False)
    (hwf : AigWF aig.nodes.val L) (hL : L ≤ Usize.max)
    {w : Nat} (A B : BitVec w) :
    blast_srem aig a b ⦃ p => WordFrame aig a (sremBound a.val.length) p ∧
      ∀ inp, Denotes (pSim inp aig.nodes.val) a.val w A →
        Denotes (pSim inp aig.nodes.val) b.val w B →
        Denotes (pSim inp p.2.nodes.val) p.1.val w (A.srem B) ⦄ := by
  unfold blast_srem
  simp only [sremBound] at hcap
  -- stage 1: q = a sdiv b
  step with (blast_sdiv_pure aig a b L hw hab (by omega) ha hb hne h0 hwf hL A B) as
    ⟨q, aig1, hfr1, hs1⟩
  obtain ⟨hql, hpre1, hlen1, hwf1, hqrng⟩ := hfr1
  dsimp only at hql hpre1 hlen1 hwf1 hqrng hs1
  have hderefq : (alloc.vec.Vec.deref q).val = q.val := rfl
  have hqlen : (alloc.vec.Vec.deref q).val.length = a.val.length := by rw [hderefq, hql]
  have hqrng1 : ∀ l ∈ (alloc.vec.Vec.deref q).val, l.node.val < aig1.nodes.val.length := by
    rw [hderefq]
    exact hqrng
  have hne1 : 0 < aig1.nodes.val.length := by
    have := hpre1.length_le
    omega
  have h01 : aig1.nodes.val[0]'hne1 = Node.False := node0_of_prefix hpre1 hne h0 hne1
  have hb1 : ∀ l ∈ b.val, l.node.val < aig1.nodes.val.length :=
    fun l hl => Nat.lt_of_lt_of_le (hb l hl) hpre1.length_le
  -- stage 2: prod = q * b
  step with (bin_pure_of_sim
    (blast_mul_dframe aig1 (alloc.vec.Vec.deref q) b (by omega) (by rw [hqlen]; omega)
      hqrng1 hb1 hne1 h01)
    (blast_mul_bitvec aig1 (alloc.vec.Vec.deref q) b (by omega)
      (by rw [hqlen]; simp only [mulBound] at hcap; omega) hqrng1 hb1 hne1 h01
      (A.smtSDiv B) B) (hwf1 L hwf) hL hqrng1 hb1) as ⟨prod, aig2, hfr2, hs2⟩
  obtain ⟨hpl, hpre2, hlen2, hwf2, hprng⟩ := hfr2
  dsimp only at hpl hpre2 hlen2 hwf2 hprng hs2
  rw [hqlen] at hpl hlen2
  have hderefp : (alloc.vec.Vec.deref prod).val = prod.val := rfl
  have hplen : (alloc.vec.Vec.deref prod).val.length = a.val.length := by rw [hderefp, hpl]
  have hprng2 : ∀ l ∈ (alloc.vec.Vec.deref prod).val, l.node.val < aig2.nodes.val.length := by
    rw [hderefp]
    exact hprng
  have hne2 : 0 < aig2.nodes.val.length := by
    have := hpre2.length_le
    omega
  have h02 : aig2.nodes.val[0]'hne2 = Node.False := node0_of_prefix hpre2 hne1 h01 hne2
  have ha2 : ∀ l ∈ a.val, l.node.val < aig2.nodes.val.length :=
    fun l hl => Nat.lt_of_lt_of_le (ha l hl) (hpre1.trans hpre2).length_le
  -- stage 3: out = a - prod
  apply WP.spec_mono (bin_pure_of_sim
    (blast_sub_dframe aig2 a (alloc.vec.Vec.deref prod) (by omega) (by omega) ha2 hprng2 hne2)
    (blast_sub_bitvec aig2 a (alloc.vec.Vec.deref prod) (by omega)
      (by simp only [subBound] at hcap; omega) ha2 hprng2 hne2 h02 A (A.smtSDiv B * B))
    (hwf2 L (hwf1 L hwf)) hL ha2 hprng2)
  rintro ⟨out, aig3⟩ ⟨hfr3, hs3⟩
  obtain ⟨hol, hpre3, hlen3, hwf3, horng⟩ := hfr3
  dsimp only at hol hpre3 hlen3 hwf3 horng hs3
  refine ⟨⟨hol, hpre1.trans (hpre2.trans hpre3), by simp only [sremBound]; omega,
    fun L hL => hwf3 L (hwf2 L (hwf1 L hL)), horng⟩, fun inp hA hB => ?_⟩
  have hQ := hs1 inp hA hB
  have hP := hs2 inp hQ (hB.up hpre1 hb inp)
  have hO := hs3 inp (hA.up (hpre1.trans hpre2) ha inp) hP
  rw [srem_eq_sub_smtSDiv_mul A B]
  exact hO

/-- Structural frame of `blast_srem` (see `blast_sdiv_frame`). -/
theorem blast_srem_frame (aig : Aig) (a b : Slice Lit) (L : Nat)
    (hw : 0 < a.val.length)
    (hab : b.val.length = a.val.length)
    (hcap : aig.nodes.val.length + sremBound a.val.length ≤ Usize.max)
    (ha : ∀ l ∈ a.val, l.node.val < aig.nodes.val.length)
    (hb : ∀ l ∈ b.val, l.node.val < aig.nodes.val.length)
    (hne : 0 < aig.nodes.val.length)
    (h0 : aig.nodes.val[0]'hne = Node.False)
    (hwf : AigWF aig.nodes.val L) (hL : L ≤ Usize.max) :
    blast_srem aig a b ⦃ p => WordFrame aig a (sremBound a.val.length) p ⦄ :=
  WP.spec_mono (blast_srem_pure aig a b L hw hab hcap ha hb hne h0 hwf hL (w := 0) 0#0 0#0)
    (fun _ h => h.1)

/-- **`blast_srem` implements SMT-LIB `bvsrem` (`BitVec.srem`, the sign of
    the dividend), for EVERY width `w ≥ 1`** — `b = 0` (the result is `a`)
    and `INT_MIN % -1 = 0` included. -/
theorem blast_srem_bitvec (aig : Aig) (a b : Slice Lit) (L : Nat)
    (hw : 0 < a.val.length)
    (hab : b.val.length = a.val.length)
    (hcap : aig.nodes.val.length + sremBound a.val.length ≤ Usize.max)
    (ha : ∀ l ∈ a.val, l.node.val < aig.nodes.val.length)
    (hb : ∀ l ∈ b.val, l.node.val < aig.nodes.val.length)
    (hne : 0 < aig.nodes.val.length)
    (h0 : aig.nodes.val[0]'hne = Node.False)
    (hwf : AigWF aig.nodes.val L) (hL : L ≤ Usize.max)
    {w : Nat} (A B : BitVec w) :
    blast_srem aig a b ⦃ p =>
      ∀ (inputs : Slice Bool), AigWF aig.nodes.val inputs.val.length →
        simulate p.2 inputs ⦃ vals =>
          Denotes vals.val a.val w A → Denotes vals.val b.val w B →
          Denotes vals.val p.1.val w (A.srem B) ⦄ ⦄ :=
  sim_of_pure' (blast_srem_pure aig a b L hw hab hcap ha hb hne h0 hwf hL A B) ha hb

/- ══════════════ THE UNARY LIFTER (for `bvneg` in the encoder) ══════════════ -/

/-- A unary word rule, lifted to the pure conditional form. -/
theorem un_pure_of_sim {aig : Aig} {a : Slice Lit} {L bound : Nat}
    {rule : Result (alloc.vec.Vec Lit × Aig)} {w : Nat} {A C : BitVec w}
    (hframe : rule ⦃ p => WordFrame aig a bound p ⦄)
    (hsem : rule ⦃ p => ∀ inputs : Slice Bool, AigWF aig.nodes.val inputs.val.length →
      simulate p.2 inputs ⦃ vals =>
        Denotes vals.val a.val w A → Denotes vals.val p.1.val w C ⦄ ⦄)
    (hwf : AigWF aig.nodes.val L) (hL : L ≤ Usize.max)
    (ha : ∀ l ∈ a.val, l.node.val < aig.nodes.val.length) :
    rule ⦃ p => WordFrame aig a bound p ∧
      ∀ inp, Denotes (pSim inp aig.nodes.val) a.val w A →
        Denotes (pSim inp p.2.nodes.val) p.1.val w C ⦄ := by
  apply WP.spec_mono (spec_and hframe hsem)
  rintro ⟨out, aig1⟩ ⟨hfr, hs⟩
  refine ⟨hfr, fun inp hA => ?_⟩
  obtain ⟨_, hpre, _, hwfp, _⟩ := hfr
  have h := harvest (P := fun vals => Denotes vals a.val w A → Denotes vals out.val w C)
    hwf (hwfp L hwf) hL hs inp
  exact h (Denotes.up hpre ha inp hA)

/-- `blast_neg` in the pure conditional form. -/
theorem blast_neg_pure (aig : Aig) (a : Slice Lit) (L : Nat)
    (hcap : aig.nodes.val.length + 9 * a.val.length ≤ Usize.max)
    (ha : ∀ l ∈ a.val, l.node.val < aig.nodes.val.length)
    (hne : 0 < aig.nodes.val.length)
    (h0 : aig.nodes.val[0]'hne = Node.False)
    (hwf : AigWF aig.nodes.val L) (hL : L ≤ Usize.max)
    {w : Nat} (A : BitVec w) :
    blast_neg aig a ⦃ p => WordFrame aig a (9 * a.val.length) p ∧
      ∀ inp, Denotes (pSim inp aig.nodes.val) a.val w A →
        Denotes (pSim inp p.2.nodes.val) p.1.val w (-A) ⦄ :=
  un_pure_of_sim (blast_neg_frame aig a hcap ha hne) (blast_neg_bitvec aig a hcap ha hne h0 A)
    hwf hL ha

end kernel.blast_kernel.spec
