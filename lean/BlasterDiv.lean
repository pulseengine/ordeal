/- Correctness of the restoring long divider (issue #68, v0.15.0, the LAST
   rule of the capstone): `sub_with_uge` and `blast_udivrem` /
   `blast_udiv` / `blast_urem`.

   This file is HAND-WRITTEN (BlastKernel.lean is generated by
   regen-blaster.sh and must not be edited). It builds on the pure-model
   infrastructure of BlasterProof.lean (`pSim` / `pEvalLit`,
   append-monotonicity, `AigWF`, the gadget-spec idiom, `simulate_spec`,
   `Denotes`), BlasterArith.lean (`dLit`, `lit_true_spec`,
   `pEvalLit_node_zero`, `getLsbD_sub_carry`), BlasterCmp.lean
   (`push_mux_gadget`), BlasterShift.lean (`pHigh`, `pHigh_stable`,
   `pHigh_eq_decide`, `node0_of_prefix`, `MuxMapInv`) and BlasterMul.lean
   (`full_adder_gadget`, `wordVals`, `DenotesBits`, `eq_of_getD_eq`).

   What `blast_udivrem` computes (ground truth from the Rust):

     rem = [F; w]; quo = [F; w]
     for step in 0..w:                  -- i = w-1-step, MSB first
         top = rem[w-1]                 -- bit shifted into position w
         for j in (1..w).rev(): rem[j] = rem[j-1]
         rem[0] = a[i]                  -- rem := (rem << 1) | a_i, low w bits
         (diff, low_ge) = sub_with_uge(rem, b)   -- 9·w gates
         ge = or(top, low_ge)                    -- 1 gate
         quo[i] = ge
         for m in 0..w: rem[m] = mux(ge, diff[m], rem[m])  -- 3·w gates
     -- SMT-LIB /0: quotient all-ones, remainder = dividend
     nz = OR-fold b                     -- w gates
     b_zero = not nz
     quo_out[q] = mux(b_zero, TRUE, quo[q])      -- 3·w gates
     rem_out[r] = mux(b_zero, a[r], rem[r])      -- 3·w gates

   Gate counts (exact): `sub_with_uge` = 9·w, one outer step = 12·w + 1,
   the whole divider = (12·w + 1)·w + 7·w = 12·w² + 8·w.

   THE W-BIT TRICK (the mathematical crux, from the Rust comment): the
   conceptual (w+1)-bit shifted remainder is `V = 2·R + a_i` where the loop
   invariant `R < B` (for `B ≠ 0`) bounds it: `V < 2·B ≤ 2·(2^w − 1)`. The
   shifted-out bit `top` is set iff `V ≥ 2^w`, and since `B < 2^w`, `top`
   alone decides the compare: `ge = top ∨ (B ≤ V mod 2^w) = (B ≤ V)`
   (`pDivGeStep_eq_decide`). The w-bit modular difference is nevertheless
   the TRUE difference: `V − B < B < 2^w` (`restore_toNat`), so the
   restoring mux keeps exactly `V mod B` and the invariant `R < B`
   re-establishes itself (`pDivRemStep_denotesBits`).

   Proof architecture (two halves, glued by `blast_udivrem_correct`):

   * REFINEMENT (Boolean pure model). `pSubCarry`/`pSubBit` model the
     `a + !b + 1` ripple chain of `sub_with_uge` on Boolean words
     (`sub_with_uge_spec`, via `full_adder_gadget`). `pDivShift` /
     `pDivGeStep` / `pDivRem` / `pDivGe` model one restoring step and the
     iterated remainder / quotient bits; `DivInv` is the outer-loop
     invariant (`blast_udivrem_loop1_spec`), with dedicated specs for the
     gate-free shift loop, the restore-mux loop, the `nz` OR-fold (reusing
     `pHigh` at `s = 0`) and the two final `/0` mux loops (via `MuxMapInv`).

   * NUMERIC BRIDGE. On denoting words, `pSubCarry` IS core's
     `BitVec.carry` of `X + ~~~Y + 1` (`pSubCarry_eq_carry`), so
     `low_ge = decide (Y ≤ X)` (`pSubCarry_last`, via
     `BitVec.ult_eq_not_carry`) and `pSubBit` reads `X − Y`
     (`pSubBit_eq_sub`). One restoring step maps remainder
     `Ahi_k mod B` to `Ahi_{k+1} mod B` where `Ahi_k = A.toNat / 2^(w−k)`
     is the consumed high part of the dividend (`pDivRem_ge_spec`, pure
     `Nat` div/mod recurrences), and the emitted `ge` bits are exactly the
     bits of the quotient (`quo_bits_testBit`).

   * The headlines, for EVERY width `w` (`w = 0` degenerates gracefully):
     - `blast_udivrem_bitvec` : quotient word denotes `A.smtUDiv B`
       (SMT-LIB `bvudiv`: all-ones on division by zero — core's
       `BitVec.udiv` returns 0 there, hence `smtUDiv`), remainder word
       denotes `A % B` (core's `umod` ALREADY has the SMT-LIB `x % 0 = x`
       semantics: `BitVec.umod_zero`).
     - `blast_udiv_bitvec` : the quotient projection.
     - `blast_urem_bitvec` : since issue #101 NOT a projection but the
       multiplicative composition `a - (a bvudiv b) * b`
       (`blast_sub(a, blast_mul(blast_udiv(a,b), b))`), exact including
       `/0`: SMT-LIB `a udiv 0 = allOnes` and `allOnes * 0 = 0`, so the
       result is `a - 0 = a` — precisely core's `BitVec.umod_zero`. Glued
       by the new BitVec identity `umod_eq_sub_smtUDiv_mul` and the
       structural "frame" specs (`blast_udivrem_frame`, `blast_mul_frame`,
       `blast_sub_frame`) that expose prefix / gate-count / WF-preservation
       / literal-range facts the simulate-wrapped headlines elide.
-/
import BlasterMul

open Aeneas Aeneas.Std Result

set_option maxHeartbeats 1000000

namespace blast_kernel.spec

/- ══════════════════ THE PURE SUBTRACT-WITH-UGE MODEL ══════════════════ -/

/-- Carry chain of `x + !y + 1` (two's-complement subtraction) on Boolean
    words: carry-in `true`, then the majority recurrence with the second
    operand negated. The final carry is the no-borrow flag `x ≥ y`. -/
def pSubCarry (x y : List Bool) : Nat → Bool
  | 0 => true
  | i + 1 =>
    Bool.atLeastTwo (x.getD i false) (!(y.getD i false)) (pSubCarry x y i)

/-- Difference bit `i` of `x + !y + 1`: the full-adder sum. -/
def pSubBit (x y : List Bool) (i : Nat) : Bool :=
  x.getD i false ^^ (!(y.getD i false) ^^ pSubCarry x y i)

/- ══════════════════ `sub_with_uge`: THE RIPPLE LOOP ══════════════════ -/

/-- Loop invariant of `sub_with_uge` after `i` bits (relative to the
    pre-state aig `aigR`): 9 gates per bit, nothing existing touched, the
    carry literal evaluates — under the CURRENT aig — to `pSubCarry … i`
    and difference literal `t < i` to `pSubBit … t`, operand values read
    under `aigR`. -/
def SubInv (aigR : Aig) (a b : Slice Lit) (aig1 : Aig) (carry1 : Lit)
    (diff1 : alloc.vec.Vec Lit) (i : Nat) : Prop :=
  i ≤ a.val.length ∧
  aig1.nodes.val.length = aigR.nodes.val.length + 9 * i ∧
  aigR.nodes.val <+: aig1.nodes.val ∧
  (∀ L, AigWF aigR.nodes.val L → AigWF aig1.nodes.val L) ∧
  diff1.val.length = i ∧
  (∀ l ∈ diff1.val, l.node.val < aig1.nodes.val.length) ∧
  carry1.node.val < aig1.nodes.val.length ∧
  (∀ inp : List Bool,
    pEvalLit (pSim inp aig1.nodes.val) carry1
      = pSubCarry (wordVals (pSim inp aigR.nodes.val) a.val)
          (wordVals (pSim inp aigR.nodes.val) b.val) i) ∧
  (∀ (inp : List Bool) (t : Nat), t < i →
    pEvalLit (pSim inp aig1.nodes.val) (diff1.val.getD t dLit)
      = pSubBit (wordVals (pSim inp aigR.nodes.val) a.val)
          (wordVals (pSim inp aigR.nodes.val) b.val) t)

/-- The `sub_with_uge` ripple loop maintains `SubInv` to the end. -/
theorem sub_with_uge_loop_spec (aig : Aig) (a b : Slice Lit) (carry : Lit)
    (w : Std.Usize) (hw : w.val = a.val.length)
    (hab : a.val.length ≤ b.val.length)
    (hcap : aig.nodes.val.length + 9 * a.val.length ≤ Usize.max)
    (ha : ∀ l ∈ a.val, l.node.val < aig.nodes.val.length)
    (hb : ∀ l ∈ b.val, l.node.val < aig.nodes.val.length)
    (hcr : carry.node.val < aig.nodes.val.length)
    (hcv : ∀ inp : List Bool,
      pEvalLit (pSim inp aig.nodes.val) carry = true) :
    sub_with_uge_loop aig a b carry (alloc.vec.Vec.new Lit) w 0#usize ⦃ q =>
      SubInv aig a b q.1 q.2.1 q.2.2 a.val.length ⦄ := by
  unfold sub_with_uge_loop
  apply loop.spec_decr_nat
    (measure := fun (s : Aig × Lit × alloc.vec.Vec Lit × Std.Usize) =>
      a.val.length - s.2.2.2.val)
    (inv := fun (s : Aig × Lit × alloc.vec.Vec Lit × Std.Usize) =>
      SubInv aig a b s.1 s.2.1 s.2.2.1 s.2.2.2.val)
  · rintro ⟨aig1, carry1, diff1, i⟩ hinv
    obtain ⟨hile, hlen1, hpre1, hwf1, hdlen, hdrng, hcrng, hcsem, hdsem⟩ :=
      hinv
    dsimp only at hile hlen1 hpre1 hwf1 hdlen hdrng hcrng hcsem hdsem
    unfold sub_with_uge_loop.body
    dsimp only
    split
    · rename_i hlt
      have hia : i.val < a.val.length := by scalar_tac
      have hib : i.val < b.val.length := by omega
      step as ⟨lb, hlb⟩
      step with (lit_not_spec lb) as ⟨nb, hnb⟩
      step as ⟨la, hla⟩
      have hla1 : la.node.val < aig1.nodes.val.length := by
        have h1 := ha la (by rw [hla]; exact List.getElem_mem _)
        have h2 := hpre1.length_le
        omega
      have hnbnode : nb.node = lb.node := by rw [hnb]
      have hnb1 : nb.node.val < aig1.nodes.val.length := by
        have h1 := hb lb (by rw [hlb]; exact List.getElem_mem _)
        have h2 := hpre1.length_le
        rw [hnbnode]
        omega
      have hcap1 : aig1.nodes.val.length + 9 ≤ Usize.max := by omega
      step with (full_adder_gadget aig1 la nb carry1 hcap1 hla1 hnb1 hcrng)
        as ⟨s, cout, aig2, hF1, hF2, hF3, hF4, hF5, hF6⟩
      have hdcap : diff1.val.length < Usize.max := by
        have := a.length_ineq
        omega
      step as ⟨diff2, hdiff2⟩
      step as ⟨i1, hi1⟩
      -- the operand values under aig1, against the pre-state aig
      have hVla : ∀ inp : List Bool,
          pEvalLit (pSim inp aig1.nodes.val) la
            = (wordVals (pSim inp aig.nodes.val) a.val).getD i.val false := by
        intro inp
        rw [hla, pEvalLit_stable hpre1 _ (ha _ (List.getElem_mem hia)) inp,
          wordVals_getD _ _ hia]
      have hVnb : ∀ inp : List Bool,
          pEvalLit (pSim inp aig1.nodes.val) nb
            = !(wordVals (pSim inp aig.nodes.val) b.val).getD i.val
                false := by
        intro inp
        rw [hnb, hlb, pEvalLit_not,
          pEvalLit_stable hpre1 _ (hb _ (List.getElem_mem hib)) inp,
          wordVals_getD _ _ hib]
      refine ⟨?_, by scalar_tac⟩
      rw [hi1]
      refine ⟨by omega, by omega, hpre1.trans hF2,
        fun L hL => hF3 L (hwf1 L hL), by rw [hdiff2]; simp [hdlen], ?_,
        hF5, ?_, ?_⟩
      · -- difference literals in range
        intro l hl
        rw [hdiff2] at hl
        rcases List.mem_append.mp hl with h' | h'
        · have h1 := hdrng l h'
          omega
        · simp only [List.mem_singleton] at h'
          subst h'
          exact hF4
      · -- carry chain advances by one majority stage
        intro inp
        rw [(hF6 inp).2, hVla inp, hVnb inp, hcsem inp]
        rfl
      · -- difference bits: old ones stable, the fresh one is the sum
        intro inp t ht
        rw [hdiff2]
        by_cases hteq : t = i.val
        · subst hteq
          rw [List.getD_eq_getElem?_getD, ← hdlen,
            List.getElem?_concat_length, Option.getD_some, (hF6 inp).1,
            hVla inp, hVnb inp, hcsem inp, hdlen]
          rfl
        · have htlt : t < diff1.val.length := by omega
          rw [List.getD_eq_getElem?_getD, List.getElem?_append_left htlt,
            ← List.getD_eq_getElem?_getD,
            getD_eq_getElem_of_lt htlt dLit,
            pEvalLit_stable hF2 _ (hdrng _ (List.getElem_mem _)) inp,
            ← getD_eq_getElem_of_lt htlt dLit]
          exact hdsem inp t (by omega)
    · rename_i hge
      have hieq : i.val = a.val.length := by scalar_tac
      rw [← hieq]
      exact ⟨hile, hlen1, hpre1, hwf1, hdlen, hdrng, hcrng, hcsem, hdsem⟩
  · dsimp only
    refine ⟨Nat.zero_le _, by scalar_tac, List.prefix_refl _, fun _ h => h,
      by simp, by simp, hcr, ?_, ?_⟩
    · intro inp
      rw [hcv inp]
      rfl
    · intro inp t ht
      scalar_tac

/-- **Spec of `sub_with_uge`** (9·w gates): the difference word carries the
    full-adder sum bits of `a + !b + 1` and the returned flag the final
    carry — `true` iff there was no borrow, i.e. `a ≥ b`. Requires node 0
    to be the constant-FALSE node (the carry chain starts at `lit_true`). -/
theorem sub_with_uge_spec (aig : Aig) (a b : Slice Lit)
    (hab : a.val.length ≤ b.val.length)
    (hcap : aig.nodes.val.length + 9 * a.val.length ≤ Usize.max)
    (ha : ∀ l ∈ a.val, l.node.val < aig.nodes.val.length)
    (hb : ∀ l ∈ b.val, l.node.val < aig.nodes.val.length)
    (hne : 0 < aig.nodes.val.length)
    (h0 : aig.nodes.val[0]'hne = Node.False) :
    sub_with_uge aig a b ⦃ p =>
      p.2.nodes.val.length = aig.nodes.val.length + 9 * a.val.length ∧
      aig.nodes.val <+: p.2.nodes.val ∧
      (∀ L, AigWF aig.nodes.val L → AigWF p.2.nodes.val L) ∧
      p.1.1.val.length = a.val.length ∧
      (∀ l ∈ p.1.1.val, l.node.val < p.2.nodes.val.length) ∧
      p.1.2.node.val < p.2.nodes.val.length ∧
      (∀ inp : List Bool,
        pEvalLit (pSim inp p.2.nodes.val) p.1.2
          = pSubCarry (wordVals (pSim inp aig.nodes.val) a.val)
              (wordVals (pSim inp aig.nodes.val) b.val) a.val.length) ∧
      (∀ (inp : List Bool) (t : Nat), t < a.val.length →
        pEvalLit (pSim inp p.2.nodes.val) (p.1.1.val.getD t dLit)
          = pSubBit (wordVals (pSim inp aig.nodes.val) a.val)
              (wordVals (pSim inp aig.nodes.val) b.val) t) ⦄ := by
  unfold sub_with_uge
  step with lit_true_spec as ⟨cin, hcin⟩
  simp only [hcin]
  have hlen : (Slice.len a).val = a.val.length := by scalar_tac
  have hcr : ({ node := 0#usize, neg := true } : Lit).node.val
      < aig.nodes.val.length := by scalar_tac
  have hcv : ∀ inp : List Bool,
      pEvalLit (pSim inp aig.nodes.val)
        ({ node := 0#usize, neg := true } : Lit) = true := fun inp =>
    pEvalLit_node_zero hne h0 inp true
  step with (sub_with_uge_loop_spec aig a b _ (Slice.len a) hlen hab hcap
    ha hb hcr hcv) as ⟨aig1, carry1, diff, hinv⟩
  obtain ⟨_, hlen1, hpre1, hwf1, hdlen, hdrng, hcrng, hcsem, hdsem⟩ := hinv
  exact ⟨by omega, hpre1, hwf1, hdlen, hdrng, hcrng, hcsem, hdsem⟩

/- ══════════ NUMERIC BRIDGE FOR THE SUBTRACTOR (core `BitVec.carry`) ══════════ -/

/-- The pure subtract carry chain coincides with core's numeric
    `BitVec.carry` of `X + ~~~Y + 1` on denoting Boolean words. -/
theorem pSubCarry_eq_carry {x y : List Bool} {w : Nat} {X Y : BitVec w}
    (hx : DenotesBits x X) (hy : DenotesBits y Y) :
    ∀ i, i ≤ w → pSubCarry x y i = BitVec.carry i X (~~~Y) true := by
  intro i
  induction i with
  | zero =>
    intro _
    simp [pSubCarry]
  | succ i ih =>
    intro hi
    rw [BitVec.carry_succ, pSubCarry, hx.2 i, hy.2 i, ih (by omega),
      BitVec.getLsbD_not]
    simp [show i < w by omega]

/-- **The borrow characterization**: the final carry of `x + !y + 1` is
    `true` iff `Y ≤ X` — `sub_with_uge`'s `uge` flag
    (via `BitVec.ult_eq_not_carry`). -/
theorem pSubCarry_last {x y : List Bool} {w : Nat} {X Y : BitVec w}
    (hx : DenotesBits x X) (hy : DenotesBits y Y) :
    pSubCarry x y w = decide (Y.toNat ≤ X.toNat) := by
  rw [pSubCarry_eq_carry hx hy w (Nat.le_refl w)]
  have h := BitVec.ult_eq_not_carry X Y
  rw [BitVec.ult_eq_decide_lt] at h
  have h2 : BitVec.carry w X (~~~Y) true = !decide (X < Y) := by
    rw [h, Bool.not_not]
  have h3 : (X < Y) ↔ X.toNat < Y.toNat := BitVec.lt_def
  by_cases hc : X.toNat < Y.toNat
  · rw [h2, decide_eq_true (h3.mpr hc), decide_eq_false (by omega)]
    rfl
  · rw [h2, decide_eq_false (fun hxy => hc (h3.mp hxy)),
      decide_eq_true (by omega : Y.toNat ≤ X.toNat)]
    rfl

/-- The pure difference bits read `X - Y` on denoting words. -/
theorem pSubBit_eq_sub {x y : List Bool} {w : Nat} {X Y : BitVec w}
    (hx : DenotesBits x X) (hy : DenotesBits y Y) {t : Nat} (ht : t < w) :
    pSubBit x y t = (X - Y).getLsbD t := by
  rw [getLsbD_sub_carry X Y ht]
  unfold pSubBit
  rw [hx.2 t, hy.2 t, pSubCarry_eq_carry hx hy t (by omega),
    BitVec.getLsbD_not]
  simp [ht]

/- ══════════════════ SMALL `getD` HELPERS ══════════════════ -/

theorem rangeMap_getD (f : Nat → Bool) {w t : Nat} (ht : t < w) :
    ((List.range w).map f).getD t false = f t := by
  have h : t < ((List.range w).map f).length := by simp [ht]
  rw [getD_eq_getElem_of_lt h false]
  simp

theorem getD_take_of_lt {α : Type} (l : List α) {n t : Nat} (ht : t < n)
    (d : α) : (l.take n).getD t d = l.getD t d := by
  rw [List.getD_eq_getElem?_getD, List.getD_eq_getElem?_getD,
    List.getElem?_take_of_lt ht]

/-- Turn a `getD`-indexed property into a membership property. -/
theorem forall_mem_of_getD {α : Type} {P : α → Prop} {l : List α} {d : α}
    (h : ∀ t : Nat, t < l.length → P (l.getD t d)) : ∀ x ∈ l, P x := by
  intro x hx
  obtain ⟨t, ht, heq⟩ := List.mem_iff_getElem.mp hx
  rw [← heq, ← getD_eq_getElem_of_lt ht d]
  exact h t ht

/- ══════════════════ THE PURE DIVIDER MODEL ══════════════════ -/

/-- The shifted remainder word entering step `k` (only used for `w ≥ 1`):
    dividend bit `w-1-k` at the bottom, previous remainder bits shifted up
    one position, the top bit dropped (it is `pDivGeStep`'s `top`). -/
def pDivShift (pa : List Bool) (w k : Nat) (r : List Bool) : List Bool :=
  pa.getD (w - 1 - k) false :: r.take (w - 1)

/-- The step's subtract decision: the shifted-out top bit — which alone
    settles the conceptual (w+1)-bit compare — OR the no-borrow flag of the
    w-bit compare (the w-bit trick). -/
def pDivGeStep (pb : List Bool) (w : Nat) (r s : List Bool) : Bool :=
  r.getD (w - 1) false || pSubCarry s pb w

/-- Remainder word after `k` restoring steps (length `w`). -/
def pDivRem (pa pb : List Bool) (w : Nat) : Nat → List Bool
  | 0 => List.replicate w false
  | k + 1 =>
    let r := pDivRem pa pb w k
    let s := pDivShift pa w k r
    let ge := pDivGeStep pb w r s
    (List.range w).map (fun m => if ge then pSubBit s pb m else s.getD m false)

/-- The `ge` bit emitted at step `k` — the quotient bit at position
    `w-1-k`. -/
def pDivGe (pa pb : List Bool) (w k : Nat) : Bool :=
  pDivGeStep pb w (pDivRem pa pb w k)
    (pDivShift pa w k (pDivRem pa pb w k))

@[simp]
theorem pDivRem_length (pa pb : List Bool) (w k : Nat) :
    (pDivRem pa pb w k).length = w := by
  cases k <;> simp [pDivRem]

theorem pDivRem_succ (pa pb : List Bool) (w k : Nat) :
    pDivRem pa pb w (k + 1)
      = (List.range w).map (fun m =>
          if pDivGe pa pb w k
          then pSubBit (pDivShift pa w k (pDivRem pa pb w k)) pb m
          else (pDivShift pa w k (pDivRem pa pb w k)).getD m false) := rfl

theorem pDivShift_length {pa : List Bool} {w k : Nat} {r : List Bool}
    (hr : r.length = w) (hw : 0 < w) :
    (pDivShift pa w k r).length = w := by
  simp [pDivShift, hr]
  omega

/- ══════════════════ GATE COUNTING ══════════════════ -/

/-- Exact gate count of the first `k` outer steps: `12·w + 1` gates per
    step (9·w subtract + 1 or + 3·w restore mux). -/
def divGates (w : Nat) : Nat → Nat
  | 0 => 0
  | k + 1 => divGates w k + (12 * w + 1)

theorem divGates_mono (w : Nat) {j k : Nat} (h : j ≤ k) :
    divGates w j ≤ divGates w k := by
  induction k with
  | zero =>
    have : j = 0 := by omega
    subst this
    exact Nat.le_refl _
  | succ k ih =>
    by_cases hj : j = k + 1
    · subst hj
      exact Nat.le_refl _
    · have h1 := ih (by omega)
      have h2 : divGates w (k + 1) = divGates w k + (12 * w + 1) := rfl
      omega

theorem divGates_eq (w : Nat) : ∀ k, divGates w k = (12 * w + 1) * k := by
  intro k
  induction k with
  | zero => simp [divGates]
  | succ k ih =>
    have h : divGates w (k + 1) = divGates w k + (12 * w + 1) := rfl
    rw [h, ih, Nat.mul_succ]

/- ══════════════════ THE INIT LOOP (no gates) ══════════════════ -/

/-- First `blast_udivrem` loop: seeds remainder AND quotient with `w`
    copies of `lit_false` (no gates). -/
theorem blast_udivrem_loop0_spec (w : Std.Usize) :
    blast_udivrem_loop0 w (alloc.vec.Vec.new Lit) (alloc.vec.Vec.new Lit)
      0#usize ⦃ r =>
      r.1.val = List.replicate w.val dLit ∧
      r.2.val = List.replicate w.val dLit ⦄ := by
  unfold blast_udivrem_loop0
  apply loop.spec_decr_nat
    (measure := fun (s : alloc.vec.Vec Lit × alloc.vec.Vec Lit × Std.Usize)
      => w.val - s.2.2.val)
    (inv := fun (s : alloc.vec.Vec Lit × alloc.vec.Vec Lit × Std.Usize) =>
      s.2.2.val ≤ w.val ∧ s.1.val = List.replicate s.2.2.val dLit ∧
      s.2.1.val = List.replicate s.2.2.val dLit)
  · rintro ⟨rem1, quo1, k⟩ ⟨hle, hrval, hqval⟩
    dsimp only at hle hrval hqval
    unfold blast_udivrem_loop0.body
    dsimp only
    split
    · rename_i hlt
      step with lit_false_spec as ⟨l, hl⟩
      have hrcap : rem1.val.length < Usize.max := by
        rw [hrval]
        simp only [List.length_replicate]
        scalar_tac
      step as ⟨rem2, hrem2⟩
      have hqcap : quo1.val.length < Usize.max := by
        rw [hqval]
        simp only [List.length_replicate]
        scalar_tac
      step as ⟨quo2, hquo2⟩
      step as ⟨k1, hk1⟩
      refine ⟨by scalar_tac, ?_, ?_, by scalar_tac⟩
      · rw [hk1, hrem2, hrval, hl, List.replicate_succ']
        rfl
      · rw [hk1, hquo2, hqval, hl, List.replicate_succ']
        rfl
    · rename_i hge
      have hkeq : k.val = w.val := by scalar_tac
      rw [← hkeq]
      exact ⟨hrval, hqval⟩
  · exact ⟨by scalar_tac, by simp, by simp⟩

/- ══════════════════ THE SHIFT LOOP (gate-free) ══════════════════ -/

/-- The in-place left-shift loop `for j in (1..=j0).rev(): rem[j] :=
    rem[j-1]`: pure `Vec` permutation, no gates. Positions `1..=j0` take
    their left neighbour's literal, position 0 and positions above `j0`
    are untouched. -/
theorem udivrem_shift_loop_spec (rem : alloc.vec.Vec Lit) (j : Std.Usize)
    (hj : j.val < rem.val.length) :
    blast_udivrem_loop1_loop0 rem j ⦃ r =>
      r.val.length = rem.val.length ∧
      (∀ t : Nat, t = 0 ∨ j.val < t →
        r.val.getD t dLit = rem.val.getD t dLit) ∧
      (∀ t : Nat, 1 ≤ t → t ≤ j.val →
        r.val.getD t dLit = rem.val.getD (t - 1) dLit) ⦄ := by
  unfold blast_udivrem_loop1_loop0
  apply loop.spec_decr_nat
    (measure := fun (s : alloc.vec.Vec Lit × Std.Usize) => s.2.val)
    (inv := fun (s : alloc.vec.Vec Lit × Std.Usize) =>
      s.2.val ≤ j.val ∧ s.1.val.length = rem.val.length ∧
      (∀ t : Nat, t ≤ s.2.val → s.1.val.getD t dLit = rem.val.getD t dLit) ∧
      (∀ t : Nat, s.2.val < t → t ≤ j.val →
        s.1.val.getD t dLit = rem.val.getD (t - 1) dLit) ∧
      (∀ t : Nat, j.val < t → s.1.val.getD t dLit = rem.val.getD t dLit))
  · rintro ⟨rem1, j1⟩ ⟨hj1le, hlen1, hlow, hmid, hhigh⟩
    dsimp only at hj1le hlen1 hlow hmid hhigh
    unfold blast_udivrem_loop1_loop0.body
    dsimp only
    split
    · rename_i hpos
      have hj1pos : 0 < j1.val := by scalar_tac
      step as ⟨i, hi⟩
      have hiv : i.val = j1.val - 1 := by scalar_tac
      have hilt : i.val < rem1.val.length := by omega
      step as ⟨l, hl⟩
      have hj1lt : j1.val < rem1.val.length := by omega
      step as ⟨old, back, hold, hback⟩
      rw [hback]
      refine ⟨by omega, ?_, ?_, ?_, ?_, by omega⟩
      · simp only [alloc.vec.Vec.set_val_eq, List.length_set]
        exact hlen1
      · -- positions at or below the new index: untouched
        intro t ht
        simp only [alloc.vec.Vec.set_val_eq]
        rw [List.getD_eq_getElem?_getD,
          List.getElem?_set_ne (show j1.val ≠ t by omega),
          ← List.getD_eq_getElem?_getD]
        exact hlow t (by omega)
      · -- positions in (i, j0]: shifted
        intro t ht1 ht2
        simp only [alloc.vec.Vec.set_val_eq]
        by_cases hteq : t = j1.val
        · subst hteq
          rw [List.getD_eq_getElem?_getD, List.getElem?_set_self (by omega),
            Option.getD_some, hl, ← getD_eq_getElem_of_lt hilt dLit,
            hlow i.val (by omega), hiv]
        · rw [List.getD_eq_getElem?_getD,
            List.getElem?_set_ne (show j1.val ≠ t by omega),
            ← List.getD_eq_getElem?_getD]
          exact hmid t (by omega) ht2
      · -- positions above j0: untouched
        intro t ht
        simp only [alloc.vec.Vec.set_val_eq]
        rw [List.getD_eq_getElem?_getD,
          List.getElem?_set_ne (show j1.val ≠ t by omega),
          ← List.getD_eq_getElem?_getD]
        exact hhigh t ht
    · rename_i hz
      have hj1z : j1.val = 0 := by scalar_tac
      refine ⟨hlen1, ?_, ?_⟩
      · intro t ht
        rcases ht with h | h
        · exact hlow t (by omega)
        · exact hhigh t h
      · intro t ht1 ht2
        exact hmid t (by omega) ht2
  · dsimp only
    exact ⟨Nat.le_refl _, rfl, fun t _ => rfl,
      fun t h1 h2 => by omega, fun t _ => rfl⟩

/- ══════════════════ THE RESTORE-MUX LOOP ══════════════════ -/

/-- Loop invariant of the restoring mux pass after `m` processed bits:
    3 gates per bit, unprocessed entries still hold their ORIGINAL
    literals, processed entry `t` evaluates to `ge ? diff[t] : rem[t]`
    (values under the loop-pre aig). -/
def RestoreInv (aigM : Aig) (rem diff : alloc.vec.Vec Lit) (ge : Lit)
    (aig1 : Aig) (rem1 : alloc.vec.Vec Lit) (m : Nat) : Prop :=
  m ≤ rem.val.length ∧
  aig1.nodes.val.length = aigM.nodes.val.length + 3 * m ∧
  aigM.nodes.val <+: aig1.nodes.val ∧
  (∀ L, AigWF aigM.nodes.val L → AigWF aig1.nodes.val L) ∧
  rem1.val.length = rem.val.length ∧
  (∀ l ∈ rem1.val, l.node.val < aig1.nodes.val.length) ∧
  (∀ t : Nat, m ≤ t → rem1.val.getD t dLit = rem.val.getD t dLit) ∧
  (∀ (inp : List Bool) (t : Nat), t < m →
    pEvalLit (pSim inp aig1.nodes.val) (rem1.val.getD t dLit)
      = if pEvalLit (pSim inp aigM.nodes.val) ge
        then pEvalLit (pSim inp aigM.nodes.val) (diff.val.getD t dLit)
        else pEvalLit (pSim inp aigM.nodes.val) (rem.val.getD t dLit))

/-- **Spec of the restore-mux loop** (3·w gates): every remainder entry
    becomes `ge ? diff[t] : rem[t]`. -/
theorem udivrem_restore_loop_spec (aigM : Aig) (w : Std.Usize)
    (rem diff : alloc.vec.Vec Lit) (ge : Lit)
    (hw : w.val = rem.val.length)
    (hdw : rem.val.length ≤ diff.val.length)
    (hcap : aigM.nodes.val.length + 3 * rem.val.length ≤ Usize.max)
    (hrem : ∀ l ∈ rem.val, l.node.val < aigM.nodes.val.length)
    (hdiff : ∀ l ∈ diff.val, l.node.val < aigM.nodes.val.length)
    (hge : ge.node.val < aigM.nodes.val.length) :
    blast_udivrem_loop1_loop1 aigM w rem diff ge 0#usize ⦃ q =>
      q.1.nodes.val.length = aigM.nodes.val.length + 3 * rem.val.length ∧
      aigM.nodes.val <+: q.1.nodes.val ∧
      (∀ L, AigWF aigM.nodes.val L → AigWF q.1.nodes.val L) ∧
      q.2.val.length = rem.val.length ∧
      (∀ l ∈ q.2.val, l.node.val < q.1.nodes.val.length) ∧
      ∀ (inp : List Bool) (t : Nat), t < rem.val.length →
        pEvalLit (pSim inp q.1.nodes.val) (q.2.val.getD t dLit)
          = if pEvalLit (pSim inp aigM.nodes.val) ge
            then pEvalLit (pSim inp aigM.nodes.val) (diff.val.getD t dLit)
            else pEvalLit (pSim inp aigM.nodes.val)
              (rem.val.getD t dLit) ⦄ := by
  unfold blast_udivrem_loop1_loop1
  apply loop.spec_decr_nat
    (measure := fun (s : Aig × alloc.vec.Vec Lit × Std.Usize) =>
      rem.val.length - s.2.2.val)
    (inv := fun (s : Aig × alloc.vec.Vec Lit × Std.Usize) =>
      RestoreInv aigM rem diff ge s.1 s.2.1 s.2.2.val)
  · rintro ⟨aig1, rem1, m⟩ hinv
    obtain ⟨hmle, hlen1, hpre1, hwf1, hrlen, hrrng, hunt, hsem⟩ := hinv
    dsimp only at hmle hlen1 hpre1 hwf1 hrlen hrrng hunt hsem
    unfold blast_udivrem_loop1_loop1.body
    dsimp only
    split
    · rename_i hlt
      have hmr : m.val < rem.val.length := by scalar_tac
      have hmd : m.val < diff.val.length := by omega
      step as ⟨l, hl⟩
      have hmr1 : m.val < rem1.val.length := by omega
      step as ⟨l1, hl1⟩
      have hl' : l.node.val < aig1.nodes.val.length := by
        have h1 := hdiff l (by rw [hl]; exact List.getElem_mem _)
        have h2 := hpre1.length_le
        omega
      have hl1mem : l1 = rem.val[m.val]'hmr := by
        rw [hl1, ← getD_eq_getElem_of_lt hmr1 dLit, hunt m.val (Nat.le_refl _),
          getD_eq_getElem_of_lt hmr dLit]
      have hl1' : l1.node.val < aig1.nodes.val.length := by
        have h1 := hrem l1 (by rw [hl1mem]; exact List.getElem_mem _)
        have h2 := hpre1.length_le
        omega
      have hge1 : ge.node.val < aig1.nodes.val.length := by
        have h2 := hpre1.length_le
        omega
      step with (push_mux_gadget aig1 ge l l1 (by omega) hge1 hl' hl1') as
        ⟨sel, aig2, hg1, hg2, hg3, hg4, hg5⟩
      step as ⟨old, back, hold, hback⟩
      step as ⟨m1, hm1⟩
      rw [hback]
      refine ⟨?_, by scalar_tac⟩
      rw [hm1]
      refine ⟨by omega, by omega, hpre1.trans hg2,
        fun L hL => hg4 L (hwf1 L hL), ?_, ?_, ?_, ?_⟩
      · simp only [alloc.vec.Vec.set_val_eq, List.length_set]
        exact hrlen
      · intro x hx
        simp only [alloc.vec.Vec.set_val_eq] at hx
        rcases List.mem_or_eq_of_mem_set hx with h' | h'
        · have h1 := hrrng x h'
          omega
        · subst h'
          exact hg3
      · intro t ht
        simp only [alloc.vec.Vec.set_val_eq]
        rw [List.getD_eq_getElem?_getD,
          List.getElem?_set_ne (show m.val ≠ t by omega),
          ← List.getD_eq_getElem?_getD]
        exact hunt t (by omega)
      · intro inp t ht
        simp only [alloc.vec.Vec.set_val_eq]
        by_cases hteq : t = m.val
        · subst hteq
          rw [List.getD_eq_getElem?_getD, List.getElem?_set_self (by omega),
            Option.getD_some, hg5 inp,
            pEvalLit_stable hpre1 ge hge inp, hl,
            pEvalLit_stable hpre1 _ (hdiff _ (List.getElem_mem hmd)) inp,
            hl1mem, pEvalLit_stable hpre1 _ (hrem _ (List.getElem_mem hmr))
              inp, ← getD_eq_getElem_of_lt hmd dLit,
            ← getD_eq_getElem_of_lt hmr dLit]
        · rw [List.getD_eq_getElem?_getD,
            List.getElem?_set_ne (show m.val ≠ t by omega),
            ← List.getD_eq_getElem?_getD]
          have htr : t < rem1.val.length := by omega
          rw [getD_eq_getElem_of_lt htr dLit,
            pEvalLit_stable hg2 _ (hrrng _ (List.getElem_mem _)) inp,
            ← getD_eq_getElem_of_lt htr dLit]
          exact hsem inp t (by omega)
    · rename_i hge'
      have hmeq : m.val = rem.val.length := by scalar_tac
      refine ⟨by dsimp only; omega, hpre1, hwf1, by dsimp only; omega,
        hrrng, ?_⟩
      dsimp only
      intro inp t ht
      exact hsem inp t (by omega)
  · dsimp only
    refine ⟨Nat.zero_le _, by scalar_tac, List.prefix_refl _, fun _ h => h,
      rfl, hrem, fun t _ => rfl, ?_⟩
    intro inp t ht
    scalar_tac

/- ══════════════════ THE `nz` OR-FOLD (b == 0 detector) ══════════════════ -/

/-- **Spec of the `nz` OR-fold loop** (w gates): the returned literal
    evaluates to the OR of `b[0..w)` — `pHigh … 0 w`, the `out_of_range`
    fold at `s = 0`. -/
theorem udivrem_nz_loop_spec (aig : Aig) (b : Slice Lit) (w : Std.Usize)
    (nz : Lit)
    (hwb : w.val ≤ b.val.length)
    (hcap : aig.nodes.val.length + w.val ≤ Usize.max)
    (hb : ∀ l ∈ b.val, l.node.val < aig.nodes.val.length)
    (hnzr : nz.node.val < aig.nodes.val.length)
    (hnzv : ∀ inp : List Bool,
      pEvalLit (pSim inp aig.nodes.val) nz = false) :
    blast_udivrem_loop2 aig b w nz 0#usize ⦃ q =>
      q.1.nodes.val.length = aig.nodes.val.length + w.val ∧
      aig.nodes.val <+: q.1.nodes.val ∧
      (∀ L, AigWF aig.nodes.val L → AigWF q.1.nodes.val L) ∧
      q.2.node.val < q.1.nodes.val.length ∧
      ∀ inp : List Bool,
        pEvalLit (pSim inp q.1.nodes.val) q.2
          = pHigh (pSim inp aig.nodes.val) b.val 0 w.val ⦄ := by
  unfold blast_udivrem_loop2
  apply loop.spec_decr_nat
    (measure := fun (s : Aig × Lit × Std.Usize) => w.val - s.2.2.val)
    (inv := fun (s : Aig × Lit × Std.Usize) =>
      s.2.2.val ≤ w.val ∧
      s.1.nodes.val.length = aig.nodes.val.length + s.2.2.val ∧
      aig.nodes.val <+: s.1.nodes.val ∧
      (∀ L, AigWF aig.nodes.val L → AigWF s.1.nodes.val L) ∧
      s.2.1.node.val < s.1.nodes.val.length ∧
      ∀ inp : List Bool,
        pEvalLit (pSim inp s.1.nodes.val) s.2.1
          = pHigh (pSim inp aig.nodes.val) b.val 0 s.2.2.val)
  · rintro ⟨aig1, nz1, n⟩ hinv
    obtain ⟨hnle, hlen1, hpre1, hwf1, hnrng, hsem⟩ := hinv
    dsimp only at hnle hlen1 hpre1 hwf1 hnrng hsem
    unfold blast_udivrem_loop2.body
    dsimp only
    split
    · rename_i hlt
      have hnw : n.val < w.val := by scalar_tac
      have hnb : n.val < b.val.length := by omega
      step as ⟨l, hl⟩
      have hl' : l.node.val < aig1.nodes.val.length := by
        have h1 := hb l (by rw [hl]; exact List.getElem_mem _)
        have h2 := hpre1.length_le
        omega
      step with (push_or_gadget aig1 nz1 l (by omega) hnrng hl') as
        ⟨nz2, aig2, hg1, hg2, hg3, hg4, hg5⟩
      step as ⟨n1, hn1⟩
      refine ⟨by scalar_tac, by scalar_tac, hpre1.trans hg2,
        fun L hL => hg4 L (hwf1 L hL), hg3, ?_, by scalar_tac⟩
      intro inp
      rw [hn1, hg5 inp, hsem inp, hl,
        pEvalLit_stable hpre1 _ (hb _ (List.getElem_mem hnb)) inp]
      simp only [pHigh, getD_eq_getElem_of_lt hnb, Nat.zero_le,
        decide_eq_true, Bool.true_and]
    · rename_i hge
      have hneq : n.val = w.val := by scalar_tac
      rw [hneq] at hlen1 hsem
      exact ⟨hlen1, hpre1, hwf1, hnrng, hsem⟩
  · dsimp only
    refine ⟨by scalar_tac, by scalar_tac, List.prefix_refl _, fun _ h => h,
      hnzr, ?_⟩
    intro inp
    rw [hnzv inp]
    rfl

/- ══════════════════ THE TWO FINAL `/0` MUX LOOPS ══════════════════ -/

/-- **Spec of the quotient `/0` mux loop** (3·w gates): output bit `j` is
    `b_zero ? t : quo[j]` (values under the loop-pre aig). -/
theorem udivrem_quo_mux_spec (aig : Aig) (w : Std.Usize)
    (quo : alloc.vec.Vec Lit) (b_zero t : Lit)
    (hw : w.val ≤ quo.val.length)
    (hcap : aig.nodes.val.length + 3 * w.val ≤ Usize.max)
    (hq : ∀ l ∈ quo.val, l.node.val < aig.nodes.val.length)
    (hbz : b_zero.node.val < aig.nodes.val.length)
    (ht : t.node.val < aig.nodes.val.length) :
    blast_udivrem_loop3 aig w quo b_zero t (alloc.vec.Vec.new Lit)
      0#usize ⦃ q =>
      q.1.nodes.val.length = aig.nodes.val.length + 3 * w.val ∧
      aig.nodes.val <+: q.1.nodes.val ∧
      (∀ L, AigWF aig.nodes.val L → AigWF q.1.nodes.val L) ∧
      q.2.val.length = w.val ∧
      (∀ l ∈ q.2.val, l.node.val < q.1.nodes.val.length) ∧
      ∀ (inp : List Bool) (j : Nat), j < q.2.val.length →
        pEvalLit (pSim inp q.1.nodes.val) (q.2.val.getD j dLit)
          = if pEvalLit (pSim inp aig.nodes.val) b_zero
            then pEvalLit (pSim inp aig.nodes.val) t
            else pEvalLit (pSim inp aig.nodes.val)
              (quo.val.getD j dLit) ⦄ := by
  unfold blast_udivrem_loop3
  apply loop.spec_decr_nat
    (measure := fun (s : Aig × alloc.vec.Vec Lit × Std.Usize) =>
      w.val - s.2.2.val)
    (inv := fun (s : Aig × alloc.vec.Vec Lit × Std.Usize) =>
      MuxMapInv aig w.val
        (fun inp j =>
          if pEvalLit (pSim inp aig.nodes.val) b_zero
          then pEvalLit (pSim inp aig.nodes.val) t
          else pEvalLit (pSim inp aig.nodes.val) (quo.val.getD j dLit))
        s.1 s.2.1 s.2.2.val)
  · rintro ⟨aig1, out1, q⟩ hinv
    obtain ⟨hile, hlen1, hpre1, hwf1, holen, horng, hsem⟩ := hinv
    dsimp only at hile hlen1 hpre1 hwf1 holen horng hsem
    unfold blast_udivrem_loop3.body
    dsimp only
    split
    · rename_i hlt
      have hqw : q.val < w.val := by scalar_tac
      have hqq : q.val < quo.val.length := by omega
      step as ⟨l, hl⟩
      have hl' : l.node.val < aig1.nodes.val.length := by
        have h1 := hq l (by rw [hl]; exact List.getElem_mem _)
        have h2 := hpre1.length_le
        omega
      have hbz1 : b_zero.node.val < aig1.nodes.val.length := by
        have h2 := hpre1.length_le
        omega
      have ht1 : t.node.val < aig1.nodes.val.length := by
        have h2 := hpre1.length_le
        omega
      step with (push_mux_gadget aig1 b_zero t l (by omega) hbz1 ht1 hl')
        as ⟨sel, aig2, hg1, hg2, hg3, hg4, hg5⟩
      have hocap : out1.val.length < Usize.max := by
        have := quo.len_ineq
        omega
      step as ⟨out2, hout2⟩
      step as ⟨q1, hq1⟩
      refine ⟨?_, by scalar_tac⟩
      rw [hq1]
      apply MuxMapInv.step ⟨hile, hlen1, hpre1, hwf1, holen, horng, hsem⟩
        hqw hg1 hg2 hg3 hg4 ?_ hout2
      intro inp
      rw [hg5 inp, pEvalLit_stable hpre1 b_zero hbz inp,
        pEvalLit_stable hpre1 t ht inp, hl,
        pEvalLit_stable hpre1 _ (hq _ (List.getElem_mem hqq)) inp,
        ← getD_eq_getElem_of_lt hqq dLit]
    · rename_i hge
      have hqeq : q.val = w.val := by scalar_tac
      rw [hqeq] at hlen1 holen
      refine ⟨hlen1, hpre1, hwf1, holen, horng, ?_⟩
      intro inp j hj
      rw [getD_eq_getElem_of_lt hj dLit]
      exact hsem inp j hj
  · exact MuxMapInv.init aig w.val _

/-- **Spec of the remainder `/0` mux loop** (3·w gates): output bit `j` is
    `b_zero ? a[j] : rem[j]` (values under the loop-pre aig). -/
theorem udivrem_rem_mux_spec (aig : Aig) (a : Slice Lit) (w : Std.Usize)
    (rem : alloc.vec.Vec Lit) (b_zero : Lit)
    (hwa : w.val ≤ a.val.length)
    (hwr : w.val ≤ rem.val.length)
    (hcap : aig.nodes.val.length + 3 * w.val ≤ Usize.max)
    (ha : ∀ l ∈ a.val, l.node.val < aig.nodes.val.length)
    (hrem : ∀ l ∈ rem.val, l.node.val < aig.nodes.val.length)
    (hbz : b_zero.node.val < aig.nodes.val.length) :
    blast_udivrem_loop4 aig a w rem b_zero (alloc.vec.Vec.new Lit)
      0#usize ⦃ q =>
      q.1.nodes.val.length = aig.nodes.val.length + 3 * w.val ∧
      aig.nodes.val <+: q.1.nodes.val ∧
      (∀ L, AigWF aig.nodes.val L → AigWF q.1.nodes.val L) ∧
      q.2.val.length = w.val ∧
      (∀ l ∈ q.2.val, l.node.val < q.1.nodes.val.length) ∧
      ∀ (inp : List Bool) (j : Nat), j < q.2.val.length →
        pEvalLit (pSim inp q.1.nodes.val) (q.2.val.getD j dLit)
          = if pEvalLit (pSim inp aig.nodes.val) b_zero
            then pEvalLit (pSim inp aig.nodes.val) (a.val.getD j dLit)
            else pEvalLit (pSim inp aig.nodes.val)
              (rem.val.getD j dLit) ⦄ := by
  unfold blast_udivrem_loop4
  apply loop.spec_decr_nat
    (measure := fun (s : Aig × alloc.vec.Vec Lit × Std.Usize) =>
      w.val - s.2.2.val)
    (inv := fun (s : Aig × alloc.vec.Vec Lit × Std.Usize) =>
      MuxMapInv aig w.val
        (fun inp j =>
          if pEvalLit (pSim inp aig.nodes.val) b_zero
          then pEvalLit (pSim inp aig.nodes.val) (a.val.getD j dLit)
          else pEvalLit (pSim inp aig.nodes.val) (rem.val.getD j dLit))
        s.1 s.2.1 s.2.2.val)
  · rintro ⟨aig1, out1, r⟩ hinv
    obtain ⟨hile, hlen1, hpre1, hwf1, holen, horng, hsem⟩ := hinv
    dsimp only at hile hlen1 hpre1 hwf1 holen horng hsem
    unfold blast_udivrem_loop4.body
    dsimp only
    split
    · rename_i hlt
      have hrw : r.val < w.val := by scalar_tac
      have hra : r.val < a.val.length := by omega
      have hrr : r.val < rem.val.length := by omega
      step as ⟨l, hl⟩
      step as ⟨l1, hl1⟩
      have hl' : l.node.val < aig1.nodes.val.length := by
        have h1 := ha l (by rw [hl]; exact List.getElem_mem _)
        have h2 := hpre1.length_le
        omega
      have hl1' : l1.node.val < aig1.nodes.val.length := by
        have h1 := hrem l1 (by rw [hl1]; exact List.getElem_mem _)
        have h2 := hpre1.length_le
        omega
      have hbz1 : b_zero.node.val < aig1.nodes.val.length := by
        have h2 := hpre1.length_le
        omega
      step with (push_mux_gadget aig1 b_zero l l1 (by omega) hbz1 hl' hl1')
        as ⟨sel, aig2, hg1, hg2, hg3, hg4, hg5⟩
      have hocap : out1.val.length < Usize.max := by
        have := a.length_ineq
        omega
      step as ⟨out2, hout2⟩
      step as ⟨r1, hr1⟩
      refine ⟨?_, by scalar_tac⟩
      rw [hr1]
      apply MuxMapInv.step ⟨hile, hlen1, hpre1, hwf1, holen, horng, hsem⟩
        hrw hg1 hg2 hg3 hg4 ?_ hout2
      intro inp
      rw [hg5 inp, pEvalLit_stable hpre1 b_zero hbz inp, hl,
        pEvalLit_stable hpre1 _ (ha _ (List.getElem_mem hra)) inp, hl1,
        pEvalLit_stable hpre1 _ (hrem _ (List.getElem_mem hrr)) inp,
        ← getD_eq_getElem_of_lt hra dLit, ← getD_eq_getElem_of_lt hrr dLit]
    · rename_i hge
      have hreq : r.val = w.val := by scalar_tac
      rw [hreq] at hlen1 holen
      refine ⟨hlen1, hpre1, hwf1, holen, horng, ?_⟩
      intro inp j hj
      rw [getD_eq_getElem_of_lt hj dLit]
      exact hsem inp j hj
  · exact MuxMapInv.init aig w.val _

/- ══════════════════ THE OUTER (STEP) LOOP ══════════════════ -/

/-- Outer-loop invariant after `k` restoring steps: `divGates w k` gates
    appended, nothing existing touched, remainder bit `t` evaluates — under
    the CURRENT aig — to bit `t` of the pure remainder `pDivRem … k`, and
    every already-assigned quotient bit `t ≥ w-k` to the emitted `ge` bit
    `pDivGe … (w-1-t)` (operand values read under the ORIGINAL aig). -/
def DivInv (aig : Aig) (a b : Slice Lit) (aig1 : Aig)
    (rem1 quo1 : alloc.vec.Vec Lit) (k : Nat) : Prop :=
  k ≤ a.val.length ∧
  aig1.nodes.val.length
    = aig.nodes.val.length + divGates a.val.length k ∧
  aig.nodes.val <+: aig1.nodes.val ∧
  (∀ L, AigWF aig.nodes.val L → AigWF aig1.nodes.val L) ∧
  rem1.val.length = a.val.length ∧
  quo1.val.length = a.val.length ∧
  (∀ l ∈ rem1.val, l.node.val < aig1.nodes.val.length) ∧
  (∀ l ∈ quo1.val, l.node.val < aig1.nodes.val.length) ∧
  (∀ (inp : List Bool) (t : Nat), t < a.val.length →
    pEvalLit (pSim inp aig1.nodes.val) (rem1.val.getD t dLit)
      = (pDivRem (wordVals (pSim inp aig.nodes.val) a.val)
          (wordVals (pSim inp aig.nodes.val) b.val)
          a.val.length k).getD t false) ∧
  (∀ (inp : List Bool) (t : Nat), a.val.length - k ≤ t →
    t < a.val.length →
    pEvalLit (pSim inp aig1.nodes.val) (quo1.val.getD t dLit)
      = pDivGe (wordVals (pSim inp aig.nodes.val) a.val)
          (wordVals (pSim inp aig.nodes.val) b.val) a.val.length
          (a.val.length - 1 - t))

/-- **Outer loop spec**: after all `w` restoring steps the remainder word
    denotes `pDivRem … w` and the quotient word spells the `ge` bits. -/
theorem blast_udivrem_loop1_spec (aig : Aig) (a b : Slice Lit)
    (w : Std.Usize) (rem quo : alloc.vec.Vec Lit)
    (hw : w.val = a.val.length)
    (hab : a.val.length ≤ b.val.length)
    (hcap : aig.nodes.val.length + divGates a.val.length a.val.length
      ≤ Usize.max)
    (ha : ∀ l ∈ a.val, l.node.val < aig.nodes.val.length)
    (hb : ∀ l ∈ b.val, l.node.val < aig.nodes.val.length)
    (hne : 0 < aig.nodes.val.length)
    (h0 : aig.nodes.val[0]'hne = Node.False)
    (hrem : rem.val = List.replicate a.val.length dLit)
    (hquo : quo.val = List.replicate a.val.length dLit) :
    blast_udivrem_loop1 aig a b w rem quo 0#usize ⦃ q =>
      DivInv aig a b q.1 q.2.1 q.2.2 a.val.length ⦄ := by
  unfold blast_udivrem_loop1
  apply loop.spec_decr_nat
    (measure := fun
      (s : Aig × alloc.vec.Vec Lit × alloc.vec.Vec Lit × Std.Usize) =>
      a.val.length - s.2.2.2.val)
    (inv := fun
      (s : Aig × alloc.vec.Vec Lit × alloc.vec.Vec Lit × Std.Usize) =>
      DivInv aig a b s.1 s.2.1 s.2.2.1 s.2.2.2.val)
  · rintro ⟨aigK, rem1, quo1, step⟩ hinv
    obtain ⟨hkle, hlenK, hpreK, hwfK, hrlen, hqlen, hrrng, hqrng, hrsem,
      hqsem⟩ := hinv
    dsimp only at hkle hlenK hpreK hwfK hrlen hqlen hrrng hqrng hrsem hqsem
    unfold blast_udivrem_loop1.body
    dsimp only
    split
    · rename_i hlt
      have hkw : step.val < a.val.length := by scalar_tac
      have hwpos : 0 < a.val.length := by omega
      -- gate budget for this iteration
      have hgstep : divGates a.val.length (step.val + 1)
          = divGates a.val.length step.val + (12 * a.val.length + 1) := rfl
      have hgmono : divGates a.val.length (step.val + 1)
          ≤ divGates a.val.length a.val.length :=
        divGates_mono a.val.length (by omega)
      have hcapK : aigK.nodes.val.length + (12 * a.val.length + 1)
          ≤ Usize.max := by omega
      step as ⟨i, hi⟩
      have hiv : i.val = a.val.length - 1 := by scalar_tac
      step as ⟨i1, hi1⟩
      have hi1v : i1.val = a.val.length - 1 - step.val := by scalar_tac
      have hirem : i.val < rem1.val.length := by omega
      step as ⟨top, htop⟩
      step with (udivrem_shift_loop_spec rem1 i (by omega)) as
        ⟨remS, hS1, hS2, hS3⟩
      have hi1a : i1.val < a.val.length := by omega
      step as ⟨la, hla⟩
      have h0S : 0 < remS.val.length := by omega
      step as ⟨old0, back0, hold0, hback0⟩
      rw [hback0]
      -- the shifted word, as a plain list
      have hderef2 :
          (alloc.vec.Vec.deref (alloc.vec.Vec.set remS 0#usize la)).val
            = remS.val.set 0 la := by
        show (alloc.vec.Vec.set remS 0#usize la).val = remS.val.set 0 la
        simp [alloc.vec.Vec.set_val_eq]
      have hsetlen : (alloc.vec.Vec.set remS 0#usize la).val.length
          = a.val.length := by
        simp only [alloc.vec.Vec.set_val_eq, List.length_set]
        omega
      -- range facts under the CURRENT aig
      have hremSrng : ∀ t : Nat, t < remS.val.length →
          (remS.val.getD t dLit).node.val < aigK.nodes.val.length := by
        intro t ht
        by_cases ht0 : t = 0
        · subst ht0
          rw [hS2 0 (Or.inl rfl)]
          have h01 : 0 < rem1.val.length := by omega
          rw [getD_eq_getElem_of_lt h01 dLit]
          exact hrrng _ (List.getElem_mem _)
        · have hti : t ≤ i.val := by omega
          rw [hS3 t (by omega) hti]
          have ht1 : t - 1 < rem1.val.length := by omega
          rw [getD_eq_getElem_of_lt ht1 dLit]
          exact hrrng _ (List.getElem_mem _)
      have hslistrng : ∀ l ∈ remS.val.set 0 la,
          l.node.val < aigK.nodes.val.length := by
        refine forall_mem_of_getD (d := dLit) (fun t ht => ?_)
        simp only [List.length_set] at ht
        by_cases ht0 : t = 0
        · subst ht0
          rw [List.getD_eq_getElem?_getD, List.getElem?_set_self (by omega),
            Option.getD_some]
          have h1 := ha la (by rw [hla]; exact List.getElem_mem _)
          have h2 := hpreK.length_le
          omega
        · rw [List.getD_eq_getElem?_getD,
            List.getElem?_set_ne (show (0 : Nat) ≠ t by omega),
            ← List.getD_eq_getElem?_getD]
          exact hremSrng t ht
      have hsrng : ∀ l ∈
          (alloc.vec.Vec.deref (alloc.vec.Vec.set remS 0#usize la)).val,
          l.node.val < aigK.nodes.val.length := by
        rw [hderef2]
        exact hslistrng
      have hbK : ∀ l ∈ b.val, l.node.val < aigK.nodes.val.length := by
        intro l hl
        have h1 := hb l hl
        have h2 := hpreK.length_le
        omega
      have hneK : 0 < aigK.nodes.val.length := by
        have := hpreK.length_le
        omega
      have h0K : aigK.nodes.val[0]'hneK = Node.False :=
        node0_of_prefix hpreK hne h0 hneK
      have hsleneq :
          (alloc.vec.Vec.deref (alloc.vec.Vec.set remS 0#usize la)).val.length
            = a.val.length := by
        rw [hderef2]
        simp only [List.length_set]
        omega
      step with (sub_with_uge_spec aigK
        (alloc.vec.Vec.deref (alloc.vec.Vec.set remS 0#usize la)) b
        (by rw [hsleneq]; omega) (by rw [hsleneq]; omega) hsrng hbK hneK
        h0K) as
        ⟨diff, low_ge, aigS, hsub1, hsub2, hsub3, hsub4, hsub5, hsub6,
          hsub7, hsub8⟩
      rw [hsleneq] at hsub1 hsub4 hsub7 hsub8
      rw [hderef2] at hsub7 hsub8
      -- the OR of the shifted-out top bit and the low compare
      have htopS : top.node.val < aigS.nodes.val.length := by
        have h1 : top.node.val < aigK.nodes.val.length := by
          rw [htop]
          exact hrrng _ (List.getElem_mem _)
        omega
      step with (push_or_gadget aigS top low_ge (by omega) htopS hsub6) as
        ⟨ge, aigO, hO1, hO2, hO3, hO4, hO5⟩
      -- quotient bit assignment
      have hi1q : i1.val < quo1.val.length := by omega
      step as ⟨oldq, backq, holdq, hbackq⟩
      rw [hbackq]
      -- the restoring mux pass
      have hsetval : (alloc.vec.Vec.set remS 0#usize la).val
          = remS.val.set 0 la := hderef2
      have hremO : ∀ l ∈ (alloc.vec.Vec.set remS 0#usize la).val,
          l.node.val < aigO.nodes.val.length := by
        rw [hsetval]
        intro l hl
        have h1 := hslistrng l hl
        omega
      have hdiffO : ∀ l ∈ diff.val, l.node.val < aigO.nodes.val.length := by
        intro l hl
        have h1 := hsub5 l hl
        omega
      step with (udivrem_restore_loop_spec aigO w
        (alloc.vec.Vec.set remS 0#usize la) diff ge
        (by rw [hsetlen]; omega) (by rw [hsetlen]; omega)
        (by rw [hsetlen]; omega) hremO hdiffO hO3) as
        ⟨aigF, rem3, hR1, hR2, hR3, hR4, hR5, hR6⟩
      rw [hsetlen] at hR1 hR4 hR6
      step as ⟨step1, hstep1⟩
      -- semantic bridge: value words under the CURRENT aig
      have hbWord : ∀ inp : List Bool,
          wordVals (pSim inp aigK.nodes.val) b.val
            = wordVals (pSim inp aig.nodes.val) b.val :=
        fun inp => wordVals_stable hpreK hb inp
      have hsWord : ∀ inp : List Bool,
          wordVals (pSim inp aigK.nodes.val) (remS.val.set 0 la)
            = pDivShift (wordVals (pSim inp aig.nodes.val) a.val)
                a.val.length step.val
                (pDivRem (wordVals (pSim inp aig.nodes.val) a.val)
                  (wordVals (pSim inp aig.nodes.val) b.val)
                  a.val.length step.val) := by
        intro inp
        apply eq_of_getD_eq
        · rw [wordVals_length, List.length_set,
            pDivShift_length (by simp) hwpos]
          omega
        · intro t ht
          rw [wordVals_length, List.length_set] at ht
          have htw : t < a.val.length := by omega
          have htset : t < (remS.val.set 0 la).length := by
            rw [List.length_set]
            omega
          rw [wordVals_getD _ _ htset, ← getD_eq_getElem_of_lt htset dLit]
          by_cases ht0 : t = 0
          · subst ht0
            rw [List.getD_eq_getElem?_getD,
              List.getElem?_set_self (by omega), Option.getD_some, hla,
              pEvalLit_stable hpreK _ (ha _ (List.getElem_mem hi1a)) inp,
              ← wordVals_getD (pSim inp aig.nodes.val) a.val hi1a, hi1v]
            simp [pDivShift]
          · obtain ⟨t', rfl⟩ : ∃ t', t = t' + 1 := ⟨t - 1, by omega⟩
            rw [List.getD_eq_getElem?_getD,
              List.getElem?_set_ne (show (0 : Nat) ≠ t' + 1 by omega),
              ← List.getD_eq_getElem?_getD,
              hS3 (t' + 1) (by omega) (by omega)]
            simp only [Nat.add_sub_cancel]
            rw [hrsem inp t' (by omega)]
            simp only [pDivShift, List.getD_cons_succ]
            rw [getD_take_of_lt _ (by omega : t' < a.val.length - 1)]
      have htopv : ∀ inp : List Bool,
          pEvalLit (pSim inp aigK.nodes.val) top
            = (pDivRem (wordVals (pSim inp aig.nodes.val) a.val)
                (wordVals (pSim inp aig.nodes.val) b.val)
                a.val.length step.val).getD (a.val.length - 1) false := by
        intro inp
        rw [htop, ← getD_eq_getElem_of_lt hirem dLit,
          hrsem inp i.val (by omega), hiv]
      -- the ge literal computes the pure step decision
      have hgev : ∀ inp : List Bool,
          pEvalLit (pSim inp aigO.nodes.val) ge
            = pDivGe (wordVals (pSim inp aig.nodes.val) a.val)
                (wordVals (pSim inp aig.nodes.val) b.val)
                a.val.length step.val := by
        intro inp
        rw [hO5 inp, pEvalLit_stable hsub2 top (by
          rw [htop]
          exact hrrng _ (List.getElem_mem _)) inp, htopv inp, hsub7 inp,
          hsWord inp, hbWord inp]
        rfl
      -- the mux branches
      have hdiffv : ∀ (inp : List Bool) (t : Nat), t < a.val.length →
          pEvalLit (pSim inp aigO.nodes.val) (diff.val.getD t dLit)
            = pSubBit (pDivShift (wordVals (pSim inp aig.nodes.val) a.val)
                a.val.length step.val
                (pDivRem (wordVals (pSim inp aig.nodes.val) a.val)
                  (wordVals (pSim inp aig.nodes.val) b.val)
                  a.val.length step.val))
              (wordVals (pSim inp aig.nodes.val) b.val) t := by
        intro inp t ht
        have htd : t < diff.val.length := by omega
        rw [getD_eq_getElem_of_lt htd dLit,
          pEvalLit_stable hO2 _ (hsub5 _ (List.getElem_mem _)) inp,
          ← getD_eq_getElem_of_lt htd dLit, hsub8 inp t ht, hsWord inp,
          hbWord inp]
      have hsvalv : ∀ (inp : List Bool) (t : Nat), t < a.val.length →
          pEvalLit (pSim inp aigO.nodes.val)
              ((alloc.vec.Vec.set remS 0#usize la).val.getD t dLit)
            = (pDivShift (wordVals (pSim inp aig.nodes.val) a.val)
                a.val.length step.val
                (pDivRem (wordVals (pSim inp aig.nodes.val) a.val)
                  (wordVals (pSim inp aig.nodes.val) b.val)
                  a.val.length step.val)).getD t false := by
        intro inp t ht
        have htset : t < (remS.val.set 0 la).length := by
          rw [List.length_set]
          omega
        rw [hsetval, getD_eq_getElem_of_lt htset dLit,
          pEvalLit_stable (hsub2.trans hO2) _
            (hslistrng _ (List.getElem_mem _)) inp,
          ← wordVals_getD (pSim inp aigK.nodes.val) _ htset, hsWord inp]
      refine ⟨?_, by scalar_tac⟩
      rw [hstep1]
      refine ⟨by omega, ?_, hpreK.trans (hsub2.trans (hO2.trans hR2)),
        fun L hL => hR3 L (hO4 L (hsub3 L (hwfK L hL))), by omega, ?_, hR5,
        ?_, ?_, ?_⟩
      · -- gate count
        omega
      · -- quotient length preserved by the in-place update
        simp only [alloc.vec.Vec.set_val_eq, List.length_set]
        exact hqlen
      · -- quotient literals in range
        intro l hl
        simp only [alloc.vec.Vec.set_val_eq] at hl
        rcases List.mem_or_eq_of_mem_set hl with h' | h'
        · have h1 := hqrng l h'
          have h2 := (hsub2.trans (hO2.trans hR2)).length_le
          omega
        · subst h'
          have h2 := hR2.length_le
          omega
      · -- remainder semantics at step k+1
        intro inp t ht
        rw [hR6 inp t ht, hgev inp, hdiffv inp t ht, hsvalv inp t ht,
          pDivRem_succ, rangeMap_getD _ ht]
      · -- quotient semantics at step k+1
        intro inp t htlo thi
        simp only [alloc.vec.Vec.set_val_eq]
        by_cases hteq : t = i1.val
        · subst hteq
          rw [List.getD_eq_getElem?_getD, List.getElem?_set_self (by omega),
            Option.getD_some, pEvalLit_stable hR2 ge hO3 inp, hgev inp]
          congr 1
          omega
        · rw [List.getD_eq_getElem?_getD,
            List.getElem?_set_ne (show i1.val ≠ t by omega),
            ← List.getD_eq_getElem?_getD]
          have htq : t < quo1.val.length := by omega
          rw [getD_eq_getElem_of_lt htq dLit,
            pEvalLit_stable (hsub2.trans (hO2.trans hR2)) _
              (hqrng _ (List.getElem_mem _)) inp,
            ← getD_eq_getElem_of_lt htq dLit]
          exact hqsem inp t (by omega) thi
    · rename_i hge2
      have hkeq : step.val = a.val.length := by scalar_tac
      rw [← hkeq]
      exact ⟨hkle, hlenK, hpreK, hwfK, hrlen, hqlen, hrrng, hqrng, hrsem,
        hqsem⟩
  · dsimp only
    refine ⟨Nat.zero_le _, by simp [divGates], List.prefix_refl _,
      fun _ h => h, by rw [hrem]; simp, by rw [hquo]; simp, ?_, ?_, ?_, ?_⟩
    · intro l hl
      rw [hrem] at hl
      have hld : l = dLit := List.eq_of_mem_replicate hl
      rw [hld]
      simp only [dLit]
      scalar_tac
    · intro l hl
      rw [hquo] at hl
      have hld : l = dLit := List.eq_of_mem_replicate hl
      rw [hld]
      simp only [dLit]
      scalar_tac
    · intro inp t ht
      simp only [hrem, dLit, List.getD_eq_getElem?_getD,
        List.getElem?_replicate, if_pos ht, Option.getD_some]
      rw [pEvalLit_node_zero hne h0 inp false]
      simp [pDivRem, ht]
    · intro inp t ht1 ht2
      scalar_tac

/- ══════════════ END-TO-END: BLAST THEN SIMULATE ══════════════ -/

/-- **Correctness of `blast_udivrem` against the simulator** (issue #68),
    the per-bit monadic headline: after blasting, simulating the extended
    aig on ANY well-formed input assignment gives, for each output bit
    `t < w`: quotient bit `b == 0 ? true : pDivGe … (w-1-t)` and remainder
    bit `b == 0 ? a[t] : (pDivRem … w)[t]`, where `b == 0` is the negated
    OR-fold `pHigh … 0 w` — everything read under the SAME simulation.
    Requires node 0 to be the constant-FALSE node. Unbounded width. -/
theorem blast_udivrem_correct (aig : Aig) (a b : Slice Lit)
    (hab : a.val.length ≤ b.val.length)
    (hcap : aig.nodes.val.length
      + (12 * a.val.length * a.val.length + 8 * a.val.length)
      ≤ Usize.max)
    (ha : ∀ l ∈ a.val, l.node.val < aig.nodes.val.length)
    (hb : ∀ l ∈ b.val, l.node.val < aig.nodes.val.length)
    (hne : 0 < aig.nodes.val.length)
    (h0 : aig.nodes.val[0]'hne = Node.False) :
    blast_udivrem aig a b ⦃ p =>
      p.1.1.val.length = a.val.length ∧
      p.1.2.val.length = a.val.length ∧
      ∀ (inputs : Slice Bool), AigWF aig.nodes.val inputs.val.length →
        simulate p.2 inputs ⦃ vals =>
          ∀ (t : Nat), t < a.val.length →
            (pEvalLit vals.val (p.1.1.val.getD t dLit)
              = if pHigh vals.val b.val 0 a.val.length
                then pDivGe (wordVals vals.val a.val)
                  (wordVals vals.val b.val) a.val.length
                  (a.val.length - 1 - t)
                else true) ∧
            (pEvalLit vals.val (p.1.2.val.getD t dLit)
              = if pHigh vals.val b.val 0 a.val.length
                then (pDivRem (wordVals vals.val a.val)
                    (wordVals vals.val b.val) a.val.length
                    a.val.length).getD t false
                else pEvalLit vals.val (a.val.getD t dLit)) ⦄ ⦄ := by
  unfold blast_udivrem
  have hlen : (Slice.len a).val = a.val.length := by scalar_tac
  have hprod : divGates a.val.length a.val.length
      = 12 * a.val.length * a.val.length + a.val.length := by
    rw [divGates_eq]
    ring
  step with (blast_udivrem_loop0_spec (Slice.len a)) as
    ⟨rem0, quo0, hrem0, hquo0⟩
  rw [hlen] at hrem0 hquo0
  step with (blast_udivrem_loop1_spec aig a b (Slice.len a) rem0 quo0 hlen
    hab (by omega) ha hb hne h0 hrem0 hquo0) as ⟨aig1, rem1, quo1, hinv⟩
  obtain ⟨_, hlen1, hpre1, hwf1, hrlen, hqlen, hrrng, hqrng, hrsem, hqsem⟩
    := hinv
  step with lit_false_spec as ⟨nz0, hnz0⟩
  have hne1 : 0 < aig1.nodes.val.length := by
    have := hpre1.length_le
    omega
  have h01 : aig1.nodes.val[0]'hne1 = Node.False :=
    node0_of_prefix hpre1 hne h0 hne1
  have hb1 : ∀ l ∈ b.val, l.node.val < aig1.nodes.val.length := by
    intro l hl
    have h1 := hb l hl
    have h2 := hpre1.length_le
    omega
  have hnz0r : nz0.node.val < aig1.nodes.val.length := by
    rw [hnz0]
    scalar_tac
  have hnz0v : ∀ inp : List Bool,
      pEvalLit (pSim inp aig1.nodes.val) nz0 = false := by
    intro inp
    rw [hnz0]
    exact pEvalLit_node_zero hne1 h01 inp false
  step with (udivrem_nz_loop_spec aig1 b (Slice.len a) nz0
    (by omega) (by omega) hb1 hnz0r hnz0v) as
    ⟨aig2, nzL, hz1, hz2, hz3, hz4, hz5⟩
  simp only [hlen] at hz5
  step with (lit_not_spec nzL) as ⟨bz, hbz⟩
  step with lit_true_spec as ⟨tl, htl⟩
  simp only [htl]
  have hbznode : bz.node = nzL.node := by rw [hbz]
  have hbz2 : bz.node.val < aig2.nodes.val.length := by
    rw [hbznode]
    exact hz4
  have hne2 : 0 < aig2.nodes.val.length := by omega
  have h02 : aig2.nodes.val[0]'hne2 = Node.False :=
    node0_of_prefix (hpre1.trans hz2) hne h0 hne2
  have htl2 : ({ node := 0#usize, neg := true } : Lit).node.val
      < aig2.nodes.val.length := by scalar_tac
  have hq2 : ∀ l ∈ quo1.val, l.node.val < aig2.nodes.val.length := by
    intro l hl
    have h1 := hqrng l hl
    have h2 := hz2.length_le
    omega
  step with (udivrem_quo_mux_spec aig2 (Slice.len a) quo1 bz
    { node := 0#usize, neg := true } (by omega) (by omega) hq2 hbz2 htl2)
    as ⟨aig3, quoOut, hQ1, hQ2, hQ3, hQ4, hQ5, hQ6⟩
  have ha3 : ∀ l ∈ a.val, l.node.val < aig3.nodes.val.length := by
    intro l hl
    have h1 := ha l hl
    have h2 := (hpre1.trans (hz2.trans hQ2)).length_le
    omega
  have hr3 : ∀ l ∈ rem1.val, l.node.val < aig3.nodes.val.length := by
    intro l hl
    have h1 := hrrng l hl
    have h2 := (hz2.trans hQ2).length_le
    omega
  have hbz3 : bz.node.val < aig3.nodes.val.length := by omega
  step with (udivrem_rem_mux_spec aig3 a (Slice.len a) rem1 bz
    (by omega) (by omega) (by omega) ha3 hr3 hbz3) as
    ⟨aig4, remOut, hM1, hM2, hM3, hM4, hM5, hM6⟩
  refine ⟨by omega, by omega, fun inputs hwfI => ?_⟩
  apply WP.spec_mono (simulate_spec aig4 inputs
    (hM3 _ (hQ3 _ (hz3 _ (hwf1 _ hwfI)))))
  intro vals hv t ht
  -- global stability chains
  have hpre14 : aig1.nodes.val <+: aig4.nodes.val :=
    hz2.trans (hQ2.trans hM2)
  have hpre04 : aig.nodes.val <+: aig4.nodes.val := hpre1.trans hpre14
  have hpre24 : aig2.nodes.val <+: aig4.nodes.val := hQ2.trans hM2
  -- the b == 0 flag, under the final simulation
  have hbzval : pEvalLit (pSim inputs.val aig2.nodes.val) bz
      = !pHigh (pSim inputs.val aig4.nodes.val) b.val 0 a.val.length := by
    rw [hbz, pEvalLit_not, hz5 inputs.val,
      pHigh_stable hpre1 hb inputs.val 0 a.val.length (by omega),
      pHigh_stable hpre04 hb inputs.val 0 a.val.length (by omega)]
  have haW : wordVals (pSim inputs.val aig4.nodes.val) a.val
      = wordVals (pSim inputs.val aig.nodes.val) a.val :=
    wordVals_stable hpre04 ha inputs.val
  have hbW : wordVals (pSim inputs.val aig4.nodes.val) b.val
      = wordVals (pSim inputs.val aig.nodes.val) b.val :=
    wordVals_stable hpre04 hb inputs.val
  constructor
  · -- the quotient bit
    have htq : t < quoOut.val.length := by omega
    rw [hv, getD_eq_getElem_of_lt htq dLit,
      pEvalLit_stable hM2 _ (hQ5 _ (List.getElem_mem _)) inputs.val,
      ← getD_eq_getElem_of_lt htq dLit, hQ6 inputs.val t (by omega),
      hbzval, pEvalLit_node_zero hne2 h02 inputs.val true]
    cases hph : pHigh (pSim inputs.val aig4.nodes.val) b.val 0
        a.val.length
    · simp
    · simp only [Bool.not_true, Bool.false_eq_true, if_false, if_true]
      have htqu : t < quo1.val.length := by omega
      rw [getD_eq_getElem_of_lt htqu dLit,
        pEvalLit_stable hz2 _ (hqrng _ (List.getElem_mem _)) inputs.val,
        ← getD_eq_getElem_of_lt htqu dLit,
        hqsem inputs.val t (by omega) (by omega), haW, hbW]
  · -- the remainder bit
    have htr : t < remOut.val.length := by omega
    rw [hv, hM6 inputs.val t (by omega),
      pEvalLit_stable hQ2 bz hbz2 inputs.val, hbzval]
    cases hph : pHigh (pSim inputs.val aig4.nodes.val) b.val 0
        a.val.length
    · -- divisor is zero: remainder = dividend
      simp only [Bool.not_false, if_true, Bool.false_eq_true, if_false]
      have hta : t < a.val.length := ht
      rw [getD_eq_getElem_of_lt hta dLit,
        pEvalLit_stable hM2 _ (ha3 _ (List.getElem_mem hta)) inputs.val]
    · -- divisor nonzero: remainder from the restoring loop
      simp only [Bool.not_true, Bool.false_eq_true, if_false, if_true]
      have htru : t < rem1.val.length := by omega
      rw [getD_eq_getElem_of_lt htru dLit,
        pEvalLit_stable (hz2.trans hQ2) _ (hrrng _ (List.getElem_mem _))
          inputs.val,
        ← getD_eq_getElem_of_lt htru dLit,
        hrsem inputs.val t (by omega), haW, hbW]

/- ══════════════ THE NUMERIC BRIDGE: ONE RESTORING STEP ══════════════ -/

/-- The shifted word denotes the truncation of the true (w+1)-bit shifted
    remainder `R.concat abit` (value `2·R + abit`). -/
theorem pDivShift_denotesBits {pa r : List Bool} {w : Nat} {A R : BitVec w}
    (hpa : DenotesBits pa A) (hr : DenotesBits r R) (hw : 0 < w) (k : Nat) :
    DenotesBits (pDivShift pa w k r)
      (BitVec.setWidth w (R.concat (A.getLsbD (w - 1 - k)))) := by
  refine ⟨pDivShift_length hr.1 hw, fun j => ?_⟩
  unfold pDivShift
  rw [BitVec.getLsbD_setWidth, BitVec.getLsbD_concat]
  cases j with
  | zero =>
    rw [List.getD_cons_zero, hpa.2]
    simp [hw]
  | succ j =>
    rw [List.getD_cons_succ]
    simp only [Nat.succ_ne_zero, if_false, Nat.add_sub_cancel]
    by_cases hj : j + 1 < w
    · rw [getD_take_of_lt _ (by omega : j < w - 1), hr.2 j]
      simp [hj]
    · rw [List.getD_eq_default _ _
        (by rw [List.length_take]; omega : List.length _ ≤ j)]
      simp [hj]

/-- The stored top bit reads the overflow of the true shifted remainder:
    `r[w-1] = (2·R + abit ≥ 2^w)`. -/
theorem top_eq_decide {r : List Bool} {w : Nat} {R : BitVec w}
    (hr : DenotesBits r R) (hw : 0 < w) (abit : Bool) :
    r.getD (w - 1) false
      = decide (2 ^ w ≤ 2 * R.toNat + abit.toNat) := by
  rw [hr.2 (w - 1),
    show R.getLsbD (w - 1) = R.toNat.testBit (w - 1) from rfl,
    Nat.testBit_eq_decide_div_mod_eq, decide_eq_decide]
  have h2 : R.toNat < 2 ^ w := R.isLt
  have h3 : 2 ^ w = 2 ^ (w - 1) * 2 := by
    rw [← Nat.pow_succ]
    congr 1
    omega
  have h4 := Nat.div_add_mod R.toNat (2 ^ (w - 1))
  have h5 : R.toNat / 2 ^ (w - 1) < 2 :=
    (Nat.div_lt_iff_lt_mul (Nat.two_pow_pos _)).mpr (by omega)
  have h6 : R.toNat % 2 ^ (w - 1) < 2 ^ (w - 1) :=
    Nat.mod_lt _ (Nat.two_pow_pos _)
  have hab : abit.toNat ≤ 1 := Bool.toNat_le abit
  have h50 : R.toNat / 2 ^ (w - 1) = 0 ∨ R.toNat / 2 ^ (w - 1) = 1 := by
    rcases Nat.lt_or_ge (R.toNat / 2 ^ (w - 1)) 1 with h | h
    · exact Or.inl (Nat.lt_one_iff.mp h)
    · exact Or.inr (Nat.le_antisymm (Nat.lt_succ_iff.mp h5) h)
  rcases h50 with h | h <;> rw [h] at h4 ⊢ <;> simp <;> omega

/-- **The w-bit trick, decision half**: the circuit decision
    `top ∨ (B ≤ S)` — with `S = (2·R + abit) mod 2^w` the truncated shifted
    remainder — equals the full (w+1)-bit compare `B ≤ 2·R + abit`,
    because `top` alone implies `2·R + abit ≥ 2^w > B`. -/
theorem pDivGeStep_eq_decide {pa pb r : List Bool} {w : Nat}
    {A B R : BitVec w} (hpa : DenotesBits pa A) (hpb : DenotesBits pb B)
    (hr : DenotesBits r R) (hw : 0 < w) (k : Nat) :
    pDivGeStep pb w r (pDivShift pa w k r)
      = decide (B.toNat ≤ 2 * R.toNat + (A.getLsbD (w - 1 - k)).toNat) := by
  unfold pDivGeStep
  have hS := pDivShift_denotesBits hpa hr hw k
  rw [pSubCarry_last hS hpb, top_eq_decide hr hw (A.getLsbD (w - 1 - k))]
  have hSto : (BitVec.setWidth w (R.concat (A.getLsbD (w - 1 - k)))).toNat
      = (2 * R.toNat + (A.getLsbD (w - 1 - k)).toNat) % 2 ^ w := by
    rw [BitVec.toNat_setWidth, BitVec.toNat_concat]
    congr 1
    omega
  by_cases htop : 2 ^ w ≤ 2 * R.toNat + (A.getLsbD (w - 1 - k)).toNat
  · rw [decide_eq_true htop]
    simp only [Bool.true_or]
    have hlt : B.toNat ≤ 2 * R.toNat + (A.getLsbD (w - 1 - k)).toNat := by
      have := B.isLt
      omega
    rw [decide_eq_true hlt]
  · rw [decide_eq_false htop]
    simp only [Bool.false_or]
    rw [hSto, Nat.mod_eq_of_lt (by omega)]

/-- **The w-bit trick, restore half**: on the invariant `R < B` the
    restored word — `ge ? S - B : S`, everything w bits — denotes exactly
    `(2·R + abit) mod B`: when subtracting, the true difference
    `2·R + abit − B < B < 2^w` survives the w-bit truncation. -/
theorem pDivRemStep_denotesBits {pa pb r : List Bool} {w : Nat}
    {A B R : BitVec w} (hpa : DenotesBits pa A) (hpb : DenotesBits pb B)
    (hr : DenotesBits r R) (hw : 0 < w)
    (_hB : 0 < B.toNat) (hRB : R.toNat < B.toNat) (k : Nat) :
    DenotesBits
      ((List.range w).map (fun m =>
        if pDivGeStep pb w r (pDivShift pa w k r)
        then pSubBit (pDivShift pa w k r) pb m
        else (pDivShift pa w k r).getD m false))
      (BitVec.ofNat w ((2 * R.toNat + (A.getLsbD (w - 1 - k)).toNat)
        % B.toNat)) := by
  have hS := pDivShift_denotesBits hpa hr hw k
  have habit : (A.getLsbD (w - 1 - k)).toNat ≤ 1 := Bool.toNat_le _
  have hVlt : 2 * R.toNat + (A.getLsbD (w - 1 - k)).toNat
      < 2 * B.toNat := by omega
  have hBlt : B.toNat < 2 ^ w := B.isLt
  have hSto : (BitVec.setWidth w (R.concat (A.getLsbD (w - 1 - k)))).toNat
      = (2 * R.toNat + (A.getLsbD (w - 1 - k)).toNat) % 2 ^ w := by
    rw [BitVec.toNat_setWidth, BitVec.toNat_concat]
    congr 1
    omega
  have hge := pDivGeStep_eq_decide hpa hpb hr hw k
  by_cases hc : B.toNat ≤ 2 * R.toNat + (A.getLsbD (w - 1 - k)).toNat
  · -- subtract branch
    have hgetrue : pDivGeStep pb w r (pDivShift pa w k r) = true := by
      rw [hge]
      exact decide_eq_true hc
    have hsub : (BitVec.setWidth w (R.concat (A.getLsbD (w - 1 - k)))
        - B).toNat
        = 2 * R.toNat + (A.getLsbD (w - 1 - k)).toNat - B.toNat := by
      rw [BitVec.toNat_sub, hSto, Nat.add_mod_mod,
        show 2 ^ w - B.toNat
            + (2 * R.toNat + (A.getLsbD (w - 1 - k)).toNat)
          = (2 * R.toNat + (A.getLsbD (w - 1 - k)).toNat - B.toNat) + 2 ^ w
          by omega,
        Nat.add_mod_right, Nat.mod_eq_of_lt (by omega)]
    have hVBlt : 2 * R.toNat + (A.getLsbD (w - 1 - k)).toNat - B.toNat
        < B.toNat := by omega
    have hVB2w : 2 * R.toNat + (A.getLsbD (w - 1 - k)).toNat - B.toNat
        < 2 ^ w := by omega
    have hofnat : BitVec.ofNat w
        ((2 * R.toNat + (A.getLsbD (w - 1 - k)).toNat) % B.toNat)
        = BitVec.setWidth w (R.concat (A.getLsbD (w - 1 - k))) - B := by
      apply BitVec.eq_of_toNat_eq
      rw [BitVec.toNat_ofNat, hsub, Nat.mod_eq_sub_mod hc,
        Nat.mod_eq_of_lt hVBlt, Nat.mod_eq_of_lt hVB2w]
    rw [hofnat]
    refine ⟨by simp, fun j => ?_⟩
    by_cases hj : j < w
    · rw [rangeMap_getD _ hj]
      simp only [hgetrue, if_true]
      exact pSubBit_eq_sub hS hpb hj
    · rw [List.getD_eq_default _ _ (by simp; omega),
        BitVec.getLsbD_of_ge _ _ (by omega)]
  · -- keep branch
    have hgefalse : pDivGeStep pb w r (pDivShift pa w k r) = false := by
      rw [hge]
      exact decide_eq_false hc
    have hVltB : 2 * R.toNat + (A.getLsbD (w - 1 - k)).toNat
        < B.toNat := by omega
    have hVlt2w : 2 * R.toNat + (A.getLsbD (w - 1 - k)).toNat
        < 2 ^ w := by omega
    have hofnat : BitVec.ofNat w
        ((2 * R.toNat + (A.getLsbD (w - 1 - k)).toNat) % B.toNat)
        = BitVec.setWidth w (R.concat (A.getLsbD (w - 1 - k))) := by
      apply BitVec.eq_of_toNat_eq
      rw [BitVec.toNat_ofNat, hSto, Nat.mod_eq_of_lt hVltB]
    rw [hofnat]
    refine ⟨by simp, fun j => ?_⟩
    by_cases hj : j < w
    · rw [rangeMap_getD _ hj]
      simp only [hgefalse, Bool.false_eq_true, if_false]
      exact hS.2 j
    · rw [List.getD_eq_default _ _ (by simp; omega),
        BitVec.getLsbD_of_ge _ _ (by omega)]

/- ══════════════ THE NUMERIC BRIDGE: THE ITERATION ══════════════ -/

/-- The consumed-high-bits recurrence: pulling in dividend bit `w-1-k`
    doubles the consumed part and adds the bit. -/
theorem ahi_succ {w : Nat} (A : BitVec w) {k : Nat} (hk : k < w) :
    A.toNat / 2 ^ (w - (k + 1))
      = 2 * (A.toNat / 2 ^ (w - k)) + (A.getLsbD (w - 1 - k)).toNat := by
  have he : w - k = (w - (k + 1)) + 1 := by omega
  have h1 : A.toNat / 2 ^ ((w - (k + 1)) + 1)
      = A.toNat / 2 ^ (w - (k + 1)) / 2 := by
    rw [Nat.pow_succ, ← Nat.div_div_eq_div_mul]
  have h2 : (A.getLsbD (w - 1 - k)).toNat
      = A.toNat / 2 ^ (w - (k + 1)) % 2 := by
    have hidx : w - 1 - k = w - (k + 1) := by omega
    rw [hidx, show A.getLsbD (w - (k + 1))
        = A.toNat.testBit (w - (k + 1)) from rfl,
      Nat.testBit_eq_decide_div_mod_eq]
    rcases Nat.mod_two_eq_zero_or_one (A.toNat / 2 ^ (w - (k + 1)))
      with h | h <;> simp [h]
  rw [he, h1, h2]
  omega

/-- **The remainder invariant, iterated**: after `k` steps the pure
    remainder word denotes `Ahi_k mod B` where `Ahi_k = A.toNat / 2^(w-k)`
    is the consumed high part of the dividend (`B ≠ 0`). -/
theorem pDivRem_ge_spec {pa pb : List Bool} {w : Nat} {A B : BitVec w}
    (hpa : DenotesBits pa A) (hpb : DenotesBits pb B) (hB : 0 < B.toNat) :
    ∀ k, k ≤ w →
      DenotesBits (pDivRem pa pb w k)
        (BitVec.ofNat w (A.toNat / 2 ^ (w - k) % B.toNat)) := by
  intro k
  induction k with
  | zero =>
    intro _
    have h0 : A.toNat / 2 ^ (w - 0) = 0 := by
      rw [Nat.sub_zero]
      exact Nat.div_eq_of_lt A.isLt
    rw [h0, Nat.zero_mod]
    refine ⟨by simp [pDivRem], fun j => ?_⟩
    show (List.replicate w false).getD j false = (BitVec.ofNat w 0).getLsbD j
    rw [List.getD_eq_getElem?_getD, List.getElem?_replicate]
    split <;> simp
  | succ k ih =>
    intro hk
    have hkw : k < w := by omega
    have hw : 0 < w := by omega
    have hrk := ih (by omega)
    have hRk : (BitVec.ofNat w (A.toNat / 2 ^ (w - k) % B.toNat)).toNat
        = A.toNat / 2 ^ (w - k) % B.toNat := by
      rw [BitVec.toNat_ofNat, Nat.mod_eq_of_lt]
      have h1 : A.toNat / 2 ^ (w - k) % B.toNat < B.toNat :=
        Nat.mod_lt _ hB
      have h2 := B.isLt
      omega
    have hRB : (BitVec.ofNat w (A.toNat / 2 ^ (w - k) % B.toNat)).toNat
        < B.toNat := by
      rw [hRk]
      exact Nat.mod_lt _ hB
    have hstep := pDivRemStep_denotesBits hpa hpb hrk hw hB hRB k
    rw [hRk] at hstep
    have harith : (2 * (A.toNat / 2 ^ (w - k) % B.toNat)
        + (A.getLsbD (w - 1 - k)).toNat) % B.toNat
        = A.toNat / 2 ^ (w - (k + 1)) % B.toNat := by
      rw [ahi_succ A hkw]
      conv_rhs => rw [← Nat.div_add_mod (A.toNat / 2 ^ (w - k)) B.toNat]
      rw [show 2 * (B.toNat * (A.toNat / 2 ^ (w - k) / B.toNat)
            + A.toNat / 2 ^ (w - k) % B.toNat)
          + (A.getLsbD (w - 1 - k)).toNat
        = B.toNat * (2 * (A.toNat / 2 ^ (w - k) / B.toNat))
          + (2 * (A.toNat / 2 ^ (w - k) % B.toNat)
             + (A.getLsbD (w - 1 - k)).toNat) by ring, Nat.mul_add_mod]
    rw [pDivRem_succ]
    rw [harith] at hstep
    exact hstep

/-- The emitted `ge` bit of step `k`, numerically. -/
theorem pDivGe_eq_decide {pa pb : List Bool} {w : Nat} {A B : BitVec w}
    (hpa : DenotesBits pa A) (hpb : DenotesBits pb B) (hB : 0 < B.toNat)
    {k : Nat} (hk : k < w) :
    pDivGe pa pb w k
      = decide (B.toNat ≤ 2 * (A.toNat / 2 ^ (w - k) % B.toNat)
          + (A.getLsbD (w - 1 - k)).toNat) := by
  unfold pDivGe
  have hrk := pDivRem_ge_spec hpa hpb hB k (by omega)
  have hRk : (BitVec.ofNat w (A.toNat / 2 ^ (w - k) % B.toNat)).toNat
      = A.toNat / 2 ^ (w - k) % B.toNat := by
    rw [BitVec.toNat_ofNat, Nat.mod_eq_of_lt]
    have h1 : A.toNat / 2 ^ (w - k) % B.toNat < B.toNat := Nat.mod_lt _ hB
    have h2 := B.isLt
    omega
  rw [pDivGeStep_eq_decide hpa hpb hrk (by omega) k, hRk]

/-- **The quotient bits**: the `ge` bit of step `j` is bit `w-1-j` of the
    `Nat` quotient — successive doubling spells the binary expansion. -/
theorem quo_bits_testBit {w : Nat} (A B : BitVec w) (hB : 0 < B.toNat) :
    ∀ k, k ≤ w → ∀ j, j < k →
      Nat.testBit (A.toNat / 2 ^ (w - k) / B.toNat) (k - 1 - j)
        = decide (B.toNat ≤ 2 * (A.toNat / 2 ^ (w - j) % B.toNat)
            + (A.getLsbD (w - 1 - j)).toNat) := by
  intro k
  induction k with
  | zero =>
    intro _ j hj
    exact absurd hj (Nat.not_lt_zero j)
  | succ k ih =>
    intro hk j hj
    have hkw : k < w := by omega
    -- the quotient recurrence q_{k+1} = 2·q_k + ge_k
    have hd := Nat.div_add_mod (A.toNat / 2 ^ (w - k)) B.toNat
    have hrlt : A.toNat / 2 ^ (w - k) % B.toNat < B.toNat := Nat.mod_lt _ hB
    have habit : (A.getLsbD (w - 1 - k)).toNat ≤ 1 := Bool.toNat_le _
    have h2 : 2 * (A.toNat / 2 ^ (w - k)) + (A.getLsbD (w - 1 - k)).toNat
        = B.toNat * (2 * (A.toNat / 2 ^ (w - k) / B.toNat))
          + (2 * (A.toNat / 2 ^ (w - k) % B.toNat)
             + (A.getLsbD (w - 1 - k)).toNat) := by
      conv_lhs => rw [← hd]
      ring
    have hqrec : A.toNat / 2 ^ (w - (k + 1)) / B.toNat
        = 2 * (A.toNat / 2 ^ (w - k) / B.toNat)
          + (if B.toNat ≤ 2 * (A.toNat / 2 ^ (w - k) % B.toNat)
              + (A.getLsbD (w - 1 - k)).toNat then 1 else 0) := by
      rw [ahi_succ A hkw, h2, Nat.mul_add_div hB]
      congr 1
      by_cases hc : B.toNat ≤ 2 * (A.toNat / 2 ^ (w - k) % B.toNat)
          + (A.getLsbD (w - 1 - k)).toNat
      · rw [if_pos hc]
        have hd1 : 1 ≤ (2 * (A.toNat / 2 ^ (w - k) % B.toNat)
            + (A.getLsbD (w - 1 - k)).toNat) / B.toNat :=
          (Nat.one_le_div_iff hB).mpr hc
        have hd2 : (2 * (A.toNat / 2 ^ (w - k) % B.toNat)
            + (A.getLsbD (w - 1 - k)).toNat) / B.toNat < 2 :=
          (Nat.div_lt_iff_lt_mul hB).mpr (by omega)
        omega
      · rw [if_neg hc]
        exact Nat.div_eq_of_lt (by omega)
    by_cases hjk : j = k
    · subst hjk
      have hidx : j + 1 - 1 - j = 0 := by omega
      rw [hidx, Nat.testBit_zero, hqrec, decide_eq_decide]
      constructor
      · intro hmod
        by_contra hc
        rw [if_neg hc] at hmod
        omega
      · intro hc
        rw [if_pos hc]
        omega
    · have hjk' : j < k := by omega
      have hidx : k + 1 - 1 - j = (k - 1 - j) + 1 := by omega
      rw [hidx, Nat.testBit_succ, hqrec]
      have hdiv2 : (2 * (A.toNat / 2 ^ (w - k) / B.toNat)
          + (if B.toNat ≤ 2 * (A.toNat / 2 ^ (w - k) % B.toNat)
              + (A.getLsbD (w - 1 - k)).toNat then 1 else 0)) / 2
          = A.toNat / 2 ^ (w - k) / B.toNat := by
        split <;> omega
      rw [hdiv2]
      exact ih (by omega) j hjk'

/- ══════════════ THE HEADLINES ══════════════ -/

/-- **`blast_udivrem` implements SMT-LIB `bvudiv`/`bvurem`, for every
    width `w`** (issue #68, the LAST rule of the v0.15.0 capstone): if the
    input words denote `A` and `B` under the post-blast simulation, the
    quotient word denotes `A.smtUDiv B` (core's SMT-LIB division:
    `if B = 0 then allOnes else A / B` — `BitVec.smtUDiv_eq`) and the
    remainder word denotes `A % B` (core's `umod` already returns `A` at
    `B = 0` — `BitVec.umod_zero` — matching SMT-LIB `bvurem`).
    Restoring long division, `12·w² + 8·w` gates. -/
theorem blast_udivrem_bitvec (aig : Aig) (a b : Slice Lit)
    (hab : a.val.length ≤ b.val.length)
    (hcap : aig.nodes.val.length
      + (12 * a.val.length * a.val.length + 8 * a.val.length)
      ≤ Usize.max)
    (ha : ∀ l ∈ a.val, l.node.val < aig.nodes.val.length)
    (hb : ∀ l ∈ b.val, l.node.val < aig.nodes.val.length)
    (hne : 0 < aig.nodes.val.length)
    (h0 : aig.nodes.val[0]'hne = Node.False)
    {w : Nat} (A B : BitVec w) :
    blast_udivrem aig a b ⦃ p =>
      ∀ (inputs : Slice Bool), AigWF aig.nodes.val inputs.val.length →
        simulate p.2 inputs ⦃ vals =>
          Denotes vals.val a.val w A → Denotes vals.val b.val w B →
          Denotes vals.val p.1.1.val w (A.smtUDiv B) ∧
          Denotes vals.val p.1.2.val w (A % B) ⦄ ⦄ := by
  apply WP.spec_mono (blast_udivrem_correct aig a b hab hcap ha hb hne h0)
  rintro ⟨⟨quoOut, remOut⟩, aig'⟩ ⟨hqlen, hrlen, hsim⟩
  intro inputs hwf
  apply WP.spec_mono (hsim inputs hwf)
  intro vals hbits hA hB
  have hpa := denotesBits_of_denotes hA
  have hpb := denotesBits_of_denotes hB
  have haw : a.val.length = w := hA.1
  have hbw : b.val.length = w := hB.1
  rw [haw] at hbits
  have hhigh : pHigh vals.val b.val 0 w = decide (0 < B.toNat) := by
    rw [pHigh_eq_decide hB (Nat.zero_le w), Nat.pow_zero, decide_eq_decide]
    omega
  constructor
  · -- the quotient word denotes `A.smtUDiv B`
    refine ⟨by omega, fun j hj => ?_⟩
    have hjw : j < w := by omega
    rw [← getD_eq_getElem_of_lt hj dLit, (hbits j (by omega)).1, hhigh]
    by_cases hBz : 0 < B.toNat
    · rw [decide_eq_true hBz]
      simp only [if_true]
      rw [pDivGe_eq_decide hpa hpb hBz (show w - 1 - j < w by omega),
        ← quo_bits_testBit A B hBz w (Nat.le_refl w) (w - 1 - j)
          (by omega)]
      have hidx : w - 1 - (w - 1 - j) = j := by omega
      have hBne : B ≠ 0#w := by
        intro h
        rw [h] at hBz
        simp at hBz
      rw [hidx, Nat.sub_self, Nat.pow_zero, Nat.div_one,
        BitVec.smtUDiv_eq, if_neg hBne,
        show (A / B).getLsbD j = (A / B).toNat.testBit j from rfl,
        BitVec.toNat_udiv]
    · have hB0 : B = 0#w := by
        apply BitVec.eq_of_toNat_eq
        simp
        omega
      rw [decide_eq_false (by omega)]
      simp only [Bool.false_eq_true, if_false]
      rw [hB0, BitVec.smtUDiv_zero, BitVec.getLsbD_allOnes]
      simp [hjw]
  · -- the remainder word denotes `A % B`
    refine ⟨by omega, fun j hj => ?_⟩
    have hjw : j < w := by omega
    rw [← getD_eq_getElem_of_lt hj dLit, (hbits j (by omega)).2, hhigh]
    by_cases hBz : 0 < B.toNat
    · rw [decide_eq_true hBz]
      simp only [if_true]
      rw [(pDivRem_ge_spec hpa hpb hBz w (Nat.le_refl w)).2 j,
        Nat.sub_self, Nat.pow_zero, Nat.div_one, ← BitVec.umod_def]
    · have hB0 : B = 0#w := by
        apply BitVec.eq_of_toNat_eq
        simp
        omega
      rw [decide_eq_false (by omega)]
      simp only [Bool.false_eq_true, if_false]
      have hja : j < a.val.length := by omega
      rw [hB0, BitVec.umod_zero, getD_eq_getElem_of_lt hja dLit,
        hA.2 j hja]

/-- **`blast_udiv` implements SMT-LIB `bvudiv`, for every width `w`**:
    the quotient projection. -/
theorem blast_udiv_bitvec (aig : Aig) (a b : Slice Lit)
    (hab : a.val.length ≤ b.val.length)
    (hcap : aig.nodes.val.length
      + (12 * a.val.length * a.val.length + 8 * a.val.length)
      ≤ Usize.max)
    (ha : ∀ l ∈ a.val, l.node.val < aig.nodes.val.length)
    (hb : ∀ l ∈ b.val, l.node.val < aig.nodes.val.length)
    (hne : 0 < aig.nodes.val.length)
    (h0 : aig.nodes.val[0]'hne = Node.False)
    {w : Nat} (A B : BitVec w) :
    blast_udiv aig a b ⦃ p =>
      ∀ (inputs : Slice Bool), AigWF aig.nodes.val inputs.val.length →
        simulate p.2 inputs ⦃ vals =>
          Denotes vals.val a.val w A → Denotes vals.val b.val w B →
          Denotes vals.val p.1.val w (A.smtUDiv B) ⦄ ⦄ := by
  unfold blast_udiv
  step with (blast_udivrem_bitvec aig a b hab hcap ha hb hne h0 A B) as
    ⟨quo, rem, aig1, hsim⟩
  intro inputs hwf
  apply WP.spec_mono (hsim inputs hwf)
  intro vals h hA hB
  exact (h hA hB).1

/- ════════ #101: THE MULTIPLICATIVE `blast_urem` COMPOSITION ════════ -/

/-- Conjunction of two proven specs on the SAME computation. -/
theorem spec_and {α : Type} {m : Result α} {P Q : α → Prop}
    (hP : WP.spec m P) (hQ : WP.spec m Q) :
    WP.spec m (fun x => P x ∧ Q x) := by
  cases m with
  | ok x =>
    simp only [WP.spec_ok] at hP hQ ⊢
    exact ⟨hP, hQ⟩
  | fail e => simp only [WP.spec_fail] at hP
  | div => simp only [WP.spec_div] at hP

/-- Harvesting a simulate-wrapped fact at the pure level: on a well-formed
    aig the (deterministic, total) monadic simulation is `pSim`, so any
    proven post of `simulate` holds of a value list EQUAL to `pSim`. -/
theorem simulate_spec_pSim (aig' : Aig) (inputs : Slice Bool)
    {P : alloc.vec.Vec Bool → Prop}
    (hwf : AigWF aig'.nodes.val inputs.val.length)
    (h : WP.spec (simulate aig' inputs) P) :
    ∃ vals : alloc.vec.Vec Bool,
      vals.val = pSim inputs.val aig'.nodes.val ∧ P vals := by
  have h2 := simulate_spec aig' inputs hwf
  cases hm : simulate aig' inputs with
  | ok vals =>
    rw [hm] at h h2
    simp only [WP.spec_ok] at h h2
    exact ⟨vals, h2, h⟩
  | fail e =>
    rw [hm] at h2
    simp only [WP.spec_fail] at h2
  | div =>
    rw [hm] at h2
    simp only [WP.spec_div] at h2

/-- Transporting `Denotes` FORWARD along append-monotonicity (converse of
    `Denotes.of_prefix`): a word whose literals all live in the smaller aig
    keeps its denotation under the extended aig's simulation. -/
theorem Denotes.up {ns ns' : List Node} (hpre : ns <+: ns')
    {word : List Lit} {w : Nat} {V : BitVec w}
    (hrng : ∀ l ∈ word, l.node.val < ns.length) (inp : List Bool)
    (h : Denotes (pSim inp ns) word w V) :
    Denotes (pSim inp ns') word w V := by
  obtain ⟨hlen, hj⟩ := h
  refine ⟨hlen, fun j hjl => ?_⟩
  rw [pEvalLit_stable hpre _ (hrng _ (List.getElem_mem _)) inp]
  exact hj j hjl

/-- **The multiplicative remainder identity** (issue #101, the one new
    mathematical fact): over `BitVec w`, `A % B = A - A.smtUDiv B * B` for
    ALL `B` INCLUDING `B = 0` — there `A.smtUDiv 0 = allOnes` and
    `allOnes * 0 = 0`, so the right side is `A - 0 = A = A % 0`
    (`BitVec.umod_zero`). For `B ≠ 0` it is the Euclidean identity
    `A % B = A - A / B * B`, which survives the w-bit truncation because
    `A / B * B ≤ A < 2^w` (`Nat.div_mul_le_self`). -/
theorem umod_eq_sub_smtUDiv_mul {w : Nat} (A B : BitVec w) :
    A % B = A - A.smtUDiv B * B := by
  by_cases hB : B = 0#w
  · subst hB
    rw [BitVec.umod_zero, BitVec.smtUDiv_zero, BitVec.mul_zero,
      BitVec.sub_zero]
  · rw [BitVec.smtUDiv_eq, if_neg hB]
    apply BitVec.eq_of_toNat_eq
    have hle : A.toNat / B.toNat * B.toNat ≤ A.toNat :=
      Nat.div_mul_le_self A.toNat B.toNat
    have hA := A.isLt
    have hd := Nat.div_add_mod A.toNat B.toNat
    have hcomm : B.toNat * (A.toNat / B.toNat)
        = A.toNat / B.toNat * B.toNat := Nat.mul_comm _ _
    rw [BitVec.toNat_umod, BitVec.toNat_sub, BitVec.toNat_mul,
      BitVec.toNat_udiv,
      Nat.mod_eq_of_lt
        (show A.toNat / B.toNat * B.toNat < 2 ^ w by omega),
      show 2 ^ w - A.toNat / B.toNat * B.toNat + A.toNat
          = A.toNat - A.toNat / B.toNat * B.toNat + 2 ^ w by omega,
      Nat.add_mod_right,
      Nat.mod_eq_of_lt
        (show A.toNat - A.toNat / B.toNat * B.toNat < 2 ^ w by omega)]
    omega

/-- **Structural frame of `blast_udivrem`**: exactly `12·w² + 8·w` gates
    are appended, nothing existing is touched, well-formedness is
    preserved, and the quotient word has width `w` with every literal in
    range. Companion to `blast_udivrem_bitvec`, whose simulate-wrapped
    statement elides these plumbing facts; the #101 composition needs both
    (glued by `spec_and`). -/
theorem blast_udivrem_frame (aig : Aig) (a b : Slice Lit)
    (hab : a.val.length ≤ b.val.length)
    (hcap : aig.nodes.val.length
      + (12 * a.val.length * a.val.length + 8 * a.val.length)
      ≤ Usize.max)
    (ha : ∀ l ∈ a.val, l.node.val < aig.nodes.val.length)
    (hb : ∀ l ∈ b.val, l.node.val < aig.nodes.val.length)
    (hne : 0 < aig.nodes.val.length)
    (h0 : aig.nodes.val[0]'hne = Node.False) :
    blast_udivrem aig a b ⦃ p =>
      p.1.1.val.length = a.val.length ∧
      aig.nodes.val <+: p.2.nodes.val ∧
      p.2.nodes.val.length = aig.nodes.val.length
        + (12 * a.val.length * a.val.length + 8 * a.val.length) ∧
      (∀ L, AigWF aig.nodes.val L → AigWF p.2.nodes.val L) ∧
      (∀ l ∈ p.1.1.val, l.node.val < p.2.nodes.val.length) ⦄ := by
  unfold blast_udivrem
  have hlen : (Slice.len a).val = a.val.length := by scalar_tac
  have hprod : divGates a.val.length a.val.length
      = 12 * a.val.length * a.val.length + a.val.length := by
    rw [divGates_eq]
    ring
  step with (blast_udivrem_loop0_spec (Slice.len a)) as
    ⟨rem0, quo0, hrem0, hquo0⟩
  rw [hlen] at hrem0 hquo0
  step with (blast_udivrem_loop1_spec aig a b (Slice.len a) rem0 quo0 hlen
    hab (by omega) ha hb hne h0 hrem0 hquo0) as ⟨aig1, rem1, quo1, hinv⟩
  obtain ⟨_, hlen1, hpre1, hwf1, hrlen, hqlen, hrrng, hqrng, _, _⟩ := hinv
  step with lit_false_spec as ⟨nz0, hnz0⟩
  have hne1 : 0 < aig1.nodes.val.length := by
    have := hpre1.length_le
    omega
  have h01 : aig1.nodes.val[0]'hne1 = Node.False :=
    node0_of_prefix hpre1 hne h0 hne1
  have hb1 : ∀ l ∈ b.val, l.node.val < aig1.nodes.val.length := by
    intro l hl
    have h1 := hb l hl
    have h2 := hpre1.length_le
    omega
  have hnz0r : nz0.node.val < aig1.nodes.val.length := by
    rw [hnz0]
    scalar_tac
  have hnz0v : ∀ inp : List Bool,
      pEvalLit (pSim inp aig1.nodes.val) nz0 = false := by
    intro inp
    rw [hnz0]
    exact pEvalLit_node_zero hne1 h01 inp false
  step with (udivrem_nz_loop_spec aig1 b (Slice.len a) nz0
    (by omega) (by omega) hb1 hnz0r hnz0v) as
    ⟨aig2, nzL, hz1, hz2, hz3, hz4, _⟩
  step with (lit_not_spec nzL) as ⟨bz, hbz⟩
  step with lit_true_spec as ⟨tl, htl⟩
  simp only [htl]
  have hbznode : bz.node = nzL.node := by rw [hbz]
  have hbz2 : bz.node.val < aig2.nodes.val.length := by
    rw [hbznode]
    exact hz4
  have hne2 : 0 < aig2.nodes.val.length := by omega
  have htl2 : ({ node := 0#usize, neg := true } : Lit).node.val
      < aig2.nodes.val.length := by scalar_tac
  have hq2 : ∀ l ∈ quo1.val, l.node.val < aig2.nodes.val.length := by
    intro l hl
    have h1 := hqrng l hl
    have h2 := hz2.length_le
    omega
  step with (udivrem_quo_mux_spec aig2 (Slice.len a) quo1 bz
    { node := 0#usize, neg := true } (by omega) (by omega) hq2 hbz2 htl2)
    as ⟨aig3, quoOut, hQ1, hQ2, hQ3, hQ4, hQ5, _⟩
  have ha3 : ∀ l ∈ a.val, l.node.val < aig3.nodes.val.length := by
    intro l hl
    have h1 := ha l hl
    have h2 := (hpre1.trans (hz2.trans hQ2)).length_le
    omega
  have hr3 : ∀ l ∈ rem1.val, l.node.val < aig3.nodes.val.length := by
    intro l hl
    have h1 := hrrng l hl
    have h2 := (hz2.trans hQ2).length_le
    omega
  have hbz3 : bz.node.val < aig3.nodes.val.length := by omega
  step with (udivrem_rem_mux_spec aig3 a (Slice.len a) rem1 bz
    (by omega) (by omega) (by omega) ha3 hr3 hbz3) as
    ⟨aig4, remOut, hM1, hM2, hM3, _, _, _⟩
  refine ⟨by omega, hpre1.trans (hz2.trans (hQ2.trans hM2)), by omega,
    fun L hL => hM3 L (hQ3 L (hz3 L (hwf1 L hL))), ?_⟩
  intro l hl
  have h1 := hQ5 l hl
  have h2 := hM2.length_le
  omega

/-- Structural frame of `blast_udiv`: the quotient projection of
    `blast_udivrem_frame`. -/
theorem blast_udiv_frame (aig : Aig) (a b : Slice Lit)
    (hab : a.val.length ≤ b.val.length)
    (hcap : aig.nodes.val.length
      + (12 * a.val.length * a.val.length + 8 * a.val.length)
      ≤ Usize.max)
    (ha : ∀ l ∈ a.val, l.node.val < aig.nodes.val.length)
    (hb : ∀ l ∈ b.val, l.node.val < aig.nodes.val.length)
    (hne : 0 < aig.nodes.val.length)
    (h0 : aig.nodes.val[0]'hne = Node.False) :
    blast_udiv aig a b ⦃ p =>
      p.1.val.length = a.val.length ∧
      aig.nodes.val <+: p.2.nodes.val ∧
      p.2.nodes.val.length = aig.nodes.val.length
        + (12 * a.val.length * a.val.length + 8 * a.val.length) ∧
      (∀ L, AigWF aig.nodes.val L → AigWF p.2.nodes.val L) ∧
      (∀ l ∈ p.1.val, l.node.val < p.2.nodes.val.length) ⦄ := by
  unfold blast_udiv
  step with (blast_udivrem_frame aig a b hab hcap ha hb hne h0) as
    ⟨quo, rem, aig1, h1, h2, h3, h4, h5⟩
  exact ⟨h1, h2, h3, h4, h5⟩

/-- Structural frame of `blast_mul`: at most `10·w²` gates appended
    (exactly `mulGates w w`), prefix / WF-preservation / output ranges. -/
theorem blast_mul_frame (aig : Aig) (a b : Slice Lit)
    (hab : a.val.length ≤ b.val.length)
    (hcap : aig.nodes.val.length + 10 * a.val.length * a.val.length
      ≤ Usize.max)
    (ha : ∀ l ∈ a.val, l.node.val < aig.nodes.val.length)
    (hb : ∀ l ∈ b.val, l.node.val < aig.nodes.val.length)
    (hne : 0 < aig.nodes.val.length)
    (h0 : aig.nodes.val[0]'hne = Node.False) :
    blast_mul aig a b ⦃ p =>
      p.1.val.length = a.val.length ∧
      aig.nodes.val <+: p.2.nodes.val ∧
      p.2.nodes.val.length ≤ aig.nodes.val.length
        + 10 * a.val.length * a.val.length ∧
      (∀ L, AigWF aig.nodes.val L → AigWF p.2.nodes.val L) ∧
      (∀ l ∈ p.1.val, l.node.val < p.2.nodes.val.length) ⦄ := by
  unfold blast_mul
  have hlen : (Slice.len a).val = a.val.length := by scalar_tac
  step with (blast_mul_loop0_spec (Slice.len a)) as ⟨acc0, hacc0⟩
  rw [hlen] at hacc0
  apply WP.spec_mono (blast_mul_loop1_spec aig a b (Slice.len a) acc0 hlen
    hab hcap ha hb hne h0 hacc0)
  rintro ⟨out, aigF⟩ ⟨_, hlenF, hpre, hwf, holen, horng, _⟩
  have hmg := mulGates_le a.val.length a.val.length
  exact ⟨holen, hpre, by omega, hwf, horng⟩

/-- Structural frame of `blast_sub`: exactly `9·w` gates appended, prefix
    and WF-preservation (`word_not` and `lit_true` are gate-free). -/
theorem blast_sub_frame (aig : Aig) (a b : Slice Lit)
    (hab : a.val.length ≤ b.val.length)
    (hcap : aig.nodes.val.length + 9 * a.val.length ≤ Usize.max)
    (ha : ∀ l ∈ a.val, l.node.val < aig.nodes.val.length)
    (hb : ∀ l ∈ b.val, l.node.val < aig.nodes.val.length)
    (hne : 0 < aig.nodes.val.length) :
    blast_sub aig a b ⦃ p =>
      p.1.val.length = a.val.length ∧
      aig.nodes.val <+: p.2.nodes.val ∧
      p.2.nodes.val.length = aig.nodes.val.length + 9 * a.val.length ∧
      (∀ L, AigWF aig.nodes.val L → AigWF p.2.nodes.val L) ⦄ := by
  unfold blast_sub
  step with (word_not_spec b) as ⟨nb, hnb⟩
  have hderef : (alloc.vec.Vec.deref nb).val = nb.val := rfl
  step with lit_true_spec as ⟨l, hl⟩
  simp only [hl]
  have hnblen : (alloc.vec.Vec.deref nb).val.length = b.val.length := by
    rw [hderef, hnb]
    simp
  have hnbrng : ∀ l ∈ (alloc.vec.Vec.deref nb).val,
      l.node.val < aig.nodes.val.length := by
    rw [hderef, hnb]
    intro l' hl'
    rw [List.mem_map] at hl'
    obtain ⟨l'', hl'', rfl⟩ := hl'
    exact hb l'' hl''
  have hcin : ({ node := 0#usize, neg := true } : Lit).node.val
      < aig.nodes.val.length := by scalar_tac
  step with (ripple_carry_spec aig a (alloc.vec.Vec.deref nb) _
    (by omega) hcap ha hnbrng hcin) as
    ⟨sum, carry, aig1, h1, h2, h3, h4, _, _, _, _⟩
  exact ⟨h1, h2, h3, h4⟩

/-- `blast_udiv`, frame AND semantics in one spec (via `spec_and`): the
    #101 composition needs the structural facts to thread the later
    `blast_mul` / `blast_sub` stages and the semantic fact to name the
    quotient. -/
theorem blast_udiv_full (aig : Aig) (a b : Slice Lit)
    (hab : a.val.length ≤ b.val.length)
    (hcap : aig.nodes.val.length
      + (12 * a.val.length * a.val.length + 8 * a.val.length)
      ≤ Usize.max)
    (ha : ∀ l ∈ a.val, l.node.val < aig.nodes.val.length)
    (hb : ∀ l ∈ b.val, l.node.val < aig.nodes.val.length)
    (hne : 0 < aig.nodes.val.length)
    (h0 : aig.nodes.val[0]'hne = Node.False)
    {w : Nat} (A B : BitVec w) :
    blast_udiv aig a b ⦃ p =>
      p.1.val.length = a.val.length ∧
      aig.nodes.val <+: p.2.nodes.val ∧
      p.2.nodes.val.length = aig.nodes.val.length
        + (12 * a.val.length * a.val.length + 8 * a.val.length) ∧
      (∀ L, AigWF aig.nodes.val L → AigWF p.2.nodes.val L) ∧
      (∀ l ∈ p.1.val, l.node.val < p.2.nodes.val.length) ∧
      ∀ (inputs : Slice Bool), AigWF aig.nodes.val inputs.val.length →
        simulate p.2 inputs ⦃ vals =>
          Denotes vals.val a.val w A → Denotes vals.val b.val w B →
          Denotes vals.val p.1.val w (A.smtUDiv B) ⦄ ⦄ := by
  apply WP.spec_mono (spec_and
    (blast_udiv_frame aig a b hab hcap ha hb hne h0)
    (blast_udiv_bitvec aig a b hab hcap ha hb hne h0 A B))
  rintro ⟨quo, aig1⟩ ⟨⟨h1, h2, h3, h4, h5⟩, h6⟩
  exact ⟨h1, h2, h3, h4, h5, h6⟩

/-- `blast_mul`, frame AND semantics in one spec (via `spec_and`). -/
theorem blast_mul_full (aig : Aig) (a b : Slice Lit)
    (hab : a.val.length ≤ b.val.length)
    (hcap : aig.nodes.val.length + 10 * a.val.length * a.val.length
      ≤ Usize.max)
    (ha : ∀ l ∈ a.val, l.node.val < aig.nodes.val.length)
    (hb : ∀ l ∈ b.val, l.node.val < aig.nodes.val.length)
    (hne : 0 < aig.nodes.val.length)
    (h0 : aig.nodes.val[0]'hne = Node.False)
    {w : Nat} (A B : BitVec w) :
    blast_mul aig a b ⦃ p =>
      p.1.val.length = a.val.length ∧
      aig.nodes.val <+: p.2.nodes.val ∧
      p.2.nodes.val.length ≤ aig.nodes.val.length
        + 10 * a.val.length * a.val.length ∧
      (∀ L, AigWF aig.nodes.val L → AigWF p.2.nodes.val L) ∧
      (∀ l ∈ p.1.val, l.node.val < p.2.nodes.val.length) ∧
      ∀ (inputs : Slice Bool), AigWF aig.nodes.val inputs.val.length →
        simulate p.2 inputs ⦃ vals =>
          Denotes vals.val a.val w A → Denotes vals.val b.val w B →
          Denotes vals.val p.1.val w (A * B) ⦄ ⦄ := by
  apply WP.spec_mono (spec_and
    (blast_mul_frame aig a b hab hcap ha hb hne h0)
    (blast_mul_bitvec aig a b hab hcap ha hb hne h0 A B))
  rintro ⟨out, aig1⟩ ⟨⟨h1, h2, h3, h4, h5⟩, h6⟩
  exact ⟨h1, h2, h3, h4, h5, h6⟩

/-- **`blast_urem` implements SMT-LIB `bvurem`, for every width `w`**
    (issue #101): since the consumer-perf rework the remainder is blasted
    MULTIPLICATIVELY as `a - (a bvudiv b) * b` — the composition
    `blast_sub(a, blast_mul(blast_udiv(a,b), b))` — which agrees with
    core's `%` on ALL divisors: at `B = 0` SMT-LIB gives
    `A udiv 0 = allOnes` and `allOnes * 0 = 0`, so the output is
    `A - 0 = A`, exactly `BitVec.umod_zero`
    (`umod_eq_sub_smtUDiv_mul`). Gate count, summed stage by stage:
    `12·w² + 8·w` (udiv) `+ 10·w²` (mul) `+ 9·w` (sub). -/
theorem blast_urem_bitvec (aig : Aig) (a b : Slice Lit)
    (hab : a.val.length ≤ b.val.length)
    (hcap : aig.nodes.val.length
      + (12 * a.val.length * a.val.length + 8 * a.val.length)
      + 10 * a.val.length * a.val.length
      + 9 * a.val.length
      ≤ Usize.max)
    (ha : ∀ l ∈ a.val, l.node.val < aig.nodes.val.length)
    (hb : ∀ l ∈ b.val, l.node.val < aig.nodes.val.length)
    (hne : 0 < aig.nodes.val.length)
    (h0 : aig.nodes.val[0]'hne = Node.False)
    {w : Nat} (A B : BitVec w) :
    blast_urem aig a b ⦃ p =>
      ∀ (inputs : Slice Bool), AigWF aig.nodes.val inputs.val.length →
        simulate p.2 inputs ⦃ vals =>
          Denotes vals.val a.val w A → Denotes vals.val b.val w B →
          Denotes vals.val p.1.val w (A % B) ⦄ ⦄ := by
  unfold blast_urem
  -- stage 1: the quotient word `q` denotes `A.smtUDiv B` (under aig1)
  step with (blast_udiv_full aig a b hab (by omega) ha hb hne h0 A B) as
    ⟨q, aig1, hql, hpre1, hlen1, hwf1, hqrng, hsimQ⟩
  have hderefq : (alloc.vec.Vec.deref q).val = q.val := rfl
  have hqlen' : (alloc.vec.Vec.deref q).val.length = a.val.length := by
    rw [hderefq, hql]
  have hne1 : 0 < aig1.nodes.val.length := by
    have := hpre1.length_le
    omega
  have h01 : aig1.nodes.val[0]'hne1 = Node.False :=
    node0_of_prefix hpre1 hne h0 hne1
  have hb1 : ∀ l ∈ b.val, l.node.val < aig1.nodes.val.length := by
    intro l hl
    have h1 := hb l hl
    have h2 := hpre1.length_le
    omega
  have hqrng' : ∀ l ∈ (alloc.vec.Vec.deref q).val,
      l.node.val < aig1.nodes.val.length := by
    rw [hderefq]
    exact hqrng
  -- stage 2: the product word denotes `A.smtUDiv B * B` (under aig2)
  step with (blast_mul_full aig1 (alloc.vec.Vec.deref q) b
    (by omega) (by rw [hqlen']; omega) hqrng' hb1 hne1 h01
    (A.smtUDiv B) B) as
    ⟨prod, aig2, hpl, hpre2, hlen2, hwf2, hprng, hsimM⟩
  rw [hqlen'] at hpl hlen2
  have hderefp : (alloc.vec.Vec.deref prod).val = prod.val := rfl
  have hplen' : (alloc.vec.Vec.deref prod).val.length = a.val.length := by
    rw [hderefp]
    exact hpl
  have hne2 : 0 < aig2.nodes.val.length := by
    have := hpre2.length_le
    omega
  have h02 : aig2.nodes.val[0]'hne2 = Node.False :=
    node0_of_prefix hpre2 hne1 h01 hne2
  have ha2 : ∀ l ∈ a.val, l.node.val < aig2.nodes.val.length := by
    intro l hl
    have h1 := ha l hl
    have h2 := hpre1.length_le
    have h3 := hpre2.length_le
    omega
  have hprng' : ∀ l ∈ (alloc.vec.Vec.deref prod).val,
      l.node.val < aig2.nodes.val.length := by
    rw [hderefp]
    exact hprng
  -- stage 3: subtract, then rewrite with the umod identity
  apply WP.spec_mono (spec_and
    (blast_sub_frame aig2 a (alloc.vec.Vec.deref prod)
      (by omega) (by omega) ha2 hprng' hne2)
    (blast_sub_bitvec aig2 a (alloc.vec.Vec.deref prod)
      (by omega) (by omega) ha2 hprng' hne2 h02 A (A.smtUDiv B * B)))
  rintro ⟨out, aig3⟩ ⟨⟨_, hpre3, _, hwf3⟩, hsimS⟩
  intro inputs hwfI
  have hwfI1 : AigWF aig1.nodes.val inputs.val.length := hwf1 _ hwfI
  have hwfI2 : AigWF aig2.nodes.val inputs.val.length := hwf2 _ hwfI1
  have hwfI3 : AigWF aig3.nodes.val inputs.val.length := hwf3 _ hwfI2
  apply WP.spec_mono (spec_and (simulate_spec aig3 inputs hwfI3)
    (hsimS inputs hwfI2))
  rintro vals ⟨hv, himp⟩
  intro hA hB
  rw [hv, hderefp] at himp
  rw [hv] at hA hB ⊢
  -- transport the operand denotations down to the ORIGINAL aig …
  have hpre03 : aig.nodes.val <+: aig3.nodes.val :=
    hpre1.trans (hpre2.trans hpre3)
  have hA0 : Denotes (pSim inputs.val aig.nodes.val) a.val w A :=
    hA.of_prefix hpre03 ha inputs.val
  have hB0 : Denotes (pSim inputs.val aig.nodes.val) b.val w B :=
    hB.of_prefix hpre03 hb inputs.val
  -- … harvest the udiv semantics under aig1 …
  obtain ⟨v1, hv1, hf1⟩ :=
    simulate_spec_pSim aig1 inputs hwfI1 (hsimQ inputs hwfI)
  rw [hv1] at hf1
  have hQ1 : Denotes (pSim inputs.val aig1.nodes.val) q.val w
      (A.smtUDiv B) :=
    hf1 (hA0.up hpre1 ha inputs.val) (hB0.up hpre1 hb inputs.val)
  -- … the mul semantics under aig2 …
  obtain ⟨v2, hv2, hf2⟩ :=
    simulate_spec_pSim aig2 inputs hwfI2 (hsimM inputs hwfI1)
  rw [hv2, hderefq] at hf2
  have hP2 : Denotes (pSim inputs.val aig2.nodes.val) prod.val w
      (A.smtUDiv B * B) :=
    hf2 (hQ1.up hpre2 hqrng inputs.val)
      (hB0.up (hpre1.trans hpre2) hb inputs.val)
  -- … lift the product to the final aig and conclude via the identity
  have hP3 : Denotes (pSim inputs.val aig3.nodes.val) prod.val w
      (A.smtUDiv B * B) :=
    hP2.up hpre3 hprng inputs.val
  rw [umod_eq_sub_smtUDiv_mul A B]
  exact himp hA hP3

end blast_kernel.spec
