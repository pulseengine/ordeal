  · exact BlastInv.init (· ^^ ·) 3 aig a b

/- ══════════════ END-TO-END: BLAST THEN SIMULATE ══════════════ -/

/-- **Correctness of `blast_and` against the simulator** (issue #68): after
    blasting, simulating the extended aig on ANY well-formed input assignment
    gives, for each output bit `j`, exactly the conjunction of the values the
    two input literals take under the SAME simulation. `pEvalLit vals.val l`
    is `vals[l.node] XOR l.neg`. Unbounded: `a`/`b` have arbitrary length. -/
theorem blast_and_correct (aig : Aig) (a b : Slice Lit)
    (hab : a.val.length ≤ b.val.length)
    (hcap : aig.nodes.val.length + a.val.length ≤ Usize.max)
    (ha : ∀ l ∈ a.val, l.node.val < aig.nodes.val.length)
    (hb : ∀ l ∈ b.val, l.node.val < aig.nodes.val.length) :
    blast_and aig a b ⦃ p =>
      p.1.val.length = a.val.length ∧
      ∀ (inputs : Slice Bool), AigWF aig.nodes.val inputs.val.length →
        simulate p.2 inputs ⦃ vals =>
          ∀ (j : Nat) (hj1 : j < p.1.val.length) (hj2 : j < a.val.length)
            (hj3 : j < b.val.length),
            pEvalLit vals.val p.1.val[j]
              = (pEvalLit vals.val a.val[j] && pEvalLit vals.val b.val[j]) ⦄ ⦄ := by
  apply WP.spec_mono (blast_and_spec aig a b hab hcap ha hb)
  rintro ⟨out, aig'⟩ ⟨h1, h2, h3, h4, h5, h6⟩
  refine ⟨h1, fun inputs hwf => ?_⟩
  apply WP.spec_mono (simulate_spec aig' inputs (h4 _ hwf))
  intro vals hv j hj1 hj2 hj3
  rw [hv, pEvalLit_stable h2 _ (ha _ (List.getElem_mem _)) inputs.val,
    pEvalLit_stable h2 _ (hb _ (List.getElem_mem _)) inputs.val]
  exact h6 inputs.val j hj1 hj2 hj3

/-- **Correctness of `blast_or` against the simulator.** -/
theorem blast_or_correct (aig : Aig) (a b : Slice Lit)
    (hab : a.val.length ≤ b.val.length)
    (hcap : aig.nodes.val.length + a.val.length ≤ Usize.max)
    (ha : ∀ l ∈ a.val, l.node.val < aig.nodes.val.length)
    (hb : ∀ l ∈ b.val, l.node.val < aig.nodes.val.length) :
    blast_or aig a b ⦃ p =>
      p.1.val.length = a.val.length ∧
      ∀ (inputs : Slice Bool), AigWF aig.nodes.val inputs.val.length →
        simulate p.2 inputs ⦃ vals =>
          ∀ (j : Nat) (hj1 : j < p.1.val.length) (hj2 : j < a.val.length)
            (hj3 : j < b.val.length),
            pEvalLit vals.val p.1.val[j]
              = (pEvalLit vals.val a.val[j] || pEvalLit vals.val b.val[j]) ⦄ ⦄ := by
  apply WP.spec_mono (blast_or_spec aig a b hab hcap ha hb)
  rintro ⟨out, aig'⟩ ⟨h1, h2, h3, h4, h5, h6⟩
  refine ⟨h1, fun inputs hwf => ?_⟩
  apply WP.spec_mono (simulate_spec aig' inputs (h4 _ hwf))
  intro vals hv j hj1 hj2 hj3
  rw [hv, pEvalLit_stable h2 _ (ha _ (List.getElem_mem _)) inputs.val,
    pEvalLit_stable h2 _ (hb _ (List.getElem_mem _)) inputs.val]
  exact h6 inputs.val j hj1 hj2 hj3

/-- **Correctness of `blast_xor` against the simulator.** -/
theorem blast_xor_correct (aig : Aig) (a b : Slice Lit)
    (hab : a.val.length ≤ b.val.length)
    (hcap : aig.nodes.val.length + 3 * a.val.length ≤ Usize.max)
    (ha : ∀ l ∈ a.val, l.node.val < aig.nodes.val.length)
    (hb : ∀ l ∈ b.val, l.node.val < aig.nodes.val.length) :
