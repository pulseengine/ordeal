/- ══════════════ THE BITVEC SEMANTICS (UNBOUNDED WIDTH) ══════════════ -/

/-- A word of literals denotes a `BitVec w` under a value list: bit `j` of the
    bitvector is the value of the `j`-th literal (LSB first). -/
def Denotes (vals : List Bool) (word : List Lit) (w : Nat) (v : BitVec w) : Prop :=
  word.length = w ∧
  ∀ (j : Nat) (hj : j < word.length), pEvalLit vals word[j] = v.getLsbD j

/-- Generic lifting of a per-bit identity to `Denotes`. -/
theorem Denotes.of_bits {vals : List Bool} {a b out : List Lit} {w : Nat}
    {A B C : BitVec w} {op : Bool → Bool → Bool}
    (hA : Denotes vals a w A) (hB : Denotes vals b w B)
    (hC : ∀ j, j < w → C.getLsbD j = op (A.getLsbD j) (B.getLsbD j))
    (hlen : out.length = a.length)
    (hbit : ∀ (j : Nat) (hj1 : j < out.length) (hj2 : j < a.length)
      (hj3 : j < b.length),
      pEvalLit vals out[j] = op (pEvalLit vals a[j]) (pEvalLit vals b[j])) :
    Denotes vals out w C := by
  obtain ⟨hal, hA⟩ := hA
  obtain ⟨hbl, hB⟩ := hB
  refine ⟨by omega, fun j hj => ?_⟩
  rw [hbit j hj (by omega) (by omega), hA j (by omega), hB j (by omega),
    hC j (by omega)]

/-- **`blast_and` implements `BitVec` AND, for every width `w`**: if the input
    words denote `A` and `B` under the post-blast simulation, the output word
    denotes `A &&& B`. -/
theorem blast_and_bitvec (aig : Aig) (a b : Slice Lit)
    (hab : a.val.length ≤ b.val.length)
    (hcap : aig.nodes.val.length + a.val.length ≤ Usize.max)
    (ha : ∀ l ∈ a.val, l.node.val < aig.nodes.val.length)
    (hb : ∀ l ∈ b.val, l.node.val < aig.nodes.val.length)
    {w : Nat} (A B : BitVec w) :
    blast_and aig a b ⦃ p =>
      ∀ (inputs : Slice Bool), AigWF aig.nodes.val inputs.val.length →
        simulate p.2 inputs ⦃ vals =>
          Denotes vals.val a.val w A → Denotes vals.val b.val w B →
          Denotes vals.val p.1.val w (A &&& B) ⦄ ⦄ := by
  apply WP.spec_mono (blast_and_correct aig a b hab hcap ha hb)
  rintro ⟨out, aig'⟩ ⟨hlen, hsim⟩
  intro inputs hwf
  apply WP.spec_mono (hsim inputs hwf)
  intro vals hbit hA hB
  exact Denotes.of_bits hA hB (fun j _ => by simp) hlen hbit

/-- **`blast_or` implements `BitVec` OR, for every width `w`.** -/
theorem blast_or_bitvec (aig : Aig) (a b : Slice Lit)
    (hab : a.val.length ≤ b.val.length)
    (hcap : aig.nodes.val.length + a.val.length ≤ Usize.max)
    (ha : ∀ l ∈ a.val, l.node.val < aig.nodes.val.length)
    (hb : ∀ l ∈ b.val, l.node.val < aig.nodes.val.length)
    {w : Nat} (A B : BitVec w) :
    blast_or aig a b ⦃ p =>
      ∀ (inputs : Slice Bool), AigWF aig.nodes.val inputs.val.length →
        simulate p.2 inputs ⦃ vals =>
          Denotes vals.val a.val w A → Denotes vals.val b.val w B →
          Denotes vals.val p.1.val w (A ||| B) ⦄ ⦄ := by
  apply WP.spec_mono (blast_or_correct aig a b hab hcap ha hb)
  rintro ⟨out, aig'⟩ ⟨hlen, hsim⟩
  intro inputs hwf
  apply WP.spec_mono (hsim inputs hwf)
  intro vals hbit hA hB
  exact Denotes.of_bits hA hB (fun j _ => by simp) hlen hbit

/-- **`blast_xor` implements `BitVec` XOR, for every width `w`.** -/
theorem blast_xor_bitvec (aig : Aig) (a b : Slice Lit)
    (hab : a.val.length ≤ b.val.length)
    (hcap : aig.nodes.val.length + 3 * a.val.length ≤ Usize.max)
    (ha : ∀ l ∈ a.val, l.node.val < aig.nodes.val.length)
    (hb : ∀ l ∈ b.val, l.node.val < aig.nodes.val.length)
    {w : Nat} (A B : BitVec w) :
    blast_xor aig a b ⦃ p =>
      ∀ (inputs : Slice Bool), AigWF aig.nodes.val inputs.val.length →
        simulate p.2 inputs ⦃ vals =>
          Denotes vals.val a.val w A → Denotes vals.val b.val w B →
          Denotes vals.val p.1.val w (A ^^^ B) ⦄ ⦄ := by
  apply WP.spec_mono (blast_xor_correct aig a b hab hcap ha hb)
  rintro ⟨out, aig'⟩ ⟨hlen, hsim⟩
  intro inputs hwf
  apply WP.spec_mono (hsim inputs hwf)
  intro vals hbit hA hB
  exact Denotes.of_bits hA hB (fun j _ => by simp) hlen hbit

end blast_kernel.spec
