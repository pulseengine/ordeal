      ∀ l' < k.val, cargs.val.getD (s1.val + l') 0#usize = cargs.val.getD (s2.val + l') 0#usize ⦄ := by
  unfold kernel.sliver_kernel.args_eq_loop
  apply loop.spec_decr_nat
    (measure := fun (st : Bool × Std.Usize) => k.val - st.2.val)
    (inv := fun (st : Bool × Std.Usize) => st.2.val ≤ k.val ∧ (st.1 = true ↔ ∀ l' < st.2.val,
      cargs.val.getD (s1.val + l') 0#usize = cargs.val.getD (s2.val + l') 0#usize))
  · rintro ⟨ok2, l1⟩ ⟨hle, hok⟩
    dsimp only at hle hok
    unfold kernel.sliver_kernel.args_eq_loop.body
    try dsimp only
    split
    · rename_i hokt
      have hall := hok.mp hokt
      split
      · rename_i hlt
        have hlt' : l1.val < k.val := by scalar_tac
        step as ⟨i, hi⟩
        have hi' : i.val < cargs.val.length := by scalar_tac
        step as ⟨i1, hi1⟩
        step as ⟨i2, hi2⟩
        have hi2' : i2.val < cargs.val.length := by scalar_tac
        step as ⟨i3, hi3⟩
        have hg1 : cargs.val.getD (s1.val + l1.val) 0#usize = i1 := by
          rw [← hi, getD_eq_getElem_of_lt hi', hi1]
        have hg2 : cargs.val.getD (s2.val + l1.val) 0#usize = i3 := by
          rw [← hi2, getD_eq_getElem_of_lt hi2', hi3]
        split
        · rename_i hne
          have hne' : i1 ≠ i3 := by simpa using hne
          step as ⟨l2, hl2⟩
          and_intros
          · scalar_tac
          · constructor
            · intro h; cases h
            · intro h
              exfalso
              apply hne'
              rw [← hg1, ← hg2]
              exact h l1.val (by rw [hl2]; omega)
          · scalar_tac
        · rename_i hne
          have hne' : i1 = i3 := UScalar.eq_of_val_eq (by simpa using hne)
          step as ⟨l2, hl2⟩
          and_intros
          · scalar_tac
          · constructor
            · intro _ l' hl'
              rw [hl2] at hl'
              rcases Nat.lt_or_ge l' l1.val with h | h
              · exact hall l' h
              · have : l' = l1.val := by omega
                subst this
                rw [hg1, hg2, hne']
            · intro _; trivial
          · scalar_tac
      · rename_i hge
        have hleq : l1.val = k.val := by scalar_tac
        try simp only [WP.spec_ok]
