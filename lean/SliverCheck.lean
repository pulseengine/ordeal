/-- What `chain_walk` establishes: the walk resolves (classes untouched), or
    it ends at a read variable registered for `(aid, img j)` which becomes
    class 4. -/
theorem chain_walk_spec (e : Slice ExtNode) (ebits : Slice Bool) (eside map : Slice Std.Usize)
    (t : Slice blast_kernel.DagNode) (reads cls ent : Slice Std.Usize) (aid j s k k0 : Std.Usize)
    (hcls : cls.val.length = t.val.length) (hent : ent.val.length = t.val.length)
    (hlev : ∀ l' < k.val, s.val + 2 * l' + 1 < eside.val.length) :
    kernel.sliver_kernel.chain_walk e ebits eside map t reads cls ent aid j s k k0 ⦃ r =>
      (r.1 = false → r.2 = cls) ∧
      (r.1 = true →
        (pWalk e.val ebits.val eside.val map.val t.val j k.val s.val k0 = .resolved ∧ r.2 = cls) ∨
        (∃ cur : Std.Usize, pWalk e.val ebits.val eside.val map.val t.val j k.val s.val k0 = .base cur ∧
          cur.val < t.val.length ∧
          (cls.val.getD cur.val 0#usize = 2#usize ∨ cls.val.getD cur.val 0#usize = 4#usize) ∧
          (ent.val.getD cur.val 0#usize).val + 2 < reads.val.length ∧
          reads.val.getD ((ent.val.getD cur.val 0#usize).val + 1) 0#usize = aid ∧
          reads.val.getD ((ent.val.getD cur.val 0#usize).val + 2) 0#usize = img map.val j.val ∧
          r.2.val = cls.val.set cur.val 4#usize)) ⦄ := by
  unfold kernel.sliver_kernel.chain_walk
  try dsimp only
  rw [node_tag_eq]
  simp only [bind_tc_ok]
  have hinv0 : WalkInv (pWalk e.val ebits.val eside.val map.val t.val j) k.val s.val k0
      (k0, true, false, 0#usize, s) := by
    unfold WalkInv
    refine ⟨(by simp), ⟨fun _ => ⟨(by simp), ⟨fun _ => (by simp), fun h => (by cases h)⟩⟩,
      fun h => (by cases h)⟩⟩
  step with (chain_walk_loop_spec e ebits eside map t j k (Slice.len t) _ k0 true false 0#usize s s k0
    (by simp) rfl hlev hinv0) as ⟨cur, ok1, done1, hr⟩
  obtain ⟨hres, hbase, hfail⟩ := hr
  try dsimp only at hres hbase hfail
  split
  · rename_i hokt
    split
    · rename_i hdt
      rw [WP.spec_ok]
      exact ⟨fun h => (by cases h), fun _ => Or.inl ⟨hres hokt hdt, rfl⟩⟩
    · rename_i hdf
      have hdf' : done1 = false := by simpa using hdf
      rw [map_at_eq]
      simp only [bind_tc_ok]
      step with (base_read_ok_spec t reads cls ent aid (img map.val j.val) cur hcls hent) as ⟨ok2, hok2⟩
      split
      · rename_i hok2t
        obtain ⟨hcur, hc24, ho, haid, hxj⟩ := hok2 hok2t
        have hcur' : cur.val < cls.val.length := by rw [hcls]; exact hcur
        step as ⟨cls1, hcls1⟩
        try rw [WP.spec_ok]
        refine ⟨fun h => (by cases h), fun _ => Or.inr ⟨cur, hbase hokt hdf', hcur, hc24, ho, haid, hxj, ?_⟩⟩
        simp [hcls1]
      · rw [WP.spec_ok]
        exact ⟨fun _ => rfl, fun h => (by cases h)⟩
  · rw [WP.spec_ok]
    exact ⟨fun _ => rfl, fun h => (by cases h)⟩

/- ══════════════════ ONE EXTENDED NODE ══════════════════ -/

theorem getD_set_self {α : Type} (l : List α) (i : Nat) (v d : α) (h : i < l.length) :
    (l.set i v).getD i d = v := by
  rw [List.getD_eq_getElem?_getD, List.getElem?_set_self h]
  rfl

theorem getD_set_ne {α : Type} (l : List α) (i j : Nat) (v d : α) (h : i ≠ j) :
    (l.set i v).getD j d = l.getD j d := by
  rw [List.getD_eq_getElem?_getD, List.getElem?_set_ne h, ← List.getD_eq_getElem?_getD]

/-- What `core_corr` establishes on `Ok`: the closed correspondence, and
    the class bookkeeping (a variable claims class 1 of an unclassified
    image; nothing else touches the classes). -/
theorem core_corr_spec (ebits : Slice Bool) (map : Slice Std.Usize) (tbits : Slice Bool)
    (nd d : blast_kernel.DagNode) (cls : Slice Std.Usize) (i mi : Std.Usize)
    (hmi : mi.val < cls.val.length) :
    kernel.sliver_kernel.core_corr ebits map tbits nd d cls i mi ⦃ r =>
      match r with
      | (core.result.Result.Ok _, cls') =>
        CoreCorr ebits.val tbits.val map.val nd d ∧
        (∀ w, nd = .Var w → cls.val.getD mi.val 0#usize = 0#usize ∧ cls'.val = cls.val.set mi.val 1#usize) ∧
        ((∀ w, nd ≠ .Var w) → cls' = cls)
      | (core.result.Result.Err _, cls') => cls' = cls ⦄ := by
  unfold kernel.sliver_kernel.core_corr
  try dsimp only
  simp only [node_tag_eq, node_f1_eq, node_f2_eq, bind_tc_ok]
  split
  · -- a variable
    rename_i h0
    obtain ⟨w, hw⟩ := (pTag_eq_zero nd).mp h0
    split
    · simp
    · rename_i hd0
      have hd0' : pTag d = 0#usize := UScalar.eq_of_val_eq (by simpa using hd0)
      obtain ⟨w', hw'⟩ := (pTag_eq_zero d).mp hd0'
      split
      · simp
      · rename_i hf1
        have hf1' : pF1 nd = pF1 d := UScalar.eq_of_val_eq (by simpa using hf1)
        rw [hw, hw'] at hf1'
        have hww : w = w' := by simpa [pF1] using hf1'
        step as ⟨c, hc⟩
        split
        · simp
        · rename_i hc0
          have hc0' : c = 0#usize := UScalar.eq_of_val_eq (by simpa using hc0)
          step as ⟨cls1, hcls1⟩
          try rw [WP.spec_ok]
          refine ⟨?_, ?_, ?_⟩
          · rw [hw, hw', CoreCorr_var, hww]
          · intro _ _
            refine ⟨?_, ?_⟩
            · rw [getD_eq_getElem_of_lt hmi, ← hc, hc0']
            · simp [hcls1]
          · intro hnv
            exact absurd hw (hnv w)
  · rename_i h0
    split
    · -- a constant
      rename_i h1
      obtain ⟨s0, w, hw⟩ := (pTag_eq_one nd).mp h1
      split
      · simp
      · rename_i hd1
        have hd1' : pTag d = 1#usize := UScalar.eq_of_val_eq (by simpa using hd1)
        obtain ⟨s1, w', hw'⟩ := (pTag_eq_one d).mp hd1'
        split
        · simp
        · rename_i hf2
          have hf2' : pF2 nd = pF2 d := UScalar.eq_of_val_eq (by simpa using hf2)
          rw [hw, hw'] at hf2'
          have hww : w = w' := by simpa [pF2] using hf2'
          rw [bits_eq_eq]
          simp only [bind_tc_ok]
          split
          · rename_i hbt
            have hbe : BitsEq ebits.val (pF1 nd).val tbits.val (pF1 d).val (pF2 nd).val :=
              of_decide_eq_true hbt
            try rw [WP.spec_ok]
            refine ⟨?_, ?_, ?_⟩
            · rw [hw, hw', CoreCorr_const]
              refine ⟨s1, by rw [hww], ?_⟩
              rw [hw, hw'] at hbe
              simpa [pF1, pF2] using hbe.2.2
            · intro w0 hw0
              rw [hw] at hw0
              cases hw0
            · intro _
              rfl
          · simp
    · rename_i h1
      have hop : IsOp nd := isOp_of_tag nd h0 h1
      rw [map_node_eq]
      simp only [bind_tc_ok]
      obtain ⟨b, hb⟩ := node_eq_ok (pMapNode map.val nd) d
      rw [hb]
      simp only [bind_tc_ok]
      split
      · rename_i hbt
        subst hbt
        try rw [WP.spec_ok]
        refine ⟨?_, ?_, ?_⟩
        · rw [CoreCorr_op _ _ _ _ _ hop]
          exact node_eq_sound _ _ hb
        · intro w0 hw0
          exact absurd hw0 (hop.1 w0)
        · intro _
          rfl
      · simp

/-- What `call_corr` establishes on `true`: the image is a call-class
    variable of the call's width whose registered entry is for the call's
    function and arity, over the images of the arguments; it becomes
    class 5. -/
theorem call_corr_spec (eside map : Slice Std.Usize) (t : Slice blast_kernel.DagNode)
    (calls cargs cls ent : Slice Std.Usize) (fid w s k mi : Std.Usize)
    (hmi : mi.val < t.val.length) (hcls : cls.val.length = t.val.length)
    (hent : ent.val.length = t.val.length)
    (hs : ∀ l < k.val, s.val + l < eside.val.length)
    (h4 : (cls.val.getD mi.val 0#usize = 3#usize ∨ cls.val.getD mi.val 0#usize = 5#usize) →
      (ent.val.getD mi.val 0#usize).val % 4 = 0)
    (hargs : ∀ c, IsCall calls.val c → (clS calls.val c).val + (clK calls.val c).val ≤ cargs.val.length) :
    kernel.sliver_kernel.call_corr eside map t calls cargs cls ent fid w s k mi ⦃ r =>
      (r.1 = false → r.2 = cls) ∧
      (r.1 = true →
        (cls.val.getD mi.val 0#usize = 3#usize ∨ cls.val.getD mi.val 0#usize = 5#usize) ∧
        t.val.getD mi.val dfltNode = .Var w ∧
        (∃ c, IsCall calls.val c ∧ 4 * c = (ent.val.getD mi.val 0#usize).val ∧
          clF calls.val c = fid ∧ clK calls.val c = k ∧
          ∀ l < k.val, img map.val (eside.val.getD (s.val + l) 0#usize).val = clArg calls.val cargs.val c l) ∧
        r.2.val = cls.val.set mi.val 5#usize) ⦄ := by
  unfold kernel.sliver_kernel.call_corr
  try dsimp only
  have hmi' : mi.val < cls.val.length := by rw [hcls]; exact hmi
  have hmi'' : mi.val < ent.val.length := by rw [hent]; exact hmi
  step as ⟨c, hc⟩
  rw [call_class_eq]
  simp only [bind_tc_ok]
  have hcg : cls.val.getD mi.val 0#usize = c := by rw [getD_eq_getElem_of_lt hmi', hc]
  split
  · rename_i hlive
    have hlive' : c = 3#usize ∨ c = 5#usize := by simpa using hlive
    have h4' := h4 (by rw [hcg]; exact hlive')
    step as ⟨dn, hdn⟩
    obtain ⟨b, hb⟩ := node_eq_ok dn (.Var w)
    rw [hb]
    simp only [bind_tc_ok]
    split
    · rename_i hbt
      subst hbt
      have hdn' := node_eq_sound _ _ hb
      step as ⟨o, ho⟩
      have hog : ent.val.getD mi.val 0#usize = o := by rw [getD_eq_getElem_of_lt hmi'', ho]
      rw [hog] at h4'
      split
      · try rw [WP.spec_ok]
        exact ⟨fun _ => rfl, fun h => (by cases h)⟩
      · rename_i holt
        step as ⟨i2, hi2⟩
        split
        · try rw [WP.spec_ok]
          exact ⟨fun _ => rfl, fun h => (by cases h)⟩
        · rename_i hge4
          have ho3 : o.val + 3 < calls.val.length := by scalar_tac
          have hic : IsCall calls.val (o.val / 4) := by
            unfold IsCall
            omega
          step as ⟨i3, hi3⟩
          have hi3' : i3.val < calls.val.length := by scalar_tac
          step as ⟨i4, hi4⟩
          have hfg : clF calls.val (o.val / 4) = i4 := by
            unfold clF
            have : 4 * (o.val / 4) + 1 = i3.val := by omega
            rw [this, getD_eq_getElem_of_lt hi3', hi4]
          -- the verdict `ok1`
          have hfin : ∀ (ok1 : Bool),
              (ok1 = true → clF calls.val (o.val / 4) = fid ∧ clK calls.val (o.val / 4) = k ∧
                ∀ l < k.val, img map.val (eside.val.getD (s.val + l) 0#usize).val
                  = clArg calls.val cargs.val (o.val / 4) l) →
              (if ok1 = true then
                (do
                  let cls1 ← Slice.update cls mi 5#usize
                  ok (true, cls1))
              else ok (false, cls) : Result (Bool × Slice Std.Usize)) ⦃ r =>
                (r.1 = false → r.2 = cls) ∧
                (r.1 = true →
                  (cls.val.getD mi.val 0#usize = 3#usize ∨ cls.val.getD mi.val 0#usize = 5#usize) ∧
                  t.val.getD mi.val dfltNode = .Var w ∧
                  (∃ c, IsCall calls.val c ∧ 4 * c = (ent.val.getD mi.val 0#usize).val ∧
                    clF calls.val c = fid ∧ clK calls.val c = k ∧
                    ∀ l < k.val, img map.val (eside.val.getD (s.val + l) 0#usize).val
                      = clArg calls.val cargs.val c l) ∧
                  r.2.val = cls.val.set mi.val 5#usize) ⦄ := by
            intro ok1 hok1
            split
            · rename_i hokt
              obtain ⟨hf, hk, ha⟩ := hok1 hokt
              step as ⟨cls1, hcls1⟩
              try rw [WP.spec_ok]
              refine ⟨fun h => (by cases h), fun _ => ⟨?_, ?_, ⟨o.val / 4, hic, ?_, hf, hk, ha⟩, ?_⟩⟩
              · rw [hcg]; exact hlive'
              · rw [getD_eq_getElem_of_lt hmi, ← hdn, hdn']
              · rw [hog]; omega
              · simp [hcls1]
            · try rw [WP.spec_ok]
              exact ⟨fun _ => rfl, fun h => (by cases h)⟩
          split
          · rename_i hfid
            step as ⟨i5, hi5⟩
            have hi5' : i5.val < calls.val.length := by scalar_tac
            step as ⟨i6, hi6⟩
            have hkg : clK calls.val (o.val / 4) = i6 := by
              unfold clK
              have : 4 * (o.val / 4) + 3 = i5.val := by omega
              rw [this, getD_eq_getElem_of_lt hi5', hi6]
            split
            · rename_i hk
              step as ⟨i7, hi7⟩
              have hi7' : i7.val < calls.val.length := by scalar_tac
              step as ⟨i8, hi8⟩
              have hsg : clS calls.val (o.val / 4) = i8 := by
                unfold clS
                have : 4 * (o.val / 4) + 2 = i7.val := by omega
                rw [this, getD_eq_getElem_of_lt hi7', hi8]
              have hrng := hargs _ hic
              rw [hsg, hkg, hk] at hrng
              step with (args_match_spec eside map cargs s i8 k hs
                (fun l hl => by omega)) as ⟨b1, hb1⟩
              apply hfin
              intro hb1t
              refine ⟨by rw [hfg]; exact hfid, by rw [hkg]; exact hk, ?_⟩
              intro l hl
              unfold clArg
              rw [hsg]
              exact hb1 hb1t l hl
            · rename_i hk
              simp only [bind_tc_ok]
              apply hfin
              intro h; cases h
          · rename_i hfid
            simp only [bind_tc_ok]
            apply hfin
            intro h; cases h
    · try rw [WP.spec_ok]
      exact ⟨fun _ => rfl, fun h => (by cases h)⟩
  · try rw [WP.spec_ok]
    exact ⟨fun _ => rfl, fun h => (by cases h)⟩

/- ══════════════════ THE CLASS TABLE ══════════════════ -/

/-- The class table (`cls`) and entry table (`ent`) after the first `n`
    extended nodes of the main loop: class 1 is exactly the images of the
    mapped extended variables below `n`, classes 2 / 4 exactly the read
    variables (4: reached by a select below `n`), classes 3 / 5 exactly
    the call variables (5: reached by a call below `n`); `ent` holds every
    table variable's entry offset. -/
structure ClsFacts (e : List ExtNode) (ebits : List Bool) (eside map : List Std.Usize)
    (t : List blast_kernel.DagNode) (reads calls cargs cls ent : List Std.Usize) (n : Nat) :
    Prop where
  len : cls.length = t.length
  elen : ent.length = t.length
  c1 : ∀ m < t.length, (cls.getD m 0#usize = 1#usize ↔ ∃ u, u < n ∧ ExtVarImg e map u m)
  c2 : ∀ m < t.length, ((cls.getD m 0#usize = 2#usize ∨ cls.getD m 0#usize = 4#usize) ↔
    ∃ r, IsRead reads r ∧ (rdV reads r).val = m)
  c4 : ∀ m < t.length, cls.getD m 0#usize = 4#usize →
    ∃ r i, IsRead reads r ∧ (rdV reads r).val = m ∧ i < n ∧ SelMapsTo e ebits eside map t reads i r
  c3 : ∀ m < t.length, ((cls.getD m 0#usize = 3#usize ∨ cls.getD m 0#usize = 5#usize) ↔
    ∃ c, IsCall calls c ∧ (clV calls c).val = m)
  c5 : ∀ m < t.length, cls.getD m 0#usize = 5#usize →
    ∃ c i, IsCall calls c ∧ (clV calls c).val = m ∧ i < n ∧ CallMapsTo e eside map t calls cargs i c
  ent_r : ∀ r, IsRead reads r → (ent.getD (rdV reads r).val 0#usize).val = 3 * r
  ent_c : ∀ c, IsCall calls c → (ent.getD (clV calls c).val 0#usize).val = 4 * c

/-- A node that is not a mapped variable leaves the facts as they are. -/
theorem clsFacts_next_nomap {e : List ExtNode} {ebits : List Bool} {eside map : List Std.Usize}
    {t : List blast_kernel.DagNode} {reads calls cargs cls ent : List Std.Usize} {n : Nat}
    (hcf : ClsFacts e ebits eside map t reads calls cargs cls ent n)
    (hn : ∀ w, e.getD n dfltExt = .Core (.Var w) → img map n = NONE) :
    ClsFacts e ebits eside map t reads calls cargs cls ent (n + 1) := by
  refine ⟨hcf.len, hcf.elen, ?_, hcf.c2, ?_, hcf.c3, ?_, hcf.ent_r, hcf.ent_c⟩
  · intro m hm
    rw [hcf.c1 m hm]
    constructor
    · rintro ⟨u, hu, h⟩
      exact ⟨u, by omega, h⟩
    · rintro ⟨u, hu, h⟩
      rcases Nat.lt_or_ge u n with hlt | hge
      · exact ⟨u, hlt, h⟩
      · have : u = n := by omega
        subst this
        obtain ⟨_, ⟨w, hw⟩, hne, _⟩ := h
        exact absurd (hn w hw) hne
  · intro m hm h4
    obtain ⟨r, i, h1, h2, h3, h5⟩ := hcf.c4 m hm h4
    exact ⟨r, i, h1, h2, by omega, h5⟩
  · intro m hm h5
    obtain ⟨c, i, h1, h2, h3, h6⟩ := hcf.c5 m hm h5
    exact ⟨c, i, h1, h2, by omega, h6⟩

/-- A mapped variable claims class 1 of its unclassified image, which no
    earlier variable maps to. -/
theorem clsFacts_var {e : List ExtNode} {ebits : List Bool} {eside map : List Std.Usize}
    {t : List blast_kernel.DagNode} {reads calls cargs cls ent : List Std.Usize} {n : Nat}
    (hcf : ClsFacts e ebits eside map t reads calls cargs cls ent n) (hnl : n < e.length)
    (w : Std.Usize) (hv : e.getD n dfltExt = .Core (.Var w)) (hne : img map n ≠ NONE)
    (hm : (img map n).val < t.length) (h0 : cls.getD (img map n).val 0#usize = 0#usize) :
    ClsFacts e ebits eside map t reads calls cargs (cls.set (img map n).val 1#usize) ent (n + 1) ∧
    ∀ u < n, ¬ ExtVarImg e map u (img map n).val := by
  have hm' : (img map n).val < cls.length := by rw [hcf.len]; exact hm
  have hnoE : ∀ u < n, ¬ ExtVarImg e map u (img map n).val := by
    intro u hu hE
    have := (hcf.c1 _ hm).mpr ⟨u, hu, hE⟩
    rw [h0] at this
    cases this
  have hnoR : ∀ r, IsRead reads r → (rdV reads r).val ≠ (img map n).val := by
    intro r hr heq
    have := (hcf.c2 _ hm).mpr ⟨r, hr, heq⟩
    rw [h0] at this
    rcases this with h | h <;> cases h
  have hnoC : ∀ c, IsCall calls c → (clV calls c).val ≠ (img map n).val := by
    intro c hc heq
    have := (hcf.c3 _ hm).mpr ⟨c, hc, heq⟩
    rw [h0] at this
    rcases this with h | h <;> cases h
  refine ⟨⟨by simp [hcf.len], hcf.elen, ?_, ?_, ?_, ?_, ?_, hcf.ent_r, hcf.ent_c⟩, hnoE⟩
  · intro m hmm
    by_cases hmeq : (img map n).val = m
    · subst hmeq
      rw [getD_set_self _ _ _ _ hm']
      constructor
      · intro _
        exact ⟨n, by omega, hnl, ⟨w, hv⟩, hne, rfl⟩
      · intro _; rfl
    · rw [getD_set_ne _ _ _ _ _ hmeq, hcf.c1 m hmm]
      constructor
      · rintro ⟨u, hu, h⟩
        exact ⟨u, by omega, h⟩
      · rintro ⟨u, hu, h⟩
        rcases Nat.lt_or_ge u n with hlt | hge
        · exact ⟨u, hlt, h⟩
        · have : u = n := by omega
          subst this
          exact absurd h.2.2.2 hmeq
  · intro m hmm
    by_cases hmeq : (img map n).val = m
    · subst hmeq
      rw [getD_set_self _ _ _ _ hm']
      constructor
      · rintro (h | h) <;> cases h
      · rintro ⟨r, hr, hrv⟩
        exact absurd hrv (hnoR r hr)
    · rw [getD_set_ne _ _ _ _ _ hmeq]
      exact hcf.c2 m hmm
  · intro m hmm h4
    by_cases hmeq : (img map n).val = m
    · subst hmeq
      rw [getD_set_self _ _ _ _ hm'] at h4
      cases h4
    · rw [getD_set_ne _ _ _ _ _ hmeq] at h4
      obtain ⟨r, i, h1, h2, h3, h5⟩ := hcf.c4 m hmm h4
      exact ⟨r, i, h1, h2, by omega, h5⟩
  · intro m hmm
    by_cases hmeq : (img map n).val = m
    · subst hmeq
      rw [getD_set_self _ _ _ _ hm']
      constructor
      · rintro (h | h) <;> cases h
      · rintro ⟨c, hc, hcv⟩
        exact absurd hcv (hnoC c hc)
    · rw [getD_set_ne _ _ _ _ _ hmeq]
      exact hcf.c3 m hmm
  · intro m hmm h5
    by_cases hmeq : (img map n).val = m
    · subst hmeq
      rw [getD_set_self _ _ _ _ hm'] at h5
      cases h5
    · rw [getD_set_ne _ _ _ _ _ hmeq] at h5
      obtain ⟨c, i, h1, h2, h3, h6⟩ := hcf.c5 m hmm h5
      exact ⟨c, i, h1, h2, by omega, h6⟩

/-- A select whose walk ends at a read variable marks it class 4: it reaches
    the entry registered there. -/
theorem clsFacts_sel {e : List ExtNode} {ebits : List Bool} {eside map : List Std.Usize}
    {t : List blast_kernel.DagNode} {reads calls cargs cls ent : List Std.Usize} {n : Nat}
    (hcf : ClsFacts e ebits eside map t reads calls cargs cls ent n) (hnl : n < e.length)
    (aid j s k : Std.Usize) (hsel : e.getD n dfltExt = .Select aid j s k) (hne : img map n ≠ NONE)
    (cur : Std.Usize) (hw : pWalk e ebits eside map t j k.val s.val (img map n) = .base cur)
    (hcur : cur.val < t.length)
    (hc24 : cls.getD cur.val 0#usize = 2#usize ∨ cls.getD cur.val 0#usize = 4#usize)
    (ho : (ent.getD cur.val 0#usize).val + 2 < reads.length)
    (haid : reads.getD ((ent.getD cur.val 0#usize).val + 1) 0#usize = aid)
    (hxj : reads.getD ((ent.getD cur.val 0#usize).val + 2) 0#usize = img map j.val) :
    ClsFacts e ebits eside map t reads calls cargs (cls.set cur.val 4#usize) ent (n + 1) ∧
    ∃ r, SelMapsTo e ebits eside map t reads n r := by
  have hcur' : cur.val < cls.length := by rw [hcf.len]; exact hcur
  obtain ⟨r, hr, hrv⟩ := (hcf.c2 _ hcur).mp hc24
  have hrv' : rdV reads r = cur := UScalar.eq_of_val_eq hrv
  have hent := hcf.ent_r r hr
  rw [hrv] at hent
  rw [hent] at haid hxj
  have hsm : SelMapsTo e ebits eside map t reads n r :=
    ⟨aid, j, s, k, hnl, hsel, hne, by rw [hw, hrv'], hr, haid, hxj⟩
  have hnoE : ∀ u < n, ¬ ExtVarImg e map u cur.val := by
    intro u hu hE
    have h1 := (hcf.c1 _ hcur).mpr ⟨u, hu, hE⟩
    rcases hc24 with h | h <;> rw [h] at h1 <;> cases h1
  refine ⟨⟨by simp [hcf.len], hcf.elen, ?_, ?_, ?_, ?_, ?_, hcf.ent_r, hcf.ent_c⟩, ⟨r, hsm⟩⟩
  · intro m hmm
    by_cases hmeq : cur.val = m
    · subst hmeq
      rw [getD_set_self _ _ _ _ hcur']
      constructor
      · intro h; cases h
      · rintro ⟨u, hu, hE⟩
        rcases Nat.lt_or_ge u n with hlt | hge
        · exact absurd hE (hnoE u hlt)
        · have : u = n := by omega
          subst this
          obtain ⟨_, ⟨w, hw'⟩, _, _⟩ := hE
          rw [hsel] at hw'
          cases hw'
    · rw [getD_set_ne _ _ _ _ _ hmeq, hcf.c1 m hmm]
      constructor
      · rintro ⟨u, hu, h⟩
        exact ⟨u, by omega, h⟩
      · rintro ⟨u, hu, h⟩
        rcases Nat.lt_or_ge u n with hlt | hge
        · exact ⟨u, hlt, h⟩
        · have : u = n := by omega
          subst this
          obtain ⟨_, ⟨w, hw'⟩, _, _⟩ := h
          rw [hsel] at hw'
          cases hw'
  · intro m hmm
    by_cases hmeq : cur.val = m
    · subst hmeq
      rw [getD_set_self _ _ _ _ hcur']
      constructor
      · intro _; exact ⟨r, hr, hrv⟩
      · intro _; exact Or.inr rfl
    · rw [getD_set_ne _ _ _ _ _ hmeq]
      exact hcf.c2 m hmm
  · intro m hmm h4
    by_cases hmeq : cur.val = m
    · subst hmeq
      exact ⟨r, n, hr, hrv, by omega, hsm⟩
    · rw [getD_set_ne _ _ _ _ _ hmeq] at h4
      obtain ⟨r', i, h1, h2, h3, h5⟩ := hcf.c4 m hmm h4
      exact ⟨r', i, h1, h2, by omega, h5⟩
  · intro m hmm
    by_cases hmeq : cur.val = m
    · subst hmeq
      rw [getD_set_self _ _ _ _ hcur']
      constructor
      · rintro (h | h) <;> cases h
      · rintro ⟨c, hc, hcv⟩
        have := (hcf.c3 _ hcur).mpr ⟨c, hc, hcv⟩
        rcases hc24 with h | h <;> rcases this with h' | h' <;> rw [h] at h' <;> cases h'
    · rw [getD_set_ne _ _ _ _ _ hmeq]
      exact hcf.c3 m hmm
  · intro m hmm h5
    by_cases hmeq : cur.val = m
    · subst hmeq
      rw [getD_set_self _ _ _ _ hcur'] at h5
      cases h5
    · rw [getD_set_ne _ _ _ _ _ hmeq] at h5
      obtain ⟨c, i, h1, h2, h3, h6⟩ := hcf.c5 m hmm h5
      exact ⟨c, i, h1, h2, by omega, h6⟩

/-- A call whose image is a call variable marks it class 5: it reaches the
    entry registered there. -/
theorem clsFacts_call {e : List ExtNode} {ebits : List Bool} {eside map : List Std.Usize}
    {t : List blast_kernel.DagNode} {reads calls cargs cls ent : List Std.Usize} {n : Nat}
    (hcf : ClsFacts e ebits eside map t reads calls cargs cls ent n) (hnl : n < e.length)
    (fid w s k : Std.Usize) (hcall : e.getD n dfltExt = .Call fid w s k) (hne : img map n ≠ NONE)
    (hm : (img map n).val < t.length)
    (hc35 : cls.getD (img map n).val 0#usize = 3#usize ∨ cls.getD (img map n).val 0#usize = 5#usize)
    (hvar : t.getD (img map n).val dfltNode = .Var w)
    (c : Nat) (hic : IsCall calls c) (hoc : 4 * c = (ent.getD (img map n).val 0#usize).val)
    (hf : clF calls c = fid) (hk : clK calls c = k)
    (hargs : ∀ l < k.val, img map (eside.getD (s.val + l) 0#usize).val = clArg calls cargs c l) :
    ClsFacts e ebits eside map t reads calls cargs (cls.set (img map n).val 5#usize) ent (n + 1) ∧
    CallMapsTo e eside map t calls cargs n c := by
  have hm' : (img map n).val < cls.length := by rw [hcf.len]; exact hm
  obtain ⟨c', hc', hcv⟩ := (hcf.c3 _ hm).mp hc35
  have hent := hcf.ent_c c' hc'
  rw [hcv] at hent
  have hcc : c = c' := by omega
  subst hcc
  have hcm : CallMapsTo e eside map t calls cargs n c :=
    ⟨fid, w, s, k, hnl, hcall, hne, hic, UScalar.eq_of_val_eq hcv, hvar, hf, hk, hargs⟩
  have hnoE : ∀ u < n, ¬ ExtVarImg e map u (img map n).val := by
    intro u hu hE
    have h1 := (hcf.c1 _ hm).mpr ⟨u, hu, hE⟩
    rcases hc35 with h | h <;> rw [h] at h1 <;> cases h1
  refine ⟨⟨by simp [hcf.len], hcf.elen, ?_, ?_, ?_, ?_, ?_, hcf.ent_r, hcf.ent_c⟩, hcm⟩
  · intro m hmm
    by_cases hmeq : (img map n).val = m
    · subst hmeq
      rw [getD_set_self _ _ _ _ hm']
      constructor
      · intro h; cases h
      · rintro ⟨u, hu, hE⟩
        rcases Nat.lt_or_ge u n with hlt | hge
        · exact absurd hE (hnoE u hlt)
        · have : u = n := by omega
          subst this
          obtain ⟨_, ⟨w', hw'⟩, _, _⟩ := hE
          rw [hcall] at hw'
          cases hw'
    · rw [getD_set_ne _ _ _ _ _ hmeq, hcf.c1 m hmm]
      constructor
      · rintro ⟨u, hu, h⟩
        exact ⟨u, by omega, h⟩
      · rintro ⟨u, hu, h⟩
        rcases Nat.lt_or_ge u n with hlt | hge
        · exact ⟨u, hlt, h⟩
        · have : u = n := by omega
          subst this
          obtain ⟨_, ⟨w', hw'⟩, _, _⟩ := h
          rw [hcall] at hw'
          cases hw'
  · intro m hmm
    by_cases hmeq : (img map n).val = m
    · subst hmeq
      rw [getD_set_self _ _ _ _ hm']
      constructor
      · rintro (h | h) <;> cases h
      · rintro ⟨r, hr, hrv⟩
        have := (hcf.c2 _ hm).mpr ⟨r, hr, hrv⟩
        rcases hc35 with h | h <;> rcases this with h' | h' <;> rw [h] at h' <;> cases h'
    · rw [getD_set_ne _ _ _ _ _ hmeq]
      exact hcf.c2 m hmm
  · intro m hmm h4
    by_cases hmeq : (img map n).val = m
    · subst hmeq
      rw [getD_set_self _ _ _ _ hm'] at h4
      cases h4
    · rw [getD_set_ne _ _ _ _ _ hmeq] at h4
      obtain ⟨r', i, h1, h2, h3, h5⟩ := hcf.c4 m hmm h4
      exact ⟨r', i, h1, h2, by omega, h5⟩
  · intro m hmm
    by_cases hmeq : (img map n).val = m
    · subst hmeq
      rw [getD_set_self _ _ _ _ hm']
      constructor
      · intro _; exact ⟨c, hic, hcv⟩
      · intro _; exact Or.inr rfl
    · rw [getD_set_ne _ _ _ _ _ hmeq]
      exact hcf.c3 m hmm
  · intro m hmm h5
    by_cases hmeq : (img map n).val = m
    · subst hmeq
      exact ⟨c, n, hic, hcv, by omega, hcm⟩
    · rw [getD_set_ne _ _ _ _ _ hmeq] at h5
      obtain ⟨c'', i, h1, h2, h3, h6⟩ := hcf.c5 m hmm h5
      exact ⟨c'', i, h1, h2, by omega, h6⟩

/-- The main loop's per-node step, at the level of the tables: on `Ok` the
    class facts advance by one node and a mapped node corresponds. -/
theorem ext_step_spec (e : Slice ExtNode) (ebits : Slice Bool) (eside map : Slice Std.Usize)
    (t : Slice blast_kernel.DagNode) (tbits : Slice Bool) (reads calls cargs cls ent : Slice Std.Usize)
    (i : Std.Usize) (ws1 : List Nat)
    (hi : i.val < e.val.length) (hmap : map.val.length = e.val.length)
    (hwf : ExtWF e.val ebits.val.length eside.val)
    (hrt : ReadTable reads.val t.val ws1) (hct : CallTable calls.val cargs.val t.val)
    (hcf : ClsFacts e.val ebits.val eside.val map.val t.val reads.val calls.val cargs.val cls.val ent.val
      i.val) :
    kernel.sliver_kernel.ext_step e ebits eside map t tbits reads calls cargs cls ent i ⦃ r =>
      match r with
      | (core.result.Result.Ok _, cls') =>
        ClsFacts e.val ebits.val eside.val map.val t.val reads.val calls.val cargs.val cls'.val ent.val
          (i.val + 1) ∧
        (img map.val i.val = NONE ∨
          ((img map.val i.val).val < t.val.length ∧
            ExtNodeCorr e.val ebits.val eside.val map.val t.val tbits.val reads.val calls.val cargs.val
              i.val ∧
            (∀ w, e.val.getD i.val dfltExt = .Core (.Var w) →
              ∀ u < i.val, ¬ ExtVarImg e.val map.val u (img map.val i.val).val)))
      | (core.result.Result.Err _, cls') => cls' = cls ⦄ := by
  unfold kernel.sliver_kernel.ext_step
  try dsimp only
  have him : i.val < map.val.length := by rw [hmap]; exact hi
  step as ⟨mi, hmi⟩
  have himg : img map.val i.val = mi := by rw [img_lt him, hmi]
  split
  · rename_i hnone
    try rw [WP.spec_ok]
    refine ⟨?_, Or.inl (by rw [himg, hnone])⟩
    apply clsFacts_next_nomap hcf
    intro w _
    rw [himg, hnone]
  · rename_i hsome
    have hne : img map.val i.val ≠ NONE := by rw [himg]; exact hsome
    split
    · simp
    · rename_i hlt
      have hmi' : mi.val < t.val.length := by scalar_tac
      have hmiv : (img map.val i.val).val < t.val.length := by rw [himg]; exact hmi'
      step as ⟨en, hen⟩
      have heng : e.val.getD i.val dfltExt = en := by rw [getD_eq_getElem_of_lt hi, hen]
      step as ⟨d, hd⟩
      have hdg : t.val.getD mi.val dfltNode = d := by rw [getD_eq_getElem_of_lt hmi', hd]
      have hwfi := hwf i.val hi
      rw [← hen] at hwfi
      cases en with
      | Core nd =>
        have hmic : mi.val < cls.val.length := by rw [hcf.len]; exact hmi'
        step with (core_corr_spec ebits map tbits nd d cls i mi hmic) as ⟨r, hr⟩
        obtain ⟨res, cls'⟩ := r
        cases res with
        | Err err => exact hr
        | Ok u =>
          obtain ⟨hcorr, hvar, hnvar⟩ := hr
          refine ⟨?_, Or.inr ⟨hmiv, ?_, ?_⟩⟩
          · rcases node_shape nd with ⟨w, hw⟩ | ⟨s0, w, hw⟩ | hop
            · obtain ⟨h0, hset⟩ := hvar w hw
              have hcv := clsFacts_var hcf hi w (by rw [heng, hw]) hne hmiv (by rw [himg]; exact h0)
              rw [himg] at hcv
              rw [hset]
              exact hcv.1
            · rw [hnvar (fun w0 hw0 => by rw [hw] at hw0; cases hw0)]
              apply clsFacts_next_nomap hcf
              intro w0 hw0
              rw [heng, hw] at hw0
              cases hw0
            · rw [hnvar hop.1]
              apply clsFacts_next_nomap hcf
              intro w0 hw0
              rw [heng] at hw0
              cases hw0
              exact absurd rfl (hop.1 _)
          · simp only [ExtNodeCorr, heng, himg, hdg]
            exact hcorr
          · intro w hw u hu
            rw [heng] at hw
            cases hw
            obtain ⟨h0, _⟩ := hvar w rfl
            have hcv := clsFacts_var hcf hi w (by rw [heng]) hne hmiv (by rw [himg]; exact h0)
            exact hcv.2 u hu
      | Select aid j s k =>
        obtain ⟨_, _, hlev⟩ := hwfi
        have hlev' : ∀ l' < k.val, s.val + 2 * l' + 1 < eside.val.length :=
          fun l' hl' => (hlev l' hl').1
        step with (chain_walk_spec e ebits eside map t reads cls ent aid j s k mi hcf.len hcf.elen hlev')
          as ⟨b, cls', hbf, hbt⟩
        try dsimp only at hbf hbt
        split
        · rename_i hb1
          rcases hbt hb1 with ⟨hres, hcls'⟩ | ⟨cur, hw, hcur, hc24, ho, haid, hxj, hset⟩
          · refine ⟨?_, Or.inr ⟨hmiv, ?_, ?_⟩⟩
            · rw [hcls']
              apply clsFacts_next_nomap hcf
              intro w0 hw0
              rw [heng] at hw0
              cases hw0
            · simp only [ExtNodeCorr, heng]
              exact Or.inl (by rw [himg]; exact hres)
            · intro w0 hw0
              rw [heng] at hw0
              cases hw0
          · have hcs := clsFacts_sel hcf hi aid j s k (by rw [heng]) hne cur (by rw [himg]; exact hw)
              hcur hc24 ho haid hxj
            refine ⟨?_, Or.inr ⟨hmiv, ?_, ?_⟩⟩
            · rw [hset]
              exact hcs.1
            · simp only [ExtNodeCorr, heng]
              exact Or.inr hcs.2
            · intro w0 hw0
              rw [heng] at hw0
              cases hw0
        · rename_i hb1
          have hb1' : b = false := by simpa using hb1
          rw [hbf hb1', WP.spec_ok]
      | Call fid w s k =>
        obtain ⟨_, hargs⟩ := hwfi
        have hs : ∀ l < k.val, s.val + l < eside.val.length := fun l hl => (hargs l hl).1
        have h4 : (cls.val.getD mi.val 0#usize = 3#usize ∨ cls.val.getD mi.val 0#usize = 5#usize) →
            (ent.val.getD mi.val 0#usize).val % 4 = 0 := by
          intro h35
          obtain ⟨c, hc, hcv⟩ := (hcf.c3 _ hmi').mp h35
          have := hcf.ent_c c hc
          rw [hcv] at this
          rw [this]
          omega
        step with (call_corr_spec eside map t calls cargs cls ent fid w s k mi hmi' hcf.len hcf.elen hs h4
          hct.args_rng) as ⟨b, cls', hbf, hbt⟩
        try dsimp only at hbf hbt
        split
        · rename_i hb1
          obtain ⟨hc35, hvar, ⟨c, hic, hoc, hf, hk, ha⟩, hset⟩ := hbt hb1
          have hcc := clsFacts_call hcf hi fid w s k (by rw [heng]) hne hmiv (by rw [himg]; exact hc35)
            (by rw [himg]; exact hvar) c hic (by rw [himg]; exact hoc) hf hk ha
          rw [himg] at hcc
          refine ⟨?_, Or.inr ⟨hmiv, ?_, ?_⟩⟩
          · rw [hset]
            exact hcc.1
          · simp only [ExtNodeCorr, heng]
            exact ⟨c, hcc.2⟩
          · intro w0 hw0
            rw [heng] at hw0
            cases hw0
        · rename_i hb1
          have hb1' : b = false := by simpa using hb1
          rw [hbf hb1', WP.spec_ok]

/- ══════════════════ THE TABLE LOOPS ══════════════════ -/

theorem check_sliver_lowering_loop0_spec (n1 : Std.Usize) (cls ent : alloc.vec.Vec Std.Usize)
    (k : Std.Usize)
    (hinv : k.val ≤ n1.val ∧ cls.val = List.replicate k.val 0#usize ∧
      ent.val = List.replicate k.val 0#usize) :
    kernel.sliver_kernel.check_sliver_lowering_loop0 n1 cls ent k ⦃ r =>
      r.1.val = List.replicate n1.val 0#usize ∧ r.2.val = List.replicate n1.val 0#usize ⦄ := by
  unfold kernel.sliver_kernel.check_sliver_lowering_loop0
  apply loop.spec_decr_nat
    (measure := fun (s : alloc.vec.Vec Std.Usize × alloc.vec.Vec Std.Usize × Std.Usize) =>
      n1.val - s.2.2.val)
    (inv := fun (s : alloc.vec.Vec Std.Usize × alloc.vec.Vec Std.Usize × Std.Usize) =>
      s.2.2.val ≤ n1.val ∧ s.1.val = List.replicate s.2.2.val 0#usize ∧
      s.2.1.val = List.replicate s.2.2.val 0#usize)
  · rintro ⟨cls1, ent1, k1⟩ ⟨hle, hc, he⟩
    dsimp only at hle hc he
    unfold kernel.sliver_kernel.check_sliver_lowering_loop0.body
    try dsimp only
    split
    · rename_i hlt
      have hcap : cls1.val.length < Usize.max := by
        rw [hc, List.length_replicate]
        scalar_tac
      have hcap' : ent1.val.length < Usize.max := by
        rw [he, List.length_replicate]
        scalar_tac
      step as ⟨cls2, hcls2⟩
      step as ⟨ent2, hent2⟩
      step as ⟨k2, hk2⟩
      and_intros
      · scalar_tac
      · rw [hcls2, hk2, hc, List.replicate_succ']
      · rw [hent2, hk2, he, List.replicate_succ']
      · scalar_tac
    · rename_i hge
      have : k1.val = n1.val := by scalar_tac
      try simp only [WP.spec_ok]
      exact ⟨by rw [hc, this], by rw [he, this]⟩
  · exact hinv

/-- The invariant of `read_entries`' loop: the entries below `off` are
    validated, their variables are class 2 (and nothing else is). -/
structure ReadInv (reads : List Std.Usize) (t : List blast_kernel.DagNode) (ws1 : List Nat)
    (cls ent : List Std.Usize) (off : Nat) : Prop where
  mod : off % 3 = 0
  le : off ≤ reads.length
  len : cls.length = t.length
  elen : ent.length = t.length
  c2 : ∀ m < t.length, (cls.getD m 0#usize = 2#usize ↔ ∃ r, 3 * r < off ∧ (rdV reads r).val = m)
  c0 : ∀ m < t.length, cls.getD m 0#usize = 2#usize ∨ cls.getD m 0#usize = 0#usize
  var_lt : ∀ r, 3 * r < off → (rdV reads r).val < t.length
  var_node : ∀ r, 3 * r < off → t.getD (rdV reads r).val dfltNode = .Var 8#usize
  idx_lt : ∀ r, 3 * r < off → (rdX reads r).val < t.length
  idx_w : ∀ r, 3 * r < off → ws1.getD (rdX reads r).val 0 = 32
  nodup : ∀ r r', 3 * r < off → r' < r → ¬ (rdA reads r' = rdA reads r ∧ rdX reads r' = rdX reads r)
  var_inj : ∀ r r', 3 * r < off → 3 * r' < off → rdV reads r = rdV reads r' → r = r'
  ent_r : ∀ r, 3 * r < off → (ent.getD (rdV reads r).val 0#usize).val = 3 * r

theorem read_entries_loop_spec (reads : Slice Std.Usize) (t : Slice blast_kernel.DagNode)
    (ws1 cls ent : Slice Std.Usize) (n m off k : Std.Usize)
    (hn : n.val = t.val.length) (hm : m.val = reads.val.length) (hws : ws1.val.length = t.val.length)
    (hinv : ReadInv reads.val t.val (ws1.val.map UScalar.val) cls.val ent.val off.val)
    (hk : 3 * k.val = off.val) :
    kernel.sliver_kernel.read_entries_loop reads t ws1 cls ent n m off k ⦃ r =>
      match r with
      | (core.result.Result.Ok _, cls', ent') =>
        reads.val.length % 3 = 0 ∧
        ReadInv reads.val t.val (ws1.val.map UScalar.val) cls'.val ent'.val reads.val.length
      | (core.result.Result.Err _, _, _) => True ⦄ := by
  unfold kernel.sliver_kernel.read_entries_loop
  apply loop.spec_decr_nat
    (measure := fun (st : Slice Std.Usize × Slice Std.Usize × Std.Usize × Std.Usize) =>
      reads.val.length - st.2.2.1.val)
    (inv := fun (st : Slice Std.Usize × Slice Std.Usize × Std.Usize × Std.Usize) =>
      ReadInv reads.val t.val (ws1.val.map UScalar.val) st.1.val st.2.1.val st.2.2.1.val ∧
      3 * st.2.2.2.val = st.2.2.1.val)
  · rintro ⟨cls1, ent1, off1, k1⟩ ⟨hI, hk1⟩
    dsimp only at hI hk1
    unfold kernel.sliver_kernel.read_entries_loop.body
    try dsimp only
    split
    · rename_i hlt
      have hlt' : off1.val < reads.val.length := by scalar_tac
      step as ⟨i, hi⟩
      split
      · simp
      · rename_i hge3
        have hoff2 : off1.val + 2 < reads.val.length := by scalar_tac
        step as ⟨var, hvar⟩
        step as ⟨i1, hi1⟩
        have hi1' : i1.val < reads.val.length := by scalar_tac
        step as ⟨aid, haid⟩
        step as ⟨i2, hi2⟩
        have hi2' : i2.val < reads.val.length := by scalar_tac
        step as ⟨idx, hidx⟩
        have hr0 : 3 * (off1.val / 3) = off1.val := by have := hI.mod; omega
        have hvg : rdV reads.val (off1.val / 3) = var := by
          unfold rdV; rw [hr0, getD_eq_getElem_of_lt hlt', hvar]
        have hag : rdA reads.val (off1.val / 3) = aid := by
          unfold rdA; rw [hr0, ← hi1, getD_eq_getElem_of_lt hi1', haid]
        have hxg : rdX reads.val (off1.val / 3) = idx := by
          unfold rdX; rw [hr0, ← hi2, getD_eq_getElem_of_lt hi2', hidx]
        split
        · simp
        · rename_i hvlt
          have hvlt' : var.val < t.val.length := by scalar_tac
          step as ⟨dn, hdn⟩
          obtain ⟨b, hb⟩ := node_eq_ok dn (.Var 8#usize)
          rw [hb]
          simp only [bind_tc_ok]
          split
          · rename_i hbt
            subst hbt
            have hdn' := node_eq_sound _ _ hb
            have hvc : var.val < cls1.val.length := by rw [hI.len]; exact hvlt'
            step as ⟨c, hc⟩
            have hcg : cls1.val.getD var.val 0#usize = c := by rw [getD_eq_getElem_of_lt hvc, hc]
            split
            · simp
            · rename_i hc0
              have hc0' : c = 0#usize := UScalar.eq_of_val_eq (by simpa using hc0)
              split
              · simp
              · rename_i hilt
                have hilt' : idx.val < t.val.length := by scalar_tac
                have hiw : idx.val < ws1.val.length := by rw [hws]; exact hilt'
                step as ⟨w, hw⟩
                split
                · simp
                · rename_i hw32
                  have hw32' : w.val = 32 := by simpa using hw32
                  step with (read_dup_spec reads off1 aid idx (by omega) hI.mod) as ⟨b1, hb1⟩
                  split
                  · simp
                  · rename_i hb1f
                    have hb1f' : b1 = false := by simpa using hb1f
                    have hnodup := hb1 hb1f'
                    have hve : var.val < ent1.val.length := by rw [hI.elen]; exact hvlt'
                    step as ⟨cls2, hcls2⟩
                    step as ⟨ent2, hent2⟩
                    step as ⟨off2, hoff2⟩
                    step as ⟨k2, hk2⟩
                    have hcls2' : cls2.val = cls1.val.set var.val 2#usize := by simp [hcls2]
                    have hent2' : ent2.val = ent1.val.set var.val off1 := by simp [hent2]
                    -- no earlier entry has this variable (its class was 0)
                    have hfresh : ∀ r, 3 * r < off1.val → (rdV reads.val r).val ≠ var.val := by
                      intro r hr heq
                      have := (hI.c2 _ hvlt').mpr ⟨r, hr, heq⟩
                      rw [hcg, hc0'] at this
                      cases this
                    refine ⟨?_, by omega, by scalar_tac⟩
                    dsimp only
                    rw [hcls2', hent2', hoff2]
                    have hsplit : ∀ r, 3 * r < off1.val + 3 → 3 * r < off1.val ∨ r = off1.val / 3 := by
                      intro r hr
                      omega
                    refine ⟨by omega, by omega, by simp [hI.len], by simp [hI.elen], ?_, ?_, ?_, ?_, ?_, ?_,
                      ?_, ?_, ?_⟩
                    · intro m hmm
                      by_cases hmeq : var.val = m
                      · subst hmeq
                        rw [getD_set_self _ _ _ _ hvc]
                        exact ⟨fun _ => ⟨off1.val / 3, by omega, hvg ▸ rfl⟩, fun _ => rfl⟩
                      · rw [getD_set_ne _ _ _ _ _ hmeq, hI.c2 m hmm]
                        constructor
                        · rintro ⟨r, hr, hrm⟩
                          exact ⟨r, by omega, hrm⟩
                        · rintro ⟨r, hr, hrm⟩
                          rcases hsplit r hr with h | h
                          · exact ⟨r, h, hrm⟩
                          · subst h
                            rw [hvg] at hrm
                            exact absurd hrm hmeq
                    · intro m hmm
                      by_cases hmeq : var.val = m
                      · subst hmeq
                        rw [getD_set_self _ _ _ _ hvc]
                        exact Or.inl rfl
                      · rw [getD_set_ne _ _ _ _ _ hmeq]
                        exact hI.c0 m hmm
                    · intro r hr
                      rcases hsplit r hr with h | h
                      · exact hI.var_lt r h
                      · subst h; rw [hvg]; exact hvlt'
                    · intro r hr
                      rcases hsplit r hr with h | h
                      · exact hI.var_node r h
                      · subst h; rw [hvg, getD_eq_getElem_of_lt hvlt', ← hdn, hdn']
                    · intro r hr
                      rcases hsplit r hr with h | h
                      · exact hI.idx_lt r h
                      · subst h; rw [hxg]; exact hilt'
                    · intro r hr
                      rcases hsplit r hr with h | h
                      · exact hI.idx_w r h
                      · subst h; rw [hxg, getD_map_val _ _ hiw, ← hw, hw32']
                    · intro r r' hr hrr'
                      rcases hsplit r hr with h | h
                      · exact hI.nodup r r' h hrr'
                      · subst h
                        rw [hag, hxg]
                        exact hnodup r' (by omega)
                    · intro r r' hr hr' heq
                      rcases hsplit r hr with h | h <;> rcases hsplit r' hr' with h' | h'
                      · exact hI.var_inj r r' h h' heq
                      · subst h'; rw [hvg] at heq
                        exact absurd (congrArg UScalar.val heq) (hfresh r h)
                      · subst h; rw [hvg] at heq
                        exact absurd (congrArg UScalar.val heq.symm) (hfresh r' h')
                      · rw [h, h']
                    · intro r hr
                      rcases hsplit r hr with h | h
                      · rw [getD_set_ne _ _ _ _ _ (hfresh r h).symm]
                        exact hI.ent_r r h
                      · subst h
                        rw [hvg, getD_set_self _ _ _ _ hve]
                        omega
          · simp
    · rename_i hge
      have hoff : off1.val = reads.val.length := by have := hI.le; scalar_tac
      try rw [WP.spec_ok]
      refine ⟨by rw [← hoff]; exact hI.mod, ?_⟩
      rw [← hoff]
      exact hI
  · exact ⟨hinv, hk⟩

/-- The invariant of `call_entries`' loop over the state left by
    `read_entries` (`clsR`, `entR`). -/
structure CallInv (calls cargs : List Std.Usize) (t : List blast_kernel.DagNode)
    (clsR entR cls ent : List Std.Usize) (off : Nat) : Prop where
  mod : off % 4 = 0
  le : off ≤ calls.length
  len : cls.length = t.length
  elen : ent.length = t.length
  c3 : ∀ m < t.length, (cls.getD m 0#usize = 3#usize ↔ ∃ c, 4 * c < off ∧ (clV calls c).val = m)
  cR : ∀ m < t.length, cls.getD m 0#usize ≠ 3#usize → cls.getD m 0#usize = clsR.getD m 0#usize
  fresh : ∀ c, 4 * c < off → clsR.getD (clV calls c).val 0#usize = 0#usize
  var_lt : ∀ c, 4 * c < off → (clV calls c).val < t.length
  var_node : ∀ c, 4 * c < off → ∃ w, t.getD (clV calls c).val dfltNode = .Var w
  args_rng : ∀ c, 4 * c < off → (clS calls c).val + (clK calls c).val ≤ cargs.length
  args_lt : ∀ c, 4 * c < off → ∀ l < (clK calls c).val, (clArg calls cargs c l).val < t.length
  nodup : ∀ c c', 4 * c < off → c' < c → ¬ (clF calls c' = clF calls c ∧ clK calls c' = clK calls c ∧
    ∀ l < (clK calls c).val, clArg calls cargs c' l = clArg calls cargs c l)
  var_inj : ∀ c c', 4 * c < off → 4 * c' < off → clV calls c = clV calls c' → c = c'
  ent_c : ∀ c, 4 * c < off → (ent.getD (clV calls c).val 0#usize).val = 4 * c
  entR : ∀ m, (∀ c, 4 * c < off → (clV calls c).val ≠ m) → ent.getD m 0#usize = entR.getD m 0#usize

theorem call_entries_loop_spec (calls cargs : Slice Std.Usize) (t : Slice blast_kernel.DagNode)
    (cls ent : Slice Std.Usize) (n m off k : Std.Usize) (clsR entR : List Std.Usize)
    (hn : n.val = t.val.length) (hm : m.val = calls.val.length)
    (hinv : CallInv calls.val cargs.val t.val clsR entR cls.val ent.val off.val)
    (hk : 4 * k.val = off.val) :
    kernel.sliver_kernel.call_entries_loop calls cargs t cls ent n m off k ⦃ r =>
      match r with
      | (core.result.Result.Ok _, cls', ent') =>
        calls.val.length % 4 = 0 ∧
        CallInv calls.val cargs.val t.val clsR entR cls'.val ent'.val calls.val.length
      | (core.result.Result.Err _, _, _) => True ⦄ := by
  unfold kernel.sliver_kernel.call_entries_loop
  apply loop.spec_decr_nat
    (measure := fun (st : Slice Std.Usize × Slice Std.Usize × Std.Usize × Std.Usize) =>
      calls.val.length - st.2.2.1.val)
    (inv := fun (st : Slice Std.Usize × Slice Std.Usize × Std.Usize × Std.Usize) =>
      CallInv calls.val cargs.val t.val clsR entR st.1.val st.2.1.val st.2.2.1.val ∧
      4 * st.2.2.2.val = st.2.2.1.val)
  · rintro ⟨cls1, ent1, off1, k1⟩ ⟨hI, hk1⟩
    dsimp only at hI hk1
    unfold kernel.sliver_kernel.call_entries_loop.body
    try dsimp only
    split
    · rename_i hlt
      have hlt' : off1.val < calls.val.length := by scalar_tac
      step as ⟨i, hi⟩
      split
      · simp
      · rename_i hge4
        have hoff3 : off1.val + 3 < calls.val.length := by scalar_tac
        step as ⟨var, hvar⟩
        step as ⟨i1, hi1⟩
        have hi1' : i1.val < calls.val.length := by scalar_tac
        step as ⟨fid, hfid⟩
        step as ⟨i2, hi2⟩
        have hi2' : i2.val < calls.val.length := by scalar_tac
        step as ⟨s, hs⟩
        step as ⟨i3, hi3⟩
        have hi3' : i3.val < calls.val.length := by scalar_tac
        step as ⟨arity, harity⟩
        have hc0 : 4 * (off1.val / 4) = off1.val := by have := hI.mod; omega
        have hvg : clV calls.val (off1.val / 4) = var := by
          unfold clV; rw [hc0, getD_eq_getElem_of_lt hlt', hvar]
        have hfg : clF calls.val (off1.val / 4) = fid := by
          unfold clF; rw [hc0, ← hi1, getD_eq_getElem_of_lt hi1', hfid]
        have hsg : clS calls.val (off1.val / 4) = s := by
          unfold clS; rw [hc0, ← hi2, getD_eq_getElem_of_lt hi2', hs]
        have hkg : clK calls.val (off1.val / 4) = arity := by
          unfold clK; rw [hc0, ← hi3, getD_eq_getElem_of_lt hi3', harity]
        split
        · simp
        · rename_i hvlt
          have hvlt' : var.val < t.val.length := by scalar_tac
          step as ⟨dn, hdn⟩
          rw [node_tag_eq]
          simp only [bind_tc_ok]
          split
          · simp
          · rename_i htag
            have htag' : pTag dn = 0#usize := UScalar.eq_of_val_eq (by simpa using htag)
            obtain ⟨w, hw⟩ := (pTag_eq_zero dn).mp htag'
            have hvc : var.val < cls1.val.length := by rw [hI.len]; exact hvlt'
            step as ⟨c, hc⟩
            have hcg : cls1.val.getD var.val 0#usize = c := by rw [getD_eq_getElem_of_lt hvc, hc]
            split
            · simp
            · rename_i hcz
              have hcz' : c = 0#usize := UScalar.eq_of_val_eq (by simpa using hcz)
              step with (args_in_range_spec cargs s arity n) as ⟨b, hb⟩
              split
              · rename_i hbt
                obtain ⟨hrng, hargs⟩ := hb hbt
                have hrng' : ∀ c', 4 * c' < off1.val →
                    (clS calls.val c').val + (clK calls.val c').val ≤ cargs.val.length :=
                  fun c' hc' => hI.args_rng c' hc'
                step with (call_dup_spec calls cargs off1 fid s arity (by omega) hI.mod hrng hrng')
                  as ⟨b1, hb1⟩
                split
                · simp
                · rename_i hb1f
                  have hb1f' : b1 = false := by simpa using hb1f
                  have hnodup := hb1 hb1f'
                  have hve : var.val < ent1.val.length := by rw [hI.elen]; exact hvlt'
                  step as ⟨cls2, hcls2⟩
                  step as ⟨ent2, hent2⟩
                  step as ⟨off2, hoff2⟩
                  step as ⟨k2, hk2⟩
                  have hcls2' : cls2.val = cls1.val.set var.val 3#usize := by simp [hcls2]
                  have hent2' : ent2.val = ent1.val.set var.val off1 := by simp [hent2]
                  have hfresh : ∀ c', 4 * c' < off1.val → (clV calls.val c').val ≠ var.val := by
                    intro c' hc' heq
                    have := (hI.c3 _ hvlt').mpr ⟨c', hc', heq⟩
                    rw [hcg, hcz'] at this
                    cases this
                  have hclsR : clsR.getD var.val 0#usize = 0#usize := by
                    have := hI.cR var.val hvlt' (by rw [hcg, hcz']; decide)
                    rw [hcg, hcz'] at this
                    exact this.symm
                  refine ⟨?_, by omega, by scalar_tac⟩
                  dsimp only
                  rw [hcls2', hent2', hoff2]
                  have hsplit : ∀ c', 4 * c' < off1.val + 4 → 4 * c' < off1.val ∨ c' = off1.val / 4 := by
                    intro c' hc'
                    omega
                  refine ⟨by omega, by omega, by simp [hI.len], by simp [hI.elen], ?_, ?_, ?_, ?_, ?_, ?_,
                    ?_, ?_, ?_, ?_, ?_⟩
                  · intro m hmm
                    by_cases hmeq : var.val = m
                    · subst hmeq
                      rw [getD_set_self _ _ _ _ hvc]
                      exact ⟨fun _ => ⟨off1.val / 4, by omega, hvg ▸ rfl⟩, fun _ => rfl⟩
                    · rw [getD_set_ne _ _ _ _ _ hmeq, hI.c3 m hmm]
                      constructor
                      · rintro ⟨c', hc', hcm⟩
                        exact ⟨c', by omega, hcm⟩
                      · rintro ⟨c', hc', hcm⟩
                        rcases hsplit c' hc' with h | h
                        · exact ⟨c', h, hcm⟩
                        · subst h
                          rw [hvg] at hcm
                          exact absurd hcm hmeq
                  · intro m hmm hne
                    by_cases hmeq : var.val = m
                    · subst hmeq
                      rw [getD_set_self _ _ _ _ hvc] at hne
                      exact absurd rfl hne
                    · rw [getD_set_ne _ _ _ _ _ hmeq] at hne ⊢
                      exact hI.cR m hmm hne
                  · intro c' hc'
                    rcases hsplit c' hc' with h | h
                    · exact hI.fresh c' h
                    · subst h; rw [hvg]; exact hclsR
                  · intro c' hc'
                    rcases hsplit c' hc' with h | h
                    · exact hI.var_lt c' h
                    · subst h; rw [hvg]; exact hvlt'
                  · intro c' hc'
                    rcases hsplit c' hc' with h | h
                    · exact hI.var_node c' h
                    · subst h; rw [hvg, getD_eq_getElem_of_lt hvlt', ← hdn, hw]; exact ⟨w, rfl⟩
                  · intro c' hc'
                    rcases hsplit c' hc' with h | h
                    · exact hI.args_rng c' h
                    · subst h; rw [hsg, hkg]; exact hrng
                  · intro c' hc' l hl
                    rcases hsplit c' hc' with h | h
                    · exact hI.args_lt c' h l hl
                    · subst h
                      unfold clArg
                      rw [hsg]
                      rw [hkg] at hl
                      have := hargs l hl
                      rw [hn] at this
                      exact this
                  · intro c' c'' hc' hcc
                    rcases hsplit c' hc' with h | h
                    · exact hI.nodup c' c'' h hcc
                    · subst h
                      rw [hfg, hkg]
                      intro hcontra
                      apply hnodup c'' (by omega)
                      refine ⟨hcontra.1, hcontra.2.1, ?_⟩
                      intro l hl
                      have := hcontra.2.2 l hl
                      unfold clArg at this
                      rw [hsg] at this
                      exact this
                  · intro c' c'' hc' hc'' heq
                    rcases hsplit c' hc' with h | h <;> rcases hsplit c'' hc'' with h' | h'
                    · exact hI.var_inj c' c'' h h' heq
                    · subst h'; rw [hvg] at heq
                      exact absurd (congrArg UScalar.val heq) (hfresh c' h)
                    · subst h; rw [hvg] at heq
                      exact absurd (congrArg UScalar.val heq.symm) (hfresh c'' h')
                    · rw [h, h']
                  · intro c' hc'
                    rcases hsplit c' hc' with h | h
                    · rw [getD_set_ne _ _ _ _ _ (hfresh c' h).symm]
                      exact hI.ent_c c' h
                    · subst h
                      rw [hvg, getD_set_self _ _ _ _ hve]
                      omega
                  · intro mm hmm
                    have hne : var.val ≠ mm := by
                      intro heq
                      apply hmm (off1.val / 4) (by omega)
                      rw [hvg]; exact heq
                    rw [getD_set_ne _ _ _ _ _ hne]
                    apply hI.entR
                    intro c' hc'
                    exact hmm c' (by omega)
              · simp
    · rename_i hge
      have hoff : off1.val = calls.val.length := by have := hI.le; scalar_tac
      try rw [WP.spec_ok]
      refine ⟨by rw [← hoff]; exact hI.mod, ?_⟩
      rw [← hoff]
      exact hI
  · exact ⟨hinv, hk⟩

theorem read_entries_spec (reads : Slice Std.Usize) (t : Slice blast_kernel.DagNode)
    (ws1 cls ent : Slice Std.Usize) (hws : ws1.val.length = t.val.length)
    (hinv : ReadInv reads.val t.val (ws1.val.map UScalar.val) cls.val ent.val 0) :
    kernel.sliver_kernel.read_entries reads t ws1 cls ent ⦃ r =>
      match r with
      | (core.result.Result.Ok _, cls', ent') =>
        reads.val.length % 3 = 0 ∧
        ReadInv reads.val t.val (ws1.val.map UScalar.val) cls'.val ent'.val reads.val.length
      | (core.result.Result.Err _, _, _) => True ⦄ := by
  unfold kernel.sliver_kernel.read_entries
  try dsimp only
  exact read_entries_loop_spec reads t ws1 cls ent _ _ 0#usize 0#usize (by simp) (by simp) hws hinv (by simp)

theorem call_entries_spec (calls cargs : Slice Std.Usize) (t : Slice blast_kernel.DagNode)
    (cls ent : Slice Std.Usize) (clsR entR : List Std.Usize)
    (hinv : CallInv calls.val cargs.val t.val clsR entR cls.val ent.val 0) :
    kernel.sliver_kernel.call_entries calls cargs t cls ent ⦃ r =>
      match r with
      | (core.result.Result.Ok _, cls', ent') =>
        calls.val.length % 4 = 0 ∧
        CallInv calls.val cargs.val t.val clsR entR cls'.val ent'.val calls.val.length
      | (core.result.Result.Err _, _, _) => True ⦄ := by
  unfold kernel.sliver_kernel.call_entries
  try dsimp only
  exact call_entries_loop_spec calls cargs t cls ent _ _ 0#usize 0#usize clsR entR (by simp) (by simp) hinv
    (by simp)

/- ══════════════════ THE MAIN LOOP ══════════════════ -/

/-- The injectivity of the map on the first `n` extended variables. -/
def VarInjE (e : List ExtNode) (map : List Std.Usize) (n : Nat) : Prop :=
  ∀ u u' m, u < n → u' < n → ExtVarImg e map u m → ExtVarImg e map u' m → u = u'

def MainInvS (e : List ExtNode) (ebits : List Bool) (eside map : List Std.Usize)
    (t : List blast_kernel.DagNode) (tbits : List Bool) (reads calls cargs ent : List Std.Usize)
    (st : alloc.vec.Vec Std.Usize × Option kernel.sliver_kernel.SliverCheckError × Std.Usize) : Prop :=
  st.2.2.val ≤ e.length ∧
  (st.2.1 = none →
    ClsFacts e ebits eside map t reads calls cargs st.1.val ent st.2.2.val ∧
    (∀ j < st.2.2.val, img map j ≠ NONE → (img map j).val < t.length ∧
      ExtNodeCorr e ebits eside map t tbits reads calls cargs j) ∧
    VarInjE e map st.2.2.val)

theorem check_sliver_lowering_loop1_spec (e : Slice ExtNode) (ebits : Slice Bool)
    (eside map reads calls cargs : Slice Std.Usize) (t : Slice blast_kernel.DagNode) (tbits : Slice Bool)
    (n0 : Std.Usize) (cls ent : alloc.vec.Vec Std.Usize)
    (failure : Option kernel.sliver_kernel.SliverCheckError) (i : Std.Usize) (ws1 : List Nat)
    (hn0 : n0.val = e.val.length) (hmap : map.val.length = e.val.length)
    (hwf : ExtWF e.val ebits.val.length eside.val)
    (hrt : ReadTable reads.val t.val ws1) (hct : CallTable calls.val cargs.val t.val)
    (hinv : MainInvS e.val ebits.val eside.val map.val t.val tbits.val reads.val calls.val cargs.val
      ent.val (cls, failure, i)) :
    kernel.sliver_kernel.check_sliver_lowering_loop1 e ebits eside map reads calls cargs t tbits n0 cls ent
      failure i ⦃ r => r.2 = none →
        ClsFacts e.val ebits.val eside.val map.val t.val reads.val calls.val cargs.val r.1.val ent.val
          e.val.length ∧
        (∀ j < e.val.length, img map.val j ≠ NONE → (img map.val j).val < t.val.length ∧
          ExtNodeCorr e.val ebits.val eside.val map.val t.val tbits.val reads.val calls.val cargs.val j) ∧
        VarInjE e.val map.val e.val.length ⦄ := by
  unfold kernel.sliver_kernel.check_sliver_lowering_loop1
  apply loop.spec_decr_nat
    (measure := fun (st : alloc.vec.Vec Std.Usize × Option kernel.sliver_kernel.SliverCheckError ×
      Std.Usize) => e.val.length - st.2.2.val)
    (inv := MainInvS e.val ebits.val eside.val map.val t.val tbits.val reads.val calls.val cargs.val
      ent.val)
  · rintro ⟨cls1, failure1, i1⟩ ⟨hle, hfacts⟩
    dsimp only at hle hfacts
    unfold kernel.sliver_kernel.check_sliver_lowering_loop1.body
    try dsimp only
    cases failure1 with
    | some err =>
      simp only [core.option.Option.is_none, Option.isNone_some, Bool.false_eq_true, ↓reduceIte,
        WP.spec_ok]
      intro h
      cases h
    | none =>
      simp only [core.option.Option.is_none, Option.isNone_none, if_true]
      obtain ⟨hcf, hcorr, hinj⟩ := hfacts rfl
      split
      · rename_i hlt
        have hilt : i1.val < e.val.length := by scalar_tac
        simp only [alloc.vec.Vec.deref_mut, lift]
        have hderef : (alloc.vec.Vec.deref ent).val = ent.val := rfl
        step with (ext_step_spec e ebits eside map t tbits reads calls cargs ⟨cls1.val, cls1.property⟩
          (alloc.vec.Vec.deref ent) i1 ws1 hilt hmap hwf hrt hct (by rw [hderef]; exact hcf))
          as ⟨r, cls2, hr⟩
        cases r with
        | Err err =>
          simp only at hr
          simp only [bind_tc_ok]
          step as ⟨i2, hi2⟩
          refine ⟨?_, by scalar_tac⟩
          exact ⟨by scalar_tac, fun h => by cases h⟩
        | Ok _u =>
          simp only at hr
          obtain ⟨hcf', hnode⟩ := hr
          rw [hderef] at hcf'
          simp only [bind_tc_ok]
          step as ⟨i2, hi2⟩
          refine ⟨?_, by scalar_tac⟩
          refine ⟨by scalar_tac, fun _ => ⟨?_, ?_, ?_⟩⟩
          · simp only
            rw [hi2]
            exact hcf'
          · intro j hj hne
            simp only at hj
            rw [hi2] at hj
            rcases Nat.lt_or_ge j i1.val with h | h
            · exact hcorr j h hne
            · have : j = i1.val := by omega
              subst this
              rcases hnode with hnone | ⟨hlt', hc, _⟩
              · exact absurd hnone hne
              · exact ⟨hlt', hc⟩
          · intro u u' m hu hu' hE hE'
            simp only at hu hu'
            rw [hi2] at hu hu'
            -- an earlier variable with the same image as node `i1` is excluded
            have hmark : ∀ u0, u0 < i1.val → ExtVarImg e.val map.val u0 m →
                ExtVarImg e.val map.val i1.val m → False := by
              intro u0 hu0 hE0 hEi
              obtain ⟨_, ⟨w, hw⟩, hne, hm⟩ := hEi
              rcases hnode with hnone | ⟨_, _, hvar⟩
              · exact hne hnone
              · apply hvar w hw u0 hu0
                rw [hm]
                exact hE0
            rcases Nat.lt_or_ge u i1.val with h | h
            · rcases Nat.lt_or_ge u' i1.val with h' | h'
              · exact hinj u u' m h h' hE hE'
              · have : u' = i1.val := by omega
                subst this
                exact absurd hE (fun hE => hmark u h hE hE')
            · have : u = i1.val := by omega
              subst this
              rcases Nat.lt_or_ge u' i1.val with h' | h'
              · exact absurd hE' (fun hE' => hmark u' h' hE' hE)
              · omega
      · rename_i hge
        have hieq : i1.val = e.val.length := by scalar_tac
        try rw [WP.spec_ok]
        intro _
        rw [← hieq]
        exact ⟨hcf, hcorr, hinj⟩
  · exact hinv

/- ══════════════════ THE CONGRUENCE ROOTS ══════════════════ -/

/-- The two-sided description of a block `[lo, hi)` of congruence roots
    over the pairs `B` admits: every root in the block is the root of an
    admitted pair, and every admitted pair has its root in the block. -/
def CongB (Pair : Nat → Nat → Prop) (Root : Nat → Nat → Nat → Prop) (lo hi : Nat)
    (B : Nat → Nat → Prop) : Prop :=
  (∀ k, lo ≤ k → k < hi → ∃ p q, B p q ∧ Pair p q ∧ Root k p q) ∧
  (∀ p q, B p q → Pair p q → ∃ k, lo ≤ k ∧ k < hi ∧ Root k p q)

theorem congB_empty (Pair : Nat → Nat → Prop) (Root : Nat → Nat → Nat → Prop) (lo : Nat)
    (B : Nat → Nat → Prop) (hB : ∀ p q, B p q → ¬ Pair p q) : CongB Pair Root lo lo B := by
  refine ⟨fun k h1 h2 => absurd h2 (by omega), fun p q hb hp => absurd hp (hB p q hb)⟩

theorem congB_trans {Pair : Nat → Nat → Prop} {Root : Nat → Nat → Nat → Prop} {lo mid hi : Nat}
    {B1 B2 : Nat → Nat → Prop} (h1 : CongB Pair Root lo mid B1) (h2 : CongB Pair Root mid hi B2)
    (hlo : lo ≤ mid) (hhi : mid ≤ hi) :
    CongB Pair Root lo hi (fun p q => B1 p q ∨ B2 p q) := by
  obtain ⟨a1, b1⟩ := h1
  obtain ⟨a2, b2⟩ := h2
  constructor
  · intro k hk1 hk2
    rcases Nat.lt_or_ge k mid with h | h
    · obtain ⟨p, q, hb, hp, hr⟩ := a1 k hk1 h
      exact ⟨p, q, Or.inl hb, hp, hr⟩
    · obtain ⟨p, q, hb, hp, hr⟩ := a2 k h hk2
      exact ⟨p, q, Or.inr hb, hp, hr⟩
  · intro p q hb hp
    rcases hb with hb | hb
    · obtain ⟨k, h1, h2, hr⟩ := b1 p q hb hp
      exact ⟨k, h1, by omega, hr⟩
    · obtain ⟨k, h1, h2, hr⟩ := b2 p q hb hp
      exact ⟨k, by omega, h2, hr⟩

theorem congB_weaken {Pair : Nat → Nat → Prop} {Root : Nat → Nat → Nat → Prop} {lo hi : Nat}
    {B B' : Nat → Nat → Prop} (h : CongB Pair Root lo hi B)
    (hBB' : ∀ p q, B p q → B' p q) (hB'B : ∀ p q, B' p q → Pair p q → B p q) :
    CongB Pair Root lo hi B' := by
  obtain ⟨a, b⟩ := h
  constructor
  · intro k hk1 hk2
    obtain ⟨p, q, hb, hp, hr⟩ := a k hk1 hk2
    exact ⟨p, q, hBB' p q hb, hp, hr⟩
  · intro p q hb hp
    exact b p q (hB'B p q hb hp) hp

/-- Read entries `p < q` of one array whose indices are not two unequal
    constants: the pairs the lowering emits a congruence root for. -/
def ReadPair (reads : List Std.Usize) (t : List blast_kernel.DagNode) (tbits : List Bool) (p q : Nat) :
    Prop :=
  p < q ∧ IsRead reads q ∧ rdA reads p = rdA reads q ∧
  ¬ ConstUnequal t tbits (rdX reads p).val (rdX reads q).val

/-- `root` is `Or(Not(Eq(xp, xq)), Eq(vp, vq))`. -/
def ArrRoot (t : List blast_kernel.DagNode) (root vp vq xp xq : Std.Usize) : Prop :=
  ∃ a, ImplShape t root vp vq a ∧ a.val < t.length ∧ t.getD a.val dfltNode = .Eq xp xq

def ArrRootAt (reads : List Std.Usize) (t : List blast_kernel.DagNode) (troots : List Std.Usize)
    (k p q : Nat) : Prop :=
  ArrRoot t (troots.getD k 0#usize) (rdV reads p) (rdV reads q) (rdX reads p) (rdX reads q)

/-- The array congruence roots occupy `[lo, hi)` of the core's roots. -/
def ArrCong (reads : List Std.Usize) (t : List blast_kernel.DagNode) (tbits : List Bool)
    (troots : List Std.Usize) (lo hi : Nat) : Prop :=
  CongB (ReadPair reads t tbits) (ArrRootAt reads t troots) lo hi (fun _ _ => True)

/-- Call entries `p < q` of one function and arity. -/
def CallPair (calls : List Std.Usize) (p q : Nat) : Prop :=
  p < q ∧ IsCall calls q ∧ clF calls p = clF calls q ∧ clK calls p = clK calls q

/-- `root` is the Ackermann root of the pair: `Eq(vp, vq)` for arity 0,
    `Or(Not(ante), Eq(vp, vq))` with the nested antecedent otherwise. -/
def UfRoot (t : List blast_kernel.DagNode) (calls cargs : List Std.Usize) (root : Std.Usize)
    (p q : Nat) : Prop :=
  ((clK calls p).val = 0 ∧ root.val < t.length ∧
    t.getD root.val dfltNode = .Eq (clV calls p) (clV calls q)) ∨
  (0 < (clK calls p).val ∧ ∃ a, ImplShape t root (clV calls p) (clV calls q) a ∧
    AnteCorr t cargs (clS calls p).val (clS calls q).val ((clK calls p).val - 1) a)

def UfRootAt (t : List blast_kernel.DagNode) (calls cargs troots : List Std.Usize) (k p q : Nat) :
    Prop :=
  UfRoot t calls cargs (troots.getD k 0#usize) p q

/-- The call congruence roots occupy `[lo, hi)` of the core's roots. -/
def UfCong (calls cargs : List Std.Usize) (t : List blast_kernel.DagNode) (troots : List Std.Usize)
    (lo hi : Nat) : Prop :=
  CongB (CallPair calls) (UfRootAt t calls cargs troots) lo hi (fun _ _ => True)

/-- The invariant of `array_cong_for`'s loop for entry `p`. -/
def ArrForInv (reads : List Std.Usize) (t : List blast_kernel.DagNode) (tbits : List Bool)
    (troots : List Std.Usize) (p op idx0 : Nat) (st : Std.Usize × Bool × Std.Usize) : Prop :=
  st.2.2.val % 3 = 0 ∧ op + 3 ≤ st.2.2.val ∧
  (st.2.1 = true → idx0 ≤ st.1.val ∧ st.1.val ≤ troots.length ∧
    CongB (ReadPair reads t tbits) (ArrRootAt reads t troots) idx0 st.1.val
      (fun p' q => p' = p ∧ 3 * q < st.2.2.val))

theorem array_cong_for_loop_spec (reads : Slice Std.Usize) (t : Slice blast_kernel.DagNode)
    (tbits : Slice Bool) (troots : Slice Std.Usize) (m aid vp xp idx : Std.Usize) (ok1 : Bool)
    (oq : Std.Usize) (p op idx0 : Nat)
    (hm : m.val = reads.val.length) (hm3 : m.val % 3 = 0) (hop : 3 * p = op)
    (haid : rdA reads.val p = aid) (hvp : rdV reads.val p = vp) (hxp : rdX reads.val p = xp)
    (hinv : ArrForInv reads.val t.val tbits.val troots.val p op idx0 (idx, ok1, oq)) :
    kernel.sliver_kernel.array_cong_for_loop reads t tbits troots m aid vp xp idx ok1 oq ⦃ r =>
      r.1 = true → idx0 ≤ r.2.val ∧ r.2.val ≤ troots.val.length ∧
        CongB (ReadPair reads.val t.val tbits.val) (ArrRootAt reads.val t.val troots.val) idx0 r.2.val
          (fun p' _ => p' = p) ⦄ := by
  unfold kernel.sliver_kernel.array_cong_for_loop
  apply loop.spec_decr_nat
    (measure := fun (st : Std.Usize × Bool × Std.Usize) => reads.val.length - st.2.2.val)
    (inv := ArrForInv reads.val t.val tbits.val troots.val p op idx0)
  · rintro ⟨idx1, ok2, oq1⟩ ⟨hmod, hge, hok⟩
    dsimp only at hmod hge hok
    unfold kernel.sliver_kernel.array_cong_for_loop.body
    try dsimp only
    split
    · rename_i hokt
      obtain ⟨hlo, hhi, hcb⟩ := hok hokt
      split
      · rename_i hlt
        have hlt' : oq1.val < reads.val.length := by scalar_tac
        have hoq3 : oq1.val + 3 ≤ reads.val.length := by omega
        have hcap : oq1.val + 3 ≤ Usize.max := by
          have := reads.length_ineq
          omega
        -- the next state re-establishes the invariant
        have hnext : ∀ (idx2 : Std.Usize) (ok3 : Bool) (oq2 : Std.Usize), oq2.val = oq1.val + 3 →
            (ok3 = true → idx0 ≤ idx2.val ∧ idx2.val ≤ troots.val.length ∧
              CongB (ReadPair reads.val t.val tbits.val) (ArrRootAt reads.val t.val troots.val) idx0
                idx2.val (fun p' q => p' = p ∧ 3 * q < oq1.val + 3)) →
            ArrForInv reads.val t.val tbits.val troots.val p op idx0 (idx2, ok3, oq2) ∧
              reads.val.length - oq2.val < reads.val.length - oq1.val := by
          intro idx2 ok3 oq2 hoq2 h3
          refine ⟨⟨by simp only; omega, by simp only; omega, ?_⟩, by omega⟩
          intro hok3
          simp only
          rw [hoq2]
          exact h3 hok3
        -- the pair (p, q) at this offset
        have hq : 3 * (oq1.val / 3) = oq1.val := by omega
        have hpq : p < oq1.val / 3 := by omega
        have hisq : IsRead reads.val (oq1.val / 3) := by unfold IsRead; omega
        step as ⟨i, hi⟩
        have hi' : i.val < reads.val.length := by scalar_tac
        step as ⟨i1, hi1⟩
        have hag : rdA reads.val (oq1.val / 3) = i1 := by
          unfold rdA; rw [hq, ← hi, getD_eq_getElem_of_lt hi', hi1]
        -- a pair skipped because `q` is not a partner: the block is unchanged
        have hskip : ¬ ReadPair reads.val t.val tbits.val p (oq1.val / 3) →
            CongB (ReadPair reads.val t.val tbits.val) (ArrRootAt reads.val t.val troots.val) idx0
              idx1.val (fun p' q => p' = p ∧ 3 * q < oq1.val + 3) := by
          intro hnp
          apply congB_weaken hcb
          · intro p' q hb; exact ⟨hb.1, by omega⟩
          · intro p' q hb hp
            refine ⟨hb.1, ?_⟩
            rcases Nat.lt_or_ge (3 * q) oq1.val with h | h
            · exact h
            · have : q = oq1.val / 3 := by omega
              subst this
              rw [hb.1] at hp
              exact absurd hp hnp
        split
        · rename_i haid1
          step as ⟨i2, hi2⟩
          have hi2' : i2.val < reads.val.length := by scalar_tac
          step as ⟨xq, hxq⟩
          have hxg : rdX reads.val (oq1.val / 3) = xq := by
            unfold rdX; rw [hq, ← hi2, getD_eq_getElem_of_lt hi2', hxq]
          step with (const_pair_unequal_spec t tbits xp xq) as ⟨b, hb⟩
          split
          · rename_i hbt
            have hcu : ConstUnequal t.val tbits.val xp.val xq.val := hb.mp hbt
            step as ⟨oq2, hoq2⟩
            apply hnext _ _ _ hoq2
            intro _
            refine ⟨hlo, hhi, hskip ?_⟩
            intro hp
            apply hp.2.2.2
            rw [hxp, hxg]
            exact hcu
          · rename_i hbf
            have hncu : ¬ ConstUnequal t.val tbits.val xp.val xq.val := fun h => hbf (hb.mpr h)
            have hpair : ReadPair reads.val t.val tbits.val p (oq1.val / 3) := by
              refine ⟨hpq, hisq, ?_, ?_⟩
              · rw [haid, hag]; exact haid1.symm
              · rw [hxp, hxg]; exact hncu
            split
            · rename_i hidxge
              step as ⟨oq2, hoq2⟩
              apply hnext _ _ _ hoq2
              intro h; cases h
            · rename_i hidxlt
              have hidxlt' : idx1.val < troots.val.length := by scalar_tac
              step as ⟨i4, hi4⟩
              step as ⟨i5, hi5⟩
              have hvg : rdV reads.val (oq1.val / 3) = i5 := by
                unfold rdV; rw [hq, getD_eq_getElem_of_lt hlt', hi5]
              step with (implication_shape_spec t i4 vp i5) as ⟨a, ha⟩
              split
              · rename_i hage
                step as ⟨oq2, hoq2⟩
                apply hnext _ _ _ hoq2
                intro h; cases h
              · rename_i halt
                have halt' : a.val < t.val.length := by scalar_tac
                have hane : a ≠ NONE := ne_NONE_of_lt (by have := t.length_ineq; omega) halt'
                have hshape := ha hane
                step as ⟨dn, hdn⟩
                obtain ⟨b1, hb1⟩ := node_eq_ok dn (.Eq xp xq)
                rw [hb1]
                simp only [bind_tc_ok]
                cases b1 with
                | true =>
                  have hdn' := node_eq_sound _ _ hb1
                  simp only [if_true]
                  have hcap2 : idx1.val + 1 ≤ Usize.max := by
                    have := troots.length_ineq; omega
                  step as ⟨i7, hi7⟩
                  step as ⟨oq2, hoq2⟩
                  apply hnext _ _ _ hoq2
                  intro _
                  refine ⟨by omega, by omega, ?_⟩
                  have hroot : ArrRootAt reads.val t.val troots.val idx1.val p (oq1.val / 3) := by
                    unfold ArrRootAt ArrRoot
                    refine ⟨a, ?_, halt', ?_⟩
                    · rw [getD_eq_getElem_of_lt hidxlt', ← hi4, hvp, hvg]
                      exact hshape
                    · rw [getD_eq_getElem_of_lt halt', ← hdn, hdn', hxp, hxg]
                  obtain ⟨hA, hB⟩ := hcb
                  rw [hi7]
                  constructor
                  · intro k hk1 hk2
                    rcases Nat.lt_or_ge k idx1.val with h | h
                    · obtain ⟨p', q, hb, hp, hr⟩ := hA k hk1 h
                      exact ⟨p', q, ⟨hb.1, by omega⟩, hp, hr⟩
                    · have : k = idx1.val := by omega
                      subst this
                      exact ⟨p, oq1.val / 3, ⟨rfl, by omega⟩, hpair, hroot⟩
                  · intro p' q hb hp
                    rcases Nat.lt_or_ge (3 * q) oq1.val with h | h
                    · obtain ⟨k, hk1, hk2, hr⟩ := hB p' q ⟨hb.1, h⟩ hp
                      exact ⟨k, hk1, by omega, hr⟩
                    · have : q = oq1.val / 3 := by omega
                      subst this
                      rw [hb.1]
                      exact ⟨idx1.val, hlo, by omega, hroot⟩
                | false =>
                  simp only [Bool.false_eq_true, if_false]
                  step as ⟨oq2, hoq2⟩
                  apply hnext _ _ _ hoq2
                  intro h; cases h
        · rename_i haid1
          step as ⟨oq2, hoq2⟩
          apply hnext _ _ _ hoq2
          intro _
          refine ⟨hlo, hhi, hskip ?_⟩
          intro hp
          apply haid1
          rw [← haid, ← hag]
          exact hp.2.2.1.symm
      · rename_i hge'
        have hoqm : reads.val.length ≤ oq1.val := by scalar_tac
        try rw [WP.spec_ok]
        intro _
        refine ⟨hlo, hhi, ?_⟩
        apply congB_weaken hcb
        · intro p' q hb; exact hb.1
        · intro p' q hb hp
          refine ⟨hb, ?_⟩
          have := hp.2.1
          unfold IsRead at this
          omega
    · rename_i hokf
      try rw [WP.spec_ok]
      intro h
      simp at h
  · exact hinv

theorem array_cong_for_spec (reads : Slice Std.Usize) (t : Slice blast_kernel.DagNode)
    (tbits : Slice Bool) (troots : Slice Std.Usize) (op idx0 : Std.Usize)
    (h3 : reads.val.length % 3 = 0) (hop3 : op.val % 3 = 0) (hop : op.val < reads.val.length)
    (hidx : idx0.val ≤ troots.val.length) :
    kernel.sliver_kernel.array_cong_for reads t tbits troots op idx0 ⦃ r =>
      r.1 = true → idx0.val ≤ r.2.val ∧ r.2.val ≤ troots.val.length ∧
        CongB (ReadPair reads.val t.val tbits.val) (ArrRootAt reads.val t.val troots.val) idx0.val r.2.val
          (fun p' _ => p' = op.val / 3) ⦄ := by
  unfold kernel.sliver_kernel.array_cong_for
  try dsimp only
  have hop2 : op.val + 2 < reads.val.length := by omega
  have hq : 3 * (op.val / 3) = op.val := by omega
  step as ⟨i, hi⟩
  have hi' : i.val < reads.val.length := by scalar_tac
  step as ⟨aid, haid⟩
  step as ⟨vp, hvp⟩
  step as ⟨i1, hi1⟩
  have hi1' : i1.val < reads.val.length := by scalar_tac
  step as ⟨xp, hxp⟩
  step as ⟨oq, hoq⟩
  apply array_cong_for_loop_spec reads t tbits troots _ aid vp xp idx0 true oq (op.val / 3) op.val
    idx0.val (by simp) (by simp; exact h3) hq
  · unfold rdA; rw [hq, ← hi, getD_eq_getElem_of_lt hi', haid]
  · unfold rdV; rw [hq, getD_eq_getElem_of_lt hop, hvp]
  · unfold rdX; rw [hq, ← hi1, getD_eq_getElem_of_lt hi1', hxp]
  · refine ⟨by show oq.val % 3 = 0; omega, by show op.val + 3 ≤ oq.val; omega,
      fun _ => ⟨le_rfl, hidx, ?_⟩⟩
    apply congB_empty
    intro p' q hb hp
    obtain ⟨hb1, hb2⟩ := hb
    have := hp.1
    show False
    simp only at hb2
    omega

def ArrInv (reads : List Std.Usize) (t : List blast_kernel.DagNode) (tbits : List Bool)
    (troots : List Std.Usize) (idx0 : Nat) (st : Std.Usize × Bool × Std.Usize) : Prop :=
  st.2.2.val % 3 = 0 ∧
  (st.2.1 = true → idx0 ≤ st.1.val ∧ st.1.val ≤ troots.length ∧
    CongB (ReadPair reads t tbits) (ArrRootAt reads t troots) idx0 st.1.val
      (fun p _ => 3 * p < st.2.2.val))

theorem array_cong_loop_spec (reads : Slice Std.Usize) (t : Slice blast_kernel.DagNode)
    (tbits : Slice Bool) (troots : Slice Std.Usize) (m idx : Std.Usize) (ok1 : Bool) (op : Std.Usize)
    (idx0 : Nat) (hm : m.val = reads.val.length) (h3 : reads.val.length % 3 = 0)
    (hinv : ArrInv reads.val t.val tbits.val troots.val idx0 (idx, ok1, op)) :
    kernel.sliver_kernel.array_cong_loop reads t tbits troots m idx ok1 op ⦃ r =>
      r.1 = true → idx0 ≤ r.2.val ∧ r.2.val ≤ troots.val.length ∧
        ArrCong reads.val t.val tbits.val troots.val idx0 r.2.val ⦄ := by
  unfold kernel.sliver_kernel.array_cong_loop
  apply loop.spec_decr_nat
    (measure := fun (st : Std.Usize × Bool × Std.Usize) => reads.val.length - st.2.2.val)
    (inv := ArrInv reads.val t.val tbits.val troots.val idx0)
  · rintro ⟨idx1, ok2, op1⟩ ⟨hmod, hok⟩
    dsimp only at hmod hok
    unfold kernel.sliver_kernel.array_cong_loop.body
    try dsimp only
    split
    · rename_i hokt
      obtain ⟨hlo, hhi, hcb⟩ := hok hokt
      split
      · rename_i hlt
        have hlt' : op1.val < reads.val.length := by scalar_tac
        have hcap : op1.val + 3 ≤ Usize.max := by
          have := reads.length_ineq; omega
        step with (array_cong_for_spec reads t tbits troots op1 idx1 h3 hmod hlt' hhi) as ⟨ok11, idx2, hr⟩
        step as ⟨op2, hop2⟩
        refine ⟨⟨by show op2.val % 3 = 0; omega, ?_⟩,
          by show reads.val.length - op2.val < reads.val.length - op1.val; omega⟩
        intro hok11
        obtain ⟨hlo2, hhi2, hcb2⟩ := hr hok11
        refine ⟨by show idx0 ≤ idx2.val; omega, hhi2, ?_⟩
        show CongB (ReadPair reads.val t.val tbits.val) (ArrRootAt reads.val t.val troots.val) idx0
          idx2.val (fun p _ => 3 * p < op2.val)
        apply congB_weaken (congB_trans hcb hcb2 hlo hlo2)
        · intro p q hb
          show 3 * p < op2.val
          rw [hop2]
          rcases hb with hb | hb
          · change 3 * p < op1.val at hb; omega
          · change p = op1.val / 3 at hb; rw [hb]; omega
        · intro p q hb _
          show 3 * p < op1.val ∨ p = op1.val / 3
          change 3 * p < op2.val at hb
          rw [hop2] at hb
          rcases Nat.lt_or_ge (3 * p) op1.val with h | h
          · exact Or.inl h
          · right; omega
      · rename_i hge
        have hopm : reads.val.length ≤ op1.val := by scalar_tac
        try rw [WP.spec_ok]
        intro _
        refine ⟨hlo, hhi, ?_⟩
        apply congB_weaken hcb
        · intro p q _; trivial
        · intro p q _ hp
          have h1 := hp.1
          have h2 := hp.2.1
          unfold IsRead at h2
          omega
    · rename_i hokf
      try rw [WP.spec_ok]
      intro h
      simp at h
  · exact hinv

theorem array_cong_spec (reads : Slice Std.Usize) (t : Slice blast_kernel.DagNode)
    (tbits : Slice Bool) (troots : Slice Std.Usize) (idx0 : Std.Usize)
    (h3 : reads.val.length % 3 = 0) (hidx : idx0.val ≤ troots.val.length) :
    kernel.sliver_kernel.array_cong reads t tbits troots idx0 ⦃ r =>
      r.1 = true → idx0.val ≤ r.2.val ∧ r.2.val ≤ troots.val.length ∧
        ArrCong reads.val t.val tbits.val troots.val idx0.val r.2.val ⦄ := by
  unfold kernel.sliver_kernel.array_cong
  try dsimp only
  apply array_cong_loop_spec reads t tbits troots _ idx0 true 0#usize idx0.val (by simp) h3
  refine ⟨by simp, fun _ => ⟨le_rfl, hidx, ?_⟩⟩
  apply congB_empty
  intro p q hb
  simp at hb

/-- The invariant of `uf_cong_for`'s loop for entry `p`. -/
def UfForInv (calls cargs : List Std.Usize) (t : List blast_kernel.DagNode)
    (troots : List Std.Usize) (p op idx0 : Nat) (st : Std.Usize × Bool × Std.Usize) : Prop :=
  st.2.2.val % 4 = 0 ∧ op + 4 ≤ st.2.2.val ∧
  (st.2.1 = true → idx0 ≤ st.1.val ∧ st.1.val ≤ troots.length ∧
    CongB (CallPair calls) (UfRootAt t calls cargs troots) idx0 st.1.val
      (fun p' q => p' = p ∧ 4 * q < st.2.2.val))

theorem uf_cong_for_loop_spec (calls cargs : Slice Std.Usize) (t : Slice blast_kernel.DagNode)
    (troots : Slice Std.Usize) (m fid vp sp k idx : Std.Usize) (ok1 : Bool) (oq : Std.Usize)
    (p op idx0 : Nat)
    (hm : m.val = calls.val.length) (hm4 : m.val % 4 = 0) (hop : 4 * p = op)
    (hfid : clF calls.val p = fid) (hvp : clV calls.val p = vp) (hsp : clS calls.val p = sp)
    (hk : clK calls.val p = k)
    (hargs : ∀ c, IsCall calls.val c → (clS calls.val c).val + (clK calls.val c).val ≤ cargs.val.length)
    (hinv : UfForInv calls.val cargs.val t.val troots.val p op idx0 (idx, ok1, oq)) :
    kernel.sliver_kernel.uf_cong_for_loop calls cargs t troots m fid vp sp k idx ok1 oq ⦃ r =>
      r.1 = true → idx0 ≤ r.2.val ∧ r.2.val ≤ troots.val.length ∧
        CongB (CallPair calls.val) (UfRootAt t.val calls.val cargs.val troots.val) idx0 r.2.val
          (fun p' _ => p' = p) ⦄ := by
  unfold kernel.sliver_kernel.uf_cong_for_loop
  apply loop.spec_decr_nat
    (measure := fun (st : Std.Usize × Bool × Std.Usize) => calls.val.length - st.2.2.val)
    (inv := UfForInv calls.val cargs.val t.val troots.val p op idx0)
  · rintro ⟨idx1, ok2, oq1⟩ ⟨hmod, hge, hok⟩
    dsimp only at hmod hge hok
    unfold kernel.sliver_kernel.uf_cong_for_loop.body
    try dsimp only
    split
    · rename_i hokt
      obtain ⟨hlo, hhi, hcb⟩ := hok hokt
      split
      · rename_i hlt
        have hlt' : oq1.val < calls.val.length := by scalar_tac
        have hoq4 : oq1.val + 4 ≤ calls.val.length := by omega
        have hcap : oq1.val + 4 ≤ Usize.max := by
          have := calls.length_ineq; omega
        have hnext : ∀ (idx2 : Std.Usize) (ok3 : Bool) (oq2 : Std.Usize), oq2.val = oq1.val + 4 →
            (ok3 = true → idx0 ≤ idx2.val ∧ idx2.val ≤ troots.val.length ∧
              CongB (CallPair calls.val) (UfRootAt t.val calls.val cargs.val troots.val) idx0
                idx2.val (fun p' q => p' = p ∧ 4 * q < oq1.val + 4)) →
            UfForInv calls.val cargs.val t.val troots.val p op idx0 (idx2, ok3, oq2) ∧
              calls.val.length - oq2.val < calls.val.length - oq1.val := by
          intro idx2 ok3 oq2 hoq2 h3
          refine ⟨⟨by simp only; omega, by simp only; omega, ?_⟩, by omega⟩
          intro hok3
          simp only
          rw [hoq2]
          exact h3 hok3
        have hq : 4 * (oq1.val / 4) = oq1.val := by omega
        have hpq : p < oq1.val / 4 := by omega
        have hisq : IsCall calls.val (oq1.val / 4) := by unfold IsCall; omega
        have hisp : IsCall calls.val p := by unfold IsCall; omega
        step as ⟨i, hi⟩
        have hi' : i.val < calls.val.length := by scalar_tac
        step as ⟨i1, hi1⟩
        have hfg : clF calls.val (oq1.val / 4) = i1 := by
          unfold clF; rw [hq, ← hi, getD_eq_getElem_of_lt hi', hi1]
        have hskip : ¬ CallPair calls.val p (oq1.val / 4) →
            CongB (CallPair calls.val) (UfRootAt t.val calls.val cargs.val troots.val) idx0
              idx1.val (fun p' q => p' = p ∧ 4 * q < oq1.val + 4) := by
          intro hnp
          apply congB_weaken hcb
          · intro p' q hb; exact ⟨hb.1, by omega⟩
          · intro p' q hb hp
            refine ⟨hb.1, ?_⟩
            rcases Nat.lt_or_ge (4 * q) oq1.val with h | h
            · exact h
            · have : q = oq1.val / 4 := by omega
              subst this
              rw [hb.1] at hp
              exact absurd hp hnp
        -- the extension of the block by the pair's root at `idx1`
        have hext : UfRootAt t.val calls.val cargs.val troots.val idx1.val p (oq1.val / 4) →
            CallPair calls.val p (oq1.val / 4) → idx1.val < troots.val.length →
            ∀ (i7 : Std.Usize), i7.val = idx1.val + 1 →
            idx0 ≤ i7.val ∧ i7.val ≤ troots.val.length ∧
              CongB (CallPair calls.val) (UfRootAt t.val calls.val cargs.val troots.val) idx0 i7.val
                (fun p' q => p' = p ∧ 4 * q < oq1.val + 4) := by
          intro hroot hpair hidxlt i7 hi7
          refine ⟨by omega, by omega, ?_⟩
          obtain ⟨hA, hB⟩ := hcb
          rw [hi7]
          constructor
          · intro k' hk1 hk2
            rcases Nat.lt_or_ge k' idx1.val with h | h
            · obtain ⟨p', q, hb, hp, hr⟩ := hA k' hk1 h
              exact ⟨p', q, ⟨hb.1, by omega⟩, hp, hr⟩
            · have : k' = idx1.val := by omega
              subst this
              exact ⟨p, oq1.val / 4, ⟨rfl, by omega⟩, hpair, hroot⟩
          · intro p' q hb hp
            rcases Nat.lt_or_ge (4 * q) oq1.val with h | h
            · obtain ⟨k', hk1, hk2, hr⟩ := hB p' q ⟨hb.1, h⟩ hp
              exact ⟨k', hk1, by omega, hr⟩
            · have : q = oq1.val / 4 := by omega
              subst this
              rw [hb.1]
              exact ⟨idx1.val, hlo, by omega, hroot⟩
        split
        · rename_i hfid1
          step as ⟨i2, hi2⟩
          have hi2' : i2.val < calls.val.length := by scalar_tac
          step as ⟨i3, hi3⟩
          have hkg : clK calls.val (oq1.val / 4) = i3 := by
            unfold clK; rw [hq, ← hi2, getD_eq_getElem_of_lt hi2', hi3]
          split
          · rename_i hk1
            have hpair : CallPair calls.val p (oq1.val / 4) :=
              ⟨hpq, hisq, by rw [hfid, hfg]; exact hfid1.symm, by rw [hk, hkg]; exact hk1.symm⟩
            split
            · rename_i hidxge
              step as ⟨oq2, hoq2⟩
              apply hnext _ _ _ hoq2
              intro h; cases h
            · rename_i hidxlt
              have hidxlt' : idx1.val < troots.val.length := by scalar_tac
              have hcap2 : idx1.val + 1 ≤ Usize.max := by
                have := troots.length_ineq; omega
              split
              · -- arity 0: the bare conclusion
                rename_i hk0
                step as ⟨r, hr⟩
                split
                · rename_i hrge
                  step as ⟨oq2, hoq2⟩
                  apply hnext _ _ _ hoq2
                  intro h; cases h
                · rename_i hrlt
                  have hrlt' : r.val < t.val.length := by scalar_tac
                  step as ⟨dn, hdn⟩
                  step as ⟨i6, hi6⟩
                  have hvg : clV calls.val (oq1.val / 4) = i6 := by
                    unfold clV; rw [hq, getD_eq_getElem_of_lt hlt', hi6]
                  obtain ⟨b, hb⟩ := node_eq_ok dn (.Eq vp i6)
                  rw [hb]
                  simp only [bind_tc_ok]
                  cases b with
                  | true =>
                    have hdn' := node_eq_sound _ _ hb
                    simp only [if_true]
                    step as ⟨i7, hi7⟩
                    step as ⟨oq2, hoq2⟩
                    apply hnext _ _ _ hoq2
                    intro _
                    apply hext ?_ hpair hidxlt' i7 hi7
                    unfold UfRootAt UfRoot
                    left
                    refine ⟨by rw [hk, hk0]; simp, ?_, ?_⟩
                    · rw [getD_eq_getElem_of_lt hidxlt', ← hr]; exact hrlt'
                    · rw [getD_eq_getElem_of_lt hidxlt', ← hr, getD_eq_getElem_of_lt hrlt', ← hdn, hdn',
                        hvp, hvg]
                  | false =>
                    simp only [Bool.false_eq_true, if_false]
                    step as ⟨oq2, hoq2⟩
                    apply hnext _ _ _ hoq2
                    intro h; cases h
              · -- arity ≥ 1: the implication with the nested antecedent
                rename_i hk0
                have hk0' : 1 ≤ k.val := by
                  have : k.val ≠ 0 := by
                    intro h
                    apply hk0
                    exact UScalar.eq_of_val_eq (by simpa using h)
                  omega
                step as ⟨i5, hi5⟩
                step as ⟨i6, hi6⟩
                have hvg : clV calls.val (oq1.val / 4) = i6 := by
                  unfold clV; rw [hq, getD_eq_getElem_of_lt hlt', hi6]
                step with (implication_shape_spec t i5 vp i6) as ⟨a, ha⟩
                split
                · rename_i hamax
                  step as ⟨oq2, hoq2⟩
                  apply hnext _ _ _ hoq2
                  intro h; cases h
                · rename_i hamax
                  have hane : a ≠ NONE := by simpa using hamax
                  have hshape := ha hane
                  step as ⟨i7, hi7⟩
                  have hi7' : i7.val < calls.val.length := by scalar_tac
                  step as ⟨i8, hi8⟩
                  have hsg : clS calls.val (oq1.val / 4) = i8 := by
                    unfold clS; rw [hq, ← hi7, getD_eq_getElem_of_lt hi7', hi8]
                  have hrp := hargs p hisp
                  rw [hsp, hk] at hrp
                  have hrq := hargs _ hisq
                  rw [hsg, hkg, hk1] at hrq
                  step with (ante_ok_spec t cargs sp i8 k a hk0' hrp hrq) as ⟨b, hb⟩
                  cases b with
                  | true =>
                    have hante := hb rfl
                    simp only [if_true]
                    step as ⟨i9, hi9⟩
                    step as ⟨oq2, hoq2⟩
                    apply hnext _ _ _ hoq2
                    intro _
                    apply hext ?_ hpair hidxlt' i9 hi9
                    unfold UfRootAt UfRoot
                    right
                    refine ⟨by rw [hk]; exact hk0', a, ?_, ?_⟩
                    · rw [getD_eq_getElem_of_lt hidxlt', ← hi5, hvp, hvg]
                      exact hshape
                    · rw [hsp, hsg, hk]
                      exact hante
                  | false =>
                    simp only [Bool.false_eq_true, if_false]
                    step as ⟨oq2, hoq2⟩
                    apply hnext _ _ _ hoq2
                    intro h; cases h
          · rename_i hk1
            step as ⟨oq2, hoq2⟩
            apply hnext _ _ _ hoq2
            intro _
            refine ⟨hlo, hhi, hskip ?_⟩
            intro hp
            apply hk1
            rw [← hkg, ← hk]
            exact hp.2.2.2.symm
        · rename_i hfid1
          step as ⟨oq2, hoq2⟩
          apply hnext _ _ _ hoq2
          intro _
          refine ⟨hlo, hhi, hskip ?_⟩
          intro hp
          apply hfid1
          rw [← hfid, ← hfg]
          exact hp.2.2.1.symm
      · rename_i hge'
        have hoqm : calls.val.length ≤ oq1.val := by scalar_tac
        try rw [WP.spec_ok]
        intro _
        refine ⟨hlo, hhi, ?_⟩
        apply congB_weaken hcb
        · intro p' q hb; exact hb.1
        · intro p' q hb hp
          refine ⟨hb, ?_⟩
          have := hp.2.1
          unfold IsCall at this
          omega
    · rename_i hokf
      try rw [WP.spec_ok]
      intro h
      simp at h
  · exact hinv

theorem uf_cong_for_spec (calls cargs : Slice Std.Usize) (t : Slice blast_kernel.DagNode)
    (troots : Slice Std.Usize) (op idx0 : Std.Usize)
    (h4 : calls.val.length % 4 = 0) (hop4 : op.val % 4 = 0) (hop : op.val < calls.val.length)
    (hidx : idx0.val ≤ troots.val.length)
    (hargs : ∀ c, IsCall calls.val c → (clS calls.val c).val + (clK calls.val c).val ≤ cargs.val.length) :
    kernel.sliver_kernel.uf_cong_for calls cargs t troots op idx0 ⦃ r =>
      r.1 = true → idx0.val ≤ r.2.val ∧ r.2.val ≤ troots.val.length ∧
        CongB (CallPair calls.val) (UfRootAt t.val calls.val cargs.val troots.val) idx0.val r.2.val
          (fun p' _ => p' = op.val / 4) ⦄ := by
  unfold kernel.sliver_kernel.uf_cong_for
  try dsimp only
  have hop3 : op.val + 3 < calls.val.length := by omega
  have hq : 4 * (op.val / 4) = op.val := by omega
  step as ⟨i, hi⟩
  have hi' : i.val < calls.val.length := by scalar_tac
  step as ⟨fid, hfid⟩
  step as ⟨vp, hvp⟩
  step as ⟨i1, hi1⟩
  have hi1' : i1.val < calls.val.length := by scalar_tac
  step as ⟨sp, hsp⟩
  step as ⟨i2, hi2⟩
  have hi2' : i2.val < calls.val.length := by scalar_tac
  step as ⟨k, hk⟩
  step as ⟨oq, hoq⟩
  apply uf_cong_for_loop_spec calls cargs t troots _ fid vp sp k idx0 true oq (op.val / 4) op.val
    idx0.val (by simp) (by simp; exact h4) hq
  · unfold clF; rw [hq, ← hi, getD_eq_getElem_of_lt hi', hfid]
  · unfold clV; rw [hq, getD_eq_getElem_of_lt hop, hvp]
  · unfold clS; rw [hq, ← hi1, getD_eq_getElem_of_lt hi1', hsp]
  · unfold clK; rw [hq, ← hi2, getD_eq_getElem_of_lt hi2', hk]
  · exact hargs
  · refine ⟨by show oq.val % 4 = 0; omega, by show op.val + 4 ≤ oq.val; omega,
      fun _ => ⟨le_rfl, hidx, ?_⟩⟩
    apply congB_empty
    intro p' q hb hp
    obtain ⟨hb1, hb2⟩ := hb
    have := hp.1
    show False
    simp only at hb2
    omega

def UfInv (calls cargs : List Std.Usize) (t : List blast_kernel.DagNode)
    (troots : List Std.Usize) (idx0 : Nat) (st : Std.Usize × Bool × Std.Usize) : Prop :=
  st.2.2.val % 4 = 0 ∧
  (st.2.1 = true → idx0 ≤ st.1.val ∧ st.1.val ≤ troots.length ∧
    CongB (CallPair calls) (UfRootAt t calls cargs troots) idx0 st.1.val
      (fun p _ => 4 * p < st.2.2.val))

theorem uf_cong_loop_spec (calls cargs : Slice Std.Usize) (t : Slice blast_kernel.DagNode)
    (troots : Slice Std.Usize) (m idx : Std.Usize) (ok1 : Bool) (op : Std.Usize) (idx0 : Nat)
    (hm : m.val = calls.val.length) (h4 : calls.val.length % 4 = 0)
    (hargs : ∀ c, IsCall calls.val c → (clS calls.val c).val + (clK calls.val c).val ≤ cargs.val.length)
    (hinv : UfInv calls.val cargs.val t.val troots.val idx0 (idx, ok1, op)) :
    kernel.sliver_kernel.uf_cong_loop calls cargs t troots m idx ok1 op ⦃ r =>
      r.1 = true → idx0 ≤ r.2.val ∧ r.2.val ≤ troots.val.length ∧
        UfCong calls.val cargs.val t.val troots.val idx0 r.2.val ⦄ := by
  unfold kernel.sliver_kernel.uf_cong_loop
  apply loop.spec_decr_nat
    (measure := fun (st : Std.Usize × Bool × Std.Usize) => calls.val.length - st.2.2.val)
    (inv := UfInv calls.val cargs.val t.val troots.val idx0)
  · rintro ⟨idx1, ok2, op1⟩ ⟨hmod, hok⟩
    dsimp only at hmod hok
    unfold kernel.sliver_kernel.uf_cong_loop.body
    try dsimp only
    split
    · rename_i hokt
      obtain ⟨hlo, hhi, hcb⟩ := hok hokt
      split
      · rename_i hlt
        have hlt' : op1.val < calls.val.length := by scalar_tac
        have hcap : op1.val + 4 ≤ Usize.max := by
          have := calls.length_ineq; omega
        step with (uf_cong_for_spec calls cargs t troots op1 idx1 h4 hmod hlt' hhi hargs)
          as ⟨ok11, idx2, hr⟩
        step as ⟨op2, hop2⟩
        refine ⟨⟨by show op2.val % 4 = 0; omega, ?_⟩,
          by show calls.val.length - op2.val < calls.val.length - op1.val; omega⟩
        intro hok11
        obtain ⟨hlo2, hhi2, hcb2⟩ := hr hok11
        refine ⟨by show idx0 ≤ idx2.val; omega, hhi2, ?_⟩
        show CongB (CallPair calls.val) (UfRootAt t.val calls.val cargs.val troots.val) idx0
          idx2.val (fun p _ => 4 * p < op2.val)
        apply congB_weaken (congB_trans hcb hcb2 hlo hlo2)
        · intro p q hb
          show 4 * p < op2.val
          rw [hop2]
          rcases hb with hb | hb
          · change 4 * p < op1.val at hb; omega
          · change p = op1.val / 4 at hb; rw [hb]; omega
        · intro p q hb _
          show 4 * p < op1.val ∨ p = op1.val / 4
          change 4 * p < op2.val at hb
          rw [hop2] at hb
          rcases Nat.lt_or_ge (4 * p) op1.val with h | h
          · exact Or.inl h
          · right; omega
      · rename_i hge
        have hopm : calls.val.length ≤ op1.val := by scalar_tac
        try rw [WP.spec_ok]
        intro _
        refine ⟨hlo, hhi, ?_⟩
        apply congB_weaken hcb
        · intro p q _; trivial
        · intro p q _ hp
          have h1 := hp.1
          have h2 := hp.2.1
          unfold IsCall at h2
          omega
    · rename_i hokf
      try rw [WP.spec_ok]
      intro h
      simp at h
  · exact hinv

theorem uf_cong_spec (calls cargs : Slice Std.Usize) (t : Slice blast_kernel.DagNode)
    (troots : Slice Std.Usize) (idx0 : Std.Usize)
    (h4 : calls.val.length % 4 = 0) (hidx : idx0.val ≤ troots.val.length)
    (hargs : ∀ c, IsCall calls.val c → (clS calls.val c).val + (clK calls.val c).val ≤ cargs.val.length) :
    kernel.sliver_kernel.uf_cong calls cargs t troots idx0 ⦃ r =>
      r.1 = true → idx0.val ≤ r.2.val ∧ r.2.val ≤ troots.val.length ∧
        UfCong calls.val cargs.val t.val troots.val idx0.val r.2.val ⦄ := by
  unfold kernel.sliver_kernel.uf_cong
  try dsimp only
  apply uf_cong_loop_spec calls cargs t troots _ idx0 true 0#usize idx0.val (by simp) h4 hargs
  refine ⟨by simp, fun _ => ⟨le_rfl, hidx, ?_⟩⟩
  apply congB_empty
  intro p q hb
  simp at hb

/- ══════════════════ THE ENTRY POINT ══════════════════ -/

/-- Everything syntactic an accepted `check_sliver_lowering` establishes. -/
structure SliverCorr (e : List ExtNode) (ebits : List Bool) (eside eroots map reads calls cargs : List Std.Usize)
    (t : List blast_kernel.DagNode) (tbits : List Bool) (troots : List Std.Usize) : Prop where
  ewf : ExtWF e ebits.length eside
  twf : DagWF t tbits.length
  tcap : t.length ≤ Usize.max
  len : map.length = e.length
  rt : ReadTable reads t (dagWidths t)
  ct : CallTable calls cargs t
  rc_disjoint : ∀ r c, IsRead reads r → IsCall calls c → rdV reads r ≠ clV calls c
  corr : ∀ i < e.length, img map i ≠ NONE → (img map i).val < t.length ∧
    ExtNodeCorr e ebits eside map t tbits reads calls cargs i
  inj : VarInjE e map e.length
  var_class : ∀ u < e.length, ∀ w, e.getD u dfltExt = .Core (.Var w) → img map u ≠ NONE →
    (∀ r, IsRead reads r → (rdV reads r).val ≠ (img map u).val) ∧
    (∀ c, IsCall calls c → (clV calls c).val ≠ (img map u).val)
  reads_live : ∀ r, IsRead reads r → ∃ i, SelMapsTo e ebits eside map t reads i r
  calls_live : ∀ c, IsCall calls c → ∃ i, CallMapsTo e eside map t calls cargs i c
  roots_len : eroots.length ≤ troots.length
  roots : RootsCorr eroots map troots eroots.length
  cong : ∃ ia, eroots.length ≤ ia ∧ ia ≤ troots.length ∧
    ArrCong reads t tbits troots eroots.length ia ∧ UfCong calls cargs t troots ia troots.length

theorem check_sliver_lowering_spec (e : Slice ExtNode) (ebits : Slice Bool)
    (eside eroots map reads calls cargs : Slice Std.Usize) (t : Slice blast_kernel.DagNode)
    (tbits : Slice Bool) (troots : Slice Std.Usize) :
    kernel.sliver_kernel.check_sliver_lowering e ebits eside eroots map reads calls cargs t tbits troots
      ⦃ r => match r with
        | core.result.Result.Ok _ =>
          SliverCorr e.val ebits.val eside.val eroots.val map.val reads.val calls.val cargs.val t.val
            tbits.val troots.val
        | core.result.Result.Err _ => True ⦄ := by
  unfold kernel.sliver_kernel.check_sliver_lowering
  try dsimp only
  step with (sliver_ext_wf_spec e (Slice.len ebits) eside) as ⟨r, hr⟩
  cases r with
  | Err err =>
    step as ⟨cf, hcf⟩
    simp only [hcf, core.result.Result.Insts.CoreOpsTryTraitFromResidualResultInfallible.from_residual]
    try simp
  | Ok ws0 =>
  obtain ⟨hws0, hewf⟩ := hr
  have hewf' : ExtWF e.val ebits.val.length eside.val := by simpa using hewf
  step as ⟨cf, hcf⟩
  simp only [hcf]
  step with (dag_wf_spec t (Slice.len tbits)) as ⟨r1, hr1⟩
  cases r1 with
  | Err err => simp
  | Ok ws1 =>
  obtain ⟨hws1, htwf⟩ := hr1
  have htwf' : DagWF t.val tbits.val.length := by simpa using htwf
  have hws1len : ws1.val.length = t.val.length := by
    have := congrArg List.length hws1
    simpa using this
  try dsimp only
  split
  · simp
  · rename_i hmaplen
    have hmap : map.val.length = e.val.length := by scalar_tac
    step with (check_sliver_lowering_loop0_spec (Slice.len t) (alloc.vec.Vec.new Std.Usize)
      (alloc.vec.Vec.new Std.Usize) 0#usize ⟨by simp, by simp, by simp⟩) as ⟨cls0, ent0, hcls0, hent0⟩
    simp only [alloc.vec.Vec.deref_mut, lift, bind_tc_ok]
    have hcls0' : cls0.val = List.replicate t.val.length 0#usize := by simpa using hcls0
    have hent0' : ent0.val = List.replicate t.val.length 0#usize := by simpa using hent0
    have hderef1 : (alloc.vec.Vec.deref ws1).val = ws1.val := rfl
    -- read_entries
    have hRinv : ReadInv reads.val t.val ((alloc.vec.Vec.deref ws1).val.map UScalar.val) cls0.val ent0.val 0 := by
      refine ⟨by simp, by simp, by rw [hcls0']; simp, by rw [hent0']; simp, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
      · intro m hm
        rw [hcls0', List.getD_eq_getElem?_getD, List.getElem?_replicate]
        simp [hm]
      · intro m hm
        rw [hcls0', List.getD_eq_getElem?_getD, List.getElem?_replicate]
        simp [hm]
      · intro r hr; omega
      · intro r hr; omega
      · intro r hr; omega
      · intro r hr; omega
      · intro r r' hr; omega
      · intro r r' hr; omega
      · intro r hr; omega
    step with (read_entries_spec reads t (alloc.vec.Vec.deref ws1) ⟨cls0.val, cls0.property⟩
      ⟨ent0.val, ent0.property⟩ (by rw [hderef1]; exact hws1len) hRinv) as ⟨r2, s3, s4, hr2⟩
    cases r2 with
    | Err err =>
      step as ⟨cf, hcf⟩
      simp only [hcf, core.result.Result.Insts.CoreOpsTryTraitFromResidualResultInfallible.from_residual]
      try simp
    | Ok u =>
    obtain ⟨h3, hR⟩ := hr2
    rw [hderef1, hws1] at hR
    step as ⟨cf1, hcf1⟩
    simp only [hcf1]
    try simp only [alloc.vec.Vec.deref_mut, lift, bind_tc_ok]
    -- call_entries
    have hCinv : CallInv calls.val cargs.val t.val s3.val s4.val s3.val s4.val 0 := by
      refine ⟨by simp, by simp, hR.len, hR.elen, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
      · intro m hm
        constructor
        · intro h
          rcases hR.c0 m hm with h2 | h2 <;> rw [h] at h2 <;> cases h2
        · rintro ⟨c, hc, _⟩; omega
      · intro m _ _; rfl
      · intro c hc; omega
      · intro c hc; omega
      · intro c hc; omega
      · intro c hc; omega
      · intro c hc; omega
      · intro c c' hc; omega
      · intro c c' hc; omega
      · intro c hc; omega
      · intro m _; rfl
    step with (call_entries_spec calls cargs t ⟨s3.val, s3.property⟩ ⟨s4.val, s4.property⟩ s3.val s4.val
      hCinv) as ⟨r3, s7, s8, hr3⟩
    cases r3 with
    | Err err =>
      step as ⟨cf, hcf⟩
      simp only [hcf, core.result.Result.Insts.CoreOpsTryTraitFromResidualResultInfallible.from_residual]
      try simp
    | Ok u =>
    obtain ⟨h4, hC⟩ := hr3
    step as ⟨cf2, hcf2⟩
    simp only [hcf2]
    -- the tables
    have hrt : ReadTable reads.val t.val (dagWidths t.val) :=
      ⟨h3, fun r hr => hR.var_lt r (by unfold IsRead at hr; omega),
        fun r hr => hR.var_node r (by unfold IsRead at hr; omega),
        fun r hr => hR.idx_lt r (by unfold IsRead at hr; omega),
        fun r hr => hR.idx_w r (by unfold IsRead at hr; omega),
        fun r r' hr => hR.nodup r r' (by unfold IsRead at hr; omega),
        fun r r' hr hr' => hR.var_inj r r' (by unfold IsRead at hr; omega) (by unfold IsRead at hr'; omega)⟩
    have hct : CallTable calls.val cargs.val t.val :=
      ⟨h4, fun c hc => hC.var_lt c (by unfold IsCall at hc; omega),
        fun c hc => hC.var_node c (by unfold IsCall at hc; omega),
        fun c hc => hC.args_rng c (by unfold IsCall at hc; omega),
        fun c hc => hC.args_lt c (by unfold IsCall at hc; omega),
        fun c c' hc => hC.nodup c c' (by unfold IsCall at hc; omega),
        fun c c' hc hc' => hC.var_inj c c' (by unfold IsCall at hc; omega) (by unfold IsCall at hc'; omega)⟩
    have hisr : ∀ r, IsRead reads.val r → 3 * r < reads.val.length := by
      intro r hr; unfold IsRead at hr; omega
    have hisc : ∀ c, IsCall calls.val c → 4 * c < calls.val.length := by
      intro c hc; unfold IsCall at hc; omega
    -- a read variable keeps class 2 through `call_entries`; a call variable had class 0
    have hread2 : ∀ r, IsRead reads.val r → s7.val.getD (rdV reads.val r).val 0#usize = 2#usize := by
      intro r hr
      have h2 : s3.val.getD (rdV reads.val r).val 0#usize = 2#usize :=
        (hR.c2 _ (hR.var_lt r (hisr r hr))).mpr ⟨r, hisr r hr, rfl⟩
      by_cases h3' : s7.val.getD (rdV reads.val r).val 0#usize = 3#usize
      · obtain ⟨c, hc, hcv⟩ := (hC.c3 _ (hR.var_lt r (hisr r hr))).mp h3'
        have := hC.fresh c hc
        rw [hcv, h2] at this
        cases this
      · rw [hC.cR _ (hR.var_lt r (hisr r hr)) h3']
        exact h2
    have hrc : ∀ r c, IsRead reads.val r → IsCall calls.val c → rdV reads.val r ≠ clV calls.val c := by
      intro r c hr hc heq
      have h2 : s3.val.getD (rdV reads.val r).val 0#usize = 2#usize :=
        (hR.c2 _ (hR.var_lt r (hisr r hr))).mpr ⟨r, hisr r hr, rfl⟩
      have h0 := hC.fresh c (hisc c hc)
      rw [← heq, h2] at h0
      cases h0
    -- the initial class facts of the main loop
    have hcf0 : ClsFacts e.val ebits.val eside.val map.val t.val reads.val calls.val cargs.val
        s7.val s8.val 0 := by
      refine ⟨hC.len, hC.elen, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
      · intro m hm
        constructor
        · intro h1
          exfalso
          by_cases h3' : s7.val.getD m 0#usize = 3#usize
          · rw [h1] at h3'; cases h3'
          · rw [hC.cR m hm h3'] at h1
            rcases hR.c0 m hm with h | h <;> rw [h1] at h <;> cases h
        · rintro ⟨u, hu, _⟩; omega
      · intro m hm
        constructor
        · intro h
          have h2 : s3.val.getD m 0#usize = 2#usize := by
            rcases h with h | h
            · by_cases h3' : s7.val.getD m 0#usize = 3#usize
              · rw [h] at h3'; cases h3'
              · rw [← hC.cR m hm h3']; exact h
            · exfalso
              by_cases h3' : s7.val.getD m 0#usize = 3#usize
              · rw [h] at h3'; cases h3'
              · rw [hC.cR m hm h3'] at h
                rcases hR.c0 m hm with h' | h' <;> rw [h] at h' <;> cases h'
          obtain ⟨r, hr, hrv⟩ := (hR.c2 m hm).mp h2
          exact ⟨r, by unfold IsRead; omega, hrv⟩
        · rintro ⟨r, hr, hrv⟩
          left
          rw [← hrv]
          exact hread2 r hr
      · intro m hm h4'
        exfalso
        by_cases h3' : s7.val.getD m 0#usize = 3#usize
        · rw [h4'] at h3'; cases h3'
        · rw [hC.cR m hm h3'] at h4'
          rcases hR.c0 m hm with h | h <;> rw [h4'] at h <;> cases h
      · intro m hm
        constructor
        · intro h
          have h3' : s7.val.getD m 0#usize = 3#usize := by
            rcases h with h | h
            · exact h
            · exfalso
              by_cases h3' : s7.val.getD m 0#usize = 3#usize
              · rw [h] at h3'; cases h3'
              · rw [hC.cR m hm h3'] at h
                rcases hR.c0 m hm with h' | h' <;> rw [h] at h' <;> cases h'
          obtain ⟨c, hc, hcv⟩ := (hC.c3 m hm).mp h3'
          exact ⟨c, by unfold IsCall; omega, hcv⟩
        · rintro ⟨c, hc, hcv⟩
          left
          exact (hC.c3 m hm).mpr ⟨c, hisc c hc, hcv⟩
      · intro m hm h5
        exfalso
        by_cases h3' : s7.val.getD m 0#usize = 3#usize
        · rw [h5] at h3'; cases h3'
        · rw [hC.cR m hm h3'] at h5
          rcases hR.c0 m hm with h | h <;> rw [h5] at h <;> cases h
      · intro r hr
        rw [hC.entR _ (fun c hc heq => hrc r c hr (by unfold IsCall; omega) (UScalar.eq_of_val_eq heq.symm))]
        exact hR.ent_r r (hisr r hr)
      · intro c hc
        exact hC.ent_c c (hisc c hc)
    -- the main loop
    have hderef2 : (alloc.vec.Vec.deref s8).val = s8.val := rfl
    step with (check_sliver_lowering_loop1_spec e ebits eside map reads calls cargs t tbits (Slice.len e)
      ⟨s7.val, s7.property⟩ ⟨s8.val, s8.property⟩ none 0#usize (dagWidths t.val) (by simp) hmap hewf' hrt hct
      ⟨by simp, fun _ => ⟨hcf0, fun j hj => by simp at hj, fun u u' m hu => by simp at hu⟩⟩)
      as ⟨cls3, failure, hloop⟩
    cases failure with
    | some err => simp
    | none =>
    obtain ⟨hcf, hcorr, hinj⟩ := hloop rfl
    try dsimp only at hcf
    -- liveness
    have hderef3 : (alloc.vec.Vec.deref cls3).val = cls3.val := rfl
    step with (dead_entry_spec (alloc.vec.Vec.deref cls3)) as ⟨dead, hdle, hdead⟩
    rw [hderef3] at hdle hdead
    split
    · simp
    · rename_i hdge
      have hdead' := hdead (by have := hcf.len; scalar_tac)
      -- the roots
      step with (ext_roots_corr_spec eroots map troots) as ⟨b, hb⟩
      split
      · rename_i hbt
        obtain ⟨hrlen, hrc'⟩ := hb hbt
        step with (array_cong_spec reads t tbits troots (Slice.len eroots) h3 (by simp; exact hrlen))
          as ⟨ok_a, idx_a, hra⟩
        split
        · rename_i hokat
          obtain ⟨hia1, hia2, harr⟩ := hra hokat
          step with (uf_cong_spec calls cargs t troots idx_a h4 hia2 hct.args_rng) as ⟨ok_u, idx_u, hru⟩
          split
          · rename_i hokut
            obtain ⟨hiu1, hiu2, huf⟩ := hru hokut
            split
            · simp
            · rename_i hidxu
              have hidxu' : idx_u.val = troots.val.length := by scalar_tac
              try rw [WP.spec_ok]
              refine ⟨hewf', htwf', (by have := t.length_ineq; omega), hmap, hrt, hct, hrc, hcorr, hinj,
                ?_, ?_, ?_, hrlen, hrc', ?_⟩
              · -- the classes are disjoint
                intro u hu w hw hne
                have hm : (img map.val u).val < t.val.length := (hcorr u hu hne).1
                have h1 : cls3.val.getD (img map.val u).val 0#usize = 1#usize :=
                  (hcf.c1 _ hm).mpr ⟨u, hu, hu, ⟨w, hw⟩, hne, rfl⟩
                refine ⟨?_, ?_⟩
                · intro r hr heq
                  have := (hcf.c2 _ hm).mpr ⟨r, hr, heq⟩
                  rcases this with h | h <;> rw [h1] at h <;> cases h
                · intro c hc heq
                  have := (hcf.c3 _ hm).mpr ⟨c, hc, heq⟩
                  rcases this with h | h <;> rw [h1] at h <;> cases h
              · -- every read entry is live
                intro r hr
                have hm := hrt.var_lt r hr
                have h24 := (hcf.c2 _ hm).mpr ⟨r, hr, rfl⟩
                have hne2 := (hdead' _ (by rw [hcf.len]; exact hm)).1
                have h4' : cls3.val.getD (rdV reads.val r).val 0#usize = 4#usize := by
                  rcases h24 with h | h
                  · exact absurd h hne2
                  · exact h
                obtain ⟨r', i, hr', hrv, _, hsm⟩ := hcf.c4 _ hm h4'
                have : r' = r := hrt.var_inj r' r hr' hr (UScalar.eq_of_val_eq hrv)
                subst this
                exact ⟨i, hsm⟩
              · -- every call entry is live
                intro c hc
                have hm := hct.var_lt c hc
                have h35 := (hcf.c3 _ hm).mpr ⟨c, hc, rfl⟩
                have hne3 := (hdead' _ (by rw [hcf.len]; exact hm)).2
                have h5 : cls3.val.getD (clV calls.val c).val 0#usize = 5#usize := by
                  rcases h35 with h | h
                  · exact absurd h hne3
                  · exact h
                obtain ⟨c', i, hc', hcv, _, hcm⟩ := hcf.c5 _ hm h5
                have : c' = c := hct.var_inj c' c hc' hc (UScalar.eq_of_val_eq hcv)
                subst this
                exact ⟨i, hcm⟩
              · refine ⟨idx_a.val, by simpa using hia1, hia2, harr, ?_⟩
                rw [← hidxu']
                exact huf
          · simp
        · simp
      · simp

/-- Everything an accepted `check_sliver_lowering` establishes. -/
theorem check_sliver_lowering_accepted (e : Slice ExtNode) (ebits : Slice Bool)
    (eside eroots map reads calls cargs : Slice Std.Usize) (t : Slice blast_kernel.DagNode)
    (tbits : Slice Bool) (troots : Slice Std.Usize)
    (h : kernel.sliver_kernel.check_sliver_lowering e ebits eside eroots map reads calls cargs t tbits
      troots = ok (core.result.Result.Ok ())) :
    SliverCorr e.val ebits.val eside.val eroots.val map.val reads.val calls.val cargs.val t.val
      tbits.val troots.val := by
  have := check_sliver_lowering_spec e ebits eside eroots map reads calls cargs t tbits troots
  rw [h, WP.spec_ok] at this
  exact this

/- ══════════════════ VALUES: THE SEMANTIC CORRESPONDENCE ══════════════════ -/

theorem dval_toW_self (v : DVal) (w : Nat) (hw : v.1 = w) : (⟨w, toW w v⟩ : DVal) = v := by
  obtain ⟨w', A⟩ := v
  simp only at hw
  subst hw
  simp [toW]

/-- `toW` at a value's own width is its bitvector. -/
theorem toW_eq_snd (v : DVal) (w : Nat) (hw : v.1 = w) (A : BitVec w) (hA : v = ⟨w, A⟩) :
    toW w v = A := by
  subst hA
  simp [toW]

theorem toW_inj_of_width (v v' : DVal) (w : Nat) (hv : v.1 = w) (hv' : v'.1 = w)
    (h : toW w v = toW w v') : v = v' := by
  obtain ⟨a, A⟩ := v
  obtain ⟨b, B⟩ := v'
  simp only at hv hv'
  subst hv hv'
  simp only [toW, BitVec.setWidth_eq] at h
  rw [h]

theorem bitsEq_bvOfFn (a : List Bool) (s0 : Nat) (b : List Bool) (s1 w : Nat)
    (h : BitsEq a s0 b s1 w) :
    bvOfFn (fun k => a.getD (s0 + k) false) w = bvOfFn (fun k => b.getD (s1 + k) false) w :=
  bvOfFn_congr _ _ w h.2.2

theorem not_bitsEq_bvOfFn (a : List Bool) (s0 : Nat) (b : List Bool) (s1 w : Nat)
    (h0 : s0 + w ≤ a.length) (h1 : s1 + w ≤ b.length) (h : ¬ BitsEq a s0 b s1 w) :
    bvOfFn (fun k => a.getD (s0 + k) false) w ≠ bvOfFn (fun k => b.getD (s1 + k) false) w := by
  intro heq
  apply h
  refine ⟨h0, h1, fun k hk => ?_⟩
  have := congrArg (fun v => v.getLsbD k) heq
  simp only [getLsbD_bvOfFn, hk, decide_true, Bool.true_and] at this
  exact this

/-- The value of a core node from its node, over the full simulation. -/
theorem dagSim_node (inp bits : List Bool) (t : List blast_kernel.DagNode) (m : Nat) (hm : m < t.length) :
    (dagSim inp bits t).getD m dDflt
      = dagNodeVal inp bits (dagSim inp bits (t.take m)) (dagNin (t.take m)) t[m] :=
  dagSim_getD_eq inp bits t m hm

theorem dagSim_var (inp bits : List Bool) (t : List blast_kernel.DagNode) (m : Nat) (hm : m < t.length)
    (w : Std.Usize) (hv : t[m] = .Var w) :
    (dagSim inp bits t).getD m dDflt
      = ⟨w.val, bvOfFn (fun j => inp.getD (dagNin (t.take m) + j) false) w.val⟩ := by
  rw [dagSim_node inp bits t m hm, hv]
  rfl

theorem dagSim_const (inp bits : List Bool) (t : List blast_kernel.DagNode) (m : Nat) (hm : m < t.length)
    (s w : Std.Usize) (hv : t[m] = .Const s w) :
    (dagSim inp bits t).getD m dDflt
      = ⟨w.val, bvOfFn (fun j => bits.getD (s.val + j) false) w.val⟩ := by
  rw [dagSim_node inp bits t m hm, hv]
  rfl

theorem dagSim_eqnode (inp bits : List Bool) (t : List blast_kernel.DagNode) (m : Nat)
    (hm : m < t.length) (a b : Std.Usize) (hv : t[m] = .Eq a b) (ha : a.val < m) (hb : b.val < m) :
    (dagSim inp bits t).getD m dDflt
      = bvBool (decide (((dagSim inp bits t).getD a.val dDflt).2
          = toW _ ((dagSim inp bits t).getD b.val dDflt))) := by
  rw [dagSim_node inp bits t m hm, hv]
  simp only [dagNodeVal]
  rw [dagSim_take_getD inp bits t m a.val ha, dagSim_take_getD inp bits t m b.val hb]

theorem dagSim_notnode (inp bits : List Bool) (t : List blast_kernel.DagNode) (m : Nat)
    (hm : m < t.length) (a : Std.Usize) (hv : t[m] = .Not a) (ha : a.val < m) :
    (dagSim inp bits t).getD m dDflt = bvBool (!bval ((dagSim inp bits t).getD a.val dDflt)) := by
  rw [dagSim_node inp bits t m hm, hv]
  simp only [dagNodeVal]
  rw [dagSim_take_getD inp bits t m a.val ha]

theorem dagSim_ornode (inp bits : List Bool) (t : List blast_kernel.DagNode) (m : Nat)
    (hm : m < t.length) (a b : Std.Usize) (hv : t[m] = .BoolOr a b) (ha : a.val < m) (hb : b.val < m) :
    (dagSim inp bits t).getD m dDflt
      = bvBool (bval ((dagSim inp bits t).getD a.val dDflt) || bval ((dagSim inp bits t).getD b.val dDflt)) := by
  rw [dagSim_node inp bits t m hm, hv]
  simp only [dagNodeVal]
  rw [dagSim_take_getD inp bits t m a.val ha, dagSim_take_getD inp bits t m b.val hb]

theorem dagSim_andnode (inp bits : List Bool) (t : List blast_kernel.DagNode) (m : Nat)
    (hm : m < t.length) (a b : Std.Usize) (hv : t[m] = .BoolAnd a b) (ha : a.val < m) (hb : b.val < m) :
    (dagSim inp bits t).getD m dDflt
      = bvBool (bval ((dagSim inp bits t).getD a.val dDflt) && bval ((dagSim inp bits t).getD b.val dDflt)) := by
  rw [dagSim_node inp bits t m hm, hv]
  simp only [dagNodeVal]
  rw [dagSim_take_getD inp bits t m a.val ha, dagSim_take_getD inp bits t m b.val hb]

theorem dagSim_itenode (inp bits : List Bool) (t : List blast_kernel.DagNode) (m : Nat)
    (hm : m < t.length) (c tt ee : Std.Usize) (hv : t[m] = .Ite c tt ee) (hc : c.val < m)
    (ht : tt.val < m) (he : ee.val < m) :
    (dagSim inp bits t).getD m dDflt
      = ⟨((dagSim inp bits t).getD tt.val dDflt).1,
          if bval ((dagSim inp bits t).getD c.val dDflt) then ((dagSim inp bits t).getD tt.val dDflt).2
          else toW _ ((dagSim inp bits t).getD ee.val dDflt)⟩ := by
  rw [dagSim_node inp bits t m hm, hv]
  simp only [dagNodeVal]
  rw [dagSim_take_getD inp bits t m c.val hc, dagSim_take_getD inp bits t m tt.val ht,
    dagSim_take_getD inp bits t m ee.val he]

/-- The width of core node `m` from its node. -/
theorem dagWidths_node (t : List blast_kernel.DagNode) (m : Nat) (hm : m < t.length) :
    (dagWidths t).getD m 0 = dagNodeWidth (dagWidths (t.take m)) t[m] :=
  dagWidths_getD_eq t m hm

theorem dagWidths_var (t : List blast_kernel.DagNode) (m : Nat) (hm : m < t.length) (w : Std.Usize)
    (hv : t[m] = .Var w) : (dagWidths t).getD m 0 = w.val := by
  rw [dagWidths_node t m hm, hv]
  rfl

theorem dagWidths_const (t : List blast_kernel.DagNode) (m : Nat) (hm : m < t.length) (s w : Std.Usize)
    (hv : t[m] = .Const s w) : (dagWidths t).getD m 0 = w.val := by
  rw [dagWidths_node t m hm, hv]
  rfl

theorem extWidths_node (e : List ExtNode) (i : Nat) (hi : i < e.length) :
    (extWidths e).getD i 0 = extNodeWidth (extWidths (e.take i)) e[i] :=
  extWidths_getD_eq e i hi

theorem extWidths_const (e : List ExtNode) (i : Nat) (hi : i < e.length) (s w : Std.Usize)
    (hv : e[i] = .Core (.Const s w)) : (extWidths e).getD i 0 = w.val := by
  rw [extWidths_node e i hi, hv]
  rfl

theorem extSim_node (inp bits : List Bool) (arrs : Arrs) (ufs : Ufs) (side : List Std.Usize)
    (e : List ExtNode) (i : Nat) (hi : i < e.length) :
    (extSim inp bits arrs ufs side e).getD i dDflt
      = extNodeVal inp bits arrs ufs side (extSim inp bits arrs ufs side (e.take i)) (extNin (e.take i)) e[i] :=
  extSim_getD_eq inp bits arrs ufs side e i hi

theorem extSim_const (inp bits : List Bool) (arrs : Arrs) (ufs : Ufs) (side : List Std.Usize)
    (e : List ExtNode) (i : Nat) (hi : i < e.length) (s w : Std.Usize) (hv : e[i] = .Core (.Const s w)) :
    (extSim inp bits arrs ufs side e).getD i dDflt
      = ⟨w.val, bvOfFn (fun j => bits.getD (s.val + j) false) w.val⟩ := by
  rw [extSim_node inp bits arrs ufs side e i hi, hv]
  rfl

/-- `pExtConst` reads a constant node. -/
theorem pExtConst_some {e : List ExtNode} {x : Nat} {s w : Std.Usize} (h : pExtConst e x = some (s, w)) :
    ∃ (hx : x < e.length), e[x] = .Core (.Const s w) := by
  unfold pExtConst at h
  cases hg : e[x]? with
  | none => rw [hg] at h; cases h
  | some nd =>
    rw [hg] at h
    have hx : x < e.length := List.getElem?_eq_some_iff.mp hg |>.1
    have hnd : e[x] = nd := by
      rw [List.getElem?_eq_getElem hx] at hg
      exact Option.some.inj hg
    refine ⟨hx, ?_⟩
    rw [hnd]
    cases nd with
    | Core d =>
      cases d <;> simp at h
      obtain ⟨rfl, rfl⟩ := h
      rfl
    | Select _ _ _ _ => simp at h
    | Call _ _ _ _ => simp at h

/-- The read-over-write only reads the chain's nodes and the index value. -/
theorem chainRead_congr (arrs : Arrs) (V V' : List DVal) (side : List Std.Usize) (aid : Nat)
    (jv : BitVec 32) : ∀ (n off : Nat),
    (∀ l < n, V.getD (side.getD (off + 2 * l) 0#usize).val dDflt = V'.getD (side.getD (off + 2 * l) 0#usize).val dDflt ∧
      V.getD (side.getD (off + 2 * l + 1) 0#usize).val dDflt = V'.getD (side.getD (off + 2 * l + 1) 0#usize).val dDflt) →
    chainRead arrs V side aid jv off n = chainRead arrs V' side aid jv off n := by
  intro n
  induction n with
  | zero => intro off _; rfl
  | succ n ih =>
    intro off h
    simp only [chainRead]
    have h0 := h 0 (by omega)
    simp only [Nat.mul_zero, Nat.add_zero] at h0
    rw [h0.1, h0.2]
    rw [ih (off + 2) (fun l hl => by
      have := h (l + 1) (by omega)
      have e1 : off + 2 + 2 * l = off + 2 * (l + 1) := by omega
      rw [e1]
      exact this)]

theorem argVals_congr (V V' : List DVal) (side : List Std.Usize) (s n : Nat)
    (h : ∀ l < n, V.getD (side.getD (s + l) 0#usize).val dDflt = V'.getD (side.getD (s + l) 0#usize).val dDflt) :
    argVals V side s n = argVals V' side s n := by
  unfold argVals
  apply List.map_congr_left
  intro l hl
  exact h l (List.mem_range.mp hl)

/-- Extended variables read the same bits as their images (phase 7's
    `VarsAgree`, with the extended query on the left). -/
def ExtVarsAgree (e : List ExtNode) (t : List blast_kernel.DagNode) (map : List Std.Usize)
    (inp0 inp1 : List Bool) : Prop :=
  ∀ i (hi : i < e.length) (w : Std.Usize), e[i] = .Core (.Var w) → img map i ≠ NONE →
    ∀ j < w.val, inp0.getD (extNin (e.take i) + j) false
      = inp1.getD (dagNin (t.take (img map i).val) + j) false

/-- The two sides agree on everything the tables register: a read variable
    holds the array's byte at its index's core value, a call variable the
    function's result (coerced to the variable's width) on its arguments'
    core values. -/
def TablesAgree (t : List blast_kernel.DagNode) (tbits : List Bool) (reads calls cargs : List Std.Usize)
    (arrs : Arrs) (ufs : Ufs) (inp1 : List Bool) : Prop :=
  (∀ r, IsRead reads r → (dagSim inp1 tbits t).getD (rdV reads r).val dDflt
    = ⟨8, arrs (rdA reads r).val (toW 32 ((dagSim inp1 tbits t).getD (rdX reads r).val dDflt))⟩) ∧
  (∀ c, IsCall calls c → (dagSim inp1 tbits t).getD (clV calls c).val dDflt
    = ⟨(dagWidths t).getD (clV calls c).val 0,
        toW _ (ufs (clF calls c).val
          (argVals (dagSim inp1 tbits t) cargs (clS calls c).val (clK calls c).val))⟩)

/-- The correspondence holds for every mapped node below `i`. -/
def CorrBelow (e : List ExtNode) (ebits : List Bool) (eside map : List Std.Usize)
    (t : List blast_kernel.DagNode) (tbits : List Bool) (inp0 inp1 : List Bool) (arrs : Arrs) (ufs : Ufs)
    (i : Nat) : Prop :=
  ∀ i' < i, img map i' ≠ NONE →
    (extSim inp0 ebits arrs ufs eside e).getD i' dDflt = (dagSim inp1 tbits t).getD (img map i').val dDflt

theorem ite_or_not (d : blast_kernel.DagNode) :
    (∃ c tt ee, d = .Ite c tt ee) ∨ pTag d ≠ pTag (.Ite 0#usize 0#usize 0#usize) := by
  cases d <;> first | exact Or.inl ⟨_, _, _, rfl⟩ | (right; simp [pTag])

/-- One `ite` level of the chain walk (the index is not a resolvable
    constant pair): the current node is `ite(img x = img j, img v, rest)`
    and the rest of the walk gives `rest` the rest of the chain. -/
theorem chain_ite_level (e : List ExtNode) (ebits : List Bool)
    (eside eroots map reads calls cargs : List Std.Usize) (t : List blast_kernel.DagNode) (tbits : List Bool)
    (troots : List Std.Usize)
    (hc : SliverCorr e ebits eside eroots map reads calls cargs t tbits troots)
    (inp0 inp1 : List Bool) (arrs : Arrs) (ufs : Ufs) (i : Nat)
    (hIH : CorrBelow e ebits eside map t tbits inp0 inp1 arrs ufs i)
    (aid j : Std.Usize) (hj : j.val < i) (hjw : (extWidths e).getD j.val 0 = 32)
    (n off : Nat) (cur : Std.Usize) (hcur : cur.val < t.length)
    (hlev' : ∀ l < n, (eside.getD (off + 2 + 2 * l) 0#usize).val < i ∧
      (extWidths e).getD (eside.getD (off + 2 + 2 * l) 0#usize).val 0 = 32 ∧
      (eside.getD (off + 2 + 2 * l + 1) 0#usize).val < i ∧
      (extWidths e).getD (eside.getD (off + 2 + 2 * l + 1) 0#usize).val 0 = 8)
    (x v : Std.Usize) (hx : x.val < i) (hxw : (extWidths e).getD x.val 0 = 32) (hvl : v.val < i)
    (hvw : (extWidths e).getD v.val 0 = 8)
    (hunf : pWalk e ebits eside map t j (n + 1) off cur
      = if cur.val < t.length then
          match t.getD cur.val dfltNode with
          | .Ite c tt ee =>
            if tt = img map v.val ∧ c.val < t.length ∧
                t.getD c.val dfltNode = .Eq (img map x.val) (img map j.val)
            then pWalk e ebits eside map t j n (off + 2) ee
            else .fail
          | _ => .fail
        else .fail)
    (hvv : ∀ cur0 : Std.Usize, cur0 = img map v.val → cur0.val < t.length →
      (dagSim inp1 tbits t).getD cur0.val dDflt
        = ⟨8, toW 8 ((extSim inp0 ebits arrs ufs eside e).getD v.val dDflt)⟩)
    (hcond : (toW 32 ((extSim inp0 ebits arrs ufs eside e).getD x.val dDflt)
        = toW 32 ((extSim inp0 ebits arrs ufs eside e).getD j.val dDflt)) ↔
      (((extSim inp0 ebits arrs ufs eside e).getD x.val dDflt).2
        = toW ((extSim inp0 ebits arrs ufs eside e).getD x.val dDflt).1
          ((extSim inp0 ebits arrs ufs eside e).getD j.val dDflt)))
    (ih : ∀ (off : Nat) (cur : Std.Usize), cur.val < t.length →
      (∀ l < n, (eside.getD (off + 2 * l) 0#usize).val < i ∧
        (extWidths e).getD (eside.getD (off + 2 * l) 0#usize).val 0 = 32 ∧
        (eside.getD (off + 2 * l + 1) 0#usize).val < i ∧
        (extWidths e).getD (eside.getD (off + 2 * l + 1) 0#usize).val 0 = 8) →
      (pWalk e ebits eside map t j n off cur = .resolved →
        (dagSim inp1 tbits t).getD cur.val dDflt
          = ⟨8, chainRead arrs (extSim inp0 ebits arrs ufs eside e) eside aid.val
              (toW 32 ((extSim inp0 ebits arrs ufs eside e).getD j.val dDflt)) off n⟩) ∧
      (∀ cur', pWalk e ebits eside map t j n off cur = .base cur' →
        (dagSim inp1 tbits t).getD cur'.val dDflt
          = ⟨8, arrs aid.val (toW 32 ((extSim inp0 ebits arrs ufs eside e).getD j.val dDflt))⟩ →
        (dagSim inp1 tbits t).getD cur.val dDflt
          = ⟨8, chainRead arrs (extSim inp0 ebits arrs ufs eside e) eside aid.val
              (toW 32 ((extSim inp0 ebits arrs ufs eside e).getD j.val dDflt)) off n⟩)) :
    (pWalk e ebits eside map t j (n + 1) off cur = .resolved →
      (dagSim inp1 tbits t).getD cur.val dDflt
        = ⟨8, if toW 32 ((extSim inp0 ebits arrs ufs eside e).getD x.val dDflt)
                = toW 32 ((extSim inp0 ebits arrs ufs eside e).getD j.val dDflt)
              then toW 8 ((extSim inp0 ebits arrs ufs eside e).getD v.val dDflt)
              else chainRead arrs (extSim inp0 ebits arrs ufs eside e) eside aid.val
                (toW 32 ((extSim inp0 ebits arrs ufs eside e).getD j.val dDflt)) (off + 2) n⟩) ∧
    (∀ cur', pWalk e ebits eside map t j (n + 1) off cur = .base cur' →
      (dagSim inp1 tbits t).getD cur'.val dDflt
        = ⟨8, arrs aid.val (toW 32 ((extSim inp0 ebits arrs ufs eside e).getD j.val dDflt))⟩ →
      (dagSim inp1 tbits t).getD cur.val dDflt
        = ⟨8, if toW 32 ((extSim inp0 ebits arrs ufs eside e).getD x.val dDflt)
                = toW 32 ((extSim inp0 ebits arrs ufs eside e).getD j.val dDflt)
              then toW 8 ((extSim inp0 ebits arrs ufs eside e).getD v.val dDflt)
              else chainRead arrs (extSim inp0 ebits arrs ufs eside e) eside aid.val
                (toW 32 ((extSim inp0 ebits arrs ufs eside e).getD j.val dDflt)) (off + 2) n⟩) := by
  set V0 := extSim inp0 ebits arrs ufs eside e with hV0
  rw [if_pos hcur, getD_eq_getElem_of_lt hcur] at hunf
  rcases ite_or_not t[cur.val] with ⟨c, tt, ee, hd⟩ | hnite
  · rw [hd, walk_ite_red] at hunf
    have hwf := hc.twf cur.val hcur
    rw [hd] at hwf
    obtain ⟨hcl, htl, hel, _, _, _⟩ := hwf
    -- the rest of the walk (either outcome) gives `ee` the rest of the chain
    have hrest : ∀ (W : WalkEnd), pWalk e ebits eside map t j (n + 1) off cur = W →
        (W = .resolved ∨ ∃ cur', W = .base cur' ∧ (dagSim inp1 tbits t).getD cur'.val dDflt
          = ⟨8, arrs aid.val (toW 32 (V0.getD j.val dDflt))⟩) →
        (tt = img map v.val ∧ c.val < t.length ∧
          t.getD c.val dfltNode = .Eq (img map x.val) (img map j.val)) ∧
        (dagSim inp1 tbits t).getD ee.val dDflt
          = ⟨8, chainRead arrs V0 eside aid.val (toW 32 (V0.getD j.val dDflt)) (off + 2) n⟩ := by
      intro W hW hout
      rw [hW] at hunf
      split at hunf
      · rename_i hcnd
        refine ⟨hcnd, ?_⟩
        obtain ⟨ih1, ih2⟩ := ih (off + 2) ee (by omega) hlev'
        rcases hout with rfl | ⟨cur', rfl, hv'⟩
        · exact ih1 hunf.symm
        · exact ih2 cur' hunf.symm hv'
      · rcases hout with rfl | ⟨cur', rfl, _⟩ <;> cases hunf
    -- the value of `cur` from its `ite`
    have hmain : (tt = img map v.val ∧ c.val < t.length ∧
          t.getD c.val dfltNode = .Eq (img map x.val) (img map j.val)) →
        (dagSim inp1 tbits t).getD ee.val dDflt
          = ⟨8, chainRead arrs V0 eside aid.val (toW 32 (V0.getD j.val dDflt)) (off + 2) n⟩ →
        (dagSim inp1 tbits t).getD cur.val dDflt
          = ⟨8, if toW 32 (V0.getD x.val dDflt) = toW 32 (V0.getD j.val dDflt)
                then toW 8 (V0.getD v.val dDflt)
                else chainRead arrs V0 eside aid.val (toW 32 (V0.getD j.val dDflt)) (off + 2) n⟩ := by
      rintro ⟨htv, hcl', hceq⟩ hee
      rw [dagSim_itenode inp1 tbits t cur.val hcur c tt ee hd hcl htl hel]
      rw [getD_eq_getElem_of_lt hcl'] at hceq
      have hwfc := hc.twf c.val hcl'
      rw [hceq] at hwfc
      obtain ⟨hxl, hjl, _, _⟩ := hwfc
      have hxne : img map x.val ≠ NONE := ne_NONE_of_lt hc.tcap (by omega)
      have hjne : img map j.val ≠ NONE := ne_NONE_of_lt hc.tcap (by omega)
      rw [dagSim_eqnode inp1 tbits t c.val hcl' _ _ hceq hxl hjl]
      rw [← hIH x.val hx hxne, ← hIH j.val hj hjne]
      rw [hvv tt htv (by omega), hee]
      simp only [bval_bvBool]
      by_cases hP : toW 32 (V0.getD x.val dDflt) = toW 32 (V0.getD j.val dDflt)
      · rw [if_pos hP]
        rw [decide_eq_true (hcond.mp hP)]
        simp
      · rw [if_neg hP]
        rw [decide_eq_false (fun h => hP (hcond.mpr h))]
        simp [toW]
    refine ⟨fun h => ?_, fun cur' h hv' => ?_⟩
    · obtain ⟨hcnd, hee⟩ := hrest _ h (Or.inl rfl)
      exact hmain hcnd hee
    · obtain ⟨hcnd, hee⟩ := hrest _ h (Or.inr ⟨cur', rfl, hv'⟩)
      exact hmain hcnd hee
  · rw [walk_nite_red _ _ _ _ _ _ _ _ _ _ _ hnite] at hunf
    refine ⟨fun h => ?_, fun cur' h _ => ?_⟩
    · rw [hunf] at h; cases h
    · rw [hunf] at h; cases h

/-- The chain walk computes the read-over-write: from a current core node
    `cur`, `n` levels from side offset `off`, a walk that resolves — or ends
    at a base node holding the array's byte at the index — gives `cur` the
    chain's value. -/
theorem chain_val (e : List ExtNode) (ebits : List Bool) (eside eroots map reads calls cargs : List Std.Usize)
    (t : List blast_kernel.DagNode) (tbits : List Bool) (troots : List Std.Usize)
    (hc : SliverCorr e ebits eside eroots map reads calls cargs t tbits troots)
    (inp0 inp1 : List Bool) (arrs : Arrs) (ufs : Ufs) (i : Nat)
    (hIH : CorrBelow e ebits eside map t tbits inp0 inp1 arrs ufs i)
    (aid j : Std.Usize) (hj : j.val < i) (hjw : (extWidths e).getD j.val 0 = 32) :
    ∀ (n off : Nat) (cur : Std.Usize), cur.val < t.length →
      (∀ l < n, (eside.getD (off + 2 * l) 0#usize).val < i ∧
        (extWidths e).getD (eside.getD (off + 2 * l) 0#usize).val 0 = 32 ∧
        (eside.getD (off + 2 * l + 1) 0#usize).val < i ∧
        (extWidths e).getD (eside.getD (off + 2 * l + 1) 0#usize).val 0 = 8) →
      (pWalk e ebits eside map t j n off cur = .resolved →
        (dagSim inp1 tbits t).getD cur.val dDflt
          = ⟨8, chainRead arrs (extSim inp0 ebits arrs ufs eside e) eside aid.val
              (toW 32 ((extSim inp0 ebits arrs ufs eside e).getD j.val dDflt)) off n⟩) ∧
      (∀ cur', pWalk e ebits eside map t j n off cur = .base cur' →
        (dagSim inp1 tbits t).getD cur'.val dDflt
          = ⟨8, arrs aid.val (toW 32 ((extSim inp0 ebits arrs ufs eside e).getD j.val dDflt))⟩ →
        (dagSim inp1 tbits t).getD cur.val dDflt
          = ⟨8, chainRead arrs (extSim inp0 ebits arrs ufs eside e) eside aid.val
              (toW 32 ((extSim inp0 ebits arrs ufs eside e).getD j.val dDflt)) off n⟩) := by
  intro n
  induction n with
  | zero =>
    intro off cur _ _
    refine ⟨fun h => by simp [pWalk] at h, fun cur' h hv => ?_⟩
    simp only [pWalk, WalkEnd.base.injEq] at h
    subst h
    exact hv
  | succ n ih =>
    intro off cur hcur hlev
    have hlev0 := hlev 0 (by omega)
    simp only [Nat.mul_zero, Nat.add_zero] at hlev0
    obtain ⟨hx, hxw, hvl, hvw⟩ := hlev0
    have hlev' : ∀ l < n, (eside.getD (off + 2 + 2 * l) 0#usize).val < i ∧
        (extWidths e).getD (eside.getD (off + 2 + 2 * l) 0#usize).val 0 = 32 ∧
        (eside.getD (off + 2 + 2 * l + 1) 0#usize).val < i ∧
        (extWidths e).getD (eside.getD (off + 2 + 2 * l + 1) 0#usize).val 0 = 8 := by
      intro l hl
      have := hlev (l + 1) (by omega)
      have e1 : off + 2 + 2 * l = off + 2 * (l + 1) := by omega
      rw [e1]
      exact this
    set V0 := extSim inp0 ebits arrs ufs eside e with hV0
    set x := eside.getD off 0#usize with hxdef
    set v := eside.getD (off + 1) 0#usize with hvdef
    set jv := toW 32 (V0.getD j.val dDflt) with hjv
    -- the value of `v` (width 8) and the equality of the two conditions
    have hvv : ∀ cur0 : Std.Usize, cur0 = img map v.val → cur0.val < t.length →
        (dagSim inp1 tbits t).getD cur0.val dDflt = ⟨8, toW 8 (V0.getD v.val dDflt)⟩ := by
      intro cur0 h0 hlt
      have hne : img map v.val ≠ NONE := by
        rw [← h0]; exact ne_NONE_of_lt hc.tcap hlt
      -- the width of `v` is 8
      have hw : (V0.getD v.val dDflt).1 = 8 := by
        rw [hV0, extSim_getD_fst]; exact hvw
      rw [h0, ← hIH v.val hvl hne, dval_toW_self _ _ hw]
    have hcond : (toW 32 (V0.getD x.val dDflt) = jv) ↔
        ((V0.getD x.val dDflt).2 = toW (V0.getD x.val dDflt).1 (V0.getD j.val dDflt)) := by
      have hwx : (V0.getD x.val dDflt).1 = 32 := by rw [hV0, extSim_getD_fst]; exact hxw
      have hwj : (V0.getD j.val dDflt).1 = 32 := by rw [hV0, extSim_getD_fst]; exact hjw
      rw [hjv]
      generalize V0.getD x.val dDflt = X at hwx ⊢
      generalize V0.getD j.val dDflt = J at hwj ⊢
      obtain ⟨wx, A⟩ := X
      obtain ⟨wj, B⟩ := J
      simp only at hwx hwj
      subst hwx hwj
      simp [toW]
    simp only [chainRead]
    cases hpx : pExtConst e x.val with
    | some px =>
      obtain ⟨xs, xw⟩ := px
      cases hpj : pExtConst e j.val with
      | some pj =>
        obtain ⟨js, jw⟩ := pj
        have hunf := pWalk_succ_const e ebits eside map t j n off cur xs xw js jw hpx hpj
        try rw [← hxdef] at hunf
        try rw [← hvdef] at hunf
        obtain ⟨hxl, hxc⟩ := pExtConst_some hpx
        obtain ⟨hjl, hjc⟩ := pExtConst_some hpj
        have hxval := extSim_const inp0 ebits arrs ufs eside e x.val hxl xs xw hxc
        have hjval := extSim_const inp0 ebits arrs ufs eside e j.val hjl js jw hjc
        have hxw32 : xw.val = 32 := by rw [← extWidths_const e x.val hxl xs xw hxc]; exact hxw
        have hjw32 : jw.val = 32 := by rw [← extWidths_const e j.val hjl js jw hjc]; exact hjw
        have hxwjw : xw = jw := UScalar.eq_of_val_eq (by rw [hxw32, hjw32])
        subst hxwjw
        -- the ranges of the two constants (for the unequal case)
        have hxrng : xs.val + xw.val ≤ ebits.length := by
          have := hc.ewf x.val hxl
          rw [hxc] at this
          exact this.2
        have hjrng : js.val + xw.val ≤ ebits.length := by
          have := hc.ewf j.val hjl
          rw [hjc] at this
          exact this.2
        have hwx : (V0.getD x.val dDflt).1 = 32 := by rw [hV0, extSim_getD_fst]; exact hxw
        have hwj : (V0.getD j.val dDflt).1 = 32 := by rw [hV0, extSim_getD_fst]; exact hjw
        by_cases hbe : BitsEq ebits xs.val ebits js.val xw.val
        · have hc' : xw = xw ∧ BitsEq ebits xs.val ebits js.val xw.val := ⟨rfl, hbe⟩
          rw [if_pos hc'] at hunf
          -- the condition holds: the level resolves
          have hcnd : toW 32 (V0.getD x.val dDflt) = jv := by
            rw [hjv, hV0, hxval, hjval, bitsEq_bvOfFn ebits xs.val ebits js.val xw.val hbe]
          rw [if_pos hcnd]
          refine ⟨fun h => ?_, fun cur' h _ => ?_⟩
          · rw [hunf] at h
            split at h
            · rename_i hce
              exact hvv cur hce hcur
            · cases h
          · rw [hunf] at h
            split at h <;> cases h
        · have hc' : ¬ (xw = xw ∧ BitsEq ebits xs.val ebits js.val xw.val) := fun h => hbe h.2
          rw [if_neg hc'] at hunf
          have hcnd : ¬ toW 32 (V0.getD x.val dDflt) = jv := by
            intro heq
            rw [hjv] at heq
            have hvx := toW_inj_of_width _ _ 32 hwx hwj heq
            rw [hV0, hxval, hjval] at hvx
            simp only [Sigma.mk.injEq, heq_eq_eq, true_and] at hvx
            exact not_bitsEq_bvOfFn ebits xs.val ebits js.val xw.val hxrng hjrng hbe hvx
          rw [if_neg hcnd]
          rw [hunf]
          exact ih (off + 2) cur hcur hlev'
      | none =>
        -- `j` is not a constant: the level is an `ite`
        have hunf := pWalk_succ_nconst e ebits eside map t j n off cur (Or.inr hpj)
        try rw [← hxdef] at hunf
        try rw [← hvdef] at hunf
        exact chain_ite_level e ebits eside eroots map reads calls cargs t tbits troots hc inp0 inp1 arrs ufs
          i hIH aid j hj hjw n off cur hcur hlev' x v hx hxw hvl hvw hunf hvv hcond ih
    | none =>
      have hunf := pWalk_succ_nconst e ebits eside map t j n off cur (Or.inl hpx)
      try rw [← hxdef] at hunf
      try rw [← hvdef] at hunf
      exact chain_ite_level e ebits eside eroots map reads calls cargs t tbits troots hc inp0 inp1 arrs ufs
        i hIH aid j hj hjw n off cur hcur hlev' x v hx hxw hvl hvw hunf hvv hcond ih

/-- **The syntactic correspondence is a semantic one**: under agreeing
    variables and base facts for the read / call variables a select / call
    reaches — facts that may use the correspondence below the node — every
    mapped extended node has the value of its image. -/
theorem sliver_corr_values_gen (e : List ExtNode) (ebits : List Bool)
    (eside eroots map reads calls cargs : List Std.Usize) (t : List blast_kernel.DagNode) (tbits : List Bool)
    (troots : List Std.Usize)
    (hc : SliverCorr e ebits eside eroots map reads calls cargs t tbits troots)
    (inp0 inp1 : List Bool) (arrs : Arrs) (ufs : Ufs)
    (hv : ExtVarsAgree e t map inp0 inp1)
    (hbase : ∀ i r, SelMapsTo e ebits eside map t reads i r →
      CorrBelow e ebits eside map t tbits inp0 inp1 arrs ufs i →
      (dagSim inp1 tbits t).getD (rdV reads r).val dDflt
        = ⟨8, arrs (rdA reads r).val (toW 32 ((dagSim inp1 tbits t).getD (rdX reads r).val dDflt))⟩)
    (hcbase : ∀ i c, CallMapsTo e eside map t calls cargs i c →
      CorrBelow e ebits eside map t tbits inp0 inp1 arrs ufs i →
      (dagSim inp1 tbits t).getD (clV calls c).val dDflt
        = ⟨(dagWidths t).getD (clV calls c).val 0,
            toW _ (ufs (clF calls c).val
              (argVals (dagSim inp1 tbits t) cargs (clS calls c).val (clK calls c).val))⟩)
    (i : Nat) : ∀ (hi : i < e.length), img map i ≠ NONE →
      (extSim inp0 ebits arrs ufs eside e).getD i dDflt
        = (dagSim inp1 tbits t).getD (img map i).val dDflt := by
  induction i using Nat.strong_induction_on with
  | _ i ih =>
  intro hi hm
  have hIH : CorrBelow e ebits eside map t tbits inp0 inp1 arrs ufs i :=
    fun i' hi' hne => ih i' hi' (by omega) hne
  obtain ⟨hlt, hcorr⟩ := hc.corr i hi hm
  have heg : e.getD i dfltExt = e[i] := getD_eq_getElem_of_lt hi dfltExt
  unfold ExtNodeCorr at hcorr
  rw [heg] at hcorr
  have hwfi := hc.ewf i hi
  rw [extSim_node inp0 ebits arrs ufs eside e i hi]
  cases hei : e[i] with
  | Core nd =>
    rw [hei] at hcorr hwfi
    simp only at hcorr
    simp only [ExtNodeWF] at hwfi
    have htg : t.getD (img map i).val dfltNode = t[(img map i).val] := getD_eq_getElem_of_lt hlt dfltNode
    rw [htg] at hcorr
    simp only [extNodeVal]
    rcases node_shape nd with ⟨w, hw⟩ | ⟨s0, w, hw⟩ | hop
    · rw [hw, CoreCorr_var] at hcorr
      rw [hw, dagSim_var inp1 tbits t _ hlt w hcorr]
      simp only [dagNodeVal]
      apply dval_mk_congr
      apply bvOfFn_congr
      intro j hj
      exact hv i hi w (by rw [hei, hw]) hm j hj
    · rw [hw, CoreCorr_const] at hcorr
      obtain ⟨s1, hd, hbits⟩ := hcorr
      rw [hw, dagSim_const inp1 tbits t _ hlt s1 w hd]
      simp only [dagNodeVal]
      apply dval_mk_congr
      apply bvOfFn_congr
      intro j hj
      exact hbits j hj
    · rw [CoreCorr_op _ _ _ _ _ hop] at hcorr
      have hwfd := hc.twf _ hlt
      have hopv : ∀ a ∈ operands nd,
          (extSim inp0 ebits arrs ufs eside (e.take i)).getD a.val dDflt
            = (dagSim inp1 tbits (t.take (img map i).val)).getD (img map a.val).val dDflt := by
        intro a ha
        have halt : a.val < i := operands_lt_of_wf hwfi a ha
        have hmem : img map a.val ∈ operands t[(img map i).val] := by
          rw [← hcorr, operands_pMapNode]
          exact List.mem_map.mpr ⟨a, ha, rfl⟩
        have hmlt : (img map a.val).val < (img map i).val := operands_lt_of_wf hwfd _ hmem
        have hne : img map a.val ≠ NONE := ne_NONE_of_lt hc.tcap (by omega)
        rw [extSim_take_getD inp0 ebits arrs ufs eside e i a.val halt,
          dagSim_take_getD inp1 tbits t (img map i).val _ hmlt]
        exact hIH a.val halt hne
      rw [dagSim_node inp1 tbits t _ hlt, ← hcorr]
      exact pMapNode_val map nd hop inp0 inp1 ebits tbits _ _ (extNin (e.take i))
        (dagNin (t.take (img map i).val)) hopv
  | Select aid j s k =>
    rw [hei] at hcorr hwfi
    simp only at hcorr
    simp only [ExtNodeWF] at hwfi
    obtain ⟨hjl, hjw, hlev⟩ := hwfi
    simp only [extNodeVal]
    rw [extSim_take_getD inp0 ebits arrs ufs eside e i j.val hjl]
    rw [chainRead_congr arrs (extSim inp0 ebits arrs ufs eside (e.take i)) (extSim inp0 ebits arrs ufs eside e)
      eside aid.val _ k.val s.val (fun l hl => by
        obtain ⟨_, hxl, _, hvl, _⟩ := hlev l hl
        exact ⟨extSim_take_getD inp0 ebits arrs ufs eside e i _ hxl,
          extSim_take_getD inp0 ebits arrs ufs eside e i _ hvl⟩)]
    have hlev' : ∀ l < k.val, (eside.getD (s.val + 2 * l) 0#usize).val < i ∧
        (extWidths e).getD (eside.getD (s.val + 2 * l) 0#usize).val 0 = 32 ∧
        (eside.getD (s.val + 2 * l + 1) 0#usize).val < i ∧
        (extWidths e).getD (eside.getD (s.val + 2 * l + 1) 0#usize).val 0 = 8 := by
      intro l hl
      obtain ⟨_, h1, h2, h3, h4⟩ := hlev l hl
      exact ⟨h1, h2, h3, h4⟩
    obtain ⟨cv1, cv2⟩ := chain_val e ebits eside eroots map reads calls cargs t tbits troots hc inp0 inp1
      arrs ufs i hIH aid j hjl hjw k.val s.val (img map i) hlt hlev'
    rcases hcorr with hres | ⟨r, hsm⟩
    · exact (cv1 hres).symm
    · have hsm' := hsm
      obtain ⟨aid', j', s', k', _, hsel, _, hw, hr, haid, hxj⟩ := hsm
      rw [heg, hei] at hsel
      cases hsel
      apply (cv2 (rdV reads r) hw ?_).symm
      rw [hbase i r hsm' hIH, haid, hxj]
      have hne : img map j.val ≠ NONE := by
        rw [← hxj]
        exact ne_NONE_of_lt hc.tcap (hc.rt.idx_lt r hr)
      rw [← hIH j.val hjl hne]
  | Call fid w s k =>
    rw [hei] at hcorr hwfi
    simp only at hcorr
    simp only [ExtNodeWF] at hwfi
    obtain ⟨hw0, hargs⟩ := hwfi
    obtain ⟨c, hcm⟩ := hcorr
    have hval := hcbase i c hcm hIH
    obtain ⟨fid', w', s', k', _, hcall, _, hic, hcv, hvar, hf, hk, hamatch⟩ := hcm
    rw [heg, hei] at hcall
    cases hcall
    simp only [extNodeVal]
    rw [hcv] at hval
    rw [hval]
    have htg : t[(img map i).val] = .Var w := by
      rw [← getD_eq_getElem_of_lt hlt]
      exact hvar
    rw [dagWidths_var t _ hlt w htg, hf, hk]
    apply dval_mk_congr
    congr 1
    congr 1
    unfold argVals
    apply List.map_congr_left
    intro l hl
    have hl' := List.mem_range.mp hl
    obtain ⟨_, hal⟩ := hargs l hl'
    have hmatch := hamatch l hl'
    have hargl : (clArg calls cargs c l).val < t.length := hc.ct.args_lt c hic l (by rw [hk]; exact hl')
    have hne : img map (eside.getD (s.val + l) 0#usize).val ≠ NONE := by
      rw [hmatch]
      exact ne_NONE_of_lt hc.tcap hargl
    rw [extSim_take_getD inp0 ebits arrs ufs eside e i _ hal, hIH _ hal hne, hmatch]
    rfl

/-- The correspondence under `TablesAgree`. -/
theorem sliver_corr_values (e : List ExtNode) (ebits : List Bool)
    (eside eroots map reads calls cargs : List Std.Usize) (t : List blast_kernel.DagNode) (tbits : List Bool)
    (troots : List Std.Usize)
    (hc : SliverCorr e ebits eside eroots map reads calls cargs t tbits troots)
    (inp0 inp1 : List Bool) (arrs : Arrs) (ufs : Ufs)
    (hv : ExtVarsAgree e t map inp0 inp1)
    (ha : TablesAgree t tbits reads calls cargs arrs ufs inp1) :
    ∀ i (hi : i < e.length), img map i ≠ NONE →
      (extSim inp0 ebits arrs ufs eside e).getD i dDflt
        = (dagSim inp1 tbits t).getD (img map i).val dDflt :=
  sliver_corr_values_gen e ebits eside eroots map reads calls cargs t tbits troots hc inp0 inp1 arrs ufs hv
    (fun _ r hsm _ => by
      obtain ⟨_, _, _, _, _, _, _, _, hr, _, _⟩ := hsm
      exact ha.1 r hr)
    (fun _ c hcm _ => by
      obtain ⟨_, _, _, _, _, _, _, hic, _⟩ := hcm
      exact ha.2 c hic)

/-- The extended roots have the values of their images. -/
theorem ext_roots_val (e : List ExtNode) (ebits : List Bool)
    (eside eroots map reads calls cargs : List Std.Usize) (t : List blast_kernel.DagNode) (tbits : List Bool)
    (troots : List Std.Usize)
    (hc : SliverCorr e ebits eside eroots map reads calls cargs t tbits troots)
    (inp0 inp1 : List Bool) (arrs : Arrs) (ufs : Ufs)
    (hcv : ∀ i (hi : i < e.length), img map i ≠ NONE →
      (extSim inp0 ebits arrs ufs eside e).getD i dDflt = (dagSim inp1 tbits t).getD (img map i).val dDflt) :
    ∀ k (hk : k < eroots.length),
      extBool inp0 ebits arrs ufs eside e (eroots[k]).val
        = dagBool inp1 tbits t (troots.getD k 0#usize).val := by
  intro k hk
  obtain ⟨hlt, hne, heq⟩ := hc.roots k hk hk
  unfold extBool dagBool
  rw [hcv _ (by rw [← hc.len]; exact hlt) hne, heq]

/-- A value equals another of the same width that it coerces to. -/
theorem dval_eq_of_toW (v v' : DVal) (hw : v.1 = v'.1) (h : v.2 = toW v.1 v') : v = v' := by
  obtain ⟨a, A⟩ := v
  obtain ⟨b, B⟩ := v'
  simp only at hw h
  subst hw
  simp only [toW, BitVec.setWidth_eq] at h
  rw [h]

/-- `toW` at the value's width. -/
theorem toW_mk (w : Nat) (A : BitVec w) : toW w ⟨w, A⟩ = A := by
  simp [toW]

/-- The nested antecedent is the conjunction of the argument equalities. -/
theorem anteCorr_val (t : List blast_kernel.DagNode) (tbits : List Bool) (nbits : Nat)
    (hwf : DagWF t nbits) (cargs : List Std.Usize) (sp sq : Nat) (inp : List Bool) :
    ∀ (l : Nat) (a : Std.Usize), AnteCorr t cargs sp sq l a →
      (bval ((dagSim inp tbits t).getD a.val dDflt) = true ↔
        ∀ i ≤ l, ((dagSim inp tbits t).getD (cargs.getD (sp + i) 0#usize).val dDflt).2
          = toW _ ((dagSim inp tbits t).getD (cargs.getD (sq + i) 0#usize).val dDflt)) := by
  intro l
  induction l with
  | zero =>
    intro a h
    obtain ⟨hal, heq⟩ := h
    rw [getD_eq_getElem_of_lt hal] at heq
    have hwfa := hwf a.val hal
    rw [heq] at hwfa
    obtain ⟨h1, h2, _, _⟩ := hwfa
    rw [dagSim_eqnode inp tbits t a.val hal _ _ heq h1 h2]
    simp only [bval_bvBool, decide_eq_true_eq]
    constructor
    · intro h i hi
      have : i = 0 := by omega
      subst this
      simpa using h
    · intro h
      simpa using h 0 (le_refl 0)
  | succ l ih =>
    intro a h
    obtain ⟨hal, c, eq, hand, heql, heqn, hrest⟩ := h
    rw [getD_eq_getElem_of_lt hal] at hand
    rw [getD_eq_getElem_of_lt heql] at heqn
    have hwfa := hwf a.val hal
    rw [hand] at hwfa
    obtain ⟨hcl, heqa, _, _⟩ := hwfa
    have hwfe := hwf eq.val heql
    rw [heqn] at hwfe
    obtain ⟨h1, h2, _, _⟩ := hwfe
    rw [dagSim_andnode inp tbits t a.val hal _ _ hand hcl heqa,
      dagSim_eqnode inp tbits t eq.val heql _ _ heqn h1 h2]
    simp only [bval_bvBool, Bool.and_eq_true, decide_eq_true_eq]
    rw [ih c hrest]
    constructor
    · rintro ⟨hc, hlast⟩ i hi
      rcases Nat.lt_or_ge i (l + 1) with hil | hil
      · exact hc i (by omega)
      · have : i = l + 1 := by omega
        subst this
        exact hlast
    · intro h
      exact ⟨fun i hi => h i (by omega), h (l + 1) (le_refl _)⟩

/-- The arguments an antecedent compares have one width. -/
theorem anteCorr_width (t : List blast_kernel.DagNode) (nbits : Nat) (hwf : DagWF t nbits)
    (cargs : List Std.Usize) (sp sq : Nat) :
    ∀ (l : Nat) (a : Std.Usize), AnteCorr t cargs sp sq l a → ∀ i ≤ l,
      (dagWidths t).getD (cargs.getD (sp + i) 0#usize).val 0
        = (dagWidths t).getD (cargs.getD (sq + i) 0#usize).val 0 := by
  intro l
  induction l with
  | zero =>
    intro a h i hi
    have : i = 0 := by omega
    subst this
    obtain ⟨hal, heq⟩ := h
    rw [getD_eq_getElem_of_lt hal] at heq
    have hwfa := hwf a.val hal
    rw [heq] at hwfa
    simpa using hwfa.2.2.2
  | succ l ih =>
    intro a h i hi
    obtain ⟨hal, c, eq, hand, heql, heqn, hrest⟩ := h
    rcases Nat.lt_or_ge i (l + 1) with hil | hil
    · exact ih c hrest i (by omega)
    · have : i = l + 1 := by omega
      subst this
      rw [getD_eq_getElem_of_lt heql] at heqn
      have hwfe := hwf eq.val heql
      rw [heqn] at hwfe
      exact hwfe.2.2.2

/-- **Every congruence root is valid under `TablesAgree`**: two reads of one
    array at equal indices hold one byte, two calls of one function on
    equal arguments hold one result (Ackermann's functional consistency). -/
theorem cong_roots_valid (e : List ExtNode) (ebits : List Bool)
    (eside eroots map reads calls cargs : List Std.Usize) (t : List blast_kernel.DagNode) (tbits : List Bool)
    (troots : List Std.Usize)
    (hc : SliverCorr e ebits eside eroots map reads calls cargs t tbits troots)
    (inp1 : List Bool) (arrs : Arrs) (ufs : Ufs)
    (ha : TablesAgree t tbits reads calls cargs arrs ufs inp1) :
    ∀ k, eroots.length ≤ k → k < troots.length →
      dagBool inp1 tbits t (troots.getD k 0#usize).val = true := by
  intro k hk1 hk2
  obtain ⟨ia, hia1, hia2, harr, huf⟩ := hc.cong
  rcases Nat.lt_or_ge k ia with hlt | hge
  · -- an array congruence root
    obtain ⟨p, q, _, hpair, hroot⟩ := harr.1 k hk1 hlt
    obtain ⟨hpq, hq, haid, _⟩ := hpair
    have hp : IsRead reads p := by unfold IsRead at hq ⊢; omega
    obtain ⟨a, ⟨hrl, nn, c, hor, hcl, hceq, hnl, hnot⟩, hal, haeq⟩ := hroot
    rw [getD_eq_getElem_of_lt hrl] at hor
    rw [getD_eq_getElem_of_lt hcl] at hceq
    rw [getD_eq_getElem_of_lt hnl] at hnot
    rw [getD_eq_getElem_of_lt hal] at haeq
    have hwfr := hc.twf _ hrl
    rw [hor] at hwfr
    obtain ⟨hnnr, hcr, _, _⟩ := hwfr
    have hwfc := hc.twf _ hcl
    rw [hceq] at hwfc
    obtain ⟨hvpc, hvqc, _, _⟩ := hwfc
    have hwfn := hc.twf _ hnl
    rw [hnot] at hwfn
    obtain ⟨han, _⟩ := hwfn
    have hwfa := hc.twf _ hal
    rw [haeq] at hwfa
    obtain ⟨hxpa, hxqa, _, _⟩ := hwfa
    unfold dagBool
    rw [dagSim_ornode inp1 tbits t _ hrl _ _ hor hnnr hcr,
      dagSim_notnode inp1 tbits t _ hnl _ hnot han,
      dagSim_eqnode inp1 tbits t _ hcl _ _ hceq hvpc hvqc,
      dagSim_eqnode inp1 tbits t _ hal _ _ haeq hxpa hxqa]
    simp only [bval_bvBool, Bool.or_eq_true, Bool.not_eq_eq_eq_not, Bool.not_true, decide_eq_true_eq,
      decide_eq_false_iff_not]
    by_cases hx : ((dagSim inp1 tbits t).getD (rdX reads p).val dDflt).2
        = toW _ ((dagSim inp1 tbits t).getD (rdX reads q).val dDflt)
    · right
      have hxw : ((dagSim inp1 tbits t).getD (rdX reads p).val dDflt).1 = 32 := by
        rw [dagSim_getD_fst]; exact hc.rt.idx_w p hp
      have hxw' : ((dagSim inp1 tbits t).getD (rdX reads q).val dDflt).1 = 32 := by
        rw [dagSim_getD_fst]; exact hc.rt.idx_w q hq
      have hxeq := dval_eq_of_toW _ _ (by rw [hxw, hxw']) hx
      rw [ha.1 p hp, ha.1 q hq, haid, hxeq]
      simp [toW]
    · left
      exact hx
  · -- a call congruence root
    obtain ⟨p, q, _, hpair, hroot⟩ := huf.1 k hge hk2
    obtain ⟨hpq, hq, hfid, hk⟩ := hpair
    have hp : IsCall calls p := by unfold IsCall at hq ⊢; omega
    -- the two results agree once the arguments do
    have hres : argVals (dagSim inp1 tbits t) cargs (clS calls p).val (clK calls p).val
        = argVals (dagSim inp1 tbits t) cargs (clS calls q).val (clK calls q).val →
        ∀ wv : Nat, (dagWidths t).getD (clV calls p).val 0 = wv → (dagWidths t).getD (clV calls q).val 0 = wv →
        ((dagSim inp1 tbits t).getD (clV calls p).val dDflt).2
          = toW _ ((dagSim inp1 tbits t).getD (clV calls q).val dDflt) := by
      intro hargs wv hwp hwq
      rw [ha.2 p hp, ha.2 q hq, hargs, hfid, hwp, hwq]
      simp [toW]
    unfold UfRootAt UfRoot at hroot
    rcases hroot with ⟨hk0, hrl, heq⟩ | ⟨hk1, a, ⟨hrl, nn, c, hor, hcl, hceq, hnl, hnot⟩, hante⟩
    · -- arity 0
      rw [getD_eq_getElem_of_lt hrl] at heq
      have hwfr := hc.twf _ hrl
      rw [heq] at hwfr
      obtain ⟨hvp, hvq, _, hww⟩ := hwfr
      unfold dagBool
      rw [dagSim_eqnode inp1 tbits t _ hrl _ _ heq hvp hvq]
      simp only [bval_bvBool, decide_eq_true_eq]
      apply hres
      · unfold argVals
        rw [← hk, hk0]
        simp
      · rfl
      · exact hww.symm
    · rw [getD_eq_getElem_of_lt hrl] at hor
      rw [getD_eq_getElem_of_lt hcl] at hceq
      rw [getD_eq_getElem_of_lt hnl] at hnot
      have hwfr := hc.twf _ hrl
      rw [hor] at hwfr
      obtain ⟨hnnr, hcr, _, _⟩ := hwfr
      have hwfc := hc.twf _ hcl
      rw [hceq] at hwfc
      obtain ⟨hvpc, hvqc, _, hww⟩ := hwfc
      have hwfn := hc.twf _ hnl
      rw [hnot] at hwfn
      obtain ⟨han, _⟩ := hwfn
      unfold dagBool
      rw [dagSim_ornode inp1 tbits t _ hrl _ _ hor hnnr hcr,
        dagSim_notnode inp1 tbits t _ hnl _ hnot han,
        dagSim_eqnode inp1 tbits t _ hcl _ _ hceq hvpc hvqc]
      simp only [bval_bvBool, Bool.or_eq_true, Bool.not_eq_eq_eq_not, Bool.not_true, decide_eq_true_eq]
      by_cases hA : bval ((dagSim inp1 tbits t).getD a.val dDflt) = true
      · right
        have hall := (anteCorr_val t tbits tbits.length hc.twf cargs (clS calls p).val (clS calls q).val inp1
          _ a hante).mp hA
        apply hres _ _ rfl hww.symm
        unfold argVals
        rw [← hk]
        apply List.map_congr_left
        intro l hl
        have hl' := List.mem_range.mp hl
        have hi := hall l (by omega)
        -- the widths of the two arguments agree (the `Eq` node is well-formed)
        apply dval_eq_of_toW _ _ ?_ hi
        rw [dagSim_getD_fst, dagSim_getD_fst]
        exact anteCorr_width t tbits.length hc.twf cargs (clS calls p).val (clS calls q).val _ a hante l
          (by omega)
      · left
        simpa using hA


/- ══════════════════ LAYOUT OF THE EXTENDED INPUTS ══════════════════ -/

/-- The width an extended node contributes to the input count. -/
def extVarWidth : ExtNode → Nat
  | .Core nd => varWidth nd
  | _ => 0

theorem extNodeNin_eq (nin : Nat) (nd : ExtNode) : extNodeNin nin nd = nin + extVarWidth nd := by
  cases nd with
  | Core nd => simp [extNodeNin, extVarWidth, dagNodeNin_eq]
  | Select _ _ _ _ => simp [extNodeNin, extVarWidth]
  | Call _ _ _ _ => simp [extNodeNin, extVarWidth]

theorem extNin_take_succ (e : List ExtNode) (k : Nat) (hk : k < e.length) :
    extNin (e.take (k + 1)) = extNin (e.take k) + extVarWidth e[k] := by
  have htake : e.take (k + 1) = e.take k ++ [e[k]] := by
    rw [List.take_add_one, List.getElem?_eq_getElem hk]
    simp
  rw [htake, extNin_snoc, extNodeNin_eq]

theorem foldl_extNodeNin_ge (m : List ExtNode) (nin : Nat) : nin ≤ m.foldl extNodeNin nin := by
  induction m generalizing nin with
  | nil => simp
  | cons nd m ih =>
    simp only [List.foldl_cons]
    exact le_trans (by rw [extNodeNin_eq]; omega) (ih _)

theorem extNin_take_mono (e : List ExtNode) (i n : Nat) (h : i ≤ n) :
    extNin (e.take i) ≤ extNin (e.take n) := by
  have hsplit := List.take_append_drop i (e.take n)
  rw [List.take_take, Nat.min_eq_left h] at hsplit
  rw [← hsplit]
  unfold extNin
  rw [List.foldl_append]
  exact foldl_extNodeNin_ge _ _

theorem layoutAuxE_length (e : List ExtNode) (blk : Nat → List Bool)
    (hlen : ∀ k (hk : k < e.length), (blk k).length = extVarWidth e[k]) (n : Nat)
    (hn : n ≤ e.length) : (layoutAux blk n).length = extNin (e.take n) := by
  induction n with
  | zero => simp [layoutAux, extNin]
  | succ n ih =>
    simp only [layoutAux, List.length_append]
    rw [ih (by omega), hlen n (by omega), extNin_take_succ e n (by omega)]

theorem layoutAuxE_getD (e : List ExtNode) (blk : Nat → List Bool)
    (hlen : ∀ k (hk : k < e.length), (blk k).length = extVarWidth e[k]) (n : Nat)
    (hn : n ≤ e.length) (i : Nat) (hi : i < n) (j : Nat) (hj : j < extVarWidth e[i]) :
    (layoutAux blk n).getD (extNin (e.take i) + j) false = (blk i).getD j false := by
  induction n with
  | zero => omega
  | succ n ih =>
    simp only [layoutAux]
    rcases Nat.lt_or_ge i n with h | h
    · have hl : extNin (e.take i) + j < (layoutAux blk n).length := by
        rw [layoutAuxE_length e blk hlen n (by omega)]
        have hmono := extNin_take_mono e (i + 1) n (by omega)
        rw [extNin_take_succ e i (by omega)] at hmono
        omega
      rw [List.getD_eq_getElem?_getD, List.getElem?_append_left hl, ← List.getD_eq_getElem?_getD]
      exact ih (by omega) h hj
    · have hin : i = n := by omega
      subst hin
      have hl : (layoutAux blk i).length = extNin (e.take i) :=
        layoutAuxE_length e blk hlen i (by omega)
      rw [List.getD_eq_getElem?_getD, List.getElem?_append_right (by omega), hl,
        Nat.add_sub_cancel_left, ← List.getD_eq_getElem?_getD]

/-- `bvOfFn` of a bitvector's own bits. -/
theorem bvOfFn_getLsbD (w : Nat) (A : BitVec w) : bvOfFn (fun b => A.getLsbD b) w = A := by
  apply BitVec.eq_of_getLsbD_eq
  intro j hj
  rw [getLsbD_bvOfFn]
  simp [hj]

/- ══════════════════ THE PUSHFORWARD (UNSAT DIRECTION) ══════════════════ -/

open Classical in
/-- The block of core variable `m` from an extended model: the bits of
    the extended variable mapped to it; for a read variable, the array's
    byte at the index of the FIRST select that reaches its entry (an
    extended-side value: no recursion through the core assignment); for a
    call variable, the function's result on the first call's arguments. -/
noncomputable def pushBlockS (e : List ExtNode) (ebits : List Bool)
    (eside map reads calls cargs : List Std.Usize) (t : List blast_kernel.DagNode)
    (inp0 : List Bool) (arrs : Arrs) (ufs : Ufs) (m : Nat) : List Bool :=
  match t.getD m dfltNode with
  | .Var w =>
    if h : ∃ u, ExtVarImg e map u m then
      block w.val (fun b => inp0.getD (extNin (e.take (Nat.find h)) + b) false)
    else if hr : ∃ r, IsRead reads r ∧ (rdV reads r).val = m then
      if hs : ∃ i, SelMapsTo e ebits eside map t reads i (Nat.find hr) then
        match e.getD (Nat.find hs) dfltExt with
        | .Select aid j _ _ =>
          block w.val (fun b =>
            (arrs aid.val (toW 32 ((extSim inp0 ebits arrs ufs eside e).getD j.val dDflt))).getLsbD b)
        | _ => List.replicate w.val false
      else List.replicate w.val false
    else if hc : ∃ c, IsCall calls c ∧ (clV calls c).val = m then
      if hi : ∃ i, CallMapsTo e eside map t calls cargs i (Nat.find hc) then
        match e.getD (Nat.find hi) dfltExt with
        | .Call fid _ s k =>
          block w.val (fun b =>
            (toW w.val (ufs fid.val (argVals (extSim inp0 ebits arrs ufs eside e) eside s.val k.val))).getLsbD b)
        | _ => List.replicate w.val false
      else List.replicate w.val false
    else List.replicate w.val false
  | _ => []

/-- The core's input assignment laid out from an extended model. -/
noncomputable def pushforwardS (e : List ExtNode) (ebits : List Bool)
    (eside map reads calls cargs : List Std.Usize) (t : List blast_kernel.DagNode)
    (inp0 : List Bool) (arrs : Arrs) (ufs : Ufs) : List Bool :=
  layoutAux (pushBlockS e ebits eside map reads calls cargs t inp0 arrs ufs) t.length

theorem pushBlockS_length (e : List ExtNode) (ebits : List Bool)
    (eside map reads calls cargs : List Std.Usize) (t : List blast_kernel.DagNode)
    (inp0 : List Bool) (arrs : Arrs) (ufs : Ufs) (k : Nat) (hk : k < t.length) :
    (pushBlockS e ebits eside map reads calls cargs t inp0 arrs ufs k).length = varWidth t[k] := by
  unfold pushBlockS
  rw [getD_eq_getElem_of_lt hk dfltNode]
  generalize t[k] = nd
  cases nd <;> try (simp only [varWidth]; rfl)
  simp only [varWidth]
  split
  · simp
  · split
    · split
      · split <;> simp
      · simp
    · split
      · split
        · split <;> simp
        · simp
      · simp

/-- The value of core variable `m` under the pushforward is its block. -/
theorem pushforwardS_var (e : List ExtNode) (ebits : List Bool)
    (eside map reads calls cargs : List Std.Usize) (t : List blast_kernel.DagNode) (tbits : List Bool)
    (inp0 : List Bool) (arrs : Arrs) (ufs : Ufs) (m : Nat) (hm : m < t.length) (w : Std.Usize)
    (hv : t[m] = .Var w) :
    (dagSim (pushforwardS e ebits eside map reads calls cargs t inp0 arrs ufs) tbits t).getD m dDflt
      = ⟨w.val, bvOfFn (fun b =>
          (pushBlockS e ebits eside map reads calls cargs t inp0 arrs ufs m).getD b false) w.val⟩ := by
  rw [dagSim_var _ tbits t m hm w hv]
  apply dval_mk_congr
  apply bvOfFn_congr
  intro b hb
  unfold pushforwardS
  have hjw : b < varWidth t[m] := by rw [hv]; simpa [varWidth] using hb
  exact layoutAux_getD t _ (pushBlockS_length e ebits eside map reads calls cargs t inp0 arrs ufs)
    t.length le_rfl m hm b hjw

open Classical in
theorem extVarsAgree_pushforward (e : List ExtNode) (ebits : List Bool)
    (eside eroots map reads calls cargs : List Std.Usize) (t : List blast_kernel.DagNode) (tbits : List Bool)
    (troots : List Std.Usize)
    (hc : SliverCorr e ebits eside eroots map reads calls cargs t tbits troots)
    (inp0 : List Bool) (arrs : Arrs) (ufs : Ufs) :
    ExtVarsAgree e t map inp0 (pushforwardS e ebits eside map reads calls cargs t inp0 arrs ufs) := by
  intro u hu w hw hne j hj
  obtain ⟨hlt, hcorr⟩ := hc.corr u hu hne
  unfold ExtNodeCorr at hcorr
  rw [getD_eq_getElem_of_lt hu dfltExt, hw] at hcorr
  simp only [CoreCorr_var] at hcorr
  have htv : t[(img map u).val] = .Var w := by
    rw [← getD_eq_getElem_of_lt hlt dfltNode]
    exact hcorr
  unfold pushforwardS
  have hjw : j < varWidth t[(img map u).val] := by rw [htv]; simpa [varWidth] using hj
  rw [layoutAux_getD t _ (pushBlockS_length e ebits eside map reads calls cargs t inp0 arrs ufs)
    t.length le_rfl _ hlt j hjw]
  unfold pushBlockS
  rw [getD_eq_getElem_of_lt hlt dfltNode, htv]
  simp only
  have hex : ∃ u', ExtVarImg e map u' (img map u).val :=
    ⟨u, hu, ⟨w, by rw [getD_eq_getElem_of_lt hu dfltExt, hw]⟩, hne, rfl⟩
  rw [dif_pos hex]
  have hspec := Nat.find_spec hex
  have hfind : Nat.find hex = u := hc.inj _ _ _ hspec.1 hu hspec ⟨hu, ⟨w, by rw [getD_eq_getElem_of_lt hu dfltExt, hw]⟩, hne, rfl⟩
  rw [hfind]
  exact (block_getD w.val (fun b => inp0.getD (extNin (e.take u) + b) false) j hj).symm

open Classical in
/-- A read variable's block is the array's byte at the first reaching
    select's index. -/
theorem pushBlockS_read (e : List ExtNode) (ebits : List Bool)
    (eside eroots map reads calls cargs : List Std.Usize) (t : List blast_kernel.DagNode) (tbits : List Bool)
    (troots : List Std.Usize)
    (hc : SliverCorr e ebits eside eroots map reads calls cargs t tbits troots)
    (inp0 : List Bool) (arrs : Arrs) (ufs : Ufs) (r : Nat) (hr : IsRead reads r) :
    ∃ i, SelMapsTo e ebits eside map t reads i r ∧ (∀ i', SelMapsTo e ebits eside map t reads i' r → i ≤ i') ∧
      ∃ aid j s k, e.getD i dfltExt = .Select aid j s k ∧
        pushBlockS e ebits eside map reads calls cargs t inp0 arrs ufs (rdV reads r).val
          = block 8 (fun b => (arrs aid.val (toW 32 ((extSim inp0 ebits arrs ufs eside e).getD j.val dDflt))).getLsbD b) := by
  have hm := hc.rt.var_lt r hr
  have hvn := hc.rt.var_node r hr
  have hnoE : ¬ ∃ u, ExtVarImg e map u (rdV reads r).val := by
    rintro ⟨u, hu, ⟨w, hw⟩, hne, hum⟩
    exact (hc.var_class u hu w hw hne).1 r hr hum.symm
  have hex : ∃ r', IsRead reads r' ∧ (rdV reads r').val = (rdV reads r).val := ⟨r, hr, rfl⟩
  have hfr : Nat.find hex = r := by
    have hspec := Nat.find_spec hex
    exact hc.rt.var_inj _ _ hspec.1 hr (UScalar.eq_of_val_eq hspec.2)
  have hlive : ∃ i, SelMapsTo e ebits eside map t reads i r := hc.reads_live r hr
  have hspec := Nat.find_spec hlive
  have hspec' := hspec
  obtain ⟨aid, j, s, k, _, hsel, _⟩ := hspec'
  refine ⟨Nat.find hlive, hspec, fun i' hi' => Nat.find_min' hlive hi', aid, j, s, k, hsel, ?_⟩
  unfold pushBlockS
  rw [hvn]
  simp only
  rw [dif_neg hnoE, dif_pos hex, hfr, dif_pos hlive, hsel]
  simp

open Classical in
/-- A call variable's block is the function's result on the first
    reaching call's arguments. -/
theorem pushBlockS_call (e : List ExtNode) (ebits : List Bool)
    (eside eroots map reads calls cargs : List Std.Usize) (t : List blast_kernel.DagNode) (tbits : List Bool)
    (troots : List Std.Usize)
    (hc : SliverCorr e ebits eside eroots map reads calls cargs t tbits troots)
    (inp0 : List Bool) (arrs : Arrs) (ufs : Ufs) (c : Nat) (hc' : IsCall calls c) :
    ∃ i, CallMapsTo e eside map t calls cargs i c ∧ (∀ i', CallMapsTo e eside map t calls cargs i' c → i ≤ i') ∧
      ∃ fid w s k, e.getD i dfltExt = .Call fid w s k ∧ t.getD (clV calls c).val dfltNode = .Var w ∧
        pushBlockS e ebits eside map reads calls cargs t inp0 arrs ufs (clV calls c).val
          = block w.val (fun b =>
              (toW w.val (ufs fid.val (argVals (extSim inp0 ebits arrs ufs eside e) eside s.val k.val))).getLsbD b) := by
  have hm := hc.ct.var_lt c hc'
  obtain ⟨w0, hvn⟩ := hc.ct.var_node c hc'
  have hnoE : ¬ ∃ u, ExtVarImg e map u (clV calls c).val := by
    rintro ⟨u, hu, ⟨w, hw⟩, hne, hum⟩
    exact (hc.var_class u hu w hw hne).2 c hc' hum.symm
  have hnoR : ¬ ∃ r, IsRead reads r ∧ (rdV reads r).val = (clV calls c).val := by
    rintro ⟨r, hr, heq⟩
    exact hc.rc_disjoint r c hr hc' (UScalar.eq_of_val_eq heq)
  have hex : ∃ c', IsCall calls c' ∧ (clV calls c').val = (clV calls c).val := ⟨c, hc', rfl⟩
  have hfc : Nat.find hex = c := by
    have hspec := Nat.find_spec hex
    exact hc.ct.var_inj _ _ hspec.1 hc' (UScalar.eq_of_val_eq hspec.2)
  have hlive : ∃ i, CallMapsTo e eside map t calls cargs i c := hc.calls_live c hc'
  have hspec := Nat.find_spec hlive
  have hspec' := hspec
  obtain ⟨fid, w, s, k, _, hcall, _, _, hcv, hvar, _⟩ := hspec'
  rw [← hcv] at hvar
  refine ⟨Nat.find hlive, hspec, fun i' hi' => Nat.find_min' hlive hi', fid, w, s, k, hcall, hvar, ?_⟩
  unfold pushBlockS
  rw [hvar]
  simp only
  rw [dif_neg hnoE, dif_neg hnoR, dif_pos hex, hfc, dif_pos hlive, hcall]

/-- The base-read fact of the pushforward: a reached read variable holds
    the array's byte at the index of its (first) select, which the
    correspondence below the select equates with the entry's index value. -/
theorem pushforward_hbase (e : List ExtNode) (ebits : List Bool)
    (eside eroots map reads calls cargs : List Std.Usize) (t : List blast_kernel.DagNode) (tbits : List Bool)
    (troots : List Std.Usize)
    (hc : SliverCorr e ebits eside eroots map reads calls cargs t tbits troots)
    (inp0 : List Bool) (arrs : Arrs) (ufs : Ufs) :
    ∀ i r, SelMapsTo e ebits eside map t reads i r →
      CorrBelow e ebits eside map t tbits inp0 (pushforwardS e ebits eside map reads calls cargs t inp0 arrs ufs)
        arrs ufs i →
      (dagSim (pushforwardS e ebits eside map reads calls cargs t inp0 arrs ufs) tbits t).getD (rdV reads r).val dDflt
        = ⟨8, arrs (rdA reads r).val (toW 32 ((dagSim (pushforwardS e ebits eside map reads calls cargs t inp0 arrs ufs)
            tbits t).getD (rdX reads r).val dDflt))⟩ := by
  intro i r hsm hIH
  have hr : IsRead reads r := by
    obtain ⟨_, _, _, _, _, _, _, _, hr, _, _⟩ := hsm
    exact hr
  obtain ⟨i0, hsm0, hmin, aid, j, s, k, hsel, hblk⟩ :=
    pushBlockS_read e ebits eside eroots map reads calls cargs t tbits troots hc inp0 arrs ufs r hr
  have hi0 := hmin i hsm
  obtain ⟨aid', j', s', k', hi0l, hsel', _, _, _, haid, hxj⟩ := hsm0
  rw [hsel] at hsel'
  cases hsel'
  have hm := hc.rt.var_lt r hr
  have hvn : t[(rdV reads r).val] = .Var 8#usize := by
    rw [← getD_eq_getElem_of_lt hm dfltNode]
    exact hc.rt.var_node r hr
  rw [pushforwardS_var e ebits eside map reads calls cargs t tbits inp0 arrs ufs _ hm _ hvn, hblk]
  -- the select's index precedes the select, which precedes `i`
  have hwf := hc.ewf i0 hi0l
  rw [← getD_eq_getElem_of_lt hi0l dfltExt, hsel] at hwf
  obtain ⟨hjl, _, _⟩ := hwf
  have hjne : img map j.val ≠ NONE := by
    rw [← hxj]
    exact ne_NONE_of_lt hc.tcap (hc.rt.idx_lt r hr)
  have hjv := hIH j.val (by omega) hjne
  rw [hxj, ← hjv, haid]
  symm
  apply dval_ext
  · simp
  · intro b hb
    have hb' : b < 8 := by simpa using hb
    rw [block_getD _ _ b hb']

theorem pushforward_hcbase (e : List ExtNode) (ebits : List Bool)
    (eside eroots map reads calls cargs : List Std.Usize) (t : List blast_kernel.DagNode) (tbits : List Bool)
    (troots : List Std.Usize)
    (hc : SliverCorr e ebits eside eroots map reads calls cargs t tbits troots)
    (inp0 : List Bool) (arrs : Arrs) (ufs : Ufs) :
    ∀ i c, CallMapsTo e eside map t calls cargs i c →
      CorrBelow e ebits eside map t tbits inp0 (pushforwardS e ebits eside map reads calls cargs t inp0 arrs ufs)
        arrs ufs i →
      (dagSim (pushforwardS e ebits eside map reads calls cargs t inp0 arrs ufs) tbits t).getD (clV calls c).val dDflt
        = ⟨(dagWidths t).getD (clV calls c).val 0,
            toW _ (ufs (clF calls c).val
              (argVals (dagSim (pushforwardS e ebits eside map reads calls cargs t inp0 arrs ufs) tbits t) cargs
                (clS calls c).val (clK calls c).val))⟩ := by
  intro i c hcm hIH
  have hic : IsCall calls c := by
    obtain ⟨_, _, _, _, _, _, _, hic, _⟩ := hcm
    exact hic
  obtain ⟨i0, hcm0, hmin, fid, w, s, k, hcall, hvar, hblk⟩ :=
    pushBlockS_call e ebits eside eroots map reads calls cargs t tbits troots hc inp0 arrs ufs c hic
  have hi0 : i0 ≤ i := hmin i hcm
  obtain ⟨fid', w', s', k', hi0l, hcall', _, _, hcv, _, hf, hk, hargs⟩ := hcm0
  rw [hcall] at hcall'
  cases hcall'
  have hm := hc.ct.var_lt c hic
  have hvn : t[(clV calls c).val] = .Var w := by
    rw [← getD_eq_getElem_of_lt hm dfltNode]
    exact hvar
  rw [pushforwardS_var e ebits eside map reads calls cargs t tbits inp0 arrs ufs _ hm _ hvn, hblk,
    dagWidths_var t _ hm w hvn, hf, hk]
  apply dval_mk_congr
  rw [bvOfFn_congr _ _ w.val (fun b hb => block_getD w.val _ b hb), bvOfFn_getLsbD]
  congr 2
  -- the arguments of the first call are the entry's arguments
  have hwf := hc.ewf i0 hi0l
  rw [← getD_eq_getElem_of_lt hi0l dfltExt, hcall] at hwf
  obtain ⟨_, hargwf⟩ := hwf
  unfold argVals
  apply List.map_congr_left
  intro l hl
  have hl' := List.mem_range.mp hl
  have halt := (hargwf l hl').2
  have hmatch := hargs l hl'
  have hargl : (clArg calls cargs c l).val < t.length := hc.ct.args_lt c hic l (by rw [hk]; exact hl')
  have hne : img map (eside.getD (s.val + l) 0#usize).val ≠ NONE := by
    rw [hmatch]; exact ne_NONE_of_lt hc.tcap hargl
  rw [hIH _ (by omega) hne, hmatch]
  rfl

/-- **UNSAT direction**: an extended model pushes forward to a core model
    — the extended roots' images by the correspondence, every congruence
    root by functional consistency. -/
theorem pushforward_sat (e : List ExtNode) (ebits : List Bool)
    (eside eroots map reads calls cargs : List Std.Usize) (t : List blast_kernel.DagNode) (tbits : List Bool)
    (troots : List Std.Usize)
    (hc : SliverCorr e ebits eside eroots map reads calls cargs t tbits troots)
    (inp0 : List Bool) (arrs : Arrs) (ufs : Ufs) (hs : ExtSat inp0 ebits arrs ufs eside e eroots) :
    ∀ k (hk : k < troots.length),
      dagBool (pushforwardS e ebits eside map reads calls cargs t inp0 arrs ufs) tbits t (troots[k]).val = true := by
  have hv := extVarsAgree_pushforward e ebits eside eroots map reads calls cargs t tbits troots hc inp0 arrs ufs
  have hcv := sliver_corr_values_gen e ebits eside eroots map reads calls cargs t tbits troots hc inp0
    (pushforwardS e ebits eside map reads calls cargs t inp0 arrs ufs) arrs ufs hv
    (pushforward_hbase e ebits eside eroots map reads calls cargs t tbits troots hc inp0 arrs ufs)
    (pushforward_hcbase e ebits eside eroots map reads calls cargs t tbits troots hc inp0 arrs ufs)
  have hcb : ∀ i, CorrBelow e ebits eside map t tbits inp0
      (pushforwardS e ebits eside map reads calls cargs t inp0 arrs ufs) arrs ufs i := by
    intro i i' _ hne
    rcases Nat.lt_or_ge i' e.length with h | h
    · exact hcv i' h hne
    · exfalso
      apply hne
      rw [img_ge]
      rw [hc.len]
      exact h
  have hta : TablesAgree t tbits reads calls cargs arrs ufs
      (pushforwardS e ebits eside map reads calls cargs t inp0 arrs ufs) := by
    constructor
    · intro r hr
      obtain ⟨i, hsm⟩ := hc.reads_live r hr
      exact pushforward_hbase e ebits eside eroots map reads calls cargs t tbits troots hc inp0 arrs ufs i r hsm
        (hcb i)
    · intro c hcc
      obtain ⟨i, hcm⟩ := hc.calls_live c hcc
      exact pushforward_hcbase e ebits eside eroots map reads calls cargs t tbits troots hc inp0 arrs ufs i c
        hcm (hcb i)
  intro k hk
  rw [← getD_eq_getElem_of_lt hk 0#usize]
  rcases Nat.lt_or_ge k eroots.length with hlt | hge
  · rw [← ext_roots_val e ebits eside eroots map reads calls cargs t tbits troots hc inp0 _ arrs ufs hcv k hlt]
    exact hs k hlt
  · exact cong_roots_valid e ebits eside eroots map reads calls cargs t tbits troots hc _ arrs ufs hta k hge hk

/- ══════════════════ THE PULLBACK (SAT DIRECTION) ══════════════════ -/

/-- The block of extended node `u`, read back from the core inputs through
    the map: its image's bits for a mapped variable, zeros for an unmapped
    one, nothing for a non-variable. -/
def pullBlockE (t : List blast_kernel.DagNode) (map : List Std.Usize) (inp1 : List Bool) (u : Nat) :
    ExtNode → List Bool
  | .Core (.Var w) =>
    if img map u ≠ NONE then
      block w.val (fun j => inp1.getD (dagNin (t.take (img map u).val) + j) false)
    else List.replicate w.val false
  | _ => []

/-- The extended query's input assignment read back from a core assignment. -/
def pullbackE (e : List ExtNode) (t : List blast_kernel.DagNode) (map : List Std.Usize)
    (inp1 : List Bool) : List Bool :=
  layoutAux (fun u => pullBlockE t map inp1 u (e.getD u dfltExt)) e.length

theorem pullBlockE_length (e : List ExtNode) (t : List blast_kernel.DagNode) (map : List Std.Usize)
    (inp1 : List Bool) (k : Nat) (hk : k < e.length) :
    (pullBlockE t map inp1 k (e.getD k dfltExt)).length = extVarWidth e[k] := by
  rw [getD_eq_getElem_of_lt hk dfltExt]
  generalize e[k] = nd
  cases nd with
  | Core nd =>
    cases nd <;> simp [pullBlockE, extVarWidth, varWidth]
    split <;> simp
  | Select _ _ _ _ => rfl
  | Call _ _ _ _ => rfl

theorem extVarsAgree_pullback (e : List ExtNode) (t : List blast_kernel.DagNode) (map : List Std.Usize)
    (inp1 : List Bool) : ExtVarsAgree e t map (pullbackE e t map inp1) inp1 := by
  intro i hi w hw hm j hj
  unfold pullbackE
  have hjw : j < extVarWidth e[i] := by
    rw [hw]
    simpa [extVarWidth, varWidth] using hj
  rw [layoutAuxE_getD e _ (pullBlockE_length e t map inp1) e.length le_rfl i hi j hjw]
  rw [getD_eq_getElem_of_lt hi dfltExt, hw]
  simp only [pullBlockE, hm, ne_eq, not_false_eq_true, ↓reduceIte]
  exact block_getD _ _ j hj

open Classical in
/-- The array interpretation read off a core model: at `(aid, v)`, the
    byte of the first read entry of `aid` whose index evaluates to `v`
    (zero when none does). -/
noncomputable def pullbackArrs (t : List blast_kernel.DagNode) (tbits : List Bool) (reads : List Std.Usize)
    (inp1 : List Bool) : Arrs :=
  fun aid v =>
    if h : ∃ r, IsRead reads r ∧ (rdA reads r).val = aid ∧
        toW 32 ((dagSim inp1 tbits t).getD (rdX reads r).val dDflt) = v
    then toW 8 ((dagSim inp1 tbits t).getD (rdV reads (Nat.find h)).val dDflt)
    else 0#8

open Classical in
/-- The UF interpretation read off a core model: at `(fid, args)`, the
    result variable of the first call entry of `fid` whose arguments
    evaluate to `args`. -/
noncomputable def pullbackUfs (t : List blast_kernel.DagNode) (tbits : List Bool) (calls cargs : List Std.Usize)
    (inp1 : List Bool) : Ufs :=
  fun fid args =>
    if h : ∃ c, IsCall calls c ∧ (clF calls c).val = fid ∧
        argVals (dagSim inp1 tbits t) cargs (clS calls c).val (clK calls c).val = args
    then (dagSim inp1 tbits t).getD (clV calls (Nat.find h)).val dDflt
    else dDflt

theorem argVals_length (V : List DVal) (side : List Std.Usize) (s n : Nat) :
    (argVals V side s n).length = n := by
  simp [argVals]

theorem argVals_getD (V : List DVal) (side : List Std.Usize) (s n i : Nat) (hi : i < n) :
    (argVals V side s n).getD i dDflt = V.getD (side.getD (s + i) 0#usize).val dDflt := by
  unfold argVals
  rw [List.getD_eq_getElem?_getD, List.getElem?_map, List.getElem?_range hi]
  rfl

/-- Two read variables of one array at equal index values hold one byte
    (the congruence root for the pair, which the check demanded). -/
theorem reads_consistent (e : List ExtNode) (ebits : List Bool)
    (eside eroots map reads calls cargs : List Std.Usize) (t : List blast_kernel.DagNode) (tbits : List Bool)
    (troots : List Std.Usize)
    (hc : SliverCorr e ebits eside eroots map reads calls cargs t tbits troots)
    (inp1 : List Bool) (hall : ∀ k (hk : k < troots.length), dagBool inp1 tbits t (troots[k]).val = true)
    (r0 r : Nat) (hlt : r0 < r) (hr : IsRead reads r) (haid : rdA reads r0 = rdA reads r)
    (hx : toW 32 ((dagSim inp1 tbits t).getD (rdX reads r0).val dDflt)
      = toW 32 ((dagSim inp1 tbits t).getD (rdX reads r).val dDflt)) :
    (dagSim inp1 tbits t).getD (rdV reads r0).val dDflt = (dagSim inp1 tbits t).getD (rdV reads r).val dDflt := by
  have hr0 : IsRead reads r0 := by unfold IsRead at hr ⊢; omega
  have hxw0 : ((dagSim inp1 tbits t).getD (rdX reads r0).val dDflt).1 = 32 := by
    rw [dagSim_getD_fst]; exact hc.rt.idx_w r0 hr0
  have hxw : ((dagSim inp1 tbits t).getD (rdX reads r).val dDflt).1 = 32 := by
    rw [dagSim_getD_fst]; exact hc.rt.idx_w r hr
  have hxeq := toW_inj_of_width _ _ 32 hxw0 hxw hx
  -- the pair is not skipped: two unequal constants have unequal values
  have hpair : ReadPair reads t tbits r0 r := by
    refine ⟨hlt, hr, haid, ?_⟩
    rintro ⟨hl0, hl, sa, wa, sb, wb, hta, htb, hne⟩
    rw [getD_eq_getElem_of_lt hl0] at hta
    rw [getD_eq_getElem_of_lt hl] at htb
    have hwa : wa.val = 32 := by rw [← dagWidths_const t _ hl0 sa wa hta]; exact hc.rt.idx_w r0 hr0
    have hwb : wb.val = 32 := by rw [← dagWidths_const t _ hl sb wb htb]; exact hc.rt.idx_w r hr
    have hwab : wa = wb := UScalar.eq_of_val_eq (by rw [hwa, hwb])
    subst hwab
    apply hne
    refine ⟨rfl, ?_⟩
    have hwf0 := hc.twf _ hl0
    rw [hta] at hwf0
    have hwf := hc.twf _ hl
    rw [htb] at hwf
    by_contra hbe
    have := not_bitsEq_bvOfFn tbits sa.val tbits sb.val wa.val hwf0.2 hwf.2 hbe
    apply this
    rw [dagSim_const inp1 tbits t _ hl0 sa wa hta, dagSim_const inp1 tbits t _ hl sb wa htb] at hxeq
    simpa using hxeq
  obtain ⟨ia, hia1, hia2, harr, _⟩ := hc.cong
  obtain ⟨k, hk1, hk2, hroot⟩ := harr.2 r0 r trivial hpair
  have hk : k < troots.length := by omega
  have hval := hall k hk
  rw [← getD_eq_getElem_of_lt hk 0#usize] at hval
  obtain ⟨a, ⟨hrl, nn, c, hor, hcl, hceq, hnl, hnot⟩, hal, haeq⟩ := hroot
  rw [getD_eq_getElem_of_lt hrl] at hor
  rw [getD_eq_getElem_of_lt hcl] at hceq
  rw [getD_eq_getElem_of_lt hnl] at hnot
  rw [getD_eq_getElem_of_lt hal] at haeq
  have hwfr := hc.twf _ hrl
  rw [hor] at hwfr
  obtain ⟨hnnr, hcr, _, _⟩ := hwfr
  have hwfc := hc.twf _ hcl
  rw [hceq] at hwfc
  obtain ⟨hvpc, hvqc, _, _⟩ := hwfc
  have hwfn := hc.twf _ hnl
  rw [hnot] at hwfn
  obtain ⟨han, _⟩ := hwfn
  have hwfa := hc.twf _ hal
  rw [haeq] at hwfa
  obtain ⟨hxpa, hxqa, _, _⟩ := hwfa
  unfold dagBool at hval
  rw [dagSim_ornode inp1 tbits t _ hrl _ _ hor hnnr hcr,
    dagSim_notnode inp1 tbits t _ hnl _ hnot han,
    dagSim_eqnode inp1 tbits t _ hcl _ _ hceq hvpc hvqc,
    dagSim_eqnode inp1 tbits t _ hal _ _ haeq hxpa hxqa] at hval
  simp only [bval_bvBool, Bool.or_eq_true, Bool.not_eq_eq_eq_not, Bool.not_true, decide_eq_true_eq,
    decide_eq_false_iff_not] at hval
  rcases hval with hne | heq
  · exfalso
    apply hne
    rw [hxeq]
    exact (toW_self _).symm
  · have hvw0 : ((dagSim inp1 tbits t).getD (rdV reads r0).val dDflt).1 = 8 := by
      rw [dagSim_getD_fst, dagWidths_var t _ (hc.rt.var_lt r0 hr0) 8#usize
        (by rw [← getD_eq_getElem_of_lt (hc.rt.var_lt r0 hr0) dfltNode]; exact hc.rt.var_node r0 hr0)]
      simp
    have hvw : ((dagSim inp1 tbits t).getD (rdV reads r).val dDflt).1 = 8 := by
      rw [dagSim_getD_fst, dagWidths_var t _ (hc.rt.var_lt r hr) 8#usize
        (by rw [← getD_eq_getElem_of_lt (hc.rt.var_lt r hr) dfltNode]; exact hc.rt.var_node r hr)]
      simp
    exact dval_eq_of_toW _ _ (by rw [hvw0, hvw]) heq

/-- Two call variables of one function on equal argument values hold one
    result (the Ackermann root for the pair). -/
theorem calls_consistent (e : List ExtNode) (ebits : List Bool)
    (eside eroots map reads calls cargs : List Std.Usize) (t : List blast_kernel.DagNode) (tbits : List Bool)
    (troots : List Std.Usize)
    (hc : SliverCorr e ebits eside eroots map reads calls cargs t tbits troots)
    (inp1 : List Bool) (hall : ∀ k (hk : k < troots.length), dagBool inp1 tbits t (troots[k]).val = true)
    (c0 c : Nat) (hlt : c0 < c) (hcc : IsCall calls c) (hfid : clF calls c0 = clF calls c)
    (hargs : argVals (dagSim inp1 tbits t) cargs (clS calls c0).val (clK calls c0).val
      = argVals (dagSim inp1 tbits t) cargs (clS calls c).val (clK calls c).val) :
    (dagSim inp1 tbits t).getD (clV calls c0).val dDflt = (dagSim inp1 tbits t).getD (clV calls c).val dDflt := by
  have hc0 : IsCall calls c0 := by unfold IsCall at hcc ⊢; omega
  have hk : clK calls c0 = clK calls c := by
    apply UScalar.eq_of_val_eq
    have := congrArg List.length hargs
    simpa [argVals_length] using this
  have hpair : CallPair calls c0 c := ⟨hlt, hcc, hfid, hk⟩
  obtain ⟨ia, hia1, hia2, _, huf⟩ := hc.cong
  obtain ⟨k, hk1, hk2, hroot⟩ := huf.2 c0 c trivial hpair
  have hkl : k < troots.length := by omega
  have hval := hall k hkl
  rw [← getD_eq_getElem_of_lt hkl 0#usize] at hval
  unfold UfRootAt UfRoot at hroot
  -- the argument values agree elementwise
  have hargi : ∀ i < (clK calls c0).val,
      ((dagSim inp1 tbits t).getD (cargs.getD ((clS calls c0).val + i) 0#usize).val dDflt).2
        = toW _ ((dagSim inp1 tbits t).getD (cargs.getD ((clS calls c).val + i) 0#usize).val dDflt) := by
    intro i hi
    have h1 := congrArg (fun L => L.getD i dDflt) hargs
    simp only at h1
    rw [argVals_getD _ _ _ _ i hi, argVals_getD _ _ _ _ i (by rw [← hk]; exact hi)] at h1
    rw [h1]
    exact (toW_self _).symm
  rcases hroot with ⟨hk0, hrl, heq⟩ | ⟨hk1', a, ⟨hrl, nn, c', hor, hcl, hceq, hnl, hnot⟩, hante⟩
  · rw [getD_eq_getElem_of_lt hrl] at heq
    have hwfr := hc.twf _ hrl
    rw [heq] at hwfr
    obtain ⟨hvp, hvq, _, hww⟩ := hwfr
    unfold dagBool at hval
    rw [dagSim_eqnode inp1 tbits t _ hrl _ _ heq hvp hvq] at hval
    simp only [bval_bvBool, decide_eq_true_eq] at hval
    exact dval_eq_of_toW _ _ (by rw [dagSim_getD_fst, dagSim_getD_fst]; exact hww) hval
  · rw [getD_eq_getElem_of_lt hrl] at hor
    rw [getD_eq_getElem_of_lt hcl] at hceq
    rw [getD_eq_getElem_of_lt hnl] at hnot
    have hwfr := hc.twf _ hrl
    rw [hor] at hwfr
    obtain ⟨hnnr, hcr, _, _⟩ := hwfr
    have hwfc := hc.twf _ hcl
    rw [hceq] at hwfc
    obtain ⟨hvpc, hvqc, _, hww⟩ := hwfc
    have hwfn := hc.twf _ hnl
    rw [hnot] at hwfn
    obtain ⟨han, _⟩ := hwfn
    unfold dagBool at hval
    rw [dagSim_ornode inp1 tbits t _ hrl _ _ hor hnnr hcr,
      dagSim_notnode inp1 tbits t _ hnl _ hnot han,
      dagSim_eqnode inp1 tbits t _ hcl _ _ hceq hvpc hvqc] at hval
    simp only [bval_bvBool, Bool.or_eq_true, Bool.not_eq_eq_eq_not, Bool.not_true, decide_eq_true_eq] at hval
    rcases hval with hA | hE
    · exfalso
      have hA' : bval ((dagSim inp1 tbits t).getD a.val dDflt) = true :=
        (anteCorr_val t tbits tbits.length hc.twf cargs (clS calls c0).val (clS calls c).val inp1 _ a
          hante).mpr (fun i hi => hargi i (by omega))
      rw [hA'] at hA
      cases hA
    · exact dval_eq_of_toW _ _ (by rw [dagSim_getD_fst, dagSim_getD_fst]; exact hww) hE

open Classical in
/-- **SAT direction**: a core model pulls back to an interpretation of the
    tables — well defined because the congruence set is complete. -/
theorem pullback_tables_agree (e : List ExtNode) (ebits : List Bool)
    (eside eroots map reads calls cargs : List Std.Usize) (t : List blast_kernel.DagNode) (tbits : List Bool)
    (troots : List Std.Usize)
    (hc : SliverCorr e ebits eside eroots map reads calls cargs t tbits troots)
    (inp1 : List Bool) (hall : ∀ k (hk : k < troots.length), dagBool inp1 tbits t (troots[k]).val = true) :
    TablesAgree t tbits reads calls cargs (pullbackArrs t tbits reads inp1) (pullbackUfs t tbits calls cargs inp1)
      inp1 := by
  constructor
  · intro r hr
    unfold pullbackArrs
    have hex : ∃ r', IsRead reads r' ∧ (rdA reads r').val = (rdA reads r).val ∧
        toW 32 ((dagSim inp1 tbits t).getD (rdX reads r').val dDflt)
          = toW 32 ((dagSim inp1 tbits t).getD (rdX reads r).val dDflt) := ⟨r, hr, rfl, rfl⟩
    rw [dif_pos hex]
    obtain ⟨hr0, haid, hx⟩ := Nat.find_spec hex
    have hle : Nat.find hex ≤ r := Nat.find_min' hex ⟨hr, rfl, rfl⟩
    have hvw : ((dagSim inp1 tbits t).getD (rdV reads (Nat.find hex)).val dDflt).1 = 8 := by
      rw [dagSim_getD_fst, dagWidths_var t _ (hc.rt.var_lt _ hr0) 8#usize
        (by rw [← getD_eq_getElem_of_lt (hc.rt.var_lt _ hr0) dfltNode]; exact hc.rt.var_node _ hr0)]
      simp
    rw [dval_toW_self _ 8 hvw]
    rcases Nat.lt_or_ge (Nat.find hex) r with hlt | hge
    · exact (reads_consistent e ebits eside eroots map reads calls cargs t tbits troots hc inp1 hall _ r hlt hr
        (UScalar.eq_of_val_eq haid) hx).symm
    · have : Nat.find hex = r := by omega
      rw [this]
  · intro c hcc
    unfold pullbackUfs
    have hex : ∃ c', IsCall calls c' ∧ (clF calls c').val = (clF calls c).val ∧
        argVals (dagSim inp1 tbits t) cargs (clS calls c').val (clK calls c').val
          = argVals (dagSim inp1 tbits t) cargs (clS calls c).val (clK calls c).val := ⟨c, hcc, rfl, rfl⟩
    rw [dif_pos hex]
    obtain ⟨hc0, hfid, hargs⟩ := Nat.find_spec hex
    have hle : Nat.find hex ≤ c := Nat.find_min' hex ⟨hcc, rfl, rfl⟩
    have hvw : ((dagSim inp1 tbits t).getD (clV calls c).val dDflt).1 = (dagWidths t).getD (clV calls c).val 0 :=
      dagSim_getD_fst _ _ _ _
    rcases Nat.lt_or_ge (Nat.find hex) c with hlt | hge
    · rw [calls_consistent e ebits eside eroots map reads calls cargs t tbits troots hc inp1 hall _ c hlt hcc
        (UScalar.eq_of_val_eq hfid) hargs]
      exact (dval_toW_self _ _ hvw).symm
    · have : Nat.find hex = c := by omega
      rw [this]
      exact (dval_toW_self _ _ hvw).symm

/- ══════════════════ THE CAPSTONES ══════════════════ -/

/-- **The sliver correspondence check is sound, both ways**: an accepted
    check makes every extended model push forward to a core model, and
    every core model pull back to an extended model — with the extended
    variables bound through the map and the tables bound to the model. -/
theorem check_sliver_lowering_sound (e : Slice ExtNode) (ebits : Slice Bool)
    (eside eroots map reads calls cargs : Slice Std.Usize) (t : Slice blast_kernel.DagNode)
    (tbits : Slice Bool) (troots : Slice Std.Usize)
    (h : kernel.sliver_kernel.check_sliver_lowering e ebits eside eroots map reads calls cargs t tbits
      troots = ok (core.result.Result.Ok ())) :
    (∀ (inp0 : List Bool) (arrs : Arrs) (ufs : Ufs),
      ExtSat inp0 ebits.val arrs ufs eside.val e.val eroots.val →
        ∃ inp1 : List Bool, ∀ k (hk : k < troots.val.length),
          dagBool inp1 tbits.val t.val (troots.val[k]).val = true) ∧
    (∀ inp1 : List Bool, (∀ k (hk : k < troots.val.length),
        dagBool inp1 tbits.val t.val (troots.val[k]).val = true) →
      ∃ (inp0 : List Bool) (arrs : Arrs) (ufs : Ufs),
        ExtVarsAgree e.val t.val map.val inp0 inp1 ∧
        TablesAgree t.val tbits.val reads.val calls.val cargs.val arrs ufs inp1 ∧
        ExtSat inp0 ebits.val arrs ufs eside.val e.val eroots.val) := by
  have hc := check_sliver_lowering_accepted e ebits eside eroots map reads calls cargs t tbits troots h
  constructor
  · intro inp0 arrs ufs hs
    exact ⟨_, pushforward_sat e.val ebits.val eside.val eroots.val map.val reads.val calls.val cargs.val t.val
      tbits.val troots.val hc inp0 arrs ufs hs⟩
  · intro inp1 hall
    have hv := extVarsAgree_pullback e.val t.val map.val inp1
    have hta := pullback_tables_agree e.val ebits.val eside.val eroots.val map.val reads.val calls.val cargs.val
      t.val tbits.val troots.val hc inp1 hall
    refine ⟨pullbackE e.val t.val map.val inp1, pullbackArrs t.val tbits.val reads.val inp1,
      pullbackUfs t.val tbits.val calls.val cargs.val inp1, hv, hta, ?_⟩
    intro k hk
    have hcv := sliver_corr_values e.val ebits.val eside.val eroots.val map.val reads.val calls.val cargs.val
      t.val tbits.val troots.val hc _ inp1 _ _ hv hta
    rw [ext_roots_val e.val ebits.val eside.val eroots.val map.val reads.val calls.val cargs.val t.val tbits.val
      troots.val hc _ inp1 _ _ hcv k hk]
    have hk' : k < troots.val.length := by have := hc.roots_len; omega
    rw [getD_eq_getElem_of_lt hk' 0#usize]
    exact hall k hk'

/-- **THE UNSAT CAPSTONE**: an accepted sliver check, an accepted term
    check and an accepted query re-check refute the EXTENDED query under
    EVERY assignment, EVERY array interpretation and EVERY UF
    interpretation. -/
theorem check_sliver_unsat_sound (e : Slice ExtNode) (ebits : Slice Bool)
    (eside eroots map reads calls cargs : Slice Std.Usize) (t : Slice blast_kernel.DagNode)
    (tbits : Slice Bool) (troots map1 : Slice Std.Usize) (ns : Slice blast_kernel.DagNode)
    (bits : Slice Bool) (roots hints : Slice Std.Usize) (steps : Slice kernel.Step)
    (cnf : alloc.vec.Vec (alloc.vec.Vec Std.I32))
    (hs : kernel.sliver_kernel.check_sliver_lowering e ebits eside eroots map reads calls cargs t tbits
      troots = ok (core.result.Result.Ok ()))
    (ht : kernel.check_term_dag t tbits troots map1 ns bits roots = ok (core.result.Result.Ok ()))
    (hq : kernel.check_query ns bits roots hints steps = ok (core.result.Result.Ok cnf)) :
    ∀ (inp0 : List Bool) (arrs : Arrs) (ufs : Ufs),
      ¬ ExtSat inp0 ebits.val arrs ufs eside.val e.val eroots.val := by
  intro inp0 arrs ufs hsat
  obtain ⟨inp1, hall⟩ := (check_sliver_lowering_sound e ebits eside eroots map reads calls cargs t tbits
    troots hs).1 inp0 arrs ufs hsat
  exact check_term_unsat_sound t tbits troots map1 ns bits roots hints steps cnf ht hq inp1 hall

/-- **THE SAT CAPSTONE**: an accepted sliver check, an accepted term check
    and an accepted model re-check give a model of the EXTENDED query — an
    assignment, an array interpretation and a UF interpretation built from
    the model, under which every asserted extended root is true — bound to
    the model: the variables through the two maps, the arrays at every
    read, the functions at every call. -/
theorem check_sliver_model_sound (e : Slice ExtNode) (ebits : Slice Bool)
    (eside eroots map reads calls cargs : Slice Std.Usize) (t : Slice blast_kernel.DagNode)
    (tbits : Slice Bool) (troots map1 : Slice Std.Usize) (ns : Slice blast_kernel.DagNode)
    (bits : Slice Bool) (roots : Slice Std.Usize) (inp2 : Slice Bool)
    (hs : kernel.sliver_kernel.check_sliver_lowering e ebits eside eroots map reads calls cargs t tbits
      troots = ok (core.result.Result.Ok ()))
    (ht : kernel.check_term_dag t tbits troots map1 ns bits roots = ok (core.result.Result.Ok ()))
    (hm : kernel.check_query_model ns bits roots inp2 = ok (core.result.Result.Ok ())) :
    ∃ (inp0 inp1 : List Bool) (arrs : Arrs) (ufs : Ufs),
      VarsAgree t.val ns.val map1.val inp1 inp2.val ∧
      ExtVarsAgree e.val t.val map.val inp0 inp1 ∧
      TablesAgree t.val tbits.val reads.val calls.val cargs.val arrs ufs inp1 ∧
      ExtSat inp0 ebits.val arrs ufs eside.val e.val eroots.val := by
  obtain ⟨inp1, hva, hall⟩ := check_term_model_sound t tbits troots map1 ns bits roots inp2 ht hm
  obtain ⟨inp0, arrs, ufs, hv, hta, hsat⟩ := (check_sliver_lowering_sound e ebits eside eroots map reads calls
    cargs t tbits troots hs).2 inp1 hall
  exact ⟨inp0, inp1, arrs, ufs, hva, hv, hta, hsat⟩

/-- **No extended query has both an accepted refutation and an accepted
    model.** -/
theorem sliver_verdicts_exclusive (e : Slice ExtNode) (ebits : Slice Bool)
    (eside eroots map reads calls cargs : Slice Std.Usize) (t : Slice blast_kernel.DagNode)
    (tbits : Slice Bool) (troots map1 : Slice Std.Usize) (ns : Slice blast_kernel.DagNode)
    (bits : Slice Bool) (roots hints : Slice Std.Usize) (steps : Slice kernel.Step)
    (cnf : alloc.vec.Vec (alloc.vec.Vec Std.I32)) (inp2 : Slice Bool)
    (hs : kernel.sliver_kernel.check_sliver_lowering e ebits eside eroots map reads calls cargs t tbits
      troots = ok (core.result.Result.Ok ()))
    (ht : kernel.check_term_dag t tbits troots map1 ns bits roots = ok (core.result.Result.Ok ()))
    (hq : kernel.check_query ns bits roots hints steps = ok (core.result.Result.Ok cnf))
    (hm : kernel.check_query_model ns bits roots inp2 = ok (core.result.Result.Ok ())) : False := by
  obtain ⟨inp0, _, arrs, ufs, _, _, _, hsat⟩ :=
    check_sliver_model_sound e ebits eside eroots map reads calls cargs t tbits troots map1 ns bits roots inp2
      hs ht hm
  exact check_sliver_unsat_sound e ebits eside eroots map reads calls cargs t tbits troots map1 ns bits roots
    hints steps cnf hs ht hq inp0 arrs ufs hsat

end kernel.spec
