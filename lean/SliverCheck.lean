theorem dead_entry_loop_spec (cls : Slice Std.Usize) (n found i : Std.Usize)
    (hn : n.val = cls.val.length)
    (hinv : i.val ≤ n.val ∧ found.val ≤ n.val ∧ (found = n → ∀ m < i.val,
      cls.val.getD m 0#usize ≠ 2#usize ∧ cls.val.getD m 0#usize ≠ 3#usize)) :
    kernel.sliver_kernel.dead_entry_loop cls n found i ⦃ r => r.val ≤ n.val ∧ (r = n →
      ∀ m < cls.val.length, cls.val.getD m 0#usize ≠ 2#usize ∧ cls.val.getD m 0#usize ≠ 3#usize) ⦄ := by
  unfold kernel.sliver_kernel.dead_entry_loop
  apply loop.spec_decr_nat
    (measure := fun (st : Std.Usize × Std.Usize) => n.val - st.2.val)
    (inv := fun (st : Std.Usize × Std.Usize) => st.2.val ≤ n.val ∧ st.1.val ≤ n.val ∧
      (st.1 = n → ∀ m < st.2.val,
        cls.val.getD m 0#usize ≠ 2#usize ∧ cls.val.getD m 0#usize ≠ 3#usize))
  · rintro ⟨found1, i1⟩ ⟨hle, hfle, hf⟩
    dsimp only at hle hfle hf
    unfold kernel.sliver_kernel.dead_entry_loop.body
    try dsimp only
    split
    · rename_i hfn
      have hall := hf hfn
      split
      · rename_i hlt
        have hlt' : i1.val < cls.val.length := by scalar_tac
        step as ⟨c, hc⟩
        rw [dead_class_eq]
        simp only [bind_tc_ok]
        have hcg : cls.val.getD i1.val 0#usize = c := by rw [getD_eq_getElem_of_lt hlt', hc]
        split
        · rename_i hdead
          step as ⟨i2, hi2⟩
          and_intros
          · scalar_tac
          · scalar_tac
          · intro h
            exfalso
            rw [h] at hlt
            exact lt_irrefl _ hlt
          · scalar_tac
        · rename_i hdead
          have hdead' : ¬ (c = 2#usize ∨ c = 3#usize) := by simpa using hdead
          step as ⟨i2, hi2⟩
          and_intros
          · scalar_tac
          · scalar_tac
          · intro _ m hm
            rw [hi2] at hm
            rcases Nat.lt_or_ge m i1.val with h | h
            · exact hall m h
            · have : m = i1.val := by omega
              subst this
              rw [hcg]
              exact ⟨fun h => hdead' (Or.inl h), fun h => hdead' (Or.inr h)⟩
          · scalar_tac
      · rename_i hge
        have hieq : i1.val = n.val := by scalar_tac
        try simp only [WP.spec_ok]
        refine ⟨hfle, fun _ m hm => hall m (by omega)⟩
    · rename_i hfn
      try simp only [WP.spec_ok]
      exact ⟨hfle, fun h => absurd h hfn⟩
  · exact hinv

