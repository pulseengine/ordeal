theorem args_eq_loop_spec (cargs : Slice Std.Usize) (s1 s2 k : Std.Usize) (ok1 : Bool) (l : Std.Usize)
    (h1 : s1.val + k.val ≤ cargs.val.length) (h2 : s2.val + k.val ≤ cargs.val.length)
    (hinv : l.val ≤ k.val ∧ (ok1 = true ↔ ∀ l' < l.val,
      cargs.val.getD (s1.val + l') 0#usize = cargs.val.getD (s2.val + l') 0#usize)) :
