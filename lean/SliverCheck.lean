import TermCheck

open Aeneas Aeneas.Std Result
open kernel.blast_kernel.spec

set_option maxHeartbeats 4000000

namespace kernel.spec

/- ══════════════════ THE EXTENDED SEMANTICS ══════════════════ -/

abbrev ExtNode := kernel.sliver_kernel.ExtNode

/-- An array interpretation: every array id is a total map BV32 → BV8. -/
abbrev Arrs := Nat → BitVec 32 → BitVec 8

/-- A UF interpretation: every function id is a total map from argument
    values. The call node coerces the result to its declared width, so
    every `ufs` is an interpretation of every signature. -/
abbrev Ufs := Nat → List DVal → DVal

/-- Read-over-write, as `eval_array` walks it: the most recent store whose
    index equals `j` wins; past the chain, the base array. -/
def chainRead (arrs : Arrs) (vals : List DVal) (side : List Std.Usize) (aid : Nat)
    (j : BitVec 32) : Nat → Nat → BitVec 8
  | _, 0 => arrs aid j
  | s, n + 1 =>
    if toW 32 (vals.getD (side.getD s 0#usize).val dDflt) = j
    then toW 8 (vals.getD (side.getD (s + 1) 0#usize).val dDflt)
    else chainRead arrs vals side aid j (s + 2) n

/-- The argument values of a call: the `n` side-table nodes from `s`. -/
def argVals (vals : List DVal) (side : List Std.Usize) (s n : Nat) : List DVal :=
  (List.range n).map (fun k => vals.getD (side.getD (s + k) 0#usize).val dDflt)

/-- The value of one extended node (`dagNodeVal` on the closed arms). -/
def extNodeVal (inp bits : List Bool) (arrs : Arrs) (ufs : Ufs) (side : List Std.Usize)
    (vals : List DVal) (nin : Nat) : ExtNode → DVal
  | .Core nd => dagNodeVal inp bits vals nin nd
  | .Select aid j s n =>
    ⟨8, chainRead arrs vals side aid.val (toW 32 (vals.getD j.val dDflt)) s.val n.val⟩
  | .Call fid w s n => ⟨w.val, toW w.val (ufs fid.val (argVals vals side s.val n.val))⟩

/-- The primary-input counter after an extended node: a query variable
    takes its width. -/
def extNodeNin (nin : Nat) : ExtNode → Nat
  | .Core nd => dagNodeNin nin nd
  | _ => nin

/-- The width of one extended node: a `select` is BV8, a call its declared
    width. -/
def extNodeWidth (ws : List Nat) : ExtNode → Nat
  | .Core nd => dagNodeWidth ws nd
  | .Select _ _ _ _ => 8
  | .Call _ w _ _ => w.val

def extSimAux (inp bits : List Bool) (arrs : Arrs) (ufs : Ufs) (side : List Std.Usize) :
    List DVal × Nat → List ExtNode → List DVal × Nat
  | st, [] => st
  | (vals, nin), nd :: ns =>
    extSimAux inp bits arrs ufs side
      (vals ++ [extNodeVal inp bits arrs ufs side vals nin nd], extNodeNin nin nd) ns

/-- **The extended semantics**: one value per node. -/
def extSim (inp bits : List Bool) (arrs : Arrs) (ufs : Ufs) (side : List Std.Usize)
    (e : List ExtNode) : List DVal :=
  (extSimAux inp bits arrs ufs side ([], 0) e).1

/-- The number of primary inputs the extended query's variables take. -/
def extNin (e : List ExtNode) : Nat := e.foldl extNodeNin 0

/-- The boolean value of (boolean) extended node `i`. -/
def extBool (inp bits : List Bool) (arrs : Arrs) (ufs : Ufs) (side : List Std.Usize)
    (e : List ExtNode) (i : Nat) : Bool :=
  bval ((extSim inp bits arrs ufs side e).getD i dDflt)

/-- An extended model satisfies the query: every asserted root is true. -/
def ExtSat (inp bits : List Bool) (arrs : Arrs) (ufs : Ufs) (side : List Std.Usize)
    (e : List ExtNode) (eroots : List Std.Usize) : Prop :=
  ∀ k (hk : k < eroots.length), extBool inp bits arrs ufs side e (eroots[k]).val = true

def extWidthsAux : List Nat → List ExtNode → List Nat
  | ws, [] => ws
  | ws, nd :: ns => extWidthsAux (ws ++ [extNodeWidth ws nd]) ns

/-- The width of every extended node. -/
def extWidths (e : List ExtNode) : List Nat := extWidthsAux [] e

/- ══════════════════ STRUCTURAL FACTS ══════════════════ -/

theorem extSimAux_append (inp bits : List Bool) (arrs : Arrs) (ufs : Ufs) (side : List Std.Usize)
    (st : List DVal × Nat) (ns ms : List ExtNode) :
    extSimAux inp bits arrs ufs side st (ns ++ ms)
      = extSimAux inp bits arrs ufs side (extSimAux inp bits arrs ufs side st ns) ms := by
  induction ns generalizing st with
  | nil => simp [extSimAux]
  | cons nd ns ih =>
    obtain ⟨vals, nin⟩ := st
    simp [extSimAux, ih]

theorem extSimAux_length (inp bits : List Bool) (arrs : Arrs) (ufs : Ufs) (side : List Std.Usize)
    (vals : List DVal) (nin : Nat) (ns : List ExtNode) :
    (extSimAux inp bits arrs ufs side (vals, nin) ns).1.length = vals.length + ns.length := by
  induction ns generalizing vals nin with
  | nil => simp [extSimAux]
  | cons nd ns ih =>
    simp only [extSimAux, ih, List.length_append, List.length_cons, List.length_nil]
    omega

@[simp] theorem extSim_length (inp bits : List Bool) (arrs : Arrs) (ufs : Ufs)
    (side : List Std.Usize) (ns : List ExtNode) :
    (extSim inp bits arrs ufs side ns).length = ns.length := by
  unfold extSim
  rw [extSimAux_length]
  simp

theorem extSimAux_nin (inp bits : List Bool) (arrs : Arrs) (ufs : Ufs) (side : List Std.Usize)
    (vals : List DVal) (nin : Nat) (ns : List ExtNode) :
    (extSimAux inp bits arrs ufs side (vals, nin) ns).2 = ns.foldl extNodeNin nin := by
  induction ns generalizing vals nin with
  | nil => simp [extSimAux]
  | cons nd ns ih => simp [extSimAux, ih, List.foldl_cons]

theorem extSimAux_prefix (inp bits : List Bool) (arrs : Arrs) (ufs : Ufs) (side : List Std.Usize)
    (vals : List DVal) (nin : Nat) (ns : List ExtNode) :
    vals <+: (extSimAux inp bits arrs ufs side (vals, nin) ns).1 := by
  induction ns generalizing vals nin with
  | nil => simp [extSimAux]
  | cons nd ns ih => exact (List.prefix_append vals _).trans (ih _ _)

theorem extSim_prefix_of_prefix (inp bits : List Bool) (arrs : Arrs) (ufs : Ufs)
    (side : List Std.Usize) {ns ns' : List ExtNode} (h : ns <+: ns') :
    extSim inp bits arrs ufs side ns <+: extSim inp bits arrs ufs side ns' := by
  obtain ⟨t, rfl⟩ := h
  unfold extSim
  rw [extSimAux_append]
  exact extSimAux_prefix inp bits arrs ufs side _ _ t

theorem extSim_snoc (inp bits : List Bool) (arrs : Arrs) (ufs : Ufs) (side : List Std.Usize)
    (ns : List ExtNode) (nd : ExtNode) :
    extSim inp bits arrs ufs side (ns ++ [nd])
      = extSim inp bits arrs ufs side ns ++
        [extNodeVal inp bits arrs ufs side (extSim inp bits arrs ufs side ns) (extNin ns) nd] := by
  unfold extSim
  rw [extSimAux_append]
  have h : extSimAux inp bits arrs ufs side ([], 0) ns
      = ((extSimAux inp bits arrs ufs side ([], 0) ns).1, extNin ns) := by
    unfold extNin
    rw [← extSimAux_nin inp bits arrs ufs side [] 0 ns]
  rw [h]
  rfl

theorem extNin_snoc (ns : List ExtNode) (nd : ExtNode) :
    extNin (ns ++ [nd]) = extNodeNin (extNin ns) nd := by
  simp [extNin, List.foldl_append]

theorem extWidthsAux_append (ws : List Nat) (ns ms : List ExtNode) :
    extWidthsAux ws (ns ++ ms) = extWidthsAux (extWidthsAux ws ns) ms := by
  induction ns generalizing ws with
  | nil => simp [extWidthsAux]
  | cons nd ns ih => simp [extWidthsAux, ih]

theorem extWidthsAux_length (ws : List Nat) (ns : List ExtNode) :
    (extWidthsAux ws ns).length = ws.length + ns.length := by
  induction ns generalizing ws with
  | nil => simp [extWidthsAux]
  | cons nd ns ih =>
    simp only [extWidthsAux, ih, List.length_append, List.length_cons, List.length_nil]
    omega

@[simp] theorem extWidths_length (ns : List ExtNode) : (extWidths ns).length = ns.length := by
  unfold extWidths
  rw [extWidthsAux_length]
  simp

theorem extWidthsAux_prefix (ws : List Nat) (ns : List ExtNode) : ws <+: extWidthsAux ws ns := by
  induction ns generalizing ws with
  | nil => simp [extWidthsAux]
  | cons nd ns ih => exact (List.prefix_append ws _).trans (ih _)

theorem extWidths_prefix_of_prefix {ns ns' : List ExtNode} (h : ns <+: ns') :
    extWidths ns <+: extWidths ns' := by
  obtain ⟨t, rfl⟩ := h
  unfold extWidths
  rw [extWidthsAux_append]
  exact extWidthsAux_prefix _ t

theorem extWidths_snoc (ns : List ExtNode) (nd : ExtNode) :
    extWidths (ns ++ [nd]) = extWidths ns ++ [extNodeWidth (extWidths ns) nd] := by
  unfold extWidths
  rw [extWidthsAux_append]
  rfl

/-- The width of a node's value is its syntactic width. -/
theorem extNodeVal_fst (inp bits : List Bool) (arrs : Arrs) (ufs : Ufs) (side : List Std.Usize)
    (vals : List DVal) (nin : Nat) (nd : ExtNode) :
    (extNodeVal inp bits arrs ufs side vals nin nd).1 = extNodeWidth (vals.map Sigma.fst) nd := by
  cases nd with
  | Core nd => exact dagNodeVal_fst inp bits vals nin nd
  | Select _ _ _ _ => rfl
  | Call _ _ _ _ => rfl

theorem extSim_map_fst (inp bits : List Bool) (arrs : Arrs) (ufs : Ufs) (side : List Std.Usize)
    (ns : List ExtNode) :
    (extSim inp bits arrs ufs side ns).map Sigma.fst = extWidths ns := by
  induction ns using List.reverseRecOn with
  | nil => simp [extSim, extSimAux, extWidths, extWidthsAux]
  | append_singleton ns nd ih =>
    rw [extSim_snoc, extWidths_snoc, List.map_append, ih, List.map_singleton,
      extNodeVal_fst, ih]

theorem extSim_getD_fst (inp bits : List Bool) (arrs : Arrs) (ufs : Ufs) (side : List Std.Usize)
    (ns : List ExtNode) (i : Nat) :
    ((extSim inp bits arrs ufs side ns).getD i dDflt).1 = (extWidths ns).getD i 0 :=
  getD_map_fst (extSim_map_fst inp bits arrs ufs side ns) i

theorem extWidths_take_getD (ns : List ExtNode) (i j : Nat) (hj : j < i) :
    (extWidths (ns.take i)).getD j 0 = (extWidths ns).getD j 0 := by
  by_cases hi : i ≤ ns.length
  · have hpre := extWidths_prefix_of_prefix (List.take_prefix i ns)
    rw [getD_of_prefix hpre]
    rw [extWidths_length, List.length_take]
    omega
  · rw [List.take_of_length_le (by omega)]

theorem extWidths_getD_eq (ns : List ExtNode) (i : Nat) (hi : i < ns.length) :
    (extWidths ns).getD i 0 = extNodeWidth (extWidths (ns.take i)) ns[i] := by
  have htake : ns.take (i + 1) = ns.take i ++ [ns[i]] := by
    rw [List.take_add_one, List.getElem?_eq_getElem hi]
    simp
  have hpre := extWidths_prefix_of_prefix (List.take_prefix (i + 1) ns)
  have hlen : i < (extWidths (ns.take (i + 1))).length := by
    rw [extWidths_length, List.length_take]
    omega
  rw [getD_of_prefix hpre hlen, htake, extWidths_snoc]
  have hl : (extWidths (ns.take i)).length = i := by
    rw [extWidths_length, List.length_take]
    omega
  have := getD_snoc_length (extWidths (ns.take i)) (extNodeWidth (extWidths (ns.take i)) ns[i]) 0
  rw [hl] at this
  exact this

/-- The value of extended node `i` is its `extNodeVal` over the earlier
    nodes' values. -/
theorem extSim_getD_eq (inp bits : List Bool) (arrs : Arrs) (ufs : Ufs) (side : List Std.Usize)
    (ns : List ExtNode) (i : Nat) (hi : i < ns.length) :
    (extSim inp bits arrs ufs side ns).getD i dDflt
      = extNodeVal inp bits arrs ufs side (extSim inp bits arrs ufs side (ns.take i))
          (extNin (ns.take i)) ns[i] := by
  have htake : ns.take (i + 1) = ns.take i ++ [ns[i]] := by
    rw [List.take_add_one, List.getElem?_eq_getElem hi]
    simp
  have hpre := extSim_prefix_of_prefix inp bits arrs ufs side (List.take_prefix (i + 1) ns)
  have hlen : i < (extSim inp bits arrs ufs side (ns.take (i + 1))).length := by
    rw [extSim_length, List.length_take]
    omega
  rw [getD_of_prefix hpre hlen, htake, extSim_snoc]
  have hl : (extSim inp bits arrs ufs side (ns.take i)).length = i := by
    rw [extSim_length, List.length_take]
    omega
  have := getD_snoc_length (extSim inp bits arrs ufs side (ns.take i))
    (extNodeVal inp bits arrs ufs side (extSim inp bits arrs ufs side (ns.take i))
      (extNin (ns.take i)) ns[i]) dDflt
  rw [hl] at this
  exact this

theorem extSim_take_getD (inp bits : List Bool) (arrs : Arrs) (ufs : Ufs) (side : List Std.Usize)
    (ns : List ExtNode) (i j : Nat) (hj : j < i) :
    (extSim inp bits arrs ufs side (ns.take i)).getD j dDflt
      = (extSim inp bits arrs ufs side ns).getD j dDflt := by
  by_cases hi : i ≤ ns.length
  · have hpre := extSim_prefix_of_prefix inp bits arrs ufs side (List.take_prefix i ns)
    rw [getD_of_prefix hpre]
    rw [extSim_length, List.length_take]
    omega
  · rw [List.take_of_length_le (by omega)]

/- ══════════════════ WELL-FORMEDNESS ══════════════════ -/

/-- Chain level `l` of a `select` at node `i` (the level's two side-table
    entries from `s + 2l`): an earlier BV32 index node and an earlier BV8
    value node, within the side table. -/
def ChainLevelWF (ws : List Nat) (side : List Std.Usize) (i s l : Nat) : Prop :=
  s + 2 * l + 1 < side.length ∧
  (side.getD (s + 2 * l) 0#usize).val < i ∧ ws.getD (side.getD (s + 2 * l) 0#usize).val 0 = 32 ∧
  (side.getD (s + 2 * l + 1) 0#usize).val < i ∧
  ws.getD (side.getD (s + 2 * l + 1) 0#usize).val 0 = 8

/-- Argument `l` of a call at node `i`: an earlier node, within the side
    table. -/
def ArgWF (side : List Std.Usize) (i s l : Nat) : Prop :=
  s + l < side.length ∧ (side.getD (s + l) 0#usize).val < i

/-- Well-formedness of one extended node at position `i`. -/
def ExtNodeWF (ws : List Nat) (nbits : Nat) (side : List Std.Usize) (i : Nat) : ExtNode → Prop
  | .Core nd => DagNodeWF ws nbits i nd
  | .Select _ j s n => j.val < i ∧ ws.getD j.val 0 = 32 ∧ ∀ l < n.val, ChainLevelWF ws side i s.val l
  | .Call _ w s n => 0 < w.val ∧ ∀ l < n.val, ArgWF side i s.val l

/-- Well-formedness of the extended query. -/
def ExtWF (e : List ExtNode) (nbits : Nat) (side : List Std.Usize) : Prop :=
  ∀ (i : Nat) (h : i < e.length), ExtNodeWF (extWidths e) nbits side i e[i]

theorem ExtNodeWF_congr {ws ws' : List Nat} {nbits i : Nat} {side : List Std.Usize} {nd : ExtNode}
    (hagree : ∀ j, j < i → ws.getD j 0 = ws'.getD j 0)
    (h : ExtNodeWF ws nbits side i nd) : ExtNodeWF ws' nbits side i nd := by
  cases nd with
  | Core nd => exact DagNodeWF_congr hagree h
  | Select aid j s n =>
    obtain ⟨h1, h2, h3⟩ := h
    refine ⟨h1, by rw [← hagree _ h1]; exact h2, ?_⟩
    intro l hl
    obtain ⟨c1, c2, c3, c4, c5⟩ := h3 l hl
    exact ⟨c1, c2, by rw [← hagree _ c2]; exact c3, c4, by rw [← hagree _ c4]; exact c5⟩
  | Call fid w s n => exact h

/- ══════════════════ THE KERNEL: `ext_wf` ══════════════════ -/

/-- The loop invariant of a "walk `n` levels, verdict in `ok`" loop over
    the predicate `P` on levels: `ok` still true means the offset is where
    level `l` starts and every earlier level holds; `ok` false means some
    level below `n` fails. -/
def LevelInv (n s stride : Nat) (P : Nat → Prop) (st : Bool × Std.Usize × Std.Usize) : Prop :=
  st.2.1.val ≤ n ∧
  (st.1 = true → st.2.2.val = s + stride * st.2.1.val ∧ ∀ l' < st.2.1.val, P l') ∧
  (st.1 = false → ∃ l' < n, ¬ P l')

/-- One level of such a loop: the verdict `ok3` of level `l1` and the new
    offset re-establish the invariant at `l1 + 1`. -/
theorem levelInv_step (n s stride : Nat) (P : Nat → Prop) (l1 l2 off2 : Std.Usize) (ok3 : Bool)
    (hl : l1.val < n) (hl2 : l2.val = l1.val + 1) (hlev : ∀ l' < l1.val, P l')
    (h3t : ok3 = true → off2.val = s + stride * (l1.val + 1) ∧ P l1.val)
    (h3f : ok3 = false → ¬ P l1.val) :
    LevelInv n s stride P (ok3, l2, off2) ∧ n - l2.val < n - l1.val := by
  refine ⟨⟨by simp only; omega, ?_, ?_⟩, by omega⟩
  · intro h
    obtain ⟨ho, hc⟩ := h3t h
    refine ⟨by simp only; rw [hl2]; exact ho, ?_⟩
    intro l' hl'
    simp only at hl'
    rw [hl2] at hl'
    rcases Nat.lt_or_ge l' l1.val with h' | h'
    · exact hlev l' h'
    · have : l' = l1.val := by omega
      subst this
      exact hc
  · intro h
    exact ⟨l1.val, hl, h3f h⟩

theorem chain_wf_loop_spec (ws eside : Slice Std.Usize) (n nn m : Std.Usize) (ok1 : Bool)
    (l off s : Std.Usize) (hnn : nn.val = ws.val.length) (hm : m.val = eside.val.length)
    (hinv : LevelInv n.val s.val 2
      (ChainLevelWF (ws.val.map UScalar.val) eside.val ws.val.length s.val) (ok1, l, off)) :
    kernel.sliver_kernel.chain_wf_loop ws eside n nn m ok1 l off ⦃ r => r = true ↔
      ∀ l' < n.val, ChainLevelWF (ws.val.map UScalar.val) eside.val ws.val.length s.val l' ⦄ := by
  unfold kernel.sliver_kernel.chain_wf_loop
  apply loop.spec_decr_nat
    (measure := fun (st : Bool × Std.Usize × Std.Usize) => n.val - st.2.1.val)
    (inv := LevelInv n.val s.val 2
      (ChainLevelWF (ws.val.map UScalar.val) eside.val ws.val.length s.val))
  · rintro ⟨ok2, l1, off1⟩ ⟨hle, hok, hnok⟩
    dsimp only at hle hok hnok
    unfold kernel.sliver_kernel.chain_wf_loop.body
    try dsimp only
    split
    · rename_i hokt
      obtain ⟨hoff, hlev⟩ := hok hokt
      split
      · rename_i hlt
        have hlt' : l1.val < n.val := by scalar_tac
        split
        · rename_i hge
          step as ⟨l2, hl2⟩
          apply levelInv_step _ _ _ _ l1 l2 _ _ hlt' hl2 hlev
          · intro h; cases h
          · intro _ hc
            have h1 := hc.1
            scalar_tac
        · rename_i hge
          step as ⟨i, hi⟩
          split
          · rename_i hlt2
            step as ⟨l2, hl2⟩
            apply levelInv_step _ _ _ _ l1 l2 _ _ hlt' hl2 hlev
            · intro h; cases h
            · intro _ hc
              have h1 := hc.1
              scalar_tac
          · rename_i hge2
            have hoffl : off1.val + 1 < eside.val.length := by scalar_tac
            step as ⟨x, hx⟩
            step as ⟨i1, hi1⟩
            have hi1l : i1.val < eside.val.length := by scalar_tac
            step as ⟨v, hv⟩
            have hxg : eside.val.getD (s.val + 2 * l1.val) 0#usize = x := by
              rw [← hoff, getD_eq_getElem_of_lt (by omega), hx]
            have hvg : eside.val.getD (s.val + 2 * l1.val + 1) 0#usize = v := by
              rw [← hoff, ← hi1, getD_eq_getElem_of_lt hi1l, hv]
            split
            · rename_i hxge
              step as ⟨l2, hl2⟩
              apply levelInv_step _ _ _ _ l1 l2 _ _ hlt' hl2 hlev
              · intro h; cases h
              · intro _
                unfold ChainLevelWF
                rw [hxg]
                scalar_tac
            · rename_i hxlt
              have hxlt' : x.val < ws.val.length := by scalar_tac
              step as ⟨i2, hi2⟩
              split
              · rename_i hw32
                step as ⟨l2, hl2⟩
                apply levelInv_step _ _ _ _ l1 l2 _ _ hlt' hl2 hlev
                · intro h; cases h
                · intro _ hc
                  have hne : ¬ i2.val = 32 := by simpa using hw32
                  have h32 := hc.2.2.1
                  rw [hxg, getD_map_val _ _ hxlt', ← hi2] at h32
                  exact hne h32
              · rename_i hw32
                have hw32' : i2.val = 32 := by simpa using hw32
                split
                · rename_i hvge
                  step as ⟨l2, hl2⟩
                  apply levelInv_step _ _ _ _ l1 l2 _ _ hlt' hl2 hlev
                  · intro h; cases h
                  · intro _
                    unfold ChainLevelWF
                    rw [hvg]
                    scalar_tac
                · rename_i hvlt
                  have hvlt' : v.val < ws.val.length := by scalar_tac
                  step as ⟨i3, hi3⟩
                  split
                  · rename_i hw8
                    step as ⟨l2, hl2⟩
                    apply levelInv_step _ _ _ _ l1 l2 _ _ hlt' hl2 hlev
                    · intro h; cases h
                    · intro _ hc
                      have hne : ¬ i3.val = 8 := by simpa using hw8
                      have h8 := hc.2.2.2.2
                      rw [hvg, getD_map_val _ _ hvlt', ← hi3] at h8
                      exact hne h8
                  · rename_i hw8
                    have hw8' : i3.val = 8 := by simpa using hw8
                    step as ⟨off2, hoff2⟩
                    step as ⟨l2, hl2⟩
                    apply levelInv_step _ _ _ _ l1 l2 _ _ hlt' hl2 hlev
                    · intro _
                      refine ⟨by rw [hoff2, hoff]; omega, ?_⟩
                      unfold ChainLevelWF
                      rw [hxg, hvg, getD_map_val _ _ hxlt', getD_map_val _ _ hvlt', ← hi2, ← hi3]
                      refine ⟨by omega, by scalar_tac, hw32', by scalar_tac, hw8'⟩
                    · intro h; cases h
      · rename_i hge
        have hleq : l1.val = n.val := by scalar_tac
        try simp only [WP.spec_ok]
        constructor
        · intro _ l' hl'
          exact hlev l' (by omega)
        · intro _; trivial
    · rename_i hokf
      have hokf' : ok2 = false := by simpa using hokf
      obtain ⟨l', hl', hn⟩ := hnok hokf'
      try simp only [WP.spec_ok]
      constructor
      · intro h; cases h
      · intro h
        exact absurd (h l' hl') hn
  · exact hinv

theorem chain_wf_spec (ws eside : Slice Std.Usize) (s n : Std.Usize) :
    kernel.sliver_kernel.chain_wf ws eside s n ⦃ r => r = true ↔
      ∀ l' < n.val, ChainLevelWF (ws.val.map UScalar.val) eside.val ws.val.length s.val l' ⦄ := by
  unfold kernel.sliver_kernel.chain_wf
  try dsimp only
  apply chain_wf_loop_spec ws eside n _ _ true 0#usize s s (by simp) (by simp)
  refine ⟨by simp, fun _ => ⟨by simp, fun l' hl' => by simp at hl'⟩, fun h => by cases h⟩

theorem args_wf_loop_spec (ws eside : Slice Std.Usize) (n nn m : Std.Usize) (ok1 : Bool)
    (l off s : Std.Usize) (hnn : nn.val = ws.val.length) (hm : m.val = eside.val.length)
    (hinv : LevelInv n.val s.val 1 (ArgWF eside.val ws.val.length s.val) (ok1, l, off)) :
    kernel.sliver_kernel.args_wf_loop eside n nn m ok1 l off ⦃ r => r = true ↔
      ∀ l' < n.val, ArgWF eside.val ws.val.length s.val l' ⦄ := by
  unfold kernel.sliver_kernel.args_wf_loop
  apply loop.spec_decr_nat
    (measure := fun (st : Bool × Std.Usize × Std.Usize) => n.val - st.2.1.val)
    (inv := LevelInv n.val s.val 1 (ArgWF eside.val ws.val.length s.val))
  · rintro ⟨ok2, l1, off1⟩ ⟨hle, hok, hnok⟩
    dsimp only at hle hok hnok
    unfold kernel.sliver_kernel.args_wf_loop.body
    try dsimp only
    split
    · rename_i hokt
      obtain ⟨hoff, hlev⟩ := hok hokt
      split
      · rename_i hlt
        have hlt' : l1.val < n.val := by scalar_tac
        split
        · rename_i hge
          step as ⟨l2, hl2⟩
          apply levelInv_step _ _ _ _ l1 l2 _ _ hlt' hl2 hlev
          · intro h; cases h
          · intro _ hc
            have h1 := hc.1
            scalar_tac
        · rename_i hge
          have hoffl : off1.val < eside.val.length := by scalar_tac
          step as ⟨a, ha⟩
          have hoff' : off1.val = s.val + l1.val := by rw [hoff]; omega
          have hag : eside.val.getD (s.val + l1.val) 0#usize = a := by
            rw [← hoff', getD_eq_getElem_of_lt hoffl, ha]
          split
          · rename_i hage
            step as ⟨l2, hl2⟩
            apply levelInv_step _ _ _ _ l1 l2 _ _ hlt' hl2 hlev
            · intro h; cases h
            · intro _
              unfold ArgWF
              rw [hag]
              scalar_tac
          · rename_i halt
            step as ⟨off2, hoff2⟩
            step as ⟨l2, hl2⟩
            apply levelInv_step _ _ _ _ l1 l2 _ _ hlt' hl2 hlev
            · intro _
              refine ⟨by rw [hoff2, hoff]; omega, ?_⟩
              unfold ArgWF
              rw [hag]
              refine ⟨by omega, by scalar_tac⟩
            · intro h; cases h
      · rename_i hge
        have hleq : l1.val = n.val := by scalar_tac
        try simp only [WP.spec_ok]
        constructor
        · intro _ l' hl'
          exact hlev l' (by omega)
        · intro _; trivial
    · rename_i hokf
      have hokf' : ok2 = false := by simpa using hokf
      obtain ⟨l', hl', hn⟩ := hnok hokf'
      try simp only [WP.spec_ok]
      constructor
      · intro h; cases h
      · intro h
        exact absurd (h l' hl') hn
  · exact hinv

theorem args_wf_spec (ws eside : Slice Std.Usize) (s n : Std.Usize) :
    kernel.sliver_kernel.args_wf ws eside s n ⦃ r => r = true ↔
      ∀ l' < n.val, ArgWF eside.val ws.val.length s.val l' ⦄ := by
  unfold kernel.sliver_kernel.args_wf
  try dsimp only
  apply args_wf_loop_spec ws eside n _ _ true 0#usize s s (by simp) (by simp)
  refine ⟨by simp, fun _ => ⟨by simp, fun l' hl' => by simp at hl'⟩, fun h => by cases h⟩

theorem ext_node_wf_spec (ws : Slice Std.Usize) (nbits : Std.Usize) (eside : Slice Std.Usize)
    (nd : ExtNode) :
    kernel.sliver_kernel.ext_node_wf ws nbits eside nd ⦃ b => b = true ↔
      (ExtNodeWF (ws.val.map UScalar.val) nbits.val eside.val ws.val.length nd ∧
        extNodeWidth (ws.val.map UScalar.val) nd ≤ Usize.max) ⦄ := by
  unfold kernel.sliver_kernel.ext_node_wf
  try dsimp only
  induction nd with
  | Core nd =>
    simp only
    exact node_wf_spec ws nbits nd
  | Select aid j s n =>
    simp only [ExtNodeWF, extNodeWidth, and_assoc]
    have hmax : (8 : Nat) ≤ Usize.max := by scalar_tac
    split
    · rename_i hlt
      have hlt' : j.val < ws.val.length := by scalar_tac
      step as ⟨i, hi⟩
      split
      · rename_i h32
        apply WP.spec_mono (chain_wf_spec ws eside s n)
        intro r hr
        rw [hr]
        have h32' : (ws.val.map UScalar.val).getD j.val 0 = 32 := by
          rw [getD_map_val _ _ hlt', ← hi, h32]
          rfl
        constructor
        · intro h
          exact ⟨hlt', h32', h, hmax⟩
        · intro h
          exact h.2.2.1
      · rename_i h32
        try simp only [WP.spec_ok]
        constructor
        · intro h; cases h
        · rintro ⟨_, h32', _, _⟩
          exfalso
          apply h32
          rw [getD_map_val _ _ hlt', ← hi] at h32'
          exact UScalar.eq_of_val_eq (by simpa using h32')
    · rename_i hge
      try simp only [WP.spec_ok]
      constructor
      · intro h; cases h
      · rintro ⟨hj, _, _, _⟩
        scalar_tac
  | Call fid w s n =>
    simp only [ExtNodeWF, extNodeWidth, and_assoc]
    have hmax : w.val ≤ Usize.max := by scalar_tac
    split
    · rename_i hpos
      apply WP.spec_mono (args_wf_spec ws eside s n)
      intro r hr
      rw [hr]
      constructor
      · intro h
        exact ⟨by scalar_tac, h, hmax⟩
      · intro h
        exact h.2.1
    · rename_i hpos
      try simp only [WP.spec_ok]
      constructor
      · intro h; cases h
      · rintro ⟨hw, _, _⟩
        scalar_tac

theorem ext_node_width_spec (ws : Slice Std.Usize) (nbits : Std.Usize) (eside : Slice Std.Usize)
    (nd : ExtNode)
    (hwf : ExtNodeWF (ws.val.map UScalar.val) nbits.val eside.val ws.val.length nd)
    (hfit : extNodeWidth (ws.val.map UScalar.val) nd ≤ Usize.max) :
    kernel.sliver_kernel.ext_node_width ws nd ⦃ w =>
      w.val = extNodeWidth (ws.val.map UScalar.val) nd ⦄ := by
  unfold kernel.sliver_kernel.ext_node_width
  try dsimp only
  induction nd with
  | Core nd => exact node_width_spec ws nbits nd hwf hfit
  | Select aid j s n => simp [extNodeWidth]
  | Call fid w s n => simp [extNodeWidth]

/-- The loop invariant of `ext_wf_loop` after `i` nodes. -/
def ExtWFInv (e : List ExtNode) (nbits : Nat) (side : List Std.Usize)
    (st : alloc.vec.Vec Std.Usize × Std.Usize) : Prop :=
  st.2.val ≤ e.length ∧
  st.1.val.map UScalar.val = extWidths (e.take st.2.val) ∧
  ∀ (j : Nat) (hj : j < st.2.val) (hj' : j < e.length), ExtNodeWF (extWidths e) nbits side j e[j]

def ExtWFPost (e : List ExtNode) (nbits : Nat) (side : List Std.Usize) :
    core.result.Result (alloc.vec.Vec Std.Usize) kernel.sliver_kernel.SliverCheckError → Prop
  | .Ok ws => ws.val.map UScalar.val = extWidths e ∧ ExtWF e nbits side
  | .Err _ => ¬ (ExtWF e nbits side ∧ ∀ w ∈ extWidths e, w ≤ Usize.max)

theorem ext_wf_loop_spec (e : Slice ExtNode) (nbits : Std.Usize) (eside : Slice Std.Usize)
    (ws : alloc.vec.Vec Std.Usize) (n i : Std.Usize)
    (hn : n.val = e.val.length) (hinv : ExtWFInv e.val nbits.val eside.val (ws, i)) :
    kernel.sliver_kernel.ext_wf_loop e nbits eside ws n i ⦃ r =>
      ExtWFPost e.val nbits.val eside.val r ⦄ := by
  unfold kernel.sliver_kernel.ext_wf_loop
  apply loop.spec_decr_nat
    (measure := fun (st : alloc.vec.Vec Std.Usize × Std.Usize) => e.val.length - st.2.val)
    (inv := ExtWFInv e.val nbits.val eside.val)
  · rintro ⟨ws1, i1⟩ ⟨hile, hws, hwf⟩
    dsimp only at hile hws hwf
    unfold kernel.sliver_kernel.ext_wf_loop.body
    try dsimp only
    split
    · rename_i hlt
      have hilt : i1.val < e.val.length := by scalar_tac
      have hlen : ws1.val.length = i1.val := by
        have := congrArg List.length hws
        simp only [List.length_map, extWidths_length, List.length_take] at this
        omega
      have hderef : (alloc.vec.Vec.deref ws1).val = ws1.val := rfl
      have htake : e.val.take (i1.val + 1) = e.val.take i1.val ++ [e.val[i1.val]] := by
        rw [List.take_add_one, List.getElem?_eq_getElem hilt]
        simp
      step as ⟨node, hnode⟩
      step with (ext_node_wf_spec (alloc.vec.Vec.deref ws1) nbits eside node) as ⟨b, hb⟩
      rw [hderef, hlen, hws] at hb
      split
      · rename_i hbt
        obtain ⟨hnwf, hfit⟩ := hb.mp hbt
        step with (ext_node_width_spec (alloc.vec.Vec.deref ws1) nbits eside node
          (by rw [hderef, hlen, hws]; exact hnwf) (by rw [hderef, hws]; exact hfit)) as ⟨w, hw⟩
        rw [hderef, hws] at hw
        have hcap : ws1.val.length < Usize.max := by
          have := e.length_ineq
          omega
        step as ⟨ws2, hws2⟩
        step as ⟨i2, hi2⟩
        refine ⟨?_, by scalar_tac⟩
        unfold ExtWFInv
        dsimp only
        refine ⟨by scalar_tac, ?_, ?_⟩
        · rw [hws2, hi2, List.map_append, hws, htake, extWidths_snoc]
          simp [hw, hnode]
        · intro j hj hj'
          rw [hi2] at hj
          rcases Nat.lt_or_ge j i1.val with hjl | hjl
          · exact hwf j hjl hj'
          · have hjeq : j = i1.val := by omega
            subst hjeq
            rw [← hnode]
            exact ExtNodeWF_congr (fun k hk => extWidths_take_getD e.val i1.val k hk) hnwf
      · rename_i hbf
        simp only [WP.spec_ok, ExtWFPost]
        rintro ⟨hdag, hfits⟩
        apply hbf
        rw [hb, hnode]
        refine ⟨?_, ?_⟩
        · exact ExtNodeWF_congr (fun k hk => (extWidths_take_getD e.val i1.val k hk).symm)
            (hdag i1.val hilt)
        · rw [← extWidths_getD_eq e.val i1.val hilt]
          exact getD_le_of_forall hfits _
    · rename_i hge
      have hieq : i1.val = e.val.length := by scalar_tac
      simp only [WP.spec_ok, ExtWFPost]
      rw [hieq, List.take_length] at hws
      refine ⟨hws, ?_⟩
      intro j hj
      exact hwf j (by omega) hj
  · exact hinv

/-- **`ext_wf` is exactly `ExtWF` + "every width fits `usize`"**: `Ok ws`
    returns the width list of a well-formed extended query (the twin of
    `dag_wf_spec`). -/
theorem sliver_ext_wf_spec (e : Slice ExtNode) (nbits : Std.Usize) (eside : Slice Std.Usize) :
    kernel.sliver_kernel.ext_wf e nbits eside ⦃ r => match r with
      | core.result.Result.Ok ws =>
        ws.val.map UScalar.val = extWidths e.val ∧ ExtWF e.val nbits.val eside.val
      | core.result.Result.Err _ =>
        ¬ (ExtWF e.val nbits.val eside.val ∧ ∀ w ∈ extWidths e.val, w ≤ Usize.max) ⦄ := by
  unfold kernel.sliver_kernel.ext_wf
  try dsimp only
  apply WP.spec_mono (ext_wf_loop_spec e nbits eside _ _ _ (by simp) ?_)
  · intro r hr
    cases r with
    | Ok ws => exact hr
    | Err e => exact hr
  · unfold ExtWFInv
    dsimp only
    refine ⟨by simp, ?_, ?_⟩
    · simp [extWidths, extWidthsAux]
    · intro j hj _
      simp at hj

/- ══════════════════ THE TABLES: PURE VIEW ══════════════════ -/

/-- A placeholder extended node for out-of-range reads (never a variable,
    a select or a call). -/
def dfltExt : ExtNode := .Core dfltNode

/-- Read entry `r`: its variable, array id and index node (offsets
    `3r .. 3r+2`). -/
def rdV (reads : List Std.Usize) (r : Nat) : Std.Usize := reads.getD (3 * r) 0#usize
def rdA (reads : List Std.Usize) (r : Nat) : Std.Usize := reads.getD (3 * r + 1) 0#usize
def rdX (reads : List Std.Usize) (r : Nat) : Std.Usize := reads.getD (3 * r + 2) 0#usize

/-- `r` is an entry of the read table. -/
def IsRead (reads : List Std.Usize) (r : Nat) : Prop := 3 * r + 2 < reads.length

/-- Call entry `c`: its variable, function id, first argument offset and
    arity (offsets `4c .. 4c+3`). -/
def clV (calls : List Std.Usize) (c : Nat) : Std.Usize := calls.getD (4 * c) 0#usize
def clF (calls : List Std.Usize) (c : Nat) : Std.Usize := calls.getD (4 * c + 1) 0#usize
def clS (calls : List Std.Usize) (c : Nat) : Std.Usize := calls.getD (4 * c + 2) 0#usize
def clK (calls : List Std.Usize) (c : Nat) : Std.Usize := calls.getD (4 * c + 3) 0#usize

/-- `c` is an entry of the call table. -/
def IsCall (calls : List Std.Usize) (c : Nat) : Prop := 4 * c + 3 < calls.length

/-- Argument `l` of call entry `c`: a core node. -/
def clArg (calls cargs : List Std.Usize) (c l : Nat) : Std.Usize :=
  cargs.getD ((clS calls c).val + l) 0#usize

/-- Two bit ranges agree (within their tables). -/
def BitsEq (a : List Bool) (s0 : Nat) (b : List Bool) (s1 w : Nat) : Prop :=
  s0 + w ≤ a.length ∧ s1 + w ≤ b.length ∧ ∀ k < w, a.getD (s0 + k) false = b.getD (s1 + k) false

instance (a : List Bool) (s0 : Nat) (b : List Bool) (s1 w : Nat) : Decidable (BitsEq a s0 b s1 w) := by
  unfold BitsEq
  infer_instance

/-- The pure `ext_const`: the bit offset and width of extended node `x`
    when it is a constant. -/
def pExtConst (e : List ExtNode) (x : Nat) : Option (Std.Usize × Std.Usize) :=
  match e[x]? with
  | some (.Core (.Const s w)) => some (s, w)
  | _ => none

/-- Where a chain walk ends: resolved at a constant level, at the base
    read variable `cur`, or nowhere (a shape mismatch). -/
inductive WalkEnd where
  | resolved
  | base (cur : Std.Usize)
  | fail
  deriving DecidableEq

deriving instance DecidableEq for kernel.blast_kernel.DagNode

/-- The pure chain walk (`chain_walk`'s loop): `n` levels from side offset
    `off`, the current core node `cur`. -/
def pWalk (e : List ExtNode) (ebits : List Bool) (eside map : List Std.Usize)
    (t : List blast_kernel.DagNode) (j : Std.Usize) : Nat → Nat → Std.Usize → WalkEnd
  | 0, _, cur => .base cur
  | n + 1, off, cur =>
    let x := eside.getD off 0#usize
    let v := eside.getD (off + 1) 0#usize
    match pExtConst e x.val, pExtConst e j.val with
    | some (xs, xw), some (js, jw) =>
      if xw = jw ∧ BitsEq ebits xs.val ebits js.val xw.val then
        (if cur = img map v.val then .resolved else .fail)
      else pWalk e ebits eside map t j n (off + 2) cur
    | _, _ =>
      if cur.val < t.length then
        match t.getD cur.val dfltNode with
        | .Ite c tt ee =>
          if tt = img map v.val ∧ c.val < t.length ∧
              t.getD c.val dfltNode = .Eq (img map x.val) (img map j.val)
          then pWalk e ebits eside map t j n (off + 2) ee
          else .fail
        | _ => .fail
      else .fail

/-- A closed extended node against its image: a variable to the same
    variable, a constant to the same constant, an operator to the same
    operator over the images of its operands. -/
def CoreCorr (ebits tbits : List Bool) (map : List Std.Usize) (nd d : blast_kernel.DagNode) : Prop :=
  match nd with
  | .Var w => d = .Var w
  | .Const s0 w => ∃ s1, d = .Const s1 w ∧
      ∀ j < w.val, ebits.getD (s0.val + j) false = tbits.getD (s1.val + j) false
  | _ => pMapNode map nd = d

theorem CoreCorr_var (ebits tbits : List Bool) (map : List Std.Usize) (w : Std.Usize)
    (d : blast_kernel.DagNode) : CoreCorr ebits tbits map (.Var w) d ↔ d = .Var w := Iff.rfl

theorem CoreCorr_const (ebits tbits : List Bool) (map : List Std.Usize) (s0 w : Std.Usize)
    (d : blast_kernel.DagNode) : CoreCorr ebits tbits map (.Const s0 w) d ↔ ∃ s1, d = .Const s1 w ∧
      ∀ j < w.val, ebits.getD (s0.val + j) false = tbits.getD (s1.val + j) false := Iff.rfl

theorem CoreCorr_op (ebits tbits : List Bool) (map : List Std.Usize) (nd d : blast_kernel.DagNode)
    (hop : IsOp nd) : CoreCorr ebits tbits map nd d ↔ pMapNode map nd = d := by
  obtain ⟨hnv, hnc⟩ := hop
  cases nd <;> first
    | exact absurd rfl (hnv _)
    | exact absurd rfl (hnc _ _)
    | exact Iff.rfl

/-- Extended select `i` reaches read entry `r`: its chain walk from its
    image ends at the entry's variable, and the entry is registered for
    the select's array at the image of its index. -/
def SelMapsTo (e : List ExtNode) (ebits : List Bool) (eside map : List Std.Usize)
    (t : List blast_kernel.DagNode) (reads : List Std.Usize) (i r : Nat) : Prop :=
  ∃ aid j s k, i < e.length ∧ e.getD i dfltExt = .Select aid j s k ∧ img map i ≠ NONE ∧
    pWalk e ebits eside map t j k.val s.val (img map i) = .base (rdV reads r) ∧
    IsRead reads r ∧ rdA reads r = aid ∧ rdX reads r = img map j.val

/-- Extended call `i` reaches call entry `c`: its image is the entry's
    variable (of the call's width), for the call's function and arity,
    over the images of its arguments. -/
def CallMapsTo (e : List ExtNode) (eside map : List Std.Usize) (t : List blast_kernel.DagNode)
    (calls cargs : List Std.Usize) (i c : Nat) : Prop :=
  ∃ fid w s k, i < e.length ∧ e.getD i dfltExt = .Call fid w s k ∧ img map i ≠ NONE ∧
    IsCall calls c ∧ clV calls c = img map i ∧ t.getD (img map i).val dfltNode = .Var w ∧
    clF calls c = fid ∧ clK calls c = k ∧
    ∀ l < k.val, img map (eside.getD (s.val + l) 0#usize).val = clArg calls cargs c l

/-- What the main loop establishes about a mapped extended node `i`. -/
def ExtNodeCorr (e : List ExtNode) (ebits : List Bool) (eside map : List Std.Usize)
    (t : List blast_kernel.DagNode) (tbits : List Bool) (reads calls cargs : List Std.Usize)
    (i : Nat) : Prop :=
  match e.getD i dfltExt with
  | .Core nd => CoreCorr ebits tbits map nd (t.getD (img map i).val dfltNode)
  | .Select _ j s k =>
    pWalk e ebits eside map t j k.val s.val (img map i) = .resolved ∨
    ∃ r, SelMapsTo e ebits eside map t reads i r
  | .Call _ _ _ _ => ∃ c, CallMapsTo e eside map t calls cargs i c

/-- Extended node `u` is a variable mapped to core node `m`. -/
def ExtVarImg (e : List ExtNode) (map : List Std.Usize) (u m : Nat) : Prop :=
  u < e.length ∧ (∃ w, e.getD u dfltExt = .Core (.Var w)) ∧ img map u ≠ NONE ∧ (img map u).val = m

/-- The read table, validated: every entry's variable is a BV8 core
    variable, its index a BV32 core node, no two entries share `(array,
    index)`, no two share a variable. -/
structure ReadTable (reads : List Std.Usize) (t : List blast_kernel.DagNode) (ws1 : List Nat) :
    Prop where
  len3 : reads.length % 3 = 0
  var_lt : ∀ r, IsRead reads r → (rdV reads r).val < t.length
  var_node : ∀ r, IsRead reads r → t.getD (rdV reads r).val dfltNode = .Var 8#usize
  idx_lt : ∀ r, IsRead reads r → (rdX reads r).val < t.length
  idx_w : ∀ r, IsRead reads r → ws1.getD (rdX reads r).val 0 = 32
  nodup : ∀ r r', IsRead reads r → r' < r → ¬ (rdA reads r' = rdA reads r ∧ rdX reads r' = rdX reads r)
  var_inj : ∀ r r', IsRead reads r → IsRead reads r' → rdV reads r = rdV reads r' → r = r'

/-- The call table, validated. -/
structure CallTable (calls cargs : List Std.Usize) (t : List blast_kernel.DagNode) : Prop where
  len4 : calls.length % 4 = 0
  var_lt : ∀ c, IsCall calls c → (clV calls c).val < t.length
  var_node : ∀ c, IsCall calls c → ∃ w, t.getD (clV calls c).val dfltNode = .Var w
  args_rng : ∀ c, IsCall calls c → (clS calls c).val + (clK calls c).val ≤ cargs.length
  args_lt : ∀ c, IsCall calls c → ∀ l < (clK calls c).val, (clArg calls cargs c l).val < t.length
  nodup : ∀ c c', IsCall calls c → c' < c → ¬ (clF calls c' = clF calls c ∧ clK calls c' = clK calls c ∧
    ∀ l < (clK calls c).val, clArg calls cargs c' l = clArg calls cargs c l)
  var_inj : ∀ c c', IsCall calls c → IsCall calls c' → clV calls c = clV calls c' → c = c'

/- ══════════════════ THE TOTAL HELPERS ══════════════════ -/

theorem bits_eq_loop_iff (tbits : Slice Bool) (s0 : Std.Usize) (bits : Slice Bool)
    (s1 w j : Std.Usize)
    (h0 : s0.val + w.val ≤ tbits.val.length) (h1 : s1.val + w.val ≤ bits.val.length)
    (hinv : j.val ≤ w.val ∧ ∀ k < j.val,
      tbits.val.getD (s0.val + k) false = bits.val.getD (s1.val + k) false) :
    kernel.bits_eq_loop tbits s0 bits s1 w j ⦃ r => r = true ↔
      ∀ k < w.val, tbits.val.getD (s0.val + k) false = bits.val.getD (s1.val + k) false ⦄ := by
  unfold kernel.bits_eq_loop
  apply loop.spec_decr_nat
    (measure := fun (j : Std.Usize) => w.val - j.val)
    (inv := fun (j : Std.Usize) => j.val ≤ w.val ∧ ∀ k < j.val,
      tbits.val.getD (s0.val + k) false = bits.val.getD (s1.val + k) false)
  · rintro j1 ⟨hle, hk⟩
    unfold kernel.bits_eq_loop.body
    try dsimp only
    split
    · rename_i hlt
      have hjl : j1.val < w.val := by scalar_tac
      step as ⟨i, hi⟩
      have hi' : i.val < tbits.val.length := by scalar_tac
      step as ⟨b, hb⟩
      step as ⟨i1, hi1⟩
      have hi1' : i1.val < bits.val.length := by scalar_tac
      step as ⟨b1, hb1⟩
      have hbv : tbits.val.getD (s0.val + j1.val) false = b := by
        rw [← hi, getD_eq_getElem_of_lt hi', hb]
      have hb1v : bits.val.getD (s1.val + j1.val) false = b1 := by
        rw [← hi1, getD_eq_getElem_of_lt hi1', hb1]
      split
      · rename_i hne
        have hne' : b ≠ b1 := by simpa using hne
        try simp only [WP.spec_ok]
        constructor
        · intro h; cases h
        · intro h
          exfalso
          apply hne'
          rw [← hbv, ← hb1v]
          exact h j1.val hjl
      · rename_i hne
        have hne' : b = b1 := by simpa using hne
        step as ⟨j2, hj2⟩
        and_intros
        · scalar_tac
        · intro k hk'
          rw [hj2] at hk'
          rcases Nat.lt_or_ge k j1.val with h | h
          · exact hk k h
          · have : k = j1.val := by omega
            subst this
            rw [hbv, hb1v, hne']
        · scalar_tac
    · rename_i hge
      try simp only [WP.spec_ok]
      constructor
      · intro _ k hk'
        exact hk k (by scalar_tac)
      · intro _; trivial
  · exact hinv

/-- `bits_eq` decides `BitsEq` exactly. -/
theorem bits_eq_iff (tbits : Slice Bool) (s0 : Std.Usize) (bits : Slice Bool) (s1 w : Std.Usize) :
    kernel.bits_eq tbits s0 bits s1 w ⦃ r => r = true ↔
      BitsEq tbits.val s0.val bits.val s1.val w.val ⦄ := by
  unfold kernel.bits_eq
  try dsimp only
  split
  · rename_i hs0
    try simp only [WP.spec_ok]
    constructor
    · intro h; cases h
    · intro h; exfalso; unfold BitsEq at h; scalar_tac
  · rename_i hs0
    step as ⟨i2, hi2⟩
    split
    · rename_i hw0
      try simp only [WP.spec_ok]
      constructor
      · intro h; cases h
      · intro h; exfalso; unfold BitsEq at h; scalar_tac
    · rename_i hw0
      split
      · rename_i hs1
        try simp only [WP.spec_ok]
        constructor
        · intro h; cases h
        · intro h; exfalso; unfold BitsEq at h; scalar_tac
      · rename_i hs1
        step as ⟨i5, hi5⟩
        split
        · rename_i hw1
          try simp only [WP.spec_ok]
          constructor
          · intro h; cases h
          · intro h; exfalso; unfold BitsEq at h; scalar_tac
        · rename_i hw1
          have h0 : s0.val + w.val ≤ tbits.val.length := by scalar_tac
          have h1 : s1.val + w.val ≤ bits.val.length := by scalar_tac
          apply WP.spec_mono (bits_eq_loop_iff tbits s0 bits s1 w 0#usize h0 h1
            ⟨by simp, fun k hk => by simp at hk⟩)
          intro r hr
          rw [hr]
          unfold BitsEq
          constructor
          · intro h; exact ⟨h0, h1, h⟩
          · intro h; exact h.2.2

theorem bits_eq_eq (tbits : Slice Bool) (s0 : Std.Usize) (bits : Slice Bool) (s1 w : Std.Usize) :
    kernel.bits_eq tbits s0 bits s1 w = ok (decide (BitsEq tbits.val s0.val bits.val s1.val w.val)) := by
  obtain ⟨r, hr, hP⟩ := WP.spec_imp_exists (bits_eq_iff tbits s0 bits s1 w)
  rw [hr]
  cases r with
  | true => rw [decide_eq_true (hP.mp rfl)]
  | false =>
    have : ¬ BitsEq tbits.val s0.val bits.val s1.val w.val := fun h => by simpa using hP.mpr h
    rw [decide_eq_false this]

theorem ext_const_eq (e : Slice ExtNode) (x : Std.Usize) :
    kernel.sliver_kernel.ext_const e x = ok (match pExtConst e.val x.val with
      | some (s, w) => (true, s, w)
      | none => (false, 0#usize, 0#usize)) := by
  unfold kernel.sliver_kernel.ext_const
  try dsimp only
  split
  · rename_i hlt
    have hlt' : x.val < e.val.length := by scalar_tac
    obtain ⟨en, hen, hP⟩ := WP.spec_imp_exists (Slice.index_usize_spec e x hlt')
    rw [hen]
    simp only [bind_tc_ok]
    rw [hP]
    unfold pExtConst
    rw [List.getElem?_eq_getElem hlt']
    cases hn : e.val[x.val] with
    | Core nd =>
      simp only [node_tag_eq, node_f1_eq, node_f2_eq, bind_tc_ok]
      cases nd <;> simp [pTag, pF1, pF2]
    | Select _ _ _ _ => simp
    | Call _ _ _ _ => simp
  · rename_i hge
    have hge' : e.val.length ≤ x.val := by scalar_tac
    unfold pExtConst
    rw [List.getElem?_eq_none hge']

theorem read_class_eq (c : Std.Usize) :
    kernel.sliver_kernel.read_class c = ok (decide (c = 2#usize ∨ c = 4#usize)) := by
