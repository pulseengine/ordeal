  · rename_i h; simp [h]

/-- What `base_read_ok` establishes: `cur` is a core node of read class
    whose registered entry (`ent`) is for `(aid, xj)`. -/
theorem base_read_ok_spec (t : Slice blast_kernel.DagNode) (reads cls ent : Slice Std.Usize)
    (aid xj cur : Std.Usize) (hcls : cls.val.length = t.val.length)
    (hent : ent.val.length = t.val.length) :
    kernel.sliver_kernel.base_read_ok t reads cls ent aid xj cur ⦃ r => r = true →
      cur.val < t.val.length ∧
      (cls.val.getD cur.val 0#usize = 2#usize ∨ cls.val.getD cur.val 0#usize = 4#usize) ∧
      (ent.val.getD cur.val 0#usize).val + 2 < reads.val.length ∧
      reads.val.getD ((ent.val.getD cur.val 0#usize).val + 1) 0#usize = aid ∧
      reads.val.getD ((ent.val.getD cur.val 0#usize).val + 2) 0#usize = xj ⦄ := by
  unfold kernel.sliver_kernel.base_read_ok
  try dsimp only
  split
  · simp
  · rename_i hlt
    have hlt' : cur.val < cls.val.length := by scalar_tac
    have hlt'' : cur.val < ent.val.length := by scalar_tac
    step as ⟨c, hc⟩
    rw [read_class_eq]
    simp only [bind_tc_ok]
    split
    · rename_i hlive
      have hlive' : c = 2#usize ∨ c = 4#usize := by simpa using hlive
      step as ⟨o, ho⟩
      split
      · rename_i holt
        step as ⟨i4, hi4⟩
        split
        · rename_i h3
          step as ⟨i5, hi5⟩
          have hi5' : i5.val < reads.val.length := by scalar_tac
          step as ⟨i6, hi6⟩
          split
          · rename_i haid
            step as ⟨i7, hi7⟩
            have hi7' : i7.val < reads.val.length := by scalar_tac
            step as ⟨i8, hi8⟩
            try simp only [WP.spec_ok]
            intro hxj
            have hxj' : i8 = xj := by simpa using hxj
            have hcg : cls.val.getD cur.val 0#usize = c := by
              rw [getD_eq_getElem_of_lt hlt', hc]
            have hog : ent.val.getD cur.val 0#usize = o := by
              rw [getD_eq_getElem_of_lt hlt'', ho]
            refine ⟨by scalar_tac, by rw [hcg]; exact hlive', ?_, ?_, ?_⟩
            · rw [hog]; scalar_tac
            · rw [hog, ← hi5, getD_eq_getElem_of_lt hi5', ← hi6]
              exact haid
            · rw [hog, ← hi7, getD_eq_getElem_of_lt hi7', ← hi8]
              exact hxj'
          · simp
        · simp
      · simp
    · simp

/-- A placeholder for an accepted `implication_shape`: the root is
    `Or(Not(a), Eq(vp, vq))`. -/
def ImplShape (t : List blast_kernel.DagNode) (root vp vq a : Std.Usize) : Prop :=
  root.val < t.length ∧ ∃ nn c, t.getD root.val dfltNode = .BoolOr nn c ∧ c.val < t.length ∧
    t.getD c.val dfltNode = .Eq vp vq ∧ nn.val < t.length ∧ t.getD nn.val dfltNode = .Not a

theorem implication_shape_spec (t : Slice blast_kernel.DagNode) (root vp vq : Std.Usize) :
    kernel.sliver_kernel.implication_shape t root vp vq ⦃ a =>
      a ≠ NONE → ImplShape t.val root vp vq a ⦄ := by
  unfold kernel.sliver_kernel.implication_shape
  try dsimp only
  simp only [node_tag_eq, node_f1_eq, node_f2_eq, bind_tc_ok]
  split
  · simp
  · rename_i hlt
    have hlt' : root.val < t.val.length := by scalar_tac
    step as ⟨d, hd⟩
    split
    · simp
    · rename_i htag
      have htag' : pTag d = pTag (.BoolOr 0#usize 0#usize) := UScalar.eq_of_val_eq (by simpa using htag)
      split
      · simp
      · rename_i hclt
        have hclt' : (pF2 d).val < t.val.length := by scalar_tac
        step as ⟨dn, hdn⟩
        obtain ⟨b, hb⟩ := node_eq_ok dn (.Eq vp vq)
        rw [hb]
        simp only [bind_tc_ok]
        split
        · rename_i hbt
          subst hbt
          have hdn' := node_eq_sound _ _ hb
          split
          · simp
          · rename_i hnlt
            have hnlt' : (pF1 d).val < t.val.length := by scalar_tac
            step as ⟨dn1, hdn1⟩
            split
            · simp
            · rename_i htag1
              have htag1' : pTag dn1 = pTag (.Not 0#usize) := UScalar.eq_of_val_eq (by simpa using htag1)
              simp only [WP.spec_ok]
              intro _
              cases d <;> simp [pTag] at htag'
              rename_i nn c
              cases dn1 <;> simp [pTag] at htag1'
              rename_i a
              simp only [pF1, pF2] at hclt' hnlt' hdn hdn1 ⊢
              refine ⟨hlt', nn, c, by rw [getD_eq_getElem_of_lt hlt', hd], hclt', ?_, hnlt', ?_⟩
              · rw [getD_eq_getElem_of_lt hclt', ← hdn, hdn']
              · rw [getD_eq_getElem_of_lt hnlt', ← hdn1]
        · simp

/-- Two constant core nodes with different widths or unequal bits. -/
def ConstUnequal (t : List blast_kernel.DagNode) (tbits : List Bool) (a b : Nat) : Prop :=
  a < t.length ∧ b < t.length ∧ ∃ sa wa sb wb, t.getD a dfltNode = .Const sa wa ∧
    t.getD b dfltNode = .Const sb wb ∧ ¬ (wa = wb ∧ BitsEq tbits sa.val tbits sb.val wa.val)

theorem const_pair_unequal_spec (t : Slice blast_kernel.DagNode) (tbits : Slice Bool)
    (a b : Std.Usize) :
    kernel.sliver_kernel.const_pair_unequal t tbits a b ⦃ r =>
      r = true ↔ ConstUnequal t.val tbits.val a.val b.val ⦄ := by
  unfold kernel.sliver_kernel.const_pair_unequal
  try dsimp only
  split
  · rename_i hge
    try simp only [WP.spec_ok]
    constructor
    · intro h; cases h
    · intro h; exfalso; have := h.1; scalar_tac
  · rename_i hlt
    have hlt' : a.val < t.val.length := by scalar_tac
    split
    · rename_i hge
      try simp only [WP.spec_ok]
      constructor
      · intro h; cases h
      · intro h; exfalso; have := h.2.1; scalar_tac
    · rename_i hltb
      have hltb' : b.val < t.val.length := by scalar_tac
      step as ⟨da, hda⟩
      step as ⟨db, hdb⟩
      simp only [node_tag_eq, bind_tc_ok]
      have hga : t.val.getD a.val dfltNode = da := by rw [getD_eq_getElem_of_lt hlt', hda]
      have hgb : t.val.getD b.val dfltNode = db := by rw [getD_eq_getElem_of_lt hltb', hdb]
      split
      · rename_i hta
        have hta' : pTag da ≠ 1#usize := by simpa using hta
        try simp only [WP.spec_ok]
        constructor
        · intro h; cases h
        · rintro ⟨_, _, sa, wa, sb, wb, ha, hb, _⟩
          exfalso
          apply hta'
          rw [hga] at ha
          rw [ha]
          rfl
      · rename_i hta
        have hta' : pTag da = 1#usize := UScalar.eq_of_val_eq (by simpa using hta)
        obtain ⟨sa, wa, hda'⟩ := (pTag_eq_one da).mp hta'
        split
        · rename_i htb
          have htb' : pTag db ≠ 1#usize := by simpa using htb
          try simp only [WP.spec_ok]
          constructor
          · intro h; cases h
          · rintro ⟨_, _, sa', wa', sb, wb, ha, hb, _⟩
            exfalso
            apply htb'
            rw [hgb] at hb
            rw [hb]
            rfl
        · rename_i htb
          have htb' : pTag db = 1#usize := UScalar.eq_of_val_eq (by simpa using htb)
          obtain ⟨sb, wb, hdb'⟩ := (pTag_eq_one db).mp htb'
          simp only [node_f2_eq, node_f1_eq, bind_tc_ok]
          subst hda' hdb'
          simp only [pF1, pF2]
          split
          · rename_i hw
            subst hw
            rw [bits_eq_eq]
            simp only [bind_tc_ok, WP.spec_ok]
            constructor
            · intro h
              refine ⟨hlt', hltb', sa, wa, sb, wa, hga, hgb, ?_⟩
              intro hc
              have := hc.2
              simp at h
              exact h this
            · rintro ⟨_, _, sa', wa', sb', wb', ha, hb, hne⟩
              rw [hga] at ha
              rw [hgb] at hb
              cases ha; cases hb
              simp only [not_and, true_implies] at hne
              simpa using hne
          · rename_i hw
            try simp only [WP.spec_ok]
            constructor
            · intro _
              exact ⟨hlt', hltb', sa, wa, sb, wb, hga, hgb, fun h => hw h.1⟩
            · intro _; trivial

/-- The invariant of `read_dup`'s loop: no entry before `off` matches. -/
def ReadDupInv (reads : List Std.Usize) (aid idx : Std.Usize) (st : Std.Usize × Bool) : Prop :=
  st.1.val % 3 = 0 ∧ (st.2 = false → ∀ r, 3 * r < st.1.val →
    ¬ (rdA reads r = aid ∧ rdX reads r = idx))

theorem read_dup_loop_spec (reads : Slice Std.Usize) (upto aid idx off : Std.Usize) (found : Bool)
    (hupto : upto.val ≤ reads.val.length) (h3 : upto.val % 3 = 0)
    (hinv : ReadDupInv reads.val aid idx (off, found)) :
    kernel.sliver_kernel.read_dup_loop reads upto aid idx off found ⦃ r => r = false →
      ∀ r', 3 * r' < upto.val → ¬ (rdA reads.val r' = aid ∧ rdX reads.val r' = idx) ⦄ := by
  unfold kernel.sliver_kernel.read_dup_loop
  apply loop.spec_decr_nat
    (measure := fun (st : Std.Usize × Bool) => upto.val - st.1.val)
    (inv := ReadDupInv reads.val aid idx)
  · rintro ⟨off1, found1⟩ ⟨hmod, hf⟩
    dsimp only at hmod hf
    unfold kernel.sliver_kernel.read_dup_loop.body
    try dsimp only
    split
    · rename_i hft
      try simp only [WP.spec_ok]
      intro h; cases h
    · rename_i hff
      have hff' : found1 = false := by simpa using hff
      have hall := hf hff'
      split
      · rename_i hlt
        have hlt'' : off1.val < upto.val := by scalar_tac
        have hlt' : off1.val + 2 < reads.val.length := by omega
        step as ⟨i, hi⟩
        have hi' : i.val < reads.val.length := by scalar_tac
        step as ⟨i1, hi1⟩
        have hr : rdA reads.val (off1.val / 3) = i1 := by
          unfold rdA
          have : 3 * (off1.val / 3) + 1 = i.val := by omega
          rw [this, getD_eq_getElem_of_lt hi', hi1]
        have hstep : ∀ (found2 : Bool) (off2 : Std.Usize), off2.val = off1.val + 3 →
            (found2 = false → ¬ (rdA reads.val (off1.val / 3) = aid ∧ rdX reads.val (off1.val / 3) = idx)) →
            ReadDupInv reads.val aid idx (off2, found2) ∧ upto.val - off2.val < upto.val - off1.val := by
          intro found2 off2 hoff2 h2
          refine ⟨⟨by simp only; omega, ?_⟩, by omega⟩
          intro hf2 r hr3
          simp only at hr3
          rw [hoff2] at hr3
          rcases Nat.lt_or_ge (3 * r) off1.val with h | h
          · exact hall r h
          · have : r = off1.val / 3 := by omega
            subst this
            exact h2 hf2
        split
        · rename_i haid
          step as ⟨i2, hi2⟩
          have hi2' : i2.val < reads.val.length := by scalar_tac
          step as ⟨i3, hi3⟩
          have hx : rdX reads.val (off1.val / 3) = i3 := by
            unfold rdX
            have : 3 * (off1.val / 3) + 2 = i2.val := by omega
            rw [this, getD_eq_getElem_of_lt hi2', hi3]
          split
          · rename_i hidx
            simp only [bind_tc_ok]
            step as ⟨off2, hoff2⟩
            apply hstep _ _ hoff2
            intro h; cases h
          · rename_i hidx
            simp only [bind_tc_ok]
            step as ⟨off2, hoff2⟩
            apply hstep _ _ hoff2
            intro _ hc
            apply hidx
            rw [← hx]
            exact hc.2
        · rename_i haid
          simp only [bind_tc_ok]
          step as ⟨off2, hoff2⟩
          apply hstep _ _ hoff2
          intro _ hc
          apply haid
          rw [← hr]
          exact hc.1
      · rename_i hge
