  apply WP.spec_mono (dead_entry_loop_spec cls (Slice.len cls) (Slice.len cls) 0#usize (by simp)
    ⟨by simp, by simp, fun _ m hm => by simp at hm⟩)
  intro r hr
  refine ⟨by simpa using hr.1, fun hlen => ?_⟩
  apply hr.2
  apply UScalar.eq_of_val_eq
  simpa using hlen

theorem ext_roots_corr_loop_spec (eroots map troots : Slice Std.Usize) (m : Std.Usize) (ok1 : Bool)
    (k : Std.Usize) (hm : m.val = eroots.val.length) (hlen : eroots.val.length ≤ troots.val.length)
    (hinv : k.val ≤ m.val ∧ (ok1 = true → RootsCorr eroots.val map.val troots.val k.val)) :
    kernel.sliver_kernel.ext_roots_corr_loop eroots map troots m ok1 k ⦃ r => r = true →
      RootsCorr eroots.val map.val troots.val eroots.val.length ⦄ := by
  unfold kernel.sliver_kernel.ext_roots_corr_loop
  apply loop.spec_decr_nat
    (measure := fun (s : Bool × Std.Usize) => m.val - s.2.val)
    (inv := fun (s : Bool × Std.Usize) => s.2.val ≤ m.val ∧
      (s.1 = true → RootsCorr eroots.val map.val troots.val s.2.val))
  · rintro ⟨ok2, k1⟩ ⟨hle, hrc⟩
    dsimp only at hle hrc
    unfold kernel.sliver_kernel.ext_roots_corr_loop.body
    try dsimp only
    split
    · rename_i hok
      split
      · rename_i hlt
        have hkl : k1.val < eroots.val.length := by scalar_tac
        step as ⟨r, hr⟩
        rw [map_at_eq]
        simp only [bind_tc_ok]
        split
        · rename_i hmax
          step as ⟨k2, hk2⟩
          and_intros
          · scalar_tac
          · intro h; simp at h
          · scalar_tac
        · rename_i hmax
          have hkr : k1.val < troots.val.length := by omega
          step as ⟨rk, hrk⟩
          split
          · rename_i hne
            step as ⟨k2, hk2⟩
            and_intros
            · scalar_tac
            · intro h; simp at h
            · scalar_tac
          · rename_i heq
            have heq' : img map.val r.val = rk := UScalar.eq_of_val_eq (by simpa using heq)
            step as ⟨k2, hk2⟩
            and_intros
            · scalar_tac
            · intro _ k' hk' hk'lt
              rw [hk2] at hk'lt
              rcases Nat.lt_or_ge k' k1.val with h | h
              · exact hrc hok k' hk' h
              · have : k' = k1.val := by omega
                subst this
                rw [← hr]
                have hrm : r.val < map.val.length := by
                  rcases Nat.lt_or_ge r.val map.val.length with h | h
                  · exact h
                  · rw [img_ge h] at hmax
                    exact absurd rfl hmax
                refine ⟨hrm, hmax, ?_⟩
                rw [heq', hrk, getD_eq_getElem_of_lt hkr]
            · scalar_tac
      · rename_i hge
        have hkeq : k1.val = eroots.val.length := by scalar_tac
        try simp only [WP.spec_ok]
        intro _
        rw [← hkeq]
        exact hrc hok
    · simp
  · exact hinv

theorem ext_roots_corr_spec (eroots map troots : Slice Std.Usize) :
    kernel.sliver_kernel.ext_roots_corr eroots map troots ⦃ r => r = true →
      eroots.val.length ≤ troots.val.length ∧
      RootsCorr eroots.val map.val troots.val eroots.val.length ⦄ := by
  unfold kernel.sliver_kernel.ext_roots_corr
  try dsimp only
  split
  · simp
  · rename_i hlen
    have hlen' : eroots.val.length ≤ troots.val.length := by scalar_tac
    apply WP.spec_mono (ext_roots_corr_loop_spec eroots map troots _ true 0#usize (by simp) hlen'
      ⟨by simp, fun _ k' _ hk' => by simp at hk'⟩)
    intro r hr ht
    exact ⟨hlen', hr ht⟩

/-- The antecedent `args_p = args_q` over arguments `0 .. l`, nested as the
    lowering nests it: `And(And(Eq(a0, b0), Eq(a1, b1)), …)`, the last
    argument's equality outermost. -/
def AnteCorr (t : List blast_kernel.DagNode) (cargs : List Std.Usize) (sp sq : Nat) :
    Nat → Std.Usize → Prop
  | 0, cur => cur.val < t.length ∧
      t.getD cur.val dfltNode = .Eq (cargs.getD sp 0#usize) (cargs.getD sq 0#usize)
  | l + 1, cur => cur.val < t.length ∧ ∃ c eq, t.getD cur.val dfltNode = .BoolAnd c eq ∧
      eq.val < t.length ∧
      t.getD eq.val dfltNode = .Eq (cargs.getD (sp + (l + 1)) 0#usize) (cargs.getD (sq + (l + 1)) 0#usize) ∧
      AnteCorr t cargs sp sq l c

theorem ante_ok_loop_spec (t : Slice blast_kernel.DagNode) (cargs : Slice Std.Usize)
    (sp sq n and_tag cur : Std.Usize) (ok1 : Bool) (l k a : Std.Usize)
    (hn : n.val = t.val.length) (htag : and_tag = pTag (.BoolAnd 0#usize 0#usize))
    (hsp : sp.val + k.val ≤ cargs.val.length) (hsq : sq.val + k.val ≤ cargs.val.length)
    (hinv : 1 ≤ l.val ∧ l.val ≤ k.val ∧ (ok1 = true →
      AnteCorr t.val cargs.val sp.val sq.val (l.val - 1) cur → AnteCorr t.val cargs.val sp.val sq.val (k.val - 1) a)) :
    kernel.sliver_kernel.ante_ok_loop t cargs sp sq n and_tag cur ok1 l ⦃ r => r.2 = true →
      AnteCorr t.val cargs.val sp.val sq.val 0 r.1 → AnteCorr t.val cargs.val sp.val sq.val (k.val - 1) a ⦄ := by
  unfold kernel.sliver_kernel.ante_ok_loop
  apply loop.spec_decr_nat
    (measure := fun (st : Std.Usize × Bool × Std.Usize) => st.2.2.val)
    (inv := fun (st : Std.Usize × Bool × Std.Usize) => 1 ≤ st.2.2.val ∧ st.2.2.val ≤ k.val ∧
      (st.2.1 = true → AnteCorr t.val cargs.val sp.val sq.val (st.2.2.val - 1) st.1 →
        AnteCorr t.val cargs.val sp.val sq.val (k.val - 1) a))
  · rintro ⟨cur1, ok2, l1⟩ ⟨h1, hle, hok⟩
    dsimp only at h1 hle hok
    unfold kernel.sliver_kernel.ante_ok_loop.body
    try dsimp only
    split
    · rename_i hokt
      have himp := hok hokt
      split
      · rename_i hlt
        have hlt' : 1 < l1.val := by scalar_tac
        step as ⟨l2, hl2⟩
        split
        · rename_i hge
          try simp only [WP.spec_ok]
          and_intros
          · scalar_tac
          · scalar_tac
          · intro h; cases h
          · scalar_tac
        · rename_i hcur
          have hcur' : cur1.val < t.val.length := by scalar_tac
          step as ⟨d, hd⟩
          rw [node_f2_eq, node_tag_eq]
          simp only [bind_tc_ok]
          split
          · rename_i hta
            try simp only [WP.spec_ok]
            and_intros
            · scalar_tac
            · scalar_tac
            · intro h; cases h
            · scalar_tac
          · rename_i hta
            have hta' : pTag d = and_tag := UScalar.eq_of_val_eq (by simpa using hta)
            split
            · rename_i heq
              try simp only [WP.spec_ok]
              and_intros
              · scalar_tac
              · scalar_tac
              · intro h; cases h
              · scalar_tac
            · rename_i heq
              have heq' : (pF2 d).val < t.val.length := by scalar_tac
              step as ⟨dn, hdn⟩
              step as ⟨i1, hi1⟩
              have hi1' : i1.val < cargs.val.length := by scalar_tac
              step as ⟨i2, hi2⟩
              step as ⟨i3, hi3⟩
              have hi3' : i3.val < cargs.val.length := by scalar_tac
              step as ⟨i4, hi4⟩
              obtain ⟨b, hb⟩ := node_eq_ok dn (.Eq i2 i4)
              rw [hb]
              simp only [bind_tc_ok]
              split
              · rename_i hbt
                subst hbt
                have hdn' := node_eq_sound _ _ hb
                rw [node_f1_eq]
                simp only [bind_tc_ok, WP.spec_ok]
                and_intros
                · scalar_tac
                · scalar_tac
                · intro _ hante
                  apply himp
                  rw [htag] at hta'
                  cases d <;> simp [pTag] at hta'
                  rename_i c eq
                  simp only [pF1, pF2] at heq' hdn hante ⊢
                  have hl1 : l1.val - 1 = (l2.val - 1) + 1 := by omega
                  rw [hl1]
                  refine ⟨hcur', c, eq, by rw [getD_eq_getElem_of_lt hcur', hd], heq', ?_, hante⟩
                  rw [getD_eq_getElem_of_lt heq', ← hdn, hdn']
                  have e1 : sp.val + (l2.val - 1 + 1) = i1.val := by omega
                  have e2 : sq.val + (l2.val - 1 + 1) = i3.val := by omega
                  rw [e1, e2, getD_eq_getElem_of_lt hi1', getD_eq_getElem_of_lt hi3', hi2, hi4]
                · scalar_tac
              · try simp only [WP.spec_ok]
                and_intros
                · scalar_tac
                · scalar_tac
                · intro h; cases h
                · scalar_tac
      · rename_i hge
        have hleq : l1.val = 1 := by scalar_tac
        try simp only [WP.spec_ok]
        intro _ h0
        apply himp
        rw [hleq]
        exact h0
    · rename_i hokf
      try simp only [WP.spec_ok]
      intro h
      simp at h
  · exact hinv

/-- `ante_ok` accepts only the nested antecedent over the `k ≥ 1`
    arguments. -/
theorem ante_ok_spec (t : Slice blast_kernel.DagNode) (cargs : Slice Std.Usize) (sp sq k a : Std.Usize)
    (hk : 1 ≤ k.val) (hsp : sp.val + k.val ≤ cargs.val.length) (hsq : sq.val + k.val ≤ cargs.val.length) :
    kernel.sliver_kernel.ante_ok t cargs sp sq k a ⦃ r => r = true →
      AnteCorr t.val cargs.val sp.val sq.val (k.val - 1) a ⦄ := by
  unfold kernel.sliver_kernel.ante_ok
  try dsimp only
  rw [node_tag_eq]
  simp only [bind_tc_ok]
  step with (ante_ok_loop_spec t cargs sp sq (Slice.len t) _ a true k k a (by simp) rfl hsp hsq
    ⟨hk, le_rfl, fun _ h => h⟩) as ⟨cur, ok1, hr⟩
  try dsimp only at hr
  split
  · rename_i hokt
    split
    · rename_i hcur
      have hcur' : cur.val < t.val.length := by scalar_tac
      have hsp' : sp.val < cargs.val.length := by omega
      have hsq' : sq.val < cargs.val.length := by omega
      step as ⟨dn, hdn⟩
      step as ⟨i, hi⟩
      step as ⟨i1, hi1⟩
      obtain ⟨b, hb⟩ := node_eq_ok dn (.Eq i i1)
      rw [hb]
      simp only [WP.spec_ok]
      intro hbt
      subst hbt
      have hdn' := node_eq_sound _ _ hb
      apply hr hokt
      refine ⟨hcur', ?_⟩
      rw [getD_eq_getElem_of_lt hcur', ← hdn, hdn', getD_eq_getElem_of_lt hsp',
        getD_eq_getElem_of_lt hsq', hi, hi1]
    · simp
  · simp

/- ══════════════════ THE CHAIN WALK ══════════════════ -/

theorem ext_const_spec (e : Slice ExtNode) (x : Std.Usize) :
    kernel.sliver_kernel.ext_const e x ⦃ r => match pExtConst e.val x.val with
      | some (s, w) => r = (true, s, w)
      | none => r = (false, 0#usize, 0#usize) ⦄ := by
  rw [ext_const_eq]
  simp only [WP.spec_ok]
  cases pExtConst e.val x.val with
  | none => rfl
  | some p => obtain ⟨s, w⟩ := p; rfl

theorem node_eq_refl (a : blast_kernel.DagNode) : kernel.node_eq a a = ok true := by
  unfold kernel.node_eq
  simp only [node_tag_eq, node_f1_eq, node_f2_eq, node_f3_eq, bind_tc_ok]
  simp

/-- One level of the pure walk at two constant indices. -/
theorem pWalk_succ_const (e : List ExtNode) (ebits : List Bool) (eside map : List Std.Usize)
    (t : List blast_kernel.DagNode) (j : Std.Usize) (n off : Nat) (cur : Std.Usize)
    (xs xw js jw : Std.Usize)
    (hx : pExtConst e (eside.getD off 0#usize).val = some (xs, xw))
    (hj : pExtConst e j.val = some (js, jw)) :
    pWalk e ebits eside map t j (n + 1) off cur
      = if xw = jw ∧ BitsEq ebits xs.val ebits js.val xw.val then
          (if cur = img map (eside.getD (off + 1) 0#usize).val then .resolved else .fail)
        else pWalk e ebits eside map t j n (off + 2) cur := by
  simp only [pWalk, hx, hj]

/-- One level of the pure walk when an index is not a constant. -/
theorem pWalk_succ_nconst (e : List ExtNode) (ebits : List Bool) (eside map : List Std.Usize)
    (t : List blast_kernel.DagNode) (j : Std.Usize) (n off : Nat) (cur : Std.Usize)
    (h : pExtConst e (eside.getD off 0#usize).val = none ∨ pExtConst e j.val = none) :
    pWalk e ebits eside map t j (n + 1) off cur
      = if cur.val < t.length then
          match t.getD cur.val dfltNode with
          | .Ite c tt ee =>
            if tt = img map (eside.getD (off + 1) 0#usize).val ∧ c.val < t.length ∧
                t.getD c.val dfltNode = .Eq (img map (eside.getD off 0#usize).val) (img map j.val)
            then pWalk e ebits eside map t j n (off + 2) ee
            else .fail
          | _ => .fail
        else .fail := by
  rcases h with h | h
  · simp only [pWalk, h]
  · simp only [pWalk, h]
    cases pExtConst e (eside.getD off 0#usize).val <;> rfl

theorem walk_ite_red (e : List ExtNode) (ebits : List Bool) (eside map : List Std.Usize)
    (t : List blast_kernel.DagNode) (j : Std.Usize) (n off vv xx : Nat) (c tt ee : Std.Usize) :
    (match blast_kernel.DagNode.Ite c tt ee with
      | .Ite c tt ee =>
        if tt = img map vv ∧ c.val < t.length ∧
            t.getD c.val dfltNode = blast_kernel.DagNode.Eq (img map xx) (img map j.val)
        then pWalk e ebits eside map t j n (off + 2) ee
        else WalkEnd.fail
      | _ => WalkEnd.fail)
    = if tt = img map vv ∧ c.val < t.length ∧
          t.getD c.val dfltNode = blast_kernel.DagNode.Eq (img map xx) (img map j.val)
      then pWalk e ebits eside map t j n (off + 2) ee
      else WalkEnd.fail := by
  rfl

theorem walk_nite_red (e : List ExtNode) (ebits : List Bool) (eside map : List Std.Usize)
    (t : List blast_kernel.DagNode) (j : Std.Usize) (n off vv xx : Nat) (d : blast_kernel.DagNode)
    (hd : pTag d ≠ pTag (.Ite 0#usize 0#usize 0#usize)) :
    (match (generalizing := false) d with
      | .Ite c tt ee =>
        if tt = img map vv ∧ c.val < t.length ∧
            t.getD c.val dfltNode = blast_kernel.DagNode.Eq (img map xx) (img map j.val)
        then pWalk e ebits eside map t j n (off + 2) ee
        else WalkEnd.fail
      | _ => WalkEnd.fail) = WalkEnd.fail := by
  cases d <;> first | rfl | exact absurd rfl hd

/-- The invariant of `chain_walk`'s loop against the pure walk `W` of the
    whole chain (`k` levels from `s`, from the image `k0`). -/
def WalkInv (W : Nat → Nat → Std.Usize → WalkEnd) (k s : Nat) (k0 : Std.Usize)
    (st : Std.Usize × Bool × Bool × Std.Usize × Std.Usize) : Prop :=
  st.2.2.2.1.val ≤ k ∧
  (st.2.1 = true → st.2.2.2.2.val = s + 2 * st.2.2.2.1.val ∧
    (st.2.2.1 = false → W k s k0 = W (k - st.2.2.2.1.val) st.2.2.2.2.val st.1) ∧
    (st.2.2.1 = true → W k s k0 = .resolved)) ∧
  (st.2.1 = false → W k s k0 = .fail)

/-- What the walk's result means. -/
def WalkPost (W : Nat → Nat → Std.Usize → WalkEnd) (k s : Nat) (k0 : Std.Usize)
    (r : Std.Usize × Bool × Bool) : Prop :=
  (r.2.1 = true → r.2.2 = true → W k s k0 = .resolved) ∧
  (r.2.1 = true → r.2.2 = false → W k s k0 = .base r.1) ∧
  (r.2.1 = false → W k s k0 = .fail)

/-- One level of the walk re-establishes the invariant. -/
theorem walkInv_step (W : Nat → Nat → Std.Usize → WalkEnd) (k s : Nat)
    (k0 cur off1 l1 cur1 off2 l2 : Std.Usize) (ok2 done2 : Bool)
    (hl : l1.val < k) (hoff : off1.val = s + 2 * l1.val)
    (hW : W k s k0 = W (k - l1.val) off1.val cur) (hl2 : l2.val = l1.val + 1)
    (hoff2 : off2.val = off1.val + 2)
    (hstep : (ok2 = true → done2 = false → W (k - l1.val) off1.val cur = W (k - l2.val) off2.val cur1) ∧
      (ok2 = true → done2 = true → W (k - l1.val) off1.val cur = .resolved) ∧
      (ok2 = false → W (k - l1.val) off1.val cur = .fail)) :
    WalkInv W k s k0 (cur1, ok2, done2, l2, off2) ∧ k - l2.val < k - l1.val := by
  obtain ⟨h1, h2, h3⟩ := hstep
  unfold WalkInv
  refine ⟨⟨(by simp only; omega), ⟨?_, ?_⟩⟩, (by omega)⟩
  · intro hok
    refine ⟨(by simp only; omega), ⟨?_, ?_⟩⟩
    · intro hd
      simp only
      rw [hW]
      exact h1 hok hd
    · intro hd
      rw [hW]
      exact h2 hok hd
  · intro hok
    rw [hW]
    exact h3 hok

theorem chain_walk_loop_spec (e : Slice ExtNode) (ebits : Slice Bool) (eside map : Slice Std.Usize)
    (t : Slice blast_kernel.DagNode) (j k n ite_tag cur : Std.Usize) (ok1 done1 : Bool)
    (l off s k0 : Std.Usize) (hn : n.val = t.val.length)
    (htag : ite_tag = pTag (.Ite 0#usize 0#usize 0#usize))
    (hlev : ∀ l' < k.val, s.val + 2 * l' + 1 < eside.val.length)
    (hinv : WalkInv (pWalk e.val ebits.val eside.val map.val t.val j) k.val s.val k0
      (cur, ok1, done1, l, off)) :
    kernel.sliver_kernel.chain_walk_loop e ebits eside map t j k n ite_tag cur ok1 done1 l off ⦃ r =>
      WalkPost (pWalk e.val ebits.val eside.val map.val t.val j) k.val s.val k0 r ⦄ := by
  unfold kernel.sliver_kernel.chain_walk_loop
  apply loop.spec_decr_nat
    (measure := fun (st : Std.Usize × Bool × Bool × Std.Usize × Std.Usize) => k.val - st.2.2.2.1.val)
    (inv := WalkInv (pWalk e.val ebits.val eside.val map.val t.val j) k.val s.val k0)
  · rintro ⟨cur1, ok2, done2, l1, off1⟩ ⟨hle, hok, hnok⟩
    dsimp only at hle hok hnok
    unfold kernel.sliver_kernel.chain_walk_loop.body
    try dsimp only
    split
    · rename_i hokt
      obtain ⟨hoff, hW, hWd⟩ := hok hokt
      split
      · rename_i hdt
        rw [WP.spec_ok]
        unfold WalkPost
        exact ⟨fun _ _ => hWd hdt, ⟨fun _ h => (by cases h), fun h => (by cases h)⟩⟩
      · rename_i hdf
        have hdf' : done2 = false := by simpa using hdf
        have hWc := hW hdf'
        split
        · rename_i hlt
          have hlt' : l1.val < k.val := by scalar_tac
          have hrng := hlev l1.val hlt'
          have hoffl : off1.val + 1 < eside.val.length := by omega
          have hcap : off1.val + 2 ≤ Usize.max := by
            have := eside.length_ineq
            omega
          step as ⟨x, hx⟩
          step as ⟨i, hi⟩
          have hil : i.val < eside.val.length := by scalar_tac
          step as ⟨v, hv⟩
          have hxg : eside.val.getD off1.val 0#usize = x := by
            rw [getD_eq_getElem_of_lt (by omega), hx]
          have hvg : eside.val.getD (off1.val + 1) 0#usize = v := by
            rw [← hi, getD_eq_getElem_of_lt hil, hv]
          have hkl : k.val - l1.val = (k.val - (l1.val + 1)) + 1 := by omega
          step with (ext_const_spec e x) as ⟨xc, xs, xw, hxc⟩
          step with (ext_const_spec e j) as ⟨jc, js, jw, hjc⟩
          cases hpx : pExtConst e.val x.val with
          | some px =>
            obtain ⟨xs', xw'⟩ := px
            rw [hpx] at hxc
            simp only [Prod.mk.injEq] at hxc
            obtain ⟨hxc1, hxs, hxw⟩ := hxc
            cases hpj : pExtConst e.val j.val with
            | some pj =>
              obtain ⟨js', jw'⟩ := pj
              rw [hpj] at hjc
              simp only [Prod.mk.injEq] at hjc
              obtain ⟨hjc1, hjs, hjw⟩ := hjc
              have hunf := pWalk_succ_const e.val ebits.val eside.val map.val t.val j
                (k.val - (l1.val + 1)) off1.val cur1 xs xw js jw
                (by rw [hxg, hpx, hxs, hxw]) (by rw [hpj, hjs, hjw])
              rw [← hkl, hvg] at hunf
              rw [hxc1, hjc1]
              simp only [if_true]
              split
              · rename_i hww
                rw [bits_eq_eq]
                simp only [bind_tc_ok]
                split
                · rename_i hbe
                  have hbe' : BitsEq ebits.val xs.val ebits.val js.val xw.val := by simpa using hbe
                  rw [map_at_eq]
                  simp only [bind_tc_ok]
                  have hcond : (xw = jw ∧ BitsEq ebits.val xs.val ebits.val js.val xw.val) := ⟨hww, hbe'⟩
                  rw [if_pos hcond] at hunf
                  step as ⟨off2, hoff2⟩
                  step as ⟨l2, hl2⟩
                  apply walkInv_step _ _ _ _ cur1 off1 l1 _ off2 l2 _ _ hlt' hoff hWc hl2 hoff2
                  refine ⟨fun _ h => (by rw [hbe] at h; cases h), ⟨fun h _ => ?_, fun h => ?_⟩⟩
                  · rw [hunf]
                    have : cur1 = img map.val v.val := by simpa using h
                    rw [if_pos this]
                  · rw [hunf]
