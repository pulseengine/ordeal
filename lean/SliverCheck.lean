/-- The invariant of `call_dup`'s loop: no entry before `off` matches. -/
def CallDupInv (calls cargs : List Std.Usize) (fid s k : Std.Usize) (st : Std.Usize × Bool) : Prop :=
  st.1.val % 4 = 0 ∧ (st.2 = false → ∀ c, 4 * c < st.1.val →
    ¬ (clF calls c = fid ∧ clK calls c = k ∧
      ∀ l < k.val, cargs.getD ((clS calls c).val + l) 0#usize = cargs.getD (s.val + l) 0#usize))

theorem call_dup_loop_spec (calls cargs : Slice Std.Usize) (upto fid s k off : Std.Usize) (found : Bool)
    (hupto : upto.val ≤ calls.val.length) (h4 : upto.val % 4 = 0)
    (hs : s.val + k.val ≤ cargs.val.length)
    (hrng : ∀ c, 4 * c < upto.val → (clS calls.val c).val + (clK calls.val c).val ≤ cargs.val.length)
    (hinv : CallDupInv calls.val cargs.val fid s k (off, found)) :
    kernel.sliver_kernel.call_dup_loop calls cargs upto fid s k off found ⦃ r => r = false →
      ∀ c, 4 * c < upto.val → ¬ (clF calls.val c = fid ∧ clK calls.val c = k ∧
        ∀ l < k.val, cargs.val.getD ((clS calls.val c).val + l) 0#usize = cargs.val.getD (s.val + l) 0#usize) ⦄ := by
  unfold kernel.sliver_kernel.call_dup_loop
  apply loop.spec_decr_nat
    (measure := fun (st : Std.Usize × Bool) => upto.val - st.1.val)
    (inv := CallDupInv calls.val cargs.val fid s k)
  · rintro ⟨off1, found1⟩ ⟨hmod, hf⟩
    dsimp only at hmod hf
    unfold kernel.sliver_kernel.call_dup_loop.body
    try dsimp only
    split
    · rename_i hft
      try simp only [WP.spec_ok]
      intro h; cases h
    · rename_i hff
      have hff' : found1 = false := by simpa using hff
      have hall := hf hff'
      split
      · rename_i hlt
        have hlt'' : off1.val < upto.val := by scalar_tac
        have hlt' : off1.val + 3 < calls.val.length := by omega
        have hc4 : 4 * (off1.val / 4) < upto.val := by omega
        step as ⟨i, hi⟩
        have hi' : i.val < calls.val.length := by scalar_tac
        step as ⟨i1, hi1⟩
        have hfg : clF calls.val (off1.val / 4) = i1 := by
          unfold clF
          have : 4 * (off1.val / 4) + 1 = i.val := by omega
          rw [this, getD_eq_getElem_of_lt hi', hi1]
        have hstep : ∀ (found2 : Bool) (off2 : Std.Usize), off2.val = off1.val + 4 →
            (found2 = false → ¬ (clF calls.val (off1.val / 4) = fid ∧ clK calls.val (off1.val / 4) = k ∧
              ∀ l < k.val, cargs.val.getD ((clS calls.val (off1.val / 4)).val + l) 0#usize
                = cargs.val.getD (s.val + l) 0#usize)) →
            CallDupInv calls.val cargs.val fid s k (off2, found2) ∧
              upto.val - off2.val < upto.val - off1.val := by
          intro found2 off2 hoff2 h2
          refine ⟨⟨by simp only; omega, ?_⟩, by omega⟩
          intro hf2 c hc
          simp only at hc
          rw [hoff2] at hc
          rcases Nat.lt_or_ge (4 * c) off1.val with h | h
          · exact hall c h
          · have : c = off1.val / 4 := by omega
            subst this
            exact h2 hf2
        split
        · rename_i hfid
          step as ⟨i2, hi2⟩
          have hi2' : i2.val < calls.val.length := by scalar_tac
          step as ⟨i3, hi3⟩
          have hkg : clK calls.val (off1.val / 4) = i3 := by
            unfold clK
            have : 4 * (off1.val / 4) + 3 = i2.val := by omega
            rw [this, getD_eq_getElem_of_lt hi2', hi3]
          split
          · rename_i hk
            step as ⟨i4, hi4⟩
            have hi4' : i4.val < calls.val.length := by scalar_tac
            step as ⟨i5, hi5⟩
            have hsg : clS calls.val (off1.val / 4) = i5 := by
              unfold clS
              have : 4 * (off1.val / 4) + 2 = i4.val := by omega
              rw [this, getD_eq_getElem_of_lt hi4', hi5]
            have hrng' := hrng _ hc4
            rw [hsg, hkg, hk] at hrng'
            step with (args_eq_spec cargs i5 s k hrng' hs) as ⟨b, hb⟩
            split
            · rename_i hbt
              simp only [bind_tc_ok]
              step as ⟨off2, hoff2⟩
              apply hstep _ _ hoff2
              intro h; cases h
            · rename_i hbf
              simp only [bind_tc_ok]
              step as ⟨off2, hoff2⟩
              apply hstep _ _ hoff2
              intro _ hc
              apply hbf
              rw [hb]
              have hc2 := hc.2.2
              rw [hsg] at hc2
              exact hc2
          · rename_i hk
            simp only [bind_tc_ok]
            step as ⟨off2, hoff2⟩
            apply hstep _ _ hoff2
            intro _ hc
            apply hk
            rw [← hkg]
            exact hc.2.1
        · rename_i hfid
          simp only [bind_tc_ok]
          step as ⟨off2, hoff2⟩
          apply hstep _ _ hoff2
          intro _ hc
          apply hfid
          rw [← hfg]
          exact hc.1
      · rename_i hge
        have hge' : upto.val ≤ off1.val := by scalar_tac
        try simp only [WP.spec_ok]
        intro _ c hc
        exact hall c (by omega)
  · exact hinv

theorem call_dup_spec (calls cargs : Slice Std.Usize) (upto fid s k : Std.Usize)
    (hupto : upto.val ≤ calls.val.length) (h4 : upto.val % 4 = 0)
