      exact hfin
  · exact ⟨Nat.zero_le _, by simp⟩

/-- Second `blast_sign_ext` loop: appends `by1` copies of the sign
    literal. -/
theorem blast_sign_ext_loop1_spec (by1 : Std.Usize) (out : alloc.vec.Vec Lit)
    (sign : Lit) (hcap : out.val.length + by1.val ≤ Usize.max) :
    blast_sign_ext_loop1 by1 out sign 0#usize ⦃ r =>
      r.val = out.val ++ List.replicate by1.val sign ⦄ := by
  unfold blast_sign_ext_loop1
  apply loop.spec_decr_nat
    (measure := fun (s : alloc.vec.Vec Lit × Std.Usize) =>
      by1.val - s.2.val)
    (inv := fun (s : alloc.vec.Vec Lit × Std.Usize) =>
      s.2.val ≤ by1.val ∧
      s.1.val = out.val ++ List.replicate s.2.val sign)
  · rintro ⟨out1, j⟩ ⟨hle, hval⟩
    dsimp only at hle hval
    unfold blast_sign_ext_loop1.body
    dsimp only
    split
    · rename_i hlt
      have hjlt : j.val < by1.val := by scalar_tac
      have hocap : out1.val.length < Usize.max := by
        rw [hval]
        simp only [List.length_append, List.length_replicate]
        omega
      step as ⟨out2, hout2⟩
      step as ⟨j1, hj1⟩
      refine ⟨by scalar_tac, ?_, by scalar_tac⟩
      rw [hj1, hout2, hval, List.replicate_succ']
      simp
    · rename_i hge
      have hjeq : j.val = by1.val := by scalar_tac
      have hfin : out1.val = out.val ++ List.replicate by1.val sign := by
        rw [hval, hjeq]
      exact hfin
  · exact ⟨Nat.zero_le _, by simp⟩

/-- `blast_sign_ext` appends `by1` copies of the MSB literal to the word
    (requires a non-empty word, mirroring the blaster's `debug_assert`). -/
theorem blast_sign_ext_spec (a : Slice Lit) (by1 : Std.Usize)
    (hne : 0 < a.val.length)
    (hcap : a.val.length + by1.val ≤ Usize.max) :
    blast_sign_ext a by1 ⦃ out =>
      out.val = a.val
        ++ List.replicate by1.val (a.val[a.val.length - 1]'(by omega)) ⦄ := by
  unfold blast_sign_ext
  step with (blast_sign_ext_loop0_spec a (alloc.vec.Vec.new Lit)
    (Slice.len a) (by scalar_tac) (by simp; scalar_tac)) as ⟨o1, ho1⟩
  step as ⟨i, hi⟩
  have hival : i.val = a.val.length - 1 := by scalar_tac
  have hilt : i.val < a.val.length := by omega
  step as ⟨sign, hsign⟩
  apply WP.spec_mono (blast_sign_ext_loop1_spec by1 o1 sign
    (by rw [ho1]; simp; omega))
  intro r hr
  rw [hr, ho1, hsign]
  simp only [List.nil_append, hival]

/-- **`blast_sign_ext` implements `BitVec.signExtend`, for every width
    `w`** (non-empty input word): below `w` the bits are `A`'s, at and above
    `w` they are `A`'s MSB (`msb_eq_getLsbD_last`). -/
theorem blast_sign_ext_bitvec (a : Slice Lit) (by1 : Std.Usize)
    (hne : 0 < a.val.length)
    (hcap : a.val.length + by1.val ≤ Usize.max)
    {w : Nat} (A : BitVec w) :
    blast_sign_ext a by1 ⦃ out =>
      ∀ vals : List Bool, Denotes vals a.val w A →
        Denotes vals out.val (w + by1.val)
          (A.signExtend (w + by1.val)) ⦄ := by
  apply WP.spec_mono (blast_sign_ext_spec a by1 hne hcap)
  intro out hout vals hA
  obtain ⟨hal, hAj⟩ := hA
  have hw : 0 < w := by omega
  have holen : out.val.length = w + by1.val := by
    rw [hout]
    simp only [List.length_append, List.length_replicate]
    omega
  refine ⟨holen, fun j hj => ?_⟩
  rw [BitVec.getLsbD_signExtend]
  rcases Nat.lt_or_ge j a.val.length with hja | hja
  · have hgetj : out.val[j]'hj = a.val[j]'hja := by
      simp only [hout]
      exact List.getElem_append_left hja
    rw [hgetj, hAj j hja]
    simp [show j < w + by1.val by omega, show j < w by omega]
  · have hgetj : out.val[j]'hj = a.val[a.val.length - 1]'(by omega) := by
      simp only [hout]
      rw [List.getElem_append_right hja]
      simp
    rw [hgetj, hAj _ (by omega), BitVec.msb_eq_getLsbD_last,
      show a.val.length - 1 = w - 1 by omega]
    simp [show j < w + by1.val by omega, show ¬(j < w) by omega]

end blast_kernel.spec
