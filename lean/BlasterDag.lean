/- Soundness of the term-DAG encoder (issue #192, phase 3 / v0.26.0).

   This file is HAND-WRITTEN (BlastKernel.lean is generated by regen.sh and
   must not be edited). It gives the term DAG of `blast_kernel::DagNode` a
   semantics directly over Lean's `BitVec` (`dagSim`) and proves that the
   Aeneas model of `blast_kernel::encode` — which calls the Lean-proven
   blast rule for every node — builds an AIG whose words denote exactly
   those values under every primary-input assignment (`encode_sound`).

   Proof architecture:
   * `dagSim` is a left fold over the node list, like `pSim`: each node's
     value is computed from the values of the earlier nodes (a width-tagged
     `BitVec`, `DVal`) and the running primary-input counter (a `Var w`
     node takes the next `w` inputs). `dagWidths` is the width-only
     projection; `DagWF` is the syntactic well-formedness the encoder
     assumes (operands are earlier nodes, widths agree).
   * `encode_node_spec` is the case split over the 32 node kinds. Each
     arm glues the rule's STRUCTURAL frame (BlasterFrame.lean: prefix,
     capacity, `AigWF`, output range) to its SEMANTIC capstone
     (`blast_X_bitvec`, stated through the monadic `simulate`) with
     `spec_and`, and harvests the pure-simulator fact with
     `simulate_spec_pSim` + `pSim_congr_inputs`.
   * `EncInv` is the loop invariant of `encode_loop0`: after `i` nodes
     every emitted word denotes its node's `dagSim` value under the
     current aig, which append-monotonicity (`Denotes.up`) carries
     forward as later rules extend the aig.
   * `encode_sound` is the headline: every asserted output literal
     simulates to its root's boolean value. BlasterCapstone.lean composes
     it with the compaction pass and `tseitin_refutes_outputs`.
-/
import BlasterTseitin
import BlasterRotr
import BlasterFrame

open Aeneas Aeneas.Std Result

set_option maxHeartbeats 2000000

namespace blast_kernel.spec

/- ══════════════════════ THE DAG SEMANTICS ══════════════════════ -/

/-- The value of a DAG node: a width-tagged bitvector. Boolean nodes are
    one-bit values (`bvBool`). -/
abbrev DVal := (w : Nat) × BitVec w

/-- The default value for out-of-range reads (every use is guarded by
    `DagWF`). -/
def dDflt : DVal := ⟨0, 0#0⟩

/-- The `w`-bit bitvector whose bit `j` is `f j`. -/
def bvOfFn (f : Nat → Bool) : (w : Nat) → BitVec w
  | 0 => 0#0
  | w + 1 => BitVec.cons (f w) (bvOfFn f w)

theorem getLsbD_bvOfFn (f : Nat → Bool) (w j : Nat) :
    (bvOfFn f w).getLsbD j = (decide (j < w) && f j) := by
  induction w generalizing j with
  | zero => simp [bvOfFn]
  | succ w ih =>
    simp only [bvOfFn, BitVec.getLsbD_cons, ih]
    by_cases h : j = w
    · subst h
      simp
    · have : (j < w + 1) ↔ (j < w) := by omega
      simp [h, this]

/-- A boolean as a one-bit value. -/
def bvBool (b : Bool) : DVal := ⟨1, BitVec.ofBool b⟩

/-- The boolean carried by a (one-bit) value: its bit 0. -/
def bval (v : DVal) : Bool := v.2.getLsbD 0

@[simp] theorem bval_bvBool (b : Bool) : bval (bvBool b) = b := by
  simp [bval, bvBool]

/-- A value coerced to width `w` (the identity when the widths agree, which
    `DagWF` guarantees at every use). -/
def toW (w : Nat) (v : DVal) : BitVec w := v.2.setWidth w

/-- The value of one node, given the values of the earlier nodes and the
    next free primary-input number. Mirrors `encode_node` arm for arm, with
    each arm's `BitVec` operation being the one its rule's capstone
    theorem is stated against. -/
def dagNodeVal (inp bits : List Bool) (vals : List DVal) (nin : Nat) :
    DagNode → DVal
  | .Var w => ⟨w.val, bvOfFn (fun j => inp.getD (nin + j) false) w.val⟩
  | .Const s w => ⟨w.val, bvOfFn (fun j => bits.getD (s.val + j) false) w.val⟩
  | .Add a b =>
    ⟨(vals.getD a.val dDflt).1,
      (vals.getD a.val dDflt).2 + toW _ (vals.getD b.val dDflt)⟩
  | .Sub a b =>
    ⟨(vals.getD a.val dDflt).1,
      (vals.getD a.val dDflt).2 - toW _ (vals.getD b.val dDflt)⟩
  | .Mul a b =>
    ⟨(vals.getD a.val dDflt).1,
      (vals.getD a.val dDflt).2 * toW _ (vals.getD b.val dDflt)⟩
  | .Udiv a b =>
    ⟨(vals.getD a.val dDflt).1,
      (vals.getD a.val dDflt).2.smtUDiv (toW _ (vals.getD b.val dDflt))⟩
  | .Urem a b =>
    ⟨(vals.getD a.val dDflt).1,
      (vals.getD a.val dDflt).2 % toW _ (vals.getD b.val dDflt)⟩
  | .And a b =>
    ⟨(vals.getD a.val dDflt).1,
      (vals.getD a.val dDflt).2 &&& toW _ (vals.getD b.val dDflt)⟩
  | .Or a b =>
    ⟨(vals.getD a.val dDflt).1,
      (vals.getD a.val dDflt).2 ||| toW _ (vals.getD b.val dDflt)⟩
  | .Xor a b =>
    ⟨(vals.getD a.val dDflt).1,
      (vals.getD a.val dDflt).2 ^^^ toW _ (vals.getD b.val dDflt)⟩
  | .Shl a b =>
    ⟨(vals.getD a.val dDflt).1,
      (vals.getD a.val dDflt).2 <<< (toW (vals.getD a.val dDflt).1 (vals.getD b.val dDflt)).toNat⟩
  | .Lshr a b =>
    ⟨(vals.getD a.val dDflt).1,
      (vals.getD a.val dDflt).2 >>> (toW (vals.getD a.val dDflt).1 (vals.getD b.val dDflt)).toNat⟩
  | .Ashr a b =>
    ⟨(vals.getD a.val dDflt).1,
      (vals.getD a.val dDflt).2.sshiftRight
        (toW (vals.getD a.val dDflt).1 (vals.getD b.val dDflt)).toNat⟩
  | .Rotr a b =>
    ⟨(vals.getD a.val dDflt).1,
      (vals.getD a.val dDflt).2.rotateRight
        ((toW (vals.getD a.val dDflt).1 (vals.getD b.val dDflt)).toNat
          % (vals.getD a.val dDflt).1)⟩
  | .Extract hi lo a =>
    ⟨hi.val - lo.val + 1, (vals.getD a.val dDflt).2.extractLsb hi.val lo.val⟩
  | .Concat a b =>
    ⟨(vals.getD a.val dDflt).1 + (vals.getD b.val dDflt).1,
      (vals.getD a.val dDflt).2 ++ (vals.getD b.val dDflt).2⟩
  | .ZeroExt a by1 =>
    ⟨(vals.getD a.val dDflt).1 + by1.val,
      (vals.getD a.val dDflt).2.setWidth ((vals.getD a.val dDflt).1 + by1.val)⟩
  | .SignExt a by1 =>
    ⟨(vals.getD a.val dDflt).1 + by1.val,
      (vals.getD a.val dDflt).2.signExtend ((vals.getD a.val dDflt).1 + by1.val)⟩
  | .Ite c t e =>
    ⟨(vals.getD t.val dDflt).1,
      if bval (vals.getD c.val dDflt) then (vals.getD t.val dDflt).2
      else toW _ (vals.getD e.val dDflt)⟩
  | .Eq a b =>
    bvBool (decide ((vals.getD a.val dDflt).2 = toW _ (vals.getD b.val dDflt)))
  | .Ne a b =>
    bvBool (decide ((vals.getD a.val dDflt).2 ≠ toW _ (vals.getD b.val dDflt)))
  | .Ult a b =>
    bvBool (decide ((vals.getD a.val dDflt).2 < toW _ (vals.getD b.val dDflt)))
  | .Ule a b =>
    bvBool (decide ((vals.getD a.val dDflt).2 ≤ toW _ (vals.getD b.val dDflt)))
  | .Ugt a b =>
    bvBool (decide (toW _ (vals.getD b.val dDflt) < (vals.getD a.val dDflt).2))
  | .Uge a b =>
    bvBool (decide (toW _ (vals.getD b.val dDflt) ≤ (vals.getD a.val dDflt).2))
  | .Slt a b =>
    bvBool ((vals.getD a.val dDflt).2.slt (toW _ (vals.getD b.val dDflt)))
  | .Sle a b =>
    bvBool ((vals.getD a.val dDflt).2.sle (toW _ (vals.getD b.val dDflt)))
  | .Sgt a b =>
    bvBool ((toW _ (vals.getD b.val dDflt)).slt (vals.getD a.val dDflt).2)
  | .Sge a b =>
    bvBool ((toW _ (vals.getD b.val dDflt)).sle (vals.getD a.val dDflt).2)
  | .Not a => bvBool (!bval (vals.getD a.val dDflt))
  | .BoolAnd a b => bvBool (bval (vals.getD a.val dDflt) && bval (vals.getD b.val dDflt))
  | .BoolOr a b => bvBool (bval (vals.getD a.val dDflt) || bval (vals.getD b.val dDflt))

/-- The primary-input counter after a node: a `Var w` takes `w` inputs. -/
def dagNodeNin (nin : Nat) : DagNode → Nat
  | .Var w => nin + w.val
  | _ => nin

/-- The width of one node, from the widths of the earlier nodes. -/
def dagNodeWidth (ws : List Nat) : DagNode → Nat
  | .Var w => w.val
  | .Const _ w => w.val
  | .Add a _ | .Sub a _ | .Mul a _ | .Udiv a _ | .Urem a _
  | .And a _ | .Or a _ | .Xor a _
  | .Shl a _ | .Lshr a _ | .Ashr a _ | .Rotr a _ => ws.getD a.val 0
  | .Extract hi lo _ => hi.val - lo.val + 1
  | .Concat a b => ws.getD a.val 0 + ws.getD b.val 0
  | .ZeroExt a by1 | .SignExt a by1 => ws.getD a.val 0 + by1.val
  | .Ite _ t _ => ws.getD t.val 0
  | .Eq _ _ | .Ne _ _ | .Ult _ _ | .Ule _ _ | .Ugt _ _ | .Uge _ _
  | .Slt _ _ | .Sle _ _ | .Sgt _ _ | .Sge _ _
  | .Not _ | .BoolAnd _ _ | .BoolOr _ _ => 1

/-- The DAG simulation, generalized over the accumulated values and the
    input counter. -/
def dagSimAux (inp bits : List Bool) : List DVal × Nat → List DagNode → List DVal × Nat
  | st, [] => st
  | (vals, nin), nd :: ns =>
    dagSimAux inp bits (vals ++ [dagNodeVal inp bits vals nin nd], dagNodeNin nin nd) ns

/-- **The DAG semantics**: one value per node, under the primary-input
    assignment `inp` (variable bits are read off `inp` in node order) and
    the constant table `bits`. -/
def dagSim (inp bits : List Bool) (ns : List DagNode) : List DVal :=
  (dagSimAux inp bits ([], 0) ns).1

/-- The number of primary inputs the DAG's variables take. -/
def dagNin (ns : List DagNode) : Nat := ns.foldl dagNodeNin 0

/-- The boolean value of (boolean) node `i`. -/
def dagBool (inp bits : List Bool) (ns : List DagNode) (i : Nat) : Bool :=
  bval ((dagSim inp bits ns).getD i dDflt)

/-- The widths, generalized over the accumulator. -/
def dagWidthsAux : List Nat → List DagNode → List Nat
  | ws, [] => ws
  | ws, nd :: ns => dagWidthsAux (ws ++ [dagNodeWidth ws nd]) ns

/-- The width of every node (independent of the inputs). -/
def dagWidths (ns : List DagNode) : List Nat := dagWidthsAux [] ns

/- ══════════════════ STRUCTURAL FACTS ABOUT THE SEMANTICS ══════════════════ -/

theorem dagSimAux_append (inp bits : List Bool) (st : List DVal × Nat)
    (ns ms : List DagNode) :
    dagSimAux inp bits st (ns ++ ms) = dagSimAux inp bits (dagSimAux inp bits st ns) ms := by
  induction ns generalizing st with
  | nil => simp [dagSimAux]
  | cons nd ns ih =>
    obtain ⟨vals, nin⟩ := st
    simp [dagSimAux, ih]

theorem dagSimAux_length (inp bits : List Bool) (vals : List DVal) (nin : Nat)
    (ns : List DagNode) :
    (dagSimAux inp bits (vals, nin) ns).1.length = vals.length + ns.length := by
  induction ns generalizing vals nin with
  | nil => simp [dagSimAux]
  | cons nd ns ih =>
    simp only [dagSimAux, ih, List.length_append, List.length_cons, List.length_nil]
    omega

@[simp] theorem dagSim_length (inp bits : List Bool) (ns : List DagNode) :
    (dagSim inp bits ns).length = ns.length := by
  unfold dagSim
  rw [dagSimAux_length]
  simp

theorem dagSimAux_nin (inp bits : List Bool) (vals : List DVal) (nin : Nat)
    (ns : List DagNode) :
    (dagSimAux inp bits (vals, nin) ns).2 = ns.foldl dagNodeNin nin := by
  induction ns generalizing vals nin with
  | nil => simp [dagSimAux]
  | cons nd ns ih => simp [dagSimAux, ih, List.foldl_cons]

theorem dagSimAux_prefix (inp bits : List Bool) (vals : List DVal) (nin : Nat)
    (ns : List DagNode) :
    vals <+: (dagSimAux inp bits (vals, nin) ns).1 := by
  induction ns generalizing vals nin with
  | nil => simp [dagSimAux]
  | cons nd ns ih => exact (List.prefix_append vals _).trans (ih _ _)

/-- The simulation of a prefix of the DAG is a prefix of the simulation. -/
theorem dagSim_prefix_of_prefix (inp bits : List Bool) {ns ns' : List DagNode}
    (h : ns <+: ns') : dagSim inp bits ns <+: dagSim inp bits ns' := by
  obtain ⟨t, rfl⟩ := h
  unfold dagSim
  rw [dagSimAux_append]
  exact dagSimAux_prefix inp bits _ _ t

/-- Unrolling one more node. -/
theorem dagSim_snoc (inp bits : List Bool) (ns : List DagNode) (nd : DagNode) :
    dagSim inp bits (ns ++ [nd])
      = dagSim inp bits ns ++ [dagNodeVal inp bits (dagSim inp bits ns) (dagNin ns) nd] := by
  unfold dagSim
  rw [dagSimAux_append]
  have h : dagSimAux inp bits ([], 0) ns = ((dagSimAux inp bits ([], 0) ns).1, dagNin ns) := by
    unfold dagNin
    rw [← dagSimAux_nin inp bits [] 0 ns]
  rw [h]
  rfl

theorem dagNin_snoc (ns : List DagNode) (nd : DagNode) :
    dagNin (ns ++ [nd]) = dagNodeNin (dagNin ns) nd := by
  simp [dagNin, List.foldl_append]

theorem dagWidthsAux_append (ws : List Nat) (ns ms : List DagNode) :
    dagWidthsAux ws (ns ++ ms) = dagWidthsAux (dagWidthsAux ws ns) ms := by
  induction ns generalizing ws with
  | nil => simp [dagWidthsAux]
  | cons nd ns ih => simp [dagWidthsAux, ih]

theorem dagWidthsAux_length (ws : List Nat) (ns : List DagNode) :
    (dagWidthsAux ws ns).length = ws.length + ns.length := by
  induction ns generalizing ws with
  | nil => simp [dagWidthsAux]
  | cons nd ns ih =>
    simp only [dagWidthsAux, ih, List.length_append, List.length_cons, List.length_nil]
    omega

@[simp] theorem dagWidths_length (ns : List DagNode) : (dagWidths ns).length = ns.length := by
  unfold dagWidths
  rw [dagWidthsAux_length]
  simp

theorem dagWidthsAux_prefix (ws : List Nat) (ns : List DagNode) :
    ws <+: dagWidthsAux ws ns := by
  induction ns generalizing ws with
  | nil => simp [dagWidthsAux]
  | cons nd ns ih => exact (List.prefix_append ws _).trans (ih _)

theorem dagWidths_prefix_of_prefix {ns ns' : List DagNode} (h : ns <+: ns') :
    dagWidths ns <+: dagWidths ns' := by
  obtain ⟨t, rfl⟩ := h
  unfold dagWidths
  rw [dagWidthsAux_append]
  exact dagWidthsAux_prefix _ t

theorem dagWidths_snoc (ns : List DagNode) (nd : DagNode) :
    dagWidths (ns ++ [nd]) = dagWidths ns ++ [dagNodeWidth (dagWidths ns) nd] := by
  unfold dagWidths
  rw [dagWidthsAux_append]
  rfl

theorem getD_map_fst {vals : List DVal} {ws : List Nat} (h : vals.map Sigma.fst = ws)
    (i : Nat) : (vals.getD i dDflt).1 = ws.getD i 0 := by
  subst h
  rw [List.getD_eq_getElem?_getD, List.getD_eq_getElem?_getD, List.getElem?_map]
  cases vals[i]? with
  | none => rfl
  | some v => rfl

/-- The width of a node's value is its syntactic width. -/
theorem dagNodeVal_fst (inp bits : List Bool) (vals : List DVal) (nin : Nat)
    (nd : DagNode) :
    (dagNodeVal inp bits vals nin nd).1 = dagNodeWidth (vals.map Sigma.fst) nd := by
  cases nd <;> simp only [dagNodeVal, dagNodeWidth, bvBool,
    getD_map_fst (rfl : vals.map Sigma.fst = vals.map Sigma.fst)]

/-- The value list projects to the width list. -/
theorem dagSim_map_fst (inp bits : List Bool) (ns : List DagNode) :
    (dagSim inp bits ns).map Sigma.fst = dagWidths ns := by
  induction ns using List.reverseRecOn with
  | nil => simp [dagSim, dagSimAux, dagWidths, dagWidthsAux]
  | append_singleton ns nd ih =>
    rw [dagSim_snoc, dagWidths_snoc, List.map_append, ih, List.map_singleton,
      dagNodeVal_fst, ih]

theorem dagSim_getD_fst (inp bits : List Bool) (ns : List DagNode) (i : Nat) :
    ((dagSim inp bits ns).getD i dDflt).1 = (dagWidths ns).getD i 0 :=
  getD_map_fst (dagSim_map_fst inp bits ns) i

/- ══════════════════ WELL-FORMEDNESS ══════════════════ -/

/-- Well-formedness of one node at position `i` against the width list
    `ws` of the whole DAG and the size `nbits` of the constant table:
    operands are earlier nodes of agreeing, positive widths; boolean
    operands have width 1; extract ranges fit. This is what the encoder's
    preconditions need — a `Var` or `Const` of width 0 would be an empty
    word, which the rules (and SMT-LIB) exclude. -/
def DagNodeWF (ws : List Nat) (nbits i : Nat) : DagNode → Prop
  | .Var w => 0 < w.val
  | .Const s w => 0 < w.val ∧ s.val + w.val ≤ nbits
  | .Add a b | .Sub a b | .Mul a b | .Udiv a b | .Urem a b
  | .And a b | .Or a b | .Xor a b
  | .Shl a b | .Lshr a b | .Ashr a b | .Rotr a b
  | .Eq a b | .Ne a b | .Ult a b | .Ule a b | .Ugt a b | .Uge a b
  | .Slt a b | .Sle a b | .Sgt a b | .Sge a b =>
    a.val < i ∧ b.val < i ∧ 0 < ws.getD a.val 0 ∧ ws.getD a.val 0 = ws.getD b.val 0
  | .Extract hi lo a => a.val < i ∧ lo.val ≤ hi.val ∧ hi.val < ws.getD a.val 0
  | .Concat a b => a.val < i ∧ b.val < i ∧ 0 < ws.getD a.val 0 ∧ 0 < ws.getD b.val 0
  | .ZeroExt a _ | .SignExt a _ => a.val < i ∧ 0 < ws.getD a.val 0
  | .Ite c t e =>
    c.val < i ∧ t.val < i ∧ e.val < i ∧ ws.getD c.val 0 = 1 ∧
    0 < ws.getD t.val 0 ∧ ws.getD t.val 0 = ws.getD e.val 0
  | .Not a => a.val < i ∧ ws.getD a.val 0 = 1
  | .BoolAnd a b | .BoolOr a b => a.val < i ∧ b.val < i ∧ ws.getD a.val 0 = 1 ∧ ws.getD b.val 0 = 1

/-- Well-formedness of a DAG: every node against the widths of the nodes
    before it (the widths of a prefix are a prefix of the widths). -/
def DagWF (ns : List DagNode) (nbits : Nat) : Prop :=
  ∀ (i : Nat) (h : i < ns.length), DagNodeWF (dagWidths ns) nbits i ns[i]

/-- A `DagNodeWF` fact only reads widths of earlier nodes, so it transfers
    between width lists that agree below `i`. -/
theorem DagNodeWF_congr {ws ws' : List Nat} {nbits i : Nat} {nd : DagNode}
    (hagree : ∀ j, j < i → ws.getD j 0 = ws'.getD j 0)
    (h : DagNodeWF ws nbits i nd) : DagNodeWF ws' nbits i nd := by
  cases nd <;> simp only [DagNodeWF] at h ⊢ <;>
    first
    | exact h
    | (obtain ⟨h1, h2, h3, h4, h5, h6⟩ := h
       simp only [hagree _ h1, hagree _ h2, hagree _ h3] at h4 h5 h6
       exact ⟨h1, h2, h3, h4, h5, h6⟩)
    | (obtain ⟨h1, h2, h3, h4⟩ := h
       simp only [hagree _ h1, hagree _ h2] at h3 h4
       exact ⟨h1, h2, h3, h4⟩)
    | (obtain ⟨h1, h2, h3⟩ := h
       simp only [hagree _ h1] at h3
       exact ⟨h1, h2, h3⟩)
    | (obtain ⟨h1, h2⟩ := h
       simp only [hagree _ h1] at h2
       exact ⟨h1, h2⟩)

/-- The widths of the first `i` nodes agree with the whole DAG's. -/
theorem dagWidths_take_getD (ns : List DagNode) (i j : Nat) (hj : j < i) :
    (dagWidths (ns.take i)).getD j 0 = (dagWidths ns).getD j 0 := by
  by_cases hi : i ≤ ns.length
  · have hpre := dagWidths_prefix_of_prefix (List.take_prefix i ns)
    rw [getD_of_prefix hpre]
    rw [dagWidths_length, List.length_take]
    omega
  · rw [List.take_of_length_le (by omega)]

/-- The gate budget of one node whose operand widths are at most `W`:
    a bound every rule's capacity hypothesis fits under (the worst case is
    `rotr` at a non-power-of-two width: `22·w² + 17·w` for the modular
    reduction plus `3·w·stages` for the barrel). -/
def gateBound (W : Nat) : Nat := 25 * W * W + 20 * W + 1

/- ══════════════ HARVESTING SIMULATE-WRAPPED FACTS ══════════════ -/

/-- `pSim` only reads the inputs an `AigWF`-bounded aig names, so two
    input lists agreeing below `L` simulate identically. -/
theorem pSimAux_congr_inputs {inp inp' : List Bool} {L : Nat}
    (h : ∀ k, k < L → inp.getD k false = inp'.getD k false)
    (vals : List Bool) (ns : List Node)
    (hns : ∀ nd ∈ ns, ∀ k, nd = Node.Input k → k.val < L) :
    pSimAux inp vals ns = pSimAux inp' vals ns := by
  induction ns generalizing vals with
  | nil => rfl
  | cons nd ns ih =>
    simp only [pSimAux]
    have hnd : pNodeVal inp vals nd = pNodeVal inp' vals nd := by
      cases nd with
      | False => rfl
      | Input k =>
        simp only [pNodeVal]
        exact h k.val (hns _ (List.mem_cons_self) k rfl)
      | And x y => rfl
    rw [hnd]
    exact ih _ (fun nd' hnd' => hns nd' (List.mem_cons_of_mem _ hnd'))

theorem pSim_congr_inputs {inp inp' : List Bool} {L : Nat} {ns : List Node}
    (hwf : AigWF ns L)
    (h : ∀ k, k < L → inp.getD k false = inp'.getD k false) :
    pSim inp ns = pSim inp' ns := by
  unfold pSim
  apply pSimAux_congr_inputs h
  intro nd hnd k hk
  obtain ⟨i, hi, rfl⟩ := List.getElem_of_mem hnd
  have := hwf i hi
  rw [hk] at this
  exact this

/-- `inp` padded or truncated to exactly `L` entries, agreeing with `inp`
    on every index below `L`. -/
def padTo (inp : List Bool) (L : Nat) : List Bool :=
  (inp ++ List.replicate L false).take L

@[simp] theorem padTo_length (inp : List Bool) (L : Nat) : (padTo inp L).length = L := by
  simp only [padTo, List.length_take, List.length_append, List.length_replicate]
  omega

theorem padTo_getD (inp : List Bool) (L k : Nat) (hk : k < L) :
    (padTo inp L).getD k false = inp.getD k false := by
  unfold padTo
  rw [List.getD_eq_getElem?_getD, List.getElem?_take_of_lt hk, List.getD_eq_getElem?_getD]
  by_cases hin : k < inp.length
  · rw [List.getElem?_append_left hin]
  · rw [List.getElem?_append_right (by omega), List.getElem?_replicate]
    have hnone : inp[k]? = none := List.getElem?_eq_none (by omega)
    have hlt : k - inp.length < L := by omega
    rw [hnone]
    simp [hlt]

/-- Harvest a `simulate`-wrapped postcondition (the shape of every
    `blast_X_bitvec` capstone) at the pure level, for an ARBITRARY input
    list: the aig only names inputs below `L`, so `inp` padded to `L` is
    a valid `Slice` that simulates like `inp`. -/
theorem harvest {aig0 aig1 : Aig} {L : Nat}
    (hwf0 : AigWF aig0.nodes.val L) (hwf1 : AigWF aig1.nodes.val L)
    (hL : L ≤ Usize.max) {P : List Bool → Prop}
    (h : ∀ inputs : Slice Bool, AigWF aig0.nodes.val inputs.val.length →
      simulate aig1 inputs ⦃ vals => P vals.val ⦄)
    (inp : List Bool) : P (pSim inp aig1.nodes.val) := by
  let inputs : Slice Bool := ⟨padTo inp L, by simp [hL]⟩
  have hlen : inputs.val.length = L := by simp [inputs]
  obtain ⟨vals, hvals, hP⟩ := simulate_spec_pSim aig1 inputs (by rw [hlen]; exact hwf1)
    (h inputs (by rw [hlen]; exact hwf0))
  rw [hvals] at hP
  have hcongr : pSim inputs.val aig1.nodes.val = pSim inp aig1.nodes.val :=
    pSim_congr_inputs hwf1 (fun k hk => padTo_getD inp L k hk)
  rw [hcongr] at hP
  exact hP

/-- A universally quantified family of specs on one computation. -/
theorem spec_forall {α β : Type} [Nonempty β] {m : Result α} {P : β → α → Prop}
    (h : ∀ x, WP.spec m (P x)) : WP.spec m (fun r => ∀ x, P x r) := by
  cases m with
  | ok x =>
    simp only [WP.spec_ok] at h ⊢
    exact h
  | fail e => exact (WP.spec_fail _).mp (h (Classical.arbitrary β)) |>.elim
  | div => exact (WP.spec_div).mp (h (Classical.arbitrary β)) |>.elim

/-- `Denotes` at an equal width, through `toW`. -/
theorem Denotes.toW {vals : List Bool} {word : List Lit} {v : DVal} {w : Nat}
    (h : Denotes vals word v.1 v.2) (hw : v.1 = w) :
    Denotes vals word w (toW w v) := by
  obtain ⟨w', V⟩ := v
  simp only at hw
  subst hw
  show Denotes vals word w' (V.setWidth w')
  rw [BitVec.setWidth_eq]
  exact h

/- ══════════════ ARITHMETIC FOR THE GATE BUDGET ══════════════ -/

theorem sq_le {w W : Nat} (hw : w ≤ W) : w * w ≤ W * W := Nat.mul_le_mul hw hw

theorem lin_le_gateBound {k w W : Nat} (hk : k ≤ 20) (hw : w ≤ W) :
    k * w ≤ gateBound W := by
  unfold gateBound
  nlinarith [sq_le hw]

theorem mul_le_gateBound {w W : Nat} (hw : w ≤ W) : 10 * w * w ≤ gateBound W := by
  unfold gateBound
  nlinarith [sq_le hw]

theorem udiv_le_gateBound {w W : Nat} (hw : w ≤ W) :
    12 * w * w + 8 * w ≤ gateBound W := by
  unfold gateBound
  nlinarith [sq_le hw]

theorem urem_le_gateBound {w W : Nat} (hw : w ≤ W) :
    (12 * w * w + 8 * w) + 10 * w * w + 9 * w ≤ gateBound W := by
  unfold gateBound
  nlinarith [sq_le hw]

theorem shift_le_gateBound {w W : Nat} (hw0 : 0 < w) (hw : w ≤ W) :
    3 * w * pStages w + (w - pStages w) + 3 * w ≤ gateBound W := by
  unfold gateBound
  have hs := pStages_le hw0
  have h1 : 3 * w * pStages w ≤ 3 * w * w := Nat.mul_le_mul_left _ hs
  have h2 : w - pStages w ≤ w := Nat.sub_le _ _
  nlinarith [sq_le hw]

theorem rotr_le_gateBound {w W : Nat} (hw0 : 0 < w) (hw : w ≤ W) :
    (12 * w * w + 8 * w) + 10 * w * w + 9 * w + 3 * w * pStages w ≤ gateBound W := by
  unfold gateBound
  have hs := pStages_le hw0
  have h1 : 3 * w * pStages w ≤ 3 * w * w := Nat.mul_le_mul_left _ hs
  nlinarith [sq_le hw]

theorem one_le_gateBound (W : Nat) : 1 ≤ gateBound W := by
  unfold gateBound
  omega

theorem le_gateBound {w W : Nat} (hw : w ≤ W) : w ≤ gateBound W := by
  unfold gateBound
  nlinarith

/- ══════════════ GLUING A RULE'S FRAME TO ITS SEMANTICS ══════════════ -/

/-- The structural post of a word rule: output width, prefix, gate budget,
    well-formedness preservation, output range. -/
def WordFrame (aig : Aig) (a : Slice Lit) (bound : Nat)
    (p : alloc.vec.Vec Lit × Aig) : Prop :=
  p.1.val.length = a.val.length ∧
  aig.nodes.val <+: p.2.nodes.val ∧
  p.2.nodes.val.length ≤ aig.nodes.val.length + bound ∧
  (∀ L, AigWF aig.nodes.val L → AigWF p.2.nodes.val L) ∧
  (∀ l ∈ p.1.val, l.node.val < p.2.nodes.val.length)

/-- The structural post of a predicate rule. -/
def PredFrame (aig : Aig) (bound : Nat) (p : Lit × Aig) : Prop :=
  aig.nodes.val <+: p.2.nodes.val ∧
  p.2.nodes.val.length ≤ aig.nodes.val.length + bound ∧
  (∀ L, AigWF aig.nodes.val L → AigWF p.2.nodes.val L) ∧
  p.1.node.val < p.2.nodes.val.length

/-- A binary WORD rule, frame and semantics in pure form: if the operand
    words denote `VA inp` and `VB inp` (of equal width) under the aig
    BEFORE the rule, the output word denotes `f` of them under the aig
    AFTER it, for every input list. -/
theorem bin_word_rule {aig : Aig} {a b : Slice Lit} {L bound : Nat}
    {rule : Result (alloc.vec.Vec Lit × Aig)}
    {f : ∀ {w : Nat}, BitVec w → BitVec w → BitVec w}
    (hframe : rule ⦃ p => WordFrame aig a bound p ⦄)
    (hsem : ∀ {w : Nat} (A B : BitVec w), rule ⦃ p =>
      ∀ inputs : Slice Bool, AigWF aig.nodes.val inputs.val.length →
        simulate p.2 inputs ⦃ vals =>
          Denotes vals.val a.val w A → Denotes vals.val b.val w B →
          Denotes vals.val p.1.val w (f A B) ⦄ ⦄)
    (hwf : AigWF aig.nodes.val L) (hL : L ≤ Usize.max)
    (ha : ∀ l ∈ a.val, l.node.val < aig.nodes.val.length)
    (hb : ∀ l ∈ b.val, l.node.val < aig.nodes.val.length)
    (VA VB : List Bool → DVal)
    (hdenA : ∀ inp, Denotes (pSim inp aig.nodes.val) a.val (VA inp).1 (VA inp).2)
    (hdenB : ∀ inp, Denotes (pSim inp aig.nodes.val) b.val (VB inp).1 (VB inp).2)
    (hwab : ∀ inp, (VB inp).1 = (VA inp).1) :
    rule ⦃ p => WordFrame aig a bound p ∧
      ∀ inp, Denotes (pSim inp p.2.nodes.val) p.1.val (VA inp).1
        (f (VA inp).2 (toW (VA inp).1 (VB inp))) ⦄ := by
  apply WP.spec_mono (spec_and hframe
    (spec_forall (fun inp => hsem (VA inp).2 (toW (VA inp).1 (VB inp)))))
  rintro ⟨out, aig1⟩ ⟨hfr, hs⟩
  refine ⟨hfr, fun inp => ?_⟩
  obtain ⟨_, hpre, _, hwfp, _⟩ := hfr
  have h := harvest (P := fun vals =>
      Denotes vals a.val (VA inp).1 (VA inp).2 →
      Denotes vals b.val (VA inp).1 (toW (VA inp).1 (VB inp)) →
      Denotes vals out.val (VA inp).1 (f (VA inp).2 (toW (VA inp).1 (VB inp))))
    hwf (hwfp L hwf) hL (hs inp) inp
  exact h (Denotes.up hpre ha inp (hdenA inp))
    (Denotes.up hpre hb inp (Denotes.toW (hdenB inp) (hwab inp)))

/-- A binary PREDICATE rule, frame and semantics in pure form. -/
theorem bin_pred_rule {aig : Aig} {a b : Slice Lit} {L bound : Nat}
    {rule : Result (Lit × Aig)}
    {g : ∀ {w : Nat}, BitVec w → BitVec w → Bool}
    (hframe : rule ⦃ p => PredFrame aig bound p ⦄)
    (hsem : ∀ {w : Nat}, 0 < w → ∀ (A B : BitVec w), rule ⦃ p =>
      ∀ inputs : Slice Bool, AigWF aig.nodes.val inputs.val.length →
        simulate p.2 inputs ⦃ vals =>
          Denotes vals.val a.val w A → Denotes vals.val b.val w B →
          pEvalLit vals.val p.1 = g A B ⦄ ⦄)
    (hwf : AigWF aig.nodes.val L) (hL : L ≤ Usize.max)
    (ha : ∀ l ∈ a.val, l.node.val < aig.nodes.val.length)
    (hb : ∀ l ∈ b.val, l.node.val < aig.nodes.val.length)
    (VA VB : List Bool → DVal)
    (hpos : ∀ inp, 0 < (VA inp).1)
    (hdenA : ∀ inp, Denotes (pSim inp aig.nodes.val) a.val (VA inp).1 (VA inp).2)
    (hdenB : ∀ inp, Denotes (pSim inp aig.nodes.val) b.val (VB inp).1 (VB inp).2)
    (hwab : ∀ inp, (VB inp).1 = (VA inp).1) :
    rule ⦃ p => PredFrame aig bound p ∧
      ∀ inp, pEvalLit (pSim inp p.2.nodes.val) p.1
        = g (VA inp).2 (toW (VA inp).1 (VB inp)) ⦄ := by
  apply WP.spec_mono (spec_and hframe
    (spec_forall (fun inp => hsem (hpos inp) (VA inp).2 (toW (VA inp).1 (VB inp)))))
  rintro ⟨out, aig1⟩ ⟨hfr, hs⟩
  refine ⟨hfr, fun inp => ?_⟩
  obtain ⟨hpre, _, hwfp, _⟩ := hfr
  have h := harvest (P := fun vals =>
      Denotes vals a.val (VA inp).1 (VA inp).2 →
      Denotes vals b.val (VA inp).1 (toW (VA inp).1 (VB inp)) →
      pEvalLit vals out = g (VA inp).2 (toW (VA inp).1 (VB inp)))
    hwf (hwfp L hwf) hL (hs inp) inp
  exact h (Denotes.up hpre ha inp (hdenA inp))
    (Denotes.up hpre hb inp (Denotes.toW (hdenB inp) (hwab inp)))

/-- A one-literal word denotes the boolean its literal evaluates to. -/
theorem Denotes_single {vals : List Bool} {l : Lit} {b : Bool}
    (h : pEvalLit vals l = b) : Denotes vals [l] 1 (BitVec.ofBool b) := by
  refine ⟨rfl, fun j hj => ?_⟩
  simp only [List.length_singleton] at hj
  have hj0 : j = 0 := by omega
  subst hj0
  simp [h, BitVec.getLsbD_ofBool]

theorem AigWF_mono {ns : List Node} {L L' : Nat} (hLL : L ≤ L') (h : AigWF ns L) :
    AigWF ns L' := by
  intro i hi
  have := h i hi
  cases hnd : ns[i] with
  | False => trivial
  | Input k =>
    rw [hnd] at this
    simp only [NodeWF] at this ⊢
    omega
  | And x y =>
    rw [hnd] at this
    exact this

theorem getD_le_of_forall {ws : List Nat} {W : Nat} (h : ∀ w ∈ ws, w ≤ W) (j : Nat) :
    ws.getD j 0 ≤ W := by
  rw [List.getD_eq_getElem?_getD]
  cases hj : ws[j]? with
  | none => simp
  | some w =>
    simp only [Option.getD_some]
    exact h w (List.mem_of_getElem? hj)

/-- What the encoder knows about one operand word: its width is the node's
    syntactic width, its literals are in range, and it denotes the node's
    value under every input list. -/
theorem operand_facts {aig : Aig} {words : Slice (alloc.vec.Vec Lit)}
    {V : List Bool → List DVal} {ws : List Nat}
    (hVw : ∀ inp, (V inp).map Sigma.fst = ws)
    (hrng : ∀ (j : Nat) (hj : j < words.val.length),
      ∀ l ∈ (words.val[j]).val, l.node.val < aig.nodes.val.length)
    (hden : ∀ (inp : List Bool) (j : Nat) (hj : j < words.val.length),
      Denotes (pSim inp aig.nodes.val) (words.val[j]).val
        ((V inp).getD j dDflt).1 ((V inp).getD j dDflt).2)
    (a : Std.Usize) (ha : a.val < words.val.length) :
    (words.val[a.val]).val.length = ws.getD a.val 0 ∧
    (∀ l ∈ (words.val[a.val]).val, l.node.val < aig.nodes.val.length) ∧
    (∀ inp, ((V inp).getD a.val dDflt).1 = ws.getD a.val 0) ∧
    (∀ inp, Denotes (pSim inp aig.nodes.val) (words.val[a.val]).val
      ((V inp).getD a.val dDflt).1 ((V inp).getD a.val dDflt).2) := by
  have hw : ∀ inp, ((V inp).getD a.val dDflt).1 = ws.getD a.val 0 :=
    fun inp => getD_map_fst (hVw inp) a.val
  refine ⟨?_, hrng a.val ha, hw, fun inp => hden inp a.val ha⟩
  rw [← hw []]
  exact (hden [] a.val ha).1

/- ══════════════ THE PER-NODE ENCODER ══════════════ -/

/-- The post of `encode_node`: the aig grows by at most one gate budget,
    the input counter advances as the semantics says, well-formedness
    follows the counter, and the new word denotes the node's value. -/
def NodePost (aig : Aig) (bits : List Bool) (nin : Nat) (node : DagNode)
    (V : List Bool → List DVal) (W : Nat)
    (p : (alloc.vec.Vec Lit × Std.Usize) × Aig) : Prop :=
  aig.nodes.val <+: p.2.nodes.val ∧
  p.2.nodes.val.length ≤ aig.nodes.val.length + gateBound W ∧
  p.1.2.val = dagNodeNin nin node ∧
  (AigWF aig.nodes.val nin → AigWF p.2.nodes.val p.1.2.val) ∧
  (nin ≤ aig.nodes.val.length → p.1.2.val ≤ p.2.nodes.val.length) ∧
  (∀ l ∈ p.1.1.val, l.node.val < p.2.nodes.val.length) ∧
  ∀ inp, Denotes (pSim inp p.2.nodes.val) p.1.1.val
    (dagNodeVal inp bits (V inp) nin node).1 (dagNodeVal inp bits (V inp) nin node).2

/-- Closing a word arm whose input counter is unchanged. -/
theorem NodePost.of_word {aig : Aig} {bits : List Bool} {nin : Std.Usize} {node : DagNode}
    {V : List Bool → List DVal} {W bound : Nat} {a : Slice Lit}
    {out : alloc.vec.Vec Lit} {aig1 : Aig}
    (hfr : WordFrame aig a bound (out, aig1)) (hbound : bound ≤ gateBound W)
    (hnin : dagNodeNin nin.val node = nin.val)
    (hden : ∀ inp, Denotes (pSim inp aig1.nodes.val) out.val
      (dagNodeVal inp bits (V inp) nin.val node).1
      (dagNodeVal inp bits (V inp) nin.val node).2) :
    NodePost aig bits nin.val node V W ((out, nin), aig1) := by
  obtain ⟨_, hpre, hlen, hwf, hrng⟩ := hfr
  dsimp only at hpre hlen hwf hrng
  unfold NodePost
  dsimp only
  refine ⟨hpre, by omega, hnin.symm, fun h => hwf _ h, fun h => ?_, hrng, hden⟩
  have := hpre.length_le
  omega

/-- Closing a predicate arm (the output is `lit_word` of the literal). -/
theorem NodePost.of_pred {aig : Aig} {bits : List Bool} {nin : Std.Usize} {node : DagNode}
    {V : List Bool → List DVal} {W bound : Nat}
    {l : Lit} {out : alloc.vec.Vec Lit} {aig1 : Aig}
    (hfr : PredFrame aig bound (l, aig1)) (hbound : bound ≤ gateBound W)
    (hout : out.val = [l])
    (hnin : dagNodeNin nin.val node = nin.val)
    (hval : ∀ inp, dagNodeVal inp bits (V inp) nin.val node
      = bvBool (pEvalLit (pSim inp aig1.nodes.val) l)) :
    NodePost aig bits nin.val node V W ((out, nin), aig1) := by
  obtain ⟨hpre, hlen, hwf, hrng⟩ := hfr
  dsimp only at hpre hlen hwf hrng
  unfold NodePost
  dsimp only
  refine ⟨hpre, by omega, hnin.symm, fun h => hwf _ h, fun h => ?_, ?_, fun inp => ?_⟩
  · have := hpre.length_le
    omega
  · intro l' hl'
    rw [hout, List.mem_singleton] at hl'
    subst hl'
    exact hrng
  · rw [hout, hval inp]
    exact Denotes_single rfl

/-- **Encoding one node** (issue #192 phase 3): under the loop's knowledge
    about the words so far — widths `ws`, values `V inp`, well-formedness
    of the node against them — `encode_node` cannot fail, extends the aig
    by at most one gate budget, and the word it returns denotes
    `dagNodeVal` of the node under every input list. -/
theorem encode_node_spec (aig : Aig) (words : Slice (alloc.vec.Vec Lit))
    (bits : Slice Bool) (nin : Std.Usize) (node : DagNode) (W : Nat)
    (V : List Bool → List DVal) (ws : List Nat)
    (hVw : ∀ inp, (V inp).map Sigma.fst = ws)
    (hnode : DagNodeWF ws bits.val.length words.val.length node)
    (hW : ∀ w ∈ ws, w ≤ W)
    (hWn : dagNodeWidth ws node ≤ W)
    (hne : 0 < aig.nodes.val.length) (h0 : aig.nodes.val[0]'hne = Node.False)
    (hwf : AigWF aig.nodes.val nin.val)
    (hnin : nin.val ≤ aig.nodes.val.length)
    (hcap : aig.nodes.val.length + gateBound W ≤ Usize.max)
    (hrng : ∀ (j : Nat) (hj : j < words.val.length),
      ∀ l ∈ (words.val[j]).val, l.node.val < aig.nodes.val.length)
    (hden : ∀ (inp : List Bool) (j : Nat) (hj : j < words.val.length),
      Denotes (pSim inp aig.nodes.val) (words.val[j]).val
        ((V inp).getD j dDflt).1 ((V inp).getD j dDflt).2) :
    encode_node aig words bits nin node ⦃ p => NodePost aig bits.val nin.val node V W p ⦄ := by
  have hL : nin.val ≤ Usize.max := by
    have := aig.nodes.len_ineq
    omega
  have hWs : ∀ j, ws.getD j 0 ≤ W := getD_le_of_forall hW
  have hderef : ∀ x : alloc.vec.Vec Lit, (alloc.vec.Vec.deref x).val = x.val :=
    fun _ => rfl
  unfold encode_node
  cases node with
  | Var w =>
    simp only [DagNodeWF] at hnode
    simp only [dagNodeWidth] at hWn
    dsimp only
    have hcapw : aig.nodes.val.length + w.val ≤ Usize.max := by
      have := le_gateBound hWn
      omega
    have hfw : nin.val + w.val ≤ Usize.max := by
      have := le_gateBound hWn
      omega
    step with (word_inputs_spec aig nin w hcapw hfw) as
      ⟨out, aig1, h1, h2, h3, h4, h5, h6⟩
    step as ⟨i, hi⟩
    unfold NodePost
    dsimp only
    refine ⟨h2, by have := le_gateBound hWn; omega, by simp [dagNodeNin, hi], ?_, ?_, h5, ?_⟩
    · intro hwf0
      rw [hi]
      exact h4 _ (le_refl _) (AigWF_mono (by omega) hwf0)
    · intro _
      rw [hi]
      omega
    · intro inp
      refine ⟨by rw [h1]; rfl, fun j hj => ?_⟩
      rw [h6 inp j hj]
      show _ = (bvOfFn (fun j => inp.getD (nin.val + j) false) w.val).getLsbD j
      rw [getLsbD_bvOfFn]
      have hjw : j < w.val := by rw [h1] at hj; exact hj
      simp [hjw]
  | Const s w =>
    simp only [DagNodeWF] at hnode
    obtain ⟨hpos, hsw⟩ := hnode
    dsimp only
    step with (word_bits_spec bits s w hsw) as ⟨out, h1, h2⟩
    unfold NodePost
    dsimp only
    refine ⟨List.prefix_refl _, by have := one_le_gateBound W; omega, rfl,
      fun h => h, fun h => h, ?_, ?_⟩
    · intro l hl
      obtain ⟨j, hj, rfl⟩ := List.getElem_of_mem hl
      rw [h2 j hj]
      exact hne
    · intro inp
      refine ⟨by rw [h1]; rfl, fun j hj => ?_⟩
      rw [h2 j hj, pEvalLit_node_zero hne h0]
      show _ = (bvOfFn (fun j => bits.val.getD (s.val + j) false) w.val).getLsbD j
      rw [getLsbD_bvOfFn]
      have hjw : j < w.val := by rw [h1] at hj; exact hj
      simp [hjw]
  | Add a b =>
    simp only [DagNodeWF] at hnode
    obtain ⟨ha, hb, hpos, heq⟩ := hnode
    obtain ⟨hlA, hrA, hwA, hdA⟩ := operand_facts hVw hrng hden a ha
    obtain ⟨hlB, hrB, hwB, hdB⟩ := operand_facts hVw hrng hden b hb
    dsimp only
    step as ⟨v, hv⟩
    step as ⟨v1, hv1⟩
    have hvA : (alloc.vec.Vec.deref v).val = (words.val[a.val]).val := by rw [hderef, hv]
    have hvB : (alloc.vec.Vec.deref v1).val = (words.val[b.val]).val := by rw [hderef, hv1]
    rw [← hvA] at hlA hrA hdA
    rw [← hvB] at hlB hrB hdB
    have hab : (alloc.vec.Vec.deref v).val.length ≤ (alloc.vec.Vec.deref v1).val.length := by rw [hlA, hlB, heq]
    have hcapA : aig.nodes.val.length + 9 * (alloc.vec.Vec.deref v).val.length ≤ Usize.max := by
