    step with (bin_pred_rule (bound := 9 * (alloc.vec.Vec.deref v).val.length) (g := fun {w} (A B : BitVec w) => B.slt A)
      (blast_sgt_frame aig _ _ hab hcapA hrA hrB hne h0)
      (fun {w} hw0 A B => blast_sgt_bitvec aig _ _ hab hcapA hrA hrB hne h0 hw0 A B)
      hwf hL hrA hrB (fun inp => (V inp).getD a.val dDflt) (fun inp => (V inp).getD b.val dDflt)
      (fun inp => by rw [hwA]; exact hpos)
      hdA hdB (fun inp => by rw [hwA, hwB, heq])) as ⟨l, aig1, hfr, hs⟩
    step with (lit_word_spec l) as ⟨v2, hv2⟩
    exact NodePost.of_pred hfr (by rw [hlA]; exact lin_le_gateBound (by omega) (hWs a.val))
      hv2 rfl (fun inp => by rw [hs inp]; rfl)
  | Sge a b =>
    simp only [DagNodeWF] at hnode
    obtain ⟨ha, hb, hpos, heq⟩ := hnode
    obtain ⟨hlA, hrA, hwA, hdA⟩ := operand_facts hVw hrng hden a ha
    obtain ⟨hlB, hrB, hwB, hdB⟩ := operand_facts hVw hrng hden b hb
    dsimp only
    step as ⟨v, hv⟩
    step as ⟨v1, hv1⟩
    have hvA : (alloc.vec.Vec.deref v).val = (words.val[a.val]).val := by rw [hderef, hv]
    have hvB : (alloc.vec.Vec.deref v1).val = (words.val[b.val]).val := by rw [hderef, hv1]
    rw [← hvA] at hlA hrA hdA
    rw [← hvB] at hlB hrB hdB
    have hab : (alloc.vec.Vec.deref v).val.length = (alloc.vec.Vec.deref v1).val.length := by rw [hlA, hlB, heq]
    have hcapA : aig.nodes.val.length + 9 * (alloc.vec.Vec.deref v).val.length ≤ Usize.max := by
      have hb' : 9 * (alloc.vec.Vec.deref v).val.length ≤ gateBound W := by
        rw [hlA]
        exact lin_le_gateBound (by omega) (hWs a.val)
      omega
    step with (bin_pred_rule (bound := 9 * (alloc.vec.Vec.deref v).val.length) (g := fun {w} (A B : BitVec w) => B.sle A)
      (blast_sge_frame aig _ _ hab hcapA hrA hrB hne h0)
      (fun {w} hw0 A B => blast_sge_bitvec aig _ _ hab hcapA hrA hrB hne h0 hw0 A B)
      hwf hL hrA hrB (fun inp => (V inp).getD a.val dDflt) (fun inp => (V inp).getD b.val dDflt)
      (fun inp => by rw [hwA]; exact hpos)
      hdA hdB (fun inp => by rw [hwA, hwB, heq])) as ⟨l, aig1, hfr, hs⟩
    step with (lit_word_spec l) as ⟨v2, hv2⟩
    exact NodePost.of_pred hfr (by rw [hlA]; exact lin_le_gateBound (by omega) (hWs a.val))
      hv2 rfl (fun inp => by rw [hs inp]; rfl)
  | Extract hi lo a =>
    simp only [DagNodeWF] at hnode
    obtain ⟨ha, hlo, hhi⟩ := hnode
    obtain ⟨hlA, hrA, hwA, hdA⟩ := operand_facts hVw hrng hden a ha
    dsimp only
    step as ⟨v, hv⟩
    have hvA : (alloc.vec.Vec.deref v).val = (words.val[a.val]).val := by rw [hderef, hv]
    rw [← hvA] at hlA hrA hdA
    have hhi' : hi.val < (alloc.vec.Vec.deref v).val.length := by rw [hlA]; exact hhi
    step with (spec_and (blast_extract_spec _ hi lo hlo hhi')
      (spec_forall (fun inp => blast_extract_bitvec _ hi lo hlo hhi'
        ((V inp).getD a.val dDflt).2))) as ⟨out, hout, hsem⟩
    unfold NodePost
    dsimp only
    refine ⟨List.prefix_refl _, by have := one_le_gateBound W; omega, rfl,
      fun h => h, fun h => h, ?_, ?_⟩
    · intro l hl
      rw [hout] at hl
      exact hrA l (List.mem_of_mem_drop (List.mem_of_mem_take hl))
    · intro inp
      exact hsem inp _ (hdA inp)
  | Concat a b =>
    simp only [DagNodeWF] at hnode
    obtain ⟨ha, hb, hposa, hposb⟩ := hnode
    simp only [dagNodeWidth] at hWn
    obtain ⟨hlA, hrA, hwA, hdA⟩ := operand_facts hVw hrng hden a ha
    obtain ⟨hlB, hrB, hwB, hdB⟩ := operand_facts hVw hrng hden b hb
    dsimp only
    step as ⟨v, hv⟩
    step as ⟨v1, hv1⟩
    have hvA : (alloc.vec.Vec.deref v).val = (words.val[a.val]).val := by rw [hderef, hv]
    have hvB : (alloc.vec.Vec.deref v1).val = (words.val[b.val]).val := by rw [hderef, hv1]
    rw [← hvA] at hlA hrA hdA
    rw [← hvB] at hlB hrB hdB
    have hcapc : (alloc.vec.Vec.deref v1).val.length + (alloc.vec.Vec.deref v).val.length
        ≤ Usize.max := by
      rw [hlA, hlB]
      have := le_gateBound hWn
      omega
    step with (spec_and (blast_concat_spec _ _ hcapc)
      (spec_forall (fun inp => blast_concat_bitvec _ _ hcapc
        ((V inp).getD a.val dDflt).2 ((V inp).getD b.val dDflt).2))) as ⟨out, hout, hsem⟩
    unfold NodePost
    dsimp only
    refine ⟨List.prefix_refl _, by have := one_le_gateBound W; omega, rfl,
      fun h => h, fun h => h, ?_, ?_⟩
    · intro l hl
      rw [hout, List.mem_append] at hl
      rcases hl with hl | hl
      · exact hrB l hl
      · exact hrA l hl
    · intro inp
      exact hsem inp _ (hdA inp) (hdB inp)
  | ZeroExt a by1 =>
    simp only [DagNodeWF] at hnode
    obtain ⟨ha, hposa⟩ := hnode
    simp only [dagNodeWidth] at hWn
    obtain ⟨hlA, hrA, hwA, hdA⟩ := operand_facts hVw hrng hden a ha
    dsimp only
    step as ⟨v, hv⟩
    have hvA : (alloc.vec.Vec.deref v).val = (words.val[a.val]).val := by rw [hderef, hv]
    rw [← hvA] at hlA hrA hdA
    have hcapz : (alloc.vec.Vec.deref v).val.length + by1.val ≤ Usize.max := by
      rw [hlA]
      have := le_gateBound hWn
      omega
    step with (spec_and (blast_zero_ext_spec _ by1 hcapz)
      (spec_forall (fun inp => blast_zero_ext_bitvec _ by1 hcapz
        ((V inp).getD a.val dDflt).2))) as ⟨out, hout, hsem⟩
    unfold NodePost
    dsimp only
    refine ⟨List.prefix_refl _, by have := one_le_gateBound W; omega, rfl,
      fun h => h, fun h => h, ?_, ?_⟩
    · intro l hl
      rw [hout, List.mem_append] at hl
      rcases hl with hl | hl
      · exact hrA l hl
      · rw [List.eq_of_mem_replicate hl]
        exact hne
    · intro inp
      have h0f : pEvalLit (pSim inp aig.nodes.val) { node := 0#usize, neg := false } = false :=
        pEvalLit_node_zero hne h0 inp false
      exact hsem inp _ h0f (hdA inp)
  | SignExt a by1 =>
    simp only [DagNodeWF] at hnode
    obtain ⟨ha, hposa⟩ := hnode
    simp only [dagNodeWidth] at hWn
    obtain ⟨hlA, hrA, hwA, hdA⟩ := operand_facts hVw hrng hden a ha
    dsimp only
    step as ⟨v, hv⟩
    have hvA : (alloc.vec.Vec.deref v).val = (words.val[a.val]).val := by rw [hderef, hv]
    rw [← hvA] at hlA hrA hdA
    have hnea : 0 < (alloc.vec.Vec.deref v).val.length := by rw [hlA]; exact hposa
    have hcaps : (alloc.vec.Vec.deref v).val.length + by1.val ≤ Usize.max := by
      rw [hlA]
      have := le_gateBound hWn
      omega
    step with (spec_and (blast_sign_ext_spec _ by1 hnea hcaps)
      (spec_forall (fun inp => blast_sign_ext_bitvec _ by1 hnea hcaps
        ((V inp).getD a.val dDflt).2))) as ⟨out, hout, hsem⟩
    unfold NodePost
    dsimp only
    refine ⟨List.prefix_refl _, by have := one_le_gateBound W; omega, rfl,
      fun h => h, fun h => h, ?_, ?_⟩
    · intro l hl
      rw [hout, List.mem_append] at hl
      rcases hl with hl | hl
      · exact hrA l hl
      · rw [List.eq_of_mem_replicate hl]
        exact hrA _ (List.getElem_mem _)
    · intro inp
      exact hsem inp _ (hdA inp)
  | Ite c t e =>
    simp only [DagNodeWF] at hnode
    obtain ⟨hc, ht, he, hwc, hpost, heq⟩ := hnode
    obtain ⟨hlC, hrC, hwC, hdC⟩ := operand_facts hVw hrng hden c hc
    obtain ⟨hlT, hrT, hwT, hdT⟩ := operand_facts hVw hrng hden t ht
    obtain ⟨hlE, hrE, hwE, hdE⟩ := operand_facts hVw hrng hden e he
    dsimp only
    step as ⟨v, hv⟩
    have hvC : v.val = (words.val[c.val]).val := by rw [hv]
    rw [← hvC] at hlC hrC hdC
    have hc0 : 0 < v.val.length := by rw [hlC, hwc]; exact Nat.one_pos
    step as ⟨l, hl⟩
    step as ⟨v1, hv1⟩
    step as ⟨v2, hv2⟩
    have hvT : (alloc.vec.Vec.deref v1).val = (words.val[t.val]).val := by rw [hderef, hv1]
    have hvE : (alloc.vec.Vec.deref v2).val = (words.val[e.val]).val := by rw [hderef, hv2]
    rw [← hvT] at hlT hrT hdT
    rw [← hvE] at hlE hrE hdE
    have hte : (alloc.vec.Vec.deref v1).val.length ≤ (alloc.vec.Vec.deref v2).val.length := by
      rw [hlT, hlE, heq]
    have hcapi : aig.nodes.val.length + 3 * (alloc.vec.Vec.deref v1).val.length
        ≤ Usize.max := by
      have hb' : 3 * (alloc.vec.Vec.deref v1).val.length ≤ gateBound W := by
        rw [hlT]
        exact lin_le_gateBound (by omega) (hWs t.val)
      omega
    have hlmem : l ∈ v.val := by
      rw [hl]
      exact List.getElem_mem _
    have hcnd : l.node.val < aig.nodes.val.length := hrC l hlmem
    have hlval : ∀ inp, pEvalLit (pSim inp aig.nodes.val) l = bval ((V inp).getD c.val dDflt) := by
      intro inp
      rw [hl]
      exact (hdC inp).2 0 hc0
    step with (spec_and (blast_ite_spec aig l _ _ hte hcapi hcnd hrT hrE)
      (spec_forall (fun inp => blast_ite_bitvec aig l _ _ hte hcapi hcnd hrT hrE
        ((V inp).getD t.val dDflt).2 (toW _ ((V inp).getD e.val dDflt))))) as
      ⟨out, aig1, h1, h2, h3, h4, h5, h6, hsem⟩
    unfold NodePost
    dsimp only
    refine ⟨h2, by have := lin_le_gateBound (k := 3) (by omega) (hWs t.val); rw [hlT] at h3; omega,
      rfl, fun h => h4 _ h, fun h => ?_, h5, fun inp => ?_⟩
    · have := h2.length_le
      omega
    · have hp := harvest (P := fun vals =>
          Denotes vals (alloc.vec.Vec.deref v1).val ((V inp).getD t.val dDflt).1
            ((V inp).getD t.val dDflt).2 →
          Denotes vals (alloc.vec.Vec.deref v2).val ((V inp).getD t.val dDflt).1
            (toW _ ((V inp).getD e.val dDflt)) →
          Denotes vals out.val ((V inp).getD t.val dDflt).1
            (if pEvalLit vals l then ((V inp).getD t.val dDflt).2
             else toW _ ((V inp).getD e.val dDflt)))
        hwf (h4 _ hwf) hL (hsem inp) inp
      have hres := hp (Denotes.up h2 hrT inp (hdT inp))
        (Denotes.up h2 hrE inp (Denotes.toW (hdE inp) (by rw [hwT, hwE, heq])))
      rw [pEvalLit_stable h2 l hcnd inp, hlval inp] at hres
      exact hres
  | Not a =>
    simp only [DagNodeWF] at hnode
    obtain ⟨ha, hwa⟩ := hnode
    obtain ⟨hlA, hrA, hwA, hdA⟩ := operand_facts hVw hrng hden a ha
    dsimp only
    step as ⟨v, hv⟩
    have hvA : v.val = (words.val[a.val]).val := by rw [hv]
    rw [← hvA] at hlA hrA hdA
    have ha0 : 0 < v.val.length := by rw [hlA, hwa]; exact Nat.one_pos
    step as ⟨l, hl⟩
    step with (lit_not_spec l) as ⟨l1, hl1⟩
    step with (lit_word_spec l1) as ⟨v1, hv1⟩
    have hlmem : l ∈ v.val := by
      rw [hl]
      exact List.getElem_mem _
    unfold NodePost
    dsimp only
    refine ⟨List.prefix_refl _, by have := one_le_gateBound W; omega, rfl,
      fun h => h, fun h => h, ?_, fun inp => ?_⟩
    · intro l' hl'
      rw [hv1, List.mem_singleton] at hl'
      subst hl'
      rw [hl1]
      exact hrA l hlmem
    · rw [hv1]
      have hA := (hdA inp).2 0 ha0
      show Denotes _ [l1] 1 (BitVec.ofBool (!bval ((V inp).getD a.val dDflt)))
      apply Denotes_single
      rw [hl1, pEvalLit_not, hl, hA]
      rfl
  | BoolAnd a b =>
    simp only [DagNodeWF] at hnode
    obtain ⟨ha, hb, hwa, hwb⟩ := hnode
    obtain ⟨hlA, hrA, hwA, hdA⟩ := operand_facts hVw hrng hden a ha
    obtain ⟨hlB, hrB, hwB, hdB⟩ := operand_facts hVw hrng hden b hb
    dsimp only
    step as ⟨v, hv⟩
    have hvA : v.val = (words.val[a.val]).val := by rw [hv]
    rw [← hvA] at hlA hrA hdA
    have ha0 : 0 < v.val.length := by rw [hlA, hwa]; exact Nat.one_pos
    step as ⟨l, hl⟩
    step as ⟨v1, hv1⟩
    have hvB : v1.val = (words.val[b.val]).val := by rw [hv1]
    rw [← hvB] at hlB hrB hdB
    have hb0 : 0 < v1.val.length := by rw [hlB, hwb]; exact Nat.one_pos
    step as ⟨l1, hl1⟩
    have hlmem : l ∈ v.val := by
      rw [hl]
      exact List.getElem_mem _
    have hl1mem : l1 ∈ v1.val := by
      rw [hl1]
      exact List.getElem_mem _
    have hcap1 : aig.nodes.val.length + 1 ≤ Usize.max := by
      have := one_le_gateBound W
      omega
    step with (push_and_gadget aig l l1 hcap1 (hrA l hlmem) (hrB l1 hl1mem)) as
      ⟨l2, aig1, h1, h2, h3, h4, h5⟩
    step with (lit_word_spec l2) as ⟨v2, hv2⟩
    unfold NodePost
    dsimp only
    refine ⟨h2, by have := one_le_gateBound W; omega, rfl, fun h => h4 _ h, fun h => ?_,
      ?_, fun inp => ?_⟩
    · omega
    · intro l' hl'
      rw [hv2, List.mem_singleton] at hl'
      subst hl'
      exact h3
    · rw [hv2]
      have hA := (hdA inp).2 0 ha0
      have hB := (hdB inp).2 0 hb0
      show Denotes _ [l2] 1 (BitVec.ofBool (bval ((V inp).getD a.val dDflt)
        && bval ((V inp).getD b.val dDflt)))
      apply Denotes_single
      rw [h5 inp, hl, hl1, hA, hB]
      rfl
  | BoolOr a b =>
    simp only [DagNodeWF] at hnode
    obtain ⟨ha, hb, hwa, hwb⟩ := hnode
    obtain ⟨hlA, hrA, hwA, hdA⟩ := operand_facts hVw hrng hden a ha
    obtain ⟨hlB, hrB, hwB, hdB⟩ := operand_facts hVw hrng hden b hb
    dsimp only
    step as ⟨v, hv⟩
    have hvA : v.val = (words.val[a.val]).val := by rw [hv]
    rw [← hvA] at hlA hrA hdA
    have ha0 : 0 < v.val.length := by rw [hlA, hwa]; exact Nat.one_pos
    step as ⟨l, hl⟩
    step as ⟨v1, hv1⟩
    have hvB : v1.val = (words.val[b.val]).val := by rw [hv1]
    rw [← hvB] at hlB hrB hdB
    have hb0 : 0 < v1.val.length := by rw [hlB, hwb]; exact Nat.one_pos
    step as ⟨l1, hl1⟩
    have hlmem : l ∈ v.val := by
      rw [hl]
      exact List.getElem_mem _
    have hl1mem : l1 ∈ v1.val := by
      rw [hl1]
      exact List.getElem_mem _
    have hcap1 : aig.nodes.val.length + 1 ≤ Usize.max := by
      have := one_le_gateBound W
      omega
    step with (push_or_gadget aig l l1 hcap1 (hrA l hlmem) (hrB l1 hl1mem)) as
      ⟨l2, aig1, h1, h2, h3, h4, h5⟩
    step with (lit_word_spec l2) as ⟨v2, hv2⟩
    unfold NodePost
    dsimp only
    refine ⟨h2, by have := one_le_gateBound W; omega, rfl, fun h => h4 _ h, fun h => ?_,
      ?_, fun inp => ?_⟩
    · omega
    · intro l' hl'
      rw [hv2, List.mem_singleton] at hl'
      subst hl'
      exact h3
    · rw [hv2]
      have hA := (hdA inp).2 0 ha0
      have hB := (hdB inp).2 0 hb0
      show Denotes _ [l2] 1 (BitVec.ofBool (bval ((V inp).getD a.val dDflt)
        || bval ((V inp).getD b.val dDflt)))
      apply Denotes_single
      rw [h5 inp, hl, hl1, hA, hB]
      rfl

/- ══════════════ THE ENCODER LOOP ══════════════ -/

/-- The width of node `i` is its syntactic width over the widths before it. -/
theorem dagWidths_getD_eq (ns : List DagNode) (i : Nat) (hi : i < ns.length) :
    (dagWidths ns).getD i 0 = dagNodeWidth (dagWidths (ns.take i)) ns[i] := by
  have htake : ns.take (i + 1) = ns.take i ++ [ns[i]] := by
    rw [List.take_add_one, List.getElem?_eq_getElem hi]
    simp
  have hpre := dagWidths_prefix_of_prefix (List.take_prefix (i + 1) ns)
  have hlen : i < (dagWidths (ns.take (i + 1))).length := by
    rw [dagWidths_length, List.length_take]
    omega
  rw [getD_of_prefix hpre hlen, htake, dagWidths_snoc]
  have hl : (dagWidths (ns.take i)).length = i := by
    rw [dagWidths_length, List.length_take]
    omega
  have := getD_snoc_length (dagWidths (ns.take i)) (dagNodeWidth (dagWidths (ns.take i)) ns[i]) 0
  rw [hl] at this
  exact this

/-- The loop invariant of `encode_loop0` after `i` nodes. -/
def EncInv (aig0 : Aig) (ns : List DagNode) (bits : List Bool) (W : Nat)
    (s : Aig × alloc.vec.Vec (alloc.vec.Vec Lit) × Std.Usize × Std.Usize) : Prop :=
  s.2.2.2.val ≤ ns.length ∧
  s.2.1.val.length = s.2.2.2.val ∧
  aig0.nodes.val <+: s.1.nodes.val ∧
  s.1.nodes.val.length ≤ aig0.nodes.val.length + s.2.2.2.val * gateBound W ∧
  s.2.2.1.val = dagNin (ns.take s.2.2.2.val) ∧
  AigWF s.1.nodes.val s.2.2.1.val ∧
  s.2.2.1.val ≤ s.1.nodes.val.length ∧
  (∀ (j : Nat) (hj : j < s.2.1.val.length),
    ∀ l ∈ (s.2.1.val[j]).val, l.node.val < s.1.nodes.val.length) ∧
  ∀ (inp : List Bool) (j : Nat) (hj : j < s.2.1.val.length),
    Denotes (pSim inp s.1.nodes.val) (s.2.1.val[j]).val
      ((dagSim inp bits (ns.take s.2.2.2.val)).getD j dDflt).1
      ((dagSim inp bits (ns.take s.2.2.2.val)).getD j dDflt).2

/-- What the encoder loop establishes once every node is done. -/
def EncPost (aig0 : Aig) (ns : List DagNode) (bits : List Bool)
    (p : Aig × alloc.vec.Vec (alloc.vec.Vec Lit)) : Prop :=
  aig0.nodes.val <+: p.1.nodes.val ∧
  AigWF p.1.nodes.val (dagNin ns) ∧
  dagNin ns ≤ p.1.nodes.val.length ∧
  p.2.val.length = ns.length ∧
  (∀ (j : Nat) (hj : j < p.2.val.length),
    ∀ l ∈ (p.2.val[j]).val, l.node.val < p.1.nodes.val.length) ∧
  ∀ (inp : List Bool) (j : Nat) (hj : j < p.2.val.length),
    Denotes (pSim inp p.1.nodes.val) (p.2.val[j]).val
      ((dagSim inp bits ns).getD j dDflt).1 ((dagSim inp bits ns).getD j dDflt).2

theorem encode_loop0_spec (aig0 : Aig) (ns : Slice DagNode) (bits : Slice Bool)
    (words : alloc.vec.Vec (alloc.vec.Vec Lit)) (nin n i : Std.Usize) (W : Nat)
    (hn : n.val = ns.val.length)
    (hne : 0 < aig0.nodes.val.length) (h0 : aig0.nodes.val[0]'hne = Node.False)
    (hdag : DagWF ns.val bits.val.length)
    (hW : ∀ w ∈ dagWidths ns.val, w ≤ W)
    (hcap : aig0.nodes.val.length + ns.val.length * gateBound W ≤ Usize.max)
    (hinv : EncInv aig0 ns.val bits.val W (aig0, words, nin, i)) :
    encode_loop0 aig0 ns bits words nin n i ⦃ p => EncPost aig0 ns.val bits.val p ⦄ := by
  unfold encode_loop0
  apply loop.spec_decr_nat
    (measure := fun (s : Aig × alloc.vec.Vec (alloc.vec.Vec Lit) × Std.Usize × Std.Usize) =>
      ns.val.length - s.2.2.2.val)
    (inv := fun s => EncInv aig0 ns.val bits.val W s)
  · rintro ⟨aig1, words1, nin1, i1⟩ hinv1
    obtain ⟨hile, hwlen, hpre, hlen, hnin, hwf, hninle, hrng, hden⟩ := hinv1
    dsimp only at hile hwlen hpre hlen hnin hwf hninle hrng hden
    unfold encode_loop0.body
    dsimp only
    split
    · rename_i hlt
      have hilt : i1.val < ns.val.length := by scalar_tac
      step as ⟨node, hnode⟩
      have hne1 : 0 < aig1.nodes.val.length := by
        have := hpre.length_le
        omega
      have h01 : aig1.nodes.val[0]'hne1 = Node.False := node0_of_prefix hpre hne h0 hne1
      have hderef : (alloc.vec.Vec.deref words1).val = words1.val := rfl
      have hVw : ∀ inp, (dagSim inp bits.val (ns.val.take i1.val)).map Sigma.fst
          = dagWidths (ns.val.take i1.val) := fun inp => dagSim_map_fst _ _ _
      have hnodewf : DagNodeWF (dagWidths (ns.val.take i1.val)) bits.val.length
          (alloc.vec.Vec.deref words1).val.length node := by
        rw [hderef, hwlen, hnode]
        exact DagNodeWF_congr (fun j hj => (dagWidths_take_getD ns.val i1.val j hj).symm)
          (hdag i1.val hilt)
      have hW' : ∀ w ∈ dagWidths (ns.val.take i1.val), w ≤ W := fun w hw =>
        hW w ((dagWidths_prefix_of_prefix (List.take_prefix _ _)).subset hw)
      have hWn : dagNodeWidth (dagWidths (ns.val.take i1.val)) node ≤ W := by
        rw [hnode, ← dagWidths_getD_eq ns.val i1.val hilt]
        exact getD_le_of_forall hW _
      have hcap1 : aig1.nodes.val.length + gateBound W ≤ Usize.max := by
        have h1 : (i1.val + 1) * gateBound W ≤ ns.val.length * gateBound W :=
          Nat.mul_le_mul_right _ (by omega)
        rw [Nat.succ_mul] at h1
        omega
      have hrng' : ∀ (j : Nat) (hj : j < (alloc.vec.Vec.deref words1).val.length),
          ∀ l ∈ ((alloc.vec.Vec.deref words1).val[j]).val, l.node.val < aig1.nodes.val.length :=
        hrng
      have hden' : ∀ (inp : List Bool) (j : Nat) (hj : j < (alloc.vec.Vec.deref words1).val.length),
          Denotes (pSim inp aig1.nodes.val) ((alloc.vec.Vec.deref words1).val[j]).val
            ((dagSim inp bits.val (ns.val.take i1.val)).getD j dDflt).1
            ((dagSim inp bits.val (ns.val.take i1.val)).getD j dDflt).2 :=
        hden
      step with (encode_node_spec aig1 (alloc.vec.Vec.deref words1) bits nin1 node W
        (fun inp => dagSim inp bits.val (ns.val.take i1.val)) (dagWidths (ns.val.take i1.val))
        hVw hnodewf hW' hWn hne1 h01 hwf hninle hcap1 hrng' hden') as
        ⟨w, nin2, aig2, hpost⟩
      unfold NodePost at hpost
      dsimp only at hpost
      obtain ⟨hp1, hp2, hp3, hp4, hp5, hp6, hp7⟩ := hpost
      have hwcap : words1.val.length < Usize.max := by
        have := ns.length_ineq
        omega
      step as ⟨words2, hwords2⟩
      step as ⟨i2, hi2⟩
      have htake : ns.val.take (i1.val + 1) = ns.val.take i1.val ++ [ns.val[i1.val]] := by
        rw [List.take_add_one, List.getElem?_eq_getElem hilt]
        simp
      refine ⟨?_, by scalar_tac⟩
      unfold EncInv
      dsimp only
      refine ⟨by scalar_tac, ?_, hpre.trans hp1, ?_, ?_, hp4 hwf, hp5 hninle, ?_, ?_⟩
      · rw [hi2, hwords2]
        simp only [List.length_append, List.length_singleton]
        omega
      · rw [hi2, Nat.succ_mul]
        omega
      · rw [hi2, htake, dagNin_snoc, ← hnin, hp3, hnode]
      · intro j hj l hl
        simp only [hwords2] at hj hl
        simp only [List.length_append, List.length_singleton] at hj
        rcases Nat.lt_or_ge j words1.val.length with hjl | hjl
        · rw [List.getElem_append_left hjl] at hl
          exact Nat.lt_of_lt_of_le (hrng j hjl l hl) hp1.length_le
        · have hjeq : j = words1.val.length := by omega
          subst hjeq
          rw [List.getElem_concat_length rfl _] at hl
          exact hp6 l hl
      · intro inp j hj
        rw [hi2, htake, dagSim_snoc]
        simp only [hwords2] at hj ⊢
        simp only [List.length_append, List.length_singleton] at hj
        have hslen : (dagSim inp bits.val (ns.val.take i1.val)).length = i1.val := by
          rw [dagSim_length, List.length_take]
          omega
        rcases Nat.lt_or_ge j words1.val.length with hjl | hjl
        · rw [List.getElem_append_left hjl]
          have hgetD : (dagSim inp bits.val (ns.val.take i1.val) ++
              [dagNodeVal inp bits.val (dagSim inp bits.val (ns.val.take i1.val))
                (dagNin (ns.val.take i1.val)) ns.val[i1.val]]).getD j dDflt
              = (dagSim inp bits.val (ns.val.take i1.val)).getD j dDflt :=
            getD_of_prefix (List.prefix_append _ _) (by omega)
          rw [hgetD]
          exact Denotes.up hp1 (hrng j hjl) inp (hden inp j hjl)
        · have hjeq : j = words1.val.length := by omega
          subst hjeq
          rw [List.getElem_concat_length rfl _]
          have hgetD : (dagSim inp bits.val (ns.val.take i1.val) ++
              [dagNodeVal inp bits.val (dagSim inp bits.val (ns.val.take i1.val))
                (dagNin (ns.val.take i1.val)) ns.val[i1.val]]).getD words1.val.length dDflt
              = dagNodeVal inp bits.val (dagSim inp bits.val (ns.val.take i1.val))
                (dagNin (ns.val.take i1.val)) ns.val[i1.val] := by
            have hl' : words1.val.length = (dagSim inp bits.val (ns.val.take i1.val)).length := by
              rw [hwlen, hslen]
            rw [hl']
            exact getD_snoc_length _ _ _
          rw [hgetD, ← hnin, ← hnode]
          exact hp7 inp
    · rename_i hge
      have hieq : i1.val = ns.val.length := by scalar_tac
      rw [hieq, List.take_length] at hnin hden
      refine ⟨hpre, by rw [← hnin]; exact hwf, by rw [← hnin]; exact hninle,
        by rw [hwlen, hieq], hrng, hden⟩
  · exact hinv

/-- The output literal of root `k`: the first literal of its word. -/
def rootLit (words : List (alloc.vec.Vec Lit)) (roots : List Std.Usize) (k : Nat) : Lit :=
  (words.getD (roots.getD k 0#usize).val (alloc.vec.Vec.new Lit)).val.getD 0 dLit

theorem encode_loop1_spec (roots : Slice Std.Usize) (words : alloc.vec.Vec (alloc.vec.Vec Lit))
    (outs : alloc.vec.Vec Lit) (m r : Std.Usize)
    (hm : m.val = roots.val.length) (hr : r.val ≤ roots.val.length)
    (hroots : ∀ x ∈ roots.val, x.val < words.val.length ∧
      0 < (words.val.getD x.val (alloc.vec.Vec.new Lit)).val.length)
    (hinv : outs.val.length = r.val ∧
      ∀ (k : Nat) (hk : k < outs.val.length), outs.val[k] = rootLit words.val roots.val k) :
    encode_loop1 roots words outs m r ⦃ out =>
      out.val.length = roots.val.length ∧
      ∀ (k : Nat) (hk : k < out.val.length), out.val[k] = rootLit words.val roots.val k ⦄ := by
  unfold encode_loop1
  apply loop.spec_decr_nat
    (measure := fun (s : alloc.vec.Vec Lit × Std.Usize) => roots.val.length - s.2.val)
    (inv := fun (s : alloc.vec.Vec Lit × Std.Usize) =>
      s.2.val ≤ roots.val.length ∧ s.1.val.length = s.2.val ∧
      ∀ (k : Nat) (hk : k < s.1.val.length), s.1.val[k] = rootLit words.val roots.val k)
  · rintro ⟨outs1, r1⟩ ⟨hrle, holen, hsem⟩
    dsimp only at hrle holen hsem
    unfold encode_loop1.body
    dsimp only
    split
    · rename_i hlt
      have hrlt : r1.val < roots.val.length := by scalar_tac
      step as ⟨idx, hidx⟩
      have hmem : idx ∈ roots.val := by rw [hidx]; exact List.getElem_mem _
      have hidxlt : idx.val < words.val.length := (hroots idx hmem).1
      step as ⟨v, hv⟩
      have hv0 : 0 < v.val.length := by
        rw [hv, ← getD_eq_getElem_of_lt hidxlt (alloc.vec.Vec.new Lit)]
        exact (hroots idx hmem).2
      step as ⟨l, hl⟩
      have hocap : outs1.val.length < Usize.max := by
        have := roots.length_ineq
        omega
      step as ⟨outs2, houts2⟩
      step as ⟨r2, hr2⟩
      refine ⟨by scalar_tac, by rw [houts2, hr2]; simp [holen], ?_, by scalar_tac⟩
      intro k hk
      simp only [houts2] at hk ⊢
      simp only [List.length_append, List.length_singleton] at hk
      rcases Nat.lt_or_ge k outs1.val.length with hkl | hkl
      · rw [List.getElem_append_left hkl]
        exact hsem k hkl
      · have hkeq : k = outs1.val.length := by omega
        subst hkeq
        rw [List.getElem_concat_length rfl _]
        unfold rootLit
        rw [holen, getD_eq_getElem_of_lt hrlt, ← hidx, getD_eq_getElem_of_lt hidxlt, ← hv,
          getD_eq_getElem_of_lt hv0]
        exact hl
    · rename_i hge
      have hreq : r1.val = roots.val.length := by scalar_tac
      exact ⟨by rw [holen, hreq], hsem⟩
  · exact ⟨hr, hinv.1, hinv.2⟩

/-- **The term-DAG encoder is sound** (issue #192 phase 3). For a
    well-formed DAG whose widths are at most `W` and a fresh-enough arena
    (node 0 is the constant, no inputs yet, capacity for every node's gate
    budget), `encode` cannot fail; the arena it builds is well-formed for
    the DAG's `dagNin` primary inputs and extends the given one; and for
    EVERY input list `inp`, every node's word denotes its `dagSim` value,
    so every asserted output literal simulates to its root's boolean value. -/
theorem encode_sound (aig : Aig) (ns : Slice DagNode) (bits : Slice Bool)
    (roots : Slice Std.Usize) (W : Nat)
    (hne : 0 < aig.nodes.val.length) (h0 : aig.nodes.val[0]'hne = Node.False)
    (hwf0 : AigWF aig.nodes.val 0)
    (hdag : DagWF ns.val bits.val.length)
    (hW : ∀ w ∈ dagWidths ns.val, w ≤ W)
    (hcap : aig.nodes.val.length + ns.val.length * gateBound W ≤ Usize.max)
    (hroots : ∀ r ∈ roots.val, r.val < ns.val.length ∧ (dagWidths ns.val).getD r.val 0 = 1) :
    encode aig ns bits roots ⦃ p =>
      aig.nodes.val <+: p.2.nodes.val ∧
      AigWF p.2.nodes.val (dagNin ns.val) ∧
      p.1.1.val.length = ns.val.length ∧
      (∀ (inp : List Bool) (j : Nat) (hj : j < p.1.1.val.length),
        Denotes (pSim inp p.2.nodes.val) (p.1.1.val[j]).val
          ((dagSim inp bits.val ns.val).getD j dDflt).1
          ((dagSim inp bits.val ns.val).getD j dDflt).2) ∧
      p.1.2.val.length = roots.val.length ∧
      (∀ l ∈ p.1.2.val, l.node.val < p.2.nodes.val.length) ∧
      ∀ (inp : List Bool) (k : Nat) (hk : k < p.1.2.val.length),
        pEvalLit (pSim inp p.2.nodes.val) p.1.2.val[k]
          = dagBool inp bits.val ns.val (roots.val.getD k 0#usize).val ⦄ := by
  unfold encode
  have hinit : EncInv aig ns.val bits.val W
      (aig, alloc.vec.Vec.new (alloc.vec.Vec Lit), 0#usize, 0#usize) := by
    refine ⟨by simp, by simp, List.prefix_refl _, by simp, by simp [dagNin], by simpa using hwf0,
      by simp, ?_, ?_⟩
    · intro j hj
      simp at hj
    · intro inp j hj
      simp at hj
  step with (encode_loop0_spec aig ns bits (alloc.vec.Vec.new (alloc.vec.Vec Lit)) 0#usize
    (Slice.len ns) 0#usize W (by simp) hne h0 hdag hW hcap hinit) as
    ⟨aig1, words, hpost⟩
  unfold EncPost at hpost
  dsimp only at hpost
  obtain ⟨hpre, hwf, hninle, hwlen, hrng, hden⟩ := hpost
  have hroots' : ∀ x ∈ roots.val, x.val < words.val.length ∧
      0 < (words.val.getD x.val (alloc.vec.Vec.new Lit)).val.length := by
    intro x hx
    obtain ⟨hlt, hw1⟩ := hroots x hx
    have hlt' : x.val < words.val.length := by rw [hwlen]; exact hlt
    refine ⟨hlt', ?_⟩
    have hd := hden [] x.val hlt'
    rw [getD_eq_getElem_of_lt hlt', hd.1, dagSim_getD_fst, hw1]
    exact Nat.one_pos
  step with (encode_loop1_spec roots words (alloc.vec.Vec.new Lit) (Slice.len roots)
    0#usize (by simp) (by simp) hroots' ⟨by simp, fun k hk => by simp at hk⟩) as
    ⟨outs, holen, hosem⟩
  try simp only [WP.spec_ok]
  try dsimp only
  refine ⟨hpre, hwf, hwlen, hden, holen, ?_, ?_⟩
  · intro l hl
    obtain ⟨k, hk, rfl⟩ := List.getElem_of_mem hl
    have hk' : k < roots.val.length := by rw [← holen]; exact hk
    rw [hosem k hk]
    unfold rootLit
    rw [getD_eq_getElem_of_lt hk']
    have hlt := (hroots' _ (List.getElem_mem hk')).1
    have hw0 := (hroots' _ (List.getElem_mem hk')).2
    rw [getD_eq_getElem_of_lt hlt] at hw0 ⊢
    rw [getD_eq_getElem_of_lt hw0]
    exact hrng _ hlt _ (List.getElem_mem _)
  · intro inp k hk
    have hk' : k < roots.val.length := by rw [← holen]; exact hk
    rw [hosem k hk]
    unfold rootLit
    rw [getD_eq_getElem_of_lt hk']
    have hlt := (hroots' _ (List.getElem_mem hk')).1
    have hw0 := (hroots' _ (List.getElem_mem hk')).2
    rw [getD_eq_getElem_of_lt hlt] at hw0 ⊢
    rw [getD_eq_getElem_of_lt hw0]
    have hd := hden inp (roots.val[k]).val hlt
    unfold dagBool bval
    exact hd.2 0 hw0

end blast_kernel.spec
