"""
Ordeal crate — certificate-checked QF_BV SMT solver.

Two build shapes:
  * Native (host) — rust_library + rust_binary for the production solver and
    CLI. Ordeal's own in-tree pure-Rust CDCL core is the engine on EVERY
    target; the only optional native extra is the Z3 differential oracle
    (cfg-gated behind the `oracle` cargo feature, dev/CI only).
  * wasm32-wasip2 — built and differentially gated on the CARGO path (the
    required CI job; see the #136 disposition at the bottom of this file).
    The same pure-Rust core runs there; no FFI ever reaches the wasm path.

The default build has ZERO external dependencies; the only dep below is the
in-workspace ordeal-lrat checker (the trust boundary). Optional native extras
are expressed in Cargo.toml under [target.'cfg(...)'.dependencies]; because
MODULE.bazel resolves crates via crate_universe from_cargo, those deps flow in
as `@crates//:<name>` here without a manual registry edit.
"""

load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("@rules_wasm_component//rust:defs.bzl", "rust_wasm_component")

package(default_visibility = ["//visibility:public"])

# ── Native (host) targets ─────────────────────────────────────────────────────

# Solver library — the public one-shot check-sat API surface.
rust_library(
    name = "ordeal",
    srcs = glob(["src/**/*.rs"], exclude = ["src/main.rs"]),
    crate_root = "src/lib.rs",
    # `include_str!` fixtures (verus.rs / smtlib.rs #[cfg(test)] modules) must
    # be declared as compile inputs, or the sandboxed build cannot read them —
    # cargo finds them via the filesystem, but Bazel needs them listed. These
    # are real Verus VC logs used as regression fixtures (issue #65).
    compile_data = glob(["tests/fixtures/*.smt2"]),
    edition = "2024",
    deps = [
        # The in-workspace LRAT checker (the sole trusted component). The
        # solver depends on the checker to validate certificates; the checker
        # depends on nothing. Still zero EXTERNAL dependencies by design
        # (wasip2-clean default build). Future native extras (cadical FFI,
        # z3 oracle) attach here gated by crate_features:
        #   "@crates//:z3",  # behind the `oracle` cargo feature (native only)
        "//crates/ordeal-lrat",
    ],
)

# CLI binary.
rust_binary(
    name = "ordeal-cli",
    srcs = ["src/main.rs"],
    crate_root = "src/main.rs",
    edition = "2024",
    deps = [":ordeal"],
)

# Unit + integration tests over the library.
rust_test(
    name = "ordeal-test",
    crate = ":ordeal",
    edition = "2024",
)

# ── wasm32-wasip2 via Bazel: deliberately NOT wired (#136 disposition) ────────
#
# The enforced wasm gate is the cargo path: the REQUIRED `Build
# (wasm32-wasip2)` CI job builds the component AND executes it under wasmtime
# against the native binary (byte-identical verdicts/certificates, #135). A
# Bazel `rust_wasm_component` target would need a cdylib crate-type variant
# and the rules_wasm_component toolchain wiring; nothing consumes a
# Bazel-built wasm artifact today, so carrying a second, unexercised wasm
# build would recreate the two-artifact drift #136 exists to prevent. Wire it
# only when a Bazel consumer materializes — and then give it the same
# differential gate as the cargo artifact.
